diff --git a/features/verifyuser/impl/src/main/kotlin/io/element/android/features/verifyuser/impl/outgoing/VerifyOtherUserStateMachine.kt b/features/verifyuser/impl/src/main/kotlin/io/element/android/features/verifyuser/impl/outgoing/VerifyOtherUserStateMachine.kt
