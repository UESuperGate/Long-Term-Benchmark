+/*
+ * Copyright 2024 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.verifyuser.api
+
+import com.bumble.appyx.core.modality.BuildContext
+import com.bumble.appyx.core.node.Node
+import com.bumble.appyx.core.plugin.Plugin
+import io.element.android.libraries.architecture.FeatureEntryPoint
+import io.element.android.libraries.architecture.NodeInputs
+import io.element.android.libraries.matrix.api.core.UserId
+
+/**
+ * Entry point for verifying another Matrix user with an interactive SAS challenge.
+ *
+ * Distinct from [VerifySessionEntryPoint] in the verifysession feature, which is for
+ * verifying the user's own session via cross-signing.
+ */
+interface VerifyUserEntryPoint : FeatureEntryPoint {
+    data class Params(val userId: UserId) : NodeInputs
+
+    fun nodeBuilder(parentNode: Node, buildContext: BuildContext): NodeBuilder
+
+    interface NodeBuilder {
+        fun params(params: Params): NodeBuilder
+        fun callback(callback: Callback): NodeBuilder
+        fun build(): Node
+    }
+
+    interface Callback : Plugin {
+        /** The user has been verified, or the flow has ended without marking the user trusted. */
+        fun onDone()
+    }
+}
