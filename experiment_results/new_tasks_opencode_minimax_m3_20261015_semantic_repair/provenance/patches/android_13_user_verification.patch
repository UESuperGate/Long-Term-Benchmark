+package io.element.android.features.verifyuser.impl.outgoing
+
+sealed interface VerifyOtherUserEvent {
+    /** User confirms they want to start the verification flow. */
+    data object StartVerification : VerifyOtherUserEvent
+
+    /** User accepts the challenge (emojis / decimals match). */
+    data object AcceptChallenge : VerifyOtherUserEvent
+
+    /** User declines the challenge (emojis / decimals don't match). */
+    data object DeclineChallenge : VerifyOtherUserEvent
+
+    /** User cancels an in-flight verification attempt. */
+    data object Cancel : VerifyOtherUserEvent
+
+    /** User acknowledges completion / cancellation / failure and wants to leave. */
+    data object Dismiss : VerifyOtherUserEvent
+}
