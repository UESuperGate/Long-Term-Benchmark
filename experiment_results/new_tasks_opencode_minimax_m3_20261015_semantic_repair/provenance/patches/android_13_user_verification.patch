+package io.element.android.features.verifyuser.impl.outgoing
+
+import com.bumble.appyx.core.modality.BuildContext
+import com.bumble.appyx.core.node.Node
+import com.bumble.appyx.core.plugin.Plugin
+import com.squareup.anvil.annotations.ContributesBinding
+import io.element.android.features.verifyuser.api.VerifyUserEntryPoint
+import io.element.android.libraries.architecture.createNode
+import io.element.android.libraries.di.AppScope
+import javax.inject.Inject
+
+@ContributesBinding(AppScope::class)
+class DefaultVerifyUserEntryPoint @Inject constructor() : VerifyUserEntryPoint {
+    override fun nodeBuilder(parentNode: Node, buildContext: BuildContext): VerifyUserEntryPoint.NodeBuilder {
+        val plugins = ArrayList<Plugin>()
+        return object : VerifyUserEntryPoint.NodeBuilder {
+            override fun params(params: VerifyUserEntryPoint.Params): VerifyUserEntryPoint.NodeBuilder {
+                plugins += params
+                return this
+            }
+
+            override fun callback(callback: VerifyUserEntryPoint.Callback): VerifyUserEntryPoint.NodeBuilder {
+                plugins += callback
+                return this
+            }
+
+            override fun build(): Node {
+                return parentNode.createNode<VerifyOtherUserNode>(buildContext, plugins)
+            }
+        }
+    }
+}
