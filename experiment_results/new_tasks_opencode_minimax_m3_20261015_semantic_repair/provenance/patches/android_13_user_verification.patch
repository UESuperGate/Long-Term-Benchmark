+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.matrix.api.verification
+
+import io.element.android.libraries.matrix.api.core.UserId
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Service for verifying another Matrix user with an interactive challenge.
+ *
+ * Unlike [SessionVerificationService] which deals with self-session cross-signing,
+ * this service targets a specific user and produces a user-scoped [UserVerifiedStatus].
+ *
+ * The underlying transport reuses the same SAS-based mechanism that drives
+ * session verification, but the resulting trust change is recorded against the
+ * target user, not the local session.
+ */
+interface UserVerificationService {
+    /** The user being verified. */
+    val userId: UserId
+
+    /**
+     * State of the current verification flow ([UserVerificationFlowState.Initial] if not started).
+     */
+    val verificationFlowState: StateFlow<UserVerificationFlowState>
+
+    /** The verification status of the target user. */
+    val userVerifiedStatus: StateFlow<UserVerifiedStatus>
+
+    /**
+     * True while there is an active verification attempt that needs attention
+     * (i.e. it is not in [UserVerificationFlowState.Initial]).
+     */
+    val needsUserVerification: Flow<Boolean>
+
+    /**
+     * Request verification of the target user.
+     *
+     * Emits [UserVerificationFlowState.DidRequest] when the request has been sent,
+     * followed by [UserVerificationFlowState.DidAcceptVerificationRequest] when the
+     * other side accepts it (or [UserVerificationFlowState.DidCancel] /
+     * [UserVerificationFlowState.DidFail] on error).
+     */
+    suspend fun requestVerification()
+
+    /** Cancel the in-progress verification attempt. */
+    suspend fun cancelVerification()
+
+    /** Approve the challenge the user has just compared. */
+    suspend fun approveVerification()
+
+    /** Decline the challenge because the user does not trust the other side. */
+    suspend fun declineVerification()
+
+    /** Start the SAS verification phase after both sides have accepted the request. */
+    suspend fun startSasVerification()
+
+    /**
+     * Reset the verification state to [UserVerificationFlowState.Initial].
+     * @param cancelAnyPendingVerificationAttempt If true, also cancels any pending
+     * SDK-level request.
+     */
+    suspend fun reset(cancelAnyPendingVerificationAttempt: Boolean)
+
+    /**
+     * Notify the service that the user is leaving the verification screen so it
+     * can drop any local optimistic state.
+     */
+    suspend fun cancelAny()
+
+    /**
+     * Factory that creates a [UserVerificationService] for a given [UserId].
+     */
+    fun interface Factory {
+        fun create(userId: UserId): UserVerificationService
+    }
+}
+
+/** Verification status of a specific user, from the local device's point of view. */
+sealed interface UserVerifiedStatus {
+    /** The SDK has not (yet) reported a status for this user. */
+    data object Unknown : UserVerifiedStatus
+
+    /** The user is verified. */
+    data object Verified : UserVerifiedStatus
+
+    /** The user is not verified (never was, or verification was withdrawn). */
+    data object NotVerified : UserVerifiedStatus
+
+    /** True if the user is currently [Verified]. */
+    fun isVerified(): Boolean = this is Verified
+}
+
+/** States produced by the [UserVerificationService]. */
+sealed interface UserVerificationFlowState {
+    /** Initial state. */
+    data object Initial : UserVerificationFlowState
+
+    /** Outgoing request was sent to the other user. */
+    data object DidRequest : UserVerificationFlowState
+
+    /** The other user accepted the verification request. */
+    data object DidAcceptVerificationRequest : UserVerificationFlowState
+
+    /** The SAS verification phase started between the two users. */
+    data object DidStartSasVerification : UserVerificationFlowState
+
+    /** Verification data (emojis or decimals) for the SAS verification received. */
+    data class DidReceiveVerificationData(val data: SessionVerificationData) : UserVerificationFlowState
+
+    /** Verification completed successfully. */
+    data object DidFinish : UserVerificationFlowState
+
+    /** Verification was cancelled by either side. */
+    data object DidCancel : UserVerificationFlowState
+
+    /** Verification failed with an error. */
+    data object DidFail : UserVerificationFlowState
+}
