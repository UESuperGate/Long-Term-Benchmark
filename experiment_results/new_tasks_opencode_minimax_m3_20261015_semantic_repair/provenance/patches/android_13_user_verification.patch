+/*
+ * Copyright 2024 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+@file:OptIn(ExperimentalCoroutinesApi::class)
+
+package io.element.android.features.verifyuser.impl.outgoing
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.derivedStateOf
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import com.freeletics.flowredux.compose.rememberStateAndDispatch
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedFactory
+import dagger.assisted.AssistedInject
+import io.element.android.libraries.architecture.AsyncData
+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.matrix.api.core.UserId
+import io.element.android.libraries.matrix.api.verification.UserVerificationFlowState
+import io.element.android.libraries.matrix.api.verification.UserVerificationService
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+import timber.log.Timber
+import io.element.android.features.verifyuser.impl.outgoing.VerifyOtherUserStateMachine.Event as StateMachineEvent
+import io.element.android.features.verifyuser.impl.outgoing.VerifyOtherUserStateMachine.State as StateMachineState
+
+class VerifyOtherUserPresenter @AssistedInject constructor(
+    @Assisted private val userId: UserId,
+    @Assisted private val navigator: VerifyOtherUserNavigator,
+    private val userVerificationServiceFactory: UserVerificationService.Factory,
+    private val stateMachineFactory: VerifyOtherUserStateMachine.Factory,
+) : Presenter<VerifyOtherUserState> {
+    @AssistedFactory
+    interface Factory {
+        fun create(
+            userId: UserId,
+            navigator: VerifyOtherUserNavigator,
+        ): VerifyOtherUserPresenter
+    }
+
+    private val userVerificationService: UserVerificationService by lazy {
+        userVerificationServiceFactory.create(userId)
+    }
+
+    private val stateMachine by lazy { stateMachineFactory.create(userVerificationService) }
+
+    @Composable
+    override fun present(): VerifyOtherUserState {
+        val stateAndDispatch = stateMachine.rememberStateAndDispatch()
+
+        LaunchedEffect(Unit) {
+            // Make sure we start from a clean state every time we enter it.
+            userVerificationService.reset(cancelAnyPendingVerificationAttempt = true)
+        }
+
+        // Forward service events into the state machine.
+        LaunchedEffect(Unit) {
+            observeService()
+        }
+
+        // Automatically close the screen when the flow reaches a terminal state and the user
+        // confirms the dismiss, OR when the service finishes successfully and the user pressed done.
+        LaunchedEffect(stateAndDispatch.state.value) {
+            val current = stateAndDispatch.state.value
+            if (current is StateMachineState.Completed || current is StateMachineState.Canceled || current is StateMachineState.Failed) {
+                // No automatic navigation; the view shows the terminal UI and waits for Dismiss event.
+            }
+        }
+
+        val step by remember {
+            derivedStateOf { stateAndDispatch.state.value.toStep() }
+        }
+
+        fun handleEvent(event: VerifyOtherUserEvent) {
+            Timber.d("VerifyUser event: ${event::class.simpleName}")
+            when (event) {
+                VerifyOtherUserEvent.StartVerification ->
+                    stateAndDispatch.dispatchAction(StateMachineEvent.StartVerification)
+                VerifyOtherUserEvent.AcceptChallenge ->
+                    stateAndDispatch.dispatchAction(StateMachineEvent.AcceptChallenge)
+                VerifyOtherUserEvent.DeclineChallenge ->
+                    stateAndDispatch.dispatchAction(StateMachineEvent.DeclineChallenge)
+                VerifyOtherUserEvent.Cancel ->
+                    stateAndDispatch.dispatchAction(StateMachineEvent.Cancel)
+                VerifyOtherUserEvent.Dismiss -> {
+                    val currentState = stateAndDispatch.state.value
+                    when (currentState) {
+                        StateMachineState.Initial -> navigator.onDone()
+                        StateMachineState.Completed -> {
+                            navigator.onDone()
+                            stateAndDispatch.dispatchAction(StateMachineEvent.Dismiss)
+                        }
+                        StateMachineState.Canceled,
+                        StateMachineState.Failed -> {
+                            navigator.onDone()
+                            stateAndDispatch.dispatchAction(StateMachineEvent.Dismiss)
+                        }
+                        else -> {
+                            stateAndDispatch.dispatchAction(StateMachineEvent.Cancel)
+                        }
+                    }
+                }
+            }
+        }
+
+        return VerifyOtherUserState(
+            userId = userId,
+            step = step,
+            eventSink = ::handleEvent,
+        )
+    }
+
+    private fun StateMachineState?.toStep(): VerifyOtherUserState.Step = when (val state = this) {
+        null, StateMachineState.Initial -> VerifyOtherUserState.Step.Initial
+        StateMachineState.Requesting,
+        StateMachineState.WaitingForAccept,
+        StateMachineState.Canceling -> VerifyOtherUserState.Step.WaitingForOtherUserAcceptance
+        StateMachineState.RequestAccepted -> VerifyOtherUserState.Step.RequestAccepted
+        is StateMachineState.Verifying.ChallengeReceived ->
+            VerifyOtherUserState.Step.Verifying(state.data, AsyncData.Uninitialized)
+        is StateMachineState.Verifying.Replying ->
+            VerifyOtherUserState.Step.Verifying(state.data, AsyncData.Loading())
+        StateMachineState.Completed -> VerifyOtherUserState.Step.Completed
+        StateMachineState.Canceled -> VerifyOtherUserState.Step.Canceled
+        StateMachineState.Failed -> VerifyOtherUserState.Step.Failed
+    }
+
+    private fun CoroutineScope.observeService() {
+        userVerificationService.verificationFlowState
+            .onEach { Timber.d("VerifyUser flow state: ${it::class.simpleName}") }
+            .onEach { sdkState ->
+                val event = when (sdkState) {
+                    UserVerificationFlowState.Initial -> StateMachineEvent.Dismiss
+                    UserVerificationFlowState.DidRequest -> StateMachineEvent.DidRequest
+                    UserVerificationFlowState.DidAcceptVerificationRequest -> StateMachineEvent.DidAccept
+                    UserVerificationFlowState.DidStartSasVerification -> null
+                    is UserVerificationFlowState.DidReceiveVerificationData -> StateMachineEvent.DidReceiveChallenge(sdkState.data)
+                    UserVerificationFlowState.DidFinish -> StateMachineEvent.DidFinish
+                    UserVerificationFlowState.DidCancel -> StateMachineEvent.DidCancel
+                    UserVerificationFlowState.DidFail -> StateMachineEvent.DidFail
+                }
+                if (event != null) {
+                    stateMachine.dispatch(event)
+                }
+            }
+            .launchIn(this)
+    }
+}
