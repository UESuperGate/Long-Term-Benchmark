+/*
+ * Copyright 2024 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.verifyuser.impl.outgoing
+
+import androidx.compose.runtime.Immutable
+import androidx.compose.runtime.Stable
+import io.element.android.libraries.architecture.AsyncData
+import io.element.android.libraries.matrix.api.core.UserId
+import io.element.android.libraries.matrix.api.verification.SessionVerificationData
+
+@Immutable
+data class VerifyOtherUserState(
+    val userId: UserId,
+    val step: Step,
+    val eventSink: (VerifyOtherUserEvent) -> Unit,
+) {
+    @Stable
+    sealed interface Step {
+        /** Pre-flight, awaiting the user to confirm starting verification. */
+        data object Initial : Step
+
+        /** The verification request has been sent, awaiting the other user to accept. */
+        data object WaitingForOtherUserAcceptance : Step
+
+        /** The other user has accepted the request. About to start SAS. */
+        data object RequestAccepted : Step
+
+        /** SAS challenge received from the SDK. */
+        data class Verifying(val data: SessionVerificationData, val reply: AsyncData<Unit>) : Step
+
+        /** Verification completed successfully - user is now verified. */
+        data object Completed : Step
+
+        /** Verification was cancelled locally or remotely. */
+        data object Canceled : Step
+
+        /** Verification failed (mismatch, SDK error, etc.). */
+        data object Failed : Step
+    }
+}
