+package io.element.android.features.verifyuser.impl.outgoing
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import com.bumble.appyx.core.modality.BuildContext
+import com.bumble.appyx.core.node.Node
+import com.bumble.appyx.core.plugin.Plugin
+import com.bumble.appyx.core.plugin.plugins
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedInject
+import io.element.android.anvilannotations.ContributesNode
+import io.element.android.features.verifyuser.api.VerifyUserEntryPoint
+import io.element.android.libraries.architecture.inputs
+import io.element.android.libraries.di.SessionScope
+
+@ContributesNode(SessionScope::class)
+class VerifyOtherUserNode @AssistedInject constructor(
+    @Assisted buildContext: BuildContext,
+    @Assisted plugins: List<Plugin>,
+    presenterFactory: VerifyOtherUserPresenter.Factory,
+) : Node(buildContext, plugins = plugins),
+    VerifyOtherUserNavigator {
+    private val params = inputs<VerifyUserEntryPoint.Params>()
+
+    private val presenter = presenterFactory.create(
+        userId = params.userId,
+        navigator = this,
+    )
+
+    override fun onDone() {
+        plugins<VerifyUserEntryPoint.Callback>().forEach { it.onDone() }
+    }
+
+    @Composable
+    override fun View(modifier: Modifier) {
+        val state = presenter.present()
+        VerifyOtherUserView(
+            state = state,
+            modifier = modifier,
+        )
+    }
+}
