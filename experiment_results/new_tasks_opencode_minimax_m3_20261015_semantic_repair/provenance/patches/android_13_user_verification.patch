+package io.element.android.libraries.matrix.impl.verification
+
+import io.element.android.libraries.matrix.api.core.UserId
+import io.element.android.libraries.matrix.api.encryption.EncryptionService
+import io.element.android.libraries.matrix.api.verification.SessionVerificationData
+import io.element.android.libraries.matrix.api.verification.SessionVerificationService
+import io.element.android.libraries.matrix.api.verification.UserVerificationFlowState
+import io.element.android.libraries.matrix.api.verification.UserVerificationService
+import io.element.android.libraries.matrix.api.verification.UserVerifiedStatus
+import io.element.android.libraries.matrix.api.verification.VerificationFlowState
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import timber.log.Timber
+
+/**
+ * Implementation of [UserVerificationService] that targets a specific user and
+ * reuses the existing self-session verification controller for the SAS exchange.
+ *
+ * The underlying Rust SDK exposes a single [org.matrix.rustcomponents.sdk.SessionVerificationController]
+ * which already supports user verification (see [RustSessionVerificationService]'s `isOwnVerification`
+ * tracking). For per-user verification requests we drive that same controller and
+ * translate its [VerificationFlowState] to a user-scoped [UserVerificationFlowState].
+ *
+ * Trust changes are recorded against the target user through
+ * [EncryptionService.isUserVerified], which is what powers the identity-violation
+ * surfaces across the app.
+ */
+class RustUserVerificationService(
+    private val sessionVerificationService: SessionVerificationService,
+    private val encryptionService: EncryptionService,
+    private val sessionCoroutineScope: CoroutineScope,
+    override val userId: UserId,
+) : UserVerificationService {
+    private val _verificationFlowState = MutableStateFlow<UserVerificationFlowState>(UserVerificationFlowState.Initial)
+    override val verificationFlowState: StateFlow<UserVerificationFlowState> = _verificationFlowState.asStateFlow()
+
+    private val _userVerifiedStatus = MutableStateFlow<UserVerifiedStatus>(UserVerifiedStatus.Unknown)
+    override val userVerifiedStatus: StateFlow<UserVerifiedStatus> = _userVerifiedStatus.asStateFlow()
+
+    private val verificationMutex = Mutex()
+    private val observedCorrelationId = MutableStateFlow(0L)
+
+    init {
+        // Refresh initial verified status from the SDK.
+        sessionCoroutineScope.launch { refreshVerifiedStatus() }
+
+        // Mirror the underlying session verification state into our user-scoped state.
+        // Only translate events that we drive ourselves; that way concurrent
+        // self-session verifications do not bleed into the user verification UI.
+        sessionCoroutineScope.launch {
+            sessionVerificationService.verificationFlowState.collect { sdkState ->
+                if (isFlowActive()) {
+                    _verificationFlowState.value = mapSdkState(sdkState)
+                }
+                if (sdkState is VerificationFlowState.DidFinish) {
+                    refreshVerifiedStatus()
+                }
+            }
+        }
+    }
+
+    override val needsUserVerification: Flow<Boolean> = verificationFlowState.map { state ->
+        state !is UserVerificationFlowState.Initial
+    }
+
+    override suspend fun requestVerification() = runVerificationAction {
+        verificationMutex.withLock {
+            observedCorrelationId.value = System.currentTimeMillis()
+            // First, ensure the underlying session service is in a clean state.
+            sessionVerificationService.reset(cancelAnyPendingVerificationAttempt = false)
+            // Drive the SDK. The existing SessionVerificationController supports both
+            // self-session and user verification flows.
+            sessionVerificationService.requestVerification()
+            _verificationFlowState.value = UserVerificationFlowState.DidRequest
+        }
+    }
+
+    override suspend fun cancelVerification() = runVerificationAction {
+        verificationMutex.withLock {
+            sessionVerificationService.cancelVerification()
+            _verificationFlowState.value = UserVerificationFlowState.DidCancel
+        }
+    }
+
+    override suspend fun approveVerification() = runVerificationAction {
+        verificationMutex.withLock {
+            sessionVerificationService.approveVerification()
+        }
+    }
+
+    override suspend fun declineVerification() = runVerificationAction {
+        verificationMutex.withLock {
+            sessionVerificationService.declineVerification()
+            // Decline means we definitely don't trust this user; withdraw any
+            // existing verification to make that explicit instead of leaving a
+            // stale "verified" badge.
+            encryptionService.withdrawVerification(userId)
+            _verificationFlowState.value = UserVerificationFlowState.DidCancel
+        }
+    }
+
+    override suspend fun startSasVerification() = runVerificationAction {
+        verificationMutex.withLock {
+            sessionVerificationService.startVerification()
+        }
+    }
+
+    override suspend fun reset(cancelAnyPendingVerificationAttempt: Boolean) {
+        verificationMutex.withLock {
+            if (cancelAnyPendingVerificationAttempt) {
+                runCatching {
+                    sessionVerificationService.cancelVerification()
+                }
+            }
+            _verificationFlowState.value = UserVerificationFlowState.Initial
+        }
+    }
+
+    override suspend fun cancelAny() {
+        // Make sure we never leave the flow in a half-open state when the UI disappears.
+        _verificationFlowState.value = UserVerificationFlowState.Initial
+    }
+
+    private suspend fun refreshVerifiedStatus() {
+        runCatching {
+            encryptionService.isUserVerified(userId).getOrDefault(false)
+        }.onSuccess { verified ->
+            _userVerifiedStatus.value = if (verified) UserVerifiedStatus.Verified else UserVerifiedStatus.NotVerified
+        }.onFailure {
+            Timber.w(it, "Failed to refresh verification status for $userId")
+        }
+    }
+
+    private fun isFlowActive(): Boolean {
+        return _verificationFlowState.value !is UserVerificationFlowState.Initial
+    }
+
+    private fun mapSdkState(sdkState: VerificationFlowState): UserVerificationFlowState = when (sdkState) {
+        VerificationFlowState.Initial -> UserVerificationFlowState.Initial
+        VerificationFlowState.DidAcceptVerificationRequest -> UserVerificationFlowState.DidAcceptVerificationRequest
+        VerificationFlowState.DidStartSasVerification -> UserVerificationFlowState.DidStartSasVerification
+        is VerificationFlowState.DidReceiveVerificationData -> UserVerificationFlowState.DidReceiveVerificationData(sdkState.data)
+        VerificationFlowState.DidFinish -> UserVerificationFlowState.DidFinish
+        VerificationFlowState.DidCancel -> UserVerificationFlowState.DidCancel
+        VerificationFlowState.DidFail -> UserVerificationFlowState.DidFail
+    }
+
+    private suspend fun runVerificationAction(block: suspend () -> Unit) {
+        runCatching {
+            // Make sure the action cannot be cancelled by intermediate flows, otherwise
+            // we might end up with a half-completed SDK call and a stale UI state.
+            withContext(NonCancellable) { block() }
+        }.onFailure {
+            Timber.e(it, "User verification action failed for $userId")
+            _verificationFlowState.value = UserVerificationFlowState.DidFail
+        }
+    }
+}
