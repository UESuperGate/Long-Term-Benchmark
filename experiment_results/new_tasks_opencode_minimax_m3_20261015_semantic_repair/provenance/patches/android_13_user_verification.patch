@@ -0,0 +1,184 @@
+/*
+ * Copyright 2024 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+@file:OptIn(ExperimentalCoroutinesApi::class)
+
+package io.element.android.features.verifyuser.impl.outgoing
+
+import com.freeletics.flowredux.dsl.FlowReduxStateMachine
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedFactory
+import dagger.assisted.AssistedInject
+import io.element.android.features.verifyuser.impl.util.andLogStateChange
+import io.element.android.features.verifyuser.impl.util.logReceivedEvents
+import io.element.android.libraries.matrix.api.verification.SessionVerificationData
+import io.element.android.libraries.matrix.api.verification.UserVerificationService
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import com.freeletics.flowredux.dsl.State as MachineState
+
+class VerifyOtherUserStateMachine @AssistedInject constructor(
+    @Assisted private val userVerificationService: UserVerificationService,
+) : FlowReduxStateMachine<VerifyOtherUserStateMachine.State, VerifyOtherUserStateMachine.Event>(
+    initialState = State.Initial
+) {
+    @AssistedFactory
+    interface Factory {
+        fun create(userVerificationService: UserVerificationService): VerifyOtherUserStateMachine
+    }
+    init {
+        spec {
+            inState<State.Initial> {
+                on { _: Event.StartVerification, state ->
+                    state.override { State.Requesting.andLogStateChange() }
+                }
+            }
+            inState<State.Requesting> {
+                onEnterEffect {
+                    userVerificationService.requestVerification()
+                }
+                on { _: Event.DidRequest, state ->
+                    state.override { State.WaitingForAccept.andLogStateChange() }
+                }
+                on { _: Event.DidFail, state ->
+                    state.override { State.Failed.andLogStateChange() }
+                }
+            }
+            inState<State.WaitingForAccept> {
+                on { _: Event.DidAccept, state ->
+                    state.override { State.RequestAccepted.andLogStateChange() }
+                }
+                on { _: Event.DidCancel, state ->
+                    state.override { State.Canceled.andLogStateChange() }
+                }
+                on { _: Event.DidFail, state ->
+                    state.override { State.Failed.andLogStateChange() }
+                }
+            }
+            inState<State.RequestAccepted> {
+                onEnterEffect {
+                    userVerificationService.startSasVerification()
+                }
+                on { event: Event.DidReceiveChallenge, state ->
+                    state.override { State.Verifying.ChallengeReceived(event.data).andLogStateChange() }
+                }
+                on { _: Event.DidCancel, state ->
+                    state.override { State.Canceled.andLogStateChange() }
+                }
+            }
+            inState<State.Verifying.ChallengeReceived> {
+                on { _: Event.AcceptChallenge, state ->
+                    state.override { State.Verifying.Replying(state.snapshot.data, accept = true).andLogStateChange() }
+                }
+                on { _: Event.DeclineChallenge, state ->
+                    state.override { State.Verifying.Replying(state.snapshot.data, accept = false).andLogStateChange() }
+                }
+            }
+            inState<State.Verifying.Replying> {
+                onEnterEffect { state ->
+                    if (state.accept) {
+                        userVerificationService.approveVerification()
+                    } else {
+                        userVerificationService.declineVerification()
+                    }
+                }
+                on { _: Event.DidFinish, state ->
+                    // Success: only the accept path can land here. The decline path cancels
+                    // immediately and goes to Canceled.
+                    state.override { State.Completed.andLogStateChange() }
+                }
+                on { _: Event.DidCancel, state ->
+                    state.override { State.Canceled.andLogStateChange() }
+                }
+                on { _: Event.DidFail, state ->
+                    state.override { State.Failed.andLogStateChange() }
+                }
+            }
+            inState<State.Canceling> {
+                onEnterEffect {
+                    userVerificationService.cancelVerification()
+                }
+            }
+            inState<State.Completed> {
+                on { _: Event.Dismiss, state ->
+                    state.override { State.Initial.andLogStateChange() }
+                }
+            }
+            inState<State.Canceled> {
+                on { _: Event.Dismiss, state ->
+                    state.override { State.Initial.andLogStateChange() }
+                }
+            }
+            inState<State.Failed> {
+                on { _: Event.Dismiss, state ->
+                    state.override { State.Initial.andLogStateChange() }
+                }
+            }
+            inState {
+                logReceivedEvents()
+                on { _: Event.Cancel, state: MachineState<State> ->
+                    when (state.snapshot) {
+                        State.Initial, State.Completed, State.Canceled, State.Failed -> state.noChange()
+                        else -> {
+                            userVerificationService.cancelVerification()
+                            state.override { State.Canceling.andLogStateChange() }
+                        }
+                    }
+                }
+                on { _: Event.DidCancel, state: MachineState<State> ->
+                    // Cancellation at any point lands in Canceled - never in a verified state.
+                    when (state.snapshot) {
+                        State.Canceled, State.Completed, State.Failed -> state.noChange()
+                        else -> state.override { State.Canceled.andLogStateChange() }
+                    }
+                }
+                on { _: Event.DidFail, state: MachineState<State> ->
+                    when (state.snapshot) {
+                        State.Completed -> state.noChange()
+                        else -> state.override { State.Failed.andLogStateChange() }
+                    }
+                }
+            }
+        }
+    }
+
+    sealed interface State {
+        data object Initial : State
+
+        /** A request to verify is being sent. */
+        data object Requesting : State
+
+        /** Waiting for the other user to accept the request. */
+        data object WaitingForAccept : State
+
+        /** The other user accepted the request. About to start SAS. */
+        data object RequestAccepted : State
+
+        sealed class Verifying(open val data: SessionVerificationData) : State {
+            data class ChallengeReceived(override val data: SessionVerificationData) : Verifying(data)
+            data class Replying(override val data: SessionVerificationData, val accept: Boolean) : Verifying(data)
+        }
+
+        data object Canceling : State
+        data object Canceled : State
+        data object Completed : State
+        data object Failed : State
+    }
+
+    sealed interface Event {
+        data object StartVerification : Event
+        data object DidRequest : Event
+        data object DidAccept : Event
+        data class DidReceiveChallenge(val data: SessionVerificationData) : Event
+        data object AcceptChallenge : Event
+        data object DeclineChallenge : Event
+        data object DidFinish : Event
+        data object Cancel : Event
+        data object DidCancel : Event
+        data object DidFail : Event
+        data object Dismiss : Event
+    }
+}
