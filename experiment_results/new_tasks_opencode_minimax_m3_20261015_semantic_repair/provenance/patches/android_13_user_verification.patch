+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import io.element.android.compound.theme.ElementTheme
+import io.element.android.compound.tokens.generated.CompoundIcons
+import io.element.android.features.verifyuser.impl.R
+import io.element.android.features.verifyuser.impl.outgoing.VerifyOtherUserState.Step
+import io.element.android.libraries.architecture.AsyncData
+import io.element.android.libraries.designsystem.atomic.pages.HeaderFooterPage
+import io.element.android.libraries.designsystem.components.BigIcon
+import io.element.android.libraries.designsystem.components.PageTitle
+import io.element.android.libraries.designsystem.theme.components.Button
+import io.element.android.libraries.designsystem.theme.components.InvisibleButton
+import io.element.android.libraries.designsystem.theme.components.Text
+import io.element.android.libraries.designsystem.theme.components.TextButton
+import io.element.android.libraries.designsystem.theme.components.TopAppBar
+import io.element.android.libraries.matrix.api.verification.SessionVerificationData
+import io.element.android.libraries.ui.strings.CommonStrings
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun VerifyOtherUserView(
+    state: VerifyOtherUserState,
+    modifier: Modifier = Modifier,
+) {
+    val step = state.step
+
+    BackHandler {
+        handleBack(state, step)
+    }
+
+    HeaderFooterPage(
+        modifier = modifier,
+        topBar = {
+            TopAppBar(title = {})
+        },
+        header = { VerifyOtherUserHeader(step = step) },
+        footer = { VerifyOtherUserBottomMenu(state = state) },
+    ) {
+        VerifyOtherUserContent(step = step)
+    }
+}
+
+private fun handleBack(state: VerifyOtherUserState, step: Step) {
+    when (step) {
+        Step.Initial -> state.eventSink(VerifyOtherUserEvent.Dismiss)
+        Step.RequestAccepted -> state.eventSink(VerifyOtherUserEvent.Cancel)
+        Step.WaitingForOtherUserAcceptance -> state.eventSink(VerifyOtherUserEvent.Cancel)
+        is Step.Verifying -> {
+            if (step.reply.isLoading()) {
+                // Do nothing, ignore back while we are sending the reply
+            } else {
+                state.eventSink(VerifyOtherUserEvent.DeclineChallenge)
+            }
+        }
+        Step.Completed, Step.Canceled, Step.Failed -> state.eventSink(VerifyOtherUserEvent.Dismiss)
+    }
+}
+
+@Composable
+private fun VerifyOtherUserHeader(step: Step) {
+    val iconStyle = when (step) {
+        Step.Initial -> BigIcon.Style.Default(CompoundIcons.UserProfile())
+        Step.WaitingForOtherUserAcceptance -> BigIcon.Style.Default(CompoundIcons.Devices())
+        Step.RequestAccepted -> BigIcon.Style.Default(CompoundIcons.Reaction())
+        is Step.Verifying -> BigIcon.Style.Default(CompoundIcons.Reaction())
+        Step.Completed -> BigIcon.Style.SuccessSolid
+        Step.Canceled -> BigIcon.Style.AlertSolid
+        Step.Failed -> BigIcon.Style.AlertSolid
+    }
+    val titleRes = when (step) {
+        Step.Initial -> R.string.screen_start_user_verification_title
+        Step.WaitingForOtherUserAcceptance -> R.string.screen_user_verification_waiting_other_user_title
+        Step.RequestAccepted -> R.string.screen_user_verification_ready_title
+        is Step.Verifying -> when (step.data) {
+            is SessionVerificationData.Emojis -> R.string.screen_user_verification_compare_emojis_title
+            is SessionVerificationData.Decimals -> R.string.screen_user_verification_compare_numbers_title
+        }
+        Step.Completed -> R.string.screen_user_verification_complete_title
+        Step.Canceled -> R.string.screen_user_verification_canceled_title
+        Step.Failed -> R.string.screen_user_verification_failed_title
+    }
+    val subtitleRes = when (step) {
+        Step.Initial -> R.string.screen_start_user_verification_subtitle
+        Step.WaitingForOtherUserAcceptance -> R.string.screen_user_verification_waiting_other_user_subtitle
+        Step.RequestAccepted -> R.string.screen_user_verification_ready_subtitle
+        is Step.Verifying -> when (step.data) {
+            is SessionVerificationData.Emojis -> R.string.screen_user_verification_compare_emojis_subtitle
+            is SessionVerificationData.Decimals -> R.string.screen_user_verification_compare_numbers_subtitle
+        }
+        Step.Completed -> R.string.screen_user_verification_complete_subtitle
+        Step.Canceled -> R.string.screen_user_verification_canceled_subtitle
+        Step.Failed -> R.string.screen_user_verification_failed_subtitle
+    }
+    PageTitle(
+        iconStyle = iconStyle,
+        title = stringResource(id = titleRes),
+        subtitle = stringResource(id = subtitleRes),
+    )
+}
+
+@Composable
+private fun VerifyOtherUserContent(step: Step) {
+    when (step) {
+        is Step.Verifying -> VerifyOtherUserChallengeContent(step.data)
+        Step.Initial -> Unit
+        else -> Unit
+    }
+}
+
+@Composable
+private fun VerifyOtherUserChallengeContent(data: SessionVerificationData) {
+    Box(
+        modifier = Modifier.fillMaxSize(),
+        contentAlignment = Alignment.Center,
+    ) {
+        when (data) {
+            is SessionVerificationData.Emojis -> {
+                Column(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp),
+                    horizontalAlignment = Alignment.CenterHorizontally,
+                    verticalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    data.emojis.forEach { emoji ->
+                        Row(
+                            modifier = Modifier.fillMaxWidth(),
+                            verticalAlignment = Alignment.CenterVertically,
+                            horizontalArrangement = Arrangement.spacedBy(12.dp),
+                        ) {
+                            Text(
+                                text = emoji.emoji,
+                                style = ElementTheme.typography.fontHeadingMdBold,
+                            )
+                            Text(
+                                text = emoji.description,
+                                style = ElementTheme.typography.fontBodyMdRegular,
+                            )
+                        }
+                    }
+                }
+            }
+            is SessionVerificationData.Decimals -> {
+                Column(
+                    modifier = Modifier.fillMaxWidth(),
+                    horizontalAlignment = Alignment.CenterHorizontally,
+                    verticalArrangement = Arrangement.spacedBy(16.dp),
+                ) {
+                    data.decimals.forEachIndexed { index, value ->
+                        Text(
+                            text = "${index + 1}.  $value",
+                            style = ElementTheme.typography.fontHeadingLgBold,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun VerifyOtherUserBottomMenu(state: VerifyOtherUserState) {
+    val step = state.step
+    when (step) {
+        Step.Initial -> {
+            Column(modifier = Modifier.fillMaxWidth()) {
+                Button(
+                    modifier = Modifier.fillMaxWidth(),
+                    text = stringResource(R.string.screen_start_user_verification_action),
+                    onClick = { state.eventSink(VerifyOtherUserEvent.StartVerification) },
+                )
+                InvisibleButton()
+            }
+        }
+        Step.WaitingForOtherUserAcceptance -> {
+            Column(modifier = Modifier.fillMaxWidth()) {
+                Button(
+                    modifier = Modifier.fillMaxWidth(),
+                    text = stringResource(CommonStrings.action_cancel),
+                    onClick = { state.eventSink(VerifyOtherUserEvent.Cancel) },
+                )
+                InvisibleButton()
+            }
+        }
+        Step.RequestAccepted -> {
+            Column(modifier = Modifier.fillMaxWidth()) {
+                Button(
+                    modifier = Modifier.fillMaxWidth(),
+                    text = stringResource(CommonStrings.action_cancel),
+                    onClick = { state.eventSink(VerifyOtherUserEvent.Cancel) },
+                )
+                InvisibleButton()
+            }
+        }
+        is Step.Verifying -> {
+            val isReplying = step.reply.isLoading()
+            Column(modifier = Modifier.fillMaxWidth()) {
+                Button(
+                    modifier = Modifier.fillMaxWidth(),
+                    text = if (isReplying) {
+                        stringResource(R.string.screen_user_verification_waiting_to_match)
+                    } else {
+                        stringResource(R.string.screen_user_verification_they_match)
+                    },
+                    enabled = !isReplying,
+                    showProgress = isReplying,
+                    onClick = {
+                        if (!isReplying) {
+                            state.eventSink(VerifyOtherUserEvent.AcceptChallenge)
+                        }
+                    },
+                )
+                if (isReplying) {
+                    InvisibleButton()
+                } else {
+                    TextButton(
+                        modifier = Modifier.fillMaxWidth(),
+                        text = stringResource(R.string.screen_user_verification_they_dont_match),
+                        onClick = { state.eventSink(VerifyOtherUserEvent.DeclineChallenge) },
+                    )
+                }
+            }
+        }
+        Step.Completed,
+        Step.Canceled,
+        Step.Failed -> {
+            Column(modifier = Modifier.fillMaxWidth()) {
+                Button(
+                    modifier = Modifier.fillMaxWidth(),
+                    text = stringResource(CommonStrings.action_done),
+                    onClick = { state.eventSink(VerifyOtherUserEvent.Dismiss) },
+                )
+                InvisibleButton()
+            }
+        }
+    }
+}
