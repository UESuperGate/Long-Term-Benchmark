@@ -0,0 +1,429 @@
+import {
+  SpaceSummary,
+  SpaceChildSummary,
+  SpaceInviteSummary,
+  SpaceLeaveOption,
+  MembershipState,
+  JoinActionState,
+  LeaveActionState,
+  InviteHandlingState
+} from './SpaceModels';
+
+export interface JoinRoomApi {
+  joinRoom(roomId: string): boolean;
+}
+
+export interface LeaveSpaceApi {
+  leaveSpace(spaceId: string, roomIds: string[]): boolean;
+}
+
+class DefaultJoinRoomApi implements JoinRoomApi {
+  joinRoom(_roomId: string): boolean {
+    return true;
+  }
+}
+
+class DefaultLeaveSpaceApi implements LeaveSpaceApi {
+  leaveSpace(_spaceId: string, _roomIds: string[]): boolean {
+    return true;
+  }
+}
+
+export type SpacesStateListener = () => void;
+
+export class SpacesPresenter {
+  joinRoomApi: JoinRoomApi = new DefaultJoinRoomApi();
+  leaveSpaceApi: LeaveSpaceApi = new DefaultLeaveSpaceApi();
+
+  private listeners: SpacesStateListener[] = [];
+
+  subscribe(listener: SpacesStateListener): void {
+    if (this.listeners.indexOf(listener) < 0) {
+      this.listeners.push(listener);
+    }
+  }
+
+  unsubscribe(listener: SpacesStateListener): void {
+    const idx = this.listeners.indexOf(listener);
+    if (idx >= 0) {
+      this.listeners.splice(idx, 1);
+    }
+  }
+
+  private notify(): void {
+    for (let i = 0; i < this.listeners.length; i++) {
+      const listener = this.listeners[i];
+      listener();
+    }
+  }
+
+  joinedSpaces: SpaceSummary[] = [
+    new SpaceSummary('!acme', 'Acme Space'),
+    new SpaceSummary('!engineering', 'Engineering Space')
+  ];
+  selectedSpaceId: string = '';
+
+  spaceChildren: Map<string, SpaceChildSummary[]> = new Map<string, SpaceChildSummary[]>([
+    ['!acme', [
+      new SpaceChildSummary('!acme:design', 'Design', false, false),
+      new SpaceChildSummary('!acme:eng', 'Engineering', false, true),
+      new SpaceChildSummary('!acme:dm', 'Direct Chat', true, false)
+    ]],
+    ['!engineering', [
+      new SpaceChildSummary('!engineering:backend', 'Backend', false, false),
+      new SpaceChildSummary('!engineering:frontend', 'Frontend', false, false)
+    ]]
+  ]);
+  childrenHasMore: Map<string, boolean> = new Map<string, boolean>([
+    ['!acme', true],
+    ['!engineering', false]
+  ]);
+  paginationLoading: Map<string, boolean> = new Map<string, boolean>();
+
+  joinActions: Map<string, JoinActionState> = new Map<string, JoinActionState>();
+  memberships: Map<string, MembershipState> = new Map<string, MembershipState>();
+
+  spaceInvites: SpaceInviteSummary[] = [
+    new SpaceInviteSummary('!invited', '!alice', false)
+  ];
+  inviteSeen: Set<string> = new Set<string>();
+  inviteHandling: Map<string, InviteHandlingState> = new Map<string, InviteHandlingState>();
+
+  leaveState: Map<string, LeaveActionState> = new Map<string, LeaveActionState>();
+  eligibleLeaveRooms: Map<string, SpaceLeaveOption[]> = new Map<string, SpaceLeaveOption[]>();
+  lastAdminRooms: Set<string> = new Set<string>();
+  selectedLeaveRooms: Map<string, Set<string>> = new Map<string, Set<string>>();
+  leaveDialogOpen: Map<string, boolean> = new Map<string, boolean>();
+
+  openSpace(spaceId: string): void {
+    this.selectedSpaceId = spaceId;
+    this.notify();
+  }
+
+  closeSpace(): void {
+    this.selectedSpaceId = '';
+    this.notify();
+  }
+
+  loadMoreChildren(spaceId: string, page: SpaceChildSummary[]): void {
+    if (this.paginationLoading.get(spaceId)) {
+      return;
+    }
+    this.paginationLoading.set(spaceId, true);
+    this.notify();
+
+    const existing = this.spaceChildren.get(spaceId);
+    if (existing === undefined) {
+      const fresh: SpaceChildSummary[] = [];
+      for (let i = 0; i < page.length; i++) {
+        fresh.push(page[i]);
+      }
+      this.spaceChildren.set(spaceId, fresh);
+    } else {
+      const seen: Set<string> = new Set<string>();
+      const merged: SpaceChildSummary[] = [];
+      for (let i = 0; i < existing.length; i++) {
+        const child = existing[i];
+        merged.push(child);
+        seen.add(child.roomId);
+      }
+      for (let i = 0; i < page.length; i++) {
+        const child = page[i];
+        if (!seen.has(child.roomId)) {
+          merged.push(child);
+          seen.add(child.roomId);
+        }
+      }
+      this.spaceChildren.set(spaceId, merged);
+    }
+    this.paginationLoading.set(spaceId, false);
+    this.notify();
+  }
+
+  setChildrenHasMore(spaceId: string, hasMore: boolean): void {
+    this.childrenHasMore.set(spaceId, hasMore);
+    this.notify();
+  }
+
+  setSpaceChildren(spaceId: string, children: SpaceChildSummary[]): void {
+    this.spaceChildren.set(spaceId, children);
+    this.notify();
+  }
+
+  joinChild(roomId: string): void {
+    this.joinActions.set(roomId, JoinActionState.Loading);
+    this.notify();
+
+    let ok = false;
+    try {
+      ok = this.joinRoomApi.joinRoom(roomId);
+    } catch (e) {
+      ok = false;
+    }
+
+    if (ok) {
+      this.joinActions.set(roomId, JoinActionState.Success);
+      this.memberships.set(roomId, MembershipState.Member);
+    } else {
+      this.joinActions.set(roomId, JoinActionState.Failure);
+    }
+    this.notify();
+  }
+
+  clearJoinFailure(roomId: string): void {
+    const cur = this.joinActions.get(roomId);
+    if (cur === JoinActionState.Failure) {
+      this.joinActions.set(roomId, JoinActionState.Idle);
+      this.notify();
+    }
+  }
+
+  resetJoinState(roomId: string): void {
+    this.joinActions.set(roomId, JoinActionState.Idle);
+    this.memberships.set(roomId, MembershipState.NotMember);
+    this.notify();
+  }
+
+  acceptInvite(spaceId: string): void {
+    this.inviteHandling.set(spaceId, InviteHandlingState.Accepted);
+    this.inviteSeen.add(spaceId);
+
+    const filtered: SpaceInviteSummary[] = [];
+    for (let i = 0; i < this.spaceInvites.length; i++) {
+      const invite = this.spaceInvites[i];
+      if (invite.spaceId !== spaceId) {
+        filtered.push(invite);
+      }
+    }
+    this.spaceInvites = filtered;
+
+    let alreadyJoined = false;
+    for (let i = 0; i < this.joinedSpaces.length; i++) {
+      if (this.joinedSpaces[i].spaceId === spaceId) {
+        alreadyJoined = true;
+        break;
+      }
+    }
+    if (!alreadyJoined) {
+      const next: SpaceSummary[] = [];
+      for (let i = 0; i < this.joinedSpaces.length; i++) {
+        next.push(this.joinedSpaces[i]);
+      }
+      next.push(new SpaceSummary(spaceId, spaceId));
+      this.joinedSpaces = next;
+    }
+    this.notify();
+  }
+
+  declineInvite(spaceId: string): void {
+    this.inviteHandling.set(spaceId, InviteHandlingState.Declined);
+    this.inviteSeen.add(spaceId);
+
+    const filtered: SpaceInviteSummary[] = [];
+    for (let i = 0; i < this.spaceInvites.length; i++) {
+      const invite = this.spaceInvites[i];
+      if (invite.spaceId !== spaceId) {
+        filtered.push(invite);
+      }
+    }
+    this.spaceInvites = filtered;
+    this.notify();
+  }
+
+  markInviteSeen(spaceId: string): void {
+    this.inviteSeen.add(spaceId);
+    const updated: SpaceInviteSummary[] = [];
+    for (let i = 0; i < this.spaceInvites.length; i++) {
+      const invite = this.spaceInvites[i];
+      if (invite.spaceId === spaceId) {
+        updated.push(new SpaceInviteSummary(invite.spaceId, invite.inviter, true));
+      } else {
+        updated.push(invite);
+      }
+    }
+    this.spaceInvites = updated;
+    this.notify();
+  }
+
+  openLeaveSpace(spaceId: string): void {
+    const children = this.spaceChildren.get(spaceId);
+    const eligible: SpaceLeaveOption[] = [];
+    if (children !== undefined) {
+      for (let i = 0; i < children.length; i++) {
+        const c = children[i];
+        if (c.isDirect) {
+          continue;
+        }
+        eligible.push(new SpaceLeaveOption(c.roomId, c.name, c.isLastAdmin));
+        if (c.isLastAdmin) {
+          this.lastAdminRooms.add(c.roomId);
+        }
+      }
+    }
+    this.eligibleLeaveRooms.set(spaceId, eligible);
+
+    const defaultSelected: Set<string> = new Set<string>();
+    for (let i = 0; i < eligible.length; i++) {
+      const option = eligible[i];
+      if (!option.isLastAdmin) {
+        defaultSelected.add(option.roomId);
+      }
+    }
+    this.selectedLeaveRooms.set(spaceId, defaultSelected);
+    this.leaveState.set(spaceId, LeaveActionState.Idle);
+    this.leaveDialogOpen.set(spaceId, true);
+    this.notify();
+  }
+
+  closeLeaveSpace(spaceId: string): void {
+    this.leaveDialogOpen.set(spaceId, false);
+    this.leaveState.set(spaceId, LeaveActionState.Idle);
+    this.notify();
+  }
+
+  deselectAllLeave(spaceId: string): void {
+    this.selectedLeaveRooms.set(spaceId, new Set<string>());
+    this.notify();
+  }
+
+  selectAllLeave(spaceId: string): void {
+    const eligible = this.eligibleLeaveRooms.get(spaceId);
+    const filtered: Set<string> = new Set<string>();
+    if (eligible !== undefined) {
+      for (let i = 0; i < eligible.length; i++) {
+        const option = eligible[i];
+        if (this.lastAdminRooms.has(option.roomId)) {
+          continue;
+        }
+        filtered.add(option.roomId);
+      }
+    }
+    this.selectedLeaveRooms.set(spaceId, filtered);
+    this.notify();
+  }
+
+  toggleLeaveRoom(spaceId: string, roomId: string): void {
+    if (this.lastAdminRooms.has(roomId)) {
+      return;
+    }
+    const eligible = this.eligibleLeaveRooms.get(spaceId);
+    if (eligible === undefined) {
+      return;
+    }
+    let inEligible = false;
+    for (let i = 0; i < eligible.length; i++) {
+      if (eligible[i].roomId === roomId) {
+        inEligible = true;
+        break;
+      }
+    }
+    if (!inEligible) {
+      return;
+    }
+    const selected = this.selectedLeaveRooms.get(spaceId);
+    const next: Set<string> = selected === undefined ? new Set<string>() : new Set<string>(selected);
+    if (next.has(roomId)) {
+      next.delete(roomId);
+    } else {
+      next.add(roomId);
+    }
+    this.selectedLeaveRooms.set(spaceId, next);
+    this.notify();
+  }
+
+  confirmLeave(spaceId: string): void {
+    const selected = this.selectedLeaveRooms.get(spaceId);
+    const roomIds: string[] = [];
+    if (selected !== undefined) {
+      selected.forEach((roomId: string) => {
+        roomIds.push(roomId);
+      });
+    }
+
+    this.leaveState.set(spaceId, LeaveActionState.Loading);
+    this.notify();
+
+    let ok = false;
+    try {
+      ok = this.leaveSpaceApi.leaveSpace(spaceId, roomIds);
+    } catch (e) {
+      ok = false;
+    }
+
+    if (ok) {
+      this.leaveState.set(spaceId, LeaveActionState.Success);
+      this.selectedLeaveRooms.set(spaceId, new Set<string>());
+    } else {
+      this.leaveState.set(spaceId, LeaveActionState.Failure);
+    }
+    this.notify();
+  }
+
+  getSelectedSpaceChildren(): SpaceChildSummary[] {
+    const list = this.spaceChildren.get(this.selectedSpaceId);
+    if (list === undefined) {
+      return [];
+    }
+    const copy: SpaceChildSummary[] = [];
+    for (let i = 0; i < list.length; i++) {
+      copy.push(list[i]);
+    }
+    return copy;
+  }
+
+  getJoinState(roomId: string): JoinActionState {
+    return this.joinActions.get(roomId) ?? JoinActionState.Idle;
+  }
+
+  getMembership(roomId: string): MembershipState {
+    return this.memberships.get(roomId) ?? MembershipState.NotMember;
+  }
+
+  getLeaveState(spaceId: string): LeaveActionState {
+    return this.leaveState.get(spaceId) ?? LeaveActionState.Idle;
+  }
+
+  hasMoreChildren(spaceId: string): boolean {
+    return this.childrenHasMore.get(spaceId) ?? false;
+  }
+
+  isPaginationLoading(spaceId: string): boolean {
+    return this.paginationLoading.get(spaceId) ?? false;
+  }
+
+  isInviteSeen(spaceId: string): boolean {
+    return this.inviteSeen.has(spaceId);
+  }
+
+  getInviteHandlingState(spaceId: string): InviteHandlingState {
+    return this.inviteHandling.get(spaceId) ?? InviteHandlingState.Pending;
+  }
+
+  getEligibleLeaveRooms(spaceId: string): SpaceLeaveOption[] {
+    const list = this.eligibleLeaveRooms.get(spaceId);
+    if (list === undefined) {
+      return [];
+    }
+    const copy: SpaceLeaveOption[] = [];
+    for (let i = 0; i < list.length; i++) {
+      copy.push(list[i]);
+    }
+    return copy;
+  }
+
+  getSelectedLeaveRooms(spaceId: string): Set<string> {
+    const set = this.selectedLeaveRooms.get(spaceId);
+    if (set === undefined) {
+      return new Set<string>();
+    }
+    return new Set<string>(set);
+  }
+
+  isLastAdminRoom(roomId: string): boolean {
+    return this.lastAdminRooms.has(roomId);
+  }
+
+  isLeaveDialogOpen(spaceId: string): boolean {
+    return this.leaveDialogOpen.get(spaceId) ?? false;
+  }
+}
