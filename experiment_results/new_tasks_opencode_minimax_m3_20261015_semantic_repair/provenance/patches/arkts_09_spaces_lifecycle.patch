+export enum MembershipState {
+  NotMember = 0,
+  Member = 1
+}
+
+export enum JoinActionState {
+  Idle = 0,
+  Loading = 1,
+  Failure = 2,
+  Success = 3
+}
+
+export enum LeaveActionState {
+  Idle = 0,
+  Loading = 1,
+  Failure = 2,
+  Success = 3
+}
+
+export enum InviteHandlingState {
+  Pending = 0,
+  Accepted = 1,
+  Declined = 2
+}
+
+export class SpaceSummary {
+  spaceId: string;
+  name: string;
+
+  constructor(spaceId: string, name: string) {
+    this.spaceId = spaceId;
+    this.name = name;
+  }
+}
+
+export class SpaceChildSummary {
+  roomId: string;
+  name: string;
+  isDirect: boolean;
+  isLastAdmin: boolean;
+
+  constructor(roomId: string, name: string, isDirect: boolean = false, isLastAdmin: boolean = false) {
+    this.roomId = roomId;
+    this.name = name;
+    this.isDirect = isDirect;
+    this.isLastAdmin = isLastAdmin;
+  }
+}
+
+export class SpaceInviteSummary {
+  spaceId: string;
+  inviter: string;
+  isInviteSeen: boolean;
+
+  constructor(spaceId: string, inviter: string = '', isInviteSeen: boolean = false) {
+    this.spaceId = spaceId;
+    this.inviter = inviter;
+    this.isInviteSeen = isInviteSeen;
+  }
+}
+
+export class SpaceLeaveOption {
+  roomId: string;
+  name: string;
+  isLastAdmin: boolean;
+
+  constructor(roomId: string, name: string, isLastAdmin: boolean = false) {
+    this.roomId = roomId;
+    this.name = name;
+    this.isLastAdmin = isLastAdmin;
+  }
+}
