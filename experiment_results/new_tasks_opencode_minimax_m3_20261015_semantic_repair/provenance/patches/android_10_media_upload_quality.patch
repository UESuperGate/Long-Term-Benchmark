+package io.element.android.libraries.preferences.api.store
+
+import kotlin.time.Duration
+
+/**
+ * Video compression presets offered to the user before sending a video attachment.
+ *
+ * Each preset has a target bitrate (in bits per second). The estimated size is then
+ * computed as `bitrate * duration / 8` and compared to the homeserver upload limit.
+ *
+ * `canUpload` for a preset is `true` if `estimatedSizeBytes <= maxUploadSize`.
+ */
+enum class VideoCompressionPreset(
+    val bitrate: Int,
+) {
+    LOW(bitrate = 1_000_000),
+    STANDARD(bitrate = 4_000_000),
+    HIGH(bitrate = 8_000_000);
+
+    companion object {
+        /**
+         * The default preset selected when no preference has been stored yet.
+         */
+        val DEFAULT: VideoCompressionPreset = STANDARD
+    }
+}
