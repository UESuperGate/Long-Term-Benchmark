+package io.element.android.libraries.preferences.api.store
+
+import kotlin.time.Duration
+
+/**
+ * Estimated output info for a [VideoCompressionPreset].
+ *
+ * @param preset the preset being described
+ * @param estimatedSizeBytes the expected encoded output size in bytes. `null` when the
+ *   duration is unknown so the presenter cannot fabricate a sendable size.
+ * @param canUpload `true` when the estimated size is within the homeserver upload
+ *   limit (inclusive comparison). When [estimatedSizeBytes] is `null`, this is `false`
+ *   because the client cannot prove the output would fit.
+ */
+data class VideoCompressionPresetInfo(
+    val preset: VideoCompressionPreset,
+    val estimatedSizeBytes: Long?,
+    val canUpload: Boolean,
+) {
+    companion object {
+        /**
+         * Compute the estimated output size in bytes for a given [bitrate] and [duration].
+         *
+         * Returns `null` if either the bitrate or the duration is unknown or non-positive,
+         * so callers can avoid fabricating a sendable size.
+         */
+        fun estimateSizeBytes(bitrate: Int, duration: Duration?): Long? {
+            val seconds = duration?.inWholeSeconds ?: return null
+            if (seconds <= 0L) return null
+            if (bitrate <= 0) return null
+            // bytes = bitrate * seconds / 8
+            return bitrate.toLong() * seconds / 8L
+        }
+    }
+}
