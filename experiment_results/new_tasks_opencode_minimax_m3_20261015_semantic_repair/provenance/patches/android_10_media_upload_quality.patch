+package io.element.android.libraries.mediaupload.api
+
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Loads and exposes the homeserver media upload size limit.
+ *
+ * The provider is asynchronous: while the value is being fetched, [maxUploadSize] is
+ * `null`. On a network failure the provider falls back to a stable 100 MiB default so the
+ * attachment preview remains usable and can still block oversized outputs against a
+ * sensible threshold.
+ */
+interface MediaUploadMaxSizeProvider {
+    /**
+     * The currently known homeserver upload limit in bytes, or `null` while the value
+     * has not been loaded yet.
+     */
+    val maxUploadSize: StateFlow<Long?>
+
+    /**
+     * Trigger the (idempotent) load of the homeserver upload limit if it hasn't already
+     * been started.
+     */
+    fun ensureLoaded()
+
+    companion object {
+        /**
+         * The fallback limit applied when the homeserver does not return a value.
+         *
+         * It is exactly 100 MiB (100 * 1024 * 1024 bytes), as required by the
+         * `mq_state_002_limit_fallback` invariant.
+         */
+        const val FALLBACK_MAX_UPLOAD_SIZE_BYTES: Long = 100L * 1024L * 1024L
+    }
+}
