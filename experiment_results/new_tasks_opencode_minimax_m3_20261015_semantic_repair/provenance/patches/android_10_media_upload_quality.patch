+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import org.json.JSONObject
+import timber.log.Timber
+import javax.inject.Inject
+
+@ContributesBinding(SessionScope::class)
+class DefaultMediaUploadMaxSizeProvider @Inject constructor(
+    private val matrixClient: MatrixClient,
+    @SessionCoroutineScope private val sessionCoroutineScope: CoroutineScope,
+) : MediaUploadMaxSizeProvider {
+    private val _maxUploadSize = MutableStateFlow<Long?>(null)
+    override val maxUploadSize: StateFlow<Long?> = _maxUploadSize.asStateFlow()
+
+    private val mutex = Mutex()
+    private var loadStarted = false
+
+    override fun ensureLoaded() {
+        sessionCoroutineScope.launch {
+            mutex.withLock {
+                if (loadStarted) return@withLock
+                loadStarted = true
+            }
+            try {
+                val result = matrixClient.getUrl(MEDIA_CONFIG_PATH)
+                val parsed = result.fold(
+                    onSuccess = { bytes ->
+                        runCatching { JSONObject(String(bytes)) }.getOrNull()
+                    },
+                    onFailure = {
+                        Timber.w(it, "Failed to fetch the homeserver media upload size; falling back to the default limit")
+                        null
+                    },
+                )
+                val limit = parsed?.optLongOrNull(UPLOAD_SIZE_KEY)
+                // Whether the homeserver returned a value or not, fall back to the stable
+                // default if the limit is missing, non-positive, or couldn't be parsed.
+                _maxUploadSize.value = if (limit != null && limit > 0L) {
+                    limit
+                } else {
+                    MediaUploadMaxSizeProvider.FALLBACK_MAX_UPLOAD_SIZE_BYTES
+                }
+            } catch (e: Exception) {
+                Timber.w(e, "Failed to fetch the homeserver media upload size; falling back to the default limit")
+                _maxUploadSize.value = MediaUploadMaxSizeProvider.FALLBACK_MAX_UPLOAD_SIZE_BYTES
+            }
+        }
+    }
+
+    companion object {
+        // Matrix-spec endpoint that returns the media upload configuration for the
+        // authenticated user. The JSON response contains `m.upload.size` in bytes.
+        const val MEDIA_CONFIG_PATH = "_matrix/media/v1/config"
+        const val UPLOAD_SIZE_KEY = "m.upload.size"
+    }
+}
+
+private fun JSONObject.optLongOrNull(name: String): Long? {
+    if (!has(name) || isNull(name)) return null
+    return runCatching { getLong(name) }.getOrNull()
+}
