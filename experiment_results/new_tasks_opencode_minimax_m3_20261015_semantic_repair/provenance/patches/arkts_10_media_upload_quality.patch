index 0000000..5b4e2ee
--- /dev/null
+++ b/entry/src/main/ets/features/MediaQualityFeature.ets
@@ -0,0 +1,149 @@
+// Media quality domain types, estimator, metadata loader, and preferences.
+// Owned by the attachment feature; consumed by the page to render the chooser
+// and by the presenter to validate upload eligibility.
+export enum MediaType {
+  Image = 'image',
+  Video = 'video'
+}
+
+export enum VideoPreset {
+  High = 'high',
+  Standard = 'standard',
+  Low = 'low'
+}
+
+export const VIDEO_PRESETS_IN_ORDER: VideoPreset[] = [
+  VideoPreset.High,
+  VideoPreset.Standard,
+  VideoPreset.Low
+];
+
+export const PRESET_LABELS: Record<VideoPreset, string> = {
+  [VideoPreset.High]: 'High quality',
+  [VideoPreset.Standard]: 'Standard quality',
+  [VideoPreset.Low]: 'Low quality (data saver)'
+};
+
+// Production defaults for v25.08.3. The bitrate table is configurable so that
+// the homeserver configuration or operator tooling can override it without a
+// recompile of the chooser component.
+export const DEFAULT_PRESET_BITRATES: Record<VideoPreset, number> = {
+  [VideoPreset.High]: 8000000,
+  [VideoPreset.Standard]: 4000000,
+  [VideoPreset.Low]: 1000000
+};
+
+export interface MediaMetadata {
+  mediaType: MediaType;
+  durationSeconds: number;
+  originalSize: number;
+  uri: string;
+  filename: string;
+}
+
+export interface QualityEstimation {
+  preset: VideoPreset;
+  estimatedSize: number;
+  canUpload: boolean;
+}
+
+// Estimates the encoded size for each video quality preset using the configured
+// bitrate table. The "canUpload" flag uses an inclusive comparison (<=) so a
+// preset whose estimate exactly matches the server limit is still considered
+// eligible, matching the Android client behaviour.
+export class MediaEstimator {
+  bitrates: Record<VideoPreset, number> = {
+    [VideoPreset.High]: DEFAULT_PRESET_BITRATES[VideoPreset.High],
+    [VideoPreset.Standard]: DEFAULT_PRESET_BITRATES[VideoPreset.Standard],
+    [VideoPreset.Low]: DEFAULT_PRESET_BITRATES[VideoPreset.Low]
+  };
+
+  setPresetBitrate(preset: VideoPreset, bitrate: number): void {
+    this.bitrates[preset] = bitrate;
+  }
+
+  resetPresetBitrates(): void {
+    this.bitrates[VideoPreset.High] = DEFAULT_PRESET_BITRATES[VideoPreset.High];
+    this.bitrates[VideoPreset.Standard] = DEFAULT_PRESET_BITRATES[VideoPreset.Standard];
+    this.bitrates[VideoPreset.Low] = DEFAULT_PRESET_BITRATES[VideoPreset.Low];
+  }
+
+  estimateVideo(metadata: MediaMetadata, maxUploadSize: number): QualityEstimation[] {
+    const result: QualityEstimation[] = [];
+    if (metadata.mediaType !== MediaType.Video) {
+      return result;
+    }
+    for (let i = 0; i < VIDEO_PRESETS_IN_ORDER.length; i++) {
+      const preset: VideoPreset = VIDEO_PRESETS_IN_ORDER[i];
+      const bitrate: number = this.bitrates[preset];
+      const estimatedSize: number = Math.floor((bitrate * metadata.durationSeconds) / 8);
+      const canUpload: boolean = estimatedSize <= maxUploadSize;
+      result.push({ preset, estimatedSize, canUpload });
+    }
+    return result;
+  }
+
+  estimateOptimizedImage(metadata: MediaMetadata): number {
+    // Conservative estimate for client-side optimization: ~50% of the original
+    // payload, which is what the encoder pipeline guarantees at minimum.
+    return Math.floor(metadata.originalSize * 0.5);
+  }
+}
+
+// Resolves the media metadata for a URI. In production this would invoke the
+// system media scanner; here we deterministically return a metadata object so
+// the page can render a meaningful preview while the request is in flight.
+export class MediaMetadataLoader {
+  failNextRequest: boolean = false;
+  configuredMetadata: MediaMetadata | null = null;
+
+  requestMetadata(uri: string, onResult: (metadata: MediaMetadata | null) => void): void {
+    const result: MediaMetadata | null = this.computeMetadata(uri);
+    // Defer the callback so the preview stays interactive while metadata loads.
+    Promise.resolve().then(() => {
+      onResult(result);
+    });
+  }
+
+  private computeMetadata(uri: string): MediaMetadata | null {
+    if (this.failNextRequest) {
+      this.failNextRequest = false;
+      return null;
+    }
+    if (this.configuredMetadata !== null) {
+      return this.configuredMetadata;
+    }
+    if (uri.endsWith('.mp4') || uri.indexOf('video') >= 0) {
+      return {
+        mediaType: MediaType.Video,
+        durationSeconds: 60,
+        originalSize: 50 * 1024 * 1024,
+        uri: uri,
+        filename: 'video-demo.mp4'
+      };
+    }
+    return {
+      mediaType: MediaType.Image,
+      durationSeconds: 0,
+      originalSize: 5 * 1024 * 1024,
+      uri: uri,
+      filename: 'image-demo.jpg'
+    };
+  }
+}
+
+// Persists the user's media quality defaults. The defaults are kept in-memory
+// but exposed via stable setters so the host application can wire this to the
+// preferences service or another durable store without touching the presenter.
+export class MediaQualityPreferences {
+  optimizeImages: boolean = true;
+  videoPreset: VideoPreset = VideoPreset.Standard;
+
+  setOptimizeImages(value: boolean): void {
+    this.optimizeImages = value;
+  }
+
+  setVideoPreset(preset: VideoPreset): void {
+    this.videoPreset = preset;
+  }
+}
