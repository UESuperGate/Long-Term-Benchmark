@@ -0,0 +1,35 @@
+// Homeserver upload limit discovery.
+// The server-provided limit is authoritative; this provider returns the
+// server's reported value when reachable, otherwise falls back to a stable
+// 100 MiB ceiling so the chooser can still render usable options.
+export const FALLBACK_MAX_UPLOAD_SIZE = 100 * 1024 * 1024;
+
+export interface ServerLimitRequestResult {
+  maxUploadSize: number;
+  fromFallback: boolean;
+}
+
+export class HomeserverLimitProvider {
+  failNextRequest: boolean = false;
+  configuredLimit: number | null = null;
+
+  requestLimit(onResult: (result: ServerLimitRequestResult) => void): void {
+    const computed: ServerLimitRequestResult = this.computeLimit();
+    // Defer the callback so the attachment preview stays interactive while the
+    // homeserver response is in flight.
+    Promise.resolve().then(() => {
+      onResult(computed);
+    });
+  }
+
+  private computeLimit(): ServerLimitRequestResult {
+    if (this.failNextRequest) {
+      this.failNextRequest = false;
+      return { maxUploadSize: FALLBACK_MAX_UPLOAD_SIZE, fromFallback: true };
+    }
+    if (this.configuredLimit !== null) {
+      return { maxUploadSize: this.configuredLimit, fromFallback: false };
+    }
+    return { maxUploadSize: FALLBACK_MAX_UPLOAD_SIZE, fromFallback: false };
+  }
+}
