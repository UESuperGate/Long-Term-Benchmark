+                .onClick(() => {
+                  this.openPredecessor();
+                })
+            }
+            .padding(12)
+            .backgroundColor('#EFF6FF')
+            .borderRadius(6)
+            .width('100%')
+            .alignItems(HorizontalAlign.Start)
+          }
+
+          if (this.tombstoned) {
+            Column({ space: 6 }) {
+              Text('This room was replaced')
+                .fontSize(15)
+                .fontWeight(FontWeight.Bold)
+                .fontColor('#B91C1C')
+              Text(this.successorReason.length === 0 ? 'A replacement room is available.' : this.successorReason)
+                .fontSize(13)
+                .fontColor('#64748B')
+              Button('Open replacement room')
+                .id('open_successor')
+                .width('100%')
+                .fontSize(13)
+                .backgroundColor('#1D4ED8')
+                .fontColor('#FFFFFF')
+                .onClick(() => {
+                  this.openSuccessor();
+                })
+            }
+            .padding(12)
+            .backgroundColor('#FEF2F2')
+            .borderRadius(6)
+            .width('100%')
+            .alignItems(HorizontalAlign.Start)
+          }
+
+          Text('Timeline')
+            .fontSize(18)
+            .fontWeight(FontWeight.Bold)
+            .width('100%')
+
+          if (this.history.length === 0) {
+            Text('No messages yet.')
+              .fontSize(14)
+              .fontColor('#64748B')
+              .width('100%')
+          } else {
+            ForEach(this.history, (message: string) => {
+              Text(message)
+                .padding(14)
+                .width('100%')
+                .backgroundColor('#FFFFFF')
+                .borderRadius(6)
+            }, (message: string) => message)
+          }
+
+          if (this.composerEnabled) {
+            TextInput({ text: this.composerText, placeholder: 'Write a message' })
+              .id('message_composer')
+              .onChange((value: string) => {
+                this.composerText = value;
+              })
+            Button('Send')
+              .id('send_message')
+              .enabled(this.composerText.trim().length > 0)
+              .width('100%')
+              .onClick(() => {
+                this.sendCurrent();
+              })
+          } else if (this.tombstoned) {
+            Text('This room is read-only because it has been replaced.')
+              .id('tombstone_readonly_hint')
+              .fontSize(13)
+              .fontColor('#64748B')
+              .width('100%')
+          }
+
+          Text(this.statusText)
+            .fontSize(12)
+            .fontColor('#64748B')
+            .width('100%')
+        }
+        .padding(20)
+        .width('100%')
+      }
+      .layoutWeight(1)
+    }
+    .height('100%')
+    .width('100%')
+    .backgroundColor('#F4F6F8')
+  }
+
+  private sendCurrent(): void {
+    if (this.presenter.sendMessage(this.composerText)) {
+      this.composerText = '';
+      this.statusText = 'Message sent';
+      this.refresh();
+    } else {
+      this.statusText = 'Message was rejected.';
+      this.refresh();
+    }
+  }
+
+  private openSuccessor(): void {
+    const target: string = this.successorRoomId;
+    if (target.length === 0) {
+      this.statusText = 'No replacement room available.';
+      return;
+    }
+    const opened = this.presenter.openSuccessor();
+    if (opened) {
+      this.roomId = target;
+      const params: RoomDetailParams = { roomId: target };
+      router.replaceUrl({ url: 'pages/RoomDetail', params: params });
+      this.statusText = '';
+      this.refresh();
+    } else {
+      this.statusText = 'Could not open the replacement room.';
+      this.refresh();
+    }
+  }
+
+  private openPredecessor(): void {
+    const target: string = this.predecessorRoomId;
+    if (target.length === 0) {
+      this.statusText = 'No predecessor room available.';
+      return;
+    }
+    const opened = this.presenter.openPredecessor();
+    if (opened) {
+      this.roomId = target;
+      const params: RoomDetailParams = { roomId: target };
+      router.replaceUrl({ url: 'pages/RoomDetail', params: params });
+      this.statusText = '';
+      this.refresh();
+    } else {
+      this.statusText = 'Could not open the predecessor room.';
+      this.refresh();
+    }
+  }
+}
+
+export default RoomDetail;
