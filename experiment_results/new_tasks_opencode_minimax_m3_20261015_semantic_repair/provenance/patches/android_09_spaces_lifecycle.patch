+private fun LeaveSpaceSheet(
+    state: LeaveSpaceState,
+    onDismiss: () -> Unit,
+    onSelectAll: () -> Unit,
+    onDeselectAll: () -> Unit,
+    onToggle: (RoomId) -> Unit,
+    onConfirm: () -> Unit,
+    onRetry: () -> Unit,
+    onDismissFailure: () -> Unit,
+) {
+    Column(modifier = Modifier.fillMaxSize().padding(16.dp)) {
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Text(
+                text = stringResource(R.string.screen_spaces_leave_title),
+                style = ElementTheme.typography.fontHeadingMdBold,
+                color = ElementTheme.colors.textPrimary,
+            )
+            TextButton(text = stringResource(R.string.screen_spaces_leave_action_cancel), onClick = onDismiss)
+        }
+        Spacer(modifier = Modifier.height(8.dp))
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            Button(text = stringResource(R.string.screen_spaces_leave_action_select_all), onClick = onSelectAll)
+            Button(text = stringResource(R.string.screen_spaces_leave_action_deselect_all), onClick = onDeselectAll)
+        }
+        Spacer(modifier = Modifier.height(8.dp))
+        if (state.isLoading) {
+            CircularProgressIndicator(modifier = Modifier.size(24.dp))
+        } else {
+            LazyColumn(modifier = Modifier.weight(1f)) {
+                itemsIndexed(state.children, key = { _, item -> item.roomId.value }) { _, child ->
+                    val isLastAdmin = child.roomId in state.lastAdminRoomIds
+                    val canSelect = child.canBeLeftWhenLeavingSpace
+                    val isSelected = child.roomId in state.selectedRoomIds
+                    LeaveSpaceRow(
+                        child = child,
+                        isLastAdmin = isLastAdmin,
+                        canSelect = canSelect,
+                        isSelected = isSelected,
+                        onToggle = { onToggle(child.roomId) },
+                    )
+                    HorizontalDivider()
+                }
+            }
+        }
+        Spacer(modifier = Modifier.height(8.dp))
+        when (state.leaveAction) {
+            LeaveSpaceAction.InProgress -> CircularProgressIndicator(modifier = Modifier.size(24.dp))
+            is LeaveSpaceAction.Failure -> {
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    Button(text = stringResource(R.string.screen_spaces_action_retry), onClick = onRetry)
+                    Button(text = stringResource(R.string.screen_spaces_action_dismiss), onClick = onDismissFailure)
+                }
+            }
+            else -> Button(
+                text = stringResource(R.string.screen_spaces_leave_action_leave, state.selectedRoomIds.size),
+                onClick = onConfirm,
+                enabled = state.selectedRoomIds.isNotEmpty(),
+            )
+        }
+    }
+}
+
+@Composable
+private fun LeaveSpaceRow(
+    child: SpaceChildRoomSummary,
+    isLastAdmin: Boolean,
+    canSelect: Boolean,
+    isSelected: Boolean,
+    onToggle: () -> Unit,
+) {
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(vertical = 8.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        androidx.compose.material3.Checkbox(
+            checked = isSelected,
+            onCheckedChange = { onToggle() },
+            enabled = canSelect,
+        )
+        Spacer(modifier = Modifier.width(8.dp))
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                text = child.name ?: child.roomId.value,
+                style = ElementTheme.typography.fontBodyLgRegular,
+                color = ElementTheme.colors.textPrimary,
+            )
+            if (isLastAdmin) {
+                Text(
+                    text = stringResource(R.string.screen_spaces_leave_child_last_admin),
+                    style = ElementTheme.typography.fontBodySmRegular,
+                    color = ElementTheme.colors.textSecondary,
+                )
+            } else if (child.isDirect) {
+                Text(
+                    text = stringResource(R.string.screen_spaces_leave_child_direct),
+                    style = ElementTheme.typography.fontBodySmRegular,
+                    color = ElementTheme.colors.textSecondary,
+                )
+            }
+        }
+    }
+}
