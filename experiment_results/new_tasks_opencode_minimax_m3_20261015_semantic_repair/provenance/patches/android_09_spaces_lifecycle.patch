index 0000000..6686cc8
--- /dev/null
+++ b/features/spaces/impl/src/main/kotlin/io/element/android/features/spaces/impl/SpacesPresenter.kt
@@ -0,0 +1,415 @@
+/*
+ * Copyright 2025 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.spaces.impl
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.MutableState
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.runtime.snapshotFlow
+import io.element.android.features.invite.api.InviteData
+import io.element.android.features.invite.api.SeenInvitesStore
+import io.element.android.features.invite.api.acceptdecline.AcceptDeclineInviteEvents
+import io.element.android.features.invite.api.acceptdecline.AcceptDeclineInviteState
+import io.element.android.features.spaces.api.LeaveSpaceAction
+import io.element.android.features.spaces.api.LeaveSpaceState
+import io.element.android.features.spaces.api.SpaceChildRoomSummary
+import io.element.android.features.spaces.api.SpaceSummary
+import io.element.android.features.spaces.api.SpacesEvents
+import io.element.android.features.spaces.api.SpacesState
+import io.element.android.libraries.architecture.AsyncAction
+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.room.RoomMembershipObserver
+import kotlinx.collections.immutable.toPersistentList
+import kotlinx.collections.immutable.toPersistentMap
+import kotlinx.collections.immutable.toPersistentSet
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import javax.inject.Inject
+
+/**
+ * Page size used to paginate the children of a Space.
+ */
+private const val SPACES_CHILDREN_PAGE_SIZE = 50
+
+/**
+ * Main presenter for the Spaces feature.
+ */
+class SpacesPresenter @Inject constructor(
+    private val matrixClient: MatrixClient,
+    private val dataSource: SpaceChildrenDataSource,
+    private val seenInvitesStore: SeenInvitesStore,
+    private val acceptDeclineInvitePresenter: Presenter<AcceptDeclineInviteState>,
+    private val roomMembershipObserver: RoomMembershipObserver,
+) : Presenter<SpacesState> {
+
+    @Composable
+    override fun present(): SpacesState {
+        val coroutineScope = rememberCoroutineScope()
+        val acceptDeclineInviteState = acceptDeclineInvitePresenter.present()
+
+        val joinedSpacesState: MutableState<List<SpaceSummary>> =
+            remember { mutableStateOf<List<SpaceSummary>>(emptyList()) }
+        val spaceInvitesState: MutableState<List<SpaceSummary>> =
+            remember { mutableStateOf<List<SpaceSummary>>(emptyList()) }
+        val selectedSpaceIdState: MutableState<RoomId?> =
+            remember { mutableStateOf<RoomId?>(null) }
+        val childrenState: MutableState<List<SpaceChildRoomSummary>> =
+            remember { mutableStateOf<List<SpaceChildRoomSummary>>(emptyList()) }
+        val joinActionsState: MutableState<Map<RoomId, AsyncAction<Unit>>> =
+            remember { mutableStateOf<Map<RoomId, AsyncAction<Unit>>>(emptyMap()) }
+        val acceptInviteActionsState: MutableState<Map<RoomId, AsyncAction<Unit>>> =
+            remember { mutableStateOf<Map<RoomId, AsyncAction<Unit>>>(emptyMap()) }
+        val declineInviteActionsState: MutableState<Map<RoomId, AsyncAction<Unit>>> =
+            remember { mutableStateOf<Map<RoomId, AsyncAction<Unit>>>(emptyMap()) }
+        val isLoadingChildrenState: MutableState<Boolean> =
+            remember { mutableStateOf<Boolean>(false) }
+        val hasMoreToLoadState: MutableState<Boolean> =
+            remember { mutableStateOf<Boolean>(false) }
+        val childrenTotalState: MutableState<Int?> =
+            remember { mutableStateOf<Int?>(null) }
+        val lastAdminRoomIdsState: MutableState<Set<RoomId>> =
+            remember { mutableStateOf<Set<RoomId>>(emptySet()) }
+        val selectedRoomIdsState: MutableState<Set<RoomId>> =
+            remember { mutableStateOf<Set<RoomId>>(emptySet()) }
+        val leaveActionState: MutableState<LeaveSpaceAction> =
+            remember { mutableStateOf<LeaveSpaceAction>(LeaveSpaceAction.Idle) }
+        val leaveIsLoadingState: MutableState<Boolean> =
+            remember { mutableStateOf<Boolean>(false) }
+        val leaveSpaceIdState: MutableState<RoomId?> =
+            remember { mutableStateOf<RoomId?>(null) }
+        val leaveChildrenState: MutableState<List<SpaceChildRoomSummary>> =
+            remember { mutableStateOf<List<SpaceChildRoomSummary>>(emptyList()) }
+
+        val seenSpaceInvites by remember { seenInvitesStore.seenRoomIds() }
+            .collectAsState(initial = emptySet<RoomId>())
+
+        // Forward accept/decline invite results into our state.
+        LaunchedEffect(acceptDeclineInviteState) {
+            snapshotFlow { acceptDeclineInviteState.acceptAction }
+                .onEach { action: AsyncAction<RoomId> ->
+                    when (action) {
+                        is AsyncAction.Success -> {
+                            val acceptedId = action.data
+                            acceptInviteActionsState.value =
+                                acceptInviteActionsState.value + (acceptedId to AsyncAction.Success(Unit))
+                            seenInvitesStore.markAsSeen(acceptedId)
+                        }
+                        is AsyncAction.Failure -> {
+                            Timber.e(action.error, "Accept invite failed")
+                        }
+                        else -> Unit
+                    }
+                }
+                .launchIn(this)
+        }
+        LaunchedEffect(acceptDeclineInviteState) {
+            snapshotFlow { acceptDeclineInviteState.declineAction }
+                .onEach { action: AsyncAction<RoomId> ->
+                    if (action is AsyncAction.Success) {
+                        val declinedId = action.data
+                        declineInviteActionsState.value =
+                            declineInviteActionsState.value + (declinedId to AsyncAction.Success(Unit))
+                    }
+                }
+                .launchIn(this)
+        }
+
+        // Refresh the joined spaces / invitations lists when the room list
+        // membership observer fires.
+        LaunchedEffect(Unit) {
+            roomMembershipObserver.updates
+                .onEach {
+                    refreshSpacesLists(
+                        dataSource = dataSource,
+                        joinedSpacesState = joinedSpacesState,
+                        spaceInvitesState = spaceInvitesState,
+                    )
+                }
+                .launchIn(this)
+            refreshSpacesLists(
+                dataSource = dataSource,
+                joinedSpacesState = joinedSpacesState,
+                spaceInvitesState = spaceInvitesState,
+            )
+        }
+
+        suspend fun loadFirstPage(spaceId: RoomId) {
+            isLoadingChildrenState.value = true
+            try {
+                val page = dataSource.getChildrenPage(spaceId, 0, SPACES_CHILDREN_PAGE_SIZE)
+                childrenState.value = page.items
+                childrenTotalState.value = page.total
+                hasMoreToLoadState.value = (page.total ?: Int.MAX_VALUE) > page.items.size
+            } finally {
+                isLoadingChildrenState.value = false
+            }
+        }
+
+        suspend fun loadMore(spaceId: RoomId) {
+            if (isLoadingChildrenState.value || !hasMoreToLoadState.value) return
+            isLoadingChildrenState.value = true
+            try {
+                val current = childrenState.value
+                val nextOffset = current.size
+                val page = dataSource.getChildrenPage(spaceId, nextOffset, SPACES_CHILDREN_PAGE_SIZE)
+                val existingIds = current.map { it.roomId }.toSet()
+                val appended = page.items.filter { child -> child.roomId !in existingIds }
+                childrenState.value = current + appended
+                childrenTotalState.value = page.total ?: childrenTotalState.value
+                hasMoreToLoadState.value =
+                    (page.total ?: current.size + page.items.size) > childrenState.value.size
+            } finally {
+                isLoadingChildrenState.value = false
+            }
+        }
+
+        fun handleEvents(event: SpacesEvents) {
+            when (event) {
+                is SpacesEvents.OpenSpace -> {
+                    val isNew = selectedSpaceIdState.value != event.spaceId
+                    selectedSpaceIdState.value = event.spaceId
+                    if (isNew) {
+                        childrenState.value = emptyList()
+                        childrenTotalState.value = null
+                        hasMoreToLoadState.value = false
+                        coroutineScope.launch {
+                            loadFirstPage(event.spaceId)
+                        }
+                    }
+                }
+                SpacesEvents.CloseSpace -> {
+                    selectedSpaceIdState.value = null
+                    childrenState.value = emptyList()
+                    childrenTotalState.value = null
+                    hasMoreToLoadState.value = false
+                }
+                SpacesEvents.LoadMoreChildren -> {
+                    val spaceId = selectedSpaceIdState.value ?: return
+                    coroutineScope.launch {
+                        loadMore(spaceId)
+                    }
+                }
+                is SpacesEvents.JoinChild -> joinChild(
+                    spaceId = selectedSpaceIdState.value,
+                    roomId = event.roomId,
+                    joinActionsState = joinActionsState,
+                    coroutineScope = coroutineScope,
+                )
+                is SpacesEvents.ClearJoinFailure -> {
+                    joinActionsState.value = joinActionsState.value - event.roomId
+                }
+                is SpacesEvents.RetryJoinChild -> joinChild(
+                    spaceId = selectedSpaceIdState.value,
+                    roomId = event.roomId,
+                    joinActionsState = joinActionsState,
+                    coroutineScope = coroutineScope,
+                )
+                is SpacesEvents.AcceptSpaceInvite -> {
+                    val invite = spaceInvitesState.value.firstOrNull { it.spaceId == event.spaceId }
+                    if (invite != null) {
+                        acceptDeclineInviteState.eventSink(
+                            AcceptDeclineInviteEvents.AcceptInvite(
+                                InviteData(
+                                    roomId = invite.spaceId,
+                                    roomName = invite.name ?: invite.spaceId.value,
+                                    isDm = false,
+                                )
+                            )
+                        )
+                    } else {
+                        acceptInviteActionsState.value = acceptInviteActionsState.value + (
+                            event.spaceId to AsyncAction.Failure(
+                                IllegalStateException("No matching Space invite")
+                            )
+                            )
+                    }
+                }
+                is SpacesEvents.DeclineSpaceInvite -> {
+                    val invite = spaceInvitesState.value.firstOrNull { it.spaceId == event.spaceId }
+                    if (invite != null) {
+                        acceptDeclineInviteState.eventSink(
+                            AcceptDeclineInviteEvents.DeclineInvite(
+                                invite = InviteData(
+                                    roomId = invite.spaceId,
+                                    roomName = invite.name ?: invite.spaceId.value,
+                                    isDm = false,
+                                ),
+                                blockUser = false,
+                                shouldConfirm = false,
+                            )
+                        )
+                    } else {
+                        declineInviteActionsState.value = declineInviteActionsState.value + (
+                            event.spaceId to AsyncAction.Failure(
+                                IllegalStateException("No matching Space invite")
+                            )
+                            )
+                    }
+                }
+                is SpacesEvents.MarkSpaceInviteAsSeen -> {
+                    coroutineScope.launch {
+                        seenInvitesStore.markAsSeen(event.spaceId)
+                    }
+                }
+                SpacesEvents.OpenLeaveSpace -> {
+                    val spaceId = selectedSpaceIdState.value ?: return
+                    coroutineScope.launch {
+                        leaveIsLoadingState.value = true
+                        try {
+                            val page = dataSource.getChildrenPage(spaceId, 0, Int.MAX_VALUE)
+                            val items = page.items
+                            leaveChildrenState.value = items
+                            leaveSpaceIdState.value = spaceId
+                            lastAdminRoomIdsState.value =
+                                items.filter { it.isLastAdmin }.map { it.roomId }.toSet()
+                            selectedRoomIdsState.value = items
+                                .filter { it.canBeLeftWhenLeavingSpace }
+                                .map { it.roomId }
+                                .toSet()
+                        } finally {
+                            leaveIsLoadingState.value = false
+                        }
+                    }
+                }
+                SpacesEvents.CloseLeaveSpace -> {
+                    leaveSpaceIdState.value = null
+                    leaveChildrenState.value = emptyList()
+                    lastAdminRoomIdsState.value = emptySet()
+                    selectedRoomIdsState.value = emptySet()
+                    leaveActionState.value = LeaveSpaceAction.Idle
+                }
+                SpacesEvents.SelectAllChildren -> {
+                    val eligible = leaveChildrenState.value
+                        .filter { it.canBeLeftWhenLeavingSpace }
+                        .map { it.roomId }
+                        .toSet()
+                    selectedRoomIdsState.value = eligible
+                }
+                SpacesEvents.DeselectAllChildren -> {
+                    selectedRoomIdsState.value = emptySet()
+                }
+                is SpacesEvents.ToggleChildSelection -> {
+                    // Never allow selecting a last-admin room.
+                    if (event.roomId in lastAdminRoomIdsState.value) return
+                    val isEligible = leaveChildrenState.value.any {
+                        it.roomId == event.roomId && it.canBeLeftWhenLeavingSpace
+                    }
+                    if (!isEligible) return
+                    selectedRoomIdsState.value = if (event.roomId in selectedRoomIdsState.value) {
+                        selectedRoomIdsState.value - event.roomId
+                    } else {
+                        selectedRoomIdsState.value + event.roomId
+                    }
+                }
+                SpacesEvents.ConfirmLeaveSpace -> {
+                    val toLeave = selectedRoomIdsState.value
+                    if (toLeave.isEmpty()) {
+                        leaveActionState.value = LeaveSpaceAction.Success
+                        return
+                    }
+                    leaveActionState.value = LeaveSpaceAction.InProgress
+                    coroutineScope.launch {
+                        val failures = mutableListOf<Throwable>()
+                        for (roomId in toLeave) {
+                            try {
+                                matrixClient.getRoom(roomId)?.use { room ->
+                                    room.leave().getOrThrow()
+                                }
+                            } catch (t: Throwable) {
+                                Timber.e(t, "Failed to leave room $roomId as part of leaving Space $leaveSpaceId")
+                                failures += t
+                            }
+                        }
+                        if (failures.isEmpty()) {
+                            leaveActionState.value = LeaveSpaceAction.Success
+                        } else {
+                            // Preserve the current selection so the user can retry.
+                            leaveActionState.value = LeaveSpaceAction.Failure(failures.first())
+                        }
+                    }
+                }
+                SpacesEvents.RetryLeaveSpace -> {
+                    handleEvents(SpacesEvents.ConfirmLeaveSpace)
+                }
+                SpacesEvents.DismissLeaveSpaceFailure -> {
+                    leaveActionState.value = LeaveSpaceAction.Idle
+                }
+            }
+        }
+
+        return SpacesState(
+            joinedSpaces = joinedSpacesState.value.toPersistentList(),
+            spaceInvites = spaceInvitesState.value.toPersistentList(),
+            seenSpaceInvites = seenSpaceInvites.toPersistentSet(),
+            selectedSpaceId = selectedSpaceIdState.value,
+            children = childrenState.value.toPersistentList(),
+            isLoadingChildren = isLoadingChildrenState.value,
+            hasMoreToLoad = hasMoreToLoadState.value,
+            joinActions = joinActionsState.value.toPersistentMap(),
+            acceptInviteActions = acceptInviteActionsState.value.toPersistentMap(),
+            declineInviteActions = declineInviteActionsState.value.toPersistentMap(),
+            leaveSpaceState = LeaveSpaceState(
+                spaceId = leaveSpaceIdState.value,
+                isLoading = leaveIsLoadingState.value,
+                children = leaveChildrenState.value.toPersistentList(),
+                selectedRoomIds = selectedRoomIdsState.value.toPersistentSet(),
+                lastAdminRoomIds = lastAdminRoomIdsState.value.toPersistentSet(),
+                leaveAction = leaveActionState.value,
+            ),
+            eventSink = ::handleEvents,
+        )
+    }
+
+    private fun joinChild(
+        spaceId: RoomId?,
+        roomId: RoomId,
+        joinActionsState: MutableState<Map<RoomId, AsyncAction<Unit>>>,
+        coroutineScope: CoroutineScope,
+    ) {
+        if (spaceId == null) return
+        joinActionsState.value = joinActionsState.value + (roomId to AsyncAction.Loading)
+        coroutineScope.launch {
+            try {
+                val result = matrixClient.joinRoom(roomId)
+                val action = if (result.isSuccess) {
+                    AsyncAction.Success(Unit)
+                } else {
+                    AsyncAction.Failure(result.exceptionOrNull() ?: RuntimeException("Join failed"))
+                }
+                joinActionsState.value = joinActionsState.value + (roomId to action)
+            } catch (t: Throwable) {
+                joinActionsState.value = joinActionsState.value + (roomId to AsyncAction.Failure(t))
+            }
+        }
+    }
+}
+
+private suspend fun refreshSpacesLists(
+    dataSource: SpaceChildrenDataSource,
+    joinedSpacesState: MutableState<List<SpaceSummary>>,
+    spaceInvitesState: MutableState<List<SpaceSummary>>,
+) {
+    try {
+        val joined = dataSource.getJoinedSpaces()
+        val invites = dataSource.getSpaceInvites()
+        joinedSpacesState.value = joined
+        spaceInvitesState.value = invites
+    } catch (t: Throwable) {
+        Timber.e(t, "Failed to refresh Space lists")
+    }
+}
