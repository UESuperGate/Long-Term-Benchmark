@@ -0,0 +1,77 @@
+/*
+ * Copyright 2025 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.spaces.api
+
+import androidx.compose.runtime.Immutable
+import io.element.android.libraries.architecture.AsyncAction
+import io.element.android.libraries.matrix.api.core.RoomId
+import kotlinx.collections.immutable.ImmutableList
+import kotlinx.collections.immutable.ImmutableMap
+import kotlinx.collections.immutable.ImmutableSet
+import kotlinx.collections.immutable.persistentListOf
+import kotlinx.collections.immutable.persistentMapOf
+import kotlinx.collections.immutable.persistentSetOf
+
+/**
+ * State of the Spaces feature.
+ *
+ * @property joinedSpaces the Spaces the user is currently joined to.
+ * @property spaceInvites the Spaces the user has been invited to but not joined yet.
+ * @property seenSpaceInvites the invitations the user has been shown.
+ * @property selectedSpaceId the Space currently shown in the detail view. When
+ *   not null, the user is browsing a specific Space; the selection is preserved
+ *   while children update.
+ * @property children the children of the selected Space, loaded so far.
+ * @property isLoadingChildren whether children are currently being loaded.
+ * @property hasMoreToLoad whether more children can be loaded by paginating.
+ * @property joinActions the per-child join action state. Each child has its own
+ *   progress/success/failure state, independent from the others.
+ * @property acceptInviteActions the per-space accept-invite action state.
+ * @property declineInviteActions the per-space decline-invite action state.
+ * @property leaveSpaceState the state of the leave-Space flow, if any.
+ * @property eventSink sink to dispatch [SpacesEvents] to the presenter.
+ */
+@Immutable
+data class SpacesState(
+    val joinedSpaces: ImmutableList<SpaceSummary>,
+    val spaceInvites: ImmutableList<SpaceSummary>,
+    val seenSpaceInvites: ImmutableSet<RoomId>,
+    val selectedSpaceId: RoomId?,
+    val children: ImmutableList<SpaceChildRoomSummary>,
+    val isLoadingChildren: Boolean,
+    val hasMoreToLoad: Boolean,
+    val joinActions: ImmutableMap<RoomId, AsyncAction<Unit>>,
+    val acceptInviteActions: ImmutableMap<RoomId, AsyncAction<Unit>>,
+    val declineInviteActions: ImmutableMap<RoomId, AsyncAction<Unit>>,
+    val leaveSpaceState: LeaveSpaceState,
+    val eventSink: (SpacesEvents) -> Unit,
+) {
+    companion object {
+        val Empty: SpacesState = SpacesState(
+            joinedSpaces = persistentListOf(),
+            spaceInvites = persistentListOf(),
+            seenSpaceInvites = persistentSetOf(),
+            selectedSpaceId = null,
+            children = persistentListOf(),
+            isLoadingChildren = false,
+            hasMoreToLoad = false,
+            joinActions = persistentMapOf(),
+            acceptInviteActions = persistentMapOf(),
+            declineInviteActions = persistentMapOf(),
+            leaveSpaceState = LeaveSpaceState(
+                spaceId = null,
+                isLoading = false,
+                children = persistentListOf(),
+                selectedRoomIds = persistentSetOf(),
+                lastAdminRoomIds = persistentSetOf(),
+                leaveAction = LeaveSpaceAction.Idle,
+            ),
+            eventSink = {},
+        )
+    }
+}
