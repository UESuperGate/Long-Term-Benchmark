+    seenSpaceInvites: Set<RoomId> = emptySet(),
+    selectedSpaceId: RoomId? = null,
+    children: List<SpaceChildRoomSummary> = emptyList(),
+    isLoadingChildren: Boolean = false,
+    hasMoreToLoad: Boolean = false,
+    joinActions: Map<RoomId, AsyncAction<Unit>> = emptyMap(),
+    acceptInviteActions: Map<RoomId, AsyncAction<Unit>> = emptyMap(),
+    declineInviteActions: Map<RoomId, AsyncAction<Unit>> = emptyMap(),
+    leaveSpaceState: LeaveSpaceState = aLeaveSpaceState(),
+    eventSink: (SpacesEvents) -> Unit = {},
+): SpacesState = SpacesState(
+    joinedSpaces = joinedSpaces.toPersistentList(),
+    spaceInvites = spaceInvites.toPersistentList(),
+    seenSpaceInvites = seenSpaceInvites.toPersistentSet(),
+    selectedSpaceId = selectedSpaceId,
+    children = children.toPersistentList(),
+    isLoadingChildren = isLoadingChildren,
+    hasMoreToLoad = hasMoreToLoad,
+    joinActions = joinActions.toPersistentMap(),
+    acceptInviteActions = acceptInviteActions.toPersistentMap(),
+    declineInviteActions = declineInviteActions.toPersistentMap(),
+    leaveSpaceState = leaveSpaceState,
+    eventSink = eventSink,
+)
