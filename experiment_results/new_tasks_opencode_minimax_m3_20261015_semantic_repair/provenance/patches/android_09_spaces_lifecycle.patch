+@Composable
+private fun SpacesListView(
+    state: SpacesState,
+    onSpaceClick: (RoomId) -> Unit,
+    onAcceptInvite: (RoomId) -> Unit,
+    onDeclineInvite: (RoomId) -> Unit,
+    onMarkInviteSeen: (RoomId) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val listState = rememberLazyListState()
+    val invites = state.spaceInvites
+    val joined = state.joinedSpaces
+    if (joined.isEmpty() && invites.isEmpty()) {
+        Box(modifier = modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+            Text(
+                text = stringResource(R.string.screen_spaces_no_spaces),
+                style = ElementTheme.typography.fontBodyLgRegular,
+                color = ElementTheme.colors.textPrimary,
+                textAlign = TextAlign.Center,
+                modifier = Modifier.padding(24.dp),
+            )
+        }
+        return
+    }
+    LazyColumn(modifier = modifier.fillMaxSize(), state = listState) {
+        if (invites.isNotEmpty()) {
+            item {
+                Text(
+                    text = stringResource(R.string.screen_spaces_invitations_section),
+                    style = ElementTheme.typography.fontHeadingMdBold,
+                    color = ElementTheme.colors.textPrimary,
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 12.dp),
+                )
+            }
+            itemsIndexed(invites, key = { _, item -> item.spaceId.value }) { _, invite ->
+                val acceptAction = state.acceptInviteActions[invite.spaceId]
+                val declineAction = state.declineInviteActions[invite.spaceId]
+                SpaceInviteRow(
+                    space = invite,
+                    isSeen = state.seenSpaceInvites.contains(invite.spaceId),
+                    acceptAction = acceptAction,
+                    declineAction = declineAction,
+                    onAccept = { onAcceptInvite(invite.spaceId) },
+                    onDecline = { onDeclineInvite(invite.spaceId) },
+                    onSeen = { onMarkInviteSeen(invite.spaceId) },
+                )
+                HorizontalDivider()
+            }
+        }
+        if (joined.isNotEmpty()) {
+            item {
+                Text(
+                    text = stringResource(R.string.screen_spaces_your_spaces_section),
+                    style = ElementTheme.typography.fontHeadingMdBold,
+                    color = ElementTheme.colors.textPrimary,
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 12.dp),
+                )
+            }
+            itemsIndexed(joined, key = { _, item -> item.spaceId.value }) { _, space ->
+                SpaceRow(space = space, onClick = { onSpaceClick(space.spaceId) })
+                HorizontalDivider()
+            }
+        }
+    }
+}
