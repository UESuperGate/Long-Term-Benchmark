+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.spaces.api
+
+import io.element.android.libraries.matrix.api.core.RoomId
+import kotlinx.collections.immutable.ImmutableList
+import kotlinx.collections.immutable.ImmutableSet
+
+/**
+ * State of the "leave a Space" flow, which lets the user pick which child
+ * rooms they want to leave before confirming.
+ *
+ * @property spaceId the id of the Space the user is about to leave.
+ * @property isLoading whether the children of the Space are currently being loaded.
+ * @property children the children of the Space, loaded so far.
+ * @property selectedRoomIds the rooms the user has explicitly selected to leave.
+ * @property lastAdminRoomIds the rooms where the user is the last admin. These
+ *   can never be included in the selection, even by bulk actions or toggles.
+ * @property leaveAction the progress of the leave-Space operation itself.
+ */
+data class LeaveSpaceState(
+    val spaceId: RoomId?,
+    val isLoading: Boolean,
+    val children: ImmutableList<SpaceChildRoomSummary>,
+    val selectedRoomIds: ImmutableSet<RoomId>,
+    val lastAdminRoomIds: ImmutableSet<RoomId>,
+    val leaveAction: LeaveSpaceAction,
+) {
+    /**
+     * The set of room ids that are eligible for being included in the leave
+     * selection. These exclude DMs and last-admin rooms.
+     */
+    val eligibleRoomIds: Set<RoomId>
+        get() = children.filter { it.canBeLeftWhenLeavingSpace }.map { it.roomId }.toSet()
+}
+
+/**
+ * Whether the leave-Space action is in progress, succeeded, or failed.
+ */
+sealed interface LeaveSpaceAction {
+    data object Idle : LeaveSpaceAction
+    data object InProgress : LeaveSpaceAction
+    data object Success : LeaveSpaceAction
+    data class Failure(val error: Throwable) : LeaveSpaceAction
+}
diff --git a/features/spaces/api/src/main/kotlin/io/element/android/features/spaces/api/SpaceChildRoomSummary.kt b/features/spaces/api/src/main/kotlin/io/element/android/features/spaces/api/SpaceChildRoomSummary.kt
