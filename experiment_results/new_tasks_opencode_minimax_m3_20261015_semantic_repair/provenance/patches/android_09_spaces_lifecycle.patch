+/*
+ * Copyright 2025 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.spaces.impl
+
+import io.element.android.features.spaces.api.SpaceChildRoomSummary
+import io.element.android.features.spaces.api.SpaceSummary
+import io.element.android.libraries.matrix.api.core.RoomId
+
+/**
+ * Source of truth for Space and child room data.
+ *
+ * Implementations are responsible for paginating child rooms, returning
+ * deduplicated and stable results so that the Spaces presenter can preserve
+ * scroll context and avoid duplicating entries.
+ */
+interface SpaceChildrenDataSource {
+    /** Returns the list of joined Spaces. */
+    suspend fun getJoinedSpaces(): List<SpaceSummary>
+
+    /** Returns the list of Space invitations. */
+    suspend fun getSpaceInvites(): List<SpaceSummary>
+
+    /**
+     * Returns a page of child rooms for the given [spaceId], starting at [offset].
+     *
+     * Implementations must return a stable ordering and must not return
+     * duplicates. Subsequent calls with the same offset must return the same
+     * elements to keep scroll context stable.
+     */
+    suspend fun getChildrenPage(spaceId: RoomId, offset: Int, limit: Int): ChildrenPage
+
+    /**
+     * Returns the total number of child rooms for the given [spaceId], or
+     * `null` if the total is not known yet.
+     */
+    suspend fun getChildrenTotal(spaceId: RoomId): Int?
+}
+
+data class ChildrenPage(
+    val items: List<SpaceChildRoomSummary>,
+    val total: Int?,
+)
diff --git a/features/spaces/impl/src/main/kotlin/io/element/android/features/spaces/impl/SpacesPresenter.kt b/features/spaces/impl/src/main/kotlin/io/element/android/features/spaces/impl/SpacesPresenter.kt
