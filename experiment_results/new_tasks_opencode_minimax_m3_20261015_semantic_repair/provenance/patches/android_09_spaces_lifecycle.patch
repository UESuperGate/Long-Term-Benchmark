+internal fun SpacesViewPreview(@PreviewParameter(SpacesStateProvider::class) state: SpacesState) =
+    ElementPreview {
+        SpacesView(state = state)
+    }
+
+@Preview
+@Composable
+internal fun SpacesViewA11yPreview() = ElementPreview {
+    SpacesView(state = aSpacesState())
+}
