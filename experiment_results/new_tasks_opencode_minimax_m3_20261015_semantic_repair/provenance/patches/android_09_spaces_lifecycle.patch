+@Composable
+fun SpacesView(
+    state: SpacesState,
+    modifier: Modifier = Modifier,
+    onSpaceSelected: (RoomId) -> Unit = {},
+    onRoomSelected: (RoomId) -> Unit = {},
+) {
+    Scaffold(modifier = modifier) { padding ->
+        Box(modifier = Modifier.padding(padding).fillMaxSize()) {
+            if (state.selectedSpaceId != null) {
+                SpaceDetailView(
+                    state = state,
+                    onBack = { state.eventSink(SpacesEvents.CloseSpace) },
+                    onLoadMore = { state.eventSink(SpacesEvents.LoadMoreChildren) },
+                    onJoinChild = { roomId -> state.eventSink(SpacesEvents.JoinChild(roomId)) },
+                    onClearJoinFailure = { roomId -> state.eventSink(SpacesEvents.ClearJoinFailure(roomId)) },
+                    onRetryJoinChild = { roomId -> state.eventSink(SpacesEvents.RetryJoinChild(roomId)) },
+                    onOpenLeaveSpace = { state.eventSink(SpacesEvents.OpenLeaveSpace) },
+                    onRoomSelected = onRoomSelected,
+                )
+            } else {
+                SpacesListView(
+                    state = state,
+                    onSpaceClick = { spaceId -> state.eventSink(SpacesEvents.OpenSpace(spaceId)) },
+                    onAcceptInvite = { spaceId -> state.eventSink(SpacesEvents.AcceptSpaceInvite(spaceId)) },
+                    onDeclineInvite = { spaceId -> state.eventSink(SpacesEvents.DeclineSpaceInvite(spaceId)) },
+                    onMarkInviteSeen = { spaceId -> state.eventSink(SpacesEvents.MarkSpaceInviteAsSeen(spaceId)) },
+                )
+            }
+            if (state.leaveSpaceState.spaceId != null) {
+                LeaveSpaceSheet(
+                    state = state.leaveSpaceState,
+                    onDismiss = { state.eventSink(SpacesEvents.CloseLeaveSpace) },
+                    onSelectAll = { state.eventSink(SpacesEvents.SelectAllChildren) },
+                    onDeselectAll = { state.eventSink(SpacesEvents.DeselectAllChildren) },
+                    onToggle = { roomId -> state.eventSink(SpacesEvents.ToggleChildSelection(roomId)) },
+                    onConfirm = { state.eventSink(SpacesEvents.ConfirmLeaveSpace) },
+                    onRetry = { state.eventSink(SpacesEvents.RetryLeaveSpace) },
+                    onDismissFailure = { state.eventSink(SpacesEvents.DismissLeaveSpaceFailure) },
+                )
+            }
+        }
+    }
+}
