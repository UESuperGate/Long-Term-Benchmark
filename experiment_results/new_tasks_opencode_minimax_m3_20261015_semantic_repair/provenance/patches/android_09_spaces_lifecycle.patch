@@ -0,0 +1,116 @@
+/*
+ * Copyright 2025 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.spaces.impl
+
+import io.element.android.features.spaces.api.SpaceChildRoomSummary
+import io.element.android.features.spaces.api.SpaceSummary
+import io.element.android.libraries.designsystem.components.avatar.AvatarData
+import io.element.android.libraries.designsystem.components.avatar.AvatarSize
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.room.CurrentUserMembership
+import io.element.android.libraries.matrix.api.room.isDm
+import io.element.android.libraries.matrix.api.roomlist.RoomListService
+import io.element.android.libraries.matrix.api.roomlist.RoomSummary
+import kotlinx.coroutines.flow.first
+import javax.inject.Inject
+
+/**
+ * Default [SpaceChildrenDataSource] backed by the [RoomListService].
+ *
+ * The actual list of "children" of a Space comes from the room summary stream
+ * filtered to known rooms of the session. DMs and Space rooms themselves are
+ * excluded from the list of children to keep the behaviour consistent with the
+ * requirement that direct messages are not Space children to leave.
+ */
+class DefaultSpaceChildrenDataSource @Inject constructor(
+    private val matrixClient: MatrixClient,
+    private val roomListService: RoomListService,
+) : SpaceChildrenDataSource {
+
+    override suspend fun getJoinedSpaces(): List<SpaceSummary> {
+        val summaries = roomListService.allRooms.summaries.first()
+        return summaries.mapNotNull { summary ->
+            val info = summary.info
+            if (!info.isSpace) return@mapNotNull null
+            if (info.currentUserMembership != CurrentUserMembership.JOINED) return@mapNotNull null
+            summary.toSpaceSummary()
+        }
+    }
+
+    override suspend fun getSpaceInvites(): List<SpaceSummary> {
+        val summaries = roomListService.allRooms.summaries.first()
+        return summaries.mapNotNull { summary ->
+            val info = summary.info
+            if (!info.isSpace) return@mapNotNull null
+            if (info.currentUserMembership != CurrentUserMembership.INVITED) return@mapNotNull null
+            summary.toSpaceSummary()
+        }
+    }
+
+    override suspend fun getChildrenPage(spaceId: RoomId, offset: Int, limit: Int): ChildrenPage {
+        val allSummaries = roomListService.allRooms.summaries.first()
+        val children = allSummaries
+            .asSequence()
+            // Filter to rooms that are not the space itself.
+            .filter { it.info.id != spaceId }
+            // DMs are explicitly not Space children.
+            .filter { !it.info.isDm }
+            // We only consider rooms the user is joined to.
+            .filter { it.info.currentUserMembership == CurrentUserMembership.JOINED }
+            .toList()
+
+        // Stable ordering by room id, so duplicates are impossible and scroll
+        // context is preserved across pages.
+        val sorted = children.sortedBy { it.info.id.value }
+        val page = sorted.drop(offset).take(limit)
+        val items = page.mapNotNull { summary ->
+            val info = summary.info
+            val isLastAdmin = info.creators.size == 1 &&
+                info.creators.first() == matrixClient.sessionId &&
+                info.privilegedCreatorRole
+            SpaceChildRoomSummary(
+                roomId = info.id,
+                name = info.name,
+                avatarData = AvatarData(
+                    id = info.id.value,
+                    name = info.name,
+                    url = info.avatarUrl,
+                    size = AvatarSize.RoomListItem,
+                ),
+                topic = info.topic,
+                isDirect = info.isDirect,
+                isLastAdmin = isLastAdmin,
+                isJoined = info.currentUserMembership == CurrentUserMembership.JOINED,
+                joinedMembersCount = info.joinedMembersCount,
+            )
+        }
+        return ChildrenPage(items = items, total = sorted.size)
+    }
+
+    override suspend fun getChildrenTotal(spaceId: RoomId): Int? {
+        return getChildrenPage(spaceId, offset = 0, limit = Int.MAX_VALUE).total
+    }
+
+    private fun RoomSummary.toSpaceSummary(): SpaceSummary {
+        val info = info
+        return SpaceSummary(
+            spaceId = info.id,
+            name = info.name,
+            avatarData = AvatarData(
+                id = info.id.value,
+                name = info.name,
+                url = info.avatarUrl,
+                size = AvatarSize.RoomListItem,
+            ),
+            isPublic = info.isPublic,
+            joinedMembersCount = info.joinedMembersCount,
+            topic = info.topic,
+        )
+    }
+}
