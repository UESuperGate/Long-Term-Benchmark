+/*
+ * Copyright 2025 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.spaces.api
+
+import androidx.compose.runtime.Immutable
+import io.element.android.libraries.designsystem.components.avatar.AvatarData
+import io.element.android.libraries.matrix.api.core.RoomId
+
+/**
+ * Summary of a room that is a child of a Space. Used to render the list of
+ * children inside a Space detail surface.
+ *
+ * @property roomId the id of the child room.
+ * @property name display name of the child room.
+ * @property avatarData avatar information for the child room.
+ * @property isDirect whether the child room is a direct message.
+ * @property isLastAdmin whether the current user is the last admin/owner of this room.
+ * @property isJoined whether the current user is currently joined to this room.
+ */
+@Immutable
+data class SpaceChildRoomSummary(
+    val roomId: RoomId,
+    val name: String?,
+    val avatarData: AvatarData,
+    val topic: String?,
+    val isDirect: Boolean,
+    val isLastAdmin: Boolean,
+    val isJoined: Boolean,
+    val joinedMembersCount: Long,
+) {
+    /**
+     * A child room can be explicitly left when leaving its parent Space if the
+     * user is currently joined and they are not the last admin of that room.
+     * Direct messages are explicitly excluded.
+     */
+    val canBeLeftWhenLeavingSpace: Boolean
+        get() = !isDirect && isJoined && !isLastAdmin
+}
