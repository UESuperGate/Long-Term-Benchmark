@@ -0,0 +1,69 @@
+/*
+ * Copyright 2025 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.spaces.api
+
+import io.element.android.libraries.matrix.api.core.RoomId
+
+/**
+ * Events that can be dispatched from the Spaces UI to the Spaces presenter.
+ *
+ * They cover navigation, children loading, per-child joining and leaving
+ * operations, including failure recovery.
+ */
+sealed interface SpacesEvents {
+    /** Select a Space as the currently shown one. The selection is preserved while children update. */
+    data class OpenSpace(val spaceId: RoomId) : SpacesEvents
+
+    /** Clear the current Space selection so the home shows the Spaces list again. */
+    data object CloseSpace : SpacesEvents
+
+    /** Load more child rooms for the currently selected Space. No-op if there are no more. */
+    data object LoadMoreChildren : SpacesEvents
+
+    /** Request to join a child room of the currently selected Space. */
+    data class JoinChild(val roomId: RoomId) : SpacesEvents
+
+    /** Clear a previous join failure for a child room so the user can retry. */
+    data class ClearJoinFailure(val roomId: RoomId) : SpacesEvents
+
+    /** Retry joining a child room that previously failed. */
+    data class RetryJoinChild(val roomId: RoomId) : SpacesEvents
+
+    /** Accept a Space invitation. */
+    data class AcceptSpaceInvite(val spaceId: RoomId) : SpacesEvents
+
+    /** Decline a Space invitation. */
+    data class DeclineSpaceInvite(val spaceId: RoomId) : SpacesEvents
+
+    /** Mark a Space invitation as seen, used for consistent UI state. */
+    data class MarkSpaceInviteAsSeen(val spaceId: RoomId) : SpacesEvents
+
+    /** Open the "leave Space" flow for the currently selected Space. */
+    data object OpenLeaveSpace : SpacesEvents
+
+    /** Close/dismiss the "leave Space" flow without confirming. */
+    data object CloseLeaveSpace : SpacesEvents
+
+    /** Select every eligible child room (excluding DMs and last-admin rooms). */
+    data object SelectAllChildren : SpacesEvents
+
+    /** Deselect every previously selected child room. */
+    data object DeselectAllChildren : SpacesEvents
+
+    /** Toggle the selection of a single child room. Last-admin rooms cannot be selected. */
+    data class ToggleChildSelection(val roomId: RoomId) : SpacesEvents
+
+    /** Confirm the leave-Space action with the currently selected rooms. */
+    data object ConfirmLeaveSpace : SpacesEvents
+
+    /** Retry a previously failed leave-Space action. */
+    data object RetryLeaveSpace : SpacesEvents
+
+    /** Dismiss the failure result of a leave-Space action without retrying. */
+    data object DismissLeaveSpaceFailure : SpacesEvents
+}
diff --git a/features/spaces/api/src/main/kotlin/io/element/android/features/spaces/api/SpacesState.kt b/features/spaces/api/src/main/kotlin/io/element/android/features/spaces/api/SpacesState.kt
