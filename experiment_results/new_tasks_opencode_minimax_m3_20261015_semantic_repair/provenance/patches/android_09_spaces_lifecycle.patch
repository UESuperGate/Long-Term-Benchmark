+    spaceId = spaceId,
+    isLoading = isLoading,
+    children = children.toPersistentList(),
+    selectedRoomIds = selectedRoomIds.toPersistentSet(),
+    lastAdminRoomIds = lastAdminRoomIds.toPersistentSet(),
