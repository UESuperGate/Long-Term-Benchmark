+++ b/features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomPresenter.kt
@@ -0,0 +1,181 @@
+/*
+ * Copyright 2025 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.reportroom.impl
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.MutableState
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.saveable.rememberSaveable
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedFactory
+import dagger.assisted.AssistedInject
+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.designsystem.utils.snackbar.SnackbarDispatcher
+import io.element.android.libraries.designsystem.utils.snackbar.SnackbarMessage
+import io.element.android.libraries.matrix.api.room.MatrixRoom
+import io.element.android.libraries.ui.strings.CommonStrings
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+class ReportRoomPresenter @AssistedInject constructor(
+    @Assisted private val room: MatrixRoom,
+    private val snackbarDispatcher: SnackbarDispatcher,
+) : Presenter<ReportRoomState> {
+
+    @AssistedFactory
+    interface Factory {
+        fun create(room: MatrixRoom): ReportRoomPresenter
+    }
+
+    @Composable
+    override fun present(): ReportRoomState {
+        val localCoroutineScope = rememberCoroutineScope()
+        // Saving form input across configuration changes / process death is desirable for a
+        // destructive flow where the user has typed a multi-sentence reason.
+        val reason = rememberSaveable { mutableStateOf("") }
+        val leaveRoom = rememberSaveable { mutableStateOf(false) }
+        val action: MutableState<ReportRoomAction> = remember { mutableStateOf(ReportRoomAction.Uninitialized) }
+
+        fun handleEvents(event: ReportRoomEvents) {
+            when (event) {
+                is ReportRoomEvents.UpdateReason -> {
+                    // Editing the reason MUST NOT toggle the leave preference – the toggle is independent.
+                    reason.value = event.reason
+                }
+                is ReportRoomEvents.ToggleLeaveRoom -> {
+                    // The leave preference is independent of the reason text.
+                    leaveRoom.value = event.leaveRoom
+                }
+                ReportRoomEvents.Report -> {
+                    // Prevent duplicate concurrent submissions.
+                    if (action.value is ReportRoomAction.InProgress) return
+                    when (action.value) {
+                        is ReportRoomAction.LeaveAfterReportFailed -> {
+                            // The user is re-submitting after a partial failure; only leave is pending.
+                            localCoroutineScope.runLeaveOnly(
+                                room = room,
+                                leaveRoom = leaveRoom.value,
+                                action = action,
+                                snackbarDispatcher = snackbarDispatcher,
+                            )
+                        }
+                        else -> localCoroutineScope.runFullReport(
+                            room = room,
+                            reason = reason.value.trim(),
+                            leaveRoom = leaveRoom.value,
+                            action = action,
+                            snackbarDispatcher = snackbarDispatcher,
+                        )
+                    }
+                }
+                ReportRoomEvents.Retry -> {
+                    when (val current = action.value) {
+                        is ReportRoomAction.ReportFailed -> localCoroutineScope.runFullReport(
+                            room = room,
+                            reason = reason.value.trim(),
+                            leaveRoom = leaveRoom.value,
+                            action = action,
+                            snackbarDispatcher = snackbarDispatcher,
+                        )
+                        is ReportRoomAction.LeaveAfterReportFailed -> localCoroutineScope.runLeaveOnly(
+                            room = room,
+                            leaveRoom = leaveRoom.value,
+                            action = action,
+                            snackbarDispatcher = snackbarDispatcher,
+                        )
+                        else -> Timber.w("Retry invoked in an unexpected state: $current")
+                    }
+                }
+                ReportRoomEvents.ClearError -> {
+                    // Returning to the editable state must not discard the reason or the leave choice.
+                    when (action.value) {
+                        is ReportRoomAction.ReportFailed,
+                        is ReportRoomAction.LeaveAfterReportFailed -> action.value = ReportRoomAction.Uninitialized
+                        else -> Unit
+                    }
+                }
+            }
+        }
+
+        return ReportRoomState(
+            reason = reason.value,
+            leaveRoom = leaveRoom.value,
+            action = action.value,
+            eventSink = ::handleEvents,
+        )
+    }
+}
+
+/**
+ * Walk through the report flow: report the room first; only attempt to leave the room if the report
+ * succeeded AND the leave option was toggled. Any failure leaves the state recoverable: the form
+ * values are preserved by the caller.
+ */
+internal fun CoroutineScope.runFullReport(
+    room: MatrixRoom,
+    reason: String,
+    leaveRoom: Boolean,
+    action: MutableState<ReportRoomAction>,
+    snackbarDispatcher: SnackbarDispatcher,
+) = launch {
+    action.value = ReportRoomAction.InProgress
+    val reportResult = room.reportRoom(reason = reason)
+    if (reportResult.isFailure) {
+        val error = reportResult.exceptionOrNull() ?: RuntimeException("Unknown failure")
+        Timber.e(error, "Failed to report room ${room.roomId}")
+        action.value = ReportRoomAction.ReportFailed(error)
+        return@launch
+    }
+    // Report succeeded.
+    if (!leaveRoom) {
+        action.value = ReportRoomAction.Success
+        snackbarDispatcher.post(SnackbarMessage(CommonStrings.common_report_submitted))
+        return@launch
+    }
+    val leaveResult = room.leave()
+    if (leaveResult.isFailure) {
+        val error = leaveResult.exceptionOrNull() ?: RuntimeException("Unknown failure")
+        Timber.e(error, "Reported room ${room.roomId} but failed to leave it")
+        // Surface partial failure: the report was already sent, so retry must only attempt the leave.
+        action.value = ReportRoomAction.LeaveAfterReportFailed(error)
+        return@launch
+    }
+    action.value = ReportRoomAction.Success
+    snackbarDispatcher.post(SnackbarMessage(CommonStrings.common_report_submitted))
+}
+
+/**
+ * Re-run only the leave step – the report has already been submitted successfully, so we must
+ * never re-send it.
+ */
+internal fun CoroutineScope.runLeaveOnly(
+    room: MatrixRoom,
+    leaveRoom: Boolean,
+    action: MutableState<ReportRoomAction>,
+    snackbarDispatcher: SnackbarDispatcher,
+) = launch {
+    if (!leaveRoom) {
+        // Nothing to do; the report is already done.
+        action.value = ReportRoomAction.Success
+        snackbarDispatcher.post(SnackbarMessage(CommonStrings.common_report_submitted))
+        return@launch
+    }
+    action.value = ReportRoomAction.InProgress
+    val leaveResult = room.leave()
+    if (leaveResult.isFailure) {
+        val error = leaveResult.exceptionOrNull() ?: RuntimeException("Unknown failure")
+        Timber.e(error, "Failed to leave already-reported room ${room.roomId}")
+        action.value = ReportRoomAction.LeaveAfterReportFailed(error)
+        return@launch
+    }
+    action.value = ReportRoomAction.Success
+    snackbarDispatcher.post(SnackbarMessage(CommonStrings.common_report_submitted))
+}
diff --git a/features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomState.kt b/features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomState.kt
