+open class ReportRoomStateProvider : PreviewParameterProvider<ReportRoomState> {
+    override val values: Sequence<ReportRoomState>
+        get() = sequenceOf(
+            aReportRoomState(),
+            aReportRoomState(reason = "Spam"),
+            aReportRoomState(reason = "Spam", leaveRoom = true),
+            aReportRoomState(reason = "Spam", leaveRoom = true, action = ReportRoomAction.InProgress),
+            aReportRoomState(reason = "Spam", leaveRoom = true, action = ReportRoomAction.ReportFailed(RuntimeException("boom"))),
+            aReportRoomState(
+                reason = "Spam",
+                leaveRoom = true,
+                action = ReportRoomAction.LeaveAfterReportFailed(RuntimeException("boom")),
+            ),
+            aReportRoomState(
+                reason = "Spam",
+                leaveRoom = true,
+                action = ReportRoomAction.Success,
+            ),
+        )
+}
+
+fun aReportRoomState(
+    reason: String = "",
+    leaveRoom: Boolean = false,
+    action: ReportRoomAction = ReportRoomAction.Uninitialized,
+) = ReportRoomState(
+    reason = reason,
+    leaveRoom = leaveRoom,
+    action = action,
+    eventSink = {},
+)
