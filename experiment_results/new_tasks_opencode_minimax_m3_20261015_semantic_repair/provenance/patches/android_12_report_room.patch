+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ReportRoomView(
+    state: ReportRoomState,
+    onBackClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val focusManager = LocalFocusManager.current
+    val isInProgress = state.action is ReportRoomAction.InProgress
+    val partialFailure = state.action as? ReportRoomAction.LeaveAfterReportFailed
+
+    // The "couldn't leave the room" confirmation renders as an overlay over the editable form, so
+    // the user can decide to retry without losing their input.
+    partialFailure?.let {
+        ConfirmationDialog(
+            title = stringResource(CommonStrings.screen_report_room_leave_failed_alert_title),
+            content = stringResource(CommonStrings.screen_report_room_leave_failed_alert_message),
+            submitText = stringResource(CommonStrings.action_retry),
+            cancelText = stringResource(CommonStrings.action_back),
+            destructiveSubmit = true,
+            onSubmitClick = { state.eventSink(ReportRoomEvents.Retry) },
+            onDismiss = { state.eventSink(ReportRoomEvents.ClearError) },
+        )
+    }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = {
+                    Text(
+                        text = stringResource(CommonStrings.screen_report_room_title),
+                        style = ElementTheme.typography.aliasScreenTitle,
+                    )
+                },
+                navigationIcon = { BackButton(onClick = onBackClick) }
+            )
+        },
+        modifier = modifier,
+    ) { padding ->
+        Column(
+            modifier = Modifier
+                .padding(padding)
+                .consumeWindowInsets(padding)
+                .imePadding()
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState())
+                .padding(16.dp)
+        ) {
+            Spacer(modifier = Modifier.height(20.dp))
+            TextField(
+                value = state.reason,
+                onValueChange = { state.eventSink(ReportRoomEvents.UpdateReason(it)) },
+                placeholder = stringResource(CommonStrings.screen_report_room_reason_placeholder),
+                minLines = 3,
+                enabled = !isInProgress,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .heightIn(min = 90.dp),
+                supportingText = stringResource(CommonStrings.screen_report_room_reason_footer),
+            )
+
+            Row(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(vertical = 12.dp),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                Column(
+                    modifier = Modifier.weight(1f),
+                    verticalArrangement = Arrangement.spacedBy(4.dp)
+                ) {
+                    Text(
+                        text = stringResource(R.string.screen_report_room_leave_room_label),
+                        style = ElementTheme.typography.fontBodyLgRegular,
+                    )
+                    Text(
+                        text = stringResource(R.string.screen_report_room_leave_room_hint),
+                        style = ElementTheme.typography.fontBodyMdRegular,
+                        color = ElementTheme.colors.textSecondary,
+                    )
+                }
+                Switch(
+                    enabled = !isInProgress,
+                    checked = state.leaveRoom,
+                    onCheckedChange = { state.eventSink(ReportRoomEvents.ToggleLeaveRoom(it)) },
+                )
+            }
+
+            Spacer(modifier = Modifier.height(24.dp))
+
+            val buttonText = stringResource(
+                id = when (state.action) {
+                    is ReportRoomAction.ReportFailed,
+                    is ReportRoomAction.LeaveAfterReportFailed -> CommonStrings.action_retry
+                    else -> CommonStrings.action_send
+                }
+            )
+            Button(
+                text = buttonText,
+                enabled = state.reason.isNotBlank() && !isInProgress,
+                showProgress = isInProgress,
+                onClick = {
+                    focusManager.clearFocus(force = true)
+                    state.eventSink(
+                        when (state.action) {
+                            is ReportRoomAction.ReportFailed,
+                            is ReportRoomAction.LeaveAfterReportFailed -> ReportRoomEvents.Retry
+                            else -> ReportRoomEvents.Report
+                        }
+                    )
+                },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(horizontal = 4.dp),
+            )
+
+            // Surface a non-fatal failure inline (after report failure: form values survived, just
+            // show the text below the button). For the partial-failure case we already showed an
+            // overlay dialog above.
+            if (state.action is ReportRoomAction.ReportFailed) {
+                Spacer(modifier = Modifier.height(16.dp))
+                Text(
+                    text = stringResource(R.string.screen_report_room_generic_error),
+                    color = ElementTheme.colors.textCriticalPrimary,
+                    style = ElementTheme.typography.fontBodyMdRegular,
+                    modifier = Modifier.padding(horizontal = 4.dp),
+                )
+            }
+        }
+    }
+}
+
+@PreviewsDayNight
+@Composable
+internal fun ReportRoomViewPreview(@PreviewParameter(ReportRoomStateProvider::class) state: ReportRoomState) = ElementPreview {
+    ReportRoomView(
+        state = state,
+        onBackClick = {},
+    )
+}
