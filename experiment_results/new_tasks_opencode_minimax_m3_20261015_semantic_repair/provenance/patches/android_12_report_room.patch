+
+import com.bumble.appyx.core.modality.BuildContext
+import com.bumble.appyx.core.node.Node
+import com.bumble.appyx.core.plugin.Plugin
+import com.squareup.anvil.annotations.ContributesBinding
+import io.element.android.features.reportroom.api.ReportRoomEntryPoint
+import io.element.android.libraries.architecture.createNode
+import io.element.android.libraries.di.AppScope
+import javax.inject.Inject
+
+@ContributesBinding(AppScope::class)
+class DefaultReportRoomEntryPoint @Inject constructor() : ReportRoomEntryPoint {
+    override fun nodeBuilder(parentNode: Node, buildContext: BuildContext): ReportRoomEntryPoint.NodeBuilder {
+        val plugins = ArrayList<Plugin>()
+        return object : ReportRoomEntryPoint.NodeBuilder {
+            override fun params(params: ReportRoomEntryPoint.Params): ReportRoomEntryPoint.NodeBuilder {
+                plugins += params
+                return this
+            }
+
+            override fun callback(callback: ReportRoomEntryPoint.Callback): ReportRoomEntryPoint.NodeBuilder {
+                plugins += callback
+                return this
+            }
+
+            override fun build(): Node {
+                return parentNode.createNode<ReportRoomNode>(buildContext, plugins)
+            }
+        }
+    }
+}
