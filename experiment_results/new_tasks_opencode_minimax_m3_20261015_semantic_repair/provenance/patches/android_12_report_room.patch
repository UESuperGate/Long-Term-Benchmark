+/*
+ * Copyright 2025 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.features.reportroom.impl
+
+/**
+ * State model for the Report Room flow.
+ *
+ * The form has two independent pieces of user input – [reason] (a free-form note to the homeserver
+ * admins) and [leaveRoom] (whether the user wants to also leave the room after the report is sent).
+ *
+ * The submission goes through an [action] state machine that:
+ *   - prevents duplicate concurrent reports
+ *   - performs the report first, then leaves the room only if the report succeeded
+ *   - preserves the form values across failures
+ *   - models a "reported, but leaving failed" partial-failure so retry only re-runs the leave
+ *     step without re-sending the report.
+ */
+data class ReportRoomState(
+    val reason: String,
+    val leaveRoom: Boolean,
+    val action: ReportRoomAction,
+    val eventSink: (ReportRoomEvents) -> Unit,
+)
+
+/**
+ * The current lifecycle status of the report-then-leave submission.
+ */
+sealed interface ReportRoomAction {
+    /** The user hasn't pressed "Report" yet, or the previous error has been dismissed. */
+    data object Uninitialized : ReportRoomAction
+
+    /** A report or a leave attempt is currently being sent over the network. */
+    data object InProgress : ReportRoomAction
+
+    /** The report (and optional leave) completed successfully. */
+    data object Success : ReportRoomAction
+
+    /**
+     * Sending the report failed. The form is still editable so the user can retry the full action.
+     */
+    data class ReportFailed(val error: Throwable) : ReportRoomAction
+
+    /**
+     * The report was sent successfully but the optional leave step failed. The form must remember
+     * that the report has already been submitted so a retry only attempts to leave the room.
+     */
+    data class LeaveAfterReportFailed(val error: Throwable) : ReportRoomAction
+}
