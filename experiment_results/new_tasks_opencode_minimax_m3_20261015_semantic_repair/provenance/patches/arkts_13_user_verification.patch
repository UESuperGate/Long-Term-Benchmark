+// IdentityFeature: tracks identity state for users across multiple surfaces
+// (timeline, room members, room detail, user profile). The verification
+// surface clears the violation badge via this service when a user
+// verification completes successfully; cancellation or failure does not.
+
+import { IdentityState } from './VerificationFeature';
+
+export class MemberIdentity {
+  userId: string;
+  displayName: string;
+  roomId: string;
+  identityState: IdentityState = IdentityState.Unknown;
+  lastChangedAt: number;
+
+  constructor(userId: string, displayName: string, roomId: string) {
+    this.userId = userId;
+    this.displayName = displayName;
+    this.roomId = roomId;
+    this.lastChangedAt = Date.now();
+  }
+}
+
+export type IdentityListener = (userId: string, roomId: string, state: IdentityState) => void;
+
+export class IdentityService {
+  members: Map<string, MemberIdentity> = new Map();
+  private listeners: IdentityListener[] = [];
+
+  private keyFor(userId: string, roomId: string): string {
+    return `${roomId}::${userId}`;
+  }
+
+  subscribe(listener: IdentityListener): void {
+    this.listeners.push(listener);
+  }
+
+  unsubscribe(listener: IdentityListener): void {
+    const idx = this.listeners.indexOf(listener);
+    if (idx >= 0) {
+      this.listeners.splice(idx, 1);
+    }
+  }
+
+  // Get-or-create a member identity row. Newly created rows default to
+  // Unknown so unrelated members never inherit another member's state.
+  getMember(userId: string, displayName: string, roomId: string): MemberIdentity {
+    const key = this.keyFor(userId, roomId);
+    const existing = this.members.get(key);
+    if (existing !== undefined) {
+      return existing;
+    }
+    const member = new MemberIdentity(userId, displayName, roomId);
+    this.members.set(key, member);
+    return member;
+  }
+
+  getIdentityState(userId: string, roomId: string): IdentityState {
+    const member = this.members.get(this.keyFor(userId, roomId));
+    if (member === undefined) {
+      return IdentityState.Unknown;
+    }
+    return member.identityState;
+  }
+
+  hasViolation(userId: string, roomId: string): boolean {
+    return this.getIdentityState(userId, roomId) === IdentityState.VerificationViolation;
+  }
+
+  isTrusted(userId: string, roomId: string): boolean {
+    return this.getIdentityState(userId, roomId) === IdentityState.Trusted;
+  }
+
+  // Apply an observed identity change. Only the targeted user's row is
+  // mutated, so unrelated members remain untouched.
+  observeIdentityChange(userId: string, displayName: string, roomId: string, newState: IdentityState): MemberIdentity {
+    const key = this.keyFor(userId, roomId);
+    let member = this.members.get(key);
+    if (member === undefined) {
+      member = new MemberIdentity(userId, displayName, roomId);
+    }
+    member.displayName = displayName;
+    member.identityState = newState;
+    member.lastChangedAt = Date.now();
+    this.members.set(key, member);
+    this.notify(userId, roomId, newState);
+    return member;
+  }
+
+  // Mark a user as trusted. Used by the verification success path to
+  // clear any outstanding violation badge. Cancellation or failure
+  // paths must not call this.
+  markTrusted(userId: string, displayName: string, roomId: string): MemberIdentity {
+    return this.observeIdentityChange(userId, displayName, roomId, IdentityState.Trusted);
+  }
+
+  // Raise an identity violation. Used by SDK observation when a
+  // signature stops matching for an encrypted room member.
+  raiseViolation(userId: string, displayName: string, roomId: string): MemberIdentity {
+    return this.observeIdentityChange(userId, displayName, roomId, IdentityState.VerificationViolation);
+  }
+
+  private notify(userId: string, roomId: string, state: IdentityState): void {
+    const snapshot: IdentityListener[] = this.listeners.slice();
+    for (let i = 0; i < snapshot.length; i++) {
+      snapshot[i](userId, roomId, state);
+    }
+  }
+}
