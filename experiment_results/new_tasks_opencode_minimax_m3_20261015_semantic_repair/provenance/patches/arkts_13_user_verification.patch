@@ -0,0 +1,354 @@
+// VerificationFeature: user (cross-user) and self-session verification state machine.
+//
+// The Matrix ecosystem allows one device to interactively verify the identity of
+// either the user's own other devices (self-session verification) or another
+// remote Matrix user (user verification). Both flows are routed through the
+// same underlying state machine but use distinct request types so that a user
+// profile never accidentally triggers a self-session flow and a self-session
+// flow never accidentally targets a remote user.
+
+export enum VerificationRequestType {
+  User = 'user',
+  SelfSession = 'self_session'
+}
+
+export enum VerificationState {
+  Idle = 'idle',
+  Initial = 'initial',
+  Ready = 'ready',
+  AwaitingOtherDeviceResponse = 'awaiting_other_device_response',
+  Verifying = 'verifying',
+  Completed = 'completed',
+  Canceled = 'canceled',
+  Failed = 'failed'
+}
+
+export enum VerificationFailure {
+  None = 'none',
+  SdkFailure = 'sdk_failure',
+  Network = 'network',
+  Timeout = 'timeout',
+  UserDeclined = 'user_declined',
+  RemoteCanceled = 'remote_canceled'
+}
+
+export enum IdentityState {
+  Unknown = 'unknown',
+  Trusted = 'trusted',
+  VerificationViolation = 'verification_violation'
+}
+
+export class SasChallenge {
+  emojis: string[];
+  numbers: number[];
+  otherDeviceId: string;
+  receivedAt: number;
+
+  constructor(emojis: string[], numbers: number[], otherDeviceId: string) {
+    this.emojis = emojis.slice();
+    this.numbers = numbers.slice();
+    this.otherDeviceId = otherDeviceId;
+    this.receivedAt = Date.now();
+  }
+
+  equals(other: SasChallenge | null): boolean {
+    if (other === null) {
+      return false;
+    }
+    if (this.emojis.length !== other.emojis.length) {
+      return false;
+    }
+    for (let i = 0; i < this.emojis.length; i++) {
+      if (this.emojis[i] !== other.emojis[i]) {
+        return false;
+      }
+    }
+    if (this.numbers.length !== other.numbers.length) {
+      return false;
+    }
+    for (let i = 0; i < this.numbers.length; i++) {
+      if (this.numbers[i] !== other.numbers[i]) {
+        return false;
+      }
+    }
+    if (this.otherDeviceId !== other.otherDeviceId) {
+      return false;
+    }
+    return true;
+  }
+}
+
+export type VerificationListener = (session: VerificationSession) => void;
+
+export class VerificationSession {
+  requestId: string;
+  requestType: VerificationRequestType;
+  targetUserId: string;
+  state: VerificationState = VerificationState.Idle;
+  sas: SasChallenge | null = null;
+  failure: VerificationFailure = VerificationFailure.None;
+  identityState: IdentityState = IdentityState.Unknown;
+  approveCalls: number = 0;
+  declineCalls: number = 0;
+  cancelCalls: number = 0;
+  resetCalls: number = 0;
+  createdAt: number;
+  completedAt: number | null = null;
+  private listeners: VerificationListener[] = [];
+
+  constructor(requestId: string, requestType: VerificationRequestType, targetUserId: string) {
+    this.requestId = requestId;
+    this.requestType = requestType;
+    this.targetUserId = targetUserId;
+    this.createdAt = Date.now();
+  }
+
+  subscribe(listener: VerificationListener): void {
+    this.listeners.push(listener);
+  }
+
+  unsubscribe(listener: VerificationListener): void {
+    const idx = this.listeners.indexOf(listener);
+    if (idx >= 0) {
+      this.listeners.splice(idx, 1);
+    }
+  }
+
+  private notify(): void {
+    const snapshot: VerificationListener[] = this.listeners.slice();
+    for (let i = 0; i < snapshot.length; i++) {
+      snapshot[i](this);
+    }
+  }
+
+  isActive(): boolean {
+    return this.state === VerificationState.Initial ||
+      this.state === VerificationState.Ready ||
+      this.state === VerificationState.AwaitingOtherDeviceResponse ||
+      this.state === VerificationState.Verifying;
+  }
+
+  isTerminal(): boolean {
+    return this.state === VerificationState.Completed ||
+      this.state === VerificationState.Canceled ||
+      this.state === VerificationState.Failed;
+  }
+
+  hasResponse(): boolean {
+    return this.approveCalls > 0 || this.declineCalls > 0;
+  }
+
+  // Idle -> Initial: create the request and emit it to the remote party.
+  requestVerification(): boolean {
+    if (this.state !== VerificationState.Idle) {
+      return false;
+    }
+    this.state = VerificationState.Initial;
+    this.notify();
+    return true;
+  }
+
+  // Initial -> Ready: the remote party accepted the request.
+  markAccepted(): boolean {
+    if (this.state !== VerificationState.Initial) {
+      return false;
+    }
+    this.state = VerificationState.Ready;
+    this.notify();
+    return true;
+  }
+
+  // Ready -> AwaitingOtherDeviceResponse: the SAS challenge materialised.
+  startSas(challenge: SasChallenge): boolean {
+    if (this.state !== VerificationState.Ready) {
+      return false;
+    }
+    this.sas = challenge;
+    this.state = VerificationState.AwaitingOtherDeviceResponse;
+    this.notify();
+    return true;
+  }
+
+  // AwaitingOtherDeviceResponse: store the challenge data the first time it
+  // arrives. Once a challenge is materialised and before any response is
+  // recorded, the SAS data must remain stable so the user can compare it
+  // across re-renders and additional SDK events.
+  receiveChallenge(challenge: SasChallenge): boolean {
+    if (this.state !== VerificationState.AwaitingOtherDeviceResponse) {
+      return false;
+    }
+    if (this.hasResponse()) {
+      return false;
+    }
+    if (this.sas === null) {
+      this.sas = challenge;
+      this.notify();
+    }
+    return true;
+  }
+
+  // Local accept: exactly one accept is sent, the SAS data is unchanged.
+  acceptChallenge(): boolean {
+    if (this.state !== VerificationState.AwaitingOtherDeviceResponse) {
+      return false;
+    }
+    if (this.hasResponse()) {
+      return false;
+    }
+    this.approveCalls += 1;
+    this.state = VerificationState.Verifying;
+    this.notify();
+    return true;
+  }
+
+  // Local decline: exactly one decline is sent; the user is not marked
+  // trusted by the verifier, regardless of any other state.
+  declineChallenge(): boolean {
+    if (this.state !== VerificationState.AwaitingOtherDeviceResponse) {
+      return false;
+    }
+    if (this.hasResponse()) {
+      return false;
+    }
+    this.declineCalls += 1;
+    this.state = VerificationState.Verifying;
+    this.notify();
+    return true;
+  }
+
+  // Verifying -> Completed: remote party confirmed the SAS matches. Only
+  // this path marks the user trusted and clears an outstanding verification
+  // violation badge.
+  finish(): boolean {
+    if (this.state !== VerificationState.Verifying) {
+      return false;
+    }
+    this.state = VerificationState.Completed;
+    this.completedAt = Date.now();
+    this.failure = VerificationFailure.None;
+    this.identityState = IdentityState.Trusted;
+    this.notify();
+    return true;
+  }
+
+  // Active -> Canceled: cancellation from either side ends the active
+  // request but never marks the user trusted.
+  cancel(): boolean {
+    if (!this.isActive()) {
+      return false;
+    }
+    this.cancelCalls += 1;
+    this.state = VerificationState.Canceled;
+    this.completedAt = Date.now();
+    this.notify();
+    return true;
+  }
+
+  // Active -> Failed: an SDK or transport failure ended the request. The
+  // failure is recoverable and never marks the user trusted.
+  fail(failure: VerificationFailure): boolean {
+    if (!this.isActive()) {
+      return false;
+    }
+    this.failure = failure;
+    this.state = VerificationState.Failed;
+    this.completedAt = Date.now();
+    this.notify();
+    return true;
+  }
+
+  // Canceled/Failed -> Failed (clean reset for retry). Never reaches
+  // Completed via this path; the user is not marked trusted.
+  reset(): boolean {
+    if (this.state !== VerificationState.Canceled && this.state !== VerificationState.Failed) {
+      return false;
+    }
+    this.resetCalls += 1;
+    this.state = VerificationState.Failed;
+    this.failure = VerificationFailure.None;
+    this.completedAt = null;
+    this.approveCalls = 0;
+    this.declineCalls = 0;
+    this.notify();
+    return true;
+  }
+}
+
+export type ServiceListener = (active: VerificationSession | null) => void;
+
+export class VerificationService {
+  private sessions: Map<string, VerificationSession> = new Map();
+  private userSessions: Map<string, string> = new Map();
+  private activeSessionId: string | null = null;
+  private serviceListeners: ServiceListener[] = [];
+
+  // Create a user (cross-user) verification request. Only one active
+  // user verification request can be live at a time. A self-session
+  // verification request is intentionally not created here so that
+  // profile flows never accidentally trigger it.
+  createUserVerification(targetUserId: string): VerificationSession {
+    const requestId: string = `user-${Date.now().toString(36)}-${Math.floor(Math.random() * 100000).toString(36)}`;
+    const session = new VerificationSession(requestId, VerificationRequestType.User, targetUserId);
+    this.sessions.set(requestId, session);
+    this.userSessions.set(targetUserId, requestId);
+    this.activeSessionId = requestId;
+    this.notify();
+    return session;
+  }
+
+  // Create a self-session verification request. Stored but never
+  // assigned as the active session so user verification continues to
+  // work independently.
+  createSelfSessionVerification(): VerificationSession {
+    const requestId: string = `self-${Date.now().toString(36)}-${Math.floor(Math.random() * 100000).toString(36)}`;
+    const session = new VerificationSession(requestId, VerificationRequestType.SelfSession, '');
+    this.sessions.set(requestId, session);
+    return session;
+  }
+
+  getActiveSession(): VerificationSession | null {
+    if (this.activeSessionId === null) {
+      return null;
+    }
+    const session = this.sessions.get(this.activeSessionId);
+    return session === undefined ? null : session;
+  }
+
+  getSessionForUser(targetUserId: string): VerificationSession | null {
+    const requestId = this.userSessions.get(targetUserId);
+    if (requestId === undefined) {
+      return null;
+    }
+    const session = this.sessions.get(requestId);
+    return session === undefined ? null : session;
+  }
+
+  setActive(session: VerificationSession): void {
+    this.activeSessionId = session.requestId;
+    this.notify();
+  }
+
+  clearActive(): void {
+    this.activeSessionId = null;
+    this.notify();
+  }
+
+  subscribe(listener: ServiceListener): void {
+    this.serviceListeners.push(listener);
+  }
+
+  unsubscribe(listener: ServiceListener): void {
+    const idx = this.serviceListeners.indexOf(listener);
+    if (idx >= 0) {
+      this.serviceListeners.splice(idx, 1);
+    }
+  }
+
+  private notify(): void {
