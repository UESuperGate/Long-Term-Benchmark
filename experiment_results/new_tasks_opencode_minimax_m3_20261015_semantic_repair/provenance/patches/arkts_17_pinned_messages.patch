+// -----------------------------------------------------------------------------
+// RoomStore: central state holder + simulated server backend
+// -----------------------------------------------------------------------------
+
+export class RoomStore {
+  private static _instance: RoomStore | null = null;
+
+  state: RoomState;
+  pinnedList: PinnedListViewState;
+  diagnostics: RoomStoreDiagnostics;
+
+  // Server-authoritative datasets
+  private serverPinned: PinnedEvent[];
+  private serverTimeline: RoomEvent[];
+
+  private readonly INITIAL_PAGE_SIZE: number = 5;
+  private readonly MORE_PAGE_SIZE: number = 3;
+  private readonly LOAD_LATENCY_MS: number = 140;
+  private readonly UNPIN_LATENCY_MS: number = 200;
+
+  // Failure injection: marks an upcoming async operation to fail
+  private failureForNextLoad: boolean;
+  private failureForUnpin: Set<string>;
+
+  private listeners: StoreListener[];
+
+  private constructor() {
+    this.state = new RoomState('room_design', 'Design team', 12);
+    this.pinnedList = new PinnedListViewState();
+    this.diagnostics = new RoomStoreDiagnostics(this);
+    this.serverPinned = [];
+    this.serverTimeline = [];
+    this.failureForNextLoad = false;
+    this.failureForUnpin = new Set<string>();
+    this.listeners = [];
+
+    this.seedServerData();
+    this.applyServerToState();
+  }
+
+  static shared(): RoomStore {
+    if (RoomStore._instance === null) {
+      RoomStore._instance = new RoomStore();
+    }
+    return RoomStore._instance;
+  }
+
+  // ---------- Listeners ----------
+
+  addListener(listener: StoreListener): void {
+    if (this.listeners.indexOf(listener) < 0) {
+      this.listeners.push(listener);
+    }
+  }
+
+  removeListener(listener: StoreListener): void {
+    const idx = this.listeners.indexOf(listener);
+    if (idx >= 0) {
+      this.listeners.splice(idx, 1);
+    }
+  }
+
+  notifyChanged(): void {
+    const snapshot = this.listeners.slice();
+    for (let i = 0; i < snapshot.length; i++) {
+      try {
+        snapshot[i].onStoreChanged();
+      } catch (e) {
+        // listener errors must not poison the store
+      }
+    }
+  }
+
+  // ---------- Server data ----------
+
+  private seedServerData(): void {
+    const now: number = Date.now();
+
+    // Pinned events in server-authoritative order (newest pin first).
+    this.serverPinned = [
+      new PinnedEvent('$welcome', 'Welcome to the room', 'Alice', now - 86400000, now - 3600000, 'Alice'),
+      new PinnedEvent('$rules', 'Please read the room rules', 'Bob', now - 86400000, now - 7200000, 'Bob'),
+      new PinnedEvent('$guidelines', 'Code of conduct guidelines', 'Carol', now - 86400000, now - 10800000, 'Carol'),
+      new PinnedEvent('$schedule', 'Sprint planning at 10:00 UTC', 'Dave', now - 86400000, now - 14400000, 'Dave'),
+      new PinnedEvent('$a', 'Alpha', 'Alice', now - 3600000, now - 1800000, 'Alice'),
+      new PinnedEvent('$b', 'Beta', 'Bob', now - 1800000, now - 900000, 'Bob'),
+      new PinnedEvent('$redacted_1', 'Message redacted', 'Eve', now - 7200000, now - 7000000, 'Eve'),
+      new PinnedEvent('$unavailable_1', 'Message unavailable', 'Frank', now - 7300000, now - 7100000, 'Frank'),
+    ];
+    this.serverPinned[6].isRedacted = true;
+    this.serverPinned[7].isUnavailable = true;
+
+    // Room timeline (some events share IDs with pinned items so the
+    // "view in timeline" navigation can find them in the room history).
+    this.serverTimeline = [
+      new RoomEvent('msg_1', 'Hey team, design review at 3pm', 'Alice', now - 7200000),
+      new RoomEvent('$welcome', 'Welcome to the room', 'Alice', now - 86400000),
+      new RoomEvent('msg_2', 'I will join from home today', 'Bob', now - 10800000),
+      new RoomEvent('$rules', 'Please read the room rules', 'Bob', now - 86400000),
+      new RoomEvent('msg_3', 'New mockups are ready', 'Carol', now - 14400000),
+      new RoomEvent('$guidelines', 'Code of conduct guidelines', 'Carol', now - 86400000),
+      new RoomEvent('$a', 'Alpha', 'Alice', now - 3600000),
+      new RoomEvent('$b', 'Beta', 'Bob', now - 1800000),
+      new RoomEvent('msg_4', 'Quick sync tomorrow morning?', 'Dave', now - 18000000),
+      new RoomEvent('$schedule', 'Sprint planning at 10:00 UTC', 'Dave', now - 86400000),
+      new RoomEvent('msg_5', 'I updated the spec', 'Eve', now - 7200000),
+    ];
+
+    // Server is authoritative for permissions: default deny.
+    this.state.canPinUnpin = false;
+  }
+
+  private applyServerToState(): void {
+    this.state.pinnedEvents = [];
+    for (let i = 0; i < this.serverPinned.length; i++) {
+      this.state.pinnedEvents.push(this.serverPinned[i]);
+    }
+    this.state.timeline = [];
+    for (let i = 0; i < this.serverTimeline.length; i++) {
+      this.state.timeline.push(this.serverTimeline[i]);
+    }
+    if (this.state.bannerIndex >= this.state.pinnedEvents.length) {
+      this.state.bannerIndex = 0;
+    }
+  }
+
+  // ---------- Permissions ----------
+
+  setCanPinUnpin(can: boolean): void {
+    if (this.state.canPinUnpin === can) {
+      return;
+    }
+    this.state.canPinUnpin = can;
+    this.notifyChanged();
+  }
+
+  // ---------- Banner ----------
+
+  hasPinnedMessages(): boolean {
+    return this.state.hasPinnedMessages();
+  }
+
+  pinnedCount(): number {
+    return this.state.pinnedEvents.length;
+  }
+
+  currentBanner(): PinnedEvent | null {
+    return this.state.currentBanner();
+  }
+
+  moveToNextBanner(): void {
+    this.state.moveToNextBanner();
+    this.notifyChanged();
+  }
+
+  // ---------- Focus / view in timeline ----------
+
+  focusEventInTimeline(eventId: string): void {
+    if (this.state.focusedEventId === eventId) {
+      return;
+    }
+    this.state.focusedEventId = eventId;
+    this.notifyChanged();
+  }
+
+  clearFocus(): void {
+    if (this.state.focusedEventId === null) {
+      return;
+    }
+    this.state.focusedEventId = null;
+    this.notifyChanged();
+  }
+
+  // ---------- Pinned list: lifecycle ----------
+
+  beginPinnedList(): void {
+    this.pinnedList = new PinnedListViewState();
+    this.pinnedList.listState = PinnedListState.LOADING;
+    this.notifyChanged();
+  }
+
+  async loadInitialPinnedPage(): Promise<void> {
+    this.pinnedList.listState = PinnedListState.LOADING;
+    this.pinnedList.items = [];
+    this.pinnedList.hasMore = false;
+    this.pinnedList.loadingMore = false;
+    this.pinnedList.loadFailureMessage = '';
+    this.pinnedList.unpinStatus = UnpinStatus.IDLE;
+    this.pinnedList.unpinFailureEventId = '';
+    this.pinnedList.unpinFailureMessage = '';
+    this.notifyChanged();
+
+    const startedAt: number = Date.now();
+    await this.delay(this.LOAD_LATENCY_MS);
+    this.pinnedList.lastLoadDurationMs = Date.now() - startedAt;
+
+    if (this.failureForNextLoad) {
+      this.failureForNextLoad = false;
+      this.pinnedList.listState = PinnedListState.FAILED;
+      this.pinnedList.loadFailureMessage = 'Unable to load pinned messages';
+      this.notifyChanged();
+      return;
+    }
+
+    const initial = this.serverPinned.slice(0, this.INITIAL_PAGE_SIZE);
+    const items: PinnedEvent[] = [];
+    for (let i = 0; i < initial.length; i++) {
+      items.push(initial[i]);
+    }
+    this.pinnedList.items = items;
+    this.pinnedList.hasMore = this.serverPinned.length > this.INITIAL_PAGE_SIZE;
+
+    if (items.length === 0) {
+      this.pinnedList.listState = PinnedListState.EMPTY;
+    } else {
+      this.pinnedList.listState = PinnedListState.FILLED;
+    }
+    this.notifyChanged();
+  }
+
+  async loadMorePinned(): Promise<void> {
+    if (this.pinnedList.listState !== PinnedListState.FILLED) {
+      return;
+    }
+    if (this.pinnedList.loadingMore) {
+      return;
+    }
+    if (!this.pinnedList.hasMore) {
+      return;
+    }
+
+    this.pinnedList.loadingMore = true;
+    this.notifyChanged();
+
+    await this.delay(this.LOAD_LATENCY_MS);
+
+    if (this.failureForNextLoad) {
+      this.failureForNextLoad = false;
+      this.pinnedList.loadingMore = false;
+      this.pinnedList.loadFailureMessage = 'Unable to load more pinned messages';
+      this.notifyChanged();
+      return;
+    }
+
+    const existing: Set<string> = new Set<string>();
+    for (let i = 0; i < this.pinnedList.items.length; i++) {
+      existing.add(this.pinnedList.items[i].eventId);
+    }
+
+    const startIdx: number = this.pinnedList.items.length;
+    const newItems: PinnedEvent[] = [];
+    let added: number = 0;
+    for (let i = startIdx; i < this.serverPinned.length && added < this.MORE_PAGE_SIZE; i++) {
+      const candidate: PinnedEvent = this.serverPinned[i];
+      if (!existing.has(candidate.eventId)) {
+        newItems.push(candidate);
+        existing.add(candidate.eventId);
+        added++;
+      }
+    }
+
+    for (let i = 0; i < newItems.length; i++) {
+      this.pinnedList.items.push(newItems[i]);
+    }
+
+    this.pinnedList.hasMore = (startIdx + newItems.length) < this.serverPinned.length;
+    this.pinnedList.loadingMore = false;
+    this.pinnedList.loadFailureMessage = '';
+    this.notifyChanged();
+  }
+
+  // ---------- Unpin ----------
+
+  async unpinEvent(eventId: string): Promise<void> {
+    if (this.pinnedList.unpinStatus === UnpinStatus.IN_FLIGHT) {
+      return;
+    }
+    if (!this.state.canPinUnpin) {
+      // Without permission, do nothing. The UI must not even surface the
+      // control, but this guards against any caller bypassing the UI gate.
+      return;
+    }
+
+    // Capture whether the target is in the current view so we can decide
+    // whether to clear the in-flight marker if the operation fails.
+    const wasVisible: boolean = this.pinnedList.items.some(e => e.eventId === eventId);
+
+    this.pinnedList.unpinStatus = UnpinStatus.IN_FLIGHT;
+    this.pinnedList.unpinFailureEventId = eventId;
+    this.pinnedList.unpinFailureMessage = '';
+    this.notifyChanged();
+
+    await this.delay(this.UNPIN_LATENCY_MS);
+
+    if (this.failureForUnpin.has(eventId)) {
+      this.failureForUnpin.delete(eventId);
+      this.pinnedList.unpinStatus = UnpinStatus.FAILED;
+      this.pinnedList.unpinFailureMessage = 'Server could not unpin the message';
+      // The item is intentionally NOT removed from either the server or the
+      // view state. It remains visible and the user gets a recovery bar.
+      this.notifyChanged();
+      return;
+    }
+
+    // Authoritative server removal.
+    const serverIdx: number = this.findPinnedIndex(this.serverPinned, eventId);
+    if (serverIdx >= 0) {
+      this.serverPinned.splice(serverIdx, 1);
+    }
+
+    // Mirror into the view list while preserving the server order of all
+    // unrelated items.
+    const listIdx: number = this.findPinnedIndex(this.pinnedList.items, eventId);
+    if (listIdx >= 0) {
+      this.pinnedList.items.splice(listIdx, 1);
+    }
+
+    // Reflect into the room state so the banner and the timeline stay in
+    // sync.
+    this.applyServerToState();
+
+    if (this.pinnedList.items.length === 0 && this.pinnedList.listState === PinnedListState.FILLED) {
+      this.pinnedList.listState = PinnedListState.EMPTY;
+    }
+
+    this.pinnedList.unpinStatus = UnpinStatus.SUCCESS;
+    this.pinnedList.unpinFailureEventId = '';
+    // Reference to silence unused warnings on small builds.
+    if (!wasVisible) {
+      // Item was not on screen; still removed from server above.
+    }
+    this.notifyChanged();
+  }
+
+  dismissUnpinFailure(): void {
+    this.pinnedList.unpinStatus = UnpinStatus.IDLE;
+    this.pinnedList.unpinFailureEventId = '';
+    this.pinnedList.unpinFailureMessage = '';
+    this.notifyChanged();
+  }
+
+  retryLastFailedUnpin(): void {
+    const eventId: string = this.pinnedList.unpinFailureEventId;
+    if (eventId.length === 0) {
+      return;
+    }
+    if (this.pinnedList.unpinStatus === UnpinStatus.IN_FLIGHT) {
+      return;
+    }
+    this.unpinEvent(eventId);
+  }
+
+  // ---------- Failure injection (diagnostics) ----------
+
+  markNextLoadForFailure(): void {
+    this.failureForNextLoad = true;
+  }
+
+  markUnpinForFailure(eventId: string): void {
+    this.failureForUnpin.add(eventId);
+  }
+
+  clearFailureInjections(): void {
+    this.failureForNextLoad = false;
+    this.failureForUnpin.clear();
+  }
+
+  // ---------- Helpers ----------
+
+  private findPinnedIndex(list: PinnedEvent[], eventId: string): number {
+    for (let i = 0; i < list.length; i++) {
+      if (list[i].eventId === eventId) {
+        return i;
+      }
+    }
+    return -1;
+  }
+
+  private delay(ms: number): Promise<void> {
+    return new Promise<void>((resolve) => {
+      setTimeout(resolve, ms);
+    });
   }
 }
