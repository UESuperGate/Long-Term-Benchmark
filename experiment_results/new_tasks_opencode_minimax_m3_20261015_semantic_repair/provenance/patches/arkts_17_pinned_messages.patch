diff --git a/entry/src/main/ets/pages/PinnedMessagesPage.ets b/entry/src/main/ets/pages/PinnedMessagesPage.ets
new file mode 100644
index 0000000..b8ce4d8
--- /dev/null
+++ b/entry/src/main/ets/pages/PinnedMessagesPage.ets
@@ -0,0 +1,329 @@
+import router from '@ohos.router';
+import {
+  PinnedEvent,
+  PinnedListState,
+  RoomStore,
+  StoreListener,
+  UnpinStatus
+} from '../features/PinnedMessagesBase';
+
+@Entry
+@Component
+struct PinnedMessagesPage {
+  @State private storeVersion: number = 0;
+  private storeListener: StoreListener = new StoreListener(() => {
+    this.storeVersion = this.storeVersion + 1;
+  });
+
+  aboutToAppear(): void {
+    RoomStore.shared().addListener(this.storeListener);
+    // Start loading the initial page of the pinned collection. We kick off
+    // the load unconditionally so re-entries (e.g. after retry) reload.
+    RoomStore.shared().loadInitialPinnedPage();
+  }
+
+  aboutToDisappear(): void {
+    RoomStore.shared().removeListener(this.storeListener);
+  }
+
+  onPageHide(): void {
+    // Make sure no transient failure bar is left lingering if the user
+    // backgrounds the app or navigates elsewhere unexpectedly.
+    RoomStore.shared().dismissUnpinFailure();
+  }
+
+  build() {
+    Column() {
+      this.PageHeader()
+
+      if (RoomStore.shared().pinnedList.listState === PinnedListState.LOADING) {
+        this.LoadingState()
+      } else if (RoomStore.shared().pinnedList.listState === PinnedListState.EMPTY) {
+        this.EmptyState()
+      } else if (RoomStore.shared().pinnedList.listState === PinnedListState.FILLED) {
+        this.FilledState()
+      } else if (RoomStore.shared().pinnedList.listState === PinnedListState.FAILED) {
+        this.FailedState()
+      } else {
+        this.LoadingState()
+      }
+    }
+    .height('100%')
+    .width('100%')
+    .backgroundColor('#F4F6F8')
+    .id('pinned_messages_page')
+  }
+
+  // ---------------------------------------------------------------------------
+  // Page header with back navigation
+  // ---------------------------------------------------------------------------
+
+  @Builder
+  PageHeader() {
+    Row({ space: 12 }) {
+      Button('Back')
+        .onClick(() => this.navigateBack())
+        .id('pinned_back')
+        .height(32)
+      Text('Pinned messages')
+        .fontSize(18)
+        .fontWeight(FontWeight.Bold)
+        .layoutWeight(1)
+      Text(`${RoomStore.shared().pinnedCount()} total`)
+        .fontSize(12)
+        .fontColor('#64748B')
+    }
+    .padding({ left: 16, right: 16, top: 16, bottom: 12 })
+    .width('100%')
+    .backgroundColor('#FFFFFF')
+    .id('pinned_messages_header')
+  }
+
+  // ---------------------------------------------------------------------------
+  // State branches
+  // ---------------------------------------------------------------------------
+
+  @Builder
+  LoadingState() {
+    Column({ space: 12 }) {
+      Progress({ value: 0, total: 100, type: ProgressType.Ring })
+        .width(36)
+        .height(36)
+        .color('#067A68')
+      Text('Loading pinned messages...')
+        .fontSize(14)
+        .fontColor('#64748B')
+    }
+    .layoutWeight(1)
+    .width('100%')
+    .justifyContent(FlexAlign.Center)
+    .alignItems(HorizontalAlign.Center)
+    .id('pinned_loading')
+  }
+
+  @Builder
+  EmptyState() {
+    Column({ space: 12 }) {
+      Text('No pinned messages')
+        .fontSize(16)
+        .fontColor('#64748B')
+      Text('Pinned messages will appear here once a member pins them.')
+        .fontSize(13)
+        .fontColor('#94A3B8')
+        .textAlign(TextAlign.Center)
+    }
+    .layoutWeight(1)
+    .width('100%')
+    .padding(24)
+    .justifyContent(FlexAlign.Center)
+    .alignItems(HorizontalAlign.Center)
+    .id('pinned_empty')
+  }
+
+  @Builder
+  FailedState() {
+    Column({ space: 12 }) {
+      Text('Could not load pinned messages')
+        .fontSize(16)
+        .fontColor('#B91C1C')
+        .fontWeight(FontWeight.Medium)
+      Text(RoomStore.shared().pinnedList.loadFailureMessage.length > 0
+        ? RoomStore.shared().pinnedList.loadFailureMessage
+        : 'Please try again.')
+        .fontSize(13)
+        .fontColor('#64748B')
+        .textAlign(TextAlign.Center)
+      Button('Retry')
+        .onClick(() => {
+          RoomStore.shared().loadInitialPinnedPage();
+        })
+        .id('pinned_retry')
+    }
+    .layoutWeight(1)
+    .width('100%')
+    .padding(24)
+    .justifyContent(FlexAlign.Center)
+    .alignItems(HorizontalAlign.Center)
+    .id('pinned_failed')
+  }
+
+  @Builder
+  FilledState() {
+    Column() {
+      List({ space: 0 }) {
+        ForEach(RoomStore.shared().pinnedList.items, (item: PinnedEvent) => {
+          ListItem() {
+            this.ItemRow(item)
+          }
+        }, (item: PinnedEvent) => item.eventId)
+
+        if (RoomStore.shared().pinnedList.hasMore) {
+          ListItem() {
+            this.LoadMoreRow()
+          }
+        }
+      }
+      .layoutWeight(1)
+      .width('100%')
+      .backgroundColor('#FFFFFF')
+      .id('pinned_list')
+
+      if (RoomStore.shared().pinnedList.unpinStatus === UnpinStatus.FAILED
+          && RoomStore.shared().pinnedList.unpinFailureEventId.length > 0) {
+        this.UnpinFailureBar()
+      }
+    }
+    .layoutWeight(1)
+    .width('100%')
+  }
+
+  // ---------------------------------------------------------------------------
+  // List item
+  // ---------------------------------------------------------------------------
+
+  @Builder
+  ItemRow(item: PinnedEvent) {
+    Row() {
+      Column({ space: 6 }) {
+        Row({ space: 6 }) {
+          Text(item.sender)
+            .fontSize(13)
+            .fontColor('#64748B')
+            .layoutWeight(1)
+          Text(`pinned by ${item.pinnedBy}`)
+            .fontSize(11)
+            .fontColor('#94A3B8')
+        }
+        .width('100%')
+
+        if (item.isRedacted) {
+          Text('[Message redacted]')
+            .fontSize(15)
+            .fontColor('#94A3B8')
+            .width('100%')
+        } else if (item.isUnavailable) {
+          Text('[Message unavailable]')
+            .fontSize(15)
+            .fontColor('#94A3B8')
+            .width('100%')
+        } else {
+          Text(item.body)
+            .fontSize(15)
+            .lineHeight(21)
+            .width('100%')
+        }
+      }
+      .layoutWeight(1)
+      .alignItems(HorizontalAlign.Start)
+
+      Column({ space: 6 }) {
+        Button('View in timeline')
+          .onClick(() => this.viewInTimeline(item))
+          .id(`pinned_view_in_timeline_${item.eventId}`)
+          .height(28)
+          .fontSize(12)
+
+        if (RoomStore.shared().state.canPinUnpin) {
+          Button(RoomStore.shared().pinnedList.unpinStatus === UnpinStatus.IN_FLIGHT
+            && RoomStore.shared().pinnedList.unpinFailureEventId === item.eventId
+            ? 'Unpinning...' : 'Unpin')
+            .onClick(() => this.unpinItem(item))
+            .id(`pinned_unpin_${item.eventId}`)
+            .height(28)
+            .fontSize(12)
+            .enabled(!(RoomStore.shared().pinnedList.unpinStatus === UnpinStatus.IN_FLIGHT
+              && RoomStore.shared().pinnedList.unpinFailureEventId === item.eventId))
+            .backgroundColor(RoomStore.shared().pinnedList.unpinStatus === UnpinStatus.IN_FLIGHT
+              && RoomStore.shared().pinnedList.unpinFailureEventId === item.eventId
+              ? '#94A3B8' : '#DC2626')
+        }
+      }
+      .alignItems(HorizontalAlign.End)
+      .margin({ left: 12 })
+    }
+    .padding(14)
+    .width('100%')
+    .backgroundColor(RoomStore.shared().pinnedList.unpinStatus === UnpinStatus.IN_FLIGHT
+      && RoomStore.shared().pinnedList.unpinFailureEventId === item.eventId
+      ? '#F1F5F9' : '#FFFFFF')
+    .id(`pinned_message_${item.eventId}`)
+  }
+
+  // ---------------------------------------------------------------------------
+  // Load more row
+  // ---------------------------------------------------------------------------
+
+  @Builder
+  LoadMoreRow() {
+    Column() {
+      if (RoomStore.shared().pinnedList.loadingMore) {
+        Progress({ value: 0, total: 100, type: ProgressType.Ring })
+          .width(24)
+          .height(24)
+          .color('#067A68')
+      } else {
+        Button('Load more')
+          .onClick(() => {
+            RoomStore.shared().loadMorePinned();
+          })
+          .id('pinned_load_more')
+          .height(32)
+      }
+    }
+    .padding(12)
+    .width('100%')
+    .alignItems(HorizontalAlign.Center)
+    .id('pinned_load_more_row')
+  }
+
+  // ---------------------------------------------------------------------------
+  // Unpin failure recovery bar
+  // ---------------------------------------------------------------------------
+
+  @Builder
+  UnpinFailureBar() {
+    Row({ space: 12 }) {
+      Text(RoomStore.shared().pinnedList.unpinFailureMessage.length > 0
+        ? RoomStore.shared().pinnedList.unpinFailureMessage
+        : 'Could not unpin')
+        .fontSize(13)
+        .fontColor('#B91C1C')
+        .layoutWeight(1)
+      Button('Retry')
+        .onClick(() => {
+          RoomStore.shared().retryLastFailedUnpin();
+        })
+        .id('pinned_unpin_retry')
+        .height(28)
+        .fontSize(12)
+      Button('Dismiss')
+        .onClick(() => {
+          RoomStore.shared().dismissUnpinFailure();
+        })
+        .id('pinned_unpin_dismiss')
+        .height(28)
+        .fontSize(12)
+    }
+    .padding(12)
+    .width('100%')
+    .backgroundColor('#FEE2E2')
+    .id('pinned_unpin_failure_bar')
+  }
+
+  // ---------------------------------------------------------------------------
+  // Actions
+  // ---------------------------------------------------------------------------
+
+  viewInTimeline(item: PinnedEvent): void {
+    RoomStore.shared().focusEventInTimeline(item.eventId);
+    router.back();
+  }
+
+  unpinItem(item: PinnedEvent): void {
+    RoomStore.shared().unpinEvent(item.eventId);
+  }
+
+  navigateBack(): void {
+    router.back();
+  }
+}
