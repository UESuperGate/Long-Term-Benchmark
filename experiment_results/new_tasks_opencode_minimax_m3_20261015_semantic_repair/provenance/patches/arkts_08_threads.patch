@@ -0,0 +1,560 @@
+import { RoomSendState } from './RoomTimelineFeature';
+
+export enum ComposerSurface {
+  Room = 'room',
+  Thread = 'thread',
+  AttachmentPreview = 'attachment_preview',
+  LocationPicker = 'location_picker',
+  VoiceRecorder = 'voice_recorder',
+  PollComposer = 'poll_composer',
+  DebugConsole = 'debug_console'
+}
+
+export enum ThreadAttachmentKind {
+  Image = 'image',
+  Voice = 'voice',
+  Location = 'location',
+  Poll = 'poll'
+}
+
+export class ThreadAttachment {
+  attachmentId: string = '';
+  caption: string = '';
+  kind: ThreadAttachmentKind = ThreadAttachmentKind.Image;
+
+  constructor(attachmentId: string, caption: string, kind: ThreadAttachmentKind) {
+    this.attachmentId = attachmentId;
+    this.caption = caption;
+    this.kind = kind;
+  }
+}
+
+export class ThreadVoiceMessage {
+  voiceId: string = '';
+  durationMs: number = 0;
+
+  constructor(voiceId: string, durationMs: number) {
+    this.voiceId = voiceId;
+    this.durationMs = durationMs;
+  }
+}
+
+export class ThreadLocationShare {
+  latitude: number = 0;
+  longitude: number = 0;
+  description: string = '';
+
+  constructor(latitude: number, longitude: number, description: string) {
+    this.latitude = latitude;
+    this.longitude = longitude;
+    this.description = description;
+  }
+}
+
+export class ThreadPoll {
+  question: string = '';
+  options: string[] = [];
+
+  constructor(question: string, options: string[]) {
+    this.question = question;
+    this.options = options;
+  }
+}
+
+export interface ThreadFailurePayload {
+  body: string;
+  replyTargetId: string | null;
+  attachment: ThreadAttachment | null;
+  voice: ThreadVoiceMessage | null;
+  location: ThreadLocationShare | null;
+  poll: ThreadPoll | null;
+}
+
+function createEmptyFailure(): ThreadFailurePayload {
+  return {
+    body: '',
+    replyTargetId: null,
+    attachment: null,
+    voice: null,
+    location: null,
+    poll: null
+  };
+}
+
+export class ThreadTimelineGateway {
+  failNextRequest: boolean = false;
+  failNextFocus: boolean = false;
+
+  lastBody: string = '';
+  lastThreadRootId: string = '';
+  lastReplyTargetId: string = '';
+  lastAttachmentId: string = '';
+  lastAttachmentCaption: string = '';
+  lastAttachmentKind: string = '';
+  lastVoiceId: string = '';
+  lastVoiceDuration: number = 0;
+  lastLocationLat: number = 0;
+  lastLocationLng: number = 0;
+  lastPollQuestion: string = '';
+
+  reset(): void {
+    this.lastBody = '';
+    this.lastThreadRootId = '';
+    this.lastReplyTargetId = '';
+    this.lastAttachmentId = '';
+    this.lastAttachmentCaption = '';
+    this.lastAttachmentKind = '';
+    this.lastVoiceId = '';
+    this.lastVoiceDuration = 0;
+    this.lastLocationLat = 0;
+    this.lastLocationLng = 0;
+    this.lastPollQuestion = '';
+  }
+
+  sendThreadMessage(rootEventId: string, replyTargetId: string | null, body: string): boolean {
+    if (this.failNextRequest) {
+      this.failNextRequest = false;
+      return false;
+    }
+    this.lastThreadRootId = rootEventId;
+    this.lastReplyTargetId = replyTargetId === null ? '' : replyTargetId;
+    this.lastBody = body;
+    return true;
+  }
+
+  sendThreadAttachment(rootEventId: string, replyTargetId: string | null, attachment: ThreadAttachment): boolean {
+    if (this.failNextRequest) {
+      this.failNextRequest = false;
+      return false;
+    }
+    this.lastThreadRootId = rootEventId;
+    this.lastReplyTargetId = replyTargetId === null ? '' : replyTargetId;
+    this.lastAttachmentId = attachment.attachmentId;
+    this.lastAttachmentCaption = attachment.caption;
+    this.lastAttachmentKind = attachment.kind;
+    return true;
+  }
+
+  sendThreadVoice(rootEventId: string, replyTargetId: string | null, voice: ThreadVoiceMessage): boolean {
+    if (this.failNextRequest) {
+      this.failNextRequest = false;
+      return false;
+    }
+    this.lastThreadRootId = rootEventId;
+    this.lastReplyTargetId = replyTargetId === null ? '' : replyTargetId;
+    this.lastVoiceId = voice.voiceId;
+    this.lastVoiceDuration = voice.durationMs;
+    return true;
+  }
+
+  sendThreadLocation(rootEventId: string, replyTargetId: string | null, location: ThreadLocationShare): boolean {
+    if (this.failNextRequest) {
+      this.failNextRequest = false;
+      return false;
+    }
+    this.lastThreadRootId = rootEventId;
+    this.lastReplyTargetId = replyTargetId === null ? '' : replyTargetId;
+    this.lastLocationLat = location.latitude;
+    this.lastLocationLng = location.longitude;
+    return true;
+  }
+
+  sendThreadPoll(rootEventId: string, replyTargetId: string | null, poll: ThreadPoll): boolean {
+    if (this.failNextRequest) {
+      this.failNextRequest = false;
+      return false;
+    }
+    this.lastThreadRootId = rootEventId;
+    this.lastReplyTargetId = replyTargetId === null ? '' : replyTargetId;
+    this.lastPollQuestion = poll.question;
+    return true;
+  }
+
+  focusEvent(rootEventId: string, eventId: string, visibleIds: string[]): boolean {
+    if (this.failNextFocus) {
+      this.failNextFocus = false;
+      return false;
+    }
+    return visibleIds.indexOf(eventId) >= 0;
+  }
+}
+
+export class ThreadTimelineStoreEntry {
+  rootEventId: string = '';
+  replies: string[] = [];
+
+  constructor(rootEventId: string, replies: string[]) {
+    this.rootEventId = rootEventId;
+    this.replies = replies;
+  }
+}
+
+class ThreadTemplateRegistry {
+  welcome: ThreadTimelineStoreEntry = new ThreadTimelineStoreEntry('$welcome', ['$welcome:reply-launch']);
+  roadmap: ThreadTimelineStoreEntry = new ThreadTimelineStoreEntry('$roadmap', ['$roadmap:reply-q3']);
+  root: ThreadTimelineStoreEntry = new ThreadTimelineStoreEntry('$root', ['$reply']);
+  missing: ThreadTimelineStoreEntry = new ThreadTimelineStoreEntry('$missing', []);
+  fallback: ThreadTimelineStoreEntry = new ThreadTimelineStoreEntry('default', ['default:reply-1']);
+}
+
+const THREAD_TEMPLATES: ThreadTemplateRegistry = new ThreadTemplateRegistry();
+
+function lookupThreadEntries(rootEventId: string): ThreadTimelineStoreEntry {
+  if (rootEventId === '$welcome') {
+    return THREAD_TEMPLATES.welcome;
+  }
+  if (rootEventId === '$roadmap') {
+    return THREAD_TEMPLATES.roadmap;
+  }
+  if (rootEventId === '$root') {
+    return THREAD_TEMPLATES.root;
+  }
+  if (rootEventId === '$missing') {
+    return THREAD_TEMPLATES.missing;
+  }
+  return new ThreadTimelineStoreEntry(rootEventId, THREAD_TEMPLATES.fallback.replies);
+}
+
+export class ThreadTimelinePresenter {
+  readonly gateway: ThreadTimelineGateway;
+
+  isOpen: boolean = false;
+  threadRootId: string = '';
+
+  events: string[] = [];
+  visibleEvents: string[] = [];
+  focusedEventId: string | null = null;
+
+  composerText: string = '';
+  sendState: RoomSendState = RoomSendState.Idle;
+  replyTargetId: string | null = null;
+  attempts: number = 0;
+  lastFailure: ThreadFailurePayload | null = null;
+
+  composerSurface: ComposerSurface = ComposerSurface.Room;
+  pendingAttachment: ThreadAttachment | null = null;
+  pendingVoice: ThreadVoiceMessage | null = null;
+  pendingLocation: ThreadLocationShare | null = null;
+  pendingPoll: ThreadPoll | null = null;
+  lastSentBody: string = '';
+  lastSentReplyTargetId: string = '';
+
+  constructor(gateway: ThreadTimelineGateway) {
+    this.gateway = gateway;
+  }
+
+  openThread(rootEventId: string): void {
+    const seed: ThreadTimelineStoreEntry = lookupThreadEntries(rootEventId);
+    this.threadRootId = rootEventId;
+    this.isOpen = true;
+    const seedEvents: string[] = [seed.rootEventId].concat(seed.replies);
+    this.events = seedEvents;
+    this.visibleEvents = seedEvents.slice();
+    this.focusedEventId = null;
+    this.composerText = '';
+    this.sendState = RoomSendState.Idle;
+    this.replyTargetId = null;
+    this.attempts = 0;
+    this.lastFailure = null;
+    this.composerSurface = ComposerSurface.Thread;
+    this.pendingAttachment = null;
+    this.pendingVoice = null;
+    this.pendingLocation = null;
+    this.pendingPoll = null;
+    this.lastSentBody = '';
+    this.lastSentReplyTargetId = '';
+  }
+
+  closeThread(): void {
+    this.isOpen = false;
+    this.threadRootId = '';
+    this.events = [];
+    this.visibleEvents = [];
+    this.focusedEventId = null;
+    this.composerText = '';
+    this.sendState = RoomSendState.Idle;
+    this.replyTargetId = null;
+    this.attempts = 0;
+    this.lastFailure = null;
+    this.composerSurface = ComposerSurface.Room;
+    this.pendingAttachment = null;
+    this.pendingVoice = null;
+    this.pendingLocation = null;
+    this.pendingPoll = null;
+    this.lastSentBody = '';
+    this.lastSentReplyTargetId = '';
+  }
+
+  focusEvent(eventId: string): boolean {
+    if (this.events.indexOf(eventId) < 0) {
+      // Out-of-window focus does not corrupt the current thread.
+      return false;
+    }
+    const succeeded: boolean = this.gateway.focusEvent(this.threadRootId, eventId, this.visibleEvents);
+    if (!succeeded) {
+      return false;
+    }
+    this.focusedEventId = eventId;
+    return true;
+  }
+
+  focusEventFailed(eventId: string): boolean {
+    if (this.events.indexOf(eventId) < 0) {
+      // Out-of-window focus never corrupts the existing thread timeline.
+      return false;
+    }
+    const succeeded: boolean = this.gateway.focusEvent(this.threadRootId, eventId, this.visibleEvents);
+    if (!succeeded) {
+      return false;
+    }
+    this.focusedEventId = eventId;
+    return true;
+  }
+
+  setComposerText(value: string): void {
+    this.composerText = value;
+  }
+
+  setReplyTarget(eventId: string | null): void {
+    if (eventId === null) {
+      this.replyTargetId = null;
+      return;
+    }
+    this.replyTargetId = eventId;
+  }
+
+  cancelReply(): void {
+    this.replyTargetId = null;
+  }
+
+  dismissFailure(): void {
+    this.lastFailure = null;
+    this.sendState = RoomSendState.Idle;
+  }
+
+  openNestedSurface(surface: ComposerSurface): void {
+    if (!this.isOpen) {
+      return;
+    }
+    this.composerSurface = surface;
+  }
+
+  returnToThread(): void {
+    if (!this.isOpen) {
+      this.composerSurface = ComposerSurface.Room;
+      return;
+    }
+    this.composerSurface = ComposerSurface.Thread;
+  }
+
+  sendMessage(): boolean {
+    const body: string = this.composerText.trim();
+    if (body.length === 0 || !this.isOpen) {
+      return false;
+    }
+    const succeeded: boolean = this.gateway.sendThreadMessage(this.threadRootId, this.replyTargetId, body);
+    if (succeeded) {
+      this.sendState = RoomSendState.Success;
+      this.events = this.events.concat(body);
+      this.visibleEvents = this.visibleEvents.concat(body);
+      this.lastSentBody = body;
+      this.lastSentReplyTargetId = this.replyTargetId === null ? '' : this.replyTargetId;
+      this.composerText = '';
+      this.replyTargetId = null;
+      this.lastFailure = null;
+    } else {
+      this.sendState = RoomSendState.Failure;
+      this.attempts += 1;
+      const failure: ThreadFailurePayload = createEmptyFailure();
+      failure.body = body;
+      failure.replyTargetId = this.replyTargetId;
+      this.lastFailure = failure;
+    }
+    return succeeded;
+  }
+
+  sendAttachment(attachment: ThreadAttachment): boolean {
+    if (!this.isOpen) {
+      return false;
+    }
+    const succeeded: boolean = this.gateway.sendThreadAttachment(this.threadRootId, this.replyTargetId, attachment);
+    const rendered: string = 'attachment:' + attachment.attachmentId;
+    if (succeeded) {
+      this.sendState = RoomSendState.Success;
+      this.events = this.events.concat(rendered);
+      this.visibleEvents = this.visibleEvents.concat(rendered);
+      this.replyTargetId = null;
+      this.lastFailure = null;
+      this.pendingAttachment = null;
+    } else {
+      this.sendState = RoomSendState.Failure;
+      this.attempts += 1;
+      const failure: ThreadFailurePayload = createEmptyFailure();
+      failure.replyTargetId = this.replyTargetId;
+      failure.attachment = attachment;
+      this.lastFailure = failure;
+      this.pendingAttachment = attachment;
+    }
+    return succeeded;
+  }
+
+  sendVoice(voice: ThreadVoiceMessage): boolean {
+    if (!this.isOpen) {
+      return false;
+    }
+    const succeeded: boolean = this.gateway.sendThreadVoice(this.threadRootId, this.replyTargetId, voice);
+    const rendered: string = 'voice:' + voice.voiceId;
+    if (succeeded) {
+      this.sendState = RoomSendState.Success;
+      this.events = this.events.concat(rendered);
+      this.visibleEvents = this.visibleEvents.concat(rendered);
+      this.replyTargetId = null;
+      this.lastFailure = null;
+      this.pendingVoice = null;
+    } else {
+      this.sendState = RoomSendState.Failure;
+      this.attempts += 1;
+      const failure: ThreadFailurePayload = createEmptyFailure();
+      failure.replyTargetId = this.replyTargetId;
+      failure.voice = voice;
+      this.lastFailure = failure;
+      this.pendingVoice = voice;
+    }
+    return succeeded;
+  }
+
+  sendLocation(location: ThreadLocationShare): boolean {
+    if (!this.isOpen) {
+      return false;
+    }
+    const succeeded: boolean = this.gateway.sendThreadLocation(this.threadRootId, this.replyTargetId, location);
+    const rendered: string = 'location:' + location.description;
+    if (succeeded) {
+      this.sendState = RoomSendState.Success;
+      this.events = this.events.concat(rendered);
+      this.visibleEvents = this.visibleEvents.concat(rendered);
+      this.replyTargetId = null;
+      this.lastFailure = null;
+      this.pendingLocation = null;
+    } else {
+      this.sendState = RoomSendState.Failure;
+      this.attempts += 1;
+      const failure: ThreadFailurePayload = createEmptyFailure();
+      failure.replyTargetId = this.replyTargetId;
+      failure.location = location;
+      this.lastFailure = failure;
+      this.pendingLocation = location;
+    }
+    return succeeded;
+  }
+
+  sendPoll(poll: ThreadPoll): boolean {
+    if (!this.isOpen) {
+      return false;
+    }
+    const succeeded: boolean = this.gateway.sendThreadPoll(this.threadRootId, this.replyTargetId, poll);
+    const rendered: string = 'poll:' + poll.question;
+    if (succeeded) {
+      this.sendState = RoomSendState.Success;
+      this.events = this.events.concat(rendered);
+      this.visibleEvents = this.visibleEvents.concat(rendered);
+      this.replyTargetId = null;
+      this.lastFailure = null;
+      this.pendingPoll = null;
+    } else {
+      this.sendState = RoomSendState.Failure;
+      this.attempts += 1;
+      const failure: ThreadFailurePayload = createEmptyFailure();
+      failure.replyTargetId = this.replyTargetId;
+      failure.poll = poll;
+      this.lastFailure = failure;
+      this.pendingPoll = poll;
+    }
+    return succeeded;
+  }
+
+  retrySend(): boolean {
+    if (this.lastFailure === null || !this.isOpen) {
+      return false;
+    }
+    const failure: ThreadFailurePayload = this.lastFailure;
+    if (failure.attachment !== null) {
+      const succeeded: boolean = this.gateway.sendThreadAttachment(this.threadRootId, failure.replyTargetId, failure.attachment);
+      const rendered: string = 'attachment:' + failure.attachment.attachmentId;
+      if (succeeded) {
+        this.sendState = RoomSendState.Success;
+        this.events = this.events.concat(rendered);
+        this.visibleEvents = this.visibleEvents.concat(rendered);
+        this.replyTargetId = null;
+        this.lastFailure = null;
+        this.pendingAttachment = null;
+      } else {
+        this.attempts += 1;
+      }
+      return succeeded;
+    }
+    if (failure.voice !== null) {
+      const succeeded: boolean = this.gateway.sendThreadVoice(this.threadRootId, failure.replyTargetId, failure.voice);
+      const rendered: string = 'voice:' + failure.voice.voiceId;
+      if (succeeded) {
+        this.sendState = RoomSendState.Success;
+        this.events = this.events.concat(rendered);
+        this.visibleEvents = this.visibleEvents.concat(rendered);
+        this.replyTargetId = null;
+        this.lastFailure = null;
+        this.pendingVoice = null;
+      } else {
+        this.attempts += 1;
+      }
+      return succeeded;
+    }
+    if (failure.location !== null) {
+      const succeeded: boolean = this.gateway.sendThreadLocation(this.threadRootId, failure.replyTargetId, failure.location);
+      const rendered: string = 'location:' + failure.location.description;
+      if (succeeded) {
+        this.sendState = RoomSendState.Success;
+        this.events = this.events.concat(rendered);
+        this.visibleEvents = this.visibleEvents.concat(rendered);
+        this.replyTargetId = null;
+        this.lastFailure = null;
+        this.pendingLocation = null;
+      } else {
+        this.attempts += 1;
+      }
+      return succeeded;
+    }
+    if (failure.poll !== null) {
+      const succeeded: boolean = this.gateway.sendThreadPoll(this.threadRootId, failure.replyTargetId, failure.poll);
+      const rendered: string = 'poll:' + failure.poll.question;
+      if (succeeded) {
+        this.sendState = RoomSendState.Success;
+        this.events = this.events.concat(rendered);
+        this.visibleEvents = this.visibleEvents.concat(rendered);
+        this.replyTargetId = null;
+        this.lastFailure = null;
+        this.pendingPoll = null;
+      } else {
+        this.attempts += 1;
+      }
+      return succeeded;
+    }
+    if (failure.body.length > 0) {
+      // Preserve original body and relation until retry succeeds.
+      const succeeded: boolean = this.gateway.sendThreadMessage(this.threadRootId, failure.replyTargetId, failure.body);
+      if (succeeded) {
+        this.sendState = RoomSendState.Success;
+        this.events = this.events.concat(failure.body);
+        this.visibleEvents = this.visibleEvents.concat(failure.body);
+        this.lastSentBody = failure.body;
+        this.lastSentReplyTargetId = failure.replyTargetId === null ? '' : failure.replyTargetId;
+        this.replyTargetId = null;
+        this.composerText = '';
+        this.lastFailure = null;
+      } else {
+        this.attempts += 1;
+      }
+      return succeeded;
+    }
+    return false;
+  }
+}
