+  private sendThreadAttachment(attachmentId: string, caption: string): void {
+    this.threadPresenter.threadRootId = this.threadRootId;
+    this.threadPresenter.replyTargetId = this.threadReplyTargetId;
+    this.threadPresenter.sendAttachment(new ThreadAttachment(attachmentId, caption, ThreadAttachmentKind.Image));
+    this.applyThreadPresentToState();
