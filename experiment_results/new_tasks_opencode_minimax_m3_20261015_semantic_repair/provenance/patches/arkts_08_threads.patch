+  private focusThreadEvent(eventId: string): void {
+    const succeeded = this.threadPresenter.focusEvent(eventId);
+    if (succeeded) {
+      this.threadFocusedEventId = eventId;
+    }
+  }
+
+  private focusThreadEventFailed(eventId: string): void {
+    const succeeded = this.threadPresenter.focusEventFailed(eventId);
+    if (!succeeded) {
+      // Failed out-of-window focus must never change the thread timeline.
+      return;
+    }
+    this.threadFocusedEventId = eventId;
+  }
