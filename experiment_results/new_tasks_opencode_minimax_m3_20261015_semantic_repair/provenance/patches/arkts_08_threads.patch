+  private openThreadFor(event: string): void {
+    this.threadPresenter.openThread(event);
+    this.applyThreadPresentToState();
+    this.threadRootId = event;
+    this.threadEvents = this.threadPresenter.events.slice();
+    this.visibleEvents = this.threadPresenter.events.slice();
+    this.threadFocusedEventId = null;
