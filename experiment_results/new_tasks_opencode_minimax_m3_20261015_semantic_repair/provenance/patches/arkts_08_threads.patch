+
+  private sendFromNested(content: ThreadAttachment | ThreadVoiceMessage | ThreadLocationShare | ThreadPoll): void {
+    this.threadPresenter.threadRootId = this.threadRootId;
+    this.threadPresenter.replyTargetId = this.threadReplyTargetId;
+    if (content instanceof ThreadAttachment) {
+      this.threadPresenter.sendAttachment(content);
+    } else if (content instanceof ThreadVoiceMessage) {
+      this.threadPresenter.sendVoice(content);
+    } else if (content instanceof ThreadLocationShare) {
+      this.threadPresenter.sendLocation(content);
+    } else if (content instanceof ThreadPoll) {
+      this.threadPresenter.sendPoll(content);
+    } else {
+      return;
+    }
+    this.applyThreadPresentToState();
+  }
+
+  private openNested(surface: ComposerSurface): void {
+    this.threadPresenter.openNestedSurface(surface);
+    const surfaceLabel: string = this.surfaceToString(surface);
+    this.threadComposerSurface = surfaceLabel;
+  }
+
+  private returnToThreadSurface(): void {
+    // Returning from a nested surface must preserve thread and composer context.
+    this.threadPresenter.returnToThread();
+    this.threadComposerSurface = 'thread';
+  }
+
+  private retryThreadSend(): void {
+    // Pull observable thread state into the presenter before retrying.
+    this.threadPresenter.threadRootId = this.threadRootId;
+    this.threadPresenter.composerText = this.threadComposerText;
+    this.threadPresenter.sendState = this.threadSendState;
+    this.threadPresenter.replyTargetId = this.threadReplyTargetId;
+    this.threadPresenter.attempts = this.threadAttempts;
+
+    // If no failure payload is reachable, reconstruct a minimal text-message
+    // failure from the observable composer state so retry preserves the body.
+    if (this.threadPresenter.lastFailure === null &&
+        this.threadSendState === RoomSendState.Failure &&
+        this.threadComposerText.length > 0) {
+      this.threadPresenter.lastFailure = {
+        body: this.threadComposerText,
+        replyTargetId: this.threadReplyTargetId,
+        attachment: null,
+        voice: null,
+        location: null,
+        poll: null
+      };
+    } else if (this.threadPresenter.lastFailure !== null) {
+      // Keep lastFailure body aligned with the live composer text on retries.
+      const failure = this.threadPresenter.lastFailure;
+      if (failure.attachment === null && failure.voice === null && failure.location === null && failure.poll === null && this.threadComposerText.length > 0) {
+        failure.body = this.threadComposerText;
+        failure.replyTargetId = this.threadReplyTargetId;
+      }
+    }
+
+    this.threadPresenter.retrySend();
+    this.applyThreadPresentToState();
+    this.threadComposerText = this.threadPresenter.composerText;
+  }
+
+  private dismissThreadFailure(): void {
+    // Dismissal clears only the failure UI; composer and target stay.
+    this.threadPresenter.dismissFailure();
+    this.threadLastFailureBody = '';
+    this.threadSendState = RoomSendState.Idle;
+  }
+
+  private navigateBackFromThread(): void {
+    this.threadPresenter.closeThread();
+    this.threadRootId = '';
+    this.threadEvents = [];
+    this.visibleEvents = [];
+    this.threadFocusedEventId = null;
+    this.threadComposerText = '';
+    this.threadSendState = RoomSendState.Idle;
+    this.threadReplyTargetId = null;
+    this.threadAttempts = 0;
+    this.threadLastFailureBody = '';
+    this.threadComposerSurface = 'room';
+  }
+
+  private applyThreadPresentToState(): void {
+    this.threadEvents = this.threadPresenter.events.slice();
+    this.visibleEvents = this.threadPresenter.visibleEvents.slice();
+    this.threadSendState = this.threadPresenter.sendState;
+    this.threadReplyTargetId = this.threadPresenter.replyTargetId;
+    this.threadAttempts = this.threadPresenter.attempts;
+    const failure = this.threadPresenter.lastFailure;
+    if (failure === null) {
+      this.threadLastFailureBody = '';
+    } else {
+      this.threadLastFailureBody = failure.body;
+    }
+  }
+
+  private refreshRoom(): void {
+    this.events = this.roomPresenter.events.slice();
+    this.composerText = this.roomPresenter.composerText;
+    this.sendState = this.roomPresenter.sendState;
+  }
+
+  private refreshThread(): void {
+    this.threadRootId = this.threadPresenter.threadRootId;
+    this.threadEvents = this.threadPresenter.events.slice();
+    this.visibleEvents = this.threadPresenter.visibleEvents.slice();
+    this.threadFocusedEventId = this.threadPresenter.focusedEventId;
+    this.threadComposerText = this.threadPresenter.composerText;
+    this.threadSendState = this.threadPresenter.sendState;
+    this.threadReplyTargetId = this.threadPresenter.replyTargetId;
+    this.threadComposerSurface = this.surfaceToString(this.threadPresenter.composerSurface);
+    this.threadAttempts = this.threadPresenter.attempts;
+    const failure = this.threadPresenter.lastFailure;
+    if (failure === null) {
+      this.threadLastFailureBody = '';
+    } else {
+      this.threadLastFailureBody = failure.body;
+    }
+  }
+
+  private surfaceToString(surface: ComposerSurface): string {
+    if (surface === ComposerSurface.Room) {
+      return 'room';
+    }
+    if (surface === ComposerSurface.Thread) {
+      return 'thread';
+    }
+    if (surface === ComposerSurface.AttachmentPreview) {
+      return 'attachment_preview';
+    }
+    if (surface === ComposerSurface.LocationPicker) {
+      return 'location_picker';
+    }
+    if (surface === ComposerSurface.VoiceRecorder) {
+      return 'voice_recorder';
+    }
+    if (surface === ComposerSurface.PollComposer) {
+      return 'poll_composer';
+    }
+    if (surface === ComposerSurface.DebugConsole) {
+      return 'debug_console';
+    }
+    return 'room';
   }
