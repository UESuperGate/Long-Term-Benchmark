+@ContributesBinding(AppScope::class)
+class DefaultJoinRoomByAddressEntryPoint @Inject constructor() : JoinRoomByAddressEntryPoint {
+    override fun nodeBuilder(parentNode: Node, buildContext: BuildContext): JoinRoomByAddressEntryPoint.NodeBuilder {
+        val plugins = ArrayList<Plugin>()
