+package io.element.android.features.joinroombyaddress.impl
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import com.bumble.appyx.core.modality.BuildContext
+import com.bumble.appyx.core.node.Node
+import com.bumble.appyx.core.plugin.Plugin
+import com.bumble.appyx.core.plugin.plugins
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedInject
+import io.element.android.anvilannotations.ContributesNode
+import io.element.android.features.joinroombyaddress.api.JoinRoomByAddressEntryPoint
+import io.element.android.libraries.di.SessionScope
+
+@ContributesNode(SessionScope::class)
+class JoinRoomByAddressNode @AssistedInject constructor(
+    @Assisted buildContext: BuildContext,
+    @Assisted plugins: List<Plugin>,
+    presenterFactory: JoinRoomByAddressPresenter.Factory,
+) : Node(buildContext, plugins = plugins) {
+
+    private val presenter = presenterFactory.create(
+        onResolved = { roomAlias, resolvedRoomAlias ->
+            // Surface the dismiss callback before navigating away so the
+            // parent can drop any pending flow state (jr_state_009).
+            plugins<JoinRoomByAddressEntryPoint.Callback>().forEach {
+                it.onJoinExistingRoom(
+                    roomAlias = roomAlias,
+                    roomId = resolvedRoomAlias.roomId,
+                    serverNames = resolvedRoomAlias.servers,
+                )
+            }
+        }
+    )
+
+    private fun onDismiss() {
+        plugins<JoinRoomByAddressEntryPoint.Callback>().forEach { it.onCancel() }
+    }
+
+    @Composable
+    override fun View(modifier: Modifier) {
+        val state = presenter.present()
+        JoinRoomByAddressView(
+            state = state,
+            onBackClick = ::navigateUp,
+            onDismissClick = ::onDismiss,
+            modifier = modifier,
+        )
+    }
+}
diff --git a/features/joinroombyaddress/impl/src/main/kotlin/io/element/android/features/joinroombyaddress/impl/JoinRoomByAddressPresenter.kt b/features/joinroombyaddress/impl/src/main/kotlin/io/element/android/features/joinroombyaddress/impl/JoinRoomByAddressPresenter.kt
