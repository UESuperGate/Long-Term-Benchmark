+         * @param roomId the roomId that the alias resolved to.
+         * @param serverNames the list of servers returned by the resolver.
+         */
+        fun onJoinExistingRoom(roomAlias: RoomAlias, roomId: RoomId, serverNames: List<String>)
+        fun onCancel()
+    }
+}
