+package io.element.android.features.joinroombyaddress.impl
+
+import androidx.compose.runtime.Immutable
+import io.element.android.libraries.matrix.api.room.alias.ResolvedRoomAlias
+
+/**
+ * Represents the user-visible state of the address entry / resolution flow.
+ *
+ * The [addressState] tracks the current phase of resolution for [address]. Stale
+ * resolution responses for an older [address] never replace the visible state,
+ * see [JoinRoomByAddressPresenter].
+ *
+ * [hasContinueBeenPressed] controls whether feedback for negative terminal
+ * states ([AddressState.Invalid], [AddressState.NotFound], [AddressState.Failure])
+ * is shown. It is reset on every address change so that simply editing the field
+ * clears stale validation, and set when the user explicitly presses Continue.
+ */
+@Immutable
+data class JoinRoomByAddressState(
+    val address: String,
+    val addressState: AddressState,
+    val hasContinueBeenPressed: Boolean,
+    val eventSink: (JoinRoomByAddressEvents) -> Unit,
+) {
+    val isResolving: Boolean get() = addressState is AddressState.Resolving
+    val isFound: Boolean get() = addressState is AddressState.Found
+    val isContinueEnabled: Boolean get() = addressState is AddressState.Found
+}
+
+@Immutable
+sealed interface AddressState {
+    /** No input has been provided yet (or it has been cleared). */
+    data object Unknown : AddressState
+
+    /** Input is non-empty but does not match the Matrix room alias syntax. */
+    data object Invalid : AddressState
+
+    /** Input is a syntactically valid alias and a resolution request is in flight. */
+    data object Resolving : AddressState
+
+    /** Resolution succeeded but the alias does not point to any known room. */
+    data object NotFound : AddressState
+
+    /** Resolution succeeded and returned a room. */
+    data class Found(val resolvedRoomAlias: ResolvedRoomAlias) : AddressState
+
+    /** Resolution could not complete because of a network/transport error or timeout. */
+    data object Failure : AddressState
+}
