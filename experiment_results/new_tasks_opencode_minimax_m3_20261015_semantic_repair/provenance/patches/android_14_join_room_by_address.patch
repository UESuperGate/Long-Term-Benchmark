+package io.element.android.features.joinroombyaddress.impl.di
+
+import com.squareup.anvil.annotations.ContributesTo
+import dagger.Module
+import dagger.Provides
+import io.element.android.features.joinroombyaddress.impl.JoinRoomByAddressPresenter
+import io.element.android.libraries.di.SessionScope
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.RoomAlias
+import io.element.android.libraries.matrix.api.room.alias.ResolvedRoomAlias
+
+@Module
+@ContributesTo(SessionScope::class)
+object JoinRoomByAddressModule {
+    @Provides
+    fun providesJoinRoomByAddressPresenterFactory(
+        matrixClient: MatrixClient,
+    ): JoinRoomByAddressPresenter.Factory {
+        return object : JoinRoomByAddressPresenter.Factory {
+            override fun create(
+                onResolved: (RoomAlias, ResolvedRoomAlias) -> Unit,
+            ): JoinRoomByAddressPresenter {
+                return JoinRoomByAddressPresenter(
+                    onResolved = onResolved,
+                    matrixClient = matrixClient,
+                )
+            }
+        }
+    }
+}
