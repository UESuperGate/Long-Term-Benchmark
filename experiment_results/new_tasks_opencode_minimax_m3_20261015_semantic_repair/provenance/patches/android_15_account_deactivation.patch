+
+package io.element.android.features.deactivateaccount.impl
+
+import androidx.compose.ui.tooling.preview.PreviewParameterProvider
+import io.element.android.libraries.architecture.AsyncAction
+
+open class DeactivateAccountStateProvider : PreviewParameterProvider<DeactivateAccountState> {
+    override val values: Sequence<DeactivateAccountState>
+        get() = sequenceOf(
+            aDeactivateAccountState(),
+            aDeactivateAccountState(password = "secret", eraseData = true),
+            aDeactivateAccountState(password = "secret", eraseData = true, action = AsyncAction.Confirming),
+            aDeactivateAccountState(password = "secret", eraseData = true, action = AsyncAction.Loading),
+            aDeactivateAccountState(password = "secret", eraseData = true, action = AsyncAction.Failure(IllegalStateException("Error"))),
+        )
+}
+
+fun aDeactivateAccountState(
+    password: String = "",
+    eraseData: Boolean = false,
+    action: AsyncAction<Unit> = AsyncAction.Uninitialized,
+) = DeactivateAccountState(
+    password = password,
+    eraseData = eraseData,
+    deactivateAccountAction = action,
+    eventSink = {},
+)
