+/*
+ * Copyright 2024 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Please see LICENSE in the repository root for full details.
+ */
+
+package io.element.android.features.deactivateaccount.impl
+
+import io.element.android.libraries.architecture.AsyncAction
+
+data class DeactivateAccountState(
+    val password: String,
+    val eraseData: Boolean,
+    val deactivateAccountAction: AsyncAction<Unit>,
+    val eventSink: (DeactivateAccountEvents) -> Unit,
+) {
+    val canSubmit: Boolean
+        get() = password.isNotEmpty() && deactivateActionIsConfirming
+
+    /**
+     * Returns true while the form is currently sitting on the destructive confirmation
+     * dialog. The first press of the deactivate button puts the form into this state
+     * without sending any request to the homeserver.
+     */
+    val deactivateActionIsConfirming: Boolean
+        get() = deactivateAccountAction is AsyncAction.Confirming ||
+            deactivateAccountAction is AsyncAction.Loading
+}
