+@ContributesBinding(AppScope::class)
+class DefaultDeactivateAccountEntryPoint @Inject constructor() : DeactivateAccountEntryPoint {
+
+    override fun nodeBuilder(parentNode: Node, buildContext: BuildContext): DeactivateAccountEntryPoint.NodeBuilder {
