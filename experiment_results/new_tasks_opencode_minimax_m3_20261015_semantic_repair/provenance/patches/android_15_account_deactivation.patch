+/*
+ * Copyright 2024 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Please see LICENSE in the repository root for full details.
+ */
+
+package io.element.android.features.deactivateaccount.impl
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.MutableState
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import com.squareup.anvil.annotations.ContributesBinding
+import io.element.android.libraries.architecture.AsyncAction
+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.architecture.runCatchingUpdatingState
+import io.element.android.libraries.di.SessionScope
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.auth.MatrixAuth
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import javax.inject.Inject
+
+@ContributesBinding(SessionScope::class)
+class DefaultDeactivateAccountPresenter @Inject constructor(
+    private val matrixClient: MatrixClient,
+) : Presenter<DeactivateAccountState> {
+
+    @Composable
+    override fun present(): DeactivateAccountState {
+        val localCoroutineScope = rememberCoroutineScope()
+
+        val passwordState: MutableState<String> = remember { mutableStateOf("") }
+        val eraseDataState: MutableState<Boolean> = remember { mutableStateOf(false) }
+        val deactivateAccountAction: MutableState<AsyncAction<Unit>> = remember {
+            mutableStateOf(AsyncAction.Uninitialized)
+        }
+
+        // Reset the password once the homeserver reports a successful deactivation.
+        LaunchedEffect(deactivateAccountAction.value) {
+            if (deactivateAccountAction.value.isSuccess()) {
+                passwordState.value = ""
+            }
+        }
+
+        fun handleEvents(event: DeactivateAccountEvents) {
+            when (event) {
+                is DeactivateAccountEvents.SetPassword -> {
+                    // Pasted newline characters are stripped so that copy/paste from
+                    // password managers does not poison the field with extra whitespace.
+                    passwordState.value = event.password.replace("\n", "")
+                }
+                is DeactivateAccountEvents.SetEraseData -> {
+                    eraseDataState.value = event.eraseData
+                }
+                is DeactivateAccountEvents.DeactivateAccount -> {
+                    when {
+                        // Once the homeserver reports a successful deactivation the form
+                        // is disabled and we cannot, and must not, send another request.
+                        deactivateAccountAction.value.isSuccess() -> Unit
+                        // Retries bypass the confirmation dialog and re-use the form
+                        // payload, so we send the request straight away.
+                        event.isRetry -> runDeactivation(
+                            localCoroutineScope,
+                            passwordState.value,
+                            eraseDataState.value,
+                            deactivateAccountAction,
+                        )
+                        // The first submit only opens the destructive confirmation
+                        // dialog. No request is sent yet.
+                        passwordState.value.isEmpty() -> Unit
+                        else -> deactivateAccountAction.value = AsyncAction.Confirming
+                    }
+                }
+                DeactivateAccountEvents.CloseDialogs -> {
+                    if (deactivateAccountAction.value.isLoading()) return
+                    deactivateAccountAction.value = AsyncAction.Uninitialized
+                }
+            }
+        }
+
+        return DeactivateAccountState(
+            password = passwordState.value,
+            eraseData = eraseDataState.value,
+            deactivateAccountAction = deactivateAccountAction.value,
+            eventSink = ::handleEvents,
+        )
+    }
+
+    private fun runDeactivation(
+        scope: CoroutineScope,
+        password: String,
+        eraseData: Boolean,
+        action: MutableState<AsyncAction<Unit>>,
+    ) {
+        if (password.isEmpty()) {
+            return
+        }
+        scope.launch {
+            suspend {
+                matrixClient.deactivateAccount(
+                    auth = MatrixAuth.Password(matrixClient.sessionId, password),
+                    eraseData = eraseData,
+                )
+            }.runCatchingUpdatingState(action)
+        }
+    }
+}
