+/*
+ * Copyright 2024 New Vector Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Please see LICENSE in the repository root for full details.
+ */
+
+package io.element.android.libraries.matrix.impl.auth
+
+import com.squareup.anvil.annotations.ContributesBinding
+import io.element.android.libraries.core.uri.ensureTrailingSlash
+import io.element.android.libraries.di.SessionScope
+import io.element.android.libraries.matrix.api.auth.AccountDeactivator
+import io.element.android.libraries.matrix.api.auth.MatrixAuth
+import io.element.android.libraries.sessionstorage.api.SessionStore
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import timber.log.Timber
+import javax.inject.Inject
+import javax.inject.Provider
+
+/**
+ * Performs account deactivation by issuing a direct HTTP request to the homeserver.
+ *
+ * The current Rust SDK doesn't expose a high-level deactivation API, so we fall back to
+ * sending a POST request to `/account/deactivate` ourselves using the user access token
+ * stored in the [SessionStore].
+ */
+@ContributesBinding(SessionScope::class)
+class HttpAccountDeactivator @Inject constructor(
+    private val okHttpClient: Provider<OkHttpClient>,
+    private val sessionStore: SessionStore,
+) : AccountDeactivator {
+
+    override suspend fun deactivate(auth: MatrixAuth, eraseData: Boolean): Result<Unit> = runCatching {
+        val password = (auth as? MatrixAuth.Password)?.password
+            ?: error("Unsupported authentication type for account deactivation: ${auth::class.simpleName}")
+        val sessionData = sessionStore.getLatestSession()
+            ?: error("No active session for account deactivation")
+        val url = sessionData.homeserverUrl.ensureTrailingSlash() + "_matrix/client/v3/account/deactivate"
+        val body = buildJsonObject {
+            put(
+                "auth",
+                JsonObject(
+                    mapOf(
+                        "type" to JsonPrimitive("m.login.password"),
+                        "user" to JsonPrimitive(sessionData.userId),
+                        "password" to JsonPrimitive(password),
+                    )
+                )
+            )
+            put("erase", JsonPrimitive(eraseData))
+        }
+        val request = Request.Builder()
+            .url(url)
+            .addHeader("Authorization", "Bearer ${sessionData.accessToken}")
+            .post(body.toString().toRequestBody(JSON_MEDIA_TYPE))
+            .build()
+        okHttpClient.get().newCall(request).execute().use { response ->
+            if (!response.isSuccessful) {
+                val errorMessage = response.body?.string() ?: "HTTP ${response.code}"
+                Timber.w("Account deactivation failed: HTTP ${response.code} - $errorMessage")
+                throw RuntimeException("Account deactivation failed: HTTP ${response.code}")
+            }
+        }
+    }
+
+    companion object {
+        private val JSON_MEDIA_TYPE = "application/json; charset=utf-8".toMediaType()
+    }
+}
