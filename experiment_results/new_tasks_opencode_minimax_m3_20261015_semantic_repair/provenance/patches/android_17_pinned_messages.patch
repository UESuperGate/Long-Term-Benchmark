+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import io.element.android.features.messages.impl.timeline.factories.TimelineItemsFactory
+import io.element.android.features.messages.impl.timeline.model.TimelineItem
+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.designsystem.utils.snackbar.SnackbarDispatcher
+import io.element.android.libraries.designsystem.utils.snackbar.SnackbarMessage
+import io.element.android.libraries.matrix.api.core.EventId
+import io.element.android.libraries.matrix.api.room.MatrixRoom
+import io.element.android.libraries.matrix.api.room.MatrixRoomMembersState
+import io.element.android.libraries.matrix.api.room.powerlevels.canPinUnpin
+import io.element.android.libraries.matrix.api.timeline.Timeline
+import io.element.android.libraries.matrix.api.timeline.Timeline.PaginationDirection
+import io.element.android.libraries.ui.strings.CommonStrings
+import kotlinx.collections.immutable.toPersistentList
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import javax.inject.Inject
+
+/**
+ * Presenter for the pinned messages screen.
+ *
+ * The presenter owns the lifecycle of a dedicated pinned-events [Timeline] obtained via
+ * [MatrixRoom.pinnedEventsTimeline]. Items are converted to [TimelineItem.Event]s through a
+ * dedicated [TimelineItemsFactory] (constructed per presenter instance, since the factory has
+ * no scope binding), so the diff cache state does not collide with the room timeline's
+ * factory.
+ *
+ * The state machine has four mutually-exclusive branches (see [PinnedMessagesState]):
+ * - [PinnedMessagesState.Loading]: the initial page is being fetched.
+ * - [PinnedMessagesState.Empty]: the initial page completed with no items.
+ * - [PinnedMessagesState.Loaded]: at least one item is loaded; pagination, focus, and
+ *   unpin are available subject to [PinnedMessagesState.Loaded.canPinUnpin].
+ * - [PinnedMessagesState.Failure]: the initial page could not be loaded at all. This is
+ *   rendered as a distinct state because a load failure is not an empty collection.
+ *
+ * The transition from [PinnedMessagesState.Loading] to either [PinnedMessagesState.Empty] or
+ * [PinnedMessagesState.Loaded] happens when the underlying pinned timeline emits its first
+ * batch of items. [PinnedMessagesState.Empty] is a successful terminal state, while
+ * [PinnedMessagesState.Failure] reports an error from the timeline constructor.
+ */
+class PinnedMessagesPresenter @Inject constructor(
+    private val room: MatrixRoom,
+    private val timelineItemsFactory: TimelineItemsFactory,
+    private val snackbarDispatcher: SnackbarDispatcher,
+) : Presenter<PinnedMessagesState> {
+    /**
+     * The current pagination status of the underlying pinned timeline, mirrored here so
+     * the View can render the load-more affordance.
+     */
+    private val paginationStatusFlow = MutableStateFlow(
+        Timeline.PaginationStatus(isPaginating = false, hasMoreToLoad = true)
+    )
+
+    /**
+     * Whether the underlying timeline has emitted its first batch at least once. Used to
+     * know when to transition out of [PinnedMessagesState.Loading]. The first batch can be
+     * empty (a successful empty state) — emptiness is per the items list, not this flag.
+     */
+    private val hasFirstEmission = MutableStateFlow(false)
+
+    /**
+     * Surfaces a fatal failure from opening the timeline. When non-null the screen renders
+     * the [PinnedMessagesState.Failure] view and never falls through to the empty list.
+     */
+    private val initialErrorFlow = MutableStateFlow<String?>(null)
+
+    @Composable
+    override fun present(): PinnedMessagesState {
+        val localScope = rememberCoroutineScope()
+
+        // Items produced by our scoped factory.
+        val items by timelineItemsFactory.collectItemsAsState()
+
+        val syncUpdateFlow = room.syncUpdateFlow.collectAsState()
+
+        // Permission gating — re-reads on sync updates so the actions reflect server state.
+        var canPinUnpin by remember { mutableStateOf(false) }
+        LaunchedEffect(syncUpdateFlow.value) {
+            canPinUnpin = room.canPinUnpin().getOrElse { false }
+        }
+
+        // The pinned timeline; held so we can issue paginate / unpin requests against it.
+        var timeline: Timeline? by remember { mutableStateOf(null) }
+
+        // In-flight unpin tracking. When non-null the UI should disable the action for that
+        // event; on completion (success or failure) the value is reset.
+        var unpinInFlight by remember { mutableStateOf<EventId?>(null) }
+        var unpinError by remember { mutableStateOf<String?>(null) }
+
+        // Retry token: incrementing forces the timeline to be reopened from scratch.
+        var retryToken by remember { mutableStateOf(0) }
+
+        LaunchedEffect(retryToken) {
+            // Tear down a previous timeline before reopening so we don't leak the FFI timeline.
+            timeline?.close()
+            timeline = null
+            hasFirstEmission.value = false
+            initialErrorFlow.value = null
+            unpinError = null
+
+            val openResult = room.pinnedEventsTimeline()
+            if (openResult.isFailure) {
+                val throwable = openResult.exceptionOrNull()
+                Timber.e(throwable, "Failed to build pinned events timeline")
+                initialErrorFlow.value = throwable?.message ?: "failed_to_open_pinned_timeline"
+                return@LaunchedEffect
+            }
+            val pinnedTimeline = openResult.getOrNull() ?: return@LaunchedEffect
+            timeline = pinnedTimeline
+
+            pinnedTimeline.timelineItems
+                .onEach { matrixItems ->
+                    val roomMembers = when (val membersState = room.membersStateFlow.value) {
+                        is MatrixRoomMembersState.Ready -> membersState.roomMembers
+                        else -> emptyList()
+                    }
+                    timelineItemsFactory.replaceWith(
+                        timelineItems = matrixItems,
+                        roomMembers = roomMembers,
+                    )
+                    if (!hasFirstEmission.value) {
+                        hasFirstEmission.value = true
+                    }
+                }
+                .launchIn(this)
+
+            pinnedTimeline.paginationStatus(PaginationDirection.BACKWARDS)
+                .onEach { status ->
+                    paginationStatusFlow.value = status
+                }
+                .launchIn(this)
+        }
+
+        val initialError by initialErrorFlow.collectAsState()
+        val hasFirstEmit by hasFirstEmission.collectAsState()
+        val paginationStatus by paginationStatusFlow.collectAsState()
+
+        // When the screen leaves composition we close the underlying pinned timeline so
+        // we don't leak the FFI timeline instance. The closure is idempotent through
+        // [Timeline.close].
+        DisposableEffect(Unit) {
+            onDispose {
+                timeline?.close()
+            }
+        }
+
+        fun handleEvent(event: PinnedMessagesEvents) {
+            when (event) {
+                PinnedMessagesEvents.LoadMore -> {
+                    val currentTimeline = timeline ?: return
+                    if (paginationStatus.canPaginate) {
+                        localScope.launch {
+                            currentTimeline.paginate(direction = PaginationDirection.BACKWARDS)
+                        }
+                    }
+                }
+                is PinnedMessagesEvents.ViewInTimeline -> {
+                    // View-in-timeline navigation is handled by the Node layer (it pops the
+                    // back stack to the room timeline and asks it to focus on the event).
+                    // Nothing to mutate here in the presenter.
+                }
+                is PinnedMessagesEvents.Unpin -> {
+                    val targetEventId = event.eventId
+                    val canAct = canPinUnpin && unpinInFlight == null
+                    if (!canAct) {
+                        // Permissions or another in-flight unpin: silently ignore. The
+                        // task invariant is that the action sheet should not even show the
+                        // entry when permissions are denied, so this is the safety net.
+                        return
+                    }
+                    val currentTimeline = timeline ?: return
+                    unpinInFlight = targetEventId
+                    unpinError = null
+                    localScope.launch {
+                        // Use the underlying pinned timeline's unpin API. The server
+                        // remains authoritative: on success the timeline will eventually
+                        // emit without this event; on failure the item stays visible and
+                        // a transient error surfaces.
+                        try {
+                            val result = currentTimeline.unpinEvent(targetEventId)
+                            if (result.isFailure) {
+                                Timber.e(result.exceptionOrNull(), "Failed to unpin event $targetEventId")
+                                unpinError = "unpin_failed"
+                                snackbarDispatcher.post(SnackbarMessage(CommonStrings.common_error))
+                            }
+                            // On success we clear in-flight; the item removal comes through
+                            // the timelineItems flow when the server confirms.
+                            unpinInFlight = null
+                        } catch (t: Throwable) {
+                            Timber.e(t, "Unpin unexpectedly failed for $targetEventId")
+                            unpinInFlight = null
+                            unpinError = "unpin_failed"
+                            snackbarDispatcher.post(SnackbarMessage(CommonStrings.common_error))
+                        }
+                    }
+                }
+                PinnedMessagesEvents.Retry -> {
+                    retryToken++
+                }
+                PinnedMessagesEvents.DismissError -> {
+                    unpinError = null
+                }
+            }
+        }
+
+        val sink: (PinnedMessagesEvents) -> Unit = { handleEvent(it) }
+
+        // State machine assembly. The branches are mutually exclusive; the order chosen here
+        // is important: a load error is presented first so an empty list is never confused
+        // for a failure; the loading branch is presented as long as no first emission has
+        // happened; an items-emitted empty batch is reported as Empty (successful), and a
+        // non-empty batch as Loaded.
+        return when {
+            initialError != null -> PinnedMessagesState.Failure(
+                error = initialError!!,
+                eventSink = sink,
+            )
+            !hasFirstEmit -> PinnedMessagesState.Loading
+            items.isEmpty() -> PinnedMessagesState.Empty
+            else -> {
+                val eventsOnly = items.filterIsInstance<TimelineItem.Event>().toPersistentList()
+                PinnedMessagesState.Loaded(
+                    items = eventsOnly,
+                    loadingMore = paginationStatus.isPaginating,
+                    hasMoreToLoad = paginationStatus.hasMoreToLoad,
+                    canPinUnpin = canPinUnpin,
+                    unpinInFlight = unpinInFlight,
+                    unpinError = unpinError,
+                    eventSink = sink,
+                )
+            }
+        }
+    }
+}
