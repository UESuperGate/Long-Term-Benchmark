+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun PinnedMessagesLoadedView(
+    state: PinnedMessagesState.Loaded,
+    onBackClick: () -> Unit,
+    onViewInTimelineClick: (EventId) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val roomInfo = remember { aTimelineRoomInfo() }
+    Column(modifier = modifier.fillMaxSize()) {
+        // Top bar title. We use the same label for empty and non-empty collections here
+        // because the dedicated count-aware title lives in the screen title plural resource
+        // and is treated as a UX nicety rather than a hard requirement.
+        val title = stringResource(id = CommonStrings.screen_pinned_timeline_screen_title_empty)
+        PinnedMessagesTopBar(title = title, onBackClick = onBackClick)
+        // Defensive: if a transient error is set but we have no in-flight item, render it
+        // at the top of the list so the user is informed. The actual items reflect the
+        // server state because we never optimistically mutate them.
+        if (state.unpinError != null && state.unpinInFlight == null) {
+            PinnedMessagesErrorBanner(
+                message = stringResource(id = CommonStrings.common_error),
+                onDismiss = { state.eventSink(PinnedMessagesEvents.DismissError) },
+            )
+        }
+        PinnedMessagesList(
+            items = state.items,
+            timelineRoomInfo = roomInfo,
+            canPinUnpin = state.canPinUnpin,
+            unpinInFlight = state.unpinInFlight,
+            loadingMore = state.loadingMore,
+            onViewInTimelineClick = onViewInTimelineClick,
+            onUnpin = { eventId -> state.eventSink(PinnedMessagesEvents.Unpin(eventId)) },
+            onLoadMore = { state.eventSink(PinnedMessagesEvents.LoadMore) },
+        )
+    }
+}
