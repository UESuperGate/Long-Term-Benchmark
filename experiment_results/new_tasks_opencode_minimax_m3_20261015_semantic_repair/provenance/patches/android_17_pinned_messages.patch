+package io.element.android.features.messages.impl.pinned
+
+import io.element.android.libraries.matrix.api.core.EventId
+
+sealed interface PinnedMessagesEvents {
+    /** Request the next page of pinned events. */
+    data object LoadMore : PinnedMessagesEvents
+
+    /**
+     * User wants to jump to the given event inside the room timeline. The owning Node pops
+     * itself and asks the timeline to focus on the event.
+     */
+    data class ViewInTimeline(val eventId: EventId) : PinnedMessagesEvents
+
+    /**
+     * User wants to unpin the given event. The owning Node forwards this to the room's
+     * live timeline which owns the actual unpin API. Failures are surfaced via state.
+     */
+    data class Unpin(val eventId: EventId) : PinnedMessagesEvents
+
+    /** Retry after a load failure. */
+    data object Retry : PinnedMessagesEvents
+
+    /** Dismiss a transient error (e.g. after a snackbar). */
+    data object DismissError : PinnedMessagesEvents
+}
