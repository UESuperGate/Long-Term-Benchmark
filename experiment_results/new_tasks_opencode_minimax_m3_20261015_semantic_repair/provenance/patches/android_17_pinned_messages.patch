+@Composable
+private fun PinnedMessagesErrorBanner(
+    message: String,
+    onDismiss: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Row(
+        modifier = modifier
+            .fillMaxWidth()
+            .background(MaterialTheme.colorScheme.errorContainer)
+            .clickable { onDismiss() }
+            .padding(horizontal = 16.dp, vertical = 12.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Text(
+            text = message,
+            color = MaterialTheme.colorScheme.onErrorContainer,
+            style = ElementTheme.typography.fontBodyMdRegular,
+            modifier = Modifier.weight(1f),
+        )
+        TextButton(
+            text = stringResource(id = CommonStrings.action_ok),
+            onClick = onDismiss,
+        )
+    }
+}
+
+@Composable
+private fun PinnedMessagesList(
+    items: ImmutableList<TimelineItem.Event>,
+    timelineRoomInfo: TimelineRoomInfo,
+    canPinUnpin: Boolean,
+    unpinInFlight: EventId?,
+    loadingMore: Boolean,
+    onViewInTimelineClick: (EventId) -> Unit,
+    onUnpin: (EventId) -> Unit,
+    onLoadMore: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val listState = rememberLazyListState()
+    LazyColumn(
+        state = listState,
+        modifier = modifier
+            .fillMaxSize()
+            .background(MaterialTheme.colorScheme.background),
+        contentPadding = PaddingValues(vertical = 8.dp),
+    ) {
+        items(items, key = { it.eventId?.value ?: it.id }) { event ->
+            PinnedItemRow(
+                event = event,
+                timelineRoomInfo = timelineRoomInfo,
+                canPinUnpin = canPinUnpin,
+                isUnpinInFlight = unpinInFlight == event.eventId,
+                onViewInTimelineClick = {
+                    event.eventId?.let(onViewInTimelineClick)
+                },
+                onUnpin = {
+                    event.eventId?.let(onUnpin)
+                },
+            )
+        }
+        if (items.isNotEmpty()) {
+            // Append a sentinel item at the very end whose onClick triggers another page.
+            // This keeps pagination opt-in per item rather than auto-driven by scroll, and
+            // avoids recursive LaunchedEffects with derived scroll state.
+            item(key = "__load_more__") {
+                LoadMoreSentinel(
+                    isLoading = loadingMore,
+                    onClick = onLoadMore,
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun LoadMoreSentinel(
+    isLoading: Boolean,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    if (isLoading) {
+        Box(
+            modifier = modifier
+                .fillMaxWidth()
+                .padding(16.dp),
+            contentAlignment = Alignment.Center,
+        ) {
+            CircularProgressIndicator()
+        }
+    } else {
+        // Provide an explicit opt-in affordance so the user can extend the timeline
+        // without depending on a recursive scroll listener. The presenter still
+        // guards against repeated invocations via `paginationStatus.canPaginate`.
+        Box(
+            modifier = modifier
+                .fillMaxWidth()
+                .clickable { onClick() }
+                .padding(16.dp),
+            contentAlignment = Alignment.Center,
+        ) {
+            Text(
+                text = stringResource(id = CommonStrings.action_load_more),
+                style = ElementTheme.typography.fontBodyMdRegular,
+                color = ElementTheme.colors.textActionAccent,
+            )
+        }
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun PinnedMessagesTopBar(
+    title: String,
+    onBackClick: () -> Unit,
+) {
+    TopAppBar(
+        navigationIcon = { BackButton(onClick = onBackClick) },
+        title = { Text(text = title) },
+    )
+}
+
+@Composable
+private fun PinnedItemRow(
+    event: TimelineItem.Event,
+    timelineRoomInfo: TimelineRoomInfo,
+    canPinUnpin: Boolean,
+    isUnpinInFlight: Boolean,
+    onViewInTimelineClick: () -> Unit,
+    onUnpin: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier.fillMaxWidth()) {
+        // Render the event body through the standard timeline row. Replies / reactions /
+        // swipe-to-reply / read receipts are intentionally inert in the pinned list view.
+        TimelineItemEventRow(
+            event = event,
+            timelineRoomInfo = timelineRoomInfo,
+            renderReadReceipts = false,
+            isLastOutgoingMessage = false,
+            isHighlighted = false,
+            onClick = onViewInTimelineClick,
+            onLongClick = {},
+            onShieldClick = {},
+            onLinkClick = {},
+            onUserDataClick = {},
+            inReplyToClick = {},
+            onReactionClick = { _, _ -> },
+            onReactionLongClick = { _, _ -> },
+            onMoreReactionsClick = {},
+            onReadReceiptClick = {},
+            onSwipeToReply = {},
+            eventSink = {},
+            modifier = Modifier.fillMaxWidth(),
+        )
+        PinnedItemFooter(
+            canPinUnpin = canPinUnpin,
+            isUnpinInFlight = isUnpinInFlight,
+            onViewInTimelineClick = onViewInTimelineClick,
+            onUnpin = onUnpin,
+        )
+    }
+}
+
+@Composable
+private fun PinnedItemFooter(
+    canPinUnpin: Boolean,
+    isUnpinInFlight: Boolean,
+    onViewInTimelineClick: () -> Unit,
+    onUnpin: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Row(
+        modifier = modifier
+            .fillMaxWidth()
+            .padding(horizontal = 16.dp, vertical = 4.dp),
+        horizontalArrangement = Arrangement.spacedBy(8.dp, Alignment.End),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        TextButton(
+            text = stringResource(id = CommonStrings.action_view_in_timeline),
+            onClick = onViewInTimelineClick,
+        )
+        // The unpin entry is gated on canPinUnpin: server permissions remain authoritative,
+        // satisfying the requirement that the unpin affordance only appears when permitted.
+        if (canPinUnpin) {
+            TextButton(
+                text = stringResource(id = CommonStrings.action_unpin),
+                onClick = onUnpin,
+                enabled = !isUnpinInFlight,
+            )
+        }
+    }
+}
