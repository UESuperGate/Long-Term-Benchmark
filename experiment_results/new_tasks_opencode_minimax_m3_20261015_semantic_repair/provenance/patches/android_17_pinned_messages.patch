+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun PinnedMessagesView(
+    state: PinnedMessagesState,
+    onBackClick: () -> Unit,
+    onViewInTimelineClick: (EventId) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    when (state) {
+        PinnedMessagesState.Loading -> {
+            PinnedMessagesLoadingView(onBackClick = onBackClick, modifier = modifier)
+        }
+        PinnedMessagesState.Empty -> {
+            PinnedMessagesEmptyView(onBackClick = onBackClick, modifier = modifier)
+        }
+        is PinnedMessagesState.Loaded -> {
+            PinnedMessagesLoadedView(
+                state = state,
+                onBackClick = onBackClick,
+                onViewInTimelineClick = onViewInTimelineClick,
+                modifier = modifier,
+            )
+        }
+        is PinnedMessagesState.Failure -> {
+            PinnedMessagesFailureView(
+                state = state,
+                onBackClick = onBackClick,
+                modifier = modifier,
+            )
+        }
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun PinnedMessagesLoadingView(
+    onBackClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier.fillMaxSize()) {
+        PinnedMessagesTopBar(
+            title = stringResource(id = CommonStrings.screen_pinned_timeline_screen_title_empty),
+            onBackClick = onBackClick,
+        )
+        Box(
+            modifier = Modifier.fillMaxSize(),
+            contentAlignment = Alignment.Center,
+        ) {
+            CircularProgressIndicator()
+        }
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun PinnedMessagesEmptyView(
+    onBackClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val pinActionText = stringResource(id = CommonStrings.action_pin)
+    Column(modifier = modifier.fillMaxSize()) {
+        PinnedMessagesTopBar(
+            title = stringResource(id = CommonStrings.screen_pinned_timeline_screen_title_empty),
+            onBackClick = onBackClick,
+        )
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(32.dp),
+            contentAlignment = Alignment.Center,
+        ) {
+            Column(
+                horizontalAlignment = Alignment.CenterHorizontally,
+                verticalArrangement = Arrangement.spacedBy(16.dp),
+            ) {
+                Icon(
+                    imageVector = CompoundIcons.PinSolid(),
+                    contentDescription = null,
+                    tint = ElementTheme.colors.iconAccentPrimary,
+                    modifier = Modifier.size(48.dp),
+                )
+                Text(
+                    text = stringResource(
+                        id = CommonStrings.screen_pinned_timeline_empty_state_headline
+                    ),
+                    style = ElementTheme.typography.fontBodyLgMedium,
+                    color = ElementTheme.colors.textPrimary,
+                    textAlign = TextAlign.Center,
+                )
+                Text(
+                    text = stringResource(
+                        id = CommonStrings.screen_pinned_timeline_empty_state_description,
+                        pinActionText,
+                    ),
+                    style = ElementTheme.typography.fontBodyMdRegular,
+                    color = ElementTheme.colors.textSecondary,
+                    textAlign = TextAlign.Center,
+                )
+            }
+        }
+    }
+}
