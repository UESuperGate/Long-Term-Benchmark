+package io.element.android.features.messages.impl.pinned
+
+import androidx.compose.runtime.Immutable
+import io.element.android.features.messages.impl.timeline.model.TimelineItem
+import io.element.android.libraries.matrix.api.core.EventId
+import kotlinx.collections.immutable.ImmutableList
+
+/**
+ * The state of the pinned messages screen.
+ *
+ * The state machine has four mutually-exclusive branches:
+ * - [Loading]: the initial page is being fetched.
+ * - [Empty]: the initial page completed successfully with no items.
+ * - [Loaded]: the initial page completed with items; pagination, focus, and unpin are
+ *   available.
+ * - [Failure]: the initial page failed. Per task invariants, [Failure] is never rendered as
+ *   an empty collection.
+ */
+@Immutable
+sealed interface PinnedMessagesState {
+    data object Loading : PinnedMessagesState
+
+    data object Empty : PinnedMessagesState
+
+    /**
+     * @param items the loaded pinned events in server order, with stable [TimelineItem.Event.eventId].
+     * @param loadingMore whether a forward page is currently being fetched.
+     * @param hasMoreToLoad whether more pages are available.
+     * @param canPinUnpin whether the current session is allowed to pin / unpin.
+     * @param unpinInFlight the event id whose unpin request is in flight (the item is still
+     *   present until the server confirms removal).
+     * @param unpinError a transient error to surface after a failed unpin.
+     * @param eventSink event sink.
+     */
+    data class Loaded(
+        val items: ImmutableList<TimelineItem.Event>,
+        val loadingMore: Boolean,
+        val hasMoreToLoad: Boolean,
+        val canPinUnpin: Boolean,
+        val unpinInFlight: EventId?,
+        val unpinError: String?,
+        val eventSink: (PinnedMessagesEvents) -> Unit,
+    ) : PinnedMessagesState
+
+    data class Failure(
+        val error: String,
+        val eventSink: (PinnedMessagesEvents) -> Unit,
+    ) : PinnedMessagesState
+}
