+    override val values: Sequence<PinnedMessagesState>
+        get() = sequenceOf(
+            PinnedMessagesState.Loading,
+            PinnedMessagesState.Empty,
+            aFailureState(),
+            aLoadedState(canPinUnpin = false),
+            aLoadedState(canPinUnpin = true),
+            aLoadedState(canPinUnpin = true, unpinInFlight = anEventId("a")),
+            aLoadedState(canPinUnpin = true, unpinError = "unpin_failed"),
+        )
+}
+
+private fun aFailureState(error: String = "failed_to_open_pinned_timeline"): PinnedMessagesState.Failure =
+    PinnedMessagesState.Failure(
+        error = error,
+        eventSink = {},
+    )
+
+private fun aLoadedState(
+    canPinUnpin: Boolean = true,
+    unpinInFlight: EventId? = null,
+    unpinError: String? = null,
+    items: List<TimelineItem.Event> = emptyList(),
+): PinnedMessagesState.Loaded {
+    val immutable: ImmutableList<TimelineItem.Event> = items.toPersistentList()
+    return PinnedMessagesState.Loaded(
+        items = immutable,
+        loadingMore = false,
+        hasMoreToLoad = false,
+        canPinUnpin = canPinUnpin,
+        unpinInFlight = unpinInFlight,
+        unpinError = unpinError,
+        eventSink = {},
+    )
+}
+
+private fun anEventId(suffix: String): EventId = EventId("\$$suffix")
+
+@Suppress("unused")
+private val persistentEmptyListOfTimelineItems: ImmutableList<TimelineItem> = persistentListOf()
