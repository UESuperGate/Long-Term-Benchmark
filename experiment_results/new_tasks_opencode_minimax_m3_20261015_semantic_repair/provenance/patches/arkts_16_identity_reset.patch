@@ -0,0 +1,121 @@
+// Wraps the (simulated) native crypto/identity SDK used by the reset flow.
+// The same shape would apply to a real Matrix Rust SDK binding.
+
+import {
+  AuthenticationType,
+  ResetError,
+  ResetHandle
+} from './IdentityResetTypes';
+
+export interface IdentityResetSdkOptions {
+  // If true, startIdentityReset rejects with an SDK-unavailable error.
+  forceNullHandle?: boolean;
+  // If true, startIdentityReset resolves to an OIDC handle.
+  preferOidc?: boolean;
+  // If true, resetPassword rejects for any password.
+  rejectAllPasswords?: boolean;
+  // If true, awaitSessionVerification never resolves until markSessionVerified
+  // is called.
+  requireManualVerification?: boolean;
+}
+
+export class IdentityResetSdk {
+  private static handleCounter: number = 0;
+  private options: IdentityResetSdkOptions = {};
+  private sessionVerified: boolean = false;
+
+  configure(options: IdentityResetSdkOptions): void {
+    this.options = options;
+  }
+
+  resetConfiguration(): void {
+    this.options = {};
+    this.sessionVerified = false;
+  }
+
+  // Production hook for the session verification module to flip state.
+  markSessionVerified(): void {
+    this.sessionVerified = true;
+  }
+
+  isSessionVerified(): boolean {
+    return this.sessionVerified;
+  }
+
+  // Simulates start_identity_reset. May reject when the SDK is unavailable.
+  async startIdentityReset(): Promise<ResetHandle> {
+    if (this.options.forceNullHandle) {
+      throw ResetError.fromCode('sdk_unavailable', 'identity reset SDK unavailable');
+    }
+    const handle: ResetHandle = new ResetHandle();
+    handle.handleId = `reset-handle-${++IdentityResetSdk.handleCounter}`;
+    handle.authenticationType = this.options.preferOidc
+      ? AuthenticationType.Oidc
+      : AuthenticationType.Password;
+    handle.isPasswordReady = handle.authenticationType === AuthenticationType.Password;
+    handle.approvalUrl = handle.authenticationType === AuthenticationType.Oidc
+      ? 'https://id.example/reset'
+      : '';
+    // Simulate the native SDK taking a moment to produce the handle.
+    await new Promise<void>((resolve) => {
+      setTimeout(() => resolve(), 0);
+    });
+    return handle;
+  }
+
+  async resetWithPassword(handle: ResetHandle, password: string): Promise<void> {
+    if (this.options.rejectAllPasswords) {
+      throw ResetError.fromCode('invalid_credentials', 'wrong password');
+    }
+    if (!handle || handle.isCancelled) {
+      throw ResetError.fromCode('handle_invalid', 'reset handle was destroyed');
+    }
+    if (password.length === 0) {
+      throw ResetError.fromCode('empty_password', 'password must not be empty');
+    }
+    if (password === 'wrong') {
+      throw ResetError.fromCode('invalid_credentials', 'wrong password');
+    }
+    // Simulate native SDK latency.
+    await new Promise<void>((resolve) => {
+      setTimeout(() => resolve(), 0);
+    });
+    handle.isCompleted = true;
+  }
+
+  async completeOidcReset(handle: ResetHandle): Promise<void> {
+    if (!handle || handle.isCancelled) {
+      throw ResetError.fromCode('handle_invalid', 'reset handle was destroyed');
+    }
+    await new Promise<void>((resolve) => {
+      setTimeout(() => resolve(), 0);
+    });
+    handle.isCompleted = true;
+  }
+
+  cancelReset(handle: ResetHandle | null): void {
+    if (!handle) {
+      return;
+    }
+    handle.isCancelled = true;
+    handle.isCompleted = false;
+    handle.emitCompletion();
+  }
+
+  // Resolves once both the SDK reports completion AND session verification
+  // reaches the `verified` state. Mirrors the production rule that
+  // completion is only emitted after cross-signing has stabilised.
+  async awaitSessionVerification(handle: ResetHandle): Promise<void> {
+    while (true) {
+      if (handle.isCancelled) {
+        throw ResetError.fromCode('cancelled', 'reset cancelled');
+      }
+      if (handle.isCompleted && this.sessionVerified) {
+        return;
+      }
+      await new Promise<void>((resolve) => {
+        setTimeout(() => resolve(), 0);
+      });
+    }
+  }
+}
