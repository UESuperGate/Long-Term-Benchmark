+// ResetCompletePage confirms to the user that the reset finished and
+// returns to the index.
+
+import router from '@ohos.router';
+import { IdentityResetPresenter } from '../features/identityreset/IdentityResetPresenter';
+
+@Entry
+@Component
+struct ResetCompletePage {
+  private presenter: IdentityResetPresenter = IdentityResetPresenter.shared();
+  @State private refreshTick: number = 0;
+
+  aboutToAppear(): void {
+    this.presenter.subscribe(this.onPresenterChange);
+  }
+
+  aboutToDisappear(): void {
+    this.presenter.unsubscribe(this.onPresenterChange);
+  }
+
+  private onPresenterChange = (): void => {
+    this.refreshTick++;
+  };
+
+  private onDone = (): void => {
+    this.presenter.reset();
+    setTimeout(() => {
+      void router.replaceUrl({ url: 'pages/Index' });
+    }, 0);
+  };
+
+  build() {
+    Column() {
+      Column({ space: 4 }) {
+        Text('Identity reset complete').fontSize(22).fontWeight(FontWeight.Bold)
+        Text('Your encryption keys have been replaced').fontSize(13).fontColor('#64748B')
+      }
+      .alignItems(HorizontalAlign.Start)
+      .padding({ left: 20, right: 20, top: 24, bottom: 12 })
+      .width('100%')
+      .backgroundColor('#FFFFFF')
+
+      Column({ space: 14 }) {
+        Text('The reset finished successfully. Other sessions have been signed out and your recovery state has been refreshed.')
+          .fontSize(14)
+          .fontColor('#1F2937')
+          .lineHeight(20)
+          .width('100%')
+        Button('Done').width('100%').onClick(() => this.onDone())
+        Text(`tick=${this.refreshTick}`).fontSize(10).fontColor('#9CA3AF').width('100%')
+      }
+      .padding(20)
+      .width('100%')
+      .alignItems(HorizontalAlign.Start)
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor('#F4F6F8')
+  }
+}
