diff --git a/entry/src/main/ets/pages/ResetIdentityPage.ets b/entry/src/main/ets/pages/ResetIdentityPage.ets
new file mode 100644
index 0000000..184fd83
--- /dev/null
+++ b/entry/src/main/ets/pages/ResetIdentityPage.ets
@@ -0,0 +1,220 @@
+// ResetIdentityPage is the orchestrator of the reset flow.
+// It renders the destructive-consequence confirmation and the password
+// reauthentication step based on the presenter's phase.
+//
+// OIDC reauthentication lives in ResetOidcPage (a separate page that
+// owns the Web component for the approvalUrl).
+
+import router from '@ohos.router';
+import { IdentityResetPresenter } from '../features/identityreset/IdentityResetPresenter';
+import { IdentityResetRouter } from '../features/identityreset/IdentityResetRouter';
+import {
+  AuthenticationType,
+  ResetActionState,
+  ResetHandleState,
+  ResetPhase
+} from '../features/identityreset/IdentityResetTypes';
+import { SecureBackupBasePresenter } from '../features/SecureBackupBase';
+
+@Entry
+@Component
+struct ResetIdentityPage {
+  private presenter: IdentityResetPresenter = IdentityResetPresenter.shared();
+  private backup: SecureBackupBasePresenter = SecureBackupBasePresenter.shared();
+  @State private refreshTick: number = 0;
+
+  aboutToAppear(): void {
+    this.presenter.subscribe(this.onPresenterChange);
+    if (this.presenter.phase === ResetPhase.Idle) {
+      this.presenter.continueToConfirmation();
+    }
+    this.refreshTick++;
+  }
+
+  aboutToDisappear(): void {
+    // Note: this page may be replaced by ResetOidcPage via
+    // router.replaceUrl when the SDK handle arrives as OIDC. We
+    // intentionally do NOT call onNodeDestroy() here because the
+    // reset flow is still active. The cleanup path is invoked from
+    // the explicit Cancel button / onBackPress path instead.
+    this.presenter.unsubscribe(this.onPresenterChange);
+  }
+
+  onBackPress(): boolean {
+    // Cancel the reset flow and let the router handle the navigation.
+    this.presenter.cancel();
+    return false;
+  }
+
+  onPageShow(): void {
+    if (this.presenter.phase === ResetPhase.HandleLoading) {
+      void this.presenter.confirmReset();
+    }
+  }
+
+  private onPresenterChange = (): void => {
+    this.refreshTick++;
+    if (this.presenter.phase === ResetPhase.OidcAuth
+      && this.presenter.authenticationType === AuthenticationType.Oidc) {
+      setTimeout(() => {
+        if (this.presenter.phase === ResetPhase.OidcAuth) {
+          void IdentityResetRouter.routeForHandle();
+        }
+      }, 0);
+    } else if (this.presenter.phase === ResetPhase.Completed) {
+      this.backup.markRecoveryVerified();
+      setTimeout(() => {
+        void IdentityResetRouter.openCompletion();
+      }, 0);
+    } else if (this.presenter.phase === ResetPhase.Cancelled) {
+      setTimeout(() => {
+        if (this.presenter.phase === ResetPhase.Cancelled) {
+          void IdentityResetRouter.backToIndex();
+        }
+      }, 0);
+    }
+    // Failed stays on the password screen: a failed attempt must not
+    // destroy the handle and the user must be able to retry without
+    // restarting the entire flow (ir_state_008).
+  };
+
+  private onConfirm = (): void => {
+    void this.presenter.confirmReset();
+  };
+
+  private onDismiss = (): void => {
+    this.presenter.dismissConfirmation();
+    setTimeout(() => {
+      void router.back();
+    }, 0);
+  };
+
+  private onCancel = (): void => {
+    this.presenter.cancel();
+    setTimeout(() => {
+      void router.back();
+    }, 0);
+  };
+
+  private onSubmitPassword = (): void => {
+    void this.presenter.submitPassword(this.presenter.password);
+  };
+
+  private onPasswordEdit = (value: string): void => {
+    this.presenter.onPasswordChanged(value);
+  };
+
+  private isConfirmationStage(): boolean {
+    return this.presenter.phase === ResetPhase.Confirmation
+      || (this.presenter.confirmationVisible
+        && this.presenter.handleState !== ResetHandleState.Success);
+  }
+
+  private isOidcFlow(): boolean {
+    return this.presenter.authenticationType === AuthenticationType.Oidc
+      && this.presenter.handleState === ResetHandleState.Success;
+  }
+
+  build() {
+    Column() {
+      this.renderHeader()
+      if (this.isConfirmationStage()) {
+        this.renderConfirmation()
+      } else if (this.isOidcFlow()) {
+        this.renderOidcPlaceholder()
+      } else {
+        this.renderPasswordStep()
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor('#F4F6F8')
+  }
+
+  @Builder
+  private renderHeader() {
+    Column({ space: 4 }) {
+      Text('Reset identity').fontSize(22).fontWeight(FontWeight.Bold)
+      Text('Clear your cryptographic keys and start fresh').fontSize(13).fontColor('#64748B')
+    }
+    .alignItems(HorizontalAlign.Start)
+    .padding({ left: 20, right: 20, top: 24, bottom: 12 })
+    .width('100%')
+    .backgroundColor('#FFFFFF')
+  }
+
+  @Builder
+  private renderConfirmation() {
+    Column({ space: 14 }) {
+      Text('This action is destructive').fontSize(16).fontWeight(FontWeight.Bold)
+        .width('100%')
+      Text(
+        'Resetting your identity will erase your existing encryption keys, ' +
+        'sign you out of all other sessions, and require you to re-verify this ' +
+        'device once the reset completes. Make sure you still have access to ' +
+        'another session or to your account password before continuing.'
+      )
+        .fontSize(14)
+        .fontColor('#1F2937')
+        .lineHeight(20)
+        .width('100%')
+      Button('Reset my identity').width('100%').onClick(() => this.onConfirm())
+      Button('Keep my identity').width('100%').backgroundColor('#E5E7EB')
+        .fontColor('#111827').onClick(() => this.onDismiss())
+    }
+    .padding(20)
+    .width('100%')
+    .alignItems(HorizontalAlign.Start)
+  }
+
+  @Builder
+  private renderOidcPlaceholder() {
+    Column({ space: 14 }) {
+      Text('Opening delegated reauthentication…').fontSize(14)
+        .fontColor('#1F2937').width('100%')
+      Button('Cancel').width('100%').backgroundColor('#E5E7EB')
+        .fontColor('#111827').onClick(() => this.onCancel())
+    }
+    .padding(20)
+    .width('100%')
+    .alignItems(HorizontalAlign.Start)
+  }
+
+  @Builder
+  private renderPasswordStep() {
+    Column({ space: 14 }) {
+      if (this.presenter.handleState === ResetHandleState.Loading) {
+        Text('Preparing reset session…').fontSize(14).fontColor('#1F2937').width('100%')
+      } else if (this.presenter.phase === ResetPhase.Completed) {
+        Text('Identity reset complete').fontSize(16).fontWeight(FontWeight.Bold).width('100%')
+      } else {
+        Text('Confirm your password to finish the reset.')
+          .fontSize(14).fontColor('#1F2937').width('100%')
+        TextInput({
+          text: this.presenter.password,
+          placeholder: 'Account password'
+        })
+          .type(InputType.Password)
+          .onChange((value: string) => this.onPasswordEdit(value))
+        if (this.presenter.passwordError.length > 0) {
+          Text(this.presenter.passwordError).fontSize(12).fontColor('#B91C1C').width('100%')
+        }
+        Button('Verify password and reset')
+          .width('100%')
+          .enabled(this.presenter.resetAction !== ResetActionState.Loading
+            && this.presenter.password.length > 0)
+          .onClick(() => this.onSubmitPassword())
+        Button('Cancel').width('100%').backgroundColor('#E5E7EB')
+          .fontColor('#111827').onClick(() => this.onCancel())
+      }
+      if (this.presenter.lastError.length > 0) {
+        Text(this.presenter.lastError).fontSize(12).fontColor('#B91C1C').width('100%')
+      }
+      Text(`phase=${this.presenter.phase} handle=${this.presenter.handleState}`).width('100%')
+        .fontSize(10).fontColor('#9CA3AF')
+    }
+    .padding(20)
+    .width('100%')
+    .alignItems(HorizontalAlign.Start)
+  }
+}
