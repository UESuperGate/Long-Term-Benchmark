@@ -0,0 +1,91 @@
+// Shared types and enumerations for the identity reset flow.
+// These types model the public state machine described in
+// 16_identity_reset/public_transitions.json.
+
+export enum ResetPhase {
+  Idle = 'idle',
+  Confirmation = 'confirmation',
+  HandleLoading = 'handle_loading',
+  PasswordAuth = 'password_auth',
+  OidcAuth = 'oidc_auth',
+  AwaitingVerification = 'awaiting_verification',
+  Completed = 'completed',
+  Failed = 'failed',
+  Cancelled = 'cancelled'
+}
+
+export enum AuthenticationType {
+  Password = 'password',
+  Oidc = 'oidc',
+  Unknown = 'unknown'
+}
+
+export enum SessionVerificationStatus {
+  NotVerified = 'not_verified',
+  Verified = 'verified',
+  Unknown = 'unknown'
+}
+
+// Matches the `handleState` field in the public transitions.
+export enum ResetHandleState {
+  Uninitialized = 'uninitialized',
+  Loading = 'loading',
+  Success = 'success',
+  Failed = 'failed'
+}
+
+// Matches the `resetAction` field in the public transitions.
+export enum ResetActionState {
+  Uninitialized = 'uninitialized',
+  Loading = 'loading',
+  Success = 'success',
+  Failed = 'failed'
+}
+
+// SDK handle object. It is created by startIdentityReset() and lives
+// across the password/OIDC reauthentication steps until completion
+// or cancellation.
+export class ResetHandle {
+  handleId: string = '';
+  authenticationType: AuthenticationType = AuthenticationType.Unknown;
+  approvalUrl: string = '';
+  isPasswordReady: boolean = false;
+  isCancelled: boolean = false;
+  isCompleted: boolean = false;
+  sessionVerificationStatus: SessionVerificationStatus = SessionVerificationStatus.Unknown;
+  completionWatchers: Array<() => void> = [];
+
+  reset(): void {
+    this.handleId = '';
+    this.authenticationType = AuthenticationType.Unknown;
+    this.approvalUrl = '';
+    this.isPasswordReady = false;
+    this.isCancelled = false;
+    this.isCompleted = false;
+    this.sessionVerificationStatus = SessionVerificationStatus.Unknown;
+    this.completionWatchers = [];
+  }
+
+  emitCompletion(): void {
+    for (const watcher of this.completionWatchers) {
+      watcher();
+    }
+    this.completionWatchers = [];
+  }
+}
+
+// Typed error class. Extends Error so it can be used in throw
+// statements (ArkTS only allows throwing Error subclasses).
+export class ResetError extends Error {
+  code: string = '';
+
+  constructor(code: string, message: string) {
+    super(message);
+    this.code = code;
+    this.name = 'ResetError';
+  }
+
+  static fromCode(code: string, message: string): ResetError {
+    return new ResetError(code, message);
+  }
+}
