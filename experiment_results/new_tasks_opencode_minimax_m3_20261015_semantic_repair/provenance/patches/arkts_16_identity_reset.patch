@@ -0,0 +1,39 @@
+// Centralised routing helpers for the identity reset pages.
+
+import router from '@ohos.router';
+import { IdentityResetPresenter } from './IdentityResetPresenter';
+import { AuthenticationType } from './IdentityResetTypes';
+
+export class IdentityResetRouter {
+  static readonly PASSWORD_PAGE: string = 'pages/ResetIdentityPage';
+  static readonly OIDC_PAGE: string = 'pages/ResetOidcPage';
+  static readonly COMPLETE_PAGE: string = 'pages/ResetCompletePage';
+  static readonly INDEX_PAGE: string = 'pages/Index';
+
+  // Navigates from the index page into the password reset page. The
+  // presenter is already on the Confirmation phase by the time this is
+  // called; the page itself triggers confirmReset() onAppear.
+  static async openResetEntry(): Promise<void> {
+    const presenter = IdentityResetPresenter.shared();
+    presenter.continueToConfirmation();
+    await router.pushUrl({ url: IdentityResetRouter.PASSWORD_PAGE });
+  }
+
+  // Routes the auth step to the appropriate sub-page based on the
+  // handle's authentication type. The caller should invoke this once
+  // the handle has loaded.
+  static async routeForHandle(): Promise<void> {
+    const presenter = IdentityResetPresenter.shared();
+    if (presenter.authenticationType === AuthenticationType.Oidc) {
+      await router.replaceUrl({ url: IdentityResetRouter.OIDC_PAGE });
+    }
+  }
+
+  static async openCompletion(): Promise<void> {
+    await router.replaceUrl({ url: IdentityResetRouter.COMPLETE_PAGE });
+  }
+
+  static async backToIndex(): Promise<void> {
+    await router.replaceUrl({ url: IdentityResetRouter.INDEX_PAGE });
+  }
+}
