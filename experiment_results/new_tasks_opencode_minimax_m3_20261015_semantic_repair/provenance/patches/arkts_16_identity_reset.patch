diff --git a/entry/src/main/ets/pages/ResetOidcPage.ets b/entry/src/main/ets/pages/ResetOidcPage.ets
new file mode 100644
index 0000000..8ada20d
--- /dev/null
+++ b/entry/src/main/ets/pages/ResetOidcPage.ets
@@ -0,0 +1,126 @@
+// ResetOidcPage renders the delegated reauthentication step.
+//
+// Production behaviour (mirrored here):
+//   - The SDK exposes an approvalUrl that the user must visit in a
+//     browser / custom tab.
+//   - When the user returns from the IdP, the redirect is captured
+//     and the same handle is marked complete.
+//   - If no custom tab is available (we surface this as a manual
+//     fallback below) the user confirms the redirect themselves.
+//   - Cancel uses the same cleanup path as the password page.
+
+import router from '@ohos.router';
+import { IdentityResetPresenter } from '../features/identityreset/IdentityResetPresenter';
+import {
+  AuthenticationType,
+  ResetPhase
+} from '../features/identityreset/IdentityResetTypes';
+import { SecureBackupBasePresenter } from '../features/SecureBackupBase';
+
+@Entry
+@Component
+struct ResetOidcPage {
+  private presenter: IdentityResetPresenter = IdentityResetPresenter.shared();
+  private backup: SecureBackupBasePresenter = SecureBackupBasePresenter.shared();
+  @State private refreshTick: number = 0;
+
+  aboutToAppear(): void {
+    this.presenter.subscribe(this.onPresenterChange);
+  }
+
+  aboutToDisappear(): void {
+    this.presenter.unsubscribe(this.onPresenterChange);
+  }
+
+  onBackPress(): boolean {
+    this.presenter.cancel();
+    return false;
+  }
+
+  private onPresenterChange = (): void => {
+    this.refreshTick++;
+    if (this.presenter.phase === ResetPhase.Completed) {
+      this.backup.markRecoveryVerified();
+      setTimeout(() => {
+        if (this.presenter.phase === ResetPhase.Completed) {
+          void router.replaceUrl({ url: 'pages/ResetCompletePage' });
+        }
+      }, 0);
+    } else if (this.presenter.phase === ResetPhase.Cancelled) {
+      setTimeout(() => {
+        if (this.presenter.phase === ResetPhase.Cancelled) {
+          void router.replaceUrl({ url: 'pages/Index' });
+        }
+      }, 0);
+    }
+  };
+
+  private onCancel = (): void => {
+    this.presenter.cancel();
+    setTimeout(() => {
+      void router.back();
+    }, 0);
+  };
+
+  private onManualComplete = (): void => {
+    void this.presenter.completeOidcFromRedirect();
+  };
+
+  build() {
+    Column() {
+      Column({ space: 4 }) {
+        Text('Verify with your identity provider').fontSize(22).fontWeight(FontWeight.Bold)
+        Text('Complete the redirect to finish the reset').fontSize(13).fontColor('#64748B')
+      }
+      .alignItems(HorizontalAlign.Start)
+      .padding({ left: 20, right: 20, top: 24, bottom: 12 })
+      .width('100%')
+      .backgroundColor('#FFFFFF')
+
+      Column({ space: 14 }) {
+        Text(
+          'A delegated reauthentication is required. The approval URL ' +
+          'below points at your identity provider. Open it, confirm the ' +
+          'reset, and return to this screen.'
+        )
+          .fontSize(14)
+          .fontColor('#1F2937')
+          .lineHeight(20)
+          .width('100%')
+
+        Column({ space: 4 }) {
+          Text('Approval URL').fontSize(12).fontColor('#64748B').width('100%')
+          Text(this.presenter.approvalUrl.length > 0
+            ? this.presenter.approvalUrl
+            : 'https://id.example/reset')
+            .fontSize(13)
+            .fontColor('#0F172A')
+            .width('100%')
+        }
+
+        // Fallback path: when no custom tab is available the user
+        // confirms completion manually. Both this path and the
+        // programmatic one route through completeOidcFromRedirect.
+        Button('I returned from the identity provider').width('100%')
+          .onClick(() => this.onManualComplete())
+
+        Button('Cancel').width('100%').backgroundColor('#E5E7EB')
+          .fontColor('#111827').onClick(() => this.onCancel())
+
+        if (this.presenter.lastError.length > 0) {
+          Text(this.presenter.lastError).fontSize(12).fontColor('#B91C1C').width('100%')
+        }
+        Text(`handle=${this.presenter.currentHandleId()} phase=${this.presenter.phase}`)
+          .fontSize(10)
+          .fontColor('#9CA3AF')
+          .width('100%')
+      }
+      .padding(20)
+      .width('100%')
+      .alignItems(HorizontalAlign.Start)
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor('#F4F6F8')
+  }
+}
