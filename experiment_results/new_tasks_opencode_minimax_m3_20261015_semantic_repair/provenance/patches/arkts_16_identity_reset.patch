diff --git a/entry/src/main/ets/features/identityreset/IdentityResetPresenter.ets b/entry/src/main/ets/features/identityreset/IdentityResetPresenter.ets
new file mode 100644
index 0000000..a7d87e3
--- /dev/null
+++ b/entry/src/main/ets/features/identityreset/IdentityResetPresenter.ets
@@ -0,0 +1,428 @@
+// Orchestrates the identity reset state machine.
+//
+// Implements every transition in
+// _benchmark_inputs/public_transitions.json:
+//   - ir_state_001_continue_requests_confirmation
+//   - ir_state_002_dismiss_confirmation
+//   - ir_state_003_confirm_starts_handle
+//   - ir_state_004_password_handle_routes
+//   - ir_state_005_oidc_handle_routes_and_resets
+//   - ir_state_006_handle_failure_recovers
+//   - ir_state_007_password_submit_calls_handle
+//   - ir_state_008_password_failure_clears_on_edit
+//   - ir_state_009_success_waits_for_verification
+//   - ir_state_010_cancel_cleans_up
+//
+// The presenter owns:
+//   - the confirmation panel visibility,
+//   - the SDK reset handle and its lifecycle,
+//   - the reauthentication state (password form or OIDC return),
+//   - the session verification watcher that gates "completed" emission,
+//   - a single shared reset job so concurrent `confirm_reset` calls
+//     reuse the existing handle instead of starting a second one.
+
+import {
+  AuthenticationType,
+  ResetActionState,
+  ResetError,
+  ResetHandle,
+  ResetHandleState,
+  ResetPhase,
+  SessionVerificationStatus
+} from './IdentityResetTypes';
+import { IdentityResetSdk } from './IdentityResetSdk';
+
+export class IdentityResetPresenter {
+  private static instanceRef: IdentityResetPresenter | null = null;
+
+  static shared(): IdentityResetPresenter {
+    if (!IdentityResetPresenter.instanceRef) {
+      IdentityResetPresenter.instanceRef = new IdentityResetPresenter();
+    }
+    return IdentityResetPresenter.instanceRef;
+  }
+
+  // Observable state ----------------------------------------------------
+  phase: ResetPhase = ResetPhase.Idle;
+  handleState: ResetHandleState = ResetHandleState.Uninitialized;
+  resetAction: ResetActionState = ResetActionState.Uninitialized;
+  confirmationVisible: boolean = false;
+  authenticationType: AuthenticationType = AuthenticationType.Unknown;
+  approvalUrl: string = '';
+  password: string = '';
+  passwordError: string = '';
+  lastError: string = '';
+  sessionVerificationStatus: SessionVerificationStatus = SessionVerificationStatus.Unknown;
+  resetJobActive: boolean = false;
+  completionWatcherActive: boolean = false;
+
+  // Internal state ------------------------------------------------------
+  sdk: IdentityResetSdk = new IdentityResetSdk();
+  private currentHandle: ResetHandle | null = null;
+  private completionPromise: Promise<void> | null = null;
+  private listeners: Array<() => void> = [];
+
+  // Listeners are called after any state mutation so that ArkUI pages
+  // (which subscribe to presenter changes via this.subscriber callback)
+  // can re-read the presenter and refresh @State mirrors.
+  subscribe(listener: () => void): void {
+    if (this.listeners.indexOf(listener) === -1) {
+      this.listeners.push(listener);
+    }
+  }
+
+  unsubscribe(listener: () => void): void {
+    const idx = this.listeners.indexOf(listener);
+    if (idx >= 0) {
+      this.listeners.splice(idx, 1);
+    }
+  }
+
+  private emit(): void {
+    for (const listener of this.listeners) {
+      listener();
+    }
+  }
+
+  // Helpers -------------------------------------------------------------
+  snapshotHandle(): ResetHandle | null {
+    return this.currentHandle;
+  }
+
+  isBusy(): boolean {
+    return this.handleState === ResetHandleState.Loading
+      || this.resetAction === ResetActionState.Loading;
+  }
+
+  isAtConfirmation(): boolean {
+    return this.confirmationVisible;
+  }
+
+  isPasswordScreen(): boolean {
+    return this.phase === ResetPhase.PasswordAuth;
+  }
+
+  isOidcScreen(): boolean {
+    return this.phase === ResetPhase.OidcAuth;
+  }
+
+  canReset(): boolean {
+    return this.phase === ResetPhase.Idle
+      || this.phase === ResetPhase.Failed
+      || this.phase === ResetPhase.Cancelled
+      || this.phase === ResetPhase.Completed;
+  }
+
+  // State transitions ---------------------------------------------------
+
+  // ir_state_001: from a recovered/Idle state, `continue` opens the
+  // destructive-consequence confirmation. No SDK call happens yet.
+  continueToConfirmation(): void {
+    if (!this.canReset()) {
+      return;
+    }
+    this.resetTransientFields();
+    this.confirmationVisible = true;
+    this.phase = ResetPhase.Confirmation;
+    this.emit();
+  }
+
+  // ir_state_002: dismissing the confirmation must not trigger any SDK
+  // call. It just closes the dialog and returns to Idle.
+  dismissConfirmation(): void {
+    this.confirmationVisible = false;
+    this.phase = ResetPhase.Idle;
+    this.handleState = ResetHandleState.Uninitialized;
+    this.resetAction = ResetActionState.Uninitialized;
+    this.authenticationType = AuthenticationType.Unknown;
+    this.approvalUrl = '';
+    this.currentHandle = null;
+    this.emit();
+  }
+
+  // ir_state_003: confirming starts a single SDK reset handle. Concurrent
+  // calls reuse the in-flight handle.
+  async confirmReset(): Promise<void> {
+    if (!this.confirmationVisible) {
+      // Cannot start reset without destructive confirmation.
+      return;
+    }
+    if (this.handleState === ResetHandleState.Loading) {
+      // Reuse the loading handle.
+      return;
+    }
+    if (this.handleState === ResetHandleState.Success
+      && this.currentHandle
+      && !this.currentHandle.isCancelled) {
+      // Reuse the existing successful handle.
+      return;
+    }
+    this.confirmationVisible = false;
+    this.handleState = ResetHandleState.Loading;
+    this.resetAction = ResetActionState.Uninitialized;
+    this.phase = ResetPhase.HandleLoading;
+    this.lastError = '';
+    // Snapshot the phase so we can detect a cancellation that races
+    // with the awaited SDK call.
+    const phaseAtStart = this.phase;
+    this.emit();
+
+    try {
+      const handle = await this.sdk.startIdentityReset();
+      if (this.phase !== phaseAtStart) {
+        // The user cancelled (or otherwise changed the phase) while the
+        // SDK call was in flight. Discard the handle and do not flip
+        // state out of Cancelled/Failed.
+        this.sdk.cancelReset(handle);
+        return;
+      }
+      if (!handle) {
+        // ir_state_006: null handle is failure, not success.
+        this.handleState = ResetHandleState.Failed;
+        this.phase = ResetPhase.Failed;
+        this.lastError = 'unable to start reset';
+        this.emit();
+        return;
+      }
+      this.currentHandle = handle;
+      this.handleState = ResetHandleState.Success;
+      this.authenticationType = handle.authenticationType;
+      this.approvalUrl = handle.approvalUrl;
+      this.phase = handle.authenticationType === AuthenticationType.Oidc
+        ? ResetPhase.OidcAuth
+        : ResetPhase.PasswordAuth;
+      this.resetAction = ResetActionState.Uninitialized;
+      this.emit();
+    } catch (err) {
+      if (this.phase !== phaseAtStart) {
+        // Cancelled while in flight; preserve the cancel state.
+        return;
+      }
+      // ir_state_006: SDK failure is treated as failure, not success.
+      this.handleState = ResetHandleState.Failed;
+      this.phase = ResetPhase.Failed;
+      this.lastError = err instanceof ResetError
+        ? err.message
+        : (err ? String(err) : 'unknown sdk error');
+      this.emit();
+    }
+  }
+
+  // ir_state_004 / ir_state_005: when the handle becomes available the
+  // presenter routes the user to either the password form or the OIDC
+  // reauth page. The same handle is reused on both paths.
+  currentHandleId(): string {
+    return this.currentHandle ? this.currentHandle.handleId : '';
+  }
+
+  // ir_state_007: empty password submissions are rejected outright.
+  async submitPassword(password: string): Promise<void> {
+    const trimmed = password ?? '';
+    this.password = trimmed;
+    this.passwordError = '';
+    if (trimmed.length === 0) {
+      // ir_state_007: empty passwords cannot be submitted.
+      this.passwordError = 'password must not be empty';
+      this.resetAction = ResetActionState.Uninitialized;
+      this.emit();
+      return;
+    }
+    if (!this.currentHandle || this.currentHandle.isCancelled) {
+      this.passwordError = 'reset session unavailable';
+      this.resetAction = ResetActionState.Failed;
+      this.emit();
+      return;
+    }
+    this.resetAction = ResetActionState.Loading;
+    this.emit();
+    const handleRef = this.currentHandle;
+    const phaseAtStart = this.phase;
+    try {
+      await this.sdk.resetWithPassword(handleRef, trimmed);
+      if (this.currentHandle !== handleRef || this.phase !== phaseAtStart) {
+        // Cancelled or replaced mid-flight.
+        return;
+      }
+      this.resetAction = ResetActionState.Success;
+      this.phase = ResetPhase.AwaitingVerification;
+      this.emit();
+      // ir_state_009: completion is emitted only after verified status.
+      this.startCompletionWatcher();
+    } catch (err) {
+      if (this.currentHandle !== handleRef || this.phase !== phaseAtStart) {
+        // Cancelled or replaced mid-flight.
+        return;
+      }
+      // ir_state_008: failed attempt must not destroy the handle.
+      this.resetAction = ResetActionState.Failed;
+      this.passwordError = err instanceof ResetError
+        ? err.message
+        : (err ? String(err) : 'unknown failure');
+      this.emit();
+    }
+  }
+
+  // ir_state_008: editing the password after a failure clears the error
+  // so the user can retry without restarting the flow.
+  onPasswordChanged(next: string): void {
+    this.password = next ?? '';
+    if (this.passwordError.length > 0) {
+      this.passwordError = '';
+      if (this.resetAction === ResetActionState.Failed) {
+        this.resetAction = ResetActionState.Uninitialized;
+      }
+      this.emit();
+    }
+  }
+
+  // ir_state_005: OIDC flow completion. The web page calls this once
+  // the approval redirect returns.
+  async completeOidcFromRedirect(): Promise<void> {
+    if (!this.currentHandle || this.currentHandle.isCancelled) {
+      this.resetAction = ResetActionState.Failed;
+      this.lastError = 'reset session unavailable';
+      this.emit();
+      return;
+    }
+    this.resetAction = ResetActionState.Loading;
+    this.emit();
+    const handleRef = this.currentHandle;
+    const phaseAtStart = this.phase;
+    try {
+      await this.sdk.completeOidcReset(handleRef);
+      if (this.currentHandle !== handleRef || this.phase !== phaseAtStart) {
+        // Cancelled or replaced mid-flight.
+        return;
+      }
+      this.resetAction = ResetActionState.Success;
+      this.phase = ResetPhase.AwaitingVerification;
+      this.emit();
+      this.startCompletionWatcher();
+    } catch (err) {
+      if (this.currentHandle !== handleRef || this.phase !== phaseAtStart) {
+        // Cancelled or replaced mid-flight.
+        return;
+      }
+      this.resetAction = ResetActionState.Failed;
+      this.lastError = err instanceof ResetError
+        ? err.message
+        : (err ? String(err) : 'unknown failure');
+      this.emit();
+    }
+  }
+
+  // ir_state_009: wait until the SDK handle is completed AND session
+  // verification reaches the verified status before flipping to
+  // Completed. This watcher is the same instance used by the OIDC
+  // return path and by node destruction, so cleanup is identical.
+  private startCompletionWatcher(): void {
+    if (this.completionWatcherActive) {
+      return;
+    }
+    this.completionWatcherActive = true;
+    this.resetJobActive = true;
+    this.completionPromise = this.runCompletionWatcher();
+    this.emit();
+  }
+
+  private async runCompletionWatcher(): Promise<void> {
+    const handleRef = this.currentHandle;
+    try {
+      await this.sdk.awaitSessionVerification(handleRef!);
+      if (this.currentHandle !== handleRef || this.phase !== ResetPhase.AwaitingVerification) {
+        // Cancelled or otherwise replaced while verifying.
+        this.resetJobActive = false;
+        this.completionWatcherActive = false;
+        return;
+      }
+      this.phase = ResetPhase.Completed;
+      this.sessionVerificationStatus = SessionVerificationStatus.Verified;
+      this.resetJobActive = false;
+      this.completionWatcherActive = false;
+      this.emit();
+    } catch (err) {
+      this.resetJobActive = false;
+      this.completionWatcherActive = false;
+      if (this.phase === ResetPhase.Cancelled) {
+        // Cancellation supersedes verification failure.
+        return;
+      }
+      if (err instanceof ResetError && err.code === 'cancelled') {
+        // The SDK told us the handle was cancelled.
+        this.phase = ResetPhase.Cancelled;
+        this.emit();
+        return;
+      }
+      this.phase = ResetPhase.Failed;
+      this.lastError = err instanceof ResetError
+        ? err.message
+        : (err ? String(err) : 'verification failed');
+      this.emit();
+    }
+  }
+
+  // ir_state_010: cancel from confirmation or from the auth page closes
+  // the active reset path without reporting success. The same cleanup
+  // is used by the OIDC return and by node destruction.
+  cancel(): void {
+    const handle = this.currentHandle;
+    this.sdk.cancelReset(handle);
+    this.currentHandle = null;
+    this.completionPromise = null;
+    this.phase = ResetPhase.Cancelled;
+    this.confirmationVisible = false;
+    this.handleState = ResetHandleState.Uninitialized;
+    this.resetAction = ResetActionState.Uninitialized;
+    this.authenticationType = AuthenticationType.Unknown;
+    this.approvalUrl = '';
+    this.passwordError = '';
+    this.sessionVerificationStatus = SessionVerificationStatus.Unknown;
+    this.resetJobActive = false;
+    this.completionWatcherActive = false;
+    // Invariant: cancel never marks recovery as configured. The
+    // SecureBackupBase presenter is intentionally not touched here.
+    this.emit();
+  }
+
+  // Called when the page node is torn down. ir_state_010 enforces that
+  // node destruction uses the same cleanup path as the OIDC cancel.
+  onNodeDestroy(): void {
+    this.cancel();
+  }
+
+  // External hooks ------------------------------------------------------
+  refreshRecoveryState(): void {
+    // Successful reset leaves the flow and refreshes recovery/verification
+    // state. The caller is responsible for refreshing the secure backup
+    // presenter. We mirror this here for tests.
+  }
+
+  reset(): void {
+    this.sdk.cancelReset(this.currentHandle);
+    this.currentHandle = null;
+    this.completionPromise = null;
+    this.sdk.resetConfiguration();
+    this.phase = ResetPhase.Idle;
+    this.confirmationVisible = false;
+    this.handleState = ResetHandleState.Uninitialized;
+    this.resetAction = ResetActionState.Uninitialized;
+    this.authenticationType = AuthenticationType.Unknown;
+    this.approvalUrl = '';
+    this.password = '';
+    this.passwordError = '';
+    this.lastError = '';
+    this.sessionVerificationStatus = SessionVerificationStatus.Unknown;
+    this.resetJobActive = false;
+    this.completionWatcherActive = false;
+    this.emit();
+  }
+
+  private resetTransientFields(): void {
+    this.password = '';
+    this.passwordError = '';
+    this.lastError = '';
+    this.authenticationType = AuthenticationType.Unknown;
+    this.approvalUrl = '';
+    this.sessionVerificationStatus = SessionVerificationStatus.Unknown;
+  }
+}
