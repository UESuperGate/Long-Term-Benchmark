+package io.element.android.features.preferences.impl.notifications.sound
+
+import android.net.Uri
+import androidx.compose.runtime.Immutable
+
+/**
+ * Describes a user-facing choice for a notification sound (message sound or call ringtone).
+ *
+ * The choices are intentionally explicit and serialisable so that:
+ * - they can round-trip through DataStore (see [serialize] / [deserialize]),
+ * - they can be matched deterministically regardless of the picker URI lifetime.
+ *
+ * Bundled presets are referenced by their preset id; custom files are referenced by their
+ * absolute path inside the app's storage dir (after copy).
+ */
+@Immutable
+sealed interface NotificationSoundConfig {
+    /** Use the system default ringtone / notification sound. */
+    data object SystemDefault : NotificationSoundConfig
+
+    /** Use a preset bundled with the application. */
+    data class BundledPreset(val presetId: String) : NotificationSoundConfig
+
+    /** Use a custom audio file copied into the app's private storage. */
+    data class Custom(val absolutePath: String, val displayName: String) : NotificationSoundConfig
+
+    /** No sound. */
+    data object Silent : NotificationSoundConfig
+
+    fun serialize(): String? = when (this) {
+        SystemDefault -> TOKEN_SYSTEM_DEFAULT
+        is BundledPreset -> "$TOKEN_BUNDLED_PREFIX$presetId"
+        is Custom -> "$TOKEN_CUSTOM_PREFIX${absolutePath}\u0001${displayName}"
+        Silent -> TOKEN_SILENT
+    }
+
+    companion object {
+        const val TOKEN_SYSTEM_DEFAULT = "system_default"
+        const val TOKEN_SILENT = "silent"
+        const val TOKEN_BUNDLED_PREFIX = "bundled:"
+        const val TOKEN_CUSTOM_PREFIX = "custom:"
+
+        /** Identifier of the bundled Element notification preset (libraries/push/impl/R.raw.message). */
+        const val BUNDLED_PRESET_ELEMENT = "element_default"
+
+        /** Built-in option list presented to the user. */
+        val BUILTIN_BUNDLED_PRESETS: List<BundledPreset> = listOf(
+            BundledPreset(BUNDLED_PRESET_ELEMENT),
+        )
+
+        fun deserialize(serialized: String?): NotificationSoundConfig {
+            if (serialized.isNullOrEmpty()) return SystemDefault
+            return when {
+                serialized == TOKEN_SYSTEM_DEFAULT -> SystemDefault
+                serialized == TOKEN_SILENT -> Silent
+                serialized.startsWith(TOKEN_BUNDLED_PREFIX) -> BundledPreset(serialized.removePrefix(TOKEN_BUNDLED_PREFIX))
+                serialized.startsWith(TOKEN_CUSTOM_PREFIX) -> {
+                    val payload = serialized.removePrefix(TOKEN_CUSTOM_PREFIX)
+                    val sep = payload.indexOf('\u0001')
+                    if (sep < 0) {
+                        Custom(payload, payload.substringAfterLast('/'))
+                    } else {
+                        Custom(payload.substring(0, sep), payload.substring(sep + 1))
+                    }
+                }
+                else -> SystemDefault
+            }
+        }
+    }
+}
+
+/**
+ * Describes a `Uri` for a sound choice. This is a separate type from [NotificationSoundConfig]
+ * because the picker returns `Uri` directly (which we must not persist as the effective sound).
+ */
+@Immutable
+data class PickedSound(val uri: Uri, val displayName: String)
