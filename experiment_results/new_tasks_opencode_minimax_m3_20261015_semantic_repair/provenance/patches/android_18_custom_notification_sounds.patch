+
+/** Identifies a notification-sound slot the user can customise. */
+enum class NotificationSoundSlotId {
+    MESSAGE,
+    CALL;
+
+    fun toNotificationSoundSlot(): NotificationSoundSlot = when (this) {
+        MESSAGE -> NotificationSoundSlot.MESSAGE
+        CALL -> NotificationSoundSlot.CALL
+    }
+
+    fun tag(): NotificationSoundSlotTag = when (this) {
+        MESSAGE -> NotificationSoundSlotTag.MESSAGE
+        CALL -> NotificationSoundSlotTag.CALL
+    }
+}
+
+data class NotificationSoundsState(
+    val messageSound: NotificationSoundConfig,
+    val callRingtone: NotificationSoundConfig,
+    val messageAction: AsyncAction<NotificationSoundConfig>,
+    val callAction: AsyncAction<NotificationSoundConfig>,
+    val hasExplicitCallRingtonePreference: Boolean,
+)
+
+interface NotificationSoundsService {
+    @Composable
+    fun state(): NotificationSoundsState
+
+    /**
+     * Apply a picker-provided URI to [slot]. The transient picker URI is **never** persisted as
+     * the effective sound — it is first copied to app-owned storage. Concurrent calls for the
+     * same slot are serialised using a per-slot mutex AND a monotonically increasing token so
+     * that a late-finishing pick can never resurrect an older choice.
+     */
+    fun setFromPickedUri(slot: NotificationSoundSlotId, picked: PickedSound)
+
+    /** Apply a non-file choice (system default, bundled preset, silent). */
+    fun setFromConfig(slot: NotificationSoundSlotId, config: NotificationSoundConfig)
+
+    /** Dismiss the error displayed for [slot]. */
+    fun dismissError(slot: NotificationSoundSlotId)
+
+    /**
+     * Discover any call-channel ringtone left behind by a legacy install and migrate it as the
+     * effective call ringtone, **unless** the user already has an explicit new preference.
+     * Returns true when a migration actually occurred.
+     */
+    suspend fun migrateLegacyCallChannelSoundIfNeeded(): Boolean
+}
+
+@ContributesBinding(SessionScope::class)
+@SingleIn(SessionScope::class)
+class DefaultNotificationSoundsService(
+    private val userPushStoreFactory: UserPushStoreFactory,
+    private val sessionId: SessionId,
+    private val notificationChannels: NotificationChannels,
+    private val fileRepository: NotificationSoundFileRepository,
+    @SessionCoroutineScope private val sessionCoroutineScope: CoroutineScope,
+) : NotificationSoundsService {
+
+    private val userPushStore: UserPushStore
+        get() = userPushStoreFactory.getOrCreate(sessionId)
+    private val messageState = MutableStateFlow<NotificationSoundConfig>(NotificationSoundConfig.SystemDefault)
+    private val callState = MutableStateFlow<NotificationSoundConfig>(NotificationSoundConfig.SystemDefault)
+    private val messageAction = MutableStateFlow<AsyncAction<NotificationSoundConfig>>(AsyncAction.Uninitialized)
+    private val callAction = MutableStateFlow<AsyncAction<NotificationSoundConfig>>(AsyncAction.Uninitialized)
+    private val explicitCallRingtonePreference = MutableStateFlow(false)
+
+    private val messageLock = Mutex()
+    private val callLock = Mutex()
+
+    // Token per slot to enforce "latest pick wins": every time we start a new update we bump the
+    // token, and the operation only commits its result back to the store if its token is still
+    // the latest one for that slot. This stops a late `complete` from resurrecting an older pick.
+    private val messageToken = MutableStateFlow(0L)
+    private val callToken = MutableStateFlow(0L)
+
+    init {
+        observePreferences()
+    }
+
+    private fun observePreferences() {
+        userPushStore.getMessageSoundConfigFlow()
+            .onEach { serialized -> messageState.value = NotificationSoundConfig.deserialize(serialized) }
+            .launchIn(sessionCoroutineScope)
+        userPushStore.getCallRingtoneConfigFlow()
+            .onEach { serialized -> callState.value = NotificationSoundConfig.deserialize(serialized) }
+            .launchIn(sessionCoroutineScope)
+        userPushStore.hasExplicitCallRingtonePreference()
+            .onEach { hasExplicit -> explicitCallRingtonePreference.value = hasExplicit }
+            .launchIn(sessionCoroutineScope)
+        userPushStore.getMessageSoundChannelVersionFlow()
+            .combine(messageToken, ::Pair)
+            .launchIn(sessionCoroutineScope)
+    }
+
+    @Composable
+    override fun state(): NotificationSoundsState {
+        val message = messageState.collectAsState().value
+        val call = callState.collectAsState().value
+        val mAction = messageAction.collectAsState().value
+        val cAction = callAction.collectAsState().value
+        val explicit = explicitCallRingtonePreference.collectAsState().value
+        return remember(message, call, mAction, cAction, explicit) {
+            NotificationSoundsState(
+                messageSound = message,
+                callRingtone = call,
+                messageAction = mAction,
+                callAction = cAction,
+                hasExplicitCallRingtonePreference = explicit,
+            )
+        }
+    }
+
+    override fun setFromPickedUri(slot: NotificationSoundSlotId, picked: PickedSound) {
+        sessionCoroutineScope.launch { applyFromPicked(slot, picked) }
+    }
+
+    override fun setFromConfig(slot: NotificationSoundSlotId, config: NotificationSoundConfig) {
+        sessionCoroutineScope.launch { applyDirect(slot, config) }
+    }
+
+    override fun dismissError(slot: NotificationSoundSlotId) {
+        when (slot) {
+            NotificationSoundSlotId.MESSAGE -> messageAction.value = AsyncAction.Uninitialized
+            NotificationSoundSlotId.CALL -> callAction.value = AsyncAction.Uninitialized
+        }
+    }
+
+    override suspend fun migrateLegacyCallChannelSoundIfNeeded(): Boolean {
+        if (userPushStore.hasExplicitCallRingtonePreference().first()) {
+            // Never overwrite an explicit, user-set preference.
+            return false
+        }
+        val legacySound = notificationChannels.getCurrentChannelSoundUri(NotificationSoundSlot.CALL)
+            ?: return false
+        val systemDefault = Settings.System.DEFAULT_RINGTONE_URI
+        if (legacySound == systemDefault) {
+            // The platform default is already installed; recording it as a preference would
+            // be wasted, so we leave the preference absent and let the channel drive.
+            return false
+        }
+        // External content:// URIs are not guaranteed to survive reboots / app updates, so we
+        // copy the resource into our own storage and persist that. Schemes other than
+        // `content://` (e.g. `android.resource://`, `file://`) are kept as-is and used
+        // directly because they are app-stable.
+        val legacyPath = legacySound.toString()
+        val config: NotificationSoundConfig = if (legacySound.scheme == android.content.ContentResolver.SCHEME_CONTENT) {
+            val picked = PickedSound(legacySound, legacyPath.substringAfterLast('/').ifEmpty { legacyPath })
+            fileRepository.copyToAppStorage(picked, NotificationSoundSlotTag.CALL).fold(
+                onSuccess = { copied ->
+                    NotificationSoundConfig.Custom(absolutePath = copied.absolutePath, displayName = copied.displayName)
+                },
+                onFailure = { error ->
+                    Timber.w(error, "Could not copy legacy call channel sound; falling back to keeping the source URI")
+                    NotificationSoundConfig.Custom(absolutePath = legacyPath, displayName = legacyPath.substringAfterLast('/').ifEmpty { legacyPath })
+                }
+            )
+        } else {
+            NotificationSoundConfig.Custom(absolutePath = legacyPath, displayName = legacyPath.substringAfterLast('/').ifEmpty { legacyPath })
+        }
+        userPushStore.setCallRingtoneConfig(config.serialize())
+        callState.value = config
+        val currentVersion = userPushStore.getCallRingtoneChannelVersionFlow().first()
+        val next = currentVersion + 1
+        userPushStore.setCallRingtoneChannelVersion(next)
+        Timber.d("Migrated legacy call channel sound to $config (version=$next)")
+        return true
+    }
+
+    private suspend fun applyDirect(slot: NotificationSoundSlotId, config: NotificationSoundConfig) {
+        val lock = lockFor(slot)
+        val tokenState = tokenFor(slot)
+        val action = actionFor(slot)
+        var appliedUri: Uri? = null
+        var success = false
+        lock.withLock {
+            val token = tokenState.value + 1
+            tokenState.value = token
+            action.value = AsyncAction.Loading
+            try {
+                persistPreference(slot, config)
+                bumpChannelVersion(slot)
+                if (tokenState.value == token) {
+                    appliedUri = appliedUriFor(config)
+                    action.value = AsyncAction.Success(config)
+                    success = true
+                }
+            } catch (e: Throwable) {
+                Timber.e(e, "Failed to apply sound config $config to $slot")
+                if (tokenState.value == token) {
+                    action.value = AsyncAction.Failure(e)
+                }
+            }
+        }
+        // Push the new sound onto the system channel outside the lock to keep I/O brief
+        // and to let two concurrent slot updates make progress independently of each other.
+        if (success) {
+            updateChannel(slot, appliedUri)
+        }
+    }
+
+    private suspend fun applyFromPicked(slot: NotificationSoundSlotId, picked: PickedSound) {
+        val lock = lockFor(slot)
+        val tokenState = tokenFor(slot)
+        val action = actionFor(slot)
+        var pathToApply: String? = null
+        lock.withLock {
+            val token = tokenState.value + 1
+            tokenState.value = token
+            action.value = AsyncAction.Loading
+            // CRITICAL: the picker URI is transient — we must NOT persist it. Instead we
+            // copy to app storage first. If the copy fails we keep the previous effective
+            // sound and surface a dismissible error.
+            val copyResult = fileRepository.copyToAppStorage(picked, slot.tag())
+            copyResult.fold(
+                onSuccess = { copied ->
+                    if (tokenState.value != token) {
+                        // We've been superseded by a newer pick; clean up the file we just copied.
+                        cleanup(copied.absolutePath)
+                        return@fold
+                    }
+                    val config = NotificationSoundConfig.Custom(copied.absolutePath, copied.displayName)
+                    try {
+                        persistPreference(slot, config)
+                        bumpChannelVersion(slot)
+                        pathToApply = copied.absolutePath
+                        action.value = AsyncAction.Success(config)
+                    } catch (e: Throwable) {
+                        Timber.e(e, "Failed to persist $config for $slot")
+                        action.value = AsyncAction.Failure(e)
+                        cleanup(copied.absolutePath)
+                    }
+                },
+                onFailure = { error ->
+                    if (tokenState.value == token) {
+                        action.value = AsyncAction.Failure(error)
+                    }
+                }
+            )
+        }
+        // Apply the channel sound outside the lock so two concurrent picker results can
+        // still race on the channel — the channel-version token enforces ordering.
+        pathToApply?.let { path -> updateChannel(slot, Uri.fromFile(File(path))) }
+    }
+
+    private suspend fun persistPreference(slot: NotificationSoundSlotId, config: NotificationSoundConfig) {
+        when (slot) {
+            NotificationSoundSlotId.MESSAGE -> userPushStore.setMessageSoundConfig(config.serialize())
+            NotificationSoundSlotId.CALL -> userPushStore.setCallRingtoneConfig(config.serialize())
+        }
+    }
+
+    private fun bumpChannelVersion(slot: NotificationSoundSlotId) {
+        val current = when (slot) {
+            NotificationSoundSlotId.MESSAGE -> messageChannelVersion
+            NotificationSoundSlotId.CALL -> callChannelVersion
+        }
+        // Read once synchronously from the in-memory mirror so the version stays consistent
+        // with the existing flow state.
+        val next = current + 1
+        when (slot) {
+            NotificationSoundSlotId.MESSAGE -> {
+                messageChannelVersion = next
+                // Persist asynchronously so we don't block the lock; the value is also
+                // captured in the in-memory mirror so subsequent reads are accurate.
+                sessionCoroutineScope.launch { userPushStore.setMessageSoundChannelVersion(next) }
+            }
+            NotificationSoundSlotId.CALL -> {
+                callChannelVersion = next
+                sessionCoroutineScope.launch { userPushStore.setCallRingtoneChannelVersion(next) }
+            }
+        }
+    }
+
+    private fun updateChannel(slot: NotificationSoundSlotId, uri: Uri?) {
+        try {
+            notificationChannels.setChannelSound(slot.toNotificationSoundSlot(), uri)
+        } catch (e: Throwable) {
+            Timber.e(e, "Failed to update notification channel sound for $slot")
+        }
+    }
+
+    private suspend fun cleanup(path: String) {
+        withContext(Dispatchers.IO) {
+            fileRepository.delete(path)
+        }
+    }
+
+    private fun lockFor(slot: NotificationSoundSlotId): Mutex = when (slot) {
+        NotificationSoundSlotId.MESSAGE -> messageLock
+        NotificationSoundSlotId.CALL -> callLock
+    }
+
+    private fun tokenFor(slot: NotificationSoundSlotId): MutableStateFlow<Long> = when (slot) {
+        NotificationSoundSlotId.MESSAGE -> messageToken
+        NotificationSoundSlotId.CALL -> callToken
+    }
+
+    private fun actionFor(slot: NotificationSoundSlotId): MutableStateFlow<AsyncAction<NotificationSoundConfig>> = when (slot) {
+        NotificationSoundSlotId.MESSAGE -> messageAction
+        NotificationSoundSlotId.CALL -> callAction
+    }
+
+    // In-memory mirror of the DataStore-backed channel-version counter. Read by bumpChannelVersion
+    // and written after every successful apply so the next bump is monotonic.
+    @Volatile
+    private var messageChannelVersion: Int = 0
+    @Volatile
+    private var callChannelVersion: Int = 0
+}
+
+private fun appliedUriFor(config: NotificationSoundConfig): Uri? = when (config) {
+    is NotificationSoundConfig.Custom -> Uri.fromFile(File(config.absolutePath))
+    is NotificationSoundConfig.BundledPreset -> bundledPresetUri(config.presetId)
+    NotificationSoundConfig.SystemDefault -> null
+    NotificationSoundConfig.Silent -> null
+}
+
+/**
+ * Resolve the on-device URI of a bundled preset. Today there is only one preset
+ * (`element_default`) which lives in the push library raw resources.
+ */
+internal fun bundledPresetUri(presetId: String): Uri? {
+    if (presetId != NotificationSoundConfig.BUNDLED_PRESET_ELEMENT) return null
+    val packageName = bundledResourcePackageName ?: return null
+    return Uri.Builder()
+        .scheme(android.content.ContentResolver.SCHEME_ANDROID_RESOURCE)
+        .path("//" + packageName + "/" + bundledResourceRawId)
+        .build()
+}
+
+@Volatile
+internal var bundledResourcePackageName: String? = null
+
+@Volatile
+internal var bundledResourceRawId: Int = 0
