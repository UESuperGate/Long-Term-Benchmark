+/**
+ * Snapshot of the message-sound and call-ringtone settings as exposed to the view.
+ *
+ * Each slot is fully independent: changing one never changes the other.
+ */
+data class NotificationSoundSlotsState(
+    val messageSound: NotificationSoundConfig,
+    val callRingtone: NotificationSoundConfig,
+    val showMessageSoundDialog: Boolean,
+    val showCallRingtoneDialog: Boolean,
+    val messagePickerToken: Int,
+    val callPickerToken: Int,
+    val messageError: NotificationSoundError?,
+    val callError: NotificationSoundError?,
+    /** True when the user has set an explicit preference for the call ringtone. */
+    val hasExplicitCallRingtonePreference: Boolean,
+)
+
+/**
+ * A dismissible, retryable error surface for a sound-slot apply.
+ */
+data class NotificationSoundError(
+    val slot: NotificationSoundSlotId,
+    val message: String,
+    val cause: Throwable?,
+)
+
+/**
+ * Convert the sound service state into the view-facing [NotificationSoundSlotsState]. Pure mapping
+ * so it stays side-effect free and easy to unit-test.
+ */
+internal fun toNotificationSoundSlotsState(
+    messageSound: NotificationSoundConfig,
+    callRingtone: NotificationSoundConfig,
+    messageAction: AsyncAction<NotificationSoundConfig>,
+    callAction: AsyncAction<NotificationSoundConfig>,
+    showMessageSoundDialog: Boolean,
+    showCallRingtoneDialog: Boolean,
+    messagePickerToken: Int,
+    callPickerToken: Int,
+    hasExplicitCallRingtonePreference: Boolean,
+): NotificationSoundSlotsState = NotificationSoundSlotsState(
+    messageSound = messageSound,
+    callRingtone = callRingtone,
+    showMessageSoundDialog = showMessageSoundDialog,
+    showCallRingtoneDialog = showCallRingtoneDialog,
+    messagePickerToken = messagePickerToken,
+    callPickerToken = callPickerToken,
+    messageError = (messageAction as? AsyncAction.Failure)?.let {
+        NotificationSoundError(slot = NotificationSoundSlotId.MESSAGE, message = it.error.message ?: "error", cause = it.error)
+    },
+    callError = (callAction as? AsyncAction.Failure)?.let {
+        NotificationSoundError(slot = NotificationSoundSlotId.CALL, message = it.error.message ?: "error", cause = it.error)
+    },
+    hasExplicitCallRingtonePreference = hasExplicitCallRingtonePreference,
+)
