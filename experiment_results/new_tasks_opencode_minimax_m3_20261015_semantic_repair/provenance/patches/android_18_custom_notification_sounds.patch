+
+/**
+ * Copies user-picked audio documents into app-owned private storage so the resulting sound
+ * remains available across device reboots and so the picker-issued transient URI is never
+ * persisted as the effective sound.
+ */
+interface NotificationSoundFileRepository {
+    /**
+     * Copy [source] (typically a `content://` URI returned by the system file picker) into
+     * app-owned storage and report the new on-disk [Uri] and the chosen [displayName].
+     *
+     * @return [Result.success] with a [CopiedSound] on success, or [Result.failure] describing
+     * the failure. The original preference is **not** modified by this method.
+     */
+    suspend fun copyToAppStorage(source: PickedSound, slot: NotificationSoundSlotTag): Result<CopiedSound>
+
+    /**
+     * Delete a previously-copied file. Failures are logged but never throw.
+     */
+    suspend fun delete(filePath: String)
+
+    /**
+     * Resolve the on-disk [Uri] for a file at [absolutePath].
+     */
+    fun uriForFile(absolutePath: String): Uri
+}
+
+/**
+ * Identifier of the slot that owns the copied file. Files for the two slots live in
+ * separate folders so that picking a new message sound does not invalidate a saved call
+ * ringtone, and vice versa.
+ */
+enum class NotificationSoundSlotTag {
+    MESSAGE,
+    CALL,
+}
+
+data class CopiedSound(
+    val absolutePath: String,
+    val uri: Uri,
+    val displayName: String,
+    val slot: NotificationSoundSlotTag,
+)
+
+@ContributesBinding(AppScope::class)
+@SingleIn(AppScope::class)
+class DefaultNotificationSoundFileRepository(
+    @ApplicationContext private val context: Context,
+) : NotificationSoundFileRepository {
+    override suspend fun copyToAppStorage(source: PickedSound, slot: NotificationSoundSlotTag): Result<CopiedSound> {
+        return runCatchingExceptions {
+            val destinationDir = File(context.filesDir, "notification_sounds/${slot.folderName}").apply {
+                if (!exists()) mkdirs()
+            }
+            val name = source.displayName
+                .ifBlank { context.getFileName(source.uri) ?: "sound_${System.currentTimeMillis()}" }
+            val sanitizedName = name.sanitizeFileName()
+            val extension = sanitizedName.substringAfterLast('.', missingDelimiterValue = "")
+            val uniqueName = if (extension.isNotEmpty()) {
+                "${UUID.randomUUID()}.${extension}"
+            } else {
+                "${UUID.randomUUID()}.audio"
+            }
+            val tempFile = File(destinationDir, "tmp_${UUID.randomUUID()}")
+            val destFile = File(destinationDir, uniqueName)
+            // Read from the picker-provided URI and write to a temp file we control. We do this
+            // BEFORE swapping any preference or notification channel so that any I/O failure
+            // (broken content, removed document, permission loss) leaves the previous effective
+            // sound untouched.
+            val bytesCopied = context.contentResolver.openInputStream(source.uri)?.use { input ->
+                FileOutputStream(tempFile).use { output ->
+                    input.copyTo(output)
+                }
+                tempFile.length().also {
+                    if (it <= 0) {
+                        tempFile.delete()
+                        error("Copied sound file is empty")
+                    }
+                }
+            } ?: run {
+                tempFile.delete()
+                error("Could not open input stream for ${source.uri}")
+            }
+            // Atomic rename so we never expose a half-written file to the channel code.
+            if (!tempFile.renameTo(destFile)) {
+                // Some filesystems require explicit copy fallback.
+                tempFile.copyTo(destFile, overwrite = true)
+                tempFile.delete()
+            }
+            val uri = uriForFile(destFile.absolutePath)
+            CopiedSound(
+                absolutePath = destFile.absolutePath,
+                uri = uri,
+                displayName = sanitizedName,
+                slot = slot,
+            ).also {
+                Timber.d("Copied ${bytesCopied} bytes for $slot sound into ${destFile.absolutePath}")
+            }
+        }.onFailure { Timber.e(it, "Failed to copy notification sound for $slot") }
+    }
+
+    override suspend fun delete(filePath: String) {
+        runCatchingExceptions {
+            val file = File(filePath)
+            if (file.exists()) file.delete()
+        }
+    }
+
+    override fun uriForFile(absolutePath: String): Uri = File(absolutePath).toUri()
+
+    private val NotificationSoundSlotTag.folderName: String
+        get() = when (this) {
+            NotificationSoundSlotTag.MESSAGE -> "message"
+            NotificationSoundSlotTag.CALL -> "call"
+        }
+
+    private fun String.sanitizeFileName(): String {
+        val trimmed = trim()
+        if (trimmed.isEmpty()) return "sound.${System.currentTimeMillis()}.audio"
+        // Strip path separators and characters that aren't safe on every filesystem.
+        val safe = trimmed.replace(Regex("[\\\\/:*?\"<>|]"), "_")
+        return if (safe.length > 96) safe.substring(0, 96) else safe
+    }
+}
