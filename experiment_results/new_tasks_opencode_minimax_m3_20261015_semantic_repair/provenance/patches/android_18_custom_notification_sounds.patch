+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import io.element.android.libraries.architecture.AsyncAction
+
+/**
+ * In-memory [NotificationSoundsService] used by tests. The persisted side-effects (DataStore
+ * and channel writes) are stubbed; behaviour is captured through [setFromConfigCalls],
+ * [setFromPickedUriCalls] and [migrateCalls].
+ */
+class FakeNotificationSoundsService(
+    initialMessageSound: NotificationSoundConfig = NotificationSoundConfig.SystemDefault,
+    initialCallRingtone: NotificationSoundConfig = NotificationSoundConfig.SystemDefault,
+    initialExplicitCallRingtone: Boolean = false,
+) : NotificationSoundsService {
+    private var messageSoundState by mutableStateOf(initialMessageSound)
+    private var callRingtoneState by mutableStateOf(initialCallRingtone)
+    private var messageActionState by mutableStateOf<AsyncAction<NotificationSoundConfig>>(AsyncAction.Uninitialized)
+    private var callActionState by mutableStateOf<AsyncAction<NotificationSoundConfig>>(AsyncAction.Uninitialized)
+    private var explicitCallRingtonePreference by mutableStateOf(initialExplicitCallRingtone)
+
+    val setFromConfigCalls = mutableListOf<Pair<NotificationSoundSlotId, NotificationSoundConfig>>()
+    val setFromPickedUriCalls = mutableListOf<Pair<NotificationSoundSlotId, PickedSound>>()
+    val migrateCalls = mutableListOf<Unit>()
+
+    var migrateResult: Boolean = false
+
+    @Composable
+    override fun state(): NotificationSoundsState {
+        return NotificationSoundsState(
+            messageSound = messageSoundState,
+            callRingtone = callRingtoneState,
+            messageAction = messageActionState,
+            callAction = callActionState,
+            hasExplicitCallRingtonePreference = explicitCallRingtonePreference,
+        )
+    }
+
+    override fun setFromPickedUri(slot: NotificationSoundSlotId, picked: PickedSound) {
+        setFromPickedUriCalls += slot to picked
+        // Simulate a successful copy by deriving a custom config from the display name.
+        val config = NotificationSoundConfig.Custom(absolutePath = "/tmp/${picked.displayName}", displayName = picked.displayName)
+        when (slot) {
+            NotificationSoundSlotId.MESSAGE -> {
+                messageSoundState = config
+                messageActionState = AsyncAction.Success(config)
+            }
+            NotificationSoundSlotId.CALL -> {
+                callRingtoneState = config
+                callActionState = AsyncAction.Success(config)
+                explicitCallRingtonePreference = true
+            }
+        }
+    }
+
+    override fun setFromConfig(slot: NotificationSoundSlotId, config: NotificationSoundConfig) {
+        setFromConfigCalls += slot to config
+        when (slot) {
+            NotificationSoundSlotId.MESSAGE -> {
+                messageSoundState = config
+                messageActionState = AsyncAction.Success(config)
+            }
+            NotificationSoundSlotId.CALL -> {
+                callRingtoneState = config
+                callActionState = AsyncAction.Success(config)
+                explicitCallRingtonePreference = true
+            }
+        }
+    }
+
+    override fun dismissError(slot: NotificationSoundSlotId) {
+        when (slot) {
+            NotificationSoundSlotId.MESSAGE -> messageActionState = AsyncAction.Uninitialized
+            NotificationSoundSlotId.CALL -> callActionState = AsyncAction.Uninitialized
+        }
+    }
+
+    override suspend fun migrateLegacyCallChannelSoundIfNeeded(): Boolean {
+        migrateCalls += Unit
+        return migrateResult
+    }
+}
