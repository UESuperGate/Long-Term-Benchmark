+    val index = presets.indexOfFirst { it.matches(current) }.takeIf { it >= 0 } ?: 0
+    val optionsList = buildList {
+        addAll(presets.map { ListOption(title = soundLabel(it)) })
+        // Trailing "Custom…" entry.
