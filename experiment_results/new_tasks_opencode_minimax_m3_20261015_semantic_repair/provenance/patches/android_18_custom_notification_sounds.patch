+    }.toImmutableList()
+    SingleSelectionDialog(
+        title = dialogTitle,
+        options = optionsList,
+        initialSelection = index,
+        onSelectOption = { i ->
+            when {
+                i < presets.size -> presets.getOrNull(i)?.let { onSelectPreset(it) }
