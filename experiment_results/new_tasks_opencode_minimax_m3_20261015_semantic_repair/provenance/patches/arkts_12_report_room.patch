diff --git a/entry/src/main/ets/pages/InviteDeclinePage.ets b/entry/src/main/ets/pages/InviteDeclinePage.ets
new file mode 100644
index 0000000..8412c17
--- /dev/null
+++ b/entry/src/main/ets/pages/InviteDeclinePage.ets
@@ -0,0 +1,103 @@
+import router from '@ohos.router';
+
+interface InviteDeclineParams {
+  roomId?: string;
+  roomName?: string;
+  inviter?: string;
+}
+
+@Entry
+@Component
+struct InviteDeclinePage {
+  @State private roomId: string = '!room:example.org';
+  @State private roomName: string = 'Community support';
+  @State private inviter: string = '@alice:example.org';
+  @State private reason: string = '';
+
+  aboutToAppear(): void {
+    const params = router.getParams() as InviteDeclineParams | undefined;
+    if (params) {
+      if (params.roomId) {
+        this.roomId = String(params.roomId);
+      }
+      if (params.roomName) {
+        this.roomName = String(params.roomName);
+      }
+      if (params.inviter) {
+        this.inviter = String(params.inviter);
+      }
+    }
+  }
+
+  build() {
+    Column() {
+      Column({ space: 4 }) {
+        Text('Decline invite')
+          .fontSize(20)
+          .fontWeight(FontWeight.Bold)
+        Text(`${this.roomName} invited by ${this.inviter}`)
+          .fontSize(12)
+          .fontColor('#64748B')
+      }
+      .alignItems(HorizontalAlign.Start)
+      .padding(20)
+      .width('100%')
+      .backgroundColor('#FFFFFF')
+
+      Scroll() {
+        Column({ space: 12 }) {
+          Text('Optional note for the inviter')
+            .fontSize(13)
+            .fontColor('#64748B')
+            .width('100%')
+          TextInput({ text: this.reason, placeholder: 'Let the inviter know why (optional)' })
+            .id('invite_decline_reason_input')
+            .width('100%')
+            .onChange((value: string) => {
+              this.reason = value;
+            })
+
+          Button('Decline and leave')
+            .id('invite_decline_only')
+            .width('100%')
+            .onClick(() => {
+              router.back();
+            })
+
+          Button('Report and decline')
+            .id('invite_report_and_decline')
+            .width('100%')
+            .backgroundColor('#FEE2E2')
+            .fontColor('#B91C1C')
+            .onClick(() => {
+              router.pushUrl({
+                url: 'pages/ReportRoomPage',
+                params: {
+                  roomId: this.roomId,
+                  leaveRoom: true,
+                  initialReason: this.reason
+                }
+              });
+            })
+
+          Button('Back')
+            .id('invite_decline_back')
+            .width('100%')
+            .backgroundColor('#F1F5F9')
+            .fontColor('#0F172A')
+            .onClick(() => {
+              router.back();
+            })
+        }
+        .padding(20)
+        .width('100%')
+        .alignItems(HorizontalAlign.Start)
+      }
+      .layoutWeight(1)
+      .width('100%')
+    }
+    .height('100%')
+    .width('100%')
+    .backgroundColor('#F4F6F8')
+  }
+}
diff --git a/entry/src/main/ets/pages/ReportRoomPage.ets b/entry/src/main/ets/pages/ReportRoomPage.ets
new file mode 100644
index 0000000..9ddc90a
--- /dev/null
+++ b/entry/src/main/ets/pages/ReportRoomPage.ets
@@ -0,0 +1,157 @@
+import router from '@ohos.router';
+import {
+  ReportRoomGateway,
+  ReportRoomPhase,
+  ReportRoomPresenter
+} from '../features/ReportRoomFeature';
+
+interface ReportRoomNavigationParams {
+  roomId?: string;
+  initialReason?: string;
+  leaveRoom?: boolean;
+}
+
+@Entry
+@Component
+struct ReportRoomPage {
+  private presenter: ReportRoomPresenter = new ReportRoomPresenter(new ReportRoomGateway());
+  @State private reason: string = '';
+  @State private leaveRoom: boolean = false;
+  @State private phase: ReportRoomPhase = 'editing';
+  @State private statusText: string = '';
+
+  aboutToAppear(): void {
+    const params = router.getParams() as ReportRoomNavigationParams | undefined;
+    const roomId: string = (params && params.roomId) ? String(params.roomId) : '!room:example.org';
+    this.presenter.openReportRoom(roomId);
+    if (params && params.initialReason) {
+      this.presenter.updateReason(String(params.initialReason));
+    }
+    if (params && typeof params.leaveRoom === 'boolean') {
+      this.presenter.setLeaveRoom(params.leaveRoom);
+    }
+    this.syncFromPresenter();
+  }
+
+  private syncFromPresenter(): void {
+    this.reason = this.presenter.reason;
+    this.leaveRoom = this.presenter.leaveRoom;
+    this.phase = this.presenter.phase;
+    this.statusText = this.presenter.statusText();
+  }
+
+  build() {
+    Column() {
+      Column({ space: 4 }) {
+        Text('Report room')
+          .fontSize(20)
+          .fontWeight(FontWeight.Bold)
+        Text(this.presenter.roomId)
+          .fontSize(12)
+          .fontColor('#64748B')
+      }
+      .alignItems(HorizontalAlign.Start)
+      .padding(20)
+      .width('100%')
+      .backgroundColor('#FFFFFF')
+
+      Scroll() {
+        Column({ space: 12 }) {
+          Text('Reason')
+            .fontSize(13)
+            .fontColor('#64748B')
+            .width('100%')
+          TextInput({ text: this.reason, placeholder: 'Why are you reporting this room?' })
+            .id('report_reason_input')
+            .width('100%')
+            .enabled(this.presenter.canEditReason())
+            .onChange((value: string) => {
+              this.presenter.updateReason(value);
+              this.syncFromPresenter();
+            })
+
+          Row({ space: 8 }) {
+            Toggle({ type: ToggleType.Checkbox, isOn: this.leaveRoom })
+              .id('leave_room_toggle')
+              .enabled(this.presenter.canEditReason())
+              .onChange((isOn: boolean) => {
+                this.presenter.setLeaveRoom(isOn);
+                this.syncFromPresenter();
+              })
+            Text('Also leave this room')
+              .fontSize(14)
+          }
+          .width('100%')
+
+          if (this.presenter.canRetry()) {
+            Button('Retry leave only')
+              .id('retry_leave_only')
+              .width('100%')
+              .onClick(() => {
+                this.presenter.retry();
+                this.syncFromPresenter();
+              })
+          }
+
+          if (this.presenter.canClear()) {
+            Button('Dismiss error')
+              .id('clear_report_action')
+              .width('100%')
+              .backgroundColor('#F1F5F9')
+              .fontColor('#0F172A')
+              .onClick(() => {
+                this.presenter.clearReportAction();
+                this.syncFromPresenter();
+              })
+          }
+
+          Button(this.presenter.inFlight() ? 'Submitting…' : 'Send report')
+            .id('submit_report')
+            .width('100%')
+            .enabled(this.presenter.canSubmit() && !this.presenter.inFlight())
+            .onClick(() => {
+              this.presenter.submitReport();
+              this.syncFromPresenter();
+            })
+
+          Button('Cancel')
+            .id('cancel_report')
+            .width('100%')
+            .backgroundColor('#F1F5F9')
+            .fontColor('#0F172A')
+            .enabled(this.presenter.canCancel())
+            .onClick(() => {
+              this.presenter.cancel();
+              this.syncFromPresenter();
+              router.back();
+            })
+
+          Text(this.statusText)
+            .id('report_status')
+            .fontSize(13)
+            .fontColor('#64748B')
+            .width('100%')
+
+          if (this.phase === 'success') {
+            Text('Done')
+              .id('report_done')
+              .fontSize(13)
+              .fontColor('#16A34A')
+              .width('100%')
+              .onClick(() => {
+                router.back();
+              })
+          }
+        }
+        .padding(20)
+        .width('100%')
+        .alignItems(HorizontalAlign.Start)
+      }
+      .layoutWeight(1)
+      .width('100%')
+    }
+    .height('100%')
+    .width('100%')
+    .backgroundColor('#F4F6F8')
+  }
+}
