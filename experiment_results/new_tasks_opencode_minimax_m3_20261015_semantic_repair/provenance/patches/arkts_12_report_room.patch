diff --git a/entry/src/main/ets/features/ReportRoomFeature.ets b/entry/src/main/ets/features/ReportRoomFeature.ets
new file mode 100644
index 0000000..9fb85cc
--- /dev/null
+++ b/entry/src/main/ets/features/ReportRoomFeature.ets
@@ -0,0 +1,244 @@
+/**
+ * ReportRoomFeature
+ *
+ * Production state machine used by Element X to report a Matrix room and,
+ * optionally, leave it in the same submission.
+ *
+ * Design rationale
+ * - The visible UI is driven entirely by `phase`, `reason`, and `leaveRoom`.
+ * - Gateway side effects are encapsulated in `ReportRoomGateway`; only the
+ *   presenter ever calls the gateway, so forms cannot leak network traffic.
+ * - The state machine is explicit: each public method corresponds to one user
+ *   intent (edit reason, toggle leave, submit, retry, clear, cancel, dismiss).
+ *   Concurrent submissions are blocked by gating writes on the active phase.
+ * - A partial failure (report sent, leave failed) is recoverable: `retry()`
+ *   re-runs only the leave step while the report success is preserved.
+ * - Editing or clearing errors never re-emits network effects.
+ */
+
+export type ReportRoomPhase =
+  | 'idle'
+  | 'editing'
+  | 'submitting_report'
+  | 'submitting_leave'
+  | 'report_failed'
+  | 'leave_failed'
+  | 'success';
+
+export interface ReportRoomOutcome {
+  reported: boolean;
+  left: boolean;
+  phase: ReportRoomPhase;
+}
+
+export class ReportRoomGateway {
+  reportCalls: number = 0;
+  leaveCalls: number = 0;
+
+  reportRoom(roomId: string, reason: string): boolean {
+    this.reportCalls += 1;
+    return true;
+  }
+
+  leaveRoom(roomId: string): boolean {
+    this.leaveCalls += 1;
+    return true;
+  }
+}
+
+export class ReportRoomPresenter {
+  readonly gateway: ReportRoomGateway;
+  roomId: string = '';
+  reason: string = '';
+  leaveRoom: boolean = false;
+  phase: ReportRoomPhase = 'idle';
+  reportCalls: number = 0;
+  leaveCalls: number = 0;
+  lastOutcome: ReportRoomOutcome | null = null;
+
+  constructor(gateway: ReportRoomGateway) {
+    this.gateway = gateway;
+  }
+
+  private isEditable(): boolean {
+    return this.phase === 'idle'
+      || this.phase === 'editing'
+      || this.phase === 'report_failed'
+      || this.phase === 'leave_failed';
+  }
+
+  private isInFlight(): boolean {
+    return this.phase === 'submitting_report' || this.phase === 'submitting_leave';
+  }
+
+  openReportRoom(roomId: string): void {
+    if (this.isInFlight()) {
+      return;
+    }
+    this.roomId = roomId;
+    this.reason = '';
+    this.leaveRoom = false;
+    this.lastOutcome = null;
+    this.phase = 'editing';
+  }
+
+  updateReason(value: string): void {
+    if (!this.isEditable()) {
+      return;
+    }
+    this.reason = value;
+    this.phase = 'editing';
+  }
+
+  toggleLeaveRoom(): void {
+    if (!this.isEditable()) {
+      return;
+    }
+    this.leaveRoom = !this.leaveRoom;
+    this.phase = 'editing';
+  }
+
+  setLeaveRoom(value: boolean): void {
+    if (!this.isEditable()) {
+      return;
+    }
+    this.leaveRoom = value;
+    this.phase = 'editing';
+  }
+
+  submitReport(): void {
+    if (this.isInFlight()) {
+      return;
+    }
+    if (this.phase === 'leave_failed') {
+      // Partial failure path: only `retry` may resume; submit must not re-report.
+      return;
+    }
+    if (!this.isEditable()) {
+      return;
+    }
+    if (this.reason.trim().length === 0) {
+      return;
+    }
+
+    this.phase = 'submitting_report';
+    const reported = this.gateway.reportRoom(this.roomId, this.reason);
+    this.reportCalls += 1;
+
+    if (!reported) {
+      this.phase = 'report_failed';
+      this.lastOutcome = { reported: false, left: false, phase: this.phase };
+      return;
+    }
+
+    if (this.leaveRoom) {
+      this.phase = 'submitting_leave';
+      const left = this.gateway.leaveRoom(this.roomId);
+      this.leaveCalls += 1;
+      if (!left) {
+        this.phase = 'leave_failed';
+        this.lastOutcome = { reported: true, left: false, phase: this.phase };
+        return;
+      }
+    }
+
+    this.phase = 'success';
+    this.lastOutcome = {
+      reported: true,
+      left: this.leaveRoom,
+      phase: this.phase
+    };
+  }
+
+  retry(): void {
+    if (this.phase !== 'leave_failed') {
+      return;
+    }
+    if (this.isInFlight()) {
+      return;
+    }
+    this.phase = 'submitting_leave';
+    const left = this.gateway.leaveRoom(this.roomId);
+    this.leaveCalls += 1;
+    if (!left) {
+      this.phase = 'leave_failed';
+      this.lastOutcome = { reported: true, left: false, phase: this.phase };
+      return;
+    }
+    this.phase = 'success';
+    this.lastOutcome = {
+      reported: true,
+      left: true,
+      phase: this.phase
+    };
+  }
+
+  clearReportAction(): void {
+    if (this.phase !== 'report_failed' && this.phase !== 'leave_failed') {
+      return;
+    }
+    // Pure UI reset: no network effects, reason and leaveRoom are preserved.
+    this.phase = 'editing';
+  }
+
+  cancel(): void {
+    if (this.isInFlight()) {
+      // Cancellation is rejected while a side-effecting step is mid-flight so
+      // we never silently drop a matrix report or leave during submit.
+      return;
+    }
+    this.phase = 'idle';
+    this.lastOutcome = null;
+  }
+
+  reset(): void {
+    this.reason = '';
+    this.leaveRoom = false;
+    this.reportCalls = 0;
+    this.leaveCalls = 0;
+    this.phase = 'idle';
+    this.lastOutcome = null;
+  }
+
+  canEditReason(): boolean {
+    return this.isEditable();
+  }
+
+  canSubmit(): boolean {
+    return this.reason.trim().length > 0
+      && (this.phase === 'editing' || this.phase === 'idle' || this.phase === 'report_failed');
+  }
+
+  canRetry(): boolean {
+    return this.phase === 'leave_failed' && !this.isInFlight();
+  }
+
+  canClear(): boolean {
+    return this.phase === 'report_failed' || this.phase === 'leave_failed';
+  }
+
+  canCancel(): boolean {
+    return !this.isInFlight();
+  }
+
+  inFlight(): boolean {
+    return this.isInFlight();
+  }
+
+  statusText(): string {
+    switch (this.phase) {
+      case 'submitting_report':
+        return 'Sending report';
+      case 'submitting_leave':
+        return 'Leaving room';
+      case 'report_failed':
+        return 'Could not send the report. Try again.';
+      case 'leave_failed':
+        return 'Report sent. Leaving the room failed. Retry to leave only.';
+      case 'success':
+        return this.leaveRoom ? 'Report sent. You left the room.' : 'Report sent.';
+      default:
+        return '';
+    }
+  }
+}
