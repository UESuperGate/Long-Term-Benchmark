new file mode 100644
index 0000000..1bd74b2
--- /dev/null
+++ b/entry/src/main/ets/features/JoinRoomByAddress/types.ets
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: Apache-2.0
+// Types and Matrix alias parsing for the "join room by address" flow.
+
+export enum AddressState {
+  Unknown = 'unknown',
+  Invalid = 'invalid',
+  Resolving = 'resolving',
+  NotFound = 'not_found',
+  RoomFound = 'room_found'
+}
+
+export interface AddressValidation {
+  isValid: true;
+  normalized: string;
+  localPart: string;
+  domain: string;
+}
+
+export interface AddressParseFailure {
+  isValid: false;
+  reason: string;
+}
+
+export type AddressParseResult = AddressValidation | AddressParseFailure;
+
+export interface ResolvedRoom {
+  roomId: string;
+  servers: string[];
+}
+
+export type ResolverFailureKind =
+  | 'not_found'
+  | 'timeout'
+  | 'network'
+  | 'invalid_response'
+  | 'server_error'
+  | 'cancelled'
+  | 'unconfigured'
+  | 'unknown';
+
+export interface ResolverError {
+  kind: 'error';
+  reason: ResolverFailureKind;
+  message: string;
+}
+
+export type ResolverResult = ResolvedRoom | ResolverError;
+
+/**
+ * Lightweight cancellation handle. Implementations poll {@link cancelled}
+ * between awaits; the flow cancels stale resolutions when the user edits
+ * the address or dismisses the sheet.
+ */
+export interface CancellationHandle {
+  cancelled: boolean;
+}
+
+export class CancellationToken implements CancellationHandle {
+  cancelled: boolean = false;
+  private listeners: Array<() => void> = [];
+
+  cancel(): void {
+    if (this.cancelled) {
+      return;
+    }
+    this.cancelled = true;
+    for (let i: number = 0; i < this.listeners.length; i++) {
+      const fn: () => void = this.listeners[i];
+      try {
+        fn();
+      } catch (_e) {
+        // ignore listener failures
+      }
+    }
+    this.listeners = [];
+  }
+
+  onCancel(listener: () => void): void {
+    if (this.cancelled) {
+      try {
+        listener();
+      } catch (_e) {
+        // ignore
+      }
+      return;
+    }
+    this.listeners.push(listener);
+  }
+}
+
+const ALIAS_LOCAL_REGEX = /^[A-Za-z0-9._=/+-]{1,255}$/;
+const ALIAS_DOMAIN_REGEX = /^[A-Za-z0-9-]+(?:[.][A-Za-z0-9-]+)+$/;
+const MAX_ALIAS_LENGTH = 255;
+
+export function isResolverError(result: ResolverResult): boolean {
+  return (result as ResolverError).kind === 'error';
+}
+
+export function parseRoomAlias(input: string): AddressParseResult {
+  const raw: string = typeof input === 'string' ? input : '';
+  const trimmed: string = raw.trim();
+  if (trimmed.length === 0) {
+    return { isValid: false, reason: 'empty' };
+  }
+  if (trimmed.length > MAX_ALIAS_LENGTH) {
+    return { isValid: false, reason: 'too_long' };
+  }
+  if (!trimmed.startsWith('#')) {
+    return { isValid: false, reason: 'missing_hash' };
+  }
+  const colonIndex: number = trimmed.indexOf(':');
+  if (colonIndex <= 1) {
+    return { isValid: false, reason: 'missing_local_or_domain' };
+  }
+  const dotIndex: number = trimmed.indexOf('.', colonIndex + 1);
+  if (dotIndex < 0 || dotIndex === trimmed.length - 1) {
+    return { isValid: false, reason: 'invalid_domain' };
+  }
+  const localPart: string = trimmed.substring(1, colonIndex);
+  const domain: string = trimmed.substring(colonIndex + 1);
+  if (!ALIAS_LOCAL_REGEX.test(localPart)) {
+    return { isValid: false, reason: 'invalid_local_chars' };
+  }
+  if (!ALIAS_DOMAIN_REGEX.test(domain)) {
+    return { isValid: false, reason: 'invalid_domain' };
+  }
+  return {
+    isValid: true,
+    normalized: trimmed,
+    localPart,
+    domain
+  };
+}
