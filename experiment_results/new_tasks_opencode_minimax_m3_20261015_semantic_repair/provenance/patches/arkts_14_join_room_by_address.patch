--- /dev/null
+++ b/entry/src/main/ets/features/JoinRoomByAddress/HttpRoomAliasResolver.ets
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// HTTP-backed Matrix room alias resolver. Issues an authoritative GET
+// against `<homeserver>/_matrix/client/v3/directory/room/<alias>` and
+// surfaces every failure as a typed ResolverError so the UI can recover.
+//
+// Construction sites MUST consult a real homeserver (configured via the
+// active client session); pattern-based or fabricated room IDs are
+// disallowed by the task requirements.
+
+import http from '@ohos.net.http';
+import { RoomAliasResolver } from './RoomAliasResolver';
+import {
+  CancellationHandle,
+  ResolverError,
+  ResolverFailureKind,
+  ResolverResult,
+  ResolvedRoom
+} from './types';
+
+const DEFAULT_TIMEOUT_MS: number = 10000;
+
+function buildError(reason: ResolverFailureKind, message: string): ResolverError {
+  const err: ResolverError = { kind: 'error', reason, message };
+  return err;
+}
+
+function isCancelled(signal: CancellationHandle): boolean {
+  return signal.cancelled;
+}
+
+export class HttpRoomAliasResolver implements RoomAliasResolver {
+  private homeserverUrl: string;
+  private timeoutMs: number;
+
+  constructor(homeserverUrl: string = '', timeoutMs: number = DEFAULT_TIMEOUT_MS) {
+    this.homeserverUrl = normalize(homeserverUrl);
+    this.timeoutMs = timeoutMs > 0 ? timeoutMs : DEFAULT_TIMEOUT_MS;
+  }
+
+  setHomeserverUrl(homeserverUrl: string): void {
+    this.homeserverUrl = normalize(homeserverUrl);
+  }
+
+  async resolve(alias: string, server: string, signal: CancellationHandle): Promise<ResolverResult> {
+    if (this.homeserverUrl.length === 0) {
+      return buildError('unconfigured', 'Homeserver is not configured');
+    }
+    if (!alias.startsWith('#') || alias.indexOf(':') < 0) {
+      return buildError('invalid_response', 'Malformed alias passed to resolver');
+    }
+    const encodedAlias: string = encodeURIComponent(alias);
+    const url: string = `${this.homeserverUrl}/_matrix/client/v3/directory/room/${encodedAlias}`;
+
+    return new Promise<ResolverResult>((resolveOuter) => {
+      let settled: boolean = false;
+      const httpRequest = http.createHttp();
+      const finish = (result: ResolverResult): void => {
+        if (settled) {
+          return;
+        }
+        settled = true;
+        try {
+          httpRequest.destroy();
+        } catch (_e) {
+          // ignore
+        }
+        resolveOuter(result);
+      };
+
+      const timer: number = setTimeout((): void => {
+        finish(buildError('timeout',
+          `Alias resolution did not complete within ${this.timeoutMs}ms`));
+      }, this.timeoutMs);
+
+      const pollHandle: number = setInterval((): void => {
+        if (isCancelled(signal)) {
+          clearInterval(pollHandle);
+          clearTimeout(timer);
+          finish(buildError('cancelled', 'Alias resolution was cancelled'));
+        }
+      }, 50);
+      httpRequest.request(url, {
+        method: http.RequestMethod.GET,
+        header: { 'Accept': 'application/json' },
+        connectTimeout: this.timeoutMs,
+        readTimeout: this.timeoutMs
+      }).then((response: http.HttpResponse): void => {
+        clearTimeout(timer);
+        clearInterval(pollHandle);
+        const code: number = Number(response.responseCode);
+        if (isCancelled(signal)) {
+          finish(buildError('cancelled', 'Alias resolution was cancelled'));
+          return;
+        }
+        if (code === 404) {
+          finish(buildError('not_found',
+            `No room found for alias ${alias} on ${server}`));
+          return;
+        }
+        if (code === 0) {
+          finish(buildError('network',
+            `Network failure contacting ${server}`));
+          return;
+        }
+        if (code >= 500) {
+          finish(buildError('server_error',
+            `Homeserver responded with status ${code}`));
+          return;
+        }
+        if (code !== 200) {
+          finish(buildError('invalid_response',
+            `Unexpected response status ${code} for alias ${alias}`));
+          return;
+        }
+        const raw: Object = response.result as Object;
+        if (typeof raw !== 'string') {
+          finish(buildError('invalid_response',
+            'Empty response body from homeserver directory endpoint'));
+          return;
+        }
+        let parsed: Record<string, Object>;
+        try {
+          parsed = JSON.parse(raw) as Record<string, Object>;
+        } catch (_parseErr) {
+          finish(buildError('invalid_response',
+            'Homeserver returned malformed JSON for alias lookup'));
+          return;
+        }
+        const roomIdValue: Object = parsed['room_id'];
+        if (typeof roomIdValue !== 'string' || roomIdValue.length === 0) {
+          finish(buildError('invalid_response',
+            'Homeserver response did not include a room_id'));
+          return;
+        }
+        const roomId: string = roomIdValue;
+        const serversValue: Object = parsed['servers'];
+        let servers: string[] = [];
+        if (Array.isArray(serversValue)) {
+          const collected: string[] = [];
+          for (const s of serversValue as Object[]) {
+            if (typeof s === 'string' && s.length > 0) {
+              collected.push(s);
+            }
+          }
+          servers = collected;
+        }
+        if (servers.length === 0) {
+          servers = [server];
+        }
+        const resolved: ResolvedRoom = { roomId, servers };
+        finish(resolved);
+      }).catch((err: Error): void => {
+        clearTimeout(timer);
+        clearInterval(pollHandle);
+        finish(buildError('network',
+          `Network failure contacting ${server}: ${err.message ?? 'unknown'}`));
+      });
+    });
+  }
+}
+
+function normalize(input: string): string {
+  return input.replace(/\/+$/, '');
+}
diff --git a/entry/src/main/ets/features/JoinRoomByAddress/JoinRoomByAddressPresenter.ets b/entry/src/main/ets/features/JoinRoomByAddress/JoinRoomByAddressPresenter.ets
