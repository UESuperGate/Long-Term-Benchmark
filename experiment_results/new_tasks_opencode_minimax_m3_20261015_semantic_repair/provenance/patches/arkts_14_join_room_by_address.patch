@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: Apache-2.0
+// Room preview screen reached from the "join by address" flow.
+// Shows the resolved room identity and offers the join/return actions.
+
+import router from '@ohos.router';
+
+interface PreviewParams {
+  roomId: string;
+  address: string;
+  servers: string[];
+}
+
+@Entry
+@Component
+struct RoomPreviewPage {
+  @State private roomId: string = '';
+  @State private address: string = '';
+  @State private serversText: string = '';
+  @State private joined: boolean = false;
+  @State private hasServers: boolean = false;
+
+  aboutToAppear(): void {
+    const params: Object = router.getParams();
+    if (params !== null && typeof params === 'object') {
+      const record = params as Record<string, Object>;
+      const rid: Object = record['roomId'];
+      if (typeof rid === 'string') {
+        this.roomId = rid;
+      }
+      const addr: Object = record['address'];
+      if (typeof addr === 'string') {
+        this.address = addr;
+      }
+      const srvs: Object = record['servers'];
+      if (Array.isArray(srvs)) {
+        const collected: string[] = [];
+        for (const s of srvs as Object[]) {
+          if (typeof s === 'string' && s.length > 0) {
+            collected.push(s);
+          }
+        }
+        if (collected.length > 0) {
+          this.serversText = collected.join(', ');
+          this.hasServers = true;
+        }
+      }
+    }
+  }
+
+  build() {
+    Column() {
+      Column({ space: 4 }) {
+        Text('Room preview')
+          .fontSize(22)
+          .fontWeight(FontWeight.Bold)
+        Text(this.address.length > 0 ? this.address : 'Resolved room')
+          .fontSize(14)
+          .fontColor('#0F172A')
+      }
+      .alignItems(HorizontalAlign.Start)
+      .padding({ left: 20, right: 20, top: 24, bottom: 16 })
+      .width('100%')
+      .backgroundColor('#FFFFFF')
+
+      Column({ space: 12 }) {
+        Column({ space: 6 }) {
+          Text('Room address')
+            .fontSize(12)
+            .fontColor('#64748B')
+          Text(this.address.length > 0 ? this.address : 'Unknown')
+            .id('preview_address')
+            .fontSize(16)
+            .fontWeight(FontWeight.Medium)
+        }
+        .alignItems(HorizontalAlign.Start)
+        .padding(14)
+        .width('100%')
+        .borderRadius(10)
+        .backgroundColor('#FFFFFF')
+
+        Column({ space: 6 }) {
+          Text('Room ID')
+            .fontSize(12)
+            .fontColor('#64748B')
+          Text(this.roomId.length > 0 ? this.roomId : 'Unknown')
+            .id('preview_room_id')
+            .fontSize(14)
+            .fontColor('#0F172A')
+        }
+        .alignItems(HorizontalAlign.Start)
+        .padding(14)
+        .width('100%')
+        .borderRadius(10)
+        .backgroundColor('#FFFFFF')
+
+        if (this.hasServers) {
+          Column({ space: 6 }) {
+            Text('Homeservers')
+              .fontSize(12)
+              .fontColor('#64748B')
+            Text(this.serversText)
+              .id('preview_servers')
+              .fontSize(14)
+              .fontColor('#0F172A')
+          }
+          .alignItems(HorizontalAlign.Start)
+          .padding(14)
+          .width('100%')
+          .borderRadius(10)
+          .backgroundColor('#FFFFFF')
+        }
+      }
+      .padding(20)
+      .width('100%')
+      .layoutWeight(1)
+
+      Column({ space: 12 }) {
+        Button(this.joined ? 'Joined' : 'Join room')
+          .id('preview_join_button')
+          .width('100%')
+          .height(48)
+          .backgroundColor(this.joined ? '#94A3B8' : '#0F766E')
+          .onClick((): void => {
+            this.joined = true;
+          })
+
+        Button('Back')
+          .id('preview_back_button')
+          .width('100%')
+          .height(44)
+          .backgroundColor('#FFFFFF')
+          .fontColor('#0F172A')
+          .onClick((): void => {
+            try {
+              router.back();
+            } catch (_e) {
+              // already on root
+            }
+          })
+      }
+      .padding(20)
+      .width('100%')
+      .backgroundColor('#FFFFFF')
+    }
+    .height('100%')
+    .width('100%')
+    .backgroundColor('#F4F6F8')
+  }
+}
