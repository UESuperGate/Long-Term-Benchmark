--- /dev/null
+++ b/entry/src/main/ets/features/JoinRoomByAddress/JoinRoomByAddressPresenter.ets
@@ -0,0 +1,405 @@
+// SPDX-License-Identifier: Apache-2.0
+// State machine for the "join room by address" flow.
+//
+// States and transitions:
+//
+//   Unknown(touched)         -> editing -> Invalid || Resolving
+//   Invalid                  -> editing
+//   Resolving                -> editing (cancel) | RoomFound | NotFound
+//   RoomFound                -> editing (cancel + clear)
+//   NotFound                 -> editing (cancel + clear) | Retry -> Resolving
+//
+// Editing the field cancels any in-flight resolve via the cancellation
+// handle, clears stale validation, and bumps the session token; a
+// response for a previous address therefore can never replace the
+// current result.
+//
+// Continue on invalid/empty input reveals validation without issuing a
+// resolution request. Continue while a valid address is resolving sets
+// a pending-continuation flag and the flow auto-advances if and only
+// if the same address resolves.
+
+import { RoomAliasResolver } from './RoomAliasResolver';
+import { DelegatingRoomAliasResolver, DirectoryLookupFn } from './DelegatingRoomAliasResolver';
+import { HttpRoomAliasResolver } from './HttpRoomAliasResolver';
+import {
+  AddressParseResult,
+  AddressState,
+  CancellationToken,
+  ResolvedRoom,
+  ResolverError,
+  ResolverResult,
+  parseRoomAlias
+} from './types';
+
+export interface NavigationParams {
+  roomId: string;
+  address: string;
+  servers: string[];
+}
+
+export type StateChangeListener = () => void;
+
+const RESOLVE_DEBOUNCE_MS: number = 300;
+
+export class JoinRoomByAddressPresenter {
+  // Observable surface (UI mirrors these via @State).
+  rawInput: string = '';
+  address: string = '';
+  localPart: string = '';
+  domain: string = '';
+  addressState: AddressState = AddressState.Unknown;
+  internalAddressState: AddressState = AddressState.Unknown;
+  validationRequested: boolean = false;
+  resolvedRoom: ResolvedRoom | null = null;
+  lastError: ResolverError | null = null;
+  pendingContinue: boolean = false;
+  isResolving: boolean = false;
+  pendingNavigation: NavigationParams | null = null;
+  closed: boolean = false;
+  resolvingRequestId: number = 0;
+
+  // Wiring.
+  private resolver: RoomAliasResolver;
+  private listener: StateChangeListener | null = null;
+
+  // Internal bookkeeping.
+  private debounceTimer: number = 0;
+  private currentToken: CancellationToken | null = null;
+  private sessionToken: number = 0;
+
+  constructor(resolver?: RoomAliasResolver) {
+    this.resolver = resolver ?? new HttpRoomAliasResolver('');
+  }
+
+  setResolver(resolver: RoomAliasResolver): void {
+    this.resolver = resolver;
+  }
+
+  setDirectoryLookup(lookup: DirectoryLookupFn | null): void {
+    if (this.resolver instanceof DelegatingRoomAliasResolver) {
+      this.resolver.setLookup(lookup);
+    }
+  }
+
+  setHomeserverUrl(homeserverUrl: string): void {
+    if (this.resolver instanceof HttpRoomAliasResolver) {
+      this.resolver.setHomeserverUrl(homeserverUrl);
+    }
+  }
+
+  setOnStateChange(listener: StateChangeListener | null): void {
+    this.listener = listener;
+  }
+
+  /** Replace any in-flight work; prepare for re-use. */
+  reset(): void {
+    this.cancelInFlight();
+    this.rawInput = '';
+    this.address = '';
+    this.localPart = '';
+    this.domain = '';
+    this.addressState = AddressState.Unknown;
+    this.internalAddressState = AddressState.Unknown;
+    this.validationRequested = false;
+    this.resolvedRoom = null;
+    this.lastError = null;
+    this.pendingContinue = false;
+    this.isResolving = false;
+    this.pendingNavigation = null;
+    this.closed = false;
+    this.resolvingRequestId = 0;
+    this.notifyChange();
+  }
+
+  /** User typed a new value. Cancels stale resolution, kicks off debounced resolve. */
+  updateAddress(value: string): void {
+    this.rawInput = typeof value === 'string' ? value : '';
+    this.validationRequested = false;
+    this.resolvedRoom = null;
+    this.lastError = null;
+    this.pendingContinue = false;
+    this.pendingNavigation = null;
+
+    this.cancelInFlight();
+
+    const trimmed: string = this.rawInput.trim();
+    const parsed: AddressParseResult = parseRoomAlias(trimmed);
+
+    if (trimmed.length === 0) {
+      this.internalAddressState = AddressState.Unknown;
+      this.addressState = AddressState.Unknown;
+      this.address = '';
+      this.localPart = '';
+      this.domain = '';
+      this.notifyChange();
+      return;
+    }
+
+    if (parsed.isValid) {
+      this.address = parsed.normalized;
+      this.localPart = parsed.localPart;
+      this.domain = parsed.domain;
+      this.internalAddressState = AddressState.Resolving;
+      this.addressState = AddressState.Resolving;
+      this.notifyChange();
+      this.scheduleResolve(parsed.normalized, parsed.domain);
+      return;
+    }
+
+    // Syntactically invalid: surface it only after the user has asked
+    // for validation (e.g. by tapping Continue). Mid-typing keeps the
+    // visible state at Unknown.
+    this.address = trimmed;
+    this.localPart = '';
+    this.domain = '';
+    this.internalAddressState = AddressState.Invalid;
+    this.addressState = AddressState.Unknown;
+    this.notifyChange();
+  }
+
+  /** User tapped Continue. */
+  requestContinue(): void {
+    if (this.closed) {
+      return;
+    }
+    this.validationRequested = true;
+
+    const trimmed: string = this.rawInput.trim();
+    const parsed: AddressParseResult = parseRoomAlias(trimmed);
+
+    if (parsed.isValid) {
+      this.address = parsed.normalized;
+      this.localPart = parsed.localPart;
+      this.domain = parsed.domain;
+    }
+
+    // Empty input -> show the validation error.
+    if (trimmed.length === 0) {
+      this.addressState = AddressState.Invalid;
+      this.internalAddressState = AddressState.Invalid;
+      this.notifyChange();
+      return;
+    }
+
+    // Invalid syntax -> reveal the validation error without resolving.
+    if (parsed.isValid !== true) {
+      this.addressState = AddressState.Invalid;
+      this.internalAddressState = AddressState.Invalid;
+      this.notifyChange();
+      return;
+    }
+
+    // Already resolved -> navigate.
+    if (this.addressState === AddressState.RoomFound && this.resolvedRoom !== null) {
+      this.navigateToPreview();
+      this.notifyChange();
+      return;
+    }
+
+    // Currently resolving -> mark for auto-advance when same address resolves.
+    if (this.addressState === AddressState.Resolving) {
+      this.internalAddressState = AddressState.Resolving;
+      this.pendingContinue = true;
+      this.notifyChange();
+      return;
+    }
+
+    // Not found with valid input -> retry the resolve.
+    if (this.addressState === AddressState.NotFound) {
+      this.addressState = AddressState.Resolving;
+      this.internalAddressState = AddressState.Resolving;
+      this.lastError = null;
+      this.pendingContinue = true;
+      this.notifyChange();
+      this.scheduleResolve(parsed.normalized, parsed.domain);
+      return;
+    }
+
+    // Invalid (validation already shown) -> no-op, message stays.
+    if (this.addressState === AddressState.Invalid) {
+      this.notifyChange();
+      return;
+    }
+
+    // Otherwise (Unknown with valid input that hasn't started resolving yet) -> start now.
+    if (this.addressState === AddressState.Unknown) {
+      this.addressState = AddressState.Resolving;
+      this.internalAddressState = AddressState.Resolving;
+      this.pendingContinue = true;
+      this.notifyChange();
+      this.scheduleResolve(parsed.normalized, parsed.domain);
+      return;
+    }
+  }
+
+  /** User tapped the Retry action in the not-found state. */
+  retry(): void {
+    if (this.closed) {
+      return;
+    }
+    const trimmed: string = this.rawInput.trim();
+    const parsed: AddressParseResult = parseRoomAlias(trimmed);
+    if (parsed.isValid !== true) {
+      this.addressState = AddressState.Invalid;
+      this.internalAddressState = AddressState.Invalid;
+      this.validationRequested = true;
+      this.notifyChange();
+      return;
+    }
+    this.address = parsed.normalized;
+    this.localPart = parsed.localPart;
+    this.domain = parsed.domain;
+    this.lastError = null;
+    this.addressState = AddressState.Resolving;
+    this.internalAddressState = AddressState.Resolving;
+    this.notifyChange();
+    this.scheduleResolve(parsed.normalized, parsed.domain);
+  }
+
+  /** User dismissed the flow without joining anything. */
+  dismiss(): void {
+    if (this.closed) {
+      return;
+    }
+    this.closed = true;
+    this.cancelInFlight();
+    this.pendingContinue = false;
+    this.pendingNavigation = null;
+    this.notifyChange();
+  }
+
+  /** Acknowledge a navigation request already consumed by the UI. */
+  consumePendingNavigation(): void {
+    this.pendingNavigation = null;
+    this.notifyChange();
+  }
+
+  /** Allow external resolvers to push their result into the state machine. */
+  notifyResolverResult(address: string, result: ResolverResult): void {
+    const trimmedAddress: string = (address ?? '').trim();
+    if (trimmedAddress.length === 0) {
+      return;
+    }
+    if (trimmedAddress !== this.address) {
+      return; // stale response for a different address
+    }
+    this.applyResult(trimmedAddress, result);
+  }
+
+  // -------- internal --------
+
+  private cancelInFlight(): void {
+    this.sessionToken += 1;
+    if (this.debounceTimer !== 0) {
+      clearTimeout(this.debounceTimer);
+      this.debounceTimer = 0;
+    }
+    if (this.currentToken !== null) {
+      try {
+        this.currentToken.cancel();
+      } catch (_e) {
+        // ignore
+      }
+      this.currentToken = null;
+    }
+    this.isResolving = false;
+  }
+
+  private scheduleResolve(normalized: string, server: string): void {
+    if (this.closed) {
+      return;
+    }
+    this.resolvingRequestId += 1;
+    const myToken: number = this.sessionToken;
+    const myRequestId: number = this.resolvingRequestId;
+    this.debounceTimer = setTimeout(() => {
+      this.debounceTimer = 0;
+      if (myToken !== this.sessionToken) {
+        return;
+      }
+      void this.runResolve(normalized, server, myToken, myRequestId);
+    }, RESOLVE_DEBOUNCE_MS);
+  }
+
+  private async runResolve(normalized: string, server: string, token: number, requestId: number): Promise<void> {
+    if (this.closed) {
+      return;
+    }
+    const signal: CancellationToken = new CancellationToken();
+    this.currentToken = signal;
+    this.isResolving = true;
+
+    let result: ResolverResult;
+    try {
+      result = await this.resolver.resolve(normalized, server, signal);
+    } catch (e) {
+      const message: string = (e as Error).message ?? String(e);
+      result = { kind: 'error', reason: 'network', message };
+    }
+
+    if (token !== this.sessionToken) {
+      return; // stale
+    }
+    if (requestId !== this.resolvingRequestId) {
+      return; // a newer resolve was started
+    }
+    if (signal.cancelled) {
+      return;
+    }
+    if (this.currentToken === signal) {
+      this.currentToken = null;
+    }
+    this.isResolving = false;
+    this.applyResult(normalized, result);
+  }
+
+  private applyResult(address: string, result: ResolverResult): void {
+    if (this.closed) {
+      return;
+    }
+    if (address !== this.address) {
+      return; // stale
+    }
+    const errCandidate: ResolverError = result as ResolverError;
+    if (errCandidate.kind === 'error') {
+      this.resolvedRoom = null;
+      this.lastError = errCandidate;
+      this.addressState = AddressState.NotFound;
+      this.pendingContinue = false;
+      this.notifyChange();
+      return;
+    }
+    const roomCandidate: ResolvedRoom = result as ResolvedRoom;
+    this.resolvedRoom = roomCandidate;
+    this.lastError = null;
+    this.addressState = AddressState.RoomFound;
+    if (this.pendingContinue) {
+      this.pendingContinue = false;
+      this.navigateToPreview();
+    }
+    this.notifyChange();
+  }
+
+  private navigateToPreview(): void {
+    if (this.closed || this.resolvedRoom === null) {
+      return;
+    }
+    const room: ResolvedRoom = this.resolvedRoom;
+    this.pendingNavigation = {
+      roomId: room.roomId,
+      address: this.address,
+      servers: room.servers.slice()
+    };
+  }
+
+  private notifyChange(): void {
+    if (this.listener !== null) {
+      try {
+        this.listener();
+      } catch (_e) {
+        // listener errors must not break the state machine
+      }
+    }
+  }
+}
diff --git a/entry/src/main/ets/features/JoinRoomByAddress/RoomAliasResolver.ets b/entry/src/main/ets/features/JoinRoomByAddress/RoomAliasResolver.ets
new file mode 100644
index 0000000..a549c2e
--- /dev/null
+++ b/entry/src/main/ets/features/JoinRoomByAddress/RoomAliasResolver.ets
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: Apache-2.0
+// Authoritative room alias resolution interface.
+// Implementations are required to consult a real source of truth
+// (e.g. the configured Matrix homeserver directory endpoint).
+// Pattern-based or fabricated room IDs are not allowed.
+
+import { CancellationHandle, ResolverResult } from './types';
+
+export interface RoomAliasResolver {
+  resolve(alias: string, server: string, signal: CancellationHandle): Promise<ResolverResult>;
+}
