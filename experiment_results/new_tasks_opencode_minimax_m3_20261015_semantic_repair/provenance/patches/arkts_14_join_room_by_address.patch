+++ b/entry/src/main/ets/features/JoinRoomByAddress/DelegatingRoomAliasResolver.ets
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: Apache-2.0
+// Pluggable resolver that delegates to a caller-provided function. This
+// lets production builds wire the real Matrix homeserver directory
+// lookup (HTTP-backed) without forcing the UI layer to depend on the
+// networking module. The flow stays authoritative: a missing delegate is
+// surfaced as 'unconfigured' rather than fabricating a room ID.
+
+import { RoomAliasResolver } from './RoomAliasResolver';
+import {
+  CancellationHandle,
+  CancellationToken,
+  ResolverError,
+  ResolverFailureKind,
+  ResolverResult,
+  ResolvedRoom
+} from './types';
+
+export type DirectoryLookupFn = (alias: string, server: string, signal: CancellationHandle)
+  => Promise<ResolverResult>;
+
+const DEFAULT_TIMEOUT_MS: number = 10000;
+
+function buildError(reason: ResolverFailureKind, message: string): ResolverError {
+  const err: ResolverError = { kind: 'error', reason, message };
+  return err;
+}
+
+function isCancellationToken(value: Object): boolean {
+  return value instanceof CancellationToken;
+}
+
+function isErrorResult(result: ResolverResult): boolean {
+  const candidate: ResolverError = result as ResolverError;
+  return candidate.kind === 'error';
+}
+
+export class DelegatingRoomAliasResolver implements RoomAliasResolver {
+  private lookup: DirectoryLookupFn | null;
+  private timeoutMs: number;
+
+  constructor(lookup: DirectoryLookupFn | null, timeoutMs: number = DEFAULT_TIMEOUT_MS) {
+    this.lookup = lookup;
+    this.timeoutMs = timeoutMs > 0 ? timeoutMs : DEFAULT_TIMEOUT_MS;
+  }
+
+  setLookup(lookup: DirectoryLookupFn | null): void {
+    this.lookup = lookup;
+  }
+
+  async resolve(alias: string, server: string, signal: CancellationHandle): Promise<ResolverResult> {
+    if (!alias.startsWith('#') || alias.indexOf(':') < 0) {
+      return buildError('invalid_response', 'Malformed alias passed to resolver');
+    }
+    if (this.lookup === null) {
+      return buildError('unconfigured',
+        'No homeserver directory lookup is configured for this build');
+    }
+    const token: CancellationToken = new CancellationToken();
+    const cancelBridge = (): void => {
+      token.cancel();
+    };
+    if (signal.cancelled) {
+      token.cancel();
+      return buildError('cancelled', 'Alias resolution was cancelled');
+    }
+    if (isCancellationToken(signal)) {
+      const upstream: CancellationToken = signal as CancellationToken;
+      upstream.onCancel((): void => {
+        token.cancel();
+        cancelBridge();
+      });
+    } else {
+      const handle: CancellationHandle = signal;
+      const interval: number = setInterval(() => {
+        const cancelledHandle: boolean = handle.cancelled;
+        const cancelledToken: boolean = token.cancelled;
+        if (cancelledHandle || cancelledToken) {
+          clearInterval(interval);
+          token.cancel();
+        }
+      }, 50);
+      token.onCancel((): void => clearInterval(interval));
+    }
+
+    let timer: number = 0;
+    const timeoutPromise: Promise<ResolverResult> = new Promise<ResolverResult>((resolveOuter) => {
+      timer = setTimeout(() => {
+        token.cancel();
+        resolveOuter(buildError('timeout',
+          `Alias resolution did not complete within ${this.timeoutMs}ms`));
+      }, this.timeoutMs);
+    });
+
+    try {
+      const lookup: DirectoryLookupFn = this.lookup;
+      const lookupPromise: Promise<ResolverResult> = lookup(alias, server, token);
+      const result: ResolverResult = await Promise.race<ResolverResult>([lookupPromise, timeoutPromise]);
+      if (timer !== 0) {
+        clearTimeout(timer);
+        timer = 0;
+      }
+      if (token.cancelled && !this.isTerminalResult(result)) {
+        return buildError('cancelled', 'Alias resolution was cancelled');
+      }
+      return result;
+    } catch (e) {
+      if (timer !== 0) {
+        clearTimeout(timer);
+        timer = 0;
+      }
+      const message: string = (e as Error).message ?? String(e);
+      if (token.cancelled) {
+        return buildError('cancelled', 'Alias resolution was cancelled');
+      }
+      return buildError('network', `Resolver failure: ${message}`);
+    }
+  }
+
+  private isTerminalResult(result: ResolverResult): boolean {
+    if (isErrorResult(result)) {
+      const err: ResolverError = result as ResolverError;
+      return err.reason === 'cancelled';
+    }
+    const room: ResolvedRoom = result as ResolvedRoom;
+    return typeof room.roomId === 'string' && room.roomId.length > 0;
+  }
+}
diff --git a/entry/src/main/ets/features/JoinRoomByAddress/HttpRoomAliasResolver.ets b/entry/src/main/ets/features/JoinRoomByAddress/HttpRoomAliasResolver.ets
