diff --git a/entry/src/main/ets/pages/JoinRoomByAddress.ets b/entry/src/main/ets/pages/JoinRoomByAddress.ets
new file mode 100644
index 0000000..ad3d6b8
--- /dev/null
+++ b/entry/src/main/ets/pages/JoinRoomByAddress.ets
@@ -0,0 +1,359 @@
+// SPDX-License-Identifier: Apache-2.0
+// "Join room by address" flow page.
+// Renders the address-entry form, the in-progress resolution state, the
+// resolved-room preview/join transition, and the failure/retry surfaces.
+
+import router from '@ohos.router';
+import {
+  AddressState,
+  ResolverError,
+  ResolverFailureKind,
+  ResolvedRoom,
+  parseRoomAlias
+} from '../features/JoinRoomByAddress/types';
+import {
+  JoinRoomByAddressPresenter,
+  NavigationParams
+} from '../features/JoinRoomByAddress/JoinRoomByAddressPresenter';
+
+const PLACEHOLDER_HINT: string = '#room:server.name';
+
+function describeResolverError(error: ResolverError): string {
+  const reason: ResolverFailureKind = error.reason;
+  if (reason === 'not_found') {
+    return 'No matching room was found for this address. Check the spelling and try again.';
+  }
+  if (reason === 'timeout') {
+    return 'Resolving the room took too long. Check your connection and retry.';
+  }
+  if (reason === 'network') {
+    return 'Could not reach the homeserver. Check your connection and retry.';
+  }
+  if (reason === 'server_error') {
+    return 'The homeserver reported an error. Please retry in a moment.';
+  }
+  if (reason === 'invalid_response') {
+    return 'The homeserver returned an unexpected response. Please retry.';
+  }
+  if (reason === 'cancelled') {
+    return 'Resolution was cancelled before it could finish.';
+  }
+  if (reason === 'unconfigured') {
+    return 'This build is not configured with a homeserver directory.';
+  }
+  return 'Unable to resolve this room address right now. Please retry.';
+}
+
+function describeInvalidSyntax(reason: string | undefined): string {
+  if (reason === 'empty') {
+    return 'Enter a room address to continue.';
+  }
+  if (reason === 'missing_hash') {
+    return 'A room address must start with #, for example #room:server.name.';
+  }
+  if (reason === 'missing_local_or_domain') {
+    return 'A room address needs both a local part and a server, like #room:server.name.';
+  }
+  if (reason === 'invalid_local_chars') {
+    return 'The local part of a room address may contain letters, digits, dots, dashes and underscores.';
+  }
+  if (reason === 'invalid_domain') {
+    return 'The server part must be a valid domain like matrix.example.org.';
+  }
+  if (reason === 'too_long') {
+    return 'That address is too long. Please shorten it and try again.';
+  }
+  return 'Enter a room address in the form #room:server.name.';
+}
+
+interface PreviewParams {
+  roomId: string;
+  address: string;
+  servers: string[];
+}
+
+@Entry
+@Component
+struct JoinRoomByAddress {
+  private presenter: JoinRoomByAddressPresenter = new JoinRoomByAddressPresenter();
+
+  @State private rawInput: string = '';
+  @State private address: string = '';
+  @State private addressState: AddressState = AddressState.Unknown;
+  @State private validationRequested: boolean = false;
+  @State private validationMessage: string = '';
+  @State private resolvedRoom: ResolvedRoom | null = null;
+  @State private lastError: ResolverError | null = null;
+  @State private pendingContinue: boolean = false;
+  @State private isResolving: boolean = false;
+  @State private pendingNavigation: NavigationParams | null = null;
+  @State private closed: boolean = false;
+  @State private errorMessage: string = '';
+  @State private foundRoomId: string = '';
+  @State private foundServers: string = '';
+
+  aboutToAppear(): void {
+    this.presenter.setOnStateChange((): void => this.syncFromPresenter());
+    this.presenter.reset();
+    const params: Object = router.getParams();
+    if (params !== null && typeof params === 'object') {
+      const record = params as Record<string, Object>;
+      const seed: Object = record['homeserverUrl'];
+      if (typeof seed === 'string' && seed.length > 0) {
+        this.presenter.setHomeserverUrl(seed);
+      }
+    }
+  }
+
+  aboutToDisappear(): void {
+    this.presenter.setOnStateChange(null);
+  }
+
+  private syncFromPresenter(): void {
+    this.rawInput = this.presenter.rawInput;
+    this.address = this.presenter.address;
+    this.addressState = this.presenter.addressState;
+    this.validationRequested = this.presenter.validationRequested;
+    this.resolvedRoom = this.presenter.resolvedRoom;
+    this.lastError = this.presenter.lastError;
+    this.pendingContinue = this.presenter.pendingContinue;
+    this.isResolving = this.presenter.isResolving;
+    this.pendingNavigation = this.presenter.pendingNavigation;
+    this.closed = this.presenter.closed;
+
+    if (this.lastError !== null) {
+      this.errorMessage = describeResolverError(this.lastError);
+    } else {
+      this.errorMessage = '';
+    }
+
+    const trimmed: string = this.rawInput.trim();
+    const showValidation: boolean = this.validationRequested
+      && (this.presenter.internalAddressState === AddressState.Invalid
+        || trimmed.length === 0);
+    if (showValidation) {
+      const parsed = parseRoomAlias(trimmed);
+      const failureView: Record<string, Object> = parsed as Object as Record<string, Object>;
+      const reasonValue: Object = failureView['reason'];
+      const reasonStr: string | undefined = typeof reasonValue === 'string' ? reasonValue : undefined;
+      this.validationMessage = describeInvalidSyntax(reasonStr);
+    } else {
+      this.validationMessage = '';
+    }
+
+    if (this.resolvedRoom !== null) {
+      this.foundRoomId = this.resolvedRoom.roomId;
+      this.foundServers = this.resolvedRoom.servers.join(', ');
+    } else {
+      this.foundRoomId = '';
+      this.foundServers = '';
+    }
+
+    if (this.pendingNavigation !== null) {
+      const nav: NavigationParams = this.pendingNavigation;
+      this.presenter.consumePendingNavigation();
+      const previewParams: PreviewParams = {
+        roomId: nav.roomId,
+        address: nav.address,
+        servers: nav.servers
+      };
+      try {
+        router.pushUrl({
+          url: 'pages/RoomPreviewPage',
+          params: previewParams
+        });
+      } catch (_e) {
+        // duplicate navigation or page missing - keep state intact
+      }
+    }
+
+    if (this.closed) {
+      try {
+        router.back();
+      } catch (_e) {
+        // already on root
+      }
+    }
+  }
+
+  build() {
+    Column() {
+      this.header()
+      this.formColumn()
+      this.footer()
+    }
+    .height('100%')
+    .width('100%')
+    .backgroundColor('#F4F6F8')
+  }
+
+  @Builder
+  private header() {
+    Column({ space: 4 }) {
+      Text('Join a room by address')
+        .fontSize(22)
+        .fontWeight(FontWeight.Bold)
+      Text('Enter a Matrix room address like #room:server.name')
+        .fontSize(13)
+        .fontColor('#64748B')
+    }
+    .alignItems(HorizontalAlign.Start)
+    .padding({ left: 20, right: 20, top: 24, bottom: 16 })
+    .width('100%')
+    .backgroundColor('#FFFFFF')
+  }
+
+  @Builder
+  private formColumn() {
+    Column({ space: 14 }) {
+      TextInput({ text: this.rawInput, placeholder: PLACEHOLDER_HINT })
+        .id('address_input')
+        .height(48)
+        .padding(12)
+        .backgroundColor('#FFFFFF')
+        .borderRadius(8)
+        .onChange((value: string) => {
+          this.presenter.updateAddress(value);
+          this.syncFromPresenter();
+        })
+
+      Row({ space: 12 }) {
+        if (this.isResolving || this.addressState === AddressState.Resolving) {
+          LoadingProgress()
+            .id('address_loading')
+            .width(20)
+            .height(20)
+          Text('Looking up the room…')
+            .fontSize(13)
+            .fontColor('#475569')
+        } else if (this.addressState === AddressState.RoomFound && this.resolvedRoom !== null) {
+          Text('Room found')
+            .id('address_found_label')
+            .fontSize(13)
+            .fontColor('#0F766E')
+        } else if (this.addressState === AddressState.NotFound) {
+          Text('No room found')
+            .id('address_notfound_label')
+            .fontSize(13)
+            .fontColor('#B91C1C')
+        } else {
+          Blank()
+        }
+      }
+      .width('100%')
+
+      if (this.errorMessage.length > 0) {
+        Text(this.errorMessage)
+          .id('address_error_message')
+          .fontSize(13)
+          .fontColor('#B91C1C')
+          .width('100%')
+      }
+
+      if (this.validationMessage.length > 0) {
+        Text(this.validationMessage)
+          .id('address_validation_message')
+          .fontSize(13)
+          .fontColor('#B91C1C')
+          .width('100%')
+      }
+
+      if (this.resolvedRoom !== null) {
+        this.foundCard()
+      }
+
+      if (this.addressState === AddressState.NotFound && this.errorMessage.length > 0) {
+        Button('Retry')
+          .id('address_retry_button')
+          .onClick((): void => {
+            this.presenter.retry();
+            this.syncFromPresenter();
+          })
+      }
+    }
+    .padding(20)
+    .width('100%')
+    .layoutWeight(1)
+  }
+
+  @Builder
+  private foundCard() {
+    Column({ space: 6 }) {
+      Text(this.address)
+        .id('address_found_value')
+        .fontSize(15)
+        .fontWeight(FontWeight.Medium)
+      Text(`Room ID: ${this.foundRoomId}`)
+        .fontSize(12)
+        .fontColor('#475569')
+      if (this.foundServers.length > 0) {
+        Text(`Servers: ${this.foundServers}`)
+          .fontSize(12)
+          .fontColor('#475569')
+      }
+    }
+    .alignItems(HorizontalAlign.Start)
+    .padding(14)
+    .width('100%')
+    .borderRadius(10)
+    .backgroundColor('#ECFDF5')
+    .borderWidth(1)
+    .borderColor('#A7F3D0')
+  }
+
+  @Builder
+  private footer() {
+    Column({ space: 12 }) {
+      Button(this.continueButtonLabel())
+        .id('address_continue_button')
+        .width('100%')
+        .height(48)
+        .backgroundColor(this.continueEnabled() ? '#0F766E' : '#94A3B8')
+        .enabled(this.continueEnabled())
+        .onClick((): void => {
+          this.presenter.requestContinue();
+          this.syncFromPresenter();
+        })
+
+      Button('Dismiss')
+        .id('address_dismiss_button')
+        .width('100%')
+        .height(44)
+        .backgroundColor('#FFFFFF')
+        .fontColor('#0F172A')
+        .onClick((): void => {
+          this.presenter.dismiss();
+          this.syncFromPresenter();
+        })
+    }
+    .padding(20)
+    .width('100%')
+    .backgroundColor('#FFFFFF')
+  }
+
+  private continueEnabled(): boolean {
+    if (this.closed) {
+      return false;
+    }
+    if (this.isResolving || this.addressState === AddressState.Resolving) {
+      return true;
+    }
+    if (this.addressState === AddressState.RoomFound) {
+      return this.resolvedRoom !== null;
+    }
+    if (this.addressState === AddressState.Invalid) {
+      return false;
+    }
+    return this.rawInput.trim().length > 0 || this.addressState === AddressState.NotFound;
+  }
+
+  private continueButtonLabel(): string {
+    if (this.addressState === AddressState.RoomFound) {
+      return 'Continue';
+    }
+    if (this.addressState === AddressState.NotFound) {
+      return 'Try again';
+    }
+    return 'Continue';
+  }
+}
diff --git a/entry/src/main/ets/pages/RoomPreviewPage.ets b/entry/src/main/ets/pages/RoomPreviewPage.ets
