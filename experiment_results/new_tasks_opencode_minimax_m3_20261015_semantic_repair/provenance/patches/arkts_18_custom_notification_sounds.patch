index 0000000..b0165ac
--- /dev/null
+++ b/entry/src/main/ets/features/sound/SoundSlotController.ets
@@ -0,0 +1,365 @@
+/**
+ * Per-slot sound controller.
+ *
+ * Each SoundSlotKind owns one of these.  The controller is the only
+ * object that mutates the slot's state: preference, dialog visibility,
+ * picker-in-flight flag, picker token, error, and channel version.
+ *
+ * The picker token is a monotonically increasing number that lets us
+ * detect stale late completions: every long-running operation
+ * (copy-from-uri, persist, channel-update) captures the token that was
+ * current at the start.  When it is about to commit its results it
+ * compares that captured token against the controller's current token;
+ * if they differ it knows a newer pick is in flight and discards its
+ * own results.
+ */
+
+import { LocalSoundStorage, CopyResult } from './LocalSoundStorage';
+import { SoundPreferenceRepository } from './SoundPreferenceRepository';
+import { NotificationChannelService } from './NotificationChannelService';
+import { DocumentSoundPicker } from './DocumentSoundPicker';
+import { SoundPresetCatalog } from './SoundPresetCatalog';
+import {
+  SoundPreference,
+  SoundSlotKind,
+  SoundError,
+  SoundErrorReason,
+  SlotSnapshot,
+  PresetDescriptor,
+  describeDisplayLabel,
+  makeCustomPreference,
+  makePresetPreference,
+  makeSystemDefaultPreference,
+} from './SoundTypes';
+
+import { SoundSettingsDeps } from './SoundSettingsService';
+
+export interface PendingAttempt {
+  readonly kind: 'preset' | 'custom';
+  readonly presetId?: string;
+  readonly sourceUri?: string;
+  readonly displayName?: string;
+  readonly pickerToken?: number;
+}
+
+interface ErrnoShape {
+  readonly code?: number;
+  readonly message?: string;
+}
+
+export class SoundSlotController {
+  private readonly slotKind: SoundSlotKind;
+  private readonly deps: SoundSettingsDeps;
+
+  private preference: SoundPreference;
+  private dialogOpen: boolean = false;
+  private pickerInFlight: boolean = false;
+  private currentPickerToken: number = 0;
+  private error: SoundError | null = null;
+  private lastAttempt: PendingAttempt | null = null;
+
+  constructor(slot: SoundSlotKind, deps: SoundSettingsDeps) {
+    this.slotKind = slot;
+    this.deps = deps;
+    this.preference = deps.repository.defaultPreferenceFor(slot);
+  }
+
+  slot(): SoundSlotKind {
+    return this.slotKind;
+  }
+
+  currentPreference(): SoundPreference {
+    return this.preference;
+  }
+
+  displayLabel(): string {
+    return describeDisplayLabel(this.preference);
+  }
+
+  isDialogOpen(): boolean {
+    return this.dialogOpen;
+  }
+
+  isPickerInFlight(): boolean {
+    return this.pickerInFlight;
+  }
+
+  currentPickerTokenValue(): number {
+    return this.currentPickerToken;
+  }
+
+  currentError(): SoundError | null {
+    return this.error;
+  }
+
+  hasPendingAttempt(): boolean {
+    return this.lastAttempt !== null;
+  }
+
+  snapshot(): SlotSnapshot {
+    return {
+      kind: this.slotKind,
+      preference: this.preference,
+      displayLabel: describeDisplayLabel(this.preference),
+      dialogOpen: this.dialogOpen,
+      pickerInFlight: this.pickerInFlight,
+      error: this.error,
+      channelVersion: this.deps.channels.currentChannelVersion(this.slotKind),
+    };
+  }
+
+  openDialog(): void {
+    this.dialogOpen = true;
+  }
+
+  closeDialog(): void {
+    this.dialogOpen = false;
+  }
+
+  dismissError(): void {
+    this.error = null;
+    this.lastAttempt = null;
+  }
+
+  /**
+   * Bump the picker token and mark the picker as in-flight.  Any
+   * previously in-flight copy / persist that captures the OLD token
+   * will be discarded on completion.
+   */
+  launchPicker(): void {
+    this.currentPickerToken = this.currentPickerToken + 1;
+    this.pickerInFlight = true;
+  }
+
+  /**
+   * Apply a preset selection.  Persists then updates the OS slot.
+   * On any failure the previous preference is left untouched and an
+   * error is exposed on the slot.
+   */
+  async applyPreset(presetId: string): Promise<void> {
+    this.error = null;
+    if (!SoundPresetCatalog.isValidPreset(this.slotKind, presetId)) {
+      this.error = this.makeError('unsupported_preset',
+        `Unknown preset ${presetId} for slot ${this.slotKind}`, true);
+      this.lastAttempt = { kind: 'preset', presetId: presetId };
+      return;
+    }
+    const preset: PresetDescriptor | null = SoundPresetCatalog.find(this.slotKind, presetId);
+    const label: string = preset !== null && preset.label.length > 0 ? preset.label : presetId;
+    const previous: SoundPreference = this.preference;
+    const now: number = Date.now();
+    const nextVersion: number = previous.version + 1;
+    const next: SoundPreference = presetId === 'system_default'
+      ? makeSystemDefaultPreference(nextVersion, now)
+      : makePresetPreference(presetId, label, nextVersion, now);
+    this.lastAttempt = { kind: 'preset', presetId: presetId };
+    try {
+      await this.deps.repository.write(this.slotKind, next);
+    } catch (e) {
+      this.preference = previous;
+      this.error = this.makeError('persist_failed',
+        `Failed to persist preset ${presetId}: ${SlotControllerLogger.describe(e)}`, true);
+      return;
+    }
+    try {
+      await this.deps.channels.apply(this.slotKind, next);
+    } catch (e) {
+      this.preference = previous;
+      await this.bestEffortRevert(this.slotKind, previous);
+      this.error = this.makeError('channel_update_failed',
+        `Failed to update channel for preset ${presetId}: ${SlotControllerLogger.describe(e)}`, true);
+      return;
+    }
+    this.preference = next;
+    this.lastAttempt = null;
+  }
+
+  /**
+   * Apply a custom pick.  The picker URI is copied into app-owned
+   * storage first; only the stable local path is persisted and the
+   * channel is updated.
+   *
+   * The picker token captured at the start is used to detect a stale
+   * late completion: if the user has since launched another pick or
+   * applied a preset the previous pick's result is discarded.
+   */
+  async applyCustomPick(sourceUri: string, displayName: string): Promise<void> {
+    this.error = null;
+    const capturedToken: number = this.currentPickerToken;
+    this.lastAttempt = {
+      kind: 'custom',
+      sourceUri: sourceUri,
+      displayName: displayName,
+      pickerToken: capturedToken,
+    };
+    const previous: SoundPreference = this.preference;
+    let copiedFilePath: string = '';
+    let copiedName: string = displayName;
+    try {
+      const result: CopyResult = await this.deps.storage.copyFromUri(sourceUri, displayName);
+      copiedFilePath = result.filePath;
+      copiedName = result.displayName.length > 0 ? result.displayName : displayName;
+    } catch (e) {
+      // The picker returned a URI we could not honour.  The previous
+      // preference must not change.
+      this.preference = previous;
+      this.error = this.makeError('copy_failed',
+        `Failed to copy picked file: ${SlotControllerLogger.describe(e)}`, true);
+      return;
+    }
+
+    // Slot token must still match what the user intended.  A newer
+    // pick or a preset selection happened in the meantime - we
+    // discard the copied file (best effort) and leave the previous
+    // preference in place.
+    if (capturedToken !== this.currentPickerToken) {
+      await this.deps.storage.delete(copiedFilePath).catch(() => undefined);
+      return;
+    }
+
+    const now: number = Date.now();
+    const next: SoundPreference = makeCustomPreference(
+      copiedFilePath, copiedName, previous.version + 1, now,
+    );
+    try {
+      await this.deps.repository.write(this.slotKind, next);
+    } catch (e) {
+      await this.deps.storage.delete(copiedFilePath).catch(() => undefined);
+      this.preference = previous;
+      this.error = this.makeError('persist_failed',
+        `Failed to persist custom sound: ${SlotControllerLogger.describe(e)}`, true);
+      return;
+    }
+    try {
+      await this.deps.channels.apply(this.slotKind, next);
+    } catch (e) {
+      await this.deps.storage.delete(copiedFilePath).catch(() => undefined);
+      await this.bestEffortRevert(this.slotKind, previous);
+      this.preference = previous;
+      this.error = this.makeError('channel_update_failed',
+        `Failed to update channel for custom sound: ${SlotControllerLogger.describe(e)}`, true);
+      return;
+    }
+    this.preference = next;
+    this.pickerInFlight = false;
+    this.lastAttempt = null;
+  }
+
+  /**
+   * Reset the slot to the system default.  Treated like an explicit
+   * user choice: persisted and pushed to the channel.
+   */
+  async resetToSystemDefault(): Promise<void> {
+    this.error = null;
+    const previous: SoundPreference = this.preference;
+    const now: number = Date.now();
+    const next: SoundPreference = makeSystemDefaultPreference(previous.version + 1, now);
+    this.lastAttempt = null;
+    try {
+      await this.deps.repository.write(this.slotKind, next);
+    } catch (e) {
+      this.preference = previous;
+      this.error = this.makeError('persist_failed',
+        `Failed to persist system default: ${SlotControllerLogger.describe(e)}`, true);
+      return;
+    }
+    try {
+      await this.deps.channels.apply(this.slotKind, next);
+    } catch (e) {
+      this.preference = previous;
+      await this.bestEffortRevert(this.slotKind, previous);
+      this.error = this.makeError('channel_update_failed',
+        `Failed to update channel for system default: ${SlotControllerLogger.describe(e)}`, true);
+      return;
+    }
+    this.preference = next;
+  }
+
+  /**
+   * Retry the last failed attempt.  Used after the user dismisses or
+   * explicitly retries an exposed error.
+   */
+  async retryLastAttempt(): Promise<boolean> {
+    const attempt: PendingAttempt | null = this.lastAttempt;
+    if (attempt === null) {
+      return false;
+    }
+    if (attempt.kind === 'preset' && attempt.presetId !== undefined) {
+      await this.applyPreset(attempt.presetId);
+      return true;
+    }
+    if (attempt.kind === 'custom' &&
+      attempt.sourceUri !== undefined &&
+      attempt.displayName !== undefined) {
+      await this.applyCustomPick(attempt.sourceUri, attempt.displayName);
+      return true;
+    }
+    return false;
+  }
+
+  /**
+   * Install a preference without going through the regular apply
+   * path.  Used by the legacy migrator and at hydration time.
+   */
+  installPreference(preference: SoundPreference): void {
+    this.preference = preference;
+    this.error = null;
+    this.lastAttempt = null;
+  }
+
+  /**
+   * Hydrate the slot from the persisted repository.  Reads the
+   * persisted value (if any) and updates the in-memory preference
+   * without touching the OS channel - the OS channel is synced via
+   * the migrator's `apply` call when needed, and stays in sync from
+   * then on.
+   */
+  async hydrateFromRepository(): Promise<void> {
+    const persisted: SoundPreference | undefined =
+      await this.deps.repository.read(this.slotKind);
+    if (persisted !== undefined) {
+      this.preference = persisted;
+    }
+  }
+
+  private makeError(reason: SoundErrorReason, message: string, retryable: boolean): SoundError {
+    return {
+      reason: reason,
+      message: message,
+      retryable: retryable,
+      slot: this.slotKind,
+    };
+  }
+
+  private async bestEffortRevert(slot: SoundSlotKind, previous: SoundPreference): Promise<void> {
+    try {
+      await this.deps.channels.apply(slot, previous);
+    } catch (e) {
+      this.error = this.makeError('channel_update_failed',
+        `Failed to revert channel for ${slot}: ${SlotControllerLogger.describe(e)}`, true);
+    }
+  }
+}
+
+class SlotControllerLogger {
+  static describe(e: Error | object | undefined): string {
+    if (e === undefined) {
+      return 'unknown error';
+    }
+    if (typeof e === 'object' && e !== null) {
+      const maybeErr: ErrnoShape = e as ErrnoShape;
+      if (typeof maybeErr.message === 'string' && maybeErr.message.length > 0) {
+        return maybeErr.message;
+      }
+      if (typeof maybeErr.code === 'number') {
+        return `code ${maybeErr.code}`;
+      }
+      try {
+        return JSON.stringify(e);
+      } catch (jsonError) {
+        return 'unknown error';
+      }
+    }
+    return String(e);
+  }
+}
diff --git a/entry/src/main/ets/features/sound/SoundTypes.ets b/entry/src/main/ets/features/sound/SoundTypes.ets
new file mode 100644
index 0000000..5957049
--- /dev/null
+++ b/entry/src/main/ets/features/sound/SoundTypes.ets
@@ -0,0 +1,132 @@
+/**
+ * Domain types for the custom notification sound feature.
+ *
+ * Each notification slot (message / call) is governed by an independent
+ * SoundPreference together with a monotonic version number.  When a
+ * long-running update (URI copy, persistence, channel update) is in flight
+ * the launcher captures the version that was current at start-up so that a
+ * late completion cannot overwrite a newer valid choice.
+ */
+
+export type SoundSource = 'system_default' | 'preset' | 'custom';
+
+export type SoundSlotKind = 'message' | 'call';
+
+export interface PresetDescriptor {
+  readonly id: string;
+  readonly label: string;
+  readonly assetPath: string;
+  readonly supportsSlot: SoundSlotKind;
+}
+
+/**
+ * The persisted and effective value for one slot.  Every successful update
+ * bumps `version` and `updatedAt`.  Callers MUST compare the `version` field
+ * before applying any side-effects derived from the value to detect stale
+ * late completions.
+ */
+export interface SoundPreference {
+  readonly source: SoundSource;
+  readonly presetId?: string;
+  readonly customFilePath?: string;
+  readonly displayName: string;
+  readonly version: number;
+  readonly updatedAt: number;
+}
+
+export const SYSTEM_DEFAULT_PRESET_ID: string = 'system_default';
+export const SYSTEM_DEFAULT_DISPLAY: string = 'System default';
+
+export function isSystemDefault(preference: SoundPreference): boolean {
+  return preference.source === 'system_default';
+}
+
+export function isCustomPreference(preference: SoundPreference): boolean {
+  return preference.source === 'custom' && preference.customFilePath !== undefined
+    && preference.customFilePath.length > 0;
+}
+
+export function isPresetPreference(preference: SoundPreference): boolean {
+  return preference.source === 'preset' && preference.presetId !== undefined;
+}
+
+export function describeDisplayLabel(preference: SoundPreference): string {
+  if (preference.source === 'system_default') {
+    return SYSTEM_DEFAULT_DISPLAY;
+  }
+  if (preference.displayName.length === 0) {
+    return 'Unknown';
+  }
+  return preference.displayName;
+}
+
+export interface SoundError {
+  readonly reason: SoundErrorReason;
+  readonly message: string;
+  readonly retryable: boolean;
+  readonly slot: SoundSlotKind;
+}
+
+export type SoundErrorReason =
+  | 'picker_cancelled'
+  | 'picker_failed'
+  | 'copy_failed'
+  | 'persist_failed'
+  | 'channel_update_failed'
+  | 'unsupported_preset';
+
+export interface PendingCustomSelection {
+  readonly pickerToken: number;
+  readonly sourceUri: string;
+  readonly displayName: string;
+  readonly startedAt: number;
+}
+
+export interface SlotSnapshot {
+  readonly kind: SoundSlotKind;
+  readonly preference: SoundPreference;
+  readonly displayLabel: string;
+  readonly dialogOpen: boolean;
+  readonly pickerInFlight: boolean;
+  readonly error: SoundError | null;
+  readonly channelVersion: number;
+}
+
+export function makeSystemDefaultPreference(version: number, updatedAt: number): SoundPreference {
+  return {
+    source: 'system_default',
+    displayName: SYSTEM_DEFAULT_DISPLAY,
+    version,
+    updatedAt,
+  };
+}
+
+export function makePresetPreference(
+  presetId: string,
+  label: string,
+  version: number,
+  updatedAt: number,
+): SoundPreference {
+  return {
+    source: 'preset',
+    presetId,
+    displayName: label,
+    version,
+    updatedAt,
+  };
+}
+
+export function makeCustomPreference(
+  filePath: string,
+  displayName: string,
+  version: number,
+  updatedAt: number,
+): SoundPreference {
+  return {
+    source: 'custom',
+    customFilePath: filePath,
+    displayName,
+    version,
+    updatedAt,
+  };
+}
