--- /dev/null
+++ b/entry/src/main/ets/features/sound/SoundSettingsService.ets
@@ -0,0 +1,183 @@
+/**
+ * High level sound settings service.
+ *
+ * This is the only class that the UI layer talks to for the custom
+ * notification sound feature.  It owns one SoundSlotController per
+ * `SoundSlotKind` so that:
+ *
+ *  - the message sound and the call ringtone have completely
+ *    independent state (dialogs, picker tokens, errors, etc.);
+ *  - concurrent updates to the same slot are serialised through a
+ *    monotonic token, so a late completion of an earlier pick can
+ *    never restore an older value;
+ *  - copy / persist / channel-update failures preserve the previous
+ *    effective sound and surface a dismissable retryable error;
+ *  - the user's choice is persisted before it becomes effective, and
+ *    the channel is updated afterwards, so a crash between the two
+ *    steps cannot lead to a silent inconsistency.
+ *
+ * The service is also responsible for invoking the legacy migrator on
+ * startup.  Migrated values are treated like any other explicit user
+ * choice and can subsequently be overwritten by a fresh preset pick or
+ * document pick.
+ */
+
+import { LocalSoundStorage } from './LocalSoundStorage';
+import { SoundPreferenceRepository } from './SoundPreferenceRepository';
+import { NotificationChannelService } from './NotificationChannelService';
+import { DocumentSoundPicker } from './DocumentSoundPicker';
+import { LegacyRingtoneMigrator, LegacyMigrationOutcome } from './LegacyRingtoneMigrator';
+import { SoundSlotController } from './SoundSlotController';
+import { SoundSlotKind, SoundPreference } from './SoundTypes';
+
+export interface SoundSettingsDeps {
+  readonly repository: SoundPreferenceRepository;
+  readonly storage: LocalSoundStorage;
+  readonly channels: NotificationChannelService;
+  readonly picker: DocumentSoundPicker;
+}
+
+export class SoundSettingsService {
+  private readonly deps: SoundSettingsDeps;
+  private readonly slots: Map<SoundSlotKind, SoundSlotController>;
+  private migrated: boolean = false;
+
+  constructor(deps: SoundSettingsDeps) {
+    this.deps = deps;
+    this.slots = new Map<SoundSlotKind, SoundSlotController>([
+      ['message', new SoundSlotController('message', deps)],
+      ['call', new SoundSlotController('call', deps)],
+    ]);
+  }
+
+  slot(kind: SoundSlotKind): SoundSlotController {
+    const controller: SoundSlotController | undefined = this.slots.get(kind);
+    if (controller === undefined) {
+      throw new Error(`unknown slot ${kind}`);
+    }
+    return controller;
+  }
+
+  /**
+   * Read the currently effective preference for the slot.  Used both
+   * at startup and by the UI to derive the label it shows.
+   */
+  currentPreference(kind: SoundSlotKind): SoundPreference {
+    return this.slot(kind).currentPreference();
+  }
+
+  /**
+   * Apply a preset selection.  The choice is persisted, then pushed
+   * to the OS notification slot.  Failures preserve the previous
+   * preference and surface a retryable error on the slot.
+   */
+  async applyPreset(kind: SoundSlotKind, presetId: string): Promise<void> {
+    await this.migrate();
+    await this.slot(kind).applyPreset(presetId);
+  }
+
+  /**
+   * Apply a custom pick.  The picker uri is copied into app-owned
+   * storage first; only the stable path is persisted and the OS slot
+   * is updated.  Failures preserve the previous preference and
+   * surface a retryable error on the slot.
+   */
+  async applyCustomPick(
+    kind: SoundSlotKind,
+    sourceUri: string,
+    displayName: string,
+  ): Promise<void> {
+    await this.migrate();
+    await this.slot(kind).applyCustomPick(sourceUri, displayName);
+  }
+
+  /**
+   * Launch the document picker for the slot.  The slot's picker
+   * token is bumped so any previous in-flight pick that completes
+   * after this launch is discarded.
+   */
+  launchPicker(kind: SoundSlotKind): void {
+    this.slot(kind).launchPicker();
+  }
+
+  /**
+   * Reset the slot back to the system default.  This is an explicit
+   * user choice (system default itself counts as a choice for
+   * migration purposes) and is persisted like any other value.
+   */
+  async resetToSystemDefault(kind: SoundSlotKind): Promise<void> {
+    await this.migrate();
+    await this.slot(kind).resetToSystemDefault();
+  }
+
+  /**
+   * Open / close the picker dialog.  These are UI side signals only -
+   * they do not start any async work.
+   */
+  openDialog(kind: SoundSlotKind): void {
+    this.slot(kind).openDialog();
+  }
+
+  closeDialog(kind: SoundSlotKind): void {
+    this.slot(kind).closeDialog();
+  }
+
+  dismissError(kind: SoundSlotKind): void {
+    this.slot(kind).dismissError();
+  }
+
+  /**
+   * Retry the last failed attempt for the slot.  Returns true if a
+   * retry was actually scheduled; false when there is nothing to retry
+   * (the slot is in a healthy state).
+   */
+  async retry(kind: SoundSlotKind): Promise<boolean> {
+    await this.migrate();
+    return this.slot(kind).retryLastAttempt();
+  }
+
+  /**
+   * One-shot initialisation: load persisted preferences for both
+   * slots and migrate the legacy call ringtone when needed.
+   * Subsequent calls are no-ops.
+   */
+  async initialize(): Promise<void> {
+    await this.deps.channels.ensureSlotRegistered('message');
+    await this.deps.channels.ensureSlotRegistered('call');
+    await this.migrate();
+  }
+
+  /**
+   * Inject a preference directly.  Used by the legacy migrator so it
+   * can install a value without going through the regular apply path
+   * (which would otherwise reject a missing pickable source).
+   */
+  installPreference(kind: SoundSlotKind, preference: SoundPreference): void {
+    this.slot(kind).installPreference(preference);
+  }
+
+  private async migrate(): Promise<void> {
+    if (this.migrated) {
+      return;
+    }
+    const callController: SoundSlotController | undefined = this.slots.get('call');
+    if (callController === undefined) {
+      this.migrated = true;
+      return;
+    }
+    await callController.hydrateFromRepository();
+    const migrator: LegacyRingtoneMigrator = new LegacyRingtoneMigrator(
+      this.deps.channels,
+      this.deps.repository,
+    );
+    const outcome: LegacyMigrationOutcome = await migrator.migrateCallSlotIfNeeded();
+    if (outcome.migrated) {
+      callController.installPreference(outcome.preference);
+    }
+    const messageController: SoundSlotController | undefined = this.slots.get('message');
+    if (messageController !== undefined) {
+      await messageController.hydrateFromRepository();
+    }
+    this.migrated = true;
+  }
+}
diff --git a/entry/src/main/ets/features/sound/SoundSlotController.ets b/entry/src/main/ets/features/sound/SoundSlotController.ets
