diff --git a/entry/src/main/ets/features/ApplicationContext.ets b/entry/src/main/ets/features/ApplicationContext.ets
new file mode 100644
index 0000000..f041777
--- /dev/null
+++ b/entry/src/main/ets/features/ApplicationContext.ets
@@ -0,0 +1,81 @@
+/**
+ * Process wide service container.
+ *
+ * Some services are inherently singletons because they own state
+ * (notification slots, persistent preferences, app owned files).  We
+ * initialise them lazily on first access from a UI context that has
+ * access to the `Context` for file and preferences operations.  The
+ * container is exposed through a tiny accessor so callers do not have
+ * to thread the service object through every constructor.
+ */
+
+import UIAbility from '@ohos.app.ability.UIAbility';
+import { LocalSoundStorage } from './sound/LocalSoundStorage';
+import { SoundPreferenceRepository } from './sound/SoundPreferenceRepository';
+import { NotificationChannelService } from './sound/NotificationChannelService';
+import { SystemDocumentSoundPicker } from './sound/DocumentSoundPicker';
+import { SoundSettingsService } from './sound/SoundSettingsService';
+
+const SOUND_FILES_SUBDIR: string = 'notification_sounds';
+const AUDIO_EXTENSIONS: string[] = ['ogg', 'mp3', 'wav', 'm4a', 'aac', 'flac'];
+const PREFS_NAME: string = 'elementx_notification_sounds';
+
+let cachedService: SoundSettingsService | null = null;
+let cachedContext: Context | null = null;
+let cachedStorageDir: string = '';
+
+function resolveStorageDir(): string {
+  if (cachedStorageDir.length > 0) {
+    return cachedStorageDir;
+  }
+  const ctx: Context | null = cachedContext;
+  if (ctx === null) {
+    throw new Error('ApplicationContext not initialised: missing context');
+  }
+  const base: string = ctx.filesDir;
+  cachedStorageDir = `${base}/${SOUND_FILES_SUBDIR}`;
+  return cachedStorageDir;
+}
+
+export function initialiseApplicationContext(context: Context): void {
+  if (cachedContext === null) {
+    cachedContext = context;
+  }
+  if (cachedService === null) {
+    const storage: LocalSoundStorage = new LocalSoundStorage(resolveStorageDir());
+    const repository: SoundPreferenceRepository = new SoundPreferenceRepository({
+      name: PREFS_NAME,
+    });
+    const channels: NotificationChannelService = new NotificationChannelService();
+    const picker: SystemDocumentSoundPicker = new SystemDocumentSoundPicker(AUDIO_EXTENSIONS);
+    cachedService = new SoundSettingsService({
+      storage,
+      repository,
+      channels,
+      picker,
+    });
+  }
+}
+
+export function getSoundSettingsService(): SoundSettingsService {
+  if (cachedService === null) {
+    throw new Error('ApplicationContext not initialised: call initialiseApplicationContext first');
+  }
+  return cachedService;
+}
+
+export function hasSoundSettingsService(): boolean {
+  return cachedService !== null;
+}
+
+export function resetApplicationContext(): void {
+  cachedService = null;
+  cachedContext = null;
+  cachedStorageDir = '';
+}
+
+// Reference the imported UIAbility type so the bundle keeps the
+// import live even when no other code in this module uses it
+// directly.  The actual `Context` is supplied to
+// `initialiseApplicationContext` by the UIAbility code path.
+const _abilityProbe: UIAbility | null = null;
