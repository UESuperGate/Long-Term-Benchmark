diff --git a/entry/src/main/ets/features/sound/DocumentSoundPicker.ets b/entry/src/main/ets/features/sound/DocumentSoundPicker.ets
new file mode 100644
index 0000000..79175c4
--- /dev/null
+++ b/entry/src/main/ets/features/sound/DocumentSoundPicker.ets
@@ -0,0 +1,86 @@
+/**
+ * System document picker integration.
+ *
+ * `DocumentViewPicker` is the standard OpenHarmony API for asking the
+ * user to pick a file from the system file manager.  We wrap it in an
+ * interface so the rest of the codebase never sees the picker type
+ * directly - this also makes it possible to fake the picker in unit
+ * tests by providing a different implementation.
+ *
+ * The wrapper exposes two operations:
+ *   - `launch`: presents the picker, returns the URI + display name of
+ *     the chosen audio document (or `null` if the user cancelled).
+ *   - `isSupported`: tells callers whether they are even allowed to
+ *     open the picker at this moment (e.g. the OS file service is up).
+ *
+ * The returned URI is a transient provider URI; the caller MUST copy it
+ * into app-owned storage via `LocalSoundStorage.copyFromUri` before
+ * making it the effective sound.
+ */
+
+import picker from '@ohos.file.picker';
+
+export interface PickedDocument {
+  readonly uri: string;
+  readonly displayName: string;
+}
+
+export interface DocumentSoundPicker {
+  launch(): Promise<PickedDocument | null>;
+  isSupported(): boolean;
+}
+
+export class SystemDocumentSoundPicker implements DocumentSoundPicker {
+  private readonly audioExtensions: string[];
+
+  constructor(audioExtensions: string[]) {
+    this.audioExtensions = audioExtensions;
+  }
+
+  isSupported(): boolean {
+    return true;
+  }
+
+  async launch(): Promise<PickedDocument | null> {
+    const pickerOptions: picker.DocumentSelectOptions = {
+      maxSelectNumber: 1,
+      fileSuffixFilters: this.audioExtensions.slice(),
+    };
+    const docPicker: picker.DocumentViewPicker = new picker.DocumentViewPicker();
+    let uris: string[] = [];
+    try {
+      uris = await docPicker.select(pickerOptions);
+    } catch (e) {
+      return null;
+    }
+    if (uris.length === 0) {
+      return null;
+    }
+    const uri: string = uris[0];
+    const displayName: string = SystemDocumentSoundPicker.deriveDisplayName(uri);
+    return {
+      uri: uri,
+      displayName: displayName,
+    };
+  }
+
+  private static deriveDisplayName(uri: string): string {
+    const lastSlash: number = uri.lastIndexOf('/');
+    const tail: string = lastSlash >= 0 && lastSlash < uri.length - 1 ? uri.substring(lastSlash + 1) : uri;
+    let decoded: string = tail;
+    try {
+      decoded = decodeURIComponent(tail);
+    } catch (e) {
+      // Some provider URIs use percent-escapes that fail strict decoding;
+      // fall back to the raw tail in that case.
+    }
+    const dot: number = decoded.lastIndexOf('.');
+    if (dot > 0 && dot < decoded.length - 1) {
+      decoded = decoded.substring(0, dot);
+    }
+    if (decoded.length === 0) {
+      return 'Custom sound';
+    }
+    return decoded;
+  }
+}
diff --git a/entry/src/main/ets/features/sound/LegacyRingtoneMigrator.ets b/entry/src/main/ets/features/sound/LegacyRingtoneMigrator.ets
new file mode 100644
index 0000000..5c18b70
--- /dev/null
+++ b/entry/src/main/ets/features/sound/LegacyRingtoneMigrator.ets
@@ -0,0 +1,118 @@
+/**
+ * Legacy ringtone migration.
+ *
+ * In the previous version of the app the call channel was configured
+ * at the OS level but the user's choice was not persisted in our
+ * preferences store.  The new persistent schema owns the user's
+ * choice but must not clobber a preference the user has already made
+ * explicitly.  This migrator performs the one-time transfer from the
+ * OS slot into our preferences store when (and only when) the user
+ * has not already recorded an explicit preference.
+ *
+ * The "explicit" marker is the `persistedCallRingtone == 'custom_explicit'`
+ * sentinel value used in earlier migrations of similar code paths;
+ * when we encounter it we leave the call preference alone.  When the
+ * slot has no preference recorded yet (`persistedCallRingtone`
+ * undefined) and the OS slot carries a non-empty sound value, we
+ * adopt that value as the user's choice.
+ */
+
+import { NotificationChannelService } from './NotificationChannelService';
+import {
+  SoundPreference,
+  makeCustomPreference,
+  makeSystemDefaultPreference,
+} from './SoundTypes';
+import { SoundPreferenceRepository } from './SoundPreferenceRepository';
+
+const LEGACY_EXPLICIT_SENTINEL: string = 'custom_explicit';
+const LEGACY_MIGRATION_VERSION: number = 1;
+
+export interface LegacyMigrationOutcome {
+  readonly migrated: boolean;
+  readonly preference: SoundPreference;
+  readonly reason: 'already_explicit' | 'os_has_sound' | 'no_os_sound' | 'os_default';
+}
+
+export class LegacyRingtoneMigrator {
+  private readonly channels: NotificationChannelService;
+  private readonly repository: SoundPreferenceRepository;
+
+  constructor(channels: NotificationChannelService, repository: SoundPreferenceRepository) {
+    this.channels = channels;
+    this.repository = repository;
+  }
+
+  /**
+   * Decide whether the call slot needs migration and, if so, apply it.
+   * The function is idempotent: calling it more than once is a no-op
+   * once the user's explicit preference has been recorded.
+   */
+  async migrateCallSlotIfNeeded(): Promise<LegacyMigrationOutcome> {
+    const persisted: SoundPreference | undefined = await this.repository.read('call');
+    if (persisted !== undefined) {
+      // The user has a persisted preference of some kind.  We honour
+      // it and never migrate over an explicit choice.
+      return {
+        migrated: false,
+        preference: persisted,
+        reason: 'already_explicit',
+      };
+    }
+
+    const osSound: string = await this.channels.currentSlotSound('call');
+    if (osSound.length === 0) {
+      const baseline: SoundPreference = this.repository.defaultPreferenceFor('call');
+      return {
+        migrated: false,
+        preference: baseline,
+        reason: 'no_os_sound',
+      };
+    }
+
+    const now: number = Date.now();
+    const preference: SoundPreference = this.buildPreference(osSound, now);
+    await this.repository.write('call', preference);
+    await this.channels.apply('call', preference);
+    return {
+      migrated: true,
+      preference: preference,
+      reason: 'os_has_sound',
+    };
+  }
+
+  private buildPreference(osSound: string, updatedAt: number): SoundPreference {
+    if (osSound.startsWith('file://')) {
+      const filePath: string = osSound.substring('file://'.length);
+      const displayName: string = NotificationChannelService.labelForOsSound(osSound, 'call');
+      return makeCustomPreference(filePath, displayName, LEGACY_MIGRATION_VERSION, updatedAt);
+    }
+    if (osSound.startsWith('rawfile://')) {
+      const id: string = LegacyRingtoneMigrator.derivePresetId(osSound);
+      const displayName: string = NotificationChannelService.labelForOsSound(osSound, 'call');
+      return {
+        source: 'preset',
+        presetId: id,
+        displayName: displayName,
+        version: LEGACY_MIGRATION_VERSION,
+        updatedAt: updatedAt,
+      };
+    }
+    // Anything we do not recognise we treat as the system default to
+    // avoid silently switching the user off their sound.
+    return makeSystemDefaultPreference(LEGACY_MIGRATION_VERSION, updatedAt);
+  }
+
+  private static derivePresetId(osSound: string): string {
+    const lastSlash: number = osSound.lastIndexOf('/');
+    const tail: string = lastSlash >= 0 && lastSlash < osSound.length - 1
+      ? osSound.substring(lastSlash + 1)
+      : osSound;
+    const dot: number = tail.lastIndexOf('.');
+    const stem: string = dot > 0 ? tail.substring(0, dot) : tail;
+    if (stem.startsWith('call_')) {
+      return stem.substring('call_'.length);
+    }
+    return stem;
+  }
+}
diff --git a/entry/src/main/ets/features/sound/LocalSoundStorage.ets b/entry/src/main/ets/features/sound/LocalSoundStorage.ets
new file mode 100644
index 0000000..593bb65
--- /dev/null
+++ b/entry/src/main/ets/features/sound/LocalSoundStorage.ets
@@ -0,0 +1,183 @@
+/**
+ * Application-owned sound storage.
+ *
+ * Whenever a user picks an audio document from a system picker the file
+ * lives behind a transient provider URI that we MUST NOT persist as the
+ * effective sound.  This service copies the picked document into the
+ * application's own files directory and returns the absolute path of the
+ * new file.  After that point the channel can be updated to use a stable
+ * URI derived from the local path and the file will remain available
+ * across restarts.
+ *
+ * The implementation is intentionally synchronous-looking from the
+ * outside (a single async `copyFromUri`) so that callers can serialise
+ * concurrent per-slot updates with a small wrapper without having to
+ * reason about intermediate state inside the storage layer.
+ */
+
+import fileIo from '@ohos.file.fs';
+import fileUri from '@ohos.file.fileuri';
+
+const RAW_FILE_PREFIX: string = 'rawfile://';
+const FILE_URI_PREFIX: string = 'file://';
+const FILE_NOT_FOUND_ERROR_CODE: number = 2;
+const POSIX_ENOENT_ERROR_CODE: number = 13900002;
+
+interface ErrnoShape {
+  readonly code?: number;
+}
+
+export interface CopyResult {
+  readonly filePath: string;
+  readonly displayName: string;
+}
+
+export class LocalSoundStorage {
+  private readonly baseDir: string;
+
+  constructor(baseDir: string) {
+    this.baseDir = baseDir;
+  }
+
+  /**
+   * Copy the bytes behind `sourceUri` into the application-owned directory
+   * and return the path of the new file.  The destination path is stable
+   * for the lifetime of the application data directory, which means the
+   * caller can persist it and resolve it again after a restart.
+   */
+  async copyFromUri(sourceUri: string, suggestedName: string): Promise<CopyResult> {
+    if (sourceUri.length === 0) {
+      throw new Error('empty source uri');
+    }
+    const extension: string = LocalSoundStorage.extractExtension(suggestedName, sourceUri);
+    const displayName: string = LocalSoundStorage.sanitizeName(suggestedName);
+    const fileName: string = LocalSoundStorage.uniqueName(displayName, extension);
+    const targetPath: string = `${this.baseDir}/${fileName}`;
+
+    let realPath: string = sourceUri;
+    if (sourceUri.startsWith(FILE_URI_PREFIX)) {
+      realPath = fileUri.getUriFromPath(sourceUri);
+    }
+    const sourceFile: fileIo.File = await fileIo.open(realPath, fileIo.OpenMode.READ_ONLY);
+    let openedTarget: boolean = false;
+    try {
+      const targetFile: fileIo.File = await fileIo.open(targetPath,
+        fileIo.OpenMode.CREATE | fileIo.OpenMode.WRITE_ONLY | fileIo.OpenMode.TRUNC);
+      openedTarget = true;
+      try {
+        await fileIo.copyFile(sourceFile.fd, targetFile.fd);
+      } finally {
+        await fileIo.close(targetFile);
+      }
+    } finally {
+      await fileIo.close(sourceFile);
+      if (!openedTarget) {
+        await LocalSoundStorage.safeUnlink(targetPath);
+      }
+    }
+    return {
+      filePath: targetPath,
+      displayName: displayName,
+    };
+  }
+
+  /**
+   * Delete a file previously copied into the owned directory.  This is a
+   * best-effort operation: if the file no longer exists we treat it as a
+   * success so callers do not have to reason about orphan cleanup races.
+   */
+  async delete(filePath: string): Promise<void> {
+    if (filePath.length === 0) {
+      return;
+    }
+    await LocalSoundStorage.safeUnlink(filePath);
+  }
+
+  /**
+   * Convert an owned absolute path back to a stable URI for the
+   * notification channel.  We deliberately use the `file://` form so the
+   * channel keeps working across process restarts as long as the data
+   * directory survives.
+   */
+  static pathToChannelUri(path: string): string {
+    if (path.length === 0) {
+      return '';
+    }
+    if (path.startsWith(RAW_FILE_PREFIX) || path.startsWith(FILE_URI_PREFIX)) {
+      return path;
+    }
+    return `${FILE_URI_PREFIX}${path}`;
+  }
+
+  private static async safeUnlink(targetPath: string): Promise<void> {
+    try {
+      await fileIo.unlink(targetPath);
+    } catch (e) {
+      const shape: ErrnoShape = e as ErrnoShape;
+      const code: number = typeof shape.code === 'number' ? shape.code : 0;
+      if (code === FILE_NOT_FOUND_ERROR_CODE || code === POSIX_ENOENT_ERROR_CODE) {
+        return;
+      }
+      // Swallow other unlink failures so that callers can fire-and-forget
+      // a delete on an orphan file without affecting the main flow.
+    }
+  }
+
+  private static extractExtension(suggestedName: string, sourceUri: string): string {
+    const dotIndex: number = suggestedName.lastIndexOf('.');
+    if (dotIndex > 0 && dotIndex < suggestedName.length - 1) {
+      return suggestedName.substring(dotIndex + 1).toLowerCase();
+    }
+    const slashIndex: number = sourceUri.lastIndexOf('/');
+    if (slashIndex >= 0 && slashIndex < sourceUri.length - 1) {
+      const tail: string = sourceUri.substring(slashIndex + 1);
+      const innerDot: number = tail.lastIndexOf('.');
+      if (innerDot > 0 && innerDot < tail.length - 1) {
+        return tail.substring(innerDot + 1).toLowerCase();
+      }
+    }
+    return 'ogg';
+  }
+
+  private static sanitizeName(name: string): string {
+    let trimmed: string = name.trim();
+    const slashIndex: number = trimmed.lastIndexOf('/');
+    if (slashIndex >= 0 && slashIndex < trimmed.length - 1) {
+      trimmed = trimmed.substring(slashIndex + 1);
+    }
+    const dotIndex: number = trimmed.lastIndexOf('.');
+    if (dotIndex > 0) {
+      trimmed = trimmed.substring(0, dotIndex);
+    }
+    let safe: string = '';
+    for (let i: number = 0; i < trimmed.length; i++) {
+      const ch: string = trimmed.charAt(i);
+      const code: number = ch.charCodeAt(0);
+      if ((code >= 48 && code <= 57) ||
+          (code >= 65 && code <= 90) ||
+          (code >= 97 && code <= 122) ||
+          ch === '_' || ch === '-' || ch === ' ') {
+        safe += ch;
+      } else {
+        safe += '_';
+      }
+    }
+    if (safe.length === 0) {
+      safe = 'sound';
+    }
+    if (safe.length > 64) {
+      safe = safe.substring(0, 64);
+    }
+    return safe;
+  }
+
+  private static uniqueName(base: string, extension: string): string {
+    // Embed a timestamp-derived suffix so that two picks within the same
+    // millisecond cannot collide and silently overwrite each other.  We
+    // do not need cryptographic uniqueness here - the goal is only to
+    // disambiguate concurrent copies.
+    const stamp: number = Date.now();
+    const rand: number = Math.floor(Math.random() * 0xffff);
+    return `${base}_${stamp.toString(36)}_${rand.toString(36)}.${extension}`;
+  }
+}
diff --git a/entry/src/main/ets/features/sound/NotificationChannelService.ets b/entry/src/main/ets/features/sound/NotificationChannelService.ets
new file mode 100644
index 0000000..714ce7c
--- /dev/null
+++ b/entry/src/main/ets/features/sound/NotificationChannelService.ets
@@ -0,0 +1,231 @@
+/**
+ * Notification channel (slot) updates.
+ *
+ * The OpenHarmony notification API categorises alerts through fixed
+ * slot types.  The legacy `addSlot(SlotType)` / `getSlot(SlotType)`
+ * signatures only accept an enum value: they cannot install a custom
+ * sound on a per-channel basis.  This service therefore uses the OS
+ * API to ensure a slot is registered and reports a stable, monotonic
+ * version that the per-slot controller can compare against the
+ * version captured at the start of a long-running operation.
+ *
+ * The mapping from a SoundPreference to the value we record in the
+ * OS-side slot (or expose as a fallback path) is:
+ *   - source = 'system_default'  -> '' (no sound override; the OS picks
+ *                                     its default for the channel)
+ *   - source = 'preset'          -> bundled rawfile URI
+ *   - source = 'custom'          -> file:// URI of the app-owned copy
+ */
+
+import notification from '@ohos.notification';
+import {
+  SoundPreference,
+  SoundSlotKind,
+  SYSTEM_DEFAULT_DISPLAY,
+} from './SoundTypes';
+
+export interface NotificationSlotInfo {
+  readonly slotType: notification.SlotType;
+  readonly id: string;
+  readonly sound: string;
+  readonly enabled: boolean;
+}
+
+const SLOT_TYPE_SERVICE: notification.SlotType = notification.SlotType.SERVICE_INFORMATION;
+const SLOT_TYPE_CALL: notification.SlotType = notification.SlotType.SOCIAL_COMMUNICATION;
+
+const SLOT_TYPE_BY_KIND: Map<SoundSlotKind, notification.SlotType> = new Map([
+  ['message', SLOT_TYPE_SERVICE],
+  ['call', SLOT_TYPE_CALL],
+]);
+
+const SLOT_ID_BY_KIND: Map<SoundSlotKind, string> = new Map([
+  ['message', 'elementx_message'],
+  ['call', 'elementx_call'],
+]);
+
+const MISSING_SLOT_ERROR_CODE: number = 1600001;
+const DUPLICATE_SLOT_ERROR_CODE: number = 1600002;
+
+interface slotRecordLike {
+  readonly id?: string;
+  readonly name?: string;
+  readonly slotType?: notification.SlotType;
+  readonly description?: string;
+  readonly sound?: string;
+  readonly level?: number;
+  readonly vibrateEnabled?: boolean;
+  readonly vibrationEnabled?: boolean;
+  readonly code?: number;
+  readonly message?: string;
+}
+
+function readErrorCode(value: Error | object | undefined): number {
+  if (value === undefined || value === null) {
+    return 0;
+  }
+  const candidate: slotRecordLike = value as slotRecordLike;
+  if (typeof candidate.code === 'number') {
+    return candidate.code;
+  }
+  return 0;
+}
+
+export class NotificationChannelService {
+  private readonly channelVersions: Map<SoundSlotKind, number> = new Map([
+    ['message', 0],
+    ['call', 0],
+  ]);
+  private readonly lastAppliedSound: Map<SoundSlotKind, string> = new Map([
+    ['message', ''],
+    ['call', ''],
+  ]);
+
+  /**
+   * Read the current channel version for the given slot.  This is the
+   * version of the slot configuration (including the sound) as it
+   * stands in the OS, NOT the persisted user preference version.
+   * Callers use it to serialise concurrent in-flight updates per slot.
+   */
+  currentChannelVersion(slot: SoundSlotKind): number {
+    return this.channelVersions.get(slot) ?? 0;
+  }
+
+  /**
+   * Read the OS-side sound value currently associated with the slot.
+   * The OpenHarmony deprecated API does not store a custom sound
+   * per slot - the slot only knows its type and whether it is
+   * enabled.  We return whatever we last applied through
+   * `apply`, which is the value that should be played by the
+   * application when a notification on this channel fires.
+   */
+  currentSlotSound(slot: SoundSlotKind): string {
+    return this.lastAppliedSound.get(slot) ?? '';
+  }
+
+  /**
+   * Ensure that the OS has a slot registered for the given kind.
+   * This is idempotent and safe to call on every startup.  Failures
+   * are surfaced as exceptions; the caller decides whether they are
+   * retryable.
+   */
+  async ensureSlotRegistered(slot: SoundSlotKind): Promise<void> {
+    const slotType: notification.SlotType | undefined = SLOT_TYPE_BY_KIND.get(slot);
+    if (slotType === undefined) {
+      throw new Error(`unknown slot kind ${slot}`);
+    }
+    try {
+      await notification.addSlot(slotType);
+    } catch (e) {
+      const code: number = readErrorCode(e);
+      if (code === MISSING_SLOT_ERROR_CODE) {
+        return;
+      }
+      if (code === DUPLICATE_SLOT_ERROR_CODE) {
+        return;
+      }
+      throw e as Error;
+    }
+  }
+
+  /**
+   * Translate a persisted SoundPreference into a sound value that the
+   * OS notification slot will accept.  System default is represented
+   * as an empty string which tells the OS to fall back to the
+   * platform default for the channel.
+   */
+  resolveSoundForSlot(slot: SoundSlotKind, preference: SoundPreference): string {
+    if (preference.source === 'system_default') {
+      return '';
+    }
+    if (preference.source === 'preset') {
+      return `rawfile:///${this.presetAssetName(slot, preference.presetId ?? '')}`;
+    }
+    if (preference.customFilePath !== undefined && preference.customFilePath.length > 0) {
+      if (preference.customFilePath.startsWith('file://') ||
+        preference.customFilePath.startsWith('rawfile://')) {
+        return preference.customFilePath;
+      }
+      return `file://${preference.customFilePath}`;
+    }
+    return '';
+  }
+
+  /**
+   * Apply the given preference to the slot.  The OpenHarmony API
+   * does not allow per-slot custom sound assignment, so this method
+   * records the resolved sound value for later use by the
+   * application and bumps the per-slot channel version on success.
+   * The returned promise resolves to the channel version that the
+   * slot now carries.
+   */
+  async apply(slot: SoundSlotKind, preference: SoundPreference): Promise<number> {
+    await this.ensureSlotRegistered(slot);
+    const soundValue: string = this.resolveSoundForSlot(slot, preference);
+    await this.fetchSlot(slot);
+    this.lastAppliedSound.set(slot, soundValue);
+    const next: number = (this.channelVersions.get(slot) ?? 0) + 1;
+    this.channelVersions.set(slot, next);
+    return next;
+  }
+
+  /**
+   * Convert an OS-side slot sound value into a display label.  Used
+   * by the legacy migrator to decide whether a value read from the
+   * slot is something the user would recognise.
+   */
+  static labelForOsSound(osSound: string, slot: SoundSlotKind): string {
+    if (osSound.length === 0) {
+      return SYSTEM_DEFAULT_DISPLAY;
+    }
+    if (osSound.startsWith('rawfile:///')) {
+      const name: string = osSound.substring('rawfile:///'.length);
+      if (name.length === 0) {
+        return SYSTEM_DEFAULT_DISPLAY;
+      }
+      return `Bundled ${name}`;
+    }
+    if (osSound.startsWith('file://')) {
+      const path: string = osSound.substring('file://'.length);
+      const slashIndex: number = path.lastIndexOf('/');
+      const base: string = slashIndex >= 0 ? path.substring(slashIndex + 1) : path;
+      const dot: number = base.lastIndexOf('.');
+      const stem: string = dot > 0 ? base.substring(0, dot) : base;
+      return stem.length > 0 ? stem : SYSTEM_DEFAULT_DISPLAY;
+    }
+    return osSound;
+  }
+
+  private async fetchSlot(slot: SoundSlotKind): Promise<NotificationSlotInfo | undefined> {
+    const slotType: notification.SlotType | undefined = SLOT_TYPE_BY_KIND.get(slot);
+    if (slotType === undefined) {
+      return undefined;
+    }
+    try {
+      await notification.getSlot(slotType);
+      const sound: string = this.lastAppliedSound.get(slot) ?? '';
+      return {
+        slotType: slotType,
+        id: SLOT_ID_BY_KIND.get(slot) ?? '',
+        sound: sound,
+        enabled: true,
+      };
+    } catch (e) {
+      const code: number = readErrorCode(e);
+      if (code === MISSING_SLOT_ERROR_CODE) {
+        return undefined;
+      }
+      throw e as Error;
+    }
+  }
+
+  private presetAssetName(slot: SoundSlotKind, presetId: string): string {
+    if (presetId.length === 0) {
+      return '';
+    }
+    if (presetId === 'silent' && slot === 'call') {
+      return '';
+    }
+    return `sounds/${slot}_${presetId}.ogg`;
+  }
+}
diff --git a/entry/src/main/ets/features/sound/SoundPreferenceRepository.ets b/entry/src/main/ets/features/sound/SoundPreferenceRepository.ets
new file mode 100644
index 0000000..c5dfd88
--- /dev/null
+++ b/entry/src/main/ets/features/sound/SoundPreferenceRepository.ets
@@ -0,0 +1,186 @@
+/**
+ * Persistent preferences repository.
+ *
+ * This is the single source of truth for the user's sound choices
+ * between launches.  Each slot (message / call) has its own key
+ * namespace so the two are completely independent: writing the
+ * message preference never touches the call preference and vice
+ * versa.
+ *
+ * The repository is implemented as a thin wrapper around the
+ * OpenHarmony preferences store.  Reads return undefined when
+ * nothing has ever been written - callers must treat that as "use
+ * the system default".  Writes are durable: once `write` resolves
+ * the new value will be observed by any subsequent `read` call,
+ * even after a process restart.
+ */
+
+import preferences from '@ohos.data.preferences';
+import {
+  SoundPreference,
+  SoundSlotKind,
+  makeSystemDefaultPreference,
+} from './SoundTypes';
+
+const PREF_VERSION_BASE: number = 1;
+
+const KEY_SOURCE: string = 'source';
+const KEY_PRESET_ID: string = 'presetId';
+const KEY_CUSTOM_FILE_PATH: string = 'customFilePath';
+const KEY_DISPLAY_NAME: string = 'displayName';
+const KEY_VERSION: string = 'version';
+const KEY_UPDATED_AT: string = 'updatedAt';
+const KEY_HAS_PERSISTED: string = 'hasPersistedPreference';
+
+function slotKey(slot: SoundSlotKind, key: string): string {
+  return `slot.${slot}.${key}`;
+}
+
+function readStringValue(raw: preferences.ValueType): string {
+  if (typeof raw === 'string') {
+    return raw;
+  }
+  if (typeof raw === 'number') {
+    return String(raw);
+  }
+  if (typeof raw === 'boolean') {
+    return raw ? 'true' : 'false';
+  }
+  return '';
+}
+
+function readNumberValue(raw: preferences.ValueType, fallback: number): number {
+  if (typeof raw === 'number') {
+    return raw;
+  }
+  if (typeof raw === 'string') {
+    const parsed: number = Number(raw);
+    if (Number.isFinite(parsed)) {
+      return parsed;
+    }
+  }
+  return fallback;
+}
+
+export class SoundPreferenceRepository {
+  private readonly options: preferences.Options;
+
+  constructor(options: preferences.Options) {
+    this.options = options;
+  }
+
+  /**
+   * Build a stable, in-memory system-default value for the given slot.
+   * The repository itself does not need to persist this baseline but it
+   * is convenient to compute it here so callers have a uniform value to
+   * work with when nothing has been written yet.
+   */
+  defaultPreferenceFor(slot: SoundSlotKind): SoundPreference {
+    return makeSystemDefaultPreference(PREF_VERSION_BASE, 0);
+  }
+
+  /**
+   * Read the persisted preference for the given slot.  Returns
+   * `undefined` when the user has never made an explicit choice;
+   * callers MUST interpret this as "use the system default" and not
+   * as "the system default is unknown".
+   */
+  async read(slot: SoundSlotKind): Promise<SoundPreference | undefined> {
+    const ctx: Context = getContext();
+    const store: preferences.Preferences = await preferences.getPreferences(ctx, this.options);
+    const hasPersistedRaw: preferences.ValueType = await store.get(slotKey(slot, KEY_HAS_PERSISTED), false);
+    const hasPersisted: boolean = typeof hasPersistedRaw === 'boolean' ? hasPersistedRaw : Boolean(hasPersistedRaw);
+    if (!hasPersisted) {
+      return undefined;
+    }
+    const sourceRaw: preferences.ValueType = await store.get(slotKey(slot, KEY_SOURCE), 'system_default');
+    const source: string = readStringValue(sourceRaw);
+    const displayRaw: preferences.ValueType = await store.get(slotKey(slot, KEY_DISPLAY_NAME), '');
+    const displayName: string = readStringValue(displayRaw);
+    const versionRaw: preferences.ValueType = await store.get(slotKey(slot, KEY_VERSION), 0);
+    const version: number = readNumberValue(versionRaw, 0);
+    const updatedAtRaw: preferences.ValueType = await store.get(slotKey(slot, KEY_UPDATED_AT), 0);
+    const updatedAt: number = readNumberValue(updatedAtRaw, 0);
+
+    if (source === 'preset') {
+      const presetRaw: preferences.ValueType = await store.get(slotKey(slot, KEY_PRESET_ID), '');
+      const presetId: string = readStringValue(presetRaw);
+      if (presetId.length === 0) {
+        return undefined;
+      }
+      return {
+        source: 'preset',
+        presetId,
+        displayName: displayName.length > 0 ? displayName : 'Preset',
+        version,
+        updatedAt,
+      };
+    }
+    if (source === 'custom') {
+      const pathRaw: preferences.ValueType = await store.get(slotKey(slot, KEY_CUSTOM_FILE_PATH), '');
+      const customFilePath: string = readStringValue(pathRaw);
+      if (customFilePath.length === 0) {
+        return undefined;
+      }
+      return {
+        source: 'custom',
+        customFilePath,
+        displayName: displayName.length > 0 ? displayName : 'Custom sound',
+        version,
+        updatedAt,
+      };
+    }
+    return {
+      source: 'system_default',
+      displayName: displayName.length > 0 ? displayName : 'System default',
+      version,
+      updatedAt,
+    };
+  }
+
+  /**
+   * Persist the preference for the given slot.  The caller is
+   * responsible for ensuring that `preference` is well-formed (e.g.
+   * `custom` must have a non-empty `customFilePath`); this method
+   * writes the value as-is.
+   */
+  async write(slot: SoundSlotKind, preference: SoundPreference): Promise<void> {
+    const ctx: Context = getContext();
+    const store: preferences.Preferences = await preferences.getPreferences(ctx, this.options);
+    await store.put(slotKey(slot, KEY_HAS_PERSISTED), true);
+    await store.put(slotKey(slot, KEY_SOURCE), preference.source);
+    await store.put(slotKey(slot, KEY_DISPLAY_NAME), preference.displayName);
+    await store.put(slotKey(slot, KEY_VERSION), preference.version);
+    await store.put(slotKey(slot, KEY_UPDATED_AT), preference.updatedAt);
+    if (preference.source === 'preset' && preference.presetId !== undefined) {
+      await store.put(slotKey(slot, KEY_PRESET_ID), preference.presetId);
+      await store.delete(slotKey(slot, KEY_CUSTOM_FILE_PATH));
+    } else if (preference.source === 'custom' && preference.customFilePath !== undefined) {
+      await store.put(slotKey(slot, KEY_CUSTOM_FILE_PATH), preference.customFilePath);
+      await store.delete(slotKey(slot, KEY_PRESET_ID));
+    } else {
+      await store.delete(slotKey(slot, KEY_PRESET_ID));
+      await store.delete(slotKey(slot, KEY_CUSTOM_FILE_PATH));
+    }
+    await store.flush();
+  }
+
+  /**
+   * Forget any persisted preference for the given slot.  After this
+   * call `read` will return `undefined` for `slot`.
+   */
+  async clear(slot: SoundSlotKind): Promise<void> {
+    const ctx: Context = getContext();
+    const store: preferences.Preferences = await preferences.getPreferences(ctx, this.options);
+    await store.delete(slotKey(slot, KEY_HAS_PERSISTED));
+    await store.delete(slotKey(slot, KEY_SOURCE));
+    await store.delete(slotKey(slot, KEY_PRESET_ID));
+    await store.delete(slotKey(slot, KEY_CUSTOM_FILE_PATH));
+    await store.delete(slotKey(slot, KEY_DISPLAY_NAME));
+    await store.delete(slotKey(slot, KEY_VERSION));
+    await store.delete(slotKey(slot, KEY_UPDATED_AT));
+    await store.flush();
+  }
+}
+
+declare function getContext(): Context;
diff --git a/entry/src/main/ets/features/sound/SoundPresetCatalog.ets b/entry/src/main/ets/features/sound/SoundPresetCatalog.ets
new file mode 100644
index 0000000..0e1398c
--- /dev/null
+++ b/entry/src/main/ets/features/sound/SoundPresetCatalog.ets
@@ -0,0 +1,104 @@
+/**
+ * Bundled preset catalog.
+ *
+ * Each preset is a vendor-shipped audio file inside the application package.
+ * The asset path is relative to the application's resources/rawfile directory.
+ * The `system_default` pseudo-preset is handled specially: it carries no
+ * asset path and the corresponding channel must be told to use the device's
+ * built-in default sound instead.
+ */
+
+import { PresetDescriptor, SoundSlotKind } from './SoundTypes';
+
+const MESSAGE_PRESETS: PresetDescriptor[] = [
+  {
+    id: 'system_default',
+    label: 'System default',
+    assetPath: '',
+    supportsSlot: 'message',
+  },
+  {
+    id: 'element_default',
+    label: 'Element',
+    assetPath: 'message_element.ogg',
+    supportsSlot: 'message',
+  },
+  {
+    id: 'chime',
+    label: 'Chime',
+    assetPath: 'message_chime.ogg',
+    supportsSlot: 'message',
+  },
+  {
+    id: 'soft',
+    label: 'Soft',
+    assetPath: 'message_soft.ogg',
+    supportsSlot: 'message',
+  },
+  {
+    id: 'pulse',
+    label: 'Pulse',
+    assetPath: 'message_pulse.ogg',
+    supportsSlot: 'message',
+  },
+];
+
+const CALL_PRESETS: PresetDescriptor[] = [
+  {
+    id: 'system_default',
+    label: 'System default',
+    assetPath: '',
+    supportsSlot: 'call',
+  },
+  {
+    id: 'element_default',
+    label: 'Element',
+    assetPath: 'call_element.ogg',
+    supportsSlot: 'call',
+  },
+  {
+    id: 'silent',
+    label: 'Silent',
+    assetPath: '',
+    supportsSlot: 'call',
+  },
+  {
+    id: 'classic',
+    label: 'Classic',
+    assetPath: 'call_classic.ogg',
+    supportsSlot: 'call',
+  },
+  {
+    id: 'modern',
+    label: 'Modern',
+    assetPath: 'call_modern.ogg',
+    supportsSlot: 'call',
+  },
+  {
+    id: 'gentle',
+    label: 'Gentle',
+    assetPath: 'call_gentle.ogg',
+    supportsSlot: 'call',
+  },
+];
+
+export class SoundPresetCatalog {
+  static listForSlot(slot: SoundSlotKind): PresetDescriptor[] {
+    return slot === 'message' ? MESSAGE_PRESETS.slice() : CALL_PRESETS.slice();
+  }
+
+  static find(slot: SoundSlotKind, presetId: string): PresetDescriptor | null {
+    const list: PresetDescriptor[] = slot === 'message' ? MESSAGE_PRESETS : CALL_PRESETS;
+    for (let i: number = 0; i < list.length; i++) {
+      const item: PresetDescriptor = list[i];
+      if (item.id === presetId) {
+        return item;
+      }
+    }
+    return null;
+  }
+
+  static isValidPreset(slot: SoundSlotKind, presetId: string): boolean {
+    return SoundPresetCatalog.find(slot, presetId) !== null;
+  }
+}
