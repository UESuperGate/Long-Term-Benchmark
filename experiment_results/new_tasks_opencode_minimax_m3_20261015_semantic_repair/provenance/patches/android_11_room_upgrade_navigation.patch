+/**
+ * Best-effort reflective lookup for the predecessor room exposed by the Rust
+ * SDK on its `RoomInfo` type. The field was added in
+ * `matrix-rust-sdk` v0.7/25.06+; older FFI versions do not expose it.
+ *
+ * Returns `null` if the field is absent or cannot be coerced to the
+ * expected `PredecessorRoom` shape.
+ */
+private fun rustPredecessorRoomOrNull(rustRoomInfo: RustRoomInfo): PredecessorRoom? {
+    return runCatching {
+        val javaClass = rustRoomInfo::class.java
+        // Uniffi-generated Kotlin classes expose Rust record fields as a
+        // public getter method named after the field (e.g. `getPredecessorRoom`).
+        val getter = javaClass.methods.firstOrNull { it.name == "getPredecessorRoom" && it.parameterCount == 0 }
+            ?: return@runCatching null
+        val raw = getter.invoke(rustRoomInfo) ?: return@runCatching null
+        mapPredecessorRoom(raw)
+    }.getOrNull()
+}
+
+/**
+ * Map a Rust `PredecessorRoom` value to the application-level
+ * [io.element.android.libraries.matrix.api.room.PredecessorRoom] type using
+ * reflection, so we don't depend on a specific class name in the FFI.
+ *
+ * The Rust type is expected to expose a `roomId: String` property and an
+ * optional `lastEventId: String?` property. Both are accessed reflectively.
+ */
+private fun mapPredecessorRoom(raw: Any): PredecessorRoom? {
+    return runCatching {
+        val rawClass = raw::class.java
+        val roomIdMethod = rawClass.methods.firstOrNull { it.name == "getRoomId" && it.parameterCount == 0 }
+            ?: return@runCatching null
+        val roomIdValue = (roomIdMethod.invoke(raw) as? String) ?: return@runCatching null
+        val lastEventIdMethod = rawClass.methods.firstOrNull { it.name == "getLastEventId" && it.parameterCount == 0 }
+        val lastEventIdValue = lastEventIdMethod?.invoke(raw) as? String
+        PredecessorRoom(
+            roomId = RoomId(roomIdValue),
+            lastEventId = lastEventIdValue?.let(::EventId),
+        )
+    }.getOrNull()
+}
