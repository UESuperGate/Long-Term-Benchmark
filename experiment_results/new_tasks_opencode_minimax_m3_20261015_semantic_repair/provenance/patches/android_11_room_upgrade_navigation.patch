+package io.element.android.libraries.matrix.api.room
+
+import io.element.android.libraries.matrix.api.core.EventId
+import io.element.android.libraries.matrix.api.core.RoomId
+
+/**
+ * When a room A is tombstoned, it is replaced by a room B. The room A is the
+ * predecessor of B, and B is the successor of A. This type holds information
+ * about the predecessor room from the replacement room's point of view.
+ *
+ * A replacement room identifies its predecessor via the
+ * `m.room.predecessor` event sent during the upgrade.
+ */
+data class PredecessorRoom(
+    /**
+     * The ID of the predecessor (tombstoned) room.
+     */
+    val roomId: RoomId,
+    /**
+     * The id of the last known event in the predecessor room. The room upgrade
+     * process moves history over to the replacement room, so this lets the
+     * replacement room point at the latest event the predecessor produced.
+     */
+    val lastEventId: EventId?,
+)
