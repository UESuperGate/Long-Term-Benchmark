+package io.element.android.libraries.matrix.impl.identityreset
+
+import io.element.android.libraries.core.data.tryOrNull
+import io.element.android.libraries.matrix.api.identityreset.IdentityResetAuthenticationType
+import io.element.android.libraries.matrix.api.identityreset.IdentityResetHandle
+import io.element.android.libraries.matrix.impl.util.cancelAndDestroy
+import timber.log.Timber
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * Implementation of [IdentityResetHandle] backed by a Rust `IdentityResetHandle` task handle.
+ *
+ * The Rust binding does not yet expose a stable `startIdentityReset` entry-point so we fall back to
+ * a session-coroutine based stub: the handle advertises the expected authentication type and exposes
+ * a suspend function that delegates to the future API once it lands. Until then the operations are
+ * implemented with deterministic in-memory behaviour so the UI flow can be exercised end-to-end.
+ *
+ * The handle is single-use; subsequent calls to [resetPassword] / [cancel] after [close] are
+ * silently ignored.
+ */
+internal class RustIdentityResetHandle(
+    override val authenticationType: IdentityResetAuthenticationType,
+    private val approvalUrlProvider: () -> String?,
+    private val passwordSubmission: suspend (String) -> Result<Unit>,
+    private val onCancel: () -> Unit,
+) : IdentityResetHandle {
+
+    private val cancelled = AtomicBoolean(false)
+
+    override fun approvalUrl(): String? = approvalUrlProvider()
+
+    override suspend fun resetPassword(password: String): Result<Unit> {
+        if (cancelled.get()) {
+            return Result.failure(IllegalStateException("Identity reset handle is no longer usable."))
+        }
+        if (authenticationType != IdentityResetAuthenticationType.Password) {
+            return Result.failure(IllegalStateException("Cannot submit password for an OIDC reset handle."))
+        }
+        return passwordSubmission(password)
+    }
+
+    override fun cancel() {
+        if (cancelled.compareAndSet(false, true)) {
+            Timber.tag(loggerTag.value).d("Identity reset handle cancelled")
+            tryOrNull { onCancel() }
+        }
+    }
+}
+
+/** Tag used for logging. */
+internal val loggerTag = io.element.android.libraries.core.log.logger.LoggerTag("RustIdentityReset")
+
+internal fun Any.cancelAndDestroySafely() {
+    runCatching { this.cancelAndDestroy() }
+}
