+            }
+            else -> {
+                _handleState.value = IdentityResetHandleState.Loading
+                failureOnNextStart?.let { failure ->
+                    failureOnNextStart = null
+                    _handleState.value = IdentityResetHandleState.Failure(failure)
+                    return@withLock Result.failure(failure)
+                }
+                val result = nextHandleResult
+                nextHandleResult = Result.success(buildHandle())
+                result.fold(
+                    onSuccess = { handle ->
+                        _handleState.value = IdentityResetHandleState.Active(handle)
+                        Result.success(handle)
+                    },
+                    onFailure = { error ->
+                        _handleState.value = IdentityResetHandleState.Failure(error)
+                        Result.failure(error)
+                    },
+                )
+            }
+        }
+    }
+
+    override suspend fun cancelIdentityReset() {
+        mutex.withLock {
+            cancelInvocations.incrementAndGet()
+            val handle = (_handleState.value as? IdentityResetHandleState.Active)?.handle
+            _handleState.value = IdentityResetHandleState.Uninitialized
+            handle?.cancel()
+        }
+    }
