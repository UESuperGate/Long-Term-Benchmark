+
+/**
+ * UI state for the password re-authentication step.
+ *
+ * @property password the value the user has entered (kept as-is so the parent flow can read it
+ * even after the underlying text-field is recomposed).
+ * @property submitAction the in-flight / outcome state of the latest password submission.
+ */
+data class IdentityResetPasswordState(
+    val password: String,
+    val submitAction: AsyncAction<Unit>,
+    val eventSink: (IdentityResetPasswordEvents) -> Unit,
+) {
