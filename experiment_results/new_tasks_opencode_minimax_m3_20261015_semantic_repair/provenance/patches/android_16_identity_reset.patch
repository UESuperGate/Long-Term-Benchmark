+package io.element.android.features.identityreset.impl.password
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.MutableState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import io.element.android.libraries.architecture.AsyncAction
+import io.element.android.libraries.architecture.Presenter
+import kotlinx.coroutines.launch
+import javax.inject.Inject
+
+/**
+ * Presenter for the password re-authentication step of the identity reset flow.
+ *
+ * The presenter does not own the SDK handle — the parent flow node passes it in via
+ * [IdentityResetPasswordEvents.Submit] so the handle can be destroyed together with the rest of
+ * the reset operation when the flow is cancelled.
+ *
+ * Invariants:
+ * - Empty passwords cannot be submitted.
+ * - A failed attempt must not destroy the underlying SDK handle (so the user can retry).
+ * - Editing the password field clears any previously displayed error so the user can re-submit.
+ */
+class IdentityResetPasswordPresenter @Inject constructor() : Presenter<IdentityResetPasswordState> {
+
+    @Composable
+    override fun present(): IdentityResetPasswordState {
+        val localCoroutineScope = rememberCoroutineScope()
+        var password by remember { mutableStateOf("") }
+        val submitAction: MutableState<AsyncAction<Unit>> = remember {
+            mutableStateOf(AsyncAction.Uninitialized)
+        }
+
+        fun handleEvents(event: IdentityResetPasswordEvents) {
+            when (event) {
+                is IdentityResetPasswordEvents.SetPassword -> {
+                    password = event.password
+                    if (submitAction.value.isFailure()) {
+                        // Drop the error so the user can retry without the dialog lingering.
+                        submitAction.value = AsyncAction.Uninitialized
+                    }
+                }
+                is IdentityResetPasswordEvents.Submit -> {
+                    val trimmed = password.trim()
+                    if (trimmed.isEmpty()) {
+                        // Empty passwords can never be submitted; never call into the SDK.
+                        return
+                    }
+                    submitAction.value = AsyncAction.Loading
+                    localCoroutineScope.launch {
+                        event.handle.resetPassword(trimmed)
+                            .onSuccess { submitAction.value = AsyncAction.Success(Unit) }
+                            .onFailure { submitAction.value = AsyncAction.Failure(it) }
+                    }
+                }
+                IdentityResetPasswordEvents.ClearError -> {
+                    submitAction.value = AsyncAction.Uninitialized
+                }
+            }
+        }
+
+        return IdentityResetPasswordState(
+            password = password,
+            submitAction = submitAction.value,
+            eventSink = ::handleEvents,
+        )
+    }
+}
