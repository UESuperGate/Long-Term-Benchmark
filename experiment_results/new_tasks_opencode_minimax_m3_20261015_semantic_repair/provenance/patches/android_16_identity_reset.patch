+    private var failureOnNextStart: Throwable? = null
+
+    /** How many times [startIdentityReset] has been called. */
+    val startCalls: Int get() = startInvocations.get()
+
+    /** How many times [cancelIdentityReset] has been called. */
+    val cancelCalls: Int get() = cancelInvocations.get()
+
+    fun givenNextAuthenticationType(type: IdentityResetAuthenticationType) {
+        nextAuthenticationType = type
+    }
+
+    fun givenNextHandleResult(result: Result<IdentityResetHandle>) {
+        nextHandleResult = result
+    }
+
+    fun givenPasswordSubmissionResult(result: Result<Unit>) {
