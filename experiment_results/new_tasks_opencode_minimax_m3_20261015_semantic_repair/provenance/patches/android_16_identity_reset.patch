+package io.element.android.libraries.matrix.api.identityreset
+
+import java.io.Closeable
+
+/**
+ * The kind of re-authentication the [IdentityResetHandle] is requesting from the user.
+ *
+ * Mirrors the Matrix spec for User-Interactive Authentication. The reset operation is started by the
+ * SDK and then either asks the user to provide their account password (in a [Password] flow) or to
+ * complete the OIDC flow of the homeserver (in an [Oidc] flow, in which case [IdentityResetHandle.approvalUrl]
+ * is the URL the user has to be redirected to).
+ */
+enum class IdentityResetAuthenticationType {
+    Password,
+    Oidc,
+}
+
+/**
+ * The state of an in-flight identity reset operation.
+ *
+ * One handle is produced per operation; it must be [cancel]led or [close]d when no longer needed so
+ * that the underlying SDK task is released.
+ */
+interface IdentityResetHandle : Closeable {
+
+    /**
+     * The authentication type the user must provide for this reset to progress.
+     */
+    val authenticationType: IdentityResetAuthenticationType
+
+    /**
+     * For [IdentityResetAuthenticationType.Oidc] the URL to display in the custom tab / web view so the
+     * user can complete OIDC re-authentication. Always `null` for [IdentityResetAuthenticationType.Password].
+     */
+    fun approvalUrl(): String?
+
+    /**
+     * Submit a password for [IdentityResetAuthenticationType.Password] handles.
+     *
+     * For OIDC handles this always returns [Result.failure] with [IllegalStateException]; the user has
+     * to complete the OIDC flow instead.
+     */
+    suspend fun resetPassword(password: String): Result<Unit>
+
+    /**
+     * Cancel and release the underlying SDK handle. After calling this the handle must not be reused.
+     */
+    fun cancel()
+
+    /**
+     * Release the underlying SDK handle. Equivalent to [cancel].
+     */
+    override fun close() = cancel()
+}
