+
+    override suspend fun startIdentityReset(): Result<IdentityResetHandle> = mutex.withLock {
+        startInvocations.incrementAndGet()
+        when (val current = _handleState.value) {
+            is IdentityResetHandleState.Active -> {
+                // Reuse the existing handle, as required by the public transitions.
+                Result.success(current.handle)
+            }
+            is IdentityResetHandleState.Loading -> {
