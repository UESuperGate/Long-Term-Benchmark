+
+    override fun nodeBuilder(parentNode: Node, buildContext: BuildContext): IdentityResetEntryPoint.NodeBuilder {
+        val plugins = ArrayList<Plugin>()
+
+        return object : IdentityResetEntryPoint.NodeBuilder {
+            override fun params(params: IdentityResetEntryPointParams): IdentityResetEntryPoint.NodeBuilder {
