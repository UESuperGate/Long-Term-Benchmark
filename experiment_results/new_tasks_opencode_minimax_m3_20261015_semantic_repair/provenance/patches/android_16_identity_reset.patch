+
+package io.element.android.features.identityreset.impl
+
+import android.os.Parcelable
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.ui.Modifier
+import androidx.lifecycle.lifecycleScope
+import com.bumble.appyx.core.modality.BuildContext
+import com.bumble.appyx.core.node.Node
+import com.bumble.appyx.core.plugin.Plugin
+import com.bumble.appyx.core.plugin.plugins
+import com.bumble.appyx.navmodel.backstack.BackStack
+import com.bumble.appyx.navmodel.backstack.operation.newRoot
+import com.bumble.appyx.navmodel.backstack.operation.pop
+import com.bumble.appyx.navmodel.backstack.operation.push
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedInject
+import io.element.android.anvilannotations.ContributesNode
+import io.element.android.features.identityreset.api.IdentityResetEntryPoint
+import io.element.android.features.identityreset.impl.confirmation.IdentityResetConfirmationNode
+import io.element.android.features.identityreset.impl.oidc.IdentityResetOidcNode
+import io.element.android.features.identityreset.impl.password.IdentityResetPasswordNode
+import io.element.android.features.identityreset.impl.success.IdentityResetCompletionNode
+import io.element.android.features.identityreset.impl.waiting.IdentityResetWaitingForVerificationNode
+import io.element.android.libraries.architecture.BackstackView
+import io.element.android.libraries.architecture.BaseFlowNode
+import io.element.android.libraries.architecture.createNode
+import io.element.android.libraries.di.SessionScope
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.identityreset.IdentityResetAuthenticationType
+import io.element.android.libraries.matrix.api.identityreset.IdentityResetHandle
+import io.element.android.libraries.matrix.api.identityreset.IdentityResetHandleState
+import kotlinx.coroutines.flow.filterIsInstance
+import kotlinx.coroutines.launch
+import kotlinx.parcelize.Parcelize
+
+/**
+ * Flow node for the identity reset user story. Wires the destructive confirmation, the SDK handle
+ * acquisition, the password / OIDC re-authentication steps, the session-verification wait, and the
+ * cleanup step (OIDC return + node destruction share the same path).
+ */
+@ContributesNode(SessionScope::class)
+class IdentityResetFlowNode @AssistedInject constructor(
+    @Assisted buildContext: BuildContext,
+    @Assisted plugins: List<Plugin>,
+    private val matrixClient: MatrixClient,
+) : BaseFlowNode<IdentityResetFlowNode.NavTarget>(
+    backstack = BackStack(
+        initialElement = NavTarget.Confirmation,
+        savedStateMap = buildContext.savedStateMap,
+    ),
+    buildContext = buildContext,
+    plugins = plugins,
+) {
+
+    sealed interface NavTarget : Parcelable {
+        @Parcelize
+        data object Confirmation : NavTarget
+
+        @Parcelize
+        data object Password : NavTarget
+
+        @Parcelize
+        data object Oidc : NavTarget
+
+        @Parcelize
+        data object WaitingForVerification : NavTarget
+
+        @Parcelize
+        data object Completion : NavTarget
+    }
+
+    private val callbacks = plugins<IdentityResetEntryPoint.Callback>()
+
+    /**
+     * The currently active SDK handle, kept in memory only because the handle is not Parcelable
+     * and so cannot be part of [NavTarget]. The parent flow drives this lifecycle.
+     */
+    private var activeHandle: IdentityResetHandle? = null
+
+    override fun resolve(navTarget: NavTarget, buildContext: BuildContext): Node {
+        return when (navTarget) {
+            NavTarget.Confirmation -> {
+                val callback = object : IdentityResetConfirmationNode.Callback {
+                    override fun onHandleReady(handle: IdentityResetHandle) {
+                        routeToReauthentication(handle)
+                    }
+                    override fun onCancel() {
+                        // Cancellation before the SDK has been engaged has no SDK side-effect,
+                        // matching the dismiss_confirmation invariant.
+                        cleanupAndCancel()
+                    }
+                }
+                createNode<IdentityResetConfirmationNode>(buildContext, listOf(callback))
+            }
+            NavTarget.Password -> {
+                val handle = activeHandle
+                    ?: error("Password step opened without an active SDK handle.")
+                val callback = object : IdentityResetPasswordNode.Callback {
+                    override fun onResetSucceeded(handle: IdentityResetHandle) {
+                        // Advancing the same handle must not start a second reset; we simply move
+                        // to the verification wait state and observe session verification status.
+                        backstack.newRoot(NavTarget.WaitingForVerification)
+                    }
+                    override fun onCancelled() {
+                        cleanupAndCancel()
+                    }
+                }
+                val inputs = IdentityResetPasswordNode.Inputs(handle = handle)
+                createNode<IdentityResetPasswordNode>(buildContext, listOf(inputs, callback))
+            }
+            NavTarget.Oidc -> {
+                val handle = activeHandle
+                    ?: error("OIDC step opened without an active SDK handle.")
+                val callback = object : IdentityResetOidcNode.Callback {
+                    override fun onCancelled() {
+                        cleanupAndCancel()
+                    }
+                }
+                val inputs = IdentityResetOidcNode.Inputs(handle = handle)
+                createNode<IdentityResetOidcNode>(buildContext, listOf(inputs, callback))
+            }
+            NavTarget.WaitingForVerification -> {
+                val callback = object : IdentityResetWaitingForVerificationNode.Callback {
+                    override fun onVerified() {
+                        backstack.newRoot(NavTarget.Completion)
+                    }
+                }
+                createNode<IdentityResetWaitingForVerificationNode>(buildContext, listOf(callback))
+            }
+            NavTarget.Completion -> {
+                val callback = object : IdentityResetCompletionNode.Callback {
+                    override fun onDone() {
+                        // Mark the flow as complete: report success to the parent so it can
+                        // refresh recovery / verification state, and tear down the active
+                        // operation.
+                        val handle = activeHandle
+                        activeHandle = null
+                        lifecycleScope.launch {
+                            matrixClient.identityResetService().cancelIdentityReset()
+                            handle?.cancel()
+                        }
+                        callbacks.forEach { it.onResetFlowComplete() }
+                        backstack.pop()
+                    }
+                }
+                createNode<IdentityResetCompletionNode>(buildContext, listOf(callback))
+            }
+        }
+    }
+
+    private fun routeToReauthentication(handle: IdentityResetHandle) {
+        // Retain the handle in the flow node so the password/oidc nodes can re-resolve it after
+        // configuration change.
+        activeHandle = handle
+        when (handle.authenticationType) {
+            IdentityResetAuthenticationType.Password -> {
+                backstack.push(NavTarget.Password)
+            }
+            IdentityResetAuthenticationType.Oidc -> {
+                backstack.push(NavTarget.Oidc)
+            }
+        }
+    }
+
+    /**
+     * Cancel the active reset operation. Used by the user-driven cancel paths and by the
+     * OIDC-return / node-destruction cleanup path so that both go through the same code.
+     */
+    private fun cleanupAndCancel() {
+        val handle = activeHandle
+        activeHandle = null
+        lifecycleScope.launch {
+            matrixClient.identityResetService().cancelIdentityReset()
+            handle?.cancel()
+        }
+        callbacks.forEach { it.onResetFlowCancelled() }
+        backstack.pop()
+    }
+
+    @Composable
+    override fun View(modifier: Modifier) {
+        BackstackView()
+        // Observe the service's handleState to detect OIDC completion / external cancellation.
+        LaunchedEffect(Unit) {
+            matrixClient.identityResetService().handleState
+                .filterIsInstance<IdentityResetHandleState.Success>()
+                .collect {
+                    backstack.newRoot(NavTarget.WaitingForVerification)
+                }
+        }
+    }
+
+    override fun onDestroy() {
+        // Cancellation that happens when the node is destroyed for any reason uses the same
+        // cleanup path as the explicit cancel; this matches the cancel_cleans_up public
+        // transition invariant.
+        val handle = activeHandle
+        activeHandle = null
+        lifecycleScope.launch {
+            matrixClient.identityResetService().cancelIdentityReset()
+            handle?.cancel()
+        }
+        super.onDestroy()
+    }
+}
