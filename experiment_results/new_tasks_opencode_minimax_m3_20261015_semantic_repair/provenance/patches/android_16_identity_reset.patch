+
+@ContributesNode(SessionScope::class)
+class IdentityResetConfirmationNode @AssistedInject constructor(
+    @Assisted buildContext: BuildContext,
+    @Assisted plugins: List<Plugin>,
+    private val presenter: IdentityResetConfirmationPresenter,
+) : Node(buildContext, plugins = plugins) {
+
+    interface Callback : Plugin {
+        /** The confirmation accepted the destructive step and a handle is now available. */
+        fun onHandleReady(handle: IdentityResetHandle)
+
+        /** The user cancelled the reset flow from this screen. */
+        fun onCancel()
+    }
+
+    private val callback = plugins<Callback>().first()
+
+    @Composable
+    override fun View(modifier: Modifier) {
+        val state = presenter.present()
+        IdentityResetConfirmationView(
+            state = state,
+            modifier = modifier,
+            onCancel = { callback.onCancel() },
+            onBackClick = ::navigateUp,
+        )
+        // Side effect: react to a successful handle load by routing to the re-auth screen.
+        LaunchedEffect(state.startAction) {
+            (state.startAction as? AsyncAction.Success)?.let { callback.onHandleReady(it.data) }
+        }
+    }
+}
