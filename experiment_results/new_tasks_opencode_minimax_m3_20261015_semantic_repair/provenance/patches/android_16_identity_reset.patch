+package io.element.android.features.identityreset.api
+
+import com.bumble.appyx.core.modality.BuildContext
+import com.bumble.appyx.core.node.Node
+import com.bumble.appyx.core.plugin.Plugin
+import io.element.android.libraries.architecture.FeatureEntryPoint
+import io.element.android.libraries.architecture.NodeInputs
+
+/**
+ * Entry point for the "Reset Identity" user story. Use this from the logged-in flow when normal
+ * recovery is unavailable and the user explicitly asks to reset their cryptographic identity.
+ *
+ * The feature handles confirmation, the underlying SDK handle acquisition, password / OIDC
+ * re-authentication, and completion / cancellation — including cleanup of the OIDC return path
+ * and the SDK node destruction.
+ */
+interface IdentityResetEntryPoint : FeatureEntryPoint {
+    fun nodeBuilder(parentNode: Node, buildContext: BuildContext): NodeBuilder
+
+    interface Callback : Plugin {
+        /** Called when the reset is fully complete (or after a successful navigation away). */
+        fun onResetFlowComplete()
+
+        /** Called when the user cancels the flow at any step before completion. */
+        fun onResetFlowCancelled()
+    }
+
+    interface NodeBuilder {
+        fun params(params: IdentityResetEntryPointParams): NodeBuilder
+        fun callback(callback: Callback): NodeBuilder
+        fun build(): Node
+    }
+}
+
+/** Marker input; the feature does not need any per-call parameters today. */
+data class IdentityResetEntryPointParams(val placeholder: Unit = Unit) : NodeInputs
