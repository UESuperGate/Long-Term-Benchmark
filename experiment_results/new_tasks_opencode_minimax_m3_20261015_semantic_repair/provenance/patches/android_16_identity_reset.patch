+
+package io.element.android.libraries.matrix.api.identityreset
+
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Service exposing the identity reset operation initiated by the user when no other recovery
+ * option is available.
+ *
+ * Lifecycle:
+ * 1. The UI asks the user for an explicit, destructive confirmation.
+ * 2. After confirmation the UI calls [startIdentityReset] once. Repeated concurrent calls reuse a
+ *    pending handle, so a single reset operation is active at a time.
+ * 3. The returned [IdentityResetHandle] either expects a password submission or the user to complete
+ *    OIDC re-authentication.
+ * 4. The UI cancels the operation via [IdentityResetHandle.cancel] on cancel or on a final failure.
+ *
+ * The state of the current operation is exposed through [handleState]; concurrent calls to
+ * [startIdentityReset] share the same loading / successful handle.
+ */
+interface IdentityResetService {
+    val handleState: StateFlow<IdentityResetHandleState>
+
+    /**
+     * Start a new identity reset operation.
+     *
+     * Idempotent while a handle is being loaded: if an operation is already in flight or has
+     * succeeded the call returns that handle without starting a second reset.
+     *
+     * @return [Result.success] with the loaded handle, or [Result.failure] if the SDK could not
+     * produce a handle (for instance if account recovery is already configured).
+     */
+    suspend fun startIdentityReset(): Result<IdentityResetHandle>
+
+    /**
+     * Cancel the current identity reset operation, if any.
+     *
+     * The underlying handle is destroyed and the state flow is reset to [IdentityResetHandleState.Uninitialized].
+     * Calling this when no operation is in flight is a no-op.
+     */
+    suspend fun cancelIdentityReset()
+}
+
+/** Possible states of the active identity reset operation. */
+sealed interface IdentityResetHandleState {
+    /** No operation has been started (or the previous one was cancelled / completed). */
+    data object Uninitialized : IdentityResetHandleState
+
+    /** An operation is being created; the UI should show a loading state. */
+    data object Loading : IdentityResetHandleState
+
+    /** The operation is in flight and waits for the user to interact with [IdentityResetHandle]. */
+    data class Active(val handle: IdentityResetHandle) : IdentityResetHandleState
+
+    /** The previous operation finished successfully; the flow is awaiting cleanup. */
+    data object Success : IdentityResetHandleState
+
+    /** The previous operation failed; the UI may display the error and offer retry. */
+    data class Failure(val error: Throwable) : IdentityResetHandleState
+}
