+package io.element.android.features.identityreset.impl.confirmation
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import io.element.android.libraries.architecture.AsyncAction
+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.identityreset.IdentityResetHandle
+import kotlinx.coroutines.launch
+import javax.inject.Inject
+
+/**
+ * Presenter for the destructive confirmation step that must be shown before any identity reset can
+ * start.
+ *
+ * The confirmation has three observable states:
+ * - confirmationVisible=false (default): only "Continue" / "Cancel" buttons. Continuing does not
+ *   start the SDK call until the user explicitly accepts the confirmation.
+ * - confirmationVisible=true: the user is looking at the destructive-consequence dialog and can
+ *   still back out.
+ *
+ * Once the user confirms, [IdentityResetConfirmationEvents.ConfirmReset] is invoked which kicks off
+ * the SDK call asynchronously (so the visible UI can transition to the loading screen without
+ * blocking the user). A dismissal event has no SDK side-effect — it merely resets
+ * [confirmationVisible] to false.
+ */
+class IdentityResetConfirmationPresenter @Inject constructor(
+    private val matrixClient: MatrixClient,
+) : Presenter<IdentityResetConfirmationState> {
+
+    @Composable
+    override fun present(): IdentityResetConfirmationState {
+        val coroutineScope = rememberCoroutineScope()
+        var confirmationVisible by remember { mutableStateOf(false) }
+        val startAction = remember { mutableStateOf<AsyncAction<IdentityResetHandle>>(AsyncAction.Uninitialized) }
+
+        fun handleEvents(event: IdentityResetConfirmationEvents) {
+            when (event) {
+                IdentityResetConfirmationEvents.Continue -> {
+                    // The "continue" path requires destructive confirmation before any SDK call.
+                    confirmationVisible = true
+                }
+                IdentityResetConfirmationEvents.DismissConfirmation -> {
+                    // Dismissing the confirmation has no SDK side-effect.
+                    confirmationVisible = false
+                }
+                IdentityResetConfirmationEvents.ConfirmReset -> {
+                    if (startAction.value.isUninitialized()) {
+                        coroutineScope.launch {
+                            startAction.value = AsyncAction.Loading
+                            matrixClient.identityResetService().startIdentityReset()
+                                .onSuccess { handle -> startAction.value = AsyncAction.Success(handle) }
+                                .onFailure { error -> startAction.value = AsyncAction.Failure(error) }
+                        }
+                    }
+                    confirmationVisible = false
+                }
+            }
+        }
+
+        return IdentityResetConfirmationState(
+            confirmationVisible = confirmationVisible,
+            startAction = startAction.value,
+            eventSink = ::handleEvents,
+        )
+    }
+}
