+package io.element.android.features.identityreset.impl.oidc
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.MutableState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import io.element.android.libraries.architecture.Presenter
+import javax.inject.Inject
+
+/**
+ * Presenter for the OIDC re-authentication step of the identity reset flow.
+ *
+ * The presenter models three observable states:
+ * - awaiting (waiting for the user to complete the OIDC browser flow),
+ * - success (OIDC completed and the handle advanced),
+ * - failure (the OIDC browser flow failed or was cancelled).
+ *
+ * The presenter does not own the SDK handle so that the parent flow node can drive the cleanup
+ * path uniformly for OIDC-return and node-destruction scenarios.
+ */
+class IdentityResetOidcPresenter @Inject constructor() : Presenter<IdentityResetOidcState> {
+
+    @Composable
+    override fun present(): IdentityResetOidcState {
+        val status: MutableState<OIDCStatus> = remember { mutableStateOf(OIDCStatus.Awaiting) }
+        var approvalUrl by remember { mutableStateOf<String?>(null) }
+
+        fun handleEvents(event: IdentityResetOidcEvents) {
+            when (event) {
+                is IdentityResetOidcEvents.SetApprovalUrl -> {
+                    approvalUrl = event.url
+                }
+                IdentityResetOidcEvents.OidcCompleted -> {
+                    status.value = OIDCStatus.Success
+                }
+                is IdentityResetOidcEvents.OidcFailed -> {
+                    status.value = OIDCStatus.Failure(event.cause)
+                }
+                IdentityResetOidcEvents.ClearError -> {
+                    status.value = OIDCStatus.Awaiting
+                }
+            }
+        }
+
+        return IdentityResetOidcState(
+            status = status.value,
+            approvalUrl = approvalUrl,
+            eventSink = ::handleEvents,
+        )
+    }
+}
+
+/** Internal status of the OIDC step. */
+sealed interface OIDCStatus {
+    data object Awaiting : OIDCStatus
+    data object Success : OIDCStatus
+    data class Failure(val cause: Throwable) : OIDCStatus
+}
