+import promptAction from '@ohos.promptAction';
+import router from '@ohos.router';
+import { PinnedListState, PinnedMessageRow, PinnedMessagesList, PinnedUnpinResult } from '../features/PinnedMessagesList';
+import { PinnedMessagesSession, RoomSessionListener } from '../features/PinnedMessagesSession';
+
+@Entry
+@Component
+struct PinnedMessages {
+  private session: PinnedMessagesSession = PinnedMessagesSession.shared();
+  private collection: PinnedMessagesList = this.session.pinnedCollection();
+  private scroller: Scroller = new Scroller();
+  private unsubscribe: RoomSessionListener | undefined = undefined;
+  private activeEventId: string = '';
+  @State private rows: PinnedMessageRow[] = [];
+  @State private listState: PinnedListState = PinnedListState.Closed;
+  @State private canPinUnpin: boolean = false;
+  @State private loadingMore: boolean = false;
+  @State private hasMore: boolean = false;
+  @State private failureMessage: string = '';
+  @State private paginationErrorMessage: string = '';
+  @State private navigationError: string = '';
+
+  aboutToAppear(): void {
+    this.unsubscribe = this.collection.subscribe((): void => {
+      this.syncFromCollection();
+    });
+    this.collection.open();
+  }
+
+  onPageHide(): void {
+    this.collection.close();
+  }
+
+  aboutToDisappear(): void {
+    if (this.unsubscribe !== undefined) {
+      this.unsubscribe();
+      this.unsubscribe = undefined;
+    }
+  }
+
+  private syncFromCollection(): void {
+    this.rows = this.collection.items().slice();
+    this.listState = this.collection.state;
+    this.canPinUnpin = this.collection.canPinUnpin;
+    this.loadingMore = this.collection.loadingMore;
+    this.hasMore = this.collection.hasMore;
+    this.failureMessage = this.collection.failureMessage;
+    this.paginationErrorMessage = this.collection.paginationErrorMessage;
+    if (this.activeEventId.length > 0 && !this.hasRow(this.activeEventId)) {
+      this.activeEventId = '';
+    }
+  }
+
+  private hasRow(eventId: string): boolean {
+    for (const row of this.rows) {
+      if (row.eventId === eventId) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private showMessageActions(row: PinnedMessageRow): void {
+    this.activeEventId = row.eventId;
+    this.collection.toggleActions(row.eventId);
+  }
+
+  private viewInTimeline(row: PinnedMessageRow): void {
+    if (row.busy) {
+      return;
+    }
+    this.session.requestTimelineFocus(row.eventId);
+    this.navigationError = '';
+    try {
+      router.back();
+    } catch (error) {
+      this.session.requestTimelineFocus('');
+      this.navigationError = 'Could not return to the room timeline.';
+    }
+  }
+
+  private unpin(row: PinnedMessageRow): void {
+    this.collection.unpin(row.eventId).then((result: PinnedUnpinResult) => {
+      if (result === PinnedUnpinResult.Confirmed) {
+        this.showToast('Message unpinned');
+        return;
+      }
+      if (result === PinnedUnpinResult.NotPermitted) {
+        this.showToast('You are not allowed to unpin messages in this room');
+        return;
+      }
+      if (result === PinnedUnpinResult.Rejected) {
+        this.showToast('Could not unpin the message, it is still pinned');
+      }
+    });
+  }
+
+  private showToast(message: string): void {
+    try {
+      promptAction.showToast({ message: message });
+    } catch (error) {
+      // The outcome is already visible next to the item, a missing toast is not
+      // worth interrupting the user for.
+    }
+  }
+
+  build() {
+    Column() {
+      this.Header()
+      if (this.navigationError.length > 0) {
+        Text(this.navigationError)
+          .fontSize(13)
+          .fontColor('#B42318')
+          .padding({ left: 20, right: 20, top: 8 })
+          .width('100%')
+      }
+      this.Body()
+    }
+    .height('100%')
+    .width('100%')
+    .backgroundColor('#F4F6F8')
+  }
+
+  @Builder
+  Header() {
+    Row() {
+      Column({ space: 2 }) {
+        Text('Pinned messages')
+          .fontSize(22)
+          .fontWeight(FontWeight.Bold)
+        Text('Design team')
+          .fontSize(13)
+          .fontColor('#64748B')
+      }
+      .alignItems(HorizontalAlign.Start)
+      Blank()
+      Button('Close')
+        .onClick((): void => {
+          this.closePage();
+        })
+        .id('pinned_messages_close')
+    }
+    .padding(20)
+    .width('100%')
+    .backgroundColor('#FFFFFF')
+  }
+
+  @Builder
+  Body() {
+    if (this.listState === PinnedListState.Loading || this.listState === PinnedListState.Closed) {
+      Column({ space: 12 }) {
+        LoadingProgress()
+          .width(32)
+          .height(32)
+          .color('#067A68')
+        Text('Loading pinned messages')
+          .fontSize(15)
+          .fontColor('#64748B')
+      }
+      .layoutWeight(1)
+      .width('100%')
+      .justifyContent(FlexAlign.Center)
+      .id('pinned_list_loading')
+    } else if (this.listState === PinnedListState.Failed) {
+      Column({ space: 12 }) {
+        Text('Pinned messages could not be loaded')
+          .fontSize(16)
+          .fontWeight(FontWeight.Medium)
+        Text(this.failureMessage)
+          .fontSize(13)
+          .fontColor('#64748B')
+          .textAlign(TextAlign.Center)
+        Button('Try again')
+          .onClick((): void => {
+            this.collection.retry();
+          })
+          .id('pinned_list_retry')
+      }
+      .padding(24)
+      .layoutWeight(1)
+      .width('100%')
+      .justifyContent(FlexAlign.Center)
+      .id('pinned_list_error')
+    } else if (this.listState === PinnedListState.Empty) {
+      Column({ space: 10 }) {
+        Text('No pinned messages')
+          .fontSize(16)
+          .fontWeight(FontWeight.Medium)
+        Text('Nothing is pinned in this room yet.')
+          .fontSize(13)
+          .fontColor('#64748B')
+      }
+      .padding(24)
+      .layoutWeight(1)
+      .width('100%')
+      .justifyContent(FlexAlign.Center)
+      .id('pinned_list_empty')
+    } else {
+      this.CollectionList()
+    }
+  }
+
+  @Builder
+  CollectionList() {
+    List({ scroller: this.scroller }) {
+      ForEach(this.rows, (row: PinnedMessageRow) => {
+        ListItem() {
+          this.MessageRow(row)
+        }
+      }, (row: PinnedMessageRow) => row.eventId)
+      this.ListFooter()
+    }
+    .layoutWeight(1)
+    .width('100%')
+    .onReachEnd((): void => {
+      this.collection.loadMore();
+    })
+    .id('pinned_messages_list')
+  }
+
+  @Builder
+  ListFooter() {
+    ListItem() {
+      Column({ space: 8 }) {
+        if (this.loadingMore) {
+          LoadingProgress()
+            .width(24)
+            .height(24)
+            .color('#067A68')
+          Text('Loading more pinned messages')
+            .fontSize(13)
+            .fontColor('#64748B')
+        } else if (this.paginationErrorMessage.length > 0) {
+          Text(this.paginationErrorMessage)
+            .fontSize(13)
+            .fontColor('#B42318')
+          Button('Try again')
+            .onClick((): void => {
+              this.collection.retry();
+            })
+            .id('pinned_list_load_more_retry')
+        } else if (!this.hasMore) {
+          Text('That is everything pinned in this room')
+            .fontSize(13)
+            .fontColor('#94A3B8')
+            .id('pinned_list_end')
+        }
+      }
+      .padding(16)
+      .width('100%')
+    }
+  }
+
+  @Builder
+  MessageRow(row: PinnedMessageRow) {
+    Column({ space: 8 }) {
+      Row({ space: 8 }) {
+        Text(row.sender)
+          .fontSize(13)
+          .fontWeight(FontWeight.Medium)
+          .fontColor(row.isRenderable() ? '#0F172A' : '#64748B')
+        Text(row.timeLabel)
+          .fontSize(12)
+          .fontColor('#94A3B8')
+        Blank()
+        Button('Actions')
+          .fontSize(12)
+          .height(28)
+          .onClick((): void => {
+            this.showMessageActions(row);
+          })
+          .id(`pinned_item_actions_${row.eventId}`)
+      }
+      .width('100%')
+      .alignItems(VerticalAlign.Center)
+
+      Text(row.body)
+        .fontSize(16)
+        .lineHeight(23)
+        .fontColor(row.isRenderable() ? '#0F172A' : '#64748B')
+        .maxLines(6)
+        .textOverflow({ overflow: TextOverflow.Ellipsis })
+        .width('100%')
+        .onClick((): void => {
+          this.viewInTimeline(row);
+        })
+
+      if (row.actionsExpanded) {
+        this.ActionMenu(row)
+      }
+
+      if (row.hasError()) {
+        Column({ space: 6 }) {
+          Text(row.errorMessage)
+            .fontSize(13)
+            .fontColor('#B42318')
+            .width('100%')
+          Row({ space: 12 }) {
+            Button('Retry unpin')
+              .fontSize(12)
+              .height(28)
+              .enabled(this.canPinUnpin && !row.busy)
+              .onClick((): void => {
+                this.unpin(row);
+              })
+              .id(`pinned_item_unpin_retry_${row.eventId}`)
+            Button('Dismiss')
+              .fontSize(12)
+              .height(28)
+              .onClick((): void => {
+                this.collection.dismissActionError(row.eventId);
+              })
+              .id(`pinned_item_error_dismiss_${row.eventId}`)
+          }
+        }
+        .alignItems(HorizontalAlign.Start)
+        .padding(10)
+        .width('100%')
+        .backgroundColor('#FEF3F2')
+        .borderRadius(6)
+      }
+    }
+    .alignItems(HorizontalAlign.Start)
+    .padding(14)
+    .margin({ left: 12, right: 12, top: 6, bottom: 6 })
+    .width('100%')
+    .backgroundColor('#FFFFFF')
+    .borderRadius(8)
+    .id(`pinned_item_${row.eventId}`)
+  }
+
+  @Builder
+  ActionMenu(row: PinnedMessageRow) {
+    Column({ space: 6 }) {
+      Button('View in timeline')
+        .width('100%')
+        .height(36)
+        .enabled(!row.busy)
+        .onClick((): void => {
+          this.viewInTimeline(row);
+        })
+        .id(`pinned_item_view_in_timeline_${row.eventId}`)
+      // Pin and unpin are only offered when the room permission allows them.
+      if (this.canPinUnpin) {
+        Button(row.busy ? 'Unpinning' : 'Unpin')
+          .width('100%')
+          .height(36)
+          .enabled(!row.busy)
+          .onClick((): void => {
+            this.unpin(row);
+          })
+          .id(`pinned_item_unpin_${row.eventId}`)
+      }
+      Button('Close')
+        .width('100%')
+        .height(36)
+        .onClick((): void => {
+          this.collection.collapseAllActions();
+        })
+        .id(`pinned_item_actions_close_${row.eventId}`)
+    }
+    .padding(10)
+    .width('100%')
+    .backgroundColor('#F8FAFC')
+    .borderRadius(6)
+  }
+
+  private closePage(): void {
+    try {
+      router.back();
+    } catch (error) {
+      this.navigationError = 'Could not close the pinned messages.';
+    }
+  }
+}
