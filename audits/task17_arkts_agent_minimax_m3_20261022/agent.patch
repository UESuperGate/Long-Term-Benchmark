+import { LocalMatrixRoom } from './LocalMatrixRoom';
+import { MatrixRoomService, PinnedSummary, PinnedSummaryListener, RoomSession, Unsubscribe } from './MatrixRoomServices';
+import { PinnedMessagesBannerPresenter } from './PinnedMessagesBase';
+import { PinnedMessagesList } from './PinnedMessagesList';
+import { RoomTimelineController } from './RoomTimeline';
+
+export type RoomSessionListener = () => void;
+
+/**
+ * Application scoped state of the room screen: the room backend, the room
+ * timeline, the pinned banner projection and the pinned collection. Both the
+ * room screen and the pinned-message screen read from this session, which is why
+ * unpinning an event in the collection is immediately reflected by the banner.
+ */
+export class PinnedMessagesSession {
+  private static instance: PinnedMessagesSession | undefined = undefined;
+
+  private roomService: MatrixRoomService | undefined;
+  private timelineController: RoomTimelineController | undefined;
+  private banner: PinnedMessagesBannerPresenter;
+  private pinnedList: PinnedMessagesList | undefined;
+  private listeners: RoomSessionListener[];
+  private unsubscribeSummary: Unsubscribe | undefined;
+  private pendingFocusEventId: string;
+  private started: boolean;
+
+  static shared(): PinnedMessagesSession {
+    if (PinnedMessagesSession.instance === undefined) {
+      PinnedMessagesSession.instance = new PinnedMessagesSession();
+    }
+    return PinnedMessagesSession.instance;
+  }
+
+  constructor() {
+    this.roomService = RoomSession.createService();
+    this.timelineController = this.roomService === undefined
+      ? undefined : new RoomTimelineController(this.roomService);
+    this.banner = new PinnedMessagesBannerPresenter();
+    this.pinnedList = undefined;
+    this.listeners = [];
+    this.unsubscribeSummary = undefined;
+    this.pendingFocusEventId = '';
+    this.started = false;
+  }
+
+  /** Resolves the room backend once at startup. */
+  start(): void {
+    if (this.started) {
+      return;
+    }
+    this.started = true;
+    this.roomService = RoomSession.createService();
+    this.timelineController = this.roomService === undefined
+      ? undefined : new RoomTimelineController(this.roomService);
+    // The collection is bound to a room, so it is rebuilt when the room changes.
+    this.pinnedList = undefined;
+    if (this.roomService === undefined) {
+      return;
+    }
+    this.roomService.loadPinnedSummary().then((summary: PinnedSummary) => {
+      this.banner.updateFrom(summary.items);
+      this.notify();
+    });
+    const summaryListener: PinnedSummaryListener = (summary: PinnedSummary) => {
+      this.banner.updateFrom(summary.items);
+      this.notify();
+    };
+    this.unsubscribeSummary = this.roomService.subscribePinnedSummary(summaryListener);
+  }
+
+  subscribe(listener: RoomSessionListener): RoomSessionListener {
+    this.listeners.push(listener);
+    return (): void => {
+      const index = this.listeners.indexOf(listener);
+      if (index >= 0) {
+        this.listeners.splice(index, 1);
+      }
+    };
+  }
+
+  isRoomAvailable(): boolean {
+    return this.roomService !== undefined;
+  }
+
+  bannerPresenter(): PinnedMessagesBannerPresenter {
+    return this.banner;
+  }
+
+  timeline(): RoomTimelineController | undefined {
+    return this.timelineController;
+  }
+
+  /** Collection view model of the room, created on first use. */
+  pinnedCollection(): PinnedMessagesList {
+    if (this.pinnedList === undefined) {
+      this.pinnedList = new PinnedMessagesList(this.roomService);
+    }
+    return this.pinnedList;
+  }
+
+  /** Records that the room timeline has to focus an event when it is shown. */
+  requestTimelineFocus(eventId: string): void {
+    this.pendingFocusEventId = eventId;
+  }
+
+  /** Returns and clears the pending focus request. */
+  consumeFocusRequest(): string {
+    const eventId = this.pendingFocusEventId;
+    this.pendingFocusEventId = '';
+    return eventId;
+  }
+
+  private notify(): void {
+    const snapshot = this.listeners.slice();
+    for (const listener of snapshot) {
+      listener();
+    }
+  }
+}
+
+/** Installs the room backend used by the session. */
+export function configureRoomBackend(): void {
+  RoomSession.configureRoom(new LocalMatrixRoom());
+}
