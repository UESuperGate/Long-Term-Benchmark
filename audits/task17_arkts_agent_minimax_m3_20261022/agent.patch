index 0000000000000000000000000000000000000000..6dd0a18efb7213b2288b1a5219f90888ac116d04
--- /dev/null
+++ b/entry/src/main/ets/features/LocalMatrixRoom.ets
@@ -0,0 +1,282 @@
+import {
+  PinnedEventAvailability,
+  PinnedItemsListener,
+  PinnedMessage,
+  PinnedRoomPort,
+  PinnedSummary,
+  PinnedSummaryListener,
+  PinnedTimelinePage,
+  PinnedTimelinePort,
+  RoomSyncListener,
+  Unsubscribe
+} from './MatrixRoomServices';
+
+/** Number of pinned events the relation timeline serves per page. */
+export const PINNED_PAGE_SIZE: number = 2;
+
+/** Number of room timeline events kept around a focused event. */
+const TIMELINE_WINDOW: number = 7;
+
+/**
+ * Room backing store used by the application. It keeps the room timeline and the
+ * pinned relation of the room locally and applies relation changes to that state,
+ * which is what the pinned collection observes: unpinning removes the event from
+ * the pinned relation and every timeline re-syncs from it.
+ */
+export class LocalMatrixRoom implements PinnedRoomPort {
+  roomId: string;
+  private timelineEvents: PinnedMessage[];
+  private pinnedEventIds: string[];
+  private summaryListeners: PinnedSummaryListener[];
+  private syncListeners: RoomSyncListener[];
+
+  constructor(roomId: string = '$design-team:matrix.org') {
+    this.roomId = roomId;
+    this.timelineEvents = createRoomTimeline();
+    this.pinnedEventIds = [
+      '$roadmap',
+      '$incident',
+      '$rules',
+      '$giphy',
+      '$launch',
+      '$welcome'
+    ];
+    this.summaryListeners = [];
+    this.syncListeners = [];
+  }
+
+  pinnedEventsTimeline(): Promise<PinnedTimelinePort> {
+    return Promise.resolve(new LocalPinnedTimeline(this));
+  }
+
+  canPinUnpin(): Promise<boolean> {
+    return Promise.resolve(true);
+  }
+
+  subscribeSync(listener: RoomSyncListener): Unsubscribe {
+    this.syncListeners.push(listener);
+    return (): void => {
+      const index = this.syncListeners.indexOf(listener);
+      if (index >= 0) {
+        this.syncListeners.splice(index, 1);
+      }
+    };
+  }
+
+  loadTimeline(focusedEventId: string | undefined): Promise<PinnedMessage[]> {
+    return Promise.resolve(this.timelineWindow(focusedEventId));
+  }
+
+  loadPinnedSummary(): Promise<PinnedSummary> {
+    return Promise.resolve(this.pinnedSummary());
+  }
+
+  subscribePinnedSummary(listener: PinnedSummaryListener): Unsubscribe {
+    this.summaryListeners.push(listener);
+    return (): void => {
+      const index = this.summaryListeners.indexOf(listener);
+      if (index >= 0) {
+        this.summaryListeners.splice(index, 1);
+      }
+    };
+  }
+
+  /** Pinned events in the order the server returned them. */
+  pinnedEventsSnapshot(): PinnedMessage[] {
+    const pinned: PinnedMessage[] = [];
+    for (const eventId of this.pinnedEventIds) {
+      const event = this.eventById(eventId);
+      if (event !== undefined) {
+        pinned.push(event);
+      }
+    }
+    return pinned;
+  }
+
+  containsEvent(eventId: string): boolean {
+    return this.eventById(eventId) !== undefined;
+  }
+
+  /**
+   * Applies an unpin request to the room state. Returns false when the relation
+   * no longer contains the event, in which case nothing is removed locally.
+   */
+  unpin(eventId: string): boolean {
+    const index = this.pinnedEventIds.indexOf(eventId);
+    if (index < 0) {
+      return false;
+    }
+    this.pinnedEventIds.splice(index, 1);
+    this.notifyRoomUpdated();
+    return true;
+  }
+
+  /** Applies a pin request. The relation only accepts room events. */
+  pinEvent(eventId: string): Promise<boolean> {
+    if (!this.containsEvent(eventId)) {
+      return Promise.resolve(false);
+    }
+    if (this.pinnedEventIds.indexOf(eventId) >= 0) {
+      return Promise.resolve(false);
+    }
+    this.pinnedEventIds.push(eventId);
+    this.notifyRoomUpdated();
+    return Promise.resolve(true);
+  }
+
+  private eventById(eventId: string): PinnedMessage | undefined {
+    for (const event of this.timelineEvents) {
+      if (event.eventId === eventId) {
+        return event;
+      }
+    }
+    return undefined;
+  }
+
+  private pinnedSummary(): PinnedSummary {
+    const items = this.pinnedEventsSnapshot();
+    return new PinnedSummary(items.length, items);
+  }
+
+  private notifyRoomUpdated(): void {
+    const syncSnapshot = this.syncListeners.slice();
+    for (const listener of syncSnapshot) {
+      listener();
+    }
+    const summary = this.pinnedSummary();
+    const summarySnapshot = this.summaryListeners.slice();
+    for (const listener of summarySnapshot) {
+      listener(summary);
+    }
+  }
+
+  private timelineWindow(focusedEventId: string | undefined): PinnedMessage[] {
+    if (focusedEventId === undefined || focusedEventId.length === 0) {
+      return this.timelineEvents.slice();
+    }
+    const index = this.indexOfEvent(focusedEventId);
+    if (index < 0) {
+      return this.timelineEvents.slice();
+    }
+    const start = Math.max(0, index - 1);
+    const end = Math.min(this.timelineEvents.length, start + TIMELINE_WINDOW);
+    return this.timelineEvents.slice(start, end);
+  }
+
+  private indexOfEvent(eventId: string): number {
+    for (let index = 0; index < this.timelineEvents.length; index++) {
+      if (this.timelineEvents[index].eventId === eventId) {
+        return index;
+      }
+    }
+    return -1;
+  }
+}
+
+/**
+ * Paginated view over the pinned relation of a room. It only serves events that
+ * the server currently reports as pinned, so an unpin is reflected by the next
+ * emission instead of by a local guess.
+ */
+class LocalPinnedTimeline implements PinnedTimelinePort {
+  private room: LocalMatrixRoom;
+  private pageSize: number;
+  private loadedEventIds: string[];
+  private listeners: PinnedItemsListener[];
+
+  constructor(room: LocalMatrixRoom, pageSize: number = PINNED_PAGE_SIZE) {
+    this.room = room;
+    this.pageSize = pageSize;
+    this.loadedEventIds = [];
+    this.listeners = [];
+  }
+
+  subscribeItems(listener: PinnedItemsListener): Unsubscribe {
+    this.listeners.push(listener);
+    return (): void => {
+      const index = this.listeners.indexOf(listener);
+      if (index >= 0) {
+        this.listeners.splice(index, 1);
+      }
+    };
+  }
+
+  /**
+   * Serves the next events that were not served yet. Paging walks the current
+   * relation instead of a positional offset, so an event that is unpinned or
+   * added by somebody else while paging cannot make this timeline skip or repeat
+   * an event.
+   */
+  async loadNextPage(): Promise<PinnedTimelinePage> {
+    const pinned = this.room.pinnedEventsSnapshot();
+    const page: PinnedMessage[] = [];
+    let hasMore = false;
+    for (const message of pinned) {
+      if (this.loadedEventIds.indexOf(message.eventId) >= 0) {
+        continue;
+      }
+      if (page.length >= this.pageSize) {
+        hasMore = true;
+        break;
+      }
+      this.loadedEventIds.push(message.eventId);
+      page.push(message);
+    }
+    this.emitItems();
+    return new PinnedTimelinePage(page, hasMore);
+  }
+
+  async unpinEvent(eventId: string): Promise<boolean> {
+    const removed = this.room.unpin(eventId);
+    if (!removed) {
+      return false;
+    }
+    const index = this.loadedEventIds.indexOf(eventId);
+    if (index >= 0) {
+      this.loadedEventIds.splice(index, 1);
+    }
+    this.emitItems();
+    return true;
+  }
+
+  close(): void {
+    this.listeners = [];
+    this.loadedEventIds = [];
+  }
+
+  private emitItems(): void {
+    if (this.listeners.length === 0) {
+      return;
+    }
+    const items: PinnedMessage[] = [];
+    const pinned = this.room.pinnedEventsSnapshot();
+    for (const message of pinned) {
+      if (this.loadedEventIds.indexOf(message.eventId) >= 0) {
+        items.push(message);
+      }
+    }
+    const snapshot = this.listeners.slice();
+    for (const listener of snapshot) {
+      listener(items);
+    }
+  }
+}
+
+function createRoomTimeline(): PinnedMessage[] {
+  const events: PinnedMessage[] = [];
+  events.push(new PinnedMessage(
+    '$welcome', 'Alice', 'Welcome to the room! Say hi when you are around.', 1712000000000));
+  events.push(new PinnedMessage(
+    '$roadmap', 'Alice', 'Q3 roadmap: offline sync, faster search, pinned messages.', 1712000600000));
+  events.push(new PinnedMessage(
+    '$incident', 'Dana', '', 1712001200000, PinnedEventAvailability.Redacted));
+  events.push(new PinnedMessage(
+    '$rules', 'Bob', 'Please read the room rules before posting links.', 1712001800000));
+  events.push(new PinnedMessage(
+    '$giphy', 'Dana', '', 1712002400000, PinnedEventAvailability.Unavailable));
+  events.push(new PinnedMessage(
+    '$launch', 'Bob', 'Release 0.5.3 ships the pinned-message collection.', 1712003000000));
+  events.push(new PinnedMessage(
+    '$lunch', 'Bob', 'Anyone up for lunch at the cafeteria at noon?', 1712003600000));
+  return events;
+}
