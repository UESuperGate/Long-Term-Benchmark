+/**
+ * Builds user facing text for a failed request. Every failure reported by the
+ * Matrix ports has to stay recoverable, so the caller always receives a message
+ * that can be shown next to a retry action.
+ */
+export function describeFailure(error: Error, fallback: string): string {
+  if (error instanceof Error && typeof error.message === 'string' && error.message.length > 0) {
+    return error.message;
+  }
+  return fallback;
+}
