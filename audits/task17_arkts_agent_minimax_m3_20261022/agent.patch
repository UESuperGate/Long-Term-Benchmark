diff --git a/entry/src/main/ets/features/PinnedMessagesList.ets b/entry/src/main/ets/features/PinnedMessagesList.ets
new file mode 100644
index 0000000000000000000000000000000000000000..acf6e0fbabaaecc7f5ba71214e4bd2d263fed396
--- /dev/null
+++ b/entry/src/main/ets/features/PinnedMessagesList.ets
@@ -0,0 +1,406 @@
+import { describeFailure } from './FailureReason';
+import {
+  MatrixRoomService,
+  PinnedEventAvailability,
+  PinnedMessage,
+  PinnedTimelinePage,
+  PinnedTimelinePort,
+  Unsubscribe
+} from './MatrixRoomServices';
+
+/**
+ * The pinned collection distinguishes loading, empty, filled and failed. A failed
+ * load is never rendered as an empty collection: only a successful load that
+ * returned no event may produce the empty state.
+ */
+export enum PinnedListState {
+  Closed = 0,
+  Loading = 1,
+  Empty = 2,
+  Filled = 3,
+  Failed = 4
+}
+
+/**
+ * One rendered row of the collection. Per item action state (open action menu,
+ * running unpin, recoverable failure) lives here and is keyed by event id, so it
+ * survives further pages being appended to the list.
+ */
+@Observed
+export class PinnedMessageRow {
+  eventId: string;
+  sender: string;
+  body: string;
+  availability: PinnedEventAvailability;
+  timeLabel: string;
+  actionsExpanded: boolean;
+  busy: boolean;
+  errorMessage: string;
+
+  constructor(message: PinnedMessage) {
+    this.eventId = message.eventId;
+    this.sender = message.sender;
+    this.body = message.displayBody();
+    this.availability = message.availability;
+    this.timeLabel = message.timestampLabel();
+    this.actionsExpanded = false;
+    this.busy = false;
+    this.errorMessage = '';
+  }
+
+  refreshFrom(message: PinnedMessage): void {
+    this.sender = message.sender;
+    this.body = message.displayBody();
+    this.availability = message.availability;
+    this.timeLabel = message.timestampLabel();
+  }
+
+  isRenderable(): boolean {
+    return this.availability === PinnedEventAvailability.Available;
+  }
+
+  hasError(): boolean {
+    return this.errorMessage.length > 0;
+  }
+}
+
+export type PinnedListListener = () => void;
+
+/** Outcome of an unpin request, so the UI can give the right feedback. */
+export enum PinnedUnpinResult {
+  Confirmed = 0,
+  Rejected = 1,
+  NotPermitted = 2,
+  Busy = 3
+}
+
+/**
+ * View model of the pinned-message collection of a room.
+ *
+ * It opens a scoped pinned-event timeline, mirrors the events the timeline
+ * reports, paginates without duplicating events, gates the pin/unpin actions on
+ * the room permission and only removes an item once the underlying state update
+ * confirmed the unpin.
+ */
+export class PinnedMessagesList {
+  private room: MatrixRoomService | undefined;
+  private timeline: PinnedTimelinePort | undefined;
+  private unsubscribeItems: Unsubscribe | undefined;
+  private unsubscribeSync: Unsubscribe | undefined;
+  private listeners: PinnedListListener[];
+  private rows: PinnedMessageRow[];
+
+  state: PinnedListState;
+  canPinUnpin: boolean;
+  hasMore: boolean;
+  loadingMore: boolean;
+  failureMessage: string;
+  paginationErrorMessage: string;
+
+  constructor(room: MatrixRoomService | undefined) {
+    this.room = room;
+    this.timeline = undefined;
+    this.unsubscribeItems = undefined;
+    this.unsubscribeSync = undefined;
+    this.listeners = [];
+    this.rows = [];
+    this.state = PinnedListState.Closed;
+    this.canPinUnpin = false;
+    this.hasMore = false;
+    this.loadingMore = false;
+    this.failureMessage = '';
+    this.paginationErrorMessage = '';
+  }
+
+  subscribe(listener: PinnedListListener): Unsubscribe {
+    this.listeners.push(listener);
+    return (): void => {
+      const index = this.listeners.indexOf(listener);
+      if (index >= 0) {
+        this.listeners.splice(index, 1);
+      }
+    };
+  }
+
+  /** Rows currently rendered, in server order. */
+  items(): PinnedMessageRow[] {
+    return this.rows;
+  }
+
+  /** Opens the collection and loads its first page of pinned events. */
+  async open(): Promise<void> {
+    this.releaseTimeline();
+    this.state = PinnedListState.Loading;
+    this.failureMessage = '';
+    this.paginationErrorMessage = '';
+    this.loadingMore = false;
+    this.hasMore = false;
+    this.notify();
+
+    const room = this.room;
+    if (room === undefined) {
+      this.failCollection('This room is not available any more.');
+      return;
+    }
+
+    try {
+      const timeline = await room.pinnedEventsTimeline();
+      this.timeline = timeline;
+      this.unsubscribeItems = timeline.subscribeItems((items: PinnedMessage[]): void => {
+        this.onTimelineItems(items);
+      });
+      this.unsubscribeSync = room.subscribeSync((): void => {
+        this.refreshPermission();
+      });
+      await this.refreshPermission();
+      const page: PinnedTimelinePage = await timeline.loadNextPage();
+      this.hasMore = page.hasMore;
+      this.resolveLoadedState();
+    } catch (error) {
+      this.failCollection(describeFailure(error, 'The pinned messages could not be loaded.'));
+    }
+  }
+
+  /** Releases the collection when the page is closed; it can be opened again. */
+  close(): void {
+    this.releaseTimeline();
+    this.collapseAllActions();
+    this.rows = [];
+    this.canPinUnpin = false;
+    this.hasMore = false;
+    this.loadingMore = false;
+    this.state = PinnedListState.Closed;
+    this.notify();
+  }
+
+  /** Recovers from a failed load, or retries a failed page. */
+  async retry(): Promise<void> {
+    if (this.state === PinnedListState.Failed) {
+      await this.open();
+      return;
+    }
+    this.paginationErrorMessage = '';
+    await this.loadMore();
+  }
+
+  /** Loads the next page of the pinned timeline. */
+  async loadMore(): Promise<void> {
+    const timeline = this.timeline;
+    if (timeline === undefined || this.loadingMore || !this.hasMore) {
+      return;
+    }
+    if (this.state !== PinnedListState.Filled) {
+      return;
+    }
+    this.loadingMore = true;
+    this.paginationErrorMessage = '';
+    this.notify();
+    try {
+      const page: PinnedTimelinePage = await timeline.loadNextPage();
+      this.appendPage(page.items);
+      this.hasMore = page.hasMore;
+      this.resolveLoadedState();
+    } catch (error) {
+      this.paginationErrorMessage =
+        describeFailure(error, 'More pinned messages could not be loaded.');
+    }
+    this.loadingMore = false;
+    this.notify();
+  }
