+   * Opens or closes the action menu of an item. This is a presentation concern
+   * only: the pinned collection itself is left untouched.
+   */
+  toggleActions(eventId: string): void {
+    const row = this.findRow(eventId);
+    if (row === undefined) {
+      return;
+    }
+    const expanded = !row.actionsExpanded;
+    this.collapseAllActions();
+    row.actionsExpanded = expanded;
+    this.notify();
+  }
+
+  collapseAllActions(): void {
+    let changed = false;
+    for (const row of this.rows) {
+      if (row.actionsExpanded) {
+        row.actionsExpanded = false;
+        changed = true;
+      }
+    }
+    if (changed) {
+      this.notify();
+    }
+  }
+
+  /**
+   * Removes a pinned event. Nothing is removed optimistically: the item is only
+   * dropped once the timeline confirmed the unpin, a failure keeps the item in
+   * place with a recoverable message.
+   */
+  async unpin(eventId: string): Promise<PinnedUnpinResult> {
+    const timeline = this.timeline;
+    if (timeline === undefined) {
+      return PinnedUnpinResult.Rejected;
+    }
+    // The room permission is authoritative: without it no request is even sent.
+    if (!this.canPinUnpin) {
+      return PinnedUnpinResult.NotPermitted;
+    }
+    const row = this.findRow(eventId);
+    if (row === undefined) {
+      return PinnedUnpinResult.Rejected;
+    }
+    if (row.busy) {
+      return PinnedUnpinResult.Busy;
+    }
+    row.busy = true;
+    row.errorMessage = '';
+    this.notify();
+
+    let confirmed = false;
+    try {
+      confirmed = await timeline.unpinEvent(eventId);
+    } catch (error) {
+      confirmed = false;
+    }
+    row.busy = false;
+
+    if (!confirmed) {
+      row.errorMessage = 'Could not unpin this message. It is still pinned.';
+      this.notify();
+      return PinnedUnpinResult.Rejected;
+    }
+    // Normally the timeline emission already dropped the event; this keeps the
+    // list correct for ports that only report the relation lazily.
+    this.removeRow(eventId);
+    this.resolveLoadedState();
+    this.notify();
+    return PinnedUnpinResult.Confirmed;
+  }
+
+  dismissActionError(eventId: string): void {
+    const row = this.findRow(eventId);
+    if (row === undefined || row.errorMessage.length === 0) {
+      return;
+    }
+    row.errorMessage = '';
+    this.notify();
+  }
+
+  private async refreshPermission(): Promise<void> {
+    const room = this.room;
+    if (room === undefined) {
+      return;
+    }
+    try {
+      const allowed = await room.canPinUnpin();
+      if (allowed !== this.canPinUnpin) {
+        this.canPinUnpin = allowed;
+        this.notify();
+      }
+    } catch (error) {
+      // Keep the last known permission: the server stays authoritative and the
+      // actions simply stay disabled until a later sync resolves it.
+    }
+  }
+
+  private onTimelineItems(items: PinnedMessage[]): void {
+    this.rows = this.mergeItems(items);
+    if (this.state === PinnedListState.Empty || this.state === PinnedListState.Filled) {
+      this.resolveLoadedState();
+    }
+    this.notify();
+  }
+
+  private mergeItems(items: PinnedMessage[]): PinnedMessageRow[] {
+    const merged: PinnedMessageRow[] = [];
+    const seen: string[] = [];
+    for (const item of items) {
+      if (seen.indexOf(item.eventId) >= 0) {
+        continue;
+      }
+      seen.push(item.eventId);
+      const existing = this.findRow(item.eventId);
+      if (existing === undefined) {
+        merged.push(new PinnedMessageRow(item));
+      } else {
+        existing.refreshFrom(item);
+        merged.push(existing);
+      }
+    }
+    return merged;
+  }
+
+  private appendPage(items: PinnedMessage[]): void {
+    const appended: PinnedMessageRow[] = this.rows.slice();
+    const seen: string[] = [];
+    for (const row of this.rows) {
+      seen.push(row.eventId);
+    }
+    for (const item of items) {
+      if (seen.indexOf(item.eventId) >= 0) {
+        continue;
+      }
+      seen.push(item.eventId);
+      appended.push(new PinnedMessageRow(item));
+    }
+    this.rows = appended;
+  }
+
+  private removeRow(eventId: string): void {
+    const remaining: PinnedMessageRow[] = [];
+    for (const row of this.rows) {
+      if (row.eventId !== eventId) {
+        remaining.push(row);
+      }
+    }
+    this.rows = remaining;
+  }
+
+  private findRow(eventId: string): PinnedMessageRow | undefined {
+    for (const row of this.rows) {
+      if (row.eventId === eventId) {
+        return row;
+      }
+    }
+    return undefined;
+  }
+
+  private resolveLoadedState(): void {
+    this.state = this.rows.length === 0 ? PinnedListState.Empty : PinnedListState.Filled;
+  }
+
+  private failCollection(message: string): void {
+    this.state = PinnedListState.Failed;
+    this.failureMessage = message;
+    this.rows = [];
+    this.hasMore = false;
+    this.notify();
+  }
+
+  private releaseTimeline(): void {
+    if (this.unsubscribeItems !== undefined) {
+      this.unsubscribeItems();
+      this.unsubscribeItems = undefined;
+    }
+    if (this.unsubscribeSync !== undefined) {
+      this.unsubscribeSync();
+      this.unsubscribeSync = undefined;
+    }
+    if (this.timeline !== undefined) {
+      this.timeline.close();
+      this.timeline = undefined;
+    }
+  }
+
+  private notify(): void {
+    const snapshot = this.listeners.slice();
+    for (const listener of snapshot) {
+      listener();
+    }
+  }
+}
