@@ -0,0 +1,199 @@
+import { describeFailure } from './FailureReason';
+import { MatrixRoomService, PinnedMessage } from './MatrixRoomServices';
+
+export enum FocusOutcome {
+  Focused = 0,
+  NotInTimeline = 1,
+  Failed = 2
+}
+
+/** Outcome of a pin request made from the room timeline. */
+export enum PinOutcome {
+  Pinned = 0,
+  Rejected = 1,
+  NotPermitted = 2
+}
+
+export type RoomTimelineListener = () => void;
+
+/**
+ * View model of the room timeline.
+ *
+ * It loads a window of the room timeline, optionally around a given event, and
+ * keeps the focused event highlighted. Focusing is best effort: when the event
+ * cannot be retrieved the timeline stays usable and reports why.
+ */
+export class RoomTimelineController {
+  private room: MatrixRoomService;
+  private listeners: RoomTimelineListener[];
+  private timelineEvents: PinnedMessage[];
+  private focusedEventId: string;
+  private statusMessage: string;
+  private loading: boolean;
+  private pinAllowed: boolean;
+  private pinningEventId: string;
+
+  constructor(room: MatrixRoomService) {
+    this.room = room;
+    this.listeners = [];
+    this.timelineEvents = [];
+    this.focusedEventId = '';
+    this.statusMessage = '';
+    this.loading = false;
+    this.pinAllowed = false;
+    this.pinningEventId = '';
+  }
+
+  subscribe(listener: RoomTimelineListener): RoomTimelineListener {
+    this.listeners.push(listener);
+    return (): void => {
+      const index = this.listeners.indexOf(listener);
+      if (index >= 0) {
+        this.listeners.splice(index, 1);
+      }
+    };
+  }
+
+  items(): PinnedMessage[] {
+    return this.timelineEvents;
+  }
+
+  isLoading(): boolean {
+    return this.loading;
+  }
+
+  status(): string {
+    return this.statusMessage;
+  }
+
+  hasStatus(): boolean {
+    return this.statusMessage.length > 0;
+  }
+
+  /** Whether the current power level allows pin/unpin requests. */
+  canPinUnpin(): boolean {
+    return this.pinAllowed;
+  }
+
+  isPinning(eventId: string): boolean {
+    return this.pinningEventId.length > 0 && this.pinningEventId === eventId;
+  }
+
+  /**
+   * Pins an event of the room. Pin actions are only offered when the permission
+   * allows them, and a rejected request leaves the room state untouched.
+   */
+  async pin(eventId: string): Promise<PinOutcome> {
+    if (!this.pinAllowed) {
+      return PinOutcome.NotPermitted;
+    }
+    if (this.pinningEventId.length > 0) {
+      return PinOutcome.Rejected;
+    }
+    this.pinningEventId = eventId;
+    this.notify();
+    let pinned = false;
+    try {
+      pinned = await this.room.pinEvent(eventId);
+    } catch (error) {
+      pinned = false;
+    }
+    this.pinningEventId = '';
+    if (pinned) {
+      this.statusMessage = '';
+    } else {
+      this.statusMessage = 'This message could not be pinned.';
+    }
+    this.notify();
+    return pinned ? PinOutcome.Pinned : PinOutcome.Rejected;
+  }
+
+  private async loadPermission(): Promise<void> {
+    try {
+      const allowed = await this.room.canPinUnpin();
+      if (allowed !== this.pinAllowed) {
+        this.pinAllowed = allowed;
+        this.notify();
+      }
+    } catch (error) {
+      // Keep the last known permission: the room power level stays authoritative.
+    }
+  }
+
+  focusedEventIdValue(): string {
+    return this.focusedEventId;
+  }
+
+  isFocused(eventId: string): boolean {
+    return this.focusedEventId.length > 0 && this.focusedEventId === eventId;
+  }
+
+  focusedIndex(): number {
+    if (this.focusedEventId.length === 0) {
+      return -1;
+    }
+    return this.indexOfEvent(this.focusedEventId);
+  }
+
+  /** Loads the timeline, optionally around a specific event. */
+  async load(focusedEventId: string | undefined): Promise<FocusOutcome> {
+    const target = focusedEventId === undefined ? '' : focusedEventId;
+    this.loading = true;
+    this.notify();
+    await this.loadPermission();
+    try {
+      this.timelineEvents = await this.room.loadTimeline(target);
+      this.focusedEventId = '';
+      this.statusMessage = '';
+      if (target.length > 0) {
+        if (this.indexOfEvent(target) >= 0) {
+          this.focusedEventId = target;
+        } else {
+          this.statusMessage = 'That message is no longer available in this room.';
+        }
+      }
+    } catch (error) {
+      this.focusedEventId = '';
+      this.statusMessage = describeFailure(error, 'The room timeline could not be loaded.');
+      this.loading = false;
+      this.notify();
+      return FocusOutcome.Failed;
+    }
+    this.loading = false;
+    this.notify();
+    if (target.length === 0) {
+      return FocusOutcome.Focused;
+    }
+    return this.focusedIndex() >= 0 ? FocusOutcome.Focused : FocusOutcome.NotInTimeline;
+  }
+
+  private indexOfEvent(eventId: string): number {
+    for (let index = 0; index < this.timelineEvents.length; index++) {
+      if (this.timelineEvents[index].eventId === eventId) {
+        return index;
+      }
+    }
+    return -1;
+  }
+
+  /** Jumps to a pinned event inside the room timeline. */
+  async focusEvent(eventId: string): Promise<FocusOutcome> {
+    return this.load(eventId);
+  }
+
+  clearFocus(): void {
+    if (this.focusedEventId.length === 0 && this.statusMessage.length === 0) {
+      return;
+    }
+    this.focusedEventId = '';
+    this.statusMessage = '';
+    this.notify();
+  }
+
+  private notify(): void {
+    const snapshot = this.listeners.slice();
+    for (const listener of snapshot) {
+      listener();
+    }
+  }
+}
