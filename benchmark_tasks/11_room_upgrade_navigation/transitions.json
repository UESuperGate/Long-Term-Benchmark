      "caseId": "ru_state_002_tombstone_is_read_only",
      "key": "tombstone_is_read_only",
      "functionalArea": "tombstone_state",
      "given": {
        "roomId": "!old:example.org",
        "history": [
          "Earlier message"
        ],
        "successorRoomId": "!new:example.org",
        "composerEnabled": true
      },
      "event": {
        "name": "render_messages"
      },
      "expected": {
        "history": [
          "Earlier message"
        ],
        "composerVisible": false,
        "successorBannerVisible": true
      },
      "invariants": [
        "existing room history remains visible"
      ],
      "evidence": {
        "androidProduction": [
          "features/messages/impl/src/main/kotlin/io/element/android/features/messages/impl/MessagesView.kt"
        ]
      },
