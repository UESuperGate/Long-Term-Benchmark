{
  "taskId": "16_identity_reset",
  "description": "Shared Android/ArkTS semantics for confirmed cryptographic identity reset with password or OIDC reauthentication",
  "cases": [
    {
      "caseId": "ir_state_001_continue_requests_confirmation",
      "key": "continue_requests_confirmation",
      "functionalArea": "confirmation",
      "given": {"confirmationVisible": false, "handleState": "uninitialized"},
      "event": {"name": "continue"},
      "expected": {"confirmationVisible": true, "startResetCount": 0},
      "invariants": ["identity reset cannot start without destructive confirmation"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/root/ResetIdentityRootPresenter.kt", "features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/root/ResetIdentityRootView.kt"]}
    },
    {
      "caseId": "ir_state_002_dismiss_confirmation",
      "key": "dismiss_confirmation",
      "functionalArea": "confirmation",
      "given": {"confirmationVisible": true, "handleState": "uninitialized"},
      "event": {"name": "dismiss_confirmation"},
      "expected": {"confirmationVisible": false, "startResetCount": 0},
      "invariants": ["dismissal has no SDK side effect"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/root/ResetIdentityRootPresenter.kt"]}
    },
    {
      "caseId": "ir_state_003_confirm_starts_handle",
      "key": "confirm_starts_handle",
      "functionalArea": "sdk_reset_handle",
      "given": {"confirmationVisible": true, "handleState": "uninitialized"},
      "event": {"name": "confirm_reset"},
      "expected": {"confirmationVisible": false, "handleState": "loading", "effect": "start_identity_reset"},
      "invariants": ["concurrent calls reuse a loading or successful handle"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowManager.kt", "features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowNode.kt"]}
    },
    {
      "caseId": "ir_state_004_password_handle_routes",
      "key": "password_handle_routes",
      "functionalArea": "password_reauthentication",
      "given": {"handleState": "loading", "authenticationType": "password"},
      "event": {"name": "handle_loaded"},
      "expected": {"handleState": "success", "screen": "reset_password", "password": ""},
      "invariants": ["the password reset screen receives the same SDK handle"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowNode.kt"]}
    },
    {
      "caseId": "ir_state_005_oidc_handle_routes_and_resets",
      "key": "oidc_handle_routes_and_resets",
      "functionalArea": "sdk_reset_handle",
      "given": {"handleState": "loading", "authenticationType": "oidc", "approvalUrl": "https://id.example/reset"},
      "event": {"name": "handle_loaded"},
      "expected": {"handleState": "success", "effect": "open_oidc_approval", "url": "https://id.example/reset", "pollEffect": "reset_oidc"},
      "invariants": ["fallback webview is used when a custom tab is unavailable"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowNode.kt", "libraries/matrix/impl/src/main/kotlin/io/element/android/libraries/matrix/impl/encryption/RustIdentityResetHandle.kt"]}
    },
    {
      "caseId": "ir_state_006_handle_failure_recovers",
      "key": "handle_failure_recovers",
      "functionalArea": "failure_and_cancel",
      "given": {"handleState": "loading"},
      "event": {"name": "start_identity_reset_returns_null_or_error"},
      "expected": {"handleState": "failure", "progressVisible": false, "screen": "reset_root", "retryEnabled": true},
      "invariants": ["a missing handle is treated as failure rather than success"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowManager.kt", "features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowNode.kt"]}
    },
    {
      "caseId": "ir_state_007_password_submit_calls_handle",
      "key": "password_submit_calls_handle",
      "functionalArea": "password_reauthentication",
      "given": {"screen": "reset_password", "password": "secret", "resetAction": "uninitialized"},
      "event": {"name": "submit_password"},
      "expected": {"resetAction": "loading", "effect": "reset_password", "password": "secret", "progressVisible": true},
      "invariants": ["empty passwords cannot be submitted"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/password/ResetIdentityPasswordPresenter.kt", "features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/password/ResetIdentityPasswordView.kt"]}
    },
    {
      "caseId": "ir_state_008_password_failure_clears_on_edit",
      "key": "password_failure_clears_on_edit",
      "functionalArea": "failure_and_cancel",
      "given": {"screen": "reset_password", "password": "wrong", "resetAction": "loading"},
      "event": {"name": "reset_password_fails_then_password_changes", "value": "correct"},
      "expected": {"resetAction": "uninitialized", "password": "correct", "errorVisible": false, "retryEnabled": true},
      "invariants": ["a failed attempt does not destroy the reset handle"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/password/ResetIdentityPasswordPresenter.kt", "features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/password/ResetIdentityPasswordView.kt"]}
    },
    {
      "caseId": "ir_state_009_success_waits_for_verification",
      "key": "success_waits_for_verification",
      "functionalArea": "success_routing",
      "given": {"resetAction": "loading", "sessionVerificationStatus": "not_verified"},
      "event": {"name": "reset_succeeds_then_session_verified"},
      "expected": {"resetAction": "success", "progressVisibleUntilVerified": true, "completionCount": 1},
      "invariants": ["completion is emitted only after verified status"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowManager.kt", "features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/password/ResetIdentityPasswordView.kt"]}
    },
    {
      "caseId": "ir_state_010_cancel_cleans_up",
      "key": "cancel_cleans_up",
      "functionalArea": "failure_and_cancel",
      "given": {"handleState": "success", "resetJobActive": true, "completionWatcherActive": true},
      "event": {"name": "cancel_or_destroy"},
      "expected": {"effect": "cancel_reset_handle", "handleState": "uninitialized", "resetJobActive": false, "completionWatcherActive": false},
      "invariants": ["OIDC return and node destruction use the same cleanup path"],
      "evidence": {"androidProduction": ["features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowManager.kt", "features/securebackup/impl/src/main/kotlin/io/element/android/features/securebackup/impl/reset/ResetIdentityFlowNode.kt", "libraries/matrix/impl/src/main/kotlin/io/element/android/libraries/matrix/impl/encryption/RustIdentityResetHandle.kt"]}
    }
  ]
}
