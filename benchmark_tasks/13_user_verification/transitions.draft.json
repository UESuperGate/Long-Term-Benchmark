      "given": {"profileUserId": "@alice:example.org", "isCurrentUser": false, "verificationAvailable": true},
      "event": {"name": "verify_user_from_profile"},
      "expected": {"route": "verify_user", "request": {"type": "user", "userId": "@alice:example.org"}},
      "invariants": ["self-session verification remains a distinct request type"],
      "evidence": {"androidProduction": ["features/userprofile/impl/src/main/kotlin/io/element/android/features/userprofile/impl/UserProfileFlowNode.kt"]}
    },
    {
      "caseId": "uv_state_002_request_targets_user",
