      "event": {"name": "start_sas_verification"},
      "expected": {"step": "awaiting_other_device_response", "effect": "start_verification", "startCalls": 1},
      "invariants": ["the target user request remains active"],
      "evidence": {"androidProduction": ["features/verifysession/impl/src/main/kotlin/io/element/android/features/verifysession/impl/outgoing/VerifySelfSessionStateMachine.kt"]}
    },
    {
