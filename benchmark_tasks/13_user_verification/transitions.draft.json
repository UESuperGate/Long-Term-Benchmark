      "functionalArea": "verification_request",
      "given": {"step": "initial", "request": {"type": "user", "userId": "@alice:example.org"}},
      "event": {"name": "request_verification"},
      "expected": {"step": "awaiting_other_device_response", "effect": "request_user_verification", "userId": "@alice:example.org", "requestCalls": 1},
      "invariants": ["current-session verification is not requested"],
      "evidence": {"androidProduction": ["features/verifysession/impl/src/main/kotlin/io/element/android/features/verifysession/impl/outgoing/VerifySelfSessionStateMachine.kt"]}
    },
    {
