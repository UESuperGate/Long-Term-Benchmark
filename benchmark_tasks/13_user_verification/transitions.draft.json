      "key": "failure_reset",
      "functionalArea": "cancel_failure",
      "given": {"step": "canceled", "failure": "sdk_failure", "identityState": "verification_violation"},
      "event": {"name": "reset"},
      "expected": {"step": "initial", "effect": "reset_verification", "cancelPending": false, "identityState": "verification_violation"},
      "invariants": ["reset creates no false success"],
      "evidence": {"androidProduction": ["features/verifysession/impl/src/main/kotlin/io/element/android/features/verifysession/impl/outgoing/VerifySelfSessionStateMachine.kt"]}
