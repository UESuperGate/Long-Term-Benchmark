      "event": {"name": "accept_challenge"},
      "expected": {"step": "verifying", "replyState": "loading", "effect": "approve_verification", "approveCalls": 1},
      "invariants": ["the SAS challenge is unchanged"],
      "evidence": {"androidProduction": ["features/verifysession/impl/src/main/kotlin/io/element/android/features/verifysession/impl/outgoing/VerifySelfSessionStateMachine.kt"]}
    },
    {
