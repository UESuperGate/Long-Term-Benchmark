      "event": {"name": "receive_challenge"},
      "expected": {"step": "verifying", "sas": ["Dog", "Tree", "Rocket"], "replyState": "uninitialized"},
      "invariants": ["the challenge data is preserved until a response is sent"],
      "evidence": {"androidProduction": ["features/verifysession/impl/src/main/kotlin/io/element/android/features/verifysession/impl/outgoing/VerifySelfSessionStateMachine.kt"]}
