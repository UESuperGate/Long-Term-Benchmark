{
  "schemaVersion": 1,
  "taskId": "06_multi_select_polls",
  "owner": "evaluator",
  "description": "Shared Android/ArkTS semantics for creating, editing and voting in multi-select polls",
  "cases": [
    {
      "caseId": "mp_state_001_default_limit",
      "key": "default_limit",
      "functionalArea": "poll_creation",
      "given": {
        "mode": "new",
        "answers": [
          "A",
          "B"
        ]
      },
      "event": {
        "name": "open_editor"
      },
      "expected": {
        "maxSelections": 1,
        "maxAllowedSelections": 2,
        "limitControlVisible": true
      },
      "invariants": [
        "question and answers remain editable"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "cd82142084e6d5336cf6749e7850b1261fffe219c4cdbaa69a2b4599167708f1"
    },
    {
      "caseId": "mp_state_002_set_limit",
      "key": "set_limit",
      "functionalArea": "poll_creation",
      "given": {
        "mode": "new",
        "answers": [
          "A",
          "B",
          "C"
        ],
        "maxSelections": 1
      },
      "event": {
        "name": "set_max_selections",
        "value": 2
      },
      "expected": {
        "maxSelections": 2,
        "maxAllowedSelections": 3
      },
      "invariants": [
        "answers are unchanged"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "9ef258563e549f0928f018092fabdaa04539330df9d8f925c17bd9a854c57506"
    },
    {
      "caseId": "mp_state_003_remove_clamps_limit",
      "key": "remove_clamps_limit",
      "functionalArea": "poll_creation",
      "given": {
        "answers": [
          "A",
          "B",
          "C"
        ],
        "maxSelections": 3
      },
      "event": {
        "name": "remove_answer",
        "index": 2
      },
      "expected": {
        "answers": [
          "A",
          "B"
        ],
        "maxSelections": 2,
        "maxAllowedSelections": 2
      },
      "invariants": [
        "maxSelections is at least one"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "29aec315cf5771def663aa9f45595012e48749dd21c37f99eb23d3226827d102"
    },
    {
      "caseId": "mp_state_004_edit_restores_limit",
      "key": "edit_restores_limit",
      "functionalArea": "poll_editing",
      "given": {
        "storedPoll": {
          "answers": [
            "A",
            "B",
            "C"
          ],
          "maxSelections": 2
        }
      },
      "event": {
        "name": "open_editor",
        "mode": "edit"
      },
      "expected": {
        "answers": [
          "A",
          "B",
          "C"
        ],
        "maxSelections": 2
      },
      "invariants": [
        "stored question and poll kind are restored"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "3807ba7f53ed5ca0b149d4870427b14db2676bf81927ca563aaa6737b022d904"
    },
    {
      "caseId": "mp_state_005_save_sends_limit",
      "key": "save_sends_limit",
      "functionalArea": "submission",
      "given": {
        "question": "Lunch?",
        "answers": [
          "A",
          "B",
          "C"
        ],
        "maxSelections": 2,
        "valid": true
      },
      "event": {
        "name": "save_poll"
      },
      "expected": {
        "effect": "create_or_edit_poll",
        "payload": {
          "answers": [
            "A",
            "B",
            "C"
          ],
          "maxSelections": 2
        }
      },
      "invariants": [
        "analytics is emitted only after success"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "e66c68fef0d2194966c62b63a138dff8773dc92691897b9c3790cb02dd5795cc"
    },
    {
      "caseId": "mp_state_006_submit_multiple_answers",
      "key": "submit_multiple_answers",
      "functionalArea": "vote_selection",
      "given": {
        "poll": {
          "answerIds": [
            "a",
            "b",
            "c"
          ],
          "maxSelections": 2
        },
        "selected": [
          "a",
          "b"
        ]
      },
      "event": {
        "name": "submit_vote"
      },
      "expected": {
        "effect": "send_poll_response",
        "answerIds": [
          "a",
          "b"
        ]
      },
      "invariants": [
        "answer order is preserved"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "9b615c5769611aa4f9a36e770a736f430272eb85816014846c8194b53bd0d634"
    },
    {
      "caseId": "mp_state_007_limit_disables_unselected",
      "key": "limit_disables_unselected",
      "functionalArea": "vote_selection",
      "given": {
        "answerIds": [
          "a",
          "b",
          "c"
        ],
        "selected": [
          "a",
          "b"
        ],
        "maxSelections": 2,
        "ended": false
      },
      "event": {
        "name": "render_poll"
      },
      "expected": {
        "enabled": [
          "a",
          "b"
        ],
        "disabled": [
          "c"
        ]
      },
      "invariants": [
        "selected answers remain enabled so they can be deselected"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "962d789261469c056cae838f37ff2c2d24f8492324f89e2437a7b6919a64dabf"
    },
    {
      "caseId": "mp_state_008_deselect_reopens_choices",
      "key": "deselect_reopens_choices",
      "functionalArea": "vote_selection",
      "given": {
        "answerIds": [
          "a",
          "b",
          "c"
        ],
        "selected": [
          "a",
          "b"
        ],
        "maxSelections": 2
      },
      "event": {
        "name": "toggle_answer",
        "answerId": "a"
      },
      "expected": {
        "selected": [
          "b"
        ],
        "enabled": [
          "a",
          "b",
          "c"
        ]
      },
      "invariants": [
        "selection count never exceeds maxSelections"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "f08d90badecfe17682fbfc180382d5fe34ef273c16ca92e4f6d4f98b70638e9a"
    },
    {
      "caseId": "mp_state_009_failure_keeps_selection",
      "key": "failure_keeps_selection",
      "functionalArea": "failure_recovery",
      "given": {
        "selected": [
          "a",
          "b"
        ],
        "submission": "loading"
      },
      "event": {
        "name": "send_poll_response_failed"
      },
      "expected": {
        "selected": [
          "a",
          "b"
        ],
        "submission": "failure",
        "retryEnabled": true
      },
      "invariants": [
        "no success analytics is emitted"
      ],
      "taskId": "06_multi_select_polls",
      "traceDigest": "f4526d8f0be9641ef10164f478eb5c3bf315571f8e0022f1ef9a3f8958d826a4"
    }
  ]
}
