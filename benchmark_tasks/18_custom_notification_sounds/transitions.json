    {
      "caseId": "ns_state_004_message_custom_copy",
      "key": "message_custom_copy",
      "functionalArea": "sound_copy",
      "given": {
        "messageSound": "system_default",
        "pickedUri": "content://media/message/42",
        "displayName": "Message Tone"
      },
      "event": {
        "name": "set_message_sound_from_picker"
      },
      "expected": {
        "messageSound": "app_owned_custom_uri",
        "messageDisplayName": "Message Tone",
        "messageChannelVersion": 1,
        "effects": [
          "copy_to_app_storage",
          "persist_message_sound",
          "recreate_message_channel"
        ]
      },
      "invariants": [
        "the transient provider URI is not persisted as the effective sound"
      ],
      "evidence": {
        "androidTests": [
          "features/preferences/impl/src/test/kotlin/io/element/android/features/preferences/impl/notifications/NotificationSettingsPresenterTest.kt",
