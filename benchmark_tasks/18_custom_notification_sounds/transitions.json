{
  "schemaVersion": 1,
  "taskId": "18_custom_notification_sounds",
  "owner": "evaluator",
  "description": "Shared Android/ArkTS semantics for independent persistent message sounds and call ringtones",
  "cases": [
    {
      "caseId": "ns_state_001_restore_independent_slots",
      "key": "restore_independent_slots",
      "functionalArea": "preference_persistence",
      "given": {
        "persistedMessageSound": "element_default",
        "persistedCallRingtone": "silent"
      },
      "event": {
        "name": "open_notification_settings"
      },
      "expected": {
        "messageSound": "element_default",
        "callRingtone": "silent",
        "labelsResolved": true
      },
      "invariants": [
        "message and call slots are loaded independently"
      ],
      "evidence": {
        "androidProduction": [
          "features/preferences/impl/src/main/kotlin/io/element/android/features/preferences/impl/notifications/NotificationSettingsPresenter.kt",
          "libraries/preferences/api/src/main/kotlin/io/element/android/libraries/preferences/api/store/NotificationSound.kt"
        ]
      },
      "taskId": "18_custom_notification_sounds",
      "traceDigest": "5ff3dfde4cfb7fddd6606d3481445c5733d8a41686055a1ad834e732e90741bb"
    },
    {
      "caseId": "ns_state_002_message_preset",
      "key": "message_preset",
      "functionalArea": "preset_dialog",
      "given": {
        "messageSound": "system_default",
        "callRingtone": "silent",
        "messageDialog": "open"
      },
      "event": {
        "name": "select_message_preset",
        "value": "element_default"
      },
      "expected": {
        "messageSound": "element_default",
        "callRingtone": "silent",
        "messageDialog": "closed",
        "messageChannelVersion": 1,
        "effects": [
          "persist_message_sound",
          "recreate_message_channel"
        ]
      },
      "invariants": [
        "changing the message sound does not change the call ringtone"
      ],
      "evidence": {
        "androidTests": [
          "features/preferences/impl/src/test/kotlin/io/element/android/features/preferences/impl/notifications/NotificationSettingsPresenterTest.kt"
        ]
      },
      "taskId": "18_custom_notification_sounds",
      "traceDigest": "5ebc94fafef6837216e2f85bf2038e72f1d8c20489d2d4222e1356db4b1a2f90"
