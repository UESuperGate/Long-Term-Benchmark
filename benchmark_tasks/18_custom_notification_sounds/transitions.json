    {
      "caseId": "ns_state_009_latest_pick_wins",
      "key": "latest_pick_wins",
      "functionalArea": "channel_recreation",
      "given": {
        "messageSound": "system_default",
        "messageChannelVersion": 0
      },
      "event": {
        "name": "set_message_sounds_rapidly",
        "values": [
          "content://A",
          "content://B"
        ]
      },
      "expected": {
        "messageSound": "app_owned_custom_uri_for_B",
        "messageChannelVersion": 2,
        "copyOrder": [
          "content://A",
          "content://B"
        ],
        "recreateOrder": [
          1,
          2
        ]
      },
      "invariants": [
        "per-slot updates are serialized and a late completion cannot restore an older pick"
      ],
      "evidence": {
        "androidTests": [
          "features/preferences/impl/src/test/kotlin/io/element/android/features/preferences/impl/notifications/NotificationSettingsPresenterTest.kt"
        ]
      },
      "taskId": "18_custom_notification_sounds",
