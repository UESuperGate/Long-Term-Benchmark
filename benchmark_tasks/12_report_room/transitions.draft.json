{
  "taskId": "12_report_room",
  "description": "Shared Android/ArkTS semantics for reporting a room with optional leave and partial-failure recovery",
  "cases": [
    {
      "caseId": "rr_state_001_initial_form",
      "key": "initial_form",
      "functionalArea": "report_form",
      "given": {"roomId": "!room:example.org"},
      "event": {"name": "open_report_room"},
      "expected": {"reason": "", "leaveRoom": false, "reportAction": "uninitialized", "canReport": false},
      "invariants": ["no report or leave effect is emitted"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomPresenter.kt", "features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomState.kt"]}
    },
    {
      "caseId": "rr_state_002_reason_enables_report",
      "key": "reason_enables_report",
      "functionalArea": "report_form",
      "given": {"reason": "", "leaveRoom": false},
      "event": {"name": "update_reason", "reason": "Spam"},
      "expected": {"reason": "Spam", "leaveRoom": false, "canReport": true},
      "invariants": ["editing the reason does not toggle leave"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomPresenter.kt"]}
    },
    {
      "caseId": "rr_state_003_toggle_leave",
      "key": "toggle_leave",
      "functionalArea": "leave_option",
      "given": {"reason": "Spam", "leaveRoom": false},
      "event": {"name": "toggle_leave_room"},
      "expected": {"reason": "Spam", "leaveRoom": true, "canReport": true},
      "invariants": ["the reason remains unchanged"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomPresenter.kt"]}
    },
    {
      "caseId": "rr_state_004_report_only_success",
      "key": "report_only_success",
      "functionalArea": "matrix_report",
      "given": {"reason": "Spam", "leaveRoom": false, "reportAction": "uninitialized"},
      "event": {"name": "report"},
      "expected": {"reportAction": "success", "reportCalls": 1, "reportReason": "Spam", "leaveCalls": 0},
      "invariants": ["reporting completes before the success result"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoom.kt"]}
    },
    {
      "caseId": "rr_state_005_report_then_leave",
      "key": "report_then_leave",
      "functionalArea": "leave_room",
      "given": {"reason": "Abuse", "leaveRoom": true, "reportAction": "uninitialized"},
      "event": {"name": "report"},
      "expected": {"reportAction": "success", "effects": ["report_room", "leave_room"], "reportCalls": 1, "leaveCalls": 1},
      "invariants": ["leave is attempted only after reporting succeeds"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoom.kt"]}
    },
    {
      "caseId": "rr_state_006_blank_reason_disabled",
      "key": "blank_reason_disabled",
      "functionalArea": "report_form",
      "given": {"reason": "   ", "leaveRoom": true},
      "event": {"name": "render_report_form"},
      "expected": {"canReport": false, "submitEnabled": false},
      "invariants": ["leave preference remains selected"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomState.kt", "features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomView.kt"]}
    },
    {
      "caseId": "rr_state_007_report_failure_stops_leave",
      "key": "report_failure_stops_leave",
      "functionalArea": "partial_failure_retry",
      "given": {"reason": "Spam", "leaveRoom": true, "reportResult": "failure"},
      "event": {"name": "report"},
      "expected": {"reportAction": "report_failed", "reportCalls": 1, "leaveCalls": 0, "reason": "Spam", "leaveRoom": true},
      "invariants": ["form values survive the failure"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoom.kt", "features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomPresenter.kt"]}
    },
    {
      "caseId": "rr_state_008_leave_failure_is_partial",
      "key": "leave_failure_is_partial",
      "functionalArea": "partial_failure_retry",
      "given": {"reason": "Spam", "leaveRoom": true, "reportResult": "success", "leaveResult": "failure"},
      "event": {"name": "report"},
      "expected": {"reportAction": "leave_failed", "reportCalls": 1, "leaveCalls": 1, "retryEnabled": true},
      "invariants": ["the successful report is remembered"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoom.kt"]}
    },
    {
      "caseId": "rr_state_009_retry_leave_only",
      "key": "retry_leave_only",
      "functionalArea": "partial_failure_retry",
      "given": {"reason": "Spam", "leaveRoom": true, "reportAction": "leave_failed", "reportCalls": 1, "leaveCalls": 1},
      "event": {"name": "retry"},
      "expected": {"reportAction": "success", "reportCalls": 1, "leaveCalls": 2, "retryShouldReport": false},
      "invariants": ["the report is never submitted twice"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomPresenter.kt"]}
    },
    {
      "caseId": "rr_state_010_clear_failure_keeps_form",
      "key": "clear_failure_keeps_form",
      "functionalArea": "partial_failure_retry",
      "given": {"reason": "Spam", "leaveRoom": true, "reportAction": "report_failed"},
      "event": {"name": "clear_report_action"},
      "expected": {"reason": "Spam", "leaveRoom": true, "reportAction": "uninitialized", "canReport": true},
      "invariants": ["clearing the error emits no network effect"],
      "evidence": {"androidProduction": ["features/reportroom/impl/src/main/kotlin/io/element/android/features/reportroom/impl/ReportRoomPresenter.kt"]}
    }
  ]
}
