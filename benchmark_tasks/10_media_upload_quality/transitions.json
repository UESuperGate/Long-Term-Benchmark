    {
      "caseId": "mq_state_004_estimate_video_presets",
      "key": "estimate_video_presets",
      "functionalArea": "video_estimation",
      "given": {
        "durationSeconds": 60,
        "presetBitrates": {
          "high": 8000000,
          "standard": 4000000,
          "low": 1000000
        },
        "maxUploadSize": 35000000
      },
      "event": {
        "name": "calculate_estimations"
      },
      "expected": {
        "sizes": {
          "high": 66000000,
          "standard": 33000000,
          "low": 8250000
        },
        "canUpload": {
          "high": false,
          "standard": true,
          "low": true
        },
        "safetyOverhead": 1.1
      },
      "invariants": [
        "server limit comparison is inclusive"
      ],
      "evidence": {
        "androidProduction": [
          "DefaultMediaOptimizationSelectorPresenter.kt",
          "MediaOptimizationSelectorState.kt"
        ],
        "androidTests": [
