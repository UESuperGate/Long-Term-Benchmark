      "key": "block_when_all_oversized",
      "functionalArea": "error_feedback",
      "given": {
        "estimations": [
          {
            "preset": "high",
            "canUpload": false
          },
          {
            "preset": "standard",
            "canUpload": false
          },
          {
            "preset": "low",
            "canUpload": false
          }
        ],
        "sendState": "idle"
      },
      "event": {
        "name": "finish_estimations"
