    {
      "caseId": "mq_state_009_failure_cancel_retry",
      "key": "failure_cancel_retry",
      "functionalArea": "error_feedback",
      "given": {
        "selectedPreset": "standard",
        "caption": "demo",
        "sendState": "failure",
        "preparedMedia": true
      },
      "event": {
        "name": "clear_failure_then_retry",
        "secondResult": "success"
      },
      "expected": {
        "stateAfterClear": "ready_to_upload",
        "finalState": "done",
        "caption": "demo",
        "presetUsed": "standard",
        "attempts": 2
      },
      "invariants": [
        "retry reuses prepared media and the selected quality without losing the caption"
      ],
      "evidence": {
        "androidProduction": [
          "AttachmentsPreviewEvents.kt",
          "AttachmentsPreviewPresenter.kt",
          "MediaSender.kt"
        ],
