  "description": "Shared Android/ArkTS semantics for media quality selection and upload-limit enforcement",
  "cases": [
    {
      "caseId": "mq_state_001_async_loading",
      "key": "async_loading",
      "functionalArea": "server_limit_loading",
      "given": {
        "mediaType": "video",
        "maxUploadSize": null,
        "metadata": null
      },
      "event": {
        "name": "open_attachment_preview"
      },
      "expected": {
        "limitState": "loading",
        "estimationState": "loading",
        "previewUsable": true,
        "sendState": "idle"
      },
      "invariants": [
        "loading server data does not block caption editing or cancellation"
      ],
      "evidence": {
        "androidProduction": [
          "DefaultMediaOptimizationSelectorPresenter.kt",
          "AttachmentsPreviewPresenter.kt"
        ],
        "androidTests": [
          "DefaultMediaOptimizationSelectorPresenterTest.kt"
