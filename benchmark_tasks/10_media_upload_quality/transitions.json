      "caseId": "mq_state_005_choose_best_preset",
      "key": "choose_best_preset",
      "functionalArea": "quality_selection",
      "given": {
        "defaultPreset": "high",
        "estimations": [
          {
            "preset": "high",
            "canUpload": false
          },
          {
            "preset": "standard",
            "canUpload": true
          },
          {
            "preset": "low",
            "canUpload": true
          }
        ]
      },
      "event": {
        "name": "load_preferences_and_estimations"
      },
      "expected": {
        "selectedPreset": "standard",
        "selectionState": "success"
      },
      "invariants": [
        "selection falls back toward smaller output without choosing an oversized preset"
      ],
      "evidence": {
        "androidProduction": [
          "DefaultMediaOptimizationSelectorPresenter.kt"
        ],
        "androidTests": [
          "DefaultMediaOptimizationSelectorPresenterTest.kt"
