{
  "taskId": "07_recent_search_history",
  "description": "Shared Android/ArkTS semantics for persistent global-search history",
  "cases": [
    {
      "caseId": "rs_state_001_empty_history",
      "key": "empty_history",
      "functionalArea": "history_loading",
      "given": {"persistedHistory": null, "query": ""},
      "event": {"name": "open_search"},
      "expected": {"history": [], "historyState": "success", "recentSectionVisible": true},
      "invariants": ["search results remain uninitialized"]
    },
    {
      "caseId": "rs_state_002_save_query",
      "key": "save_query",
      "functionalArea": "history_write",
      "given": {"history": [], "query": "matrix"},
      "event": {"name": "save_query_to_history"},
      "expected": {"history": [{"type": "query", "term": "matrix"}], "persisted": true},
      "invariants": ["query text is unchanged"]
    },
    {
      "caseId": "rs_state_003_ignore_blank_query",
      "key": "ignore_blank_query",
      "functionalArea": "history_write",
      "given": {"history": [{"type": "query", "term": "matrix"}], "query": "   "},
      "event": {"name": "save_query_to_history"},
      "expected": {"history": [{"type": "query", "term": "matrix"}], "writeCount": 0},
      "invariants": ["blank queries are never persisted"]
    },
    {
      "caseId": "rs_state_004_save_room",
      "key": "save_room",
      "functionalArea": "history_write",
      "given": {"history": [], "roomId": "!room:example.org"},
      "event": {"name": "save_room_to_history"},
      "expected": {"history": [{"type": "room", "roomId": "!room:example.org"}], "persisted": true},
      "invariants": ["room entries remain typed"]
    },
    {
      "caseId": "rs_state_005_duplicate_moves_front",
      "key": "duplicate_moves_front",
      "functionalArea": "history_ordering",
      "given": {"history": ["query:a", "room:!r", "query:b"]},
      "event": {"name": "add", "entry": "query:b"},
      "expected": {"history": ["query:b", "query:a", "room:!r"], "duplicateCount": 0},
      "invariants": ["unrelated relative order is preserved"]
    },
    {
      "caseId": "rs_state_006_capacity_drops_oldest",
      "key": "capacity_drops_oldest",
      "functionalArea": "history_ordering",
      "given": {"historyCount": 25, "oldest": "query:old"},
      "event": {"name": "add", "entry": "query:new"},
      "expected": {"historyCount": 25, "first": "query:new", "containsOldest": false},
      "invariants": ["maximum history size is 25"]
    },
    {
      "caseId": "rs_state_007_persisted_roundtrip",
      "key": "persisted_roundtrip",
      "functionalArea": "persistence",
      "given": {"history": ["query:matrix", "room:!room"]},
      "event": {"name": "recreate_store"},
      "expected": {"history": ["query:matrix", "room:!room"], "orderPreserved": true},
      "invariants": ["query and room types survive serialization"]
    },
    {
      "caseId": "rs_state_008_clear_history",
      "key": "clear_history",
      "functionalArea": "persistence",
      "given": {"history": ["query:matrix", "room:!room"], "fileExists": true},
      "event": {"name": "clear_history"},
      "expected": {"history": [], "fileExists": false},
      "invariants": ["new observers receive the empty history"]
    },
    {
      "caseId": "rs_state_009_corruption_recovers",
      "key": "corruption_recovers",
      "functionalArea": "failure_recovery",
      "given": {"persistedBytes": "invalid-json"},
      "event": {"name": "load_then_add", "entry": "room:!recovered"},
      "expected": {"initialHistory": [], "history": ["room:!recovered"], "persisted": true},
      "invariants": ["corruption does not crash search"]
    },
    {
      "caseId": "rs_state_010_select_query_restarts_search",
      "key": "select_query_restarts_search",
      "functionalArea": "history_selection",
      "given": {"query": "", "target": "messages", "historyEntry": "query:matrix"},
      "event": {"name": "select_history_result"},
      "expected": {"query": "matrix", "target": "rooms", "resultsState": "loading"},
      "invariants": ["the history entry remains stored"]
    },
    {
      "caseId": "rs_state_011_missing_room_filtered",
      "key": "missing_room_filtered",
      "functionalArea": "failure_recovery",
      "given": {"history": ["room:!missing", "query:matrix"], "accessibleRooms": []},
      "event": {"name": "map_history_for_ui"},
      "expected": {"visibleHistory": ["query:matrix"], "historyState": "success"},
      "invariants": ["one missing room does not hide valid entries"]
    }
  ]
}
