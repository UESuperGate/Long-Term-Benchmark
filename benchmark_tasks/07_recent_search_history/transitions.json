{
  "schemaVersion": 1,
  "taskId": "07_recent_search_history",
  "owner": "evaluator",
  "description": "Shared Android/ArkTS semantics for persistent global-search history",
  "cases": [
    {
      "caseId": "rs_state_001_empty_history",
      "key": "empty_history",
      "functionalArea": "history_loading",
      "given": {
        "persistedHistory": null,
        "query": ""
      },
      "event": {
        "name": "open_search"
      },
      "expected": {
        "history": [],
        "historyState": "success",
        "recentSectionVisible": true
      },
      "invariants": [
        "search results remain uninitialized"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "8557bb408187d763b145dd3db3d16f8fd61488697ea33fdea14e2d772c481465"
    },
    {
      "caseId": "rs_state_002_save_query",
      "key": "save_query",
      "functionalArea": "history_write",
      "given": {
        "history": [],
        "query": "matrix"
      },
      "event": {
        "name": "save_query_to_history"
      },
      "expected": {
        "history": [
          {
            "type": "query",
            "term": "matrix"
          }
        ],
        "persisted": true
      },
      "invariants": [
        "query text is unchanged"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "d2835bcb2b8a1fffb6f4a4b65134f7bb84036b9200fb309c05ea4375a59082b2"
    },
    {
      "caseId": "rs_state_003_ignore_blank_query",
      "key": "ignore_blank_query",
      "functionalArea": "history_write",
      "given": {
        "history": [
          {
            "type": "query",
            "term": "matrix"
          }
        ],
        "query": "   "
      },
      "event": {
        "name": "save_query_to_history"
      },
      "expected": {
        "history": [
          {
            "type": "query",
            "term": "matrix"
          }
        ],
        "writeCount": 0
      },
      "invariants": [
        "blank queries are never persisted"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "dfedc47d688644c9ca2270b8ee6e77a8459f3d28547db512eed16c8eb455e1d2"
    },
    {
      "caseId": "rs_state_004_save_room",
      "key": "save_room",
      "functionalArea": "history_write",
      "given": {
        "history": [],
        "roomId": "!room:example.org"
      },
      "event": {
        "name": "save_room_to_history"
      },
      "expected": {
        "history": [
          {
            "type": "room",
            "roomId": "!room:example.org"
          }
        ],
        "persisted": true
      },
      "invariants": [
        "room entries remain typed"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "3e2492d351ea6008c94497182354e9d4c0b34448c50d8c9078a2d6b4b2b70627"
    },
    {
      "caseId": "rs_state_005_duplicate_moves_front",
      "key": "duplicate_moves_front",
      "functionalArea": "history_ordering",
      "given": {
        "history": [
          "query:a",
          "room:!r",
          "query:b"
        ]
      },
      "event": {
        "name": "add",
        "entry": "query:b"
      },
      "expected": {
        "history": [
          "query:b",
          "query:a",
          "room:!r"
        ],
        "duplicateCount": 0
      },
      "invariants": [
        "unrelated relative order is preserved"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "06206474643c14802266eb12661e2fd83adbaa21508537f01dc589e36f69f651"
    },
    {
      "caseId": "rs_state_006_capacity_drops_oldest",
      "key": "capacity_drops_oldest",
      "functionalArea": "history_ordering",
      "given": {
        "historyCount": 25,
        "oldest": "query:old"
      },
      "event": {
        "name": "add",
        "entry": "query:new"
      },
      "expected": {
        "historyCount": 25,
        "first": "query:new",
        "containsOldest": false
      },
      "invariants": [
        "maximum history size is 25"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "6d0e69f896e197839be970703b2eb40e01b0ad394fcff09096b2d3202aab405a"
    },
    {
      "caseId": "rs_state_007_persisted_roundtrip",
      "key": "persisted_roundtrip",
      "functionalArea": "persistence",
      "given": {
        "history": [
          "query:matrix",
          "room:!room"
        ]
      },
      "event": {
        "name": "recreate_store"
      },
      "expected": {
        "history": [
          "query:matrix",
          "room:!room"
        ],
        "orderPreserved": true
      },
      "invariants": [
        "query and room types survive serialization"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "5e198dc45e5cc8a43d474a43d38c9c5e46374fd19949cad252decb73c9190fa4"
    },
    {
      "caseId": "rs_state_008_clear_history",
      "key": "clear_history",
      "functionalArea": "persistence",
      "given": {
        "history": [
          "query:matrix",
          "room:!room"
        ],
        "fileExists": true
      },
      "event": {
        "name": "clear_history"
      },
      "expected": {
        "history": [],
        "fileExists": false
      },
      "invariants": [
        "new observers receive the empty history"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "98444250d68ee0aa5be9cfbc0b0c1b63a59f7d88f121b4856421171e25d5e474"
    },
    {
      "caseId": "rs_state_009_corruption_recovers",
      "key": "corruption_recovers",
      "functionalArea": "failure_recovery",
      "given": {
        "persistedBytes": "invalid-json"
      },
      "event": {
        "name": "load_then_add",
        "entry": "room:!recovered"
      },
      "expected": {
        "initialHistory": [],
        "history": [
          "room:!recovered"
        ],
        "persisted": true
      },
      "invariants": [
        "corruption does not crash search"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "0f8661f6e3ede08e77408cd0b88cafcc8556cd96cc509bc5570f1df56bba3a4a"
    },
    {
      "caseId": "rs_state_010_select_query_restarts_search",
      "key": "select_query_restarts_search",
      "functionalArea": "history_selection",
      "given": {
        "query": "",
        "target": "messages",
        "historyEntry": "query:matrix"
      },
      "event": {
        "name": "select_history_result"
      },
      "expected": {
        "query": "matrix",
        "target": "rooms",
        "resultsState": "loading"
      },
      "invariants": [
        "the history entry remains stored"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "bfab0ddc9b48c3de041054e3705108e21932e913f2db043bf2a6361e93d29969"
    },
    {
      "caseId": "rs_state_011_missing_room_filtered",
      "key": "missing_room_filtered",
      "functionalArea": "failure_recovery",
      "given": {
        "history": [
          "room:!missing",
          "query:matrix"
        ],
        "accessibleRooms": []
      },
      "event": {
        "name": "map_history_for_ui"
      },
      "expected": {
        "visibleHistory": [
          "query:matrix"
        ],
        "historyState": "success"
      },
      "invariants": [
        "one missing room does not hide valid entries"
      ],
      "taskId": "07_recent_search_history",
      "traceDigest": "375e30e9c7f21ff9a6b97dccab43bbb40fbeed792dd354709a30ad88a1da3035"
    }
  ]
}
