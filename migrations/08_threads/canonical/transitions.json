    {
      "caseId": "th_state_008_retry_failed_send",
      "key": "retry_failed_send",
      "functionalArea": "failure_recovery",
      "given": {
        "threadRootId": "$root",
        "composerText": "retry me",
        "sendState": "failure",
        "attempts": 1
      },
      "event": {
        "name": "retry_send"
      },
      "expected": {
        "sendState": "success",
        "attempts": 2,
        "effect": "send_message",
        "body": "retry me",
        "threadRootId": "$root"
      },
      "invariants": [
        "failure keeps the original body and relation until retry succeeds"
      ],
      "evidence": {
        "androidProduction": [
          "MessageComposerPresenter.kt",
          "ThreadedMessagesNode.kt"
        ],
        "androidTests": [
          "MessageComposerPresenterTest.kt"
        ]
      },
      "taskId": "08_threads",
      "traceDigest": "364c9fd4e2a9ce03bfc44d7249d1b659f193117122854f661d3eae79904ab238"
    },
    {
      "caseId": "th_state_009_back_isolates_room",
      "key": "back_isolates_room",
      "functionalArea": "thread_navigation",
      "given": {
        "surface": "thread",
        "threadRootId": "$root",
        "focusedEventId": "$reply",
        "mainRoomFocus": null
      },
      "event": {
        "name": "navigate_back"
      },
      "expected": {
        "surface": "room",
        "threadRootId": null,
        "mainRoomFocus": null
      },
      "invariants": [
        "thread focus and composer state do not leak into the room timeline"
      ],
      "evidence": {
        "androidProduction": [
          "MessagesFlowNode.kt",
          "ThreadedMessagesNode.kt"
        ],
        "androidTests": [
          "MessagesPresenterTest.kt"
        ]
      },
      "taskId": "08_threads",
      "traceDigest": "8cb3a64b7078a99baf19b3440d76a2a38ba5cac8a8d10d4374f513ab8d3c9fc1"
    }
  ]
