    {
      "caseId": "sp_state_003_join_child_success",
      "key": "join_child_success",
      "functionalArea": "join_room",
      "given": {
        "children": [
          {
            "roomId": "!a",
            "membership": null
          },
          {
            "roomId": "!b",
            "membership": null
          }
        ],
        "joinActions": {}
      },
      "event": {
        "name": "join_child",
        "roomId": "!a",
        "result": "success"
