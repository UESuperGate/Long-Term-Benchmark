        "effect": "join_room"
      },
      "invariants": [
        "joining one child does not change another child's state"
      ],
      "evidence": {
        "androidProduction": [
          "SpacePresenter.kt"
        ],
        "androidTests": [
          "SpacePresenterTest.kt"
        ]
      },
