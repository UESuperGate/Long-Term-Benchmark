          "!b": null
        },
        "attempts": {
          "!a": 2
        }
      },
      "invariants": [
        "failure and retry are tracked independently per room"
      ],
      "evidence": {
        "androidProduction": [
          "SpacePresenter.kt",
          "SpaceEvents.kt"
        ],
        "androidTests": [
          "SpacePresenterTest.kt"
        ]
      },
      "taskId": "09_spaces_lifecycle",
