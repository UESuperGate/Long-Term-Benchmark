          "!a",
          "!b"
        ],
        "selectedRoomIds": [
          "!a"
        ],
        "lastAdminSelected": false
      },
      "invariants": [
        "bulk actions and toggles cannot select a last-admin room"
      ],
      "evidence": {
        "androidProduction": [
          "LeaveSpaceEvents.kt",
          "LeaveSpacePresenter.kt"
        ],
        "androidTests": [
          "LeaveSpacePresenterTest.kt"
        ]
      },
