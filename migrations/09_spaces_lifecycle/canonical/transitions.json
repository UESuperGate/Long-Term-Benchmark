{
  "schemaVersion": 1,
  "taskId": "09_spaces_lifecycle",
  "owner": "evaluator",
  "description": "Shared Android/ArkTS semantics for browsing, joining and leaving Spaces",
  "cases": [
    {
      "caseId": "sp_state_001_open_space",
      "key": "open_space",
      "functionalArea": "space_navigation",
      "given": {
        "joinedSpaces": [
          "!space"
        ],
        "selectedSpaceId": null
      },
      "event": {
        "name": "open_space",
        "spaceId": "!space"
      },
      "expected": {
        "surface": "space",
        "selectedSpaceId": "!space",
        "childrenState": "loading"
      },
      "invariants": [
        "home retains the selected Space while children update"
      ],
      "evidence": {
        "androidProduction": [
          "HomeSpacesPresenter.kt",
          "SpaceFlowNode.kt"
        ],
        "androidTests": [
          "HomeSpacesPresenterTest.kt",
          "DefaultSpaceEntryPointTest.kt"
        ]
      },
      "taskId": "09_spaces_lifecycle",
      "traceDigest": "5031e634ed571cc5f31bb38df86b4e3df9dcd2b29045dee14e9722d353c7931c"
    },
    {
      "caseId": "sp_state_002_paginate_children",
      "key": "paginate_children",
      "functionalArea": "space_pagination",
      "given": {
        "children": [
          "!a",
          "!b"
        ],
        "hasMoreToLoad": true
      },
      "event": {
        "name": "load_more",
        "page": [
          "!b",
          "!c"
