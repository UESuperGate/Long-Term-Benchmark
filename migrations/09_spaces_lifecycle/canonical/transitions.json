    {
      "caseId": "sp_state_006_default_leave_selection",
      "key": "default_leave_selection",
      "functionalArea": "leave_space_selection",
      "given": {
        "spaceId": "!space",
        "children": [
          {
            "roomId": "!normal",
            "isDirect": false,
            "isLastAdmin": false
          },
          {
            "roomId": "!admin",
            "isDirect": false,
            "isLastAdmin": true
          },
          {
            "roomId": "!dm",
            "isDirect": true,
            "isLastAdmin": false
          }
        ]
      },
      "event": {
        "name": "open_leave_space"
      },
      "expected": {
        "visibleChildren": [
          "!normal",
          "!admin"
        ],
        "selectedRoomIds": [
          "!normal"
        ],
        "disabledRoomIds": [
          "!admin"
        ]
      },
      "invariants": [
        "direct messages are excluded and last-admin rooms are never selected by default"
      ],
      "evidence": {
        "androidProduction": [
          "LeaveSpacePresenter.kt",
          "SelectableSpaceRoom.kt"
        ],
        "androidTests": [
          "LeaveSpacePresenterTest.kt"
        ]
      },
      "taskId": "09_spaces_lifecycle",
      "traceDigest": "aac1c6b8a362a8ec39ccd2fc66a248d8d912924c903666479a6b4eb4faf57a6b"
    },
    {
      "caseId": "sp_state_007_bulk_and_toggle_selection",
      "key": "bulk_and_toggle_selection",
      "functionalArea": "leave_space_selection",
      "given": {
        "eligibleRoomIds": [
          "!a",
          "!b"
        ],
        "lastAdminRoomIds": [
          "!admin"
        ],
        "selectedRoomIds": [
          "!a"
        ]
      },
      "event": {
        "name": "deselect_all_select_all_toggle",
        "roomId": "!b"
      },
      "expected": {
        "afterDeselectAll": [],
