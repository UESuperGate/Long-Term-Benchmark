+export class UnifiedSupportController {
+  readonly store: UnifiedSupportStore = new UnifiedSupportStore();
+  private readonly service: SupportServiceLeaf;
+  private readonly network?: NetworkLeaf;
+  private readonly attachments?: AttachmentLeaf;
+  /** Local conversations get negative ids until the bot bridge returns one. */
+  private localConversationId: number = 0;
+  private localMessageId: number = 0;
+
+  constructor(service: SupportServiceLeaf, network?: NetworkLeaf, attachments?: AttachmentLeaf) {
+    this.service = service;
+    this.network = network;
+    this.attachments = attachments;
+  }
+
+  // ------------------------------------------------------------ list loading
+
+  /** Opens the unified list from the single "Get help" entry. */
+  open(): Promise<boolean> {
+    return this.loadUnifiedList();
+  }
+
+  /** Retries the unified list through the very same repository path. */
+  retry(): Promise<boolean> {
+    return this.loadUnifiedList();
+  }
+
+  private async loadUnifiedList(): Promise<boolean> {
+    this.store.loading = true;
+    this.store.error = ERROR_NONE;
+    this.store.requestCount += 1;
+    try {
+      const rows: SupportConversation[] = await this.service.loadConversations();
+      this.store.conversations = this.adoptAll(rows);
+      this.realignSelection();
+      this.store.error = ERROR_NONE;
+      return true;
+    } catch (error) {
+      // A failed request stays observable error state; it is never flattened
+      // into an empty successful list.
+      this.store.error = this.failureToken();
+      return false;
+    } finally {
+      this.store.loading = false;
+    }
+  }
+
+  // --------------------------------------------------------- detail opening
+
+  async openConversation(id: number): Promise<boolean> {
+    // Draft state belongs to the conversation it was typed for, so switching to
+    // another conversation clears it. Re-opening the same conversation keeps the
+    // input the user already wrote.
+    const current: SupportConversation | undefined = this.store.selected;
+    if (current === undefined || current.id !== id) {
+      this.store.replyForm.clear();
+    }
+    this.store.error = ERROR_NONE;
+    this.store.loading = true;
+    this.store.requestCount += 1;
+    try {
+      const conversation: SupportConversation = await this.service.loadConversation(id);
+      const adopted: SupportConversation = this.adopt(conversation);
+      this.upsert(adopted);
+      this.store.selected = adopted;
+      return true;
+    } catch (error) {
+      this.store.error = this.failureToken();
+      return false;
+    } finally {
+      this.store.loading = false;
+    }
+  }
+
+  /**
+   * Creates the bot conversation locally. The remote bot bridge only runs on the
+   * first send, so the entry appears immediately without a round trip.
+   */
+  createNewBotConversation(): void {
+    this.localConversationId += 1;
+    const conversation: SupportConversation = {
+      id: -this.localConversationId,
+      title: NEW_CONVERSATION_TITLE,
+      status: SUPPORT_BOT_STATUS,
+      canAcceptReply: true,
+      messages: []
+    };
+    this.store.replyForm.clear();
+    this.store.error = ERROR_NONE;
+
+    const rows: SupportConversation[] = [conversation];
+    const existing: SupportConversation[] = this.store.conversations;
+    for (let i = 0; i < existing.length; i++) {
+      rows.push(existing[i]);
+    }
+    this.store.conversations = rows;
+    this.store.selected = conversation;
+  }
+
+  // -------------------------------------------------------------- reply form
+
+  updateDraft(message: string): void {
+    this.store.replyForm.message = message;
+  }
+
+  updateAttachments(values: string[]): void {
+    this.store.replyForm.attachments = values.slice();
+  }
+
+  setIncludeAppLogs(value: boolean): void {
+    this.store.replyForm.includeAppLogs = value;
+  }
+
+  setReplySheetVisible(value: boolean): void {
+    this.store.replyForm.sheetVisible = value;
+  }
+
+  // ------------------------------------------------------ detail affordances
+
+  detailState(conversation: SupportConversation): DetailAffordance {
+    const affordance: DetailAffordance = {
+      composer: COMPOSER_NONE,
+      typingIndicatorSupported: false,
+      closedBanner: false
+    };
+    if (isClosedConversation(conversation)) {
+      affordance.closedBanner = true;
+      return affordance;
+    }
+    if (!conversation.canAcceptReply) {
+      return affordance;
+    }
+    affordance.typingIndicatorSupported = true;
+    affordance.composer = isBotConversation(conversation) ? COMPOSER_INLINE : COMPOSER_REPLY_SHEET;
+    return affordance;
+  }
+
+  detailAffordance(conversation: SupportConversation): string {
+    const affordance: DetailAffordance = this.detailState(conversation);
+    if (affordance.closedBanner) {
+      return AFFORDANCE_CLOSED_BANNER;
+    }
+    if (affordance.composer === COMPOSER_INLINE) {
+      return AFFORDANCE_INLINE_COMPOSER;
+    }
+    if (affordance.composer === COMPOSER_REPLY_SHEET) {
+      return AFFORDANCE_REPLY_SHEET;
+    }
+    return AFFORDANCE_NO_REPLY;
+  }
+
+  // -------------------------------------------------------------- send reply
+
+  async sendReply(message: string): Promise<boolean> {
+    // The guard is set before any asynchronous work so a duplicate tap cannot
+    // reach the repository.
+    if (this.store.sending) {
+      return false;
+    }
+    // Offline is detected before the optimistic message is inserted and before
+    // the repository is called at all.
+    if (!this.isOnline()) {
+      this.store.error = ERROR_OFFLINE;
+      return false;
+    }
+
+    let conversation: SupportConversation | undefined = this.store.selected;
+    if (conversation === undefined) {
+      this.createNewBotConversation();
+      conversation = this.store.selected;
+    }
+    if (conversation === undefined) {
+      return false;
+    }
+
+    const form: ReplyFormState = this.store.replyForm;
+    const sentText: string = message.length > 0 ? message : form.message;
+    if (sentText.length === 0) {
+      return false;
+    }
+
+    this.localMessageId += 1;
+    const optimistic: SupportMessage = {
+      id: -this.localMessageId,
+      author: MESSAGE_AUTHOR_USER,
+      text: sentText
+    };
+    const pendingBotConversation: boolean = conversation.id < 0;
+    // Snapshot the payload before any asynchronous work so later typing cannot
+    // change what this send actually transmits.
+    const pendingAttachments: string[] = form.attachments.slice();
+    const pendingAppLogs: boolean = form.includeAppLogs;
+
+    this.store.sending = true;
+    this.store.error = ERROR_NONE;
+    form.message = '';
+    this.appendMessage(conversation, optimistic);
+    this.upsert(conversation);
+    this.store.selected = conversation;
+
+    let tempPaths: string[] = [];
+    let logIds: string[] = [];
+    let returned: SupportConversation | undefined = undefined;
+    let failed = false;
+    try {
+      if (pendingAppLogs) {
+        logIds = await this.uploadAppLogs();
+      }
+      tempPaths = await this.createTempFiles(pendingAttachments);
+      if (pendingBotConversation) {
+        // Application owned bot creation bridge, then the returned reply.
+        this.store.requestCount += 1;
+        returned = await this.service.createBotConversation(GET_HELP_BOT_ID, sentText);
+      } else {
+        this.store.requestCount += 1;
+        returned = await this.service.reply(conversation.id, sentText, tempPaths, logIds);
+      }
+    } catch (error) {
+      failed = true;
+    }
+
+    this.store.sending = false;
+    await this.removeTempFiles(tempPaths);
+
+    if (failed || returned === undefined) {
+      this.rollbackOptimistic(conversation, optimistic, sentText);
+      this.store.error = this.failureToken();
+      return false;
+    }
+
+    this.applySentConversation(conversation, optimistic, returned);
+    this.store.replyForm.clear();
+    this.store.error = ERROR_NONE;
+    return true;
+  }
+
+  // ------------------------------------------------------------------ private
+
+  private isOnline(): boolean {
+    const leaf: NetworkLeaf | undefined = this.network;
+    if (leaf === undefined) {
+      return true;
+    }
+    return leaf.online();
+  }
+
+  private failureToken(): string {
+    return this.isOnline() ? ERROR_GENERAL : ERROR_OFFLINE;
+  }
+
+  /** Copies leaf payloads so the controller never mutates foreign objects. */
+  private adopt(conversation: SupportConversation): SupportConversation {
+    return {
+      id: conversation.id,
+      title: conversation.title,
+      status: conversation.status,
+      canAcceptReply: conversation.canAcceptReply,
+      messages: conversation.messages.slice()
+    };
+  }
+
+  private adoptAll(conversations: SupportConversation[]): SupportConversation[] {
+    const adopted: SupportConversation[] = [];
+    for (let i = 0; i < conversations.length; i++) {
+      adopted.push(this.adopt(conversations[i]));
+    }
+    return adopted;
+  }
+
+  /** Keeps the selected detail pointing at the same object as its list row. */
+  private realignSelection(): void {
+    const selected: SupportConversation | undefined = this.store.selected;
+    if (selected === undefined) {
+      return;
+    }
+    const rows: SupportConversation[] = this.store.conversations;
+    for (let i = 0; i < rows.length; i++) {
+      if (rows[i].id === selected.id) {
+        this.store.selected = rows[i];
+        return;
+      }
+    }
+  }
+
+  private upsert(conversation: SupportConversation): void {
+    const rows: SupportConversation[] = [];
+    const existing: SupportConversation[] = this.store.conversations;
+    let replaced = false;
+    for (let i = 0; i < existing.length; i++) {
+      if (existing[i].id === conversation.id) {
+        if (!replaced) {
+          rows.push(conversation);
+          replaced = true;
+        }
+      } else {
+        rows.push(existing[i]);
+      }
+    }
+    if (!replaced) {
+      const head: SupportConversation[] = [conversation];
+      for (let i = 0; i < rows.length; i++) {
+        head.push(rows[i]);
+      }
+      this.store.conversations = head;
+      return;
+    }
+    this.store.conversations = rows;
+  }
+
+  /** Swaps the previous row for the refreshed conversation, keeping position. */
+  private replaceInList(previousId: number, next: SupportConversation): void {
+    const source: SupportConversation[] = this.store.conversations;
+    const rows: SupportConversation[] = [];
+    let inserted = false;
+    for (let i = 0; i < source.length; i++) {
+      const row: SupportConversation = source[i];
+      if (row.id === previousId || row.id === next.id) {
+        if (!inserted) {
+          rows.push(next);
+          inserted = true;
+        }
+        continue;
+      }
+      rows.push(row);
+    }
+    if (!inserted) {
+      const head: SupportConversation[] = [next];
+      for (let i = 0; i < rows.length; i++) {
+        head.push(rows[i]);
+      }
+      this.store.conversations = head;
+      return;
+    }
+    this.store.conversations = rows;
+  }
+
+  private appendMessage(conversation: SupportConversation, message: SupportMessage): void {
+    const messages: SupportMessage[] = conversation.messages.slice();
+    messages.push(message);
+    conversation.messages = messages;
+  }
+
+  private removeMessage(conversation: SupportConversation, messageId: number): void {
+    const messages: SupportMessage[] = conversation.messages;
+    const remaining: SupportMessage[] = [];
+    for (let i = 0; i < messages.length; i++) {
+      if (messages[i].id !== messageId) {
+        remaining.push(messages[i]);
+      }
+    }
+    conversation.messages = remaining;
+  }
+
+  private async uploadAppLogs(): Promise<string[]> {
+    const leaf: AttachmentLeaf | undefined = this.attachments;
+    if (leaf === undefined) {
+      return [];
+    }
+    return await leaf.uploadEncryptedLogs();
+  }
+
+  private async createTempFiles(sources: string[]): Promise<string[]> {
+    if (sources.length === 0) {
+      return [];
+    }
+    const leaf: AttachmentLeaf | undefined = this.attachments;
+    if (leaf === undefined) {
+      return sources.slice();
+    }
+    return await leaf.createTempFiles(sources);
+  }
+
+  private async removeTempFiles(paths: string[]): Promise<void> {
+    if (paths.length === 0) {
+      return;
+    }
+    const leaf: AttachmentLeaf | undefined = this.attachments;
+    if (leaf === undefined) {
+      return;
+    }
+    try {
+      await leaf.removeTempFiles(paths);
+    } catch (error) {
+      // Temporary file cleanup is best effort and never fails a completed send.
+    }
+  }
+
+  /** Only the optimistic message is undone; history is left untouched. */
+  private rollbackOptimistic(
+    conversation: SupportConversation,
+    optimistic: SupportMessage,
+    sentText: string
+  ): void {
+    this.removeMessage(conversation, optimistic.id);
+    if (this.store.replyForm.message.length === 0) {
+      this.store.replyForm.message = sentText;
+    }
+    this.upsert(conversation);
+    this.store.selected = conversation;
+  }
+
+  private applySentConversation(
+    conversation: SupportConversation,
+    optimistic: SupportMessage,
+    returned: SupportConversation
+  ): void {
+    const merged: SupportConversation = {
+      id: returned.id,
+      title: returned.title.length > 0 ? returned.title : conversation.title,
+      status: returned.status.length > 0 ? returned.status : conversation.status,
+      canAcceptReply: returned.canAcceptReply,
+      messages: this.mergeMessages(conversation, optimistic, returned)
+    };
+    this.replaceInList(conversation.id, merged);
+    this.store.selected = merged;
+  }
+
+  /**
+   * Keeps the user's question exactly once: when the response already echoes it
+   * the response is authoritative, otherwise the local message is re-inserted at
+   * its chronological position.
+   */
+  private mergeMessages(
+    conversation: SupportConversation,
+    optimistic: SupportMessage,
+    returned: SupportConversation
+  ): SupportMessage[] {
+    const incoming: SupportMessage[] = returned.messages;
+    for (let i = 0; i < incoming.length; i++) {
+      if (incoming[i].id === optimistic.id || incoming[i].text === optimistic.text) {
+        return incoming.slice();
+      }
+    }
+    const anchor: number = this.lastAnchorIndex(incoming, conversation.messages);
+    const merged: SupportMessage[] = [];
+    if (anchor < 0) {
+      merged.push(optimistic);
+      for (let i = 0; i < incoming.length; i++) {
+        merged.push(incoming[i]);
+      }
+      return merged;
+    }
+    for (let i = 0; i <= anchor; i++) {
+      merged.push(incoming[i]);
+    }
+    merged.push(optimistic);
+    for (let i = anchor + 1; i < incoming.length; i++) {
+      merged.push(incoming[i]);
+    }
+    return merged;
+  }
+
+  private lastAnchorIndex(incoming: SupportMessage[], previous: SupportMessage[]): number {
+    let anchor = -1;
+    for (let i = 0; i < incoming.length; i++) {
+      for (let j = 0; j < previous.length; j++) {
+        if (previous[j].id === incoming[i].id) {
+          anchor = i;
+        }
+      }
+    }
+    return anchor;
+  }
+}
