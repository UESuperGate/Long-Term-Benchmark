 }
 
+export interface DetailAffordance {
+  composer: string;
+  typingIndicatorSupported: boolean;
+  closedBanner: boolean;
+}
+
+// ---------------------------------------------------------------- vocabulary
+
+/** Name of the unified surface that replaced the separate support entries. */
+export const SUPPORT_SURFACE: string = 'unified_support';
+
+/** The single menu entry that opens the unified experience. */
+export const SUPPORT_ENTRY_LABEL: string = 'Get help';
+
+/** Status that identifies a bot conversation row. */
+export const SUPPORT_BOT_STATUS: string = 'bot';
+
+/** Status of a Happiness Engineer ticket that can no longer be replied to. */
+export const SUPPORT_CLOSED_STATUS: string = 'closed';
+
+export const ERROR_NONE: string = '';
+export const ERROR_GENERAL: string = 'general';
+export const ERROR_OFFLINE: string = 'offline';
+
+export const MESSAGE_AUTHOR_USER: string = 'user';
+export const NEW_CONVERSATION_TITLE: string = 'New conversation';
+
+/** Bot that answers questions started from the unified "Get help" entry. */
+export const GET_HELP_BOT_ID: string = 'get-help';
+
+export const COMPOSER_INLINE: string = 'inline_composer';
+export const COMPOSER_REPLY_SHEET: string = 'reply_sheet';
+export const COMPOSER_NONE: string = 'none';
+
+export const AFFORDANCE_INLINE_COMPOSER: string = 'inline_composer';
+export const AFFORDANCE_REPLY_SHEET: string = 'reply_sheet';
+export const AFFORDANCE_CLOSED_BANNER: string = 'closed_banner';
+export const AFFORDANCE_NO_REPLY: string = 'no_reply_action';
+
+// --------------------------------------------------------------- model rules
+
+export function isBotConversation(conversation: SupportConversation): boolean {
+  return conversation.status === SUPPORT_BOT_STATUS;
+}
+
+export function isClosedConversation(conversation: SupportConversation): boolean {
+  return conversation.status === SUPPORT_CLOSED_STATUS;
+}
+
+/**
+ * Closed Happiness Engineer tickets keep their history but can no longer accept
+ * replies, so the reply affordance is derived from both flags.
+ */
+export function canReplyToConversation(conversation: SupportConversation): boolean {
+  return conversation.canAcceptReply && !isClosedConversation(conversation);
+}
+
+export function isUserMessage(message: SupportMessage): boolean {
+  return message.author === MESSAGE_AUTHOR_USER;
+}
+
+export function statusLabel(conversation: SupportConversation): string {
+  if (isBotConversation(conversation)) {
+    return 'Bot conversation';
+  }
+  return conversation.status;
+}
+
