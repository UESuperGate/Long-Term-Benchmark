+package org.wordpress.android.support.unified.ui
+
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Modifier
+
+/**
+ * The one and only "Get help" entry point.
+ *
+ * It replaces the separate bot and Happiness Engineer menu entries: both of them now open this
+ * screen, which lists every conversation from the unified repository and routes to the shared
+ * conversation detail experience.
+ */
+@Composable
+fun UnifiedSupportScreen(
+    viewModel: UnifiedSupportViewModel,
+    modifier: Modifier = Modifier,
+) {
+    val conversations by viewModel.conversations.collectAsState()
+    val conversationsState by viewModel.conversationsState.collectAsState()
+    val errorMessage by viewModel.errorMessage.collectAsState()
+    val selectedConversation by viewModel.selectedConversation.collectAsState()
+    val isLoadingConversation by viewModel.isLoadingConversation.collectAsState()
+    val isSendingReply by viewModel.isSendingReply.collectAsState()
+    val replyFormState by viewModel.replyFormState.collectAsState()
+
+    val conversation = selectedConversation
+    if (conversation == null) {
+        UnifiedSupportConversationsListScreen(
+            conversations = conversations,
+            conversationsState = conversationsState,
+            errorMessage = errorMessage,
+            onConversationClick = viewModel::onConversationClick,
+            onCreateNewBotConversationClick = viewModel::onCreateNewBotConversationClick,
+            onRetryClick = viewModel::refreshConversations,
+            modifier = modifier.fillMaxSize(),
+        )
+        return
+    }
+
+    UnifiedConversationDetailScreen(
+        conversation = conversation,
+        replyFormState = replyFormState,
+        isSendingReply = isSendingReply,
+        isLoadingConversation = isLoadingConversation,
+        onReplyMessageChange = viewModel::updateReplyMessage,
+        onSendReply = { message, includeAppLogs ->
+            viewModel.sendReply(message, includeAppLogs)
+        },
+        onOpenReplySheet = { viewModel.updateReplyBottomSheetVisibility(true) },
+        onDismissReplySheet = { viewModel.updateReplyBottomSheetVisibility(false) },
+        onToggleIncludeAppLogs = viewModel::updateReplyIncludeAppLogs,
+        onBackClick = viewModel::onBackClick,
+        modifier = modifier.fillMaxSize(),
+    )
+}
