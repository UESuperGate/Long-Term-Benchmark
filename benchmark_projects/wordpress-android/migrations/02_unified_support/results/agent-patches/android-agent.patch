@@ -0,0 +1,366 @@
+package org.wordpress.android.support.unified.ui
+
+import android.net.Uri
+import androidx.compose.ui.text.AnnotatedString
+import androidx.lifecycle.viewModelScope
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import org.wordpress.android.fluxc.store.AccountStore
+import org.wordpress.android.fluxc.utils.AppLogWrapper
+import org.wordpress.android.support.common.ui.ConversationsSupportViewModel
+import org.wordpress.android.support.unified.model.ConversationReplyFormState
+import org.wordpress.android.support.unified.model.UnifiedConversation
+import org.wordpress.android.support.unified.model.UnifiedMessage
+import org.wordpress.android.support.unified.model.UnifiedMessageAuthorRole
+import org.wordpress.android.support.unified.model.UnifiedSupportStatus
+import org.wordpress.android.support.unified.repository.UnifiedSupportRepository
+import org.wordpress.android.support.unified.repository.UnifiedSupportRequestException
+import org.wordpress.android.support.unified.util.AttachmentStateValidator
+import org.wordpress.android.support.unified.util.EncryptedAppLogsUploader
+import org.wordpress.android.support.unified.util.TempAttachmentsUtil
+import org.wordpress.android.util.AppLog
+import org.wordpress.android.util.NetworkUtilsWrapper
+import java.util.Date
+import javax.inject.Inject
+
+/**
+ * View model backing the single "Get help" surface.
+ *
+ * It serves bot conversations and Happiness Engineer tickets from one list and one detail screen:
+ * the kind of conversation is derived from the conversation status, and both kinds share the same
+ * create/reply lifecycle. All of the state is kept here so it survives page recreation, and the
+ * reply form is bound to the selected conversation so a draft can never leak to another one.
+ */
+@HiltViewModel
+class UnifiedSupportViewModel @Inject constructor(
+    accountStore: AccountStore,
+    private val repository: UnifiedSupportRepository,
+    private val tempAttachmentsUtil: TempAttachmentsUtil,
+    private val attachmentStateValidator: AttachmentStateValidator,
+    private val encryptedAppLogsUploader: EncryptedAppLogsUploader,
+    private val ioDispatcher: CoroutineDispatcher,
+    appLogWrapper: AppLogWrapper,
+    networkUtilsWrapper: NetworkUtilsWrapper,
+) : ConversationsSupportViewModel<UnifiedConversation>(
+    accountStore = accountStore,
+    appLogWrapper = appLogWrapper,
+    networkUtilsWrapper = networkUtilsWrapper,
+) {
+
+    private val _isSendingReply = MutableStateFlow(false)
+    val isSendingReply: StateFlow<Boolean> = _isSendingReply.asStateFlow()
+
+    // Reply composer state. It lives in the view model so it survives page recreation.
+    private val _replyFormState = MutableStateFlow(ConversationReplyFormState())
+    val replyFormState: StateFlow<ConversationReplyFormState> = _replyFormState.asStateFlow()
+
+    /** Conversation the current reply form belongs to. */
+    @Volatile
+    private var replyFormConversationId: Long? = null
+
+    /** Optimistic messages get negative ids so they never collide with a service assigned id. */
+    private var optimisticMessageCounter = 0L
+
+    init {
+        // The reply form belongs to one selected conversation: when a different conversation gets
+        // selected the draft is dropped so text, attachments, app log selection and the visibility
+        // of the reply sheet cannot leak into the newly opened conversation.
+        viewModelScope.launch {
+            _selectedConversation.collect { conversation -> onConversationSelected(conversation) }
+        }
+    }
+
+    // region conversations
+
+    override fun initRepository(accessToken: String) {
+        repository.init(accessToken, accountStore.account.userId)
+    }
+
+    /**
+     * A failed request is surfaced as an error instead of an empty successful list, so retrying
+     * goes through this very same repository path and can replace the error state.
+     */
+    override suspend fun getConversations(): List<UnifiedConversation> =
+        repository.loadConversations()
+            ?: throw UnifiedSupportRequestException("Error loading unified support conversations")
+
+    override suspend fun getConversation(conversationId: Long): UnifiedConversation? =
+        repository.loadConversation(conversationId)
+
+    /**
+     * Opens the conversation with [conversationId]. Known conversations are taken from the list so
+     * the row the user tapped is the conversation that gets opened.
+     */
+    fun onConversationClick(conversationId: Long) {
+        val conversation = _conversations.value.firstOrNull { it.id == conversationId }
+            ?: UnifiedConversation(
+                id = conversationId,
+                title = "",
+                description = "",
+                status = UnifiedSupportStatus.UNKNOWN,
+                canAcceptReply = true,
+                createdAt = Date(),
+                updatedAt = Date(),
+                messages = emptyList(),
+            )
+        onConversationClick(conversation)
+    }
+
+    /**
+     * Creates a new bot conversation locally. The conversation only reaches the service with the
+     * first send, which creates the conversation through the bot creation bridge.
+     */
+    fun onCreateNewBotConversationClick() {
+        viewModelScope.launch {
+            if (!networkUtilsWrapper.isNetworkAvailable()) {
+                _errorMessage.value = ErrorType.OFFLINE
+                return@launch
+            }
+
+            val now = Date()
+            val localConversation = UnifiedConversation(
+                id = UnifiedConversation.NEW_CONVERSATION_ID,
+                title = "",
+                description = "",
+                status = UnifiedSupportStatus.BOT,
+                canAcceptReply = true,
+                createdAt = now,
+                updatedAt = now,
+                messages = emptyList(),
+            )
+            clearReplyForm()
+            setNewConversation(localConversation)
+        }
+    }
+
+    // endregion
+
+    // region reply
+
+    /**
+     * Sends the composer content to the selected conversation.
+     *
+     * The sending guard is taken synchronously, before any asynchronous work starts, so a second
+     * send issued while a send is in flight can never reach the repository. When the device is
+     * offline the draft is kept, the offline error is exposed and the repository is not called.
+     */
+    @Synchronized
+    fun sendReply(message: String, includeAppLogs: Boolean = false) {
+        if (_isSendingReply.value) {
+            appLogWrapper.d(
+                AppLog.T.SUPPORT,
+                "Ignoring a duplicated unified support reply: a reply is already being sent"
+            )
+            return
+        }
+
+        val conversation = _selectedConversation.value
+        if (conversation == null) {
+            appLogWrapper.e(
+                AppLog.T.SUPPORT,
+                "Error sending a unified support reply: no conversation selected"
+            )
+            return
+        }
+
+        // Offline is detected before anything is optimistically inserted, so the transcript keeps
+        // showing the last known state and the draft stays available for a later retry.
+        if (!networkUtilsWrapper.isNetworkAvailable()) {
+            _errorMessage.value = ErrorType.OFFLINE
+            return
+        }
+
+        _isSendingReply.value = true
+
+        val formState = _replyFormState.value
+        val optimisticMessage = createOptimisticMessage(message)
+
+        // Show the user message right away and clear the input while the request is pending.
+        _selectedConversation.value = conversation.copy(
+            messages = conversation.messages + optimisticMessage
+        )
+        _replyFormState.value = formState.copy(message = "")
+
+        viewModelScope.launch(ioDispatcher) {
+            sendReplyRequest(
+                conversation = conversation,
+                message = message,
+                formState = formState,
+                includeAppLogs = includeAppLogs,
+                optimisticMessage = optimisticMessage,
+            )
+        }
+    }
+
+    private suspend fun sendReplyRequest(
+        conversation: UnifiedConversation,
+        message: String,
+        formState: ConversationReplyFormState,
+        includeAppLogs: Boolean,
+        optimisticMessage: UnifiedMessage,
+    ) {
+        try {
+            val updatedConversation = dispatchReply(
+                conversation = conversation,
+                message = message,
+                formState = formState,
+                includeAppLogs = includeAppLogs,
+            )
+
+            if (updatedConversation != null) {
+                onReplySent(
+                    previousConversation = conversation,
+                    updatedConversation = updatedConversation,
+                    isLocalDraft = conversation.isLocalDraft,
+                )
+            } else {
+                onReplyFailed(optimisticMessage, message)
+            }
+        } catch (throwable: Throwable) {
+            appLogWrapper.e(
+                AppLog.T.SUPPORT,
+                "Error sending a unified support reply: ${throwable.message} - " +
+                        "${throwable.stackTraceToString()}"
+            )
+            onReplyFailed(optimisticMessage, message)
+        } finally {
+            _isSendingReply.value = false
+        }
+    }
+
+    /**
+     * Executes at most one create-or-reply operation and always cleans the temporary attachment
+     * files it created, no matter whether the remote call succeeded or failed.
+     */
+    private suspend fun dispatchReply(
+        conversation: UnifiedConversation,
+        message: String,
+        formState: ConversationReplyFormState,
+        includeAppLogs: Boolean,
+    ): UnifiedConversation? {
+        if (conversation.isLocalDraft) {
+            return repository.createNewBotConversation(message)
+        }
+
+        val encryptedLogIds = if (includeAppLogs) encryptedAppLogsUploader.uploadLogs() else emptyList()
+        val tempFiles = tempAttachmentsUtil.createTempFilesFrom(formState.attachmentState.acceptedUris)
+        return try {
+            repository.replyToConversation(
+                conversationId = conversation.id,
+                message = message,
+                attachments = tempFiles.map { it.path },
+                encryptedLogIds = encryptedLogIds,
+            )
+        } finally {
+            tempAttachmentsUtil.removeTempFiles(tempFiles)
+        }
+    }
+
+    private fun onReplySent(
+        previousConversation: UnifiedConversation,
+        updatedConversation: UnifiedConversation,
+        isLocalDraft: Boolean,
+    ) {
+        // A conversation that only exists locally keeps the question the user asked and appends the
+        // answer the service sent back. An existing conversation is replaced by the service state.
+        val finalConversation = if (isLocalDraft) {
+            updatedConversation.copy(
+                messages = (previousConversation.messages + updatedConversation.messages)
+                    .distinctBy { it.id }
+            )
+        } else {
+            updatedConversation
+        }
+
+        _conversations.value = replaceConversation(finalConversation)
+        _selectedConversation.value = finalConversation
+        clearReplyForm()
+    }
+
+    private fun onReplyFailed(optimisticMessage: UnifiedMessage, message: String) {
+        // Only the optimistic message is rolled back; every pre-existing message is left untouched.
+        _selectedConversation.value = _selectedConversation.value?.let { conversation ->
+            conversation.copy(
+                messages = conversation.messages.filterNot { it.id == optimisticMessage.id }
+            )
+        }
+
+        // The conversation stays retryable: the sent text comes back unless the user already typed
+        // something newer, in which case the newer text wins.
+        val currentFormState = _replyFormState.value
+        if (currentFormState.message.isEmpty()) {
+            _replyFormState.value = currentFormState.copy(message = message)
+        }
+
+        _errorMessage.value = ErrorType.GENERAL
+    }
+
+    private fun replaceConversation(conversation: UnifiedConversation): List<UnifiedConversation> =
+        _conversations.value.let { conversations ->
+            if (conversations.none { it.id == conversation.id }) {
+                listOf(conversation) + conversations
+            } else {
+                conversations.map { if (it.id == conversation.id) conversation else it }
+            }
+        }
+
+    private fun createOptimisticMessage(text: String): UnifiedMessage = UnifiedMessage(
+        id = -(++optimisticMessageCounter),
+        formattedText = AnnotatedString(text),
+        authorRole = UnifiedMessageAuthorRole.USER,
+        authorName = "",
+        createdAt = Date(),
+        attachments = emptyList(),
+    )
+
+    // endregion
+
+    // region reply form
+
+    fun addReplyAttachments(uris: List<Uri>) {
+        viewModelScope.launch(ioDispatcher) {
+            val currentState = _replyFormState.value
+            val newState = attachmentStateValidator.addAttachments(currentState.attachmentState, uris)
+            _replyFormState.value = currentState.copy(attachmentState = newState)
+        }
+    }
+
+    fun removeReplyAttachment(uri: Uri) {
+        viewModelScope.launch(ioDispatcher) {
+            val currentState = _replyFormState.value
+            val newState = attachmentStateValidator.removeAttachment(currentState.attachmentState, uri)
+            _replyFormState.value = currentState.copy(attachmentState = newState)
+        }
+    }
+
+    fun updateReplyMessage(message: String) {
+        _replyFormState.value = _replyFormState.value.copy(message = message)
+    }
+
+    fun updateReplyIncludeAppLogs(include: Boolean) {
+        _replyFormState.value = _replyFormState.value.copy(includeAppLogs = include)
+    }
+
+    fun updateReplyBottomSheetVisibility(isVisible: Boolean) {
+        _replyFormState.value = _replyFormState.value.copy(isBottomSheetVisible = isVisible)
+    }
+
+    fun clearReplyForm() {
+        _replyFormState.value = ConversationReplyFormState()
+    }
+
+    private fun onConversationSelected(conversation: UnifiedConversation?) {
+        val conversationId = conversation?.id
+        if (replyFormConversationId == conversationId) {
+            return
+        }
+        replyFormConversationId = conversationId
+        clearReplyForm()
+    }
+
+    // endregion
+}
