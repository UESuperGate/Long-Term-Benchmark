+package org.wordpress.android.support.unified.ui
+
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.material3.Button
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.semantics.contentDescription
+import androidx.compose.ui.semantics.semantics
+import androidx.compose.ui.unit.dp
+import org.wordpress.android.support.common.ui.ConversationsSupportViewModel
+import org.wordpress.android.support.unified.model.UnifiedConversation
+
+/**
+ * The single "Get help" list.
+ *
+ * Bot conversations and Happiness Engineer tickets are rendered by the same list: a bot row is
+ * identified as a bot conversation, while a ticket row keeps showing its own ticket status.
+ * A failed request is rendered as an error or offline state, never as an empty successful list,
+ * and the retry action goes through the very same unified repository path.
+ */
+@Composable
+fun UnifiedSupportConversationsListScreen(
+    conversations: List<UnifiedConversation>,
+    conversationsState: ConversationsSupportViewModel.ConversationsState,
+    errorMessage: ConversationsSupportViewModel.ErrorType?,
+    onConversationClick: (UnifiedConversation) -> Unit,
+    onCreateNewBotConversationClick: () -> Unit,
+    onRetryClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier.fillMaxSize()) {
+        Text(
+            text = UnifiedSupportStrings.GET_HELP_TITLE,
+            modifier = Modifier.padding(16.dp),
+        )
+
+        when {
+            conversationsState is ConversationsSupportViewModel.ConversationsState.NoNetwork ||
+                errorMessage == ConversationsSupportViewModel.ErrorType.OFFLINE -> {
+                ErrorState(
+                    message = UnifiedSupportStrings.OFFLINE_TITLE,
+                    onRetryClick = onRetryClick,
+                )
+            }
+
+            conversationsState is ConversationsSupportViewModel.ConversationsState.Error ||
+                errorMessage == ConversationsSupportViewModel.ErrorType.GENERAL ||
+                errorMessage == ConversationsSupportViewModel.ErrorType.FORBIDDEN -> {
+                ErrorState(
+                    message = UnifiedSupportStrings.LOAD_ERROR_TITLE,
+                    onRetryClick = onRetryClick,
+                )
+            }
+
+            conversationsState is ConversationsSupportViewModel.ConversationsState.Loading ||
+                conversationsState is ConversationsSupportViewModel.ConversationsState.Refreshing -> {
+                Text(
+                    text = UnifiedSupportStrings.LOADING,
+                    modifier = Modifier.padding(16.dp),
+                )
+            }
+
+            conversations.isEmpty() -> {
+                Text(
+                    text = UnifiedSupportStrings.NEW_CONVERSATION,
+                    modifier = Modifier.padding(16.dp),
+                )
+            }
+
+            else -> {
+                LazyColumn(
+                    modifier = Modifier.fillMaxWidth(),
+                    verticalArrangement = Arrangement.spacedBy(4.dp),
+                ) {
+                    items(items = conversations, key = { it.getConversationId() }) { conversation ->
+                        UnifiedConversationRow(
+                            conversation = conversation,
+                            onClick = { onConversationClick(conversation) },
+                        )
+                    }
+                }
+            }
+        }
+
+        Button(
+            onClick = onCreateNewBotConversationClick,
+            modifier = Modifier.padding(16.dp),
+        ) {
+            Text(UnifiedSupportStrings.NEW_CONVERSATION)
+        }
+    }
+}
+
+@Composable
+private fun UnifiedConversationRow(
+    conversation: UnifiedConversation,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(
+        modifier = modifier
+            .fillMaxWidth()
+            .clickable(onClick = onClick)
+            .padding(16.dp)
+            .semantics { contentDescription = conversationRowDescription(conversation) },
+    ) {
+        Text(text = conversation.title.ifEmpty { UnifiedSupportStrings.GET_HELP_TITLE })
+        Text(
+            text = if (conversation.isBot) {
+                UnifiedSupportStrings.BOT_BADGE
+            } else {
+                conversation.status
+            }
+        )
+        if (conversation.description.isNotEmpty()) {
+            Text(text = conversation.description)
+        }
+    }
+}
+
+@Composable
+private fun ErrorState(
+    message: String,
+    onRetryClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(
+        modifier = modifier.fillMaxWidth().padding(16.dp),
+        verticalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+        Text(text = message)
+        Button(onClick = onRetryClick) {
+            Text(UnifiedSupportStrings.RETRY_LABEL)
+        }
+    }
+}
+
+private fun conversationRowDescription(conversation: UnifiedConversation): String =
+    if (conversation.isBot) {
+        "${UnifiedSupportStrings.BOT_BADGE} conversation"
+    } else {
+        "Ticket ${conversation.status}"
+    }
