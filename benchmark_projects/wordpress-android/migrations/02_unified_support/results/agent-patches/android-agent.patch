+package org.wordpress.android.support.unified.ui
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Button
+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Surface
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.semantics.contentDescription
+import androidx.compose.ui.semantics.semantics
+import androidx.compose.ui.unit.dp
+import org.wordpress.android.support.unified.model.UnifiedConversation
+
+/**
+ * Bottom bar of the unified conversation detail experience.
+ *
+ * The affordance is derived from the conversation itself, never from the surface the conversation
+ * was opened from:
+ *  - a bot conversation keeps the chat composer inline with the transcript;
+ *  - a replyable Happiness Engineer ticket exposes the action that opens the reply sheet;
+ *  - a closed ticket exposes no reply action at all.
+ */
+@Composable
+fun ConversationBottomBar(
+    conversation: UnifiedConversation,
+    replyText: String,
+    isSendingReply: Boolean,
+    onReplyTextChange: (String) -> Unit,
+    onSendClick: (String) -> Unit,
+    onOpenReplySheetClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Surface(
+        modifier = modifier.fillMaxWidth(),
+        tonalElevation = 2.dp,
+    ) {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(horizontal = 12.dp, vertical = 8.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            when {
+                conversation.showsInlineComposer -> {
+                    OutlinedTextField(
+                        value = replyText,
+                        onValueChange = onReplyTextChange,
+                        enabled = !isSendingReply,
+                        maxLines = 4,
+                        placeholder = { Text(UnifiedSupportStrings.BOT_COMPOSER_HINT) },
+                        modifier = Modifier
+                            .weight(1f)
+                            .semantics {
+                                contentDescription = UnifiedSupportStrings.BOT_COMPOSER_CONTENT_DESCRIPTION
+                            },
+                    )
+                    Button(
+                        onClick = { onSendClick(replyText) },
+                        enabled = !isSendingReply && replyText.isNotBlank(),
+                        modifier = Modifier.semantics {
+                            contentDescription = UnifiedSupportStrings.SEND_CONTENT_DESCRIPTION
+                        },
+                    ) {
+                        Text(UnifiedSupportStrings.SEND_LABEL)
+                    }
+                }
+
+                conversation.showsReplyAction -> {
+                    Button(
+                        onClick = onOpenReplySheetClick,
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .semantics {
+                                contentDescription = UnifiedSupportStrings.REPLY_CONTENT_DESCRIPTION
+                            },
+                    ) {
+                        Text(UnifiedSupportStrings.REPLY_LABEL)
+                    }
+                }
+
+                else -> {
+                    // Closed tickets have nothing to reply to, so the bar stays empty on purpose.
+                    Box(modifier = Modifier.fillMaxWidth())
+                }
+            }
+        }
+    }
+}
