@@ -0,0 +1,31 @@
+package org.wordpress.android.support.unified.model
+
+/**
+ * Status values used by the unified support conversations endpoint.
+ *
+ * Both bot and Happiness Engineer conversations travel through the same endpoint, so the status
+ * string is what tells both the app and the server which kind of conversation is being handled:
+ * a `bot` status identifies a bot conversation, every other value is a Happiness Engineer ticket
+ * keeping its own ticket status (`open`, `pending`, `closed`, `solved`, ...).
+ */
+object UnifiedSupportStatus {
+    const val BOT = "bot"
+    const val OPEN = "open"
+    const val PENDING = "pending"
+    const val CLOSED = "closed"
+    const val SOLVED = "solved"
+    const val UNKNOWN = "unknown"
+
+    fun normalize(status: String): String = status.trim().lowercase()
+
+    fun isBot(status: String): Boolean = normalize(status) == BOT
+
+    /**
+     * A conversation can only take a reply while it is still open. Bot conversations are always
+     * replyable, and every ticket status other than `closed`/`solved` keeps the reply affordance.
+     */
+    fun canAcceptReply(status: String): Boolean = when (normalize(status)) {
+        CLOSED, SOLVED -> false
+        else -> true
+    }
+}
