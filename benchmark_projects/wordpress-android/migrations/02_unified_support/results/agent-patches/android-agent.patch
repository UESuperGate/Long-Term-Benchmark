+package org.wordpress.android.support.unified.model
+
+/**
+ * Reply composer state. It belongs to the conversation that is currently selected, so opening a
+ * different conversation resets it (see [org.wordpress.android.support.unified.ui.UnifiedSupportViewModel]).
+ */
+data class ConversationReplyFormState(
+    val message: String = "",
+    val includeAppLogs: Boolean = false,
+    val attachmentState: AttachmentState = AttachmentState(),
+    val isBottomSheetVisible: Boolean = false,
+)
