+package org.wordpress.android.support.unified.model
+
+import androidx.compose.runtime.Immutable
+import androidx.compose.ui.text.AnnotatedString
+import java.util.Date
+
+/**
+ * Author roles used by the unified conversations endpoint.
+ *
+ * Bot conversations report `user`/`bot` while Happiness Engineer tickets report `user`/`agent`,
+ * so both kinds of conversation can be rendered with the same transcript component.
+ */
+object UnifiedMessageAuthorRole {
+    const val USER = "user"
+    const val BOT = "bot"
+    const val AGENT = "agent"
+}
+
+@Immutable
+data class UnifiedMessage(
+    val id: Long,
+    val formattedText: AnnotatedString,
+    val authorRole: String,
+    val authorName: String,
+    val createdAt: Date,
+    val attachments: List<UnifiedAttachment>,
+) {
+    val isUser: Boolean
+        get() = authorRole.trim().lowercase() == UnifiedMessageAuthorRole.USER
+}
+
+@Immutable
+data class UnifiedAttachment(
+    val id: Long,
+    val filename: String,
+    val url: String,
+    val type: String,
+) {
+    val isImage: Boolean
+        get() = type.startsWith("image/", ignoreCase = true)
+
+    val isVideo: Boolean
+        get() = type.startsWith("video/", ignoreCase = true)
+}
