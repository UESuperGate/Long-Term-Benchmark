@@ -0,0 +1,53 @@
+package org.wordpress.android.support.unified.model
+
+import org.wordpress.android.support.common.model.Conversation
+import java.util.Date
+
+/**
+ * A single entry of the unified "Get help" list.
+ *
+ * Bot conversations and Happiness Engineer tickets share this single model: a conversation is a bot
+ * conversation when its [status] is `bot`, otherwise it is a ticket keeping its own ticket status.
+ * Everything the UI needs to render the conversation – whether a reply can be sent, which
+ * affordance to show – is derived from [status].
+ */
+data class UnifiedConversation(
+    val id: Long,
+    val title: String,
+    val description: String,
+    val status: String,
+    val canAcceptReply: Boolean,
+    val createdAt: Date,
+    val updatedAt: Date,
+    val messages: List<UnifiedMessage>,
+) : Conversation {
+    override fun getConversationId(): Long = id
+
+    /** `true` when the conversation is handled by the bot instead of a Happiness Engineer. */
+    val isBot: Boolean
+        get() = UnifiedSupportStatus.isBot(status)
+
+    /** `true` when the transcript is rendered with an inline chat composer. */
+    val showsInlineComposer: Boolean
+        get() = isBot
+
+    /** `true` when the reply is sent through the reply bottom sheet action. */
+    val showsReplyAction: Boolean
+        get() = !isBot && canAcceptReply
+
+    /** `true` when the ticket was closed and the transcript shows the closed banner. */
+    val isClosed: Boolean
+        get() = UnifiedSupportStatus.normalize(status) == UnifiedSupportStatus.CLOSED
+
+    /** Identifier used by the locally created conversation before the bot conversation exists. */
+    val isLocalDraft: Boolean
+        get() = id == NEW_CONVERSATION_ID
+
+    companion object {
+        /**
+         * Local conversations are created optimistically with this identifier. The real bot
+         * conversation id only exists once the first send has been accepted by the service.
+         */
+        const val NEW_CONVERSATION_ID = 0L
+    }
+}
