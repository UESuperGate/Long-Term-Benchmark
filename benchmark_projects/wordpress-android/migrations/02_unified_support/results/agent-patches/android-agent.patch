@@ -0,0 +1,17 @@
+package org.wordpress.android.support.unified
+
+/**
+ * Destinations offered by the support menu.
+ *
+ * The separate "Ask the bots" and "Ask Happiness Engineers" entries have been retired and replaced
+ * by a single [GET_HELP] entry, which is backed by the unified list and repository path: it lists
+ * bot conversations and Happiness Engineer tickets together and opens the shared detail experience
+ * for both kinds of conversation.
+ */
+enum class SupportDestination {
+    GET_HELP,
+    HELP_CENTER,
+    APPLICATION_LOGS,
+    LOGIN,
+    NETWORK_REQUESTS,
+}
\ No newline at end of file
