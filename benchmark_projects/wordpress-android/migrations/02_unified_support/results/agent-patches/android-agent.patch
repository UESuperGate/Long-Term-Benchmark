+package org.wordpress.android.support.unified.model
+
+import android.net.Uri
+
+/**
+ * Attachments the user picked for a reply. The state is kept by the view model so it survives
+ * page recreation and it is cleared whenever a different conversation gets selected.
+ */
+data class AttachmentState(
+    val acceptedUris: List<Uri> = emptyList(),
+    val rejectedUris: List<Uri> = emptyList(),
+    val currentTotalSizeBytes: Long = 0L,
+    val rejectedTotalSizeBytes: Long = 0L,
+)
