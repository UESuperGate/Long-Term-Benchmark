{
  "schemaVersion": 1,
  "taskId": "03_site_picker",
  "platform": "android",
  "controls": [
    {
      "name": "missing_source_manifest",
      "mutation": "remove candidate final/upstream-source-manifest.json",
      "scorerExit": 1,
      "semantic": {"passed": 0, "failed": 0, "notScored": 10, "total": 10},
      "adapter": "incomplete",
      "diagnostic": "missing upstream-source-manifest.json"
    },
    {
      "name": "compiled_source_byte_mismatch",
      "mutation": "append one newline byte to candidate compiled SiteViewModel.kt",
      "scorerExit": 1,
      "semantic": {"passed": 0, "failed": 0, "notScored": 10, "total": 10},
      "adapter": "incomplete",
      "diagnostic": "compiled production byte mismatch"
    },
    {
      "name": "missing_candidate_identity",
      "mutation": "remove candidate final/build.gradle.kts",
      "scorerExit": 1,
      "semantic": {"passed": 0, "failed": 0, "notScored": 10, "total": 10},
      "adapter": "incomplete",
      "diagnostic": "candidate application identity unavailable"
    }
  ],
  "candidateDirectories": "fresh random TemporaryDirectory copies",
  "candidateDirectoriesRemoved": true,
  "passOrFailFabricatedFromBindingErrors": false
}
