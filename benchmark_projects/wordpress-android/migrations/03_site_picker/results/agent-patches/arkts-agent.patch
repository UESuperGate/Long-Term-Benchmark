index 0000000000000000000000000000000000000000..1866c415c1aa0c095d0df85193fafe5735530bc6
--- /dev/null
+++ b/entry/src/main/ets/feature/SitePickerViewModel.ets
@@ -0,0 +1,208 @@
+import {
+  SITE_EMPTY_NO_MATCHES,
+  SITE_EMPTY_NO_SITES,
+  SITE_EMPTY_NONE,
+  SITE_RECENT_LIMIT,
+  SITE_SECTION_ALL,
+  SITE_SECTION_PINNED,
+  SITE_SECTION_RECENT,
+  SITE_SECTION_SEARCH,
+  SitePickerRow,
+  SiteRecord,
+  SiteSection
+} from './SitePickerModels';
+
+/**
+ * Pure derivation of the picker list.
+ *
+ * Grouping rules:
+ *  - the pinned section lists every pinned site that is still owned, in store order;
+ *  - the recent section lists the most recently accessed sites first and never
+ *    repeats a pinned site;
+ *  - every remaining site is listed once in the trailing section.
+ */
+export class SitePickerViewModel {
+  static normalize(values: Object[]): SiteRecord[] {
+    const catalog: SiteRecord[] = [];
+    if (values === undefined || values === null) {
+      return catalog;
+    }
+    for (let index = 0; index < values.length; index++) {
+      const record: SiteRecord | undefined = SiteRecord.fromValue(values[index]);
+      if (record === undefined || catalog.length === 0 || SitePickerViewModel.contains(catalog, record.localId)) {
+        continue;
+      }
+      catalog.push(record);
+    }
+    return catalog;
+  }
+
+  static contains(catalog: SiteRecord[], localId: number): boolean {
+    for (let index = 0; index < catalog.length; index++) {
+      if (catalog[index].localId === localId) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  static find(catalog: SiteRecord[], localId: number): SiteRecord | undefined {
+    for (let index = 0; index < catalog.length; index++) {
+      if (catalog[index].localId === localId) {
+        return catalog[index];
+      }
+    }
+    return undefined;
+  }
+
+  static idList(catalog: SiteRecord[]): number[] {
+    const ids: number[] = [];
+    for (let index = 0; index < catalog.length; index++) {
+      ids.push(catalog[index].localId);
+    }
+    return ids;
+  }
+
+  static includes(values: number[], localId: number): boolean {
+    for (let index = 0; index < values.length; index++) {
+      if (values[index] === localId) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  /** Pinned, recent and remaining sites, in that order. */
+  static sectionsFor(catalog: SiteRecord[], pinned: number[], recent: number[]): SiteSection[] {
+    const pinnedIds: number[] = [];
+    for (let index = 0; index < catalog.length; index++) {
+      const localId: number = catalog[index].localId;
+      if (SitePickerViewModel.includes(pinned, localId)) {
+        pinnedIds.push(localId);
+      }
+    }
+
+    const recentIds: number[] = [];
+    for (let index = 0; index < recent.length && recentIds.length < SITE_RECENT_LIMIT; index++) {
+      const localId: number = recent[index];
+      if (SitePickerViewModel.includes(pinnedIds, localId)) {
+        continue;
+      }
+      if (SitePickerViewModel.includes(recentIds, localId)) {
+        continue;
+      }
+      if (!SitePickerViewModel.contains(catalog, localId)) {
+        continue;
+      }
+      recentIds.push(localId);
+    }
+
+    const remainingIds: number[] = [];
+    for (let index = 0; index < catalog.length; index++) {
+      const localId: number = catalog[index].localId;
+      if (SitePickerViewModel.includes(pinnedIds, localId) || SitePickerViewModel.includes(recentIds, localId)) {
+        continue;
+      }
+      remainingIds.push(localId);
+    }
+
+    const sections: SiteSection[] = [];
+    sections.push(new SiteSection(SITE_SECTION_PINNED, pinnedIds));
+    sections.push(new SiteSection(SITE_SECTION_RECENT, recentIds));
+    sections.push(new SiteSection(SITE_SECTION_ALL, remainingIds));
+    return sections;
+  }
+
+  static search(catalog: SiteRecord[], query: string): SiteRecord[] {
+    const matches: SiteRecord[] = [];
+    const needle: string = query.trim();
+    if (needle.length === 0) {
+      return matches;
+    }
+    for (let index = 0; index < catalog.length; index++) {
+      if (catalog[index].matches(needle)) {
+        matches.push(catalog[index]);
+      }
+    }
+    return matches;
+  }
+
+  /** A search replaces the grouped view with the matching sites only. */
+  static searchSections(catalog: SiteRecord[], query: string): SiteSection[] {
+    const sections: SiteSection[] = [];
+    sections.push(new SiteSection(SITE_SECTION_SEARCH, SitePickerViewModel.idList(SitePickerViewModel.search(catalog, query))));
+    return sections;
+  }
+
+  static flatten(sections: SiteSection[]): number[] {
+    const ordered: number[] = [];
+    for (let index = 0; index < sections.length; index++) {
+      const ids: number[] = sections[index].localIds;
+      for (let inner = 0; inner < ids.length; inner++) {
+        if (!SitePickerViewModel.includes(ordered, ids[inner])) {
+          ordered.push(ids[inner]);
+        }
+      }
+    }
+    return ordered;
+  }
+
+  static rowsFor(catalog: SiteRecord[], sections: SiteSection[], pinned: number[], activeLocalId: number,
+    selectEnabled: boolean, pinControlVisible: boolean): SitePickerRow[] {
+    const rows: SitePickerRow[] = [];
+    const ordered: number[] = SitePickerViewModel.flatten(sections);
+    for (let index = 0; index < ordered.length; index++) {
+      const record: SiteRecord | undefined = SitePickerViewModel.find(catalog, ordered[index]);
+      if (record === undefined) {
+        continue;
+      }
+      const row: SitePickerRow = new SitePickerRow();
+      row.localId = record.localId;
+      row.name = record.name;
+      row.host = record.host;
+      row.section = SitePickerViewModel.sectionOf(sections, record.localId);
+      row.pinned = SitePickerViewModel.includes(pinned, record.localId);
+      row.active = record.localId === activeLocalId;
+      row.selectEnabled = selectEnabled;
+      row.pinControlVisible = pinControlVisible;
+      row.wpComAccessible = record.wpComAccessible;
+      rows.push(row);
+    }
+    return rows;
+  }
+
+  static sectionOf(sections: SiteSection[], localId: number): string {
+    for (let index = 0; index < sections.length; index++) {
+      if (SitePickerViewModel.includes(sections[index].localIds, localId)) {
+        return sections[index].name;
+      }
+    }
+    return SITE_SECTION_ALL;
+  }
+
+  static emptyStateFor(siteCount: number, searching: boolean, matchCount: number): string {
+    if (searching) {
+      return matchCount === 0 ? SITE_EMPTY_NO_MATCHES : SITE_EMPTY_NONE;
+    }
+    return siteCount === 0 ? SITE_EMPTY_NO_SITES : SITE_EMPTY_NONE;
+  }
+
+  /** Most recently accessed first, bounded, without dropping the chosen site. */
+  static promoteRecent(recent: number[], localId: number): number[] {
+    const promoted: number[] = [];
+    if (SitePickerViewModel.includes(recent, localId)) {
+      promoted.push(localId);
+    }
+    for (let index = 0; index < recent.length; index++) {
+      const candidate: number = recent[index];
+      if (candidate === localId || SitePickerViewModel.includes(promoted, candidate)) {
+        continue;
+      }
+      promoted.push(candidate);
+    }
+    while (promoted.length > SITE_RECENT_LIMIT) {
+      promoted.pop();
+    }
+    return promoted;
+  }
+}
