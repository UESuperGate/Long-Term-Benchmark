@@ -0,0 +1,771 @@
+import { common } from '@kit.AbilityKit';
+import { preferences } from '@kit.ArkData';
+import { SitePickerEffect, SitePickerInput, SitePickerLeaf } from '../integration/SitePickerPageIntegration';
+import {
+  SITE_ACTION_NONE,
+  SITE_ACTION_PIN,
+  SITE_EMPTY_NO_MATCHES,
+  SITE_EMPTY_NO_SITES,
+  SITE_MODE_DEFAULT,
+  SITE_REFRESH_FAILED,
+  SITE_REFRESH_IDLE,
+  SITE_REFRESH_RUNNING,
+  SITE_REFRESH_SUCCEEDED,
+  SITE_RESULT_ERROR,
+  SITE_RESULT_SELECTED,
+  SitePickerCommandEvent,
+  SitePickerSnapshot,
+  SitePickerStoreObserver,
+  SiteRecord,
+  SiteSection,
+  SiteSelectionResult,
+  cloneDocument,
+  emptyDocument,
+  hasField,
+  readFlag,
+  readNumber,
+  readNumberList,
+  readObjectList,
+  readText
+} from './SitePickerModels';
+import { SitePickerViewModel } from './SitePickerViewModel';
+
+const PICKER_PREFERENCES_NAME: string = 'wordpress_site_picker';
+const PICKER_STATE_KEY: string = 'state';
+const PICKER_PERSISTENCE_KEY: string = 'persistence';
+
+const PINNED_KEY: string = 'persistedPinnedLocalIds';
+const RECENT_KEY: string = 'persistedRecentLocalIds';
+const ACTIVE_SITE_KEY: string = 'selectedLocalId';
+
+const OUTCOME_ERROR: string = 'error';
+const OUTCOME_FAILURE: string = 'failure';
+const OUTCOME_FAILED: string = 'failed';
+const OUTCOME_FAIL: string = 'fail';
+const OUTCOME_OFFLINE: string = 'offline';
+
+/**
+ * Application owned state for the redesigned site picker.
+ *
+ * The store owns three things:
+ *  - the site catalog it currently displays,
+ *  - the durable pinned / recently accessed preferences,
+ *  - the presentation state (grouping, search, pin editing, refresh progress)
+ *    that the page renders.
+ *
+ * Every command updates that state, the derived grouping is rebuilt and the
+ * documents are persisted, so reopening the picker always observes what the
+ * user actually did rather than what a previous page happened to render.
+ */
+export class SitePickerStore {
+  private document: Record<string, Object> = emptyDocument();
+  private durable: Record<string, Object> = emptyDocument();
+  private readonly prefs: preferences.Preferences;
+  private readonly leaf: SitePickerLeaf;
+  private liveDocument?: Record<string, Object>;
+  private liveDurable?: Record<string, Object>;
+  private catalogSource: Object[] = [];
+  private catalog: SiteRecord[] = [];
+  private observers: SitePickerStoreObserver[] = [];
+  private released: boolean = false;
+
+  private constructor(store: preferences.Preferences, input: SitePickerInput) {
+    this.prefs = store;
+    this.leaf = input.leaf;
+    this.liveDocument = input.state;
+    this.liveDurable = input.persistence;
+  }
+
+  static async create(context: common.UIAbilityContext, input: SitePickerInput,
+    initialize: boolean): Promise<SitePickerStore> {
+    const prefs: preferences.Preferences = await preferences.getPreferences(context, PICKER_PREFERENCES_NAME);
+    if (initialize) {
+      await prefs.clear();
+      await prefs.put(PICKER_STATE_KEY, JSON.stringify(input.state === undefined ? emptyDocument() : input.state));
+      await prefs.put(PICKER_PERSISTENCE_KEY,
+        JSON.stringify(input.persistence === undefined ? emptyDocument() : input.persistence));
+      await prefs.flush();
+    }
+    const store: SitePickerStore = new SitePickerStore(prefs, input);
+    store.document = await SitePickerStore.readDocument(prefs, PICKER_STATE_KEY);
+    store.durable = await SitePickerStore.readDocument(prefs, PICKER_PERSISTENCE_KEY);
+    store.adoptCatalog();
+    store.hydratePreferences();
+    store.recompute();
+    return store;
+  }
+
+  private static async readDocument(prefs: preferences.Preferences, key: string): Promise<Record<string, Object>> {
+    const stored: string = await prefs.get(key, '{}') as string;
+    if (stored === undefined || stored === null || stored.length === 0) {
+      return emptyDocument();
+    }
+    return JSON.parse(stored) as Record<string, Object>;
+  }
+
+  // ---------------------------------------------------------------- accessors
+
+  currentState(): Record<string, Object> {
+    return cloneDocument(this.document);
+  }
+
+  currentPersistence(): Record<string, Object> {
+    return cloneDocument(this.durable);
+  }
+
+  snapshot(): SitePickerSnapshot {
+    const view: SitePickerSnapshot = new SitePickerSnapshot();
+    view.mode = this.mode();
+    view.restricted = this.isRestricted();
+    view.pickerOpen = readFlag(this.document, 'pickerOpen', true);
+    view.actionMode = this.actionMode();
+    view.pinEditingVisible = this.pinEditingVisible();
+    view.addSiteVisible = this.addSiteVisible();
+    view.searching = this.searchQuery().length > 0;
+    view.searchQuery = this.searchQuery();
+    view.searchExpanded = readFlag(this.document, 'searchExpanded', view.searching);
+    view.refreshing = readFlag(this.document, 'refreshing', false);
+    view.refreshStatus = readText(this.document, 'refreshStatus', SITE_REFRESH_IDLE);
+    view.lastRefreshError = readText(this.document, 'lastRefreshError', '');
+    view.siteCount = this.catalog.length;
+    view.activeLocalId = this.activeLocalId();
+    view.sections = this.visibleSections();
+    const ordered: number[] = SitePickerViewModel.flatten(view.sections);
+    view.emptyState = SitePickerViewModel.emptyStateFor(this.catalog.length, view.searching, ordered.length);
+    view.emptyMessage = SitePickerStore.emptyMessage(view.emptyState);
+    view.rows = SitePickerViewModel.rowsFor(this.catalog, view.sections, this.pinnedIds(), view.activeLocalId,
+      this.rowSelectionEnabled(), this.pinEditingVisible());
+    view.resultStatus = readText(this.document, 'resultStatus', '');
+    view.resultLocalId = readNumber(this.document, 'resultLocalId', -1);
+    return view;
+  }
+
+  private static emptyMessage(emptyState: string): string {
+    if (emptyState === SITE_EMPTY_NO_MATCHES) {
+      return 'No sites match this search. Clear the search to see every site.';
+    }
+    if (emptyState === SITE_EMPTY_NO_SITES) {
+      return 'No sites yet. Add a site to get started.';
+    }
+    return '';
+  }
+
+  subscribe(observer: SitePickerStoreObserver): void {
+    if (this.released || this.observers.indexOf(observer) >= 0) {
+      return;
+    }
+    this.observers.push(observer);
+  }
+
+  unsubscribe(observer: SitePickerStoreObserver): void {
+    const index: number = this.observers.indexOf(observer);
+    if (index >= 0) {
+      this.observers.splice(index, 1);
+    }
+  }
+
+  /** Releases observers so a recreated page does not leak callbacks. */
+  release(): void {
+    this.released = true;
+    this.observers = [];
+  }
+
+  // ------------------------------------------------------------------ commands
+
+  async invoke(name: string, event: Record<string, Object>): Promise<void> {
+    if (this.released) {
+      return;
+    }
+    const payload: Record<string, Object> = event === undefined || event === null ? emptyDocument() : event;
+    await this.dispatch(SitePickerStore.commandOf(name), payload);
+    this.recompute();
+    await this.persist();
+  }
+
+  async openSitePicker(): Promise<void> {
+    await this.invoke('openSitePicker', emptyDocument());
+  }
+
+  async closeSitePicker(): Promise<void> {
+    await this.invoke('closePicker', emptyDocument());
+  }
+
+  async selectSite(localId: number): Promise<void> {
+    await this.invoke('selectSite', new SitePickerCommandEvent().put('localId', localId).build());
+  }
+
+  async tapSiteRow(localId: number): Promise<void> {
+    await this.invoke('tapSiteRow', new SitePickerCommandEvent().put('localId', localId).build());
+  }
+
+  async search(query: string): Promise<void> {
+    await this.invoke('enterSearchQuery', new SitePickerCommandEvent().put('query', query).build());
+  }
+
+  async clearSearch(): Promise<void> {
+    await this.invoke('clearSearch', emptyDocument());
+  }
+
+  async beginPinEditing(): Promise<void> {
+    await this.invoke('enterPinMode', emptyDocument());
+  }
+
+  async endPinEditing(): Promise<void> {
+    await this.invoke('exitPinMode', emptyDocument());
+  }
+
+  async togglePin(localId: number): Promise<void> {
+    await this.invoke('togglePin', new SitePickerCommandEvent().put('localId', localId).build());
+  }
+
+  async setPinned(localId: number, pinned: boolean): Promise<void> {
+    await this.invoke(pinned ? 'pinSite' : 'unpinSite', new SitePickerCommandEvent().put('localId', localId).build());
+  }
+
+  async refresh(): Promise<void> {
+    await this.invoke('manualRefresh', emptyDocument());
+  }
+
+  async retryRefresh(): Promise<void> {
+    await this.invoke('retryManualRefresh', emptyDocument());
+  }
+
+  async recreate(): Promise<void> {
+    await this.invoke('recreatePicker', emptyDocument());
+  }
+
+  async addSite(): Promise<void> {
+    await this.invoke('addSite', emptyDocument());
+  }
+
+  // ------------------------------------------------------------------ dispatch
+
+  private static commandOf(name: string): string {
+    if (name === 'openSitePicker' || name === 'openPicker' || name === 'openSiteList') {
+      return 'open';
+    }
+    if (name === 'closePicker' || name === 'dismissPicker' || name === 'close') {
+      return 'close';
+    }
+    if (name === 'selectSite' || name === 'select') {
+      return 'select';
+    }
+    if (name === 'tapSiteRow' || name === 'tapRow' || name === 'clickSiteRow') {
+      return 'tapRow';
+    }
+    if (name === 'longPressSite' || name === 'longPressRow' || name === 'longPress') {
+      return 'longPress';
+    }
+    if (name === 'enterSearchQuery' || name === 'updateSearchQuery' || name === 'enterSearch' ||
+      name === 'search' || name === 'typeSearchQuery') {
+      return 'enterSearch';
+    }
+    if (name === 'clearSearch' || name === 'exitSearch' || name === 'closeSearch' || name === 'leaveSearch') {
+      return 'clearSearch';
+    }
+    if (name === 'enterPinMode' || name === 'startPinEditing' || name === 'editPins' ||
+      name === 'openPinEditor' || name === 'enterEditPins') {
+      return 'enterPinMode';
+    }
+    if (name === 'exitPinMode' || name === 'endPinMode' || name === 'finishPinMode' ||
+      name === 'closePinEditor' || name === 'leavePinMode' || name === 'finishEditingPins') {
+      return 'exitPinMode';
+    }
+    if (name === 'togglePin') {
+      return 'togglePin';
+    }
+    if (name === 'pinSite' || name === 'pin') {
+      return 'pin';
+    }
+    if (name === 'unpinSite' || name === 'unpin') {
+      return 'unpin';
+    }
+    if (name === 'manualRefreshFailure' || name === 'refreshFailed') {
+      return 'refreshFailure';
+    }
+    if (name === 'manualRefresh' || name === 'refresh' || name === 'refreshSites') {
+      return 'manualRefresh';
+    }
+    if (name === 'retryManualRefresh' || name === 'retryRefresh') {
+      return 'retryManualRefresh';
+    }
+    if (name === 'recreatePicker' || name === 'recreate' || name === 'recreatePage') {
+      return 'recreate';
+    }
+    if (name === 'addSite' || name === 'createSite') {
+      return 'addSite';
+    }
+    return 'unknown';
+  }
+
+  private async dispatch(command: string, event: Record<string, Object>): Promise<void> {
+    if (command === 'open') {
+      await this.open();
+      return;
+    }
+    if (command === 'close') {
+      this.close();
+      return;
+    }
+    if (command === 'select') {
+      await this.select(event);
+      return;
+    }
+    if (command === 'tapRow') {
+      await this.tapRow(event);
+      return;
+    }
+    if (command === 'longPress') {
+      // The legacy long press workflow for hiding sites was removed. A long
+      // press leaves the row, the pinned set and the active site untouched.
+      return;
+    }
+    if (command === 'enterSearch') {
+      this.enterSearch(event);
+      return;
+    }
+    if (command === 'clearSearch') {
+      this.resetSearch();
+      return;
+    }
+    if (command === 'enterPinMode') {
+      this.enterPinMode();
+      return;
+    }
+    if (command === 'exitPinMode') {
+      this.exitPinMode();
+      return;
+    }
+    if (command === 'togglePin' || command === 'pin' || command === 'unpin') {
+      this.updatePin(command, event);
+      return;
+    }
+    if (command === 'manualRefresh' || command === 'retryManualRefresh') {
+      await this.runRefresh(event);
+      return;
+    }
+    if (command === 'refreshFailure') {
+      this.finishRefresh(false, 'sites_refresh_failed');
+      return;
+    }
+    if (command === 'recreate') {
+      this.adoptCatalog();
+      return;
+    }
+    if (command === 'addSite') {
+      await this.requestSiteCreation();
+      return;
+    }
+  }
+
+  /** Site creation itself belongs to the host experience; the picker only asks for it. */
+  private async requestSiteCreation(): Promise<void> {
+    if (!this.addSiteVisible()) {
+      return;
+    }
+    try {
+      await this.emit({ name: 'createSite' });
+    } catch (failure) {
+      // The creation flow stays available for another attempt.
+    }
+  }
+
+  private async open(): Promise<void> {
+    this.document['pickerOpen'] = true;
+    this.document['actionMode'] = SITE_ACTION_NONE;
+    this.resetSearch();
+    this.recompute();
+    await this.loadSites();
+  }
+
+  private close(): void {
+    this.document['pickerOpen'] = false;
+    this.document['actionMode'] = SITE_ACTION_NONE;
+  }
+
+  private async loadSites(): Promise<void> {
+    try {
+      await this.emit({ name: 'readSites', source: 'all_sites' });
+    } catch (failure) {
+      // The catalog could not be loaded; keep the last usable list on screen.
+    }
+    this.adoptCatalog();
+  }
+
+  private async select(event: Record<string, Object>): Promise<void> {
+    const localId: number = readNumber(event, 'localId', -1);
+    if (SitePickerViewModel.find(this.catalog, localId) === undefined) {
+      this.publishResult(new SiteSelectionResult(SITE_RESULT_ERROR, localId, 'unknown_site'));
+      return;
+    }
+    this.document['selectedLocalId'] = localId;
+    this.document['activeLocalId'] = localId;
+    this.durable[ACTIVE_SITE_KEY] = localId;
+    this.setRecent(SitePickerViewModel.promoteRecent(this.recentIds(), localId));
+    this.document['pickerOpen'] = false;
+    this.document['actionMode'] = SITE_ACTION_NONE;
+    this.publishResult(new SiteSelectionResult(SITE_RESULT_SELECTED, localId, ''));
+    await this.emit({ name: 'publishSiteSelection', localId: localId });
+  }
+
+  private async tapRow(event: Record<string, Object>): Promise<void> {
+    if (!this.rowSelectionEnabled()) {
+      // While pins are being edited the row body is inert, so a tap can never
+      // select a site: only the explicit pin control changes the pinned set.
+      return;
+    }
+    await this.select(event);
+  }
+
+  private enterSearch(event: Record<string, Object>): void {
+    const query: string = readText(event, 'query', readText(event, 'text', readText(event, 'value', '')));
+    this.document['searchQuery'] = query;
+    this.document['activeSearchQuery'] = query;
+    this.document['searchExpanded'] = query.length > 0;
+  }
+
+  private resetSearch(): void {
+    this.document['searchQuery'] = '';
+    this.document['activeSearchQuery'] = '';
+    this.document['searchExpanded'] = false;
+  }
+
+  private enterPinMode(): void {
+    if (this.isRestricted()) {
+      return;
+    }
+    this.document['actionMode'] = SITE_ACTION_PIN;
+  }
+
+  private exitPinMode(): void {
+    this.document['actionMode'] = SITE_ACTION_NONE;
+  }
+
+  private updatePin(command: string, event: Record<string, Object>): void {
+    if (this.isRestricted()) {
+      return;
+    }
+    const localId: number = readNumber(event, 'localId', -1);
+    if (SitePickerViewModel.find(this.catalog, localId) === undefined) {
+      return;
+    }
+    const pinned: number[] = this.pinnedIds();
+    const isPinned: boolean = SitePickerViewModel.includes(pinned, localId);
+    if (command === 'pin') {
+      if (isPinned) {
+        return;
+      }
+      this.writePinned(this.withPinned(pinned, localId));
+      return;
+    }
+    if (command === 'unpin') {
+      if (!isPinned) {
+        return;
+      }
+      this.writePinned(this.without(pinned, localId));
+      return;
+    }
+    this.writePinned(isPinned ? this.without(pinned, localId) : this.withPinned(pinned, localId));
+  }
+
+  private async runRefresh(event: Record<string, Object>): Promise<void> {
+    if (readFlag(this.document, 'refreshing', false)) {
+      return;
+    }
+    this.document['refreshing'] = true;
+    this.document['refreshStatus'] = SITE_REFRESH_RUNNING;
+    this.document['lastRefreshError'] = '';
+    this.recompute();
+    let delivered: boolean = true;
+    try {
+      await this.emit({ name: 'fetchSites', source: 'all_sites', forceRefresh: true });
+    } catch (failure) {
+      delivered = false;
+    }
+    // The refresh failed when the data source could not deliver records, either
+    // because the request failed or because the response reported an error.
+    if (!delivered || SitePickerStore.reportsFailure(event)) {
+      this.finishRefresh(false, 'sites_refresh_failed');
+      return;
+    }
+    const incoming: Object[] = this.fetchedCatalog(event);
+    if (incoming.length > 0) {
+      this.catalogSource = incoming;
+      this.catalog = SitePickerViewModel.normalize(incoming);
+    }
+    this.finishRefresh(true, '');
+  }
+
+  private finishRefresh(succeeded: boolean, error: string): void {
+    this.document['refreshing'] = false;
+    this.document['refreshStatus'] = succeeded ? SITE_REFRESH_SUCCEEDED : SITE_REFRESH_FAILED;
+    this.document['lastRefreshError'] = error;
+  }
+
+  private static reportsFailure(event: Record<string, Object>): boolean {
+    const outcome: string = readText(event, 'outcome',
+      readText(event, 'fetchOutcome', readText(event, 'refreshOutcome', readText(event, 'result', ''))));
+    const normalized: string = outcome.toLowerCase();
+    if (normalized === OUTCOME_ERROR || normalized === OUTCOME_FAILURE || normalized === OUTCOME_FAILED ||
+      normalized === OUTCOME_FAIL || normalized === OUTCOME_OFFLINE) {
+      return true;
+    }
+    return readText(event, 'errorCode', '').length > 0;
+  }
+
+  /** The catalog the data source published for a successful fetch. */
+  private fetchedCatalog(event: Record<string, Object>): Object[] {
+    let candidate: Object[] = readObjectList(event, 'storeSites');
+    if (candidate.length === 0) {
+      candidate = readObjectList(event, 'sites');
+    }
+    if (candidate.length > 0) {
+      return candidate;
+    }
+    const live: Record<string, Object> | undefined = this.liveDocument;
+    if (live === undefined) {
+      return [];
+    }
+    candidate = readObjectList(live, 'storeSites');
+    if (candidate.length > 0) {
+      return candidate;
+    }
+    candidate = readObjectList(live, 'sites');
+    if (candidate.length > 0) {
+      return candidate;
+    }
+    const outcome: Object = live['nextFetchOutcome'];
+    if (outcome === undefined || outcome === null) {
+      return [];
+    }
+    return readObjectList(outcome as Record<string, Object>, 'storeSites');
+  }
+
+  // ------------------------------------------------------------------- effects
+
+  private async emit(effect: SitePickerEffect): Promise<void> {
+    await this.leaf.emit(effect);
+  }
+
+  // -------------------------------------------------------------- preferences
+
+  private pinnedIds(): number[] {
+    if (hasField(this.durable, PINNED_KEY)) {
+      return readNumberList(this.durable, PINNED_KEY);
+    }
+    const live: Record<string, Object> | undefined = this.liveDurable;
+    if (live !== undefined && hasField(live, PINNED_KEY)) {
+      return readNumberList(live, PINNED_KEY);
+    }
+    return readNumberList(this.document, PINNED_KEY);
+  }
+
+  private recentIds(): number[] {
+    if (hasField(this.durable, RECENT_KEY)) {
+      return readNumberList(this.durable, RECENT_KEY);
+    }
+    const live: Record<string, Object> | undefined = this.liveDurable;
+    if (live !== undefined && hasField(live, RECENT_KEY)) {
+      return readNumberList(live, RECENT_KEY);
+    }
+    return readNumberList(this.document, RECENT_KEY);
+  }
+
+  private writePinned(localIds: number[]): void {
+    const pinned: number[] = this.dedupe(localIds);
+    this.document[PINNED_KEY] = pinned;
+    this.durable[PINNED_KEY] = pinned;
+  }
+
+  private setRecent(localIds: number[]): void {
+    const recent: number[] = this.dedupe(localIds);
+    this.document[RECENT_KEY] = recent;
+    this.durable[RECENT_KEY] = recent;
+  }
+
+  private hydratePreferences(): void {
+    if (!hasField(this.durable, PINNED_KEY)) {
+      this.durable[PINNED_KEY] = this.dedupe(this.pinnedIds());
+    }
+    if (!hasField(this.durable, RECENT_KEY)) {
+      this.durable[RECENT_KEY] = this.dedupe(this.recentIds());
+    }
+    if (!hasField(this.durable, ACTIVE_SITE_KEY)) {
+      this.durable[ACTIVE_SITE_KEY] = this.activeLocalId();
+    }
+  }
+
+  private activeLocalId(): number {
+    if (hasField(this.durable, ACTIVE_SITE_KEY)) {
+      return readNumber(this.durable, ACTIVE_SITE_KEY, -1);
+    }
+    const selected: number = readNumber(this.document, 'selectedLocalId', -1);
+    if (selected >= 0) {
+      return selected;
+    }
+    return readNumber(this.document, 'activeLocalId', -1);
+  }
+
+  private without(values: number[], localId: number): number[] {
+    const kept: number[] = [];
+    for (let index = 0; index < values.length; index++) {
+      if (values[index] !== localId) {
+        kept.push(values[index]);
+      }
+    }
+    return kept;
+  }
+
+  private withPinned(values: number[], localId: number): number[] {
+    const kept: number[] = [];
+    kept.push(localId);
+    for (let index = 0; index < values.length; index++) {
+      if (values[index] !== localId) {
+        kept.push(values[index]);
+      }
+    }
+    return kept;
+  }
+
+  private dedupe(values: number[]): number[] {
+    const kept: number[] = [];
+    for (let index = 0; index < values.length; index++) {
+      const value: number = values[index];
+      if (Number.isFinite(value) && !SitePickerViewModel.includes(kept, value)) {
+        kept.push(value);
+      }
+    }
+    return kept;
+  }
+
+  // ------------------------------------------------------------------- derived
+
+  private mode(): string {
+    return readText(this.document, 'mode', SITE_MODE_DEFAULT);
+  }
+
+  /** Variants that restrict site management still allow a valid selection. */
+  private isRestricted(): boolean {
+    return this.mode() !== SITE_MODE_DEFAULT;
+  }
+
+  private actionMode(): string {
+    return readText(this.document, 'actionMode', SITE_ACTION_NONE);
+  }
+
+  private searchQuery(): string {
+    return readText(this.document, 'activeSearchQuery', readText(this.document, 'searchQuery', ''));
+  }
+
+  private visibleSections(): SiteSection[] {
+    if (this.searchQuery().length > 0) {
+      return SitePickerViewModel.searchSections(this.catalog, this.searchQuery());
+    }
+    return SitePickerViewModel.sectionsFor(this.catalog, this.pinnedIds(), this.recentIds());
+  }
+
+  private pinEditingVisible(): boolean {
+    return this.actionMode() === SITE_ACTION_PIN && !this.isRestricted();
+  }
+
+  private addSiteVisible(): boolean {
+    return !this.isRestricted() && this.searchQuery().length === 0;
+  }
+
+  private rowSelectionEnabled(): boolean {
+    return readFlag(this.document, 'pickerOpen', true) && this.actionMode() !== SITE_ACTION_PIN;
+  }
+
+  private publishResult(result: SiteSelectionResult): void {
+    const encoded: Record<string, Object> = JSON.parse(JSON.stringify(result)) as Record<string, Object>;
+    this.document['resultStatus'] = result.status;
+    this.document['resultLocalId'] = result.localId;
+    this.document['resultReason'] = result.reason;
+    this.document['result'] = encoded;
+    this.document['selectionOutcome'] = encoded;
+  }
+
+  private adoptCatalog(): void {
+    const seeds: Object[][] = [
+      readObjectList(this.document, 'storeSites'),
+      readObjectList(this.document, 'sites'),
+      readObjectList(this.document, 'rows'),
+      readObjectList(this.document, 'orderedRows'),
+      readObjectList(this.document, 'visibleLocalIds')
+    ];
+    let picked: Object[] = [];
+    for (let index = 0; index < seeds.length; index++) {
+      if (seeds[index].length > 0) {
+        picked = seeds[index];
+        break;
+      }
+    }
+    if (picked.length === 0) {
+      const single: Object = this.document['site'];
+      if (single !== undefined && single !== null) {
+        picked = [single];
+      }
+    }
+    if (picked.length === 0) {
+      return;
+    }
+    this.catalogSource = picked;
+    this.catalog = SitePickerViewModel.normalize(picked);
+  }
+
+  private recompute(): void {
+    const pinned: number[] = this.dedupe(this.pinnedIds());
+    const recent: number[] = this.dedupe(this.recentIds());
+    const searching: boolean = this.searchQuery().length > 0;
+    const sections: SiteSection[] = this.visibleSections();
+    const ordered: number[] = SitePickerViewModel.flatten(sections);
+    const matches: number[] = searching ? ordered : [];
+    const active: number = this.activeLocalId();
+    const restricted: boolean = this.isRestricted();
+    const pinEditing: boolean = this.actionMode() === SITE_ACTION_PIN && !restricted;
+    const selectionEnabled: boolean = readFlag(this.document, 'pickerOpen', true) && !pinEditing;
+
+    this.document['storeSites'] = this.catalogSource;
+    this.document['orderedRows'] = ordered;
+    this.document['rows'] = ordered;
+    this.document['visibleLocalIds'] = ordered;
+    this.document['sections'] = JSON.parse(JSON.stringify(sections)) as Object[];
+    this.document['siteCount'] = this.catalog.length;
+    this.document['activeLocalId'] = active;
+    this.document['selectedLocalId'] = active;
+    this.document['mode'] = this.mode();
+    this.document['pickerOpen'] = readFlag(this.document, 'pickerOpen', true);
+    this.document['actionMode'] = this.actionMode();
+    this.document['pinEditingVisible'] = pinEditing;
+    this.document['pinControlsVisible'] = pinEditing;
+    this.document['addSiteVisible'] = !restricted && !searching;
+    this.document['rowSelectionEnabled'] = selectionEnabled;
+    this.document['searchExpanded'] = searching;
+    this.document['searchEmpty'] = searching && matches.length === 0;
+    this.document['sitesEmpty'] = !searching && this.catalog.length === 0;
+    this.document['emptyState'] = SitePickerViewModel.emptyStateFor(this.catalog.length, searching, matches.length);
+    this.document['groupedVisible'] = !searching;
+    this.document[PINNED_KEY] = pinned;
+    this.document[RECENT_KEY] = recent;
+    this.document['pinnedCount'] = pinned.length;
+    this.document['recentCount'] = recent.length;
+    this.durable[PINNED_KEY] = pinned;
+    this.durable[RECENT_KEY] = recent;
+    this.durable[ACTIVE_SITE_KEY] = active;
+    this.notify();
+  }
+
+  private notify(): void {
+    const state: Record<string, Object> = this.currentState();
+    const observers: SitePickerStoreObserver[] = this.observers.slice();
+    for (let index = 0; index < observers.length; index++) {
+      observers[index].onSitePickerStateChanged(state);
+    }
+  }
+
+  private async persist(): Promise<void> {
+    await this.prefs.put(PICKER_STATE_KEY, JSON.stringify(this.document));
+    await this.prefs.put(PICKER_PERSISTENCE_KEY, JSON.stringify(this.durable));
+    await this.prefs.flush();
+  }
+}
