+/**
+ * Domain models shared by the redesigned site picker.
+ *
+ * The picker groups the available sites into a pinned section, a recently
+ * accessed section and the remaining sites. A site that is pinned is never
+ * repeated inside the recent section, and the active site stays identifiable
+ * while it is listed.
+ */
+
+export const SITE_SECTION_PINNED: string = 'pinned';
+export const SITE_SECTION_RECENT: string = 'recent';
+export const SITE_SECTION_ALL: string = 'all';
+export const SITE_SECTION_SEARCH: string = 'search';
+
+export const SITE_MODE_DEFAULT: string = 'default';
+
+export const SITE_ACTION_NONE: string = 'none';
+export const SITE_ACTION_PIN: string = 'pin';
+
+export const SITE_REFRESH_IDLE: string = 'idle';
+export const SITE_REFRESH_RUNNING: string = 'running';
+export const SITE_REFRESH_SUCCEEDED: string = 'succeeded';
+export const SITE_REFRESH_FAILED: string = 'failed';
+
+export const SITE_RESULT_SELECTED: string = 'selected';
+export const SITE_RESULT_ERROR: string = 'error';
+
+export const SITE_EMPTY_NONE: string = 'none';
+export const SITE_EMPTY_NO_SITES: string = 'no_sites';
+export const SITE_EMPTY_NO_MATCHES: string = 'no_search_results';
+
+/**
+ * Upper bound for the recently accessed list. Fewer sites than this are always
+ * listed, the limit only trims very long access histories.
+ */
+export const SITE_RECENT_LIMIT: number = 11;
+
+export function emptyDocument(): Record<string, Object> {
+  return JSON.parse('{}') as Record<string, Object>;
+}
+
+export function cloneDocument(value: Record<string, Object>): Record<string, Object> {
+  return JSON.parse(JSON.stringify(value)) as Record<string, Object>;
+}
+
+export function hasField(source: Record<string, Object>, key: string): boolean {
+  const value: Object = source[key];
+  return !(value === undefined || value === null);
+}
+
+export function readText(source: Record<string, Object>, key: string, fallback: string): string {
+  const value: Object = source[key];
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  return value as string;
+}
+
+export function readNumber(source: Record<string, Object>, key: string, fallback: number): number {
+  const value: Object = source[key];
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  const numeric: number = value as number;
+  if (Number.isFinite(numeric)) {
+    return numeric;
+  }
+  const converted: number = Number(value as string);
+  return Number.isFinite(converted) ? converted : fallback;
+}
+
+export function readFlag(source: Record<string, Object>, key: string, fallback: boolean): boolean {
+  const value: Object = source[key];
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  return value === true;
+}
+
+export function readObjectList(source: Record<string, Object>, key: string): Object[] {
+  const value: Object = source[key];
+  if (value === undefined || value === null) {
+    return [];
+  }
+  return value as Object[];
+}
+
+export function readNumberList(source: Record<string, Object>, key: string): number[] {
+  const value: Object = source[key];
+  if (value === undefined || value === null) {
+    return [];
+  }
+  return value as number[];
+}
+
+/** Builds the payload documents that the picker commands are invoked with. */
+export class SitePickerCommandEvent {
+  private readonly values: Record<string, Object> = emptyDocument();
+
+  put(key: string, value: Object): SitePickerCommandEvent {
+    this.values[key] = value;
+    return this;
+  }
+
+  build(): Record<string, Object> {
+    return this.values;
+  }
+}
+
+/** A single site the user owns, as held by the site store. */
+export class SiteRecord {
+  localId: number = 0;
+  siteId: number = 0;
+  name: string = '';
+  host: string = '';
+  wpComAccessible: boolean = false;
+
+  constructor(localId: number, siteId: number, name: string, host: string, wpComAccessible: boolean) {
+    this.localId = localId;
+    this.siteId = siteId;
+    this.name = name;
+    this.host = host;
+    this.wpComAccessible = wpComAccessible;
+  }
+
+  static fallbackName(localId: number): string {
+    return 'Site ' + localId.toString();
+  }
+
+  static fromValue(value: Object): SiteRecord | undefined {
+    if (value === undefined || value === null) {
+      return undefined;
+    }
+    const numeric: number = value as number;
+    if (Number.isFinite(numeric)) {
+      return new SiteRecord(numeric, numeric, SiteRecord.fallbackName(numeric), '', false);
+    }
+    const fields: Record<string, Object> = value as Record<string, Object>;
+    const localId: number = readNumber(fields, 'localId', -1);
+    if (localId < 0) {
+      return undefined;
+    }
+    const siteId: number = readNumber(fields, 'siteId', localId);
+    const name: string = readText(fields, 'name', SiteRecord.fallbackName(localId));
+    const host: string = readText(fields, 'host', '');
+    return new SiteRecord(localId, siteId, name, host, readFlag(fields, 'wpComAccessible', false));
+  }
+
+  matches(query: string): boolean {
+    const needle: string = query.toLowerCase();
+    return this.name.toLowerCase().indexOf(needle) >= 0 || this.host.toLowerCase().indexOf(needle) >= 0;
+  }
+}
+
+/** One group of the picker list, for example the pinned sites. */
+export class SiteSection {
+  name: string = SITE_SECTION_ALL;
+  localIds: number[] = [];
+
+  constructor(name: string, localIds: number[]) {
+    this.name = name;
+    this.localIds = localIds;
+  }
+}
+
+/** Everything a site row needs in order to be rendered. */
+export class SitePickerRow {
+  localId: number = -1;
+  name: string = '';
+  host: string = '';
+  section: string = SITE_SECTION_ALL;
+  pinned: boolean = false;
+  active: boolean = false;
+  selectEnabled: boolean = true;
+  pinControlVisible: boolean = false;
+  wpComAccessible: boolean = false;
+}
+
+/** Result contract shared by every picker variant when a site is chosen. */
+export class SiteSelectionResult {
+  status: string = SITE_RESULT_ERROR;
+  localId: number = -1;
+  reason: string = '';
+
+  constructor(status: string, localId: number, reason: string) {
+    this.status = status;
+    this.localId = localId;
+    this.reason = reason;
+  }
+}
+
+/** Immutable projection of the picker used by the page layer. */
+export class SitePickerSnapshot {
+  mode: string = SITE_MODE_DEFAULT;
+  restricted: boolean = false;
+  pickerOpen: boolean = true;
+  actionMode: string = SITE_ACTION_NONE;
+  pinEditingVisible: boolean = false;
+  addSiteVisible: boolean = true;
+  searching: boolean = false;
+  searchQuery: string = '';
+  searchExpanded: boolean = false;
+  refreshing: boolean = false;
+  refreshStatus: string = SITE_REFRESH_IDLE;
+  lastRefreshError: string = '';
+  emptyState: string = SITE_EMPTY_NONE;
+  emptyMessage: string = '';
+  siteCount: number = 0;
+  activeLocalId: number = -1;
+  resultStatus: string = '';
+  resultLocalId: number = -1;
+  sections: SiteSection[] = [];
+  rows: SitePickerRow[] = [];
+}
+
+export interface SitePickerStoreObserver {
+  onSitePickerStateChanged(state: Record<string, Object>): void;
+}
