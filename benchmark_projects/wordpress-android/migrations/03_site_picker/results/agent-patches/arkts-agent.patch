+import { common } from '@kit.AbilityKit';
+import { preferences } from '@kit.ArkData';
+import { SitePickerViewModel } from './SitePickerViewModel';
+import { SiteRecord, emptyDocument, readObjectList } from './SitePickerModels';
+
+const SITES_PREFERENCES_NAME: string = 'wordpress_sites';
+const SITES_KEY: string = 'sites';
+const ACTIVE_SITE_KEY: string = 'active_site';
+
+/** Durable access to the sites the user owns. */
+export interface SiteRepository {
+  loadSites(): Promise<SiteRecord[]>;
+  refreshSites(): Promise<SiteRecord[]>;
+  saveSite(record: SiteRecord): Promise<SiteRecord>;
+  activateSite(localId: number): Promise<void>;
+  activeLocalId(): number;
+}
+
+/**
+ * Repository backed by the application's own durable documents.
+ *
+ * `refreshSites` rejects when the stored catalog cannot be produced, which is
+ * what lets the picker leave its refreshing state and keep the last usable
+ * list on screen so the user can retry.
+ */
+export class LocalSiteRepository implements SiteRepository {
+  private readonly prefs: preferences.Preferences;
+  private catalog: SiteRecord[] = [];
+  private active: number = -1;
+
+  constructor(context: common.UIAbilityContext) {
+    this.prefs = preferences.getPreferencesSync(context, { name: SITES_PREFERENCES_NAME });
+  }
+
+  async loadSites(): Promise<SiteRecord[]> {
+    try {
+      this.catalog = this.decode(this.readCatalog());
+      this.active = this.prefs.getSync(ACTIVE_SITE_KEY, -1) as number;
+    } catch (failure) {
