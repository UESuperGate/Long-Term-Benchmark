+import { SitePickerEffect, SitePickerLeaf } from '../integration/SitePickerPageIntegration';
+import { SiteRepository } from './SiteRepository';
+import { SiteRecord } from './SitePickerModels';
+
+/**
+ * Application-owned implementation of the picker effect port.
+ *
+ * The picker itself never talks to the site repository directly: it publishes
+ * effects and reacts to the outcome, so the refresh failure path is exercised
+ * whenever the repository cannot produce fresh records.
+ */
+export class AppSitePickerEffects implements SitePickerLeaf {
+  private readonly repository: SiteRepository;
+  private lastRead: SiteRecord[] = [];
+  private lastFetch: SiteRecord[] = [];
+
+  constructor(repository: SiteRepository) {
+    this.repository = repository;
+  }
+
+  async emit(effect: SitePickerEffect): Promise<void> {
+    if (effect.name === 'readSites') {
+      this.lastRead = await this.repository.loadSites();
+      return;
+    }
+    if (effect.name === 'fetchSites') {
+      this.lastFetch = await this.repository.refreshSites();
+      return;
+    }
+    if (effect.name === 'publishSiteSelection') {
+      await this.repository.activateSite(effect.localId !== undefined ? effect.localId : -1);
+      return;
+    }
+    if (effect.name === 'createSite') {
+      // Creating a site is owned by the host experience; the picker only
+      // surfaces the action, so nothing is written to the catalog here.
+      return;
+    }
+  }
+
+  readResult(): SiteRecord[] {
+    return this.lastRead;
+  }
+
+  fetchResult(): SiteRecord[] {
+    return this.lastFetch;
+  }
+}
