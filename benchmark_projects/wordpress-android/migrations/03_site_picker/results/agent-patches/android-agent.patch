@@ -0,0 +1,124 @@
+package org.wordpress.android.ui.main
+
+import android.view.LayoutInflater
+import android.view.ViewGroup
+import androidx.recyclerview.widget.RecyclerView
+import org.wordpress.android.WordPress
+import org.wordpress.android.databinding.ItemChooseSiteBinding
+import org.wordpress.android.ui.main.utils.SiteRecordUtil
+
+/**
+ * Mode the picker is displayed in.
+ *
+ * [None] is the regular mode in which tapping a site selects it, [Pin] is the pin editing mode in which the only
+ * available interaction is updating the pinned set.
+ */
+sealed class ActionMode(val value: String) {
+    companion object {
+        private const val NONE_VALUE = "none"
+        private const val PIN_VALUE = "pin"
+
+        /**
+         * Restores the mode that was persisted as [ActionMode.value]. Unknown values fall back to [None] so a stale
+         * saved state can never leave the picker in an unusable mode.
+         */
+        fun from(value: String): ActionMode = if (value == PIN_VALUE) Pin else None
+    }
+
+    object None : ActionMode(NONE_VALUE) {
+        override fun toString(): String = value
+
+        override fun hashCode(): Int = value.hashCode()
+
+        override fun equals(other: Any?): Boolean = other === this
+    }
+
+    object Pin : ActionMode(PIN_VALUE) {
+        override fun toString(): String = value
+
+        override fun hashCode(): Int = value.hashCode()
+
+        override fun equals(other: Any?): Boolean = other === this
+    }
+}
+
+/**
+ * Displays the rows prepared by the [SiteViewModel]: either the sites grouped in pinned, recent and remaining sections
+ * or the sites matching the current search query.
+ */
+class ChooseSiteAdapter : RecyclerView.Adapter<ChooseSiteViewHolder>() {
+    /**
+     * Invoked when the list is asked to be loaded again.
+     */
+    var onReload: (() -> Unit)? = null
+
+    /**
+     * Invoked when a site is selected while the picker isn't editing pins.
+     */
+    var onSiteClicked: ((SiteRecord) -> Unit)? = null
+
+    /**
+     * Invoked when a site row is long pressed while the picker isn't editing pins.
+     */
+    var onSiteLongClicked: ((SiteRecord) -> Unit)? = null
+
+    /**
+     * Invoked after the pinned set has been persisted so the rows can be grouped again.
+     */
+    var onSitePinUpdated: ((SiteRecord) -> Unit)? = null
+
+    /**
+     * Local id of the site that is currently active. It stays highlighted in every mode.
+     */
+    var selectedSiteId: Int? = null
+
+    private val siteRecords = mutableListOf<SiteRecord>()
+
+    /**
+     * Current mode of the picker.
+     */
+    var mode: ActionMode = ActionMode.None
+        private set
+
+    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): ChooseSiteViewHolder {
+        val binding = ItemChooseSiteBinding.inflate(LayoutInflater.from(parent.context), parent, false)
+        return ChooseSiteViewHolder(binding).also { WordPress.instance.component().inject(it) }
+    }
+
+    override fun getItemCount(): Int = siteRecords.size
+
+    override fun onBindViewHolder(holder: ChooseSiteViewHolder, position: Int) {
+        val siteRecord = siteRecords[position]
+        holder.onPinUpdated = onSitePinUpdated
+        holder.onClicked = onSiteClicked
+        holder.onLongClicked = onSiteLongClicked
+        holder.bind(mode, siteRecord, activeSiteRecord(), selectedSiteId)
+    }
+
+    /**
+     * Replaces the displayed rows. The rows are expected to be already grouped and ordered by the view model.
+     */
+    fun setSites(sites: List<SiteRecord>) {
+        siteRecords.clear()
+        siteRecords.addAll(sites)
+        notifyDataSetChanged()
+    }
+
+    /**
+     * Switches the picker in or out of the pin editing mode without touching the displayed rows.
+     */
+    fun setActionMode(actionMode: ActionMode) {
+        if (mode == actionMode) return
+        mode = actionMode
+        notifyDataSetChanged()
+    }
+
+    /**
+     * Site that is currently active, looked up in the displayed rows.
+     */
+    private fun activeSiteRecord(): SiteRecord? {
+        val localId = selectedSiteId ?: return null
+        if (localId == SiteRecordUtil.HEADER_LOCAL_ID) return null
+        return siteRecords.firstOrNull { it.localId == localId }
+    }
+}
