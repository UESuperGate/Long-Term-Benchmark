+package org.wordpress.android.ui.main
+
+import android.os.Looper
+import androidx.annotation.StringRes
+import androidx.lifecycle.LiveData
+import androidx.lifecycle.MutableLiveData
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Job
+import org.wordpress.android.R
+import org.wordpress.android.WordPress
+import org.wordpress.android.fluxc.model.SiteModel
+import org.wordpress.android.fluxc.store.SiteStore
+import org.wordpress.android.modules.BG_THREAD
+import org.wordpress.android.ui.main.utils.SiteRecordUtil
+import org.wordpress.android.ui.prefs.AppPrefsWrapper
+import org.wordpress.android.viewmodel.ScopedViewModel
+import javax.inject.Inject
+import javax.inject.Named
+
+/**
+ * Holds the state of the site picker: the rows that are displayed and the effects of the manual refresh.
+ */
+@HiltViewModel
+class SiteViewModel @Inject constructor(
+    @Named(BG_THREAD) private val dispatcher: CoroutineDispatcher,
+    private val siteStore: SiteStore,
+    private val appPrefs: AppPrefsWrapper
+) : ScopedViewModel(dispatcher) {
+    private val _sites = MutableLiveData<List<SiteRecord>>()
+
+    /**
+     * Rows to be displayed by the picker. They are either grouped in pinned, recent and remaining sections or are the
+     * sites matching the current search query.
+     */
+    val sites: LiveData<List<SiteRecord>> = _sites
+
+    private val _refreshing = MutableLiveData(false)
+
+    /**
+     * True while a refresh is in progress.
+     */
+    val refreshing: LiveData<Boolean> = _refreshing
+
+    private val _refreshFailed = MutableLiveData(false)
+
+    /**
+     * True when the last refresh failed. The sites that were loaded before the failure are still displayed.
+     */
+    val refreshFailed: LiveData<Boolean> = _refreshFailed
+
+    private val _selectedSite = MutableLiveData<SiteRecord?>()
+
+    /**
+     * Site that has just been selected by the user.
+     */
+    val selectedSite: LiveData<SiteRecord?> = _selectedSite
+
+    /**
+     * Local id of the site that is currently active.
+     */
+    val activeSiteId: Int
+        get() = appPrefs.getSelectedSite()
+
+    /**
+     * Loads the sites available for [mode] and displays them, either grouped or filtered by [query].
+     *
+     * A refresh that fails keeps the sites that are already displayed so the user can retry.
+     */
+    fun loadSites(
+        mode: SitePickerMode = SitePickerMode.DEFAULT,
+        query: String = ""
+    ): Job {
+        _refreshFailed.updateValue(false)
+        _refreshing.updateValue(true)
+        return launch {
+            try {
+                val siteRecords = getSites(mode)
+                val rows = if (query.isBlank()) {
+                    groupSites(siteRecords)
+                } else {
+                    SiteRecordUtil.filteredSites(siteRecords, query)
+                }
+                _sites.updateValue(rows)
+            } catch (error: Exception) {
+                // The sites that are already displayed are kept so the user can retry the refresh.
+                _refreshFailed.updateValue(true)
+            } finally {
+                _refreshing.updateValue(false)
+            }
+        }
+    }
+
+    /**
+     * Records [siteRecord] as recently accessed and publishes it as the selected site.
+     */
+    fun onSiteSelected(siteRecord: SiteRecord) {
+        appPrefs.addRecentSiteLocalId(siteRecord.localId)
+        _selectedSite.updateValue(siteRecord)
+    }
+
+    /**
+     * Title of the section of the grouped list at the given [section] index.
+     */
+    fun getSection(section: Int): String = when (section) {
+        PINNED_SECTION -> sectionTitle(R.string.site_picker_pinned_sites, PINNED_SECTION_TITLE)
+        RECENT_SECTION -> sectionTitle(R.string.site_picker_recent_sites, RECENT_SECTION_TITLE)
+        ALL_SECTIONS_SECTION -> sectionTitle(R.string.site_picker_all_sites, ALL_SECTIONS_SECTION_TITLE)
+        else -> ""
+    }
+
+    private fun getSites(mode: SitePickerMode): List<SiteRecord> {
+        val siteModels = when (mode) {
+            SitePickerMode.WPCOM_SITES_ONLY -> siteStore.sitesAccessedViaWPComRest
+            SitePickerMode.DEFAULT, SitePickerMode.SIMPLE -> siteStore.sites
+        }
+        return SiteRecordUtil.createRecords(siteModels)
+    }
+
+    /**
+     * Groups the sites into the pinned, recent and remaining sections. A pinned site is never part of the recent
+     * section and every site appears exactly once.
+     */
+    private fun groupSites(sites: List<SiteRecord>): List<SiteRecord> {
+        val pinnedLocalIds = appPrefs.pinnedSiteLocalIds
+        val recentLocalIds = appPrefs.getRecentSiteLocalIds()
+        val currentSiteId = activeSiteId.toLong()
+        val sitesByLocalId = sites.associateBy { it.localId }
+
+        val pinnedSites = sites.filter { it.localId in pinnedLocalIds }
+        val recentSites = recentLocalIds
+            .mapNotNull { localId -> sitesByLocalId[localId] }
+            .filterNot { it.localId in pinnedLocalIds }
+            .map { it.apply { recentPick = true } }
+        val remainingSites = sites.filter { it.localId !in pinnedLocalIds && it.localId !in recentLocalIds }
+
+        return buildList {
+            addSection(PINNED_SECTION, SiteRecordUtil.sort(sortSites(pinnedSites), currentSiteId))
+            addSection(RECENT_SECTION, recentSites)
+            addSection(ALL_SECTIONS_SECTION, sortSites(remainingSites))
+        }
+    }
+
+    private fun MutableList<SiteRecord>.addSection(section: Int, sites: List<SiteRecord>) {
+        if (sites.isEmpty()) return
+        add(sectionHeader(section))
+        addAll(sites)
+    }
+
+    private fun sectionHeader(section: Int): SiteRecord = SiteRecord(
+        SiteModel().apply {
+            id = SiteRecordUtil.HEADER_LOCAL_ID
+            name = getSection(section)
+        }
+    )
+
+    private fun sortSites(sites: List<SiteRecord>): List<SiteRecord> =
+        sites.sortedBy { it.blogNameOrHomeURL.lowercase() }
+
+    @Suppress("SwallowedException")
+    private fun sectionTitle(@StringRes titleId: Int, fallbackTitle: String): String = try {
+        WordPress.instance.getString(titleId)
+    } catch (error: RuntimeException) {
+        fallbackTitle
+    }
+
+    /**
+     * Live data is updated from the dispatcher the view model was created with, so the value is posted when the
+     * current thread isn't the main one.
+     */
+    private fun <T> MutableLiveData<T>.updateValue(value: T) {
+        val isMainThread = try {
+            Looper.myLooper() == Looper.getMainLooper()
+        } catch (error: RuntimeException) {
+            true
+        }
+        if (isMainThread) setValue(value) else postValue(value)
+    }
+
+    companion object {
+        private const val PINNED_SECTION = 0
+        private const val RECENT_SECTION = 1
+        private const val ALL_SECTIONS_SECTION = 2
+
+        private const val PINNED_SECTION_TITLE = "Pinned sites"
+        private const val RECENT_SECTION_TITLE = "Recent sites"
+        private const val ALL_SECTIONS_SECTION_TITLE = "All sites"
+    }
+}
