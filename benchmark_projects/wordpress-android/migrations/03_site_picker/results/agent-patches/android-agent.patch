@@ -0,0 +1,261 @@
+package org.wordpress.android.ui.main
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Bundle
+import android.text.Editable
+import android.text.TextWatcher
+import android.view.Gravity
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ProgressBar
+import android.widget.TextView
+import androidx.activity.ComponentActivity
+import androidx.activity.viewModels
+import androidx.core.view.isVisible
+import androidx.lifecycle.viewmodel.initializer
+import androidx.lifecycle.viewmodel.viewModelFactory
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import kotlinx.coroutines.Dispatchers
+import org.wordpress.android.fluxc.store.SiteStore
+import org.wordpress.android.ui.prefs.AppPrefsWrapper
+
+/**
+ * Hosts the site picker.
+ *
+ * The available sites are displayed grouped in pinned, recent and remaining sites. The user can search them, edit the
+ * pinned set and refresh the list, and selects a site by tapping it. Variants of the picker that don't allow managing
+ * sites only allow selecting them.
+ */
+class SitePickerActivity : ComponentActivity() {
+    private val viewModel: SiteViewModel by viewModels {
+        viewModelFactory {
+            initializer {
+                SiteViewModel(Dispatchers.Default, SiteStore(), AppPrefsWrapper())
+            }
+        }
+    }
+
+    private val appPrefs = AppPrefsWrapper()
+
+    private lateinit var searchInput: EditText
+    private lateinit var refreshButton: Button
+    private lateinit var pinModeButton: Button
+    private lateinit var addSiteButton: Button
+    private lateinit var progressBar: ProgressBar
+    private lateinit var statusView: TextView
+
+    private lateinit var siteAdapter: ChooseSiteAdapter
+
+    private var pickerMode: SitePickerMode = SitePickerMode.DEFAULT
+    private var actionMode: ActionMode = ActionMode.None
+    private var searchQuery: String = ""
+    private var sitesLoaded: Boolean = false
+
+    /**
+     * Variants that restrict site management don't expose the pin controls nor the site creation action.
+     */
+    private val canManageSites: Boolean
+        get() = pickerMode == SitePickerMode.DEFAULT
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        pickerMode = sitePickerMode(intent.getStringExtra(KEY_SITE_PICKER_MODE))
+        if (savedInstanceState != null) {
+            searchQuery = savedInstanceState.getString(KEY_SEARCH_QUERY).orEmpty()
+            actionMode = ActionMode.from(savedInstanceState.getString(KEY_ACTION_MODE).orEmpty())
+        }
+        setContentView(buildContentView())
+        observeViewModel()
+        loadSites()
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        super.onSaveInstanceState(outState)
+        outState.putString(KEY_SEARCH_QUERY, searchQuery)
+        outState.putString(KEY_ACTION_MODE, siteAdapter.mode.value)
+    }
+
+    private fun buildContentView(): ViewGroup {
+        val content = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            layoutParams = ViewGroup.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.MATCH_PARENT
+            )
+        }
+
+        searchInput = EditText(this).apply {
+            hint = SEARCH_HINT
+            isSingleLine = true
+            layoutParams = LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT
+            )
+        }
+        content.addView(searchInput)
+
+        val actions = LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            layoutParams = LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT
+            )
+        }
+        refreshButton = actionButton(REFRESH) { refreshSites() }
+        pinModeButton = actionButton(EDIT_PINS) { togglePinMode() }
+        addSiteButton = actionButton(ADD_SITE) { showStatus(SITE_CREATION_UNAVAILABLE) }
+        actions.addView(refreshButton)
+        actions.addView(pinModeButton)
+        actions.addView(addSiteButton)
+        content.addView(actions)
+
+        progressBar = ProgressBar(this, null, android.R.attr.progressBarStyleHorizontal).apply {
+            isIndeterminate = true
+            isVisible = false
+            layoutParams = LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT
+            )
+        }
+        content.addView(progressBar)
+
+        statusView = TextView(this).apply {
+            gravity = Gravity.CENTER
+            isVisible = false
+            layoutParams = LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT
+            )
+        }
+        content.addView(statusView)
+
+        siteAdapter = ChooseSiteAdapter().apply {
+            onSiteClicked = { siteRecord -> viewModel.onSiteSelected(siteRecord) }
+            onSitePinUpdated = { loadSites() }
+            selectedSiteId = viewModel.activeSiteId.takeIf { it != NO_SITE }
+            setActionMode(actionMode)
+        }
+        val siteList = RecyclerView(this).apply {
+            layoutManager = LinearLayoutManager(this@SitePickerActivity)
+            adapter = siteAdapter
+            layoutParams = LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                0,
+                LIST_WEIGHT
+            )
+        }
+        content.addView(siteList)
+
+        searchInput.setText(searchQuery)
+        searchInput.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) = Unit
+
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) = Unit
+
+            override fun afterTextChanged(text: Editable?) {
+                val query = text?.toString().orEmpty()
+                if (query == searchQuery) return
+                searchQuery = query
+                loadSites()
+            }
+        })
+
+        pinModeButton.isVisible = canManageSites
+        addSiteButton.isVisible = canManageSites
+        updatePinModeButton()
+
+        return content
+    }
+
+    private fun actionButton(label: String, onClicked: () -> Unit) = Button(this).apply {
+        text = label
+        layoutParams = LinearLayout.LayoutParams(
+            ViewGroup.LayoutParams.WRAP_CONTENT,
+            ViewGroup.LayoutParams.WRAP_CONTENT
+        )
+        setOnClickListener { onClicked() }
+    }
+
+    private fun observeViewModel() {
+        viewModel.sites.observe(this) { sites ->
+            sitesLoaded = true
+            siteAdapter.setSites(sites.orEmpty())
+            updateStatus()
+        }
+        viewModel.refreshing.observe(this) { refreshing ->
+            progressBar.isVisible = refreshing
+            refreshButton.isEnabled = !refreshing
+        }
+        viewModel.refreshFailed.observe(this) { failed ->
+            if (failed) showStatus(REFRESH_FAILED)
+        }
+        viewModel.selectedSite.observe(this) { siteRecord ->
+            if (siteRecord != null) finishWithSite(siteRecord)
+        }
+    }
+
+    private fun loadSites() {
+        sitesLoaded = false
+        viewModel.loadSites(pickerMode, searchQuery)
+    }
+
+    private fun refreshSites() = loadSites()
+
+    private fun togglePinMode() {
+        siteAdapter.setActionMode(if (siteAdapter.mode is ActionMode.Pin) ActionMode.None else ActionMode.Pin)
+        updatePinModeButton()
+    }
+
+    private fun updatePinModeButton() {
+        pinModeButton.text = if (siteAdapter.mode is ActionMode.Pin) DONE else EDIT_PINS
+    }
+
+    private fun updateStatus() {
+        if (viewModel.sites.value.orEmpty().isNotEmpty() || !sitesLoaded) {
+            statusView.isVisible = false
+            return
+        }
+        statusView.isVisible = true
+        statusView.text = if (searchQuery.isBlank()) NO_SITES else NO_SEARCH_RESULTS
+    }
+
+    private fun showStatus(message: String) {
+        statusView.isVisible = true
+        statusView.text = message
+    }
+
+    private fun finishWithSite(siteRecord: SiteRecord) {
+        appPrefs.setSelectedSite(siteRecord.localId)
+        setResult(Activity.RESULT_OK, Intent().putExtra(KEY_SITE_LOCAL_ID, siteRecord.localId))
+        finish()
+    }
+
+    private fun sitePickerMode(mode: String?): SitePickerMode = SitePickerMode.entries
+        .firstOrNull { it.name.equals(mode, ignoreCase = true) }
+        ?: SitePickerMode.DEFAULT
+
+    companion object {
+        const val KEY_SITE_PICKER_MODE = "site_picker_mode"
+        const val KEY_SITE_LOCAL_ID = "site_local_id"
+
+        private const val KEY_SEARCH_QUERY = "site_picker_search_query"
+        private const val KEY_ACTION_MODE = "site_picker_action_mode"
+
