+package org.wordpress.android.ui.main.utils
+
+import org.wordpress.android.fluxc.model.SiteModel
+import org.wordpress.android.ui.main.SiteRecord
+
+/**
+ * Helpers used to order and filter the rows shown by the site picker.
+ */
+object SiteRecordUtil {
+    /**
+     * Local id reserved for the synthetic records that carry the title of a section of the grouped site list. Site local
+     * ids are always positive, so a row with this id is a section header and never a site.
+     */
+    const val HEADER_LOCAL_ID: Int = -1
+
+    /**
+     * Orders [sites] keeping the site matching [activeSiteId] on top. The order of the remaining sites is preserved.
+     */
+    fun sort(sites: List<SiteRecord>, activeSiteId: Long): List<SiteRecord> =
+        sites.sortedBy { if (it.localId.toLong() == activeSiteId) 0 else 1 }
+
+    /**
+     * Orders [sites] keeping the pinned sites on top. The order of the remaining sites is preserved.
+     */
+    fun sort(sites: List<SiteRecord>, pinnedLocalIds: Set<Int>): List<SiteRecord> =
+        sites.sortedBy { if (it.localId in pinnedLocalIds) 0 else 1 }
+
+    /**
+     * Index of the site matching [localId] or -1 when the site isn't part of [sites].
+     */
+    fun indexOf(sites: List<SiteRecord>, localId: Int): Int = sites.indexOfFirst { it.localId == localId }
+
+    /**
+     * Index of [siteRecord] within [sites] or -1 when the site isn't part of the list.
+     */
+    fun indexOf(sites: List<SiteRecord>, siteRecord: SiteRecord): Int = indexOf(sites, siteRecord.localId)
+
+    /**
+     * True when both lists hold the same sites in the same order.
+     */
+    fun isSameList(sites: List<SiteRecord>, otherSites: List<SiteRecord>): Boolean =
+        sites.size == otherSites.size && sites.indices.all { sites[it].localId == otherSites[it].localId }
+
+    /**
+     * Sites matching [query]. Section headers are never matched, so filtering a grouped list always returns sites only.
+     * A blank query matches every site of the list.
+     */
+    fun filteredSites(sites: List<SiteRecord>, query: String): List<SiteRecord> {
+        val siteRecords = sites.filterNot { it.localId == HEADER_LOCAL_ID }
+        val needle = query.trim()
+        if (needle.isEmpty()) return siteRecords
+        return siteRecords.filter { siteRecord ->
+            siteRecord.blogNameOrHomeURL.contains(needle, ignoreCase = true) ||
+                siteRecord.homeURL.contains(needle, ignoreCase = true)
+        }
+    }
+
+    /**
+     * Wraps the given sites into the records displayed by the picker.
+     */
+    fun createRecords(sites: List<SiteModel>): List<SiteRecord> = sites.map { SiteRecord(it) }
+}
