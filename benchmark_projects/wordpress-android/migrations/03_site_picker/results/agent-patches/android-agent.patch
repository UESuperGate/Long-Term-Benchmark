+++ b/src/main/java/org/wordpress/android/ui/main/ChooseSiteViewHolder.kt
@@ -0,0 +1,199 @@
+package org.wordpress.android.ui.main
+
+import android.content.Context
+import android.content.res.ColorStateList
+import android.graphics.Color
+import android.view.View
+import androidx.core.view.isVisible
+import androidx.recyclerview.widget.RecyclerView
+import org.wordpress.android.R
+import org.wordpress.android.analytics.AnalyticsTracker
+import org.wordpress.android.databinding.ItemChooseSiteBinding
+import org.wordpress.android.ui.main.utils.SiteRecordUtil
+import org.wordpress.android.ui.prefs.AppPrefsWrapper
+import org.wordpress.android.util.extensions.getColorFromAttribute
+import org.wordpress.android.util.extensions.isDarkTheme
+import org.wordpress.android.util.image.ImageManager
+import javax.inject.Inject
+
+/**
+ * Renders a single row of the site picker, which is either a site or the header of a section of the grouped list.
+ */
+class ChooseSiteViewHolder(private val binding: ItemChooseSiteBinding) : RecyclerView.ViewHolder(binding.root) {
+    @Inject
+    lateinit var imageManager: ImageManager
+
+    @Inject
+    lateinit var appPrefs: AppPrefsWrapper
+
+    /**
+     * Invoked after the pinned set has been updated by the pin control.
+     */
+    var onPinUpdated: ((SiteRecord) -> Unit)? = null
+
+    /**
+     * Invoked when the site is selected.
+     */
+    var onClicked: ((SiteRecord) -> Unit)? = null
+
+    /**
+     * Invoked when the site row is long pressed.
+     */
+    var onLongClicked: ((SiteRecord) -> Unit)? = null
+
+    private val siteImageManager: ImageManager
+        get() = if (this::imageManager.isInitialized) imageManager else ImageManager()
+
+    private val sitePrefs: AppPrefsWrapper
+        get() = if (this::appPrefs.isInitialized) appPrefs else AppPrefsWrapper()
+
+    /**
+     * Binds [siteRecord] to the row.
+     *
+     * While [actionMode] is [ActionMode.Pin] the row body can't be used to select or open a site: only the pin control
+     * reacts to user input. [activeSite] is the site that is currently active and [selectedSiteId] the local id that
+     * has to be highlighted.
+     */
+    fun bind(
+        actionMode: ActionMode,
+        siteRecord: SiteRecord,
+        activeSite: SiteRecord?,
+        selectedSiteId: Int?
+    ) {
+        val context = binding.root.context
+        val isHeader = siteRecord.localId == SiteRecordUtil.HEADER_LOCAL_ID
+        val isActive = !isHeader && siteRecord.localId == activeSite?.localId
+        val isSelected = !isHeader && siteRecord.localId == selectedSiteId
+        val isPinMode = actionMode is ActionMode.Pin
+
+        with(binding) {
+            header.isVisible = isHeader
+            layoutContainer.isVisible = !isHeader
+            pin.isVisible = isPinMode && !isHeader
+            if (isHeader) {
+                header.text = siteRecord.blogNameOrHomeURL
+                root.alpha = OPAQUE
+                bindRowInteraction(null, null)
+                return@with
+            }
+
+            textTitle.text = siteRecord.blogNameOrHomeURL
+            textDomain.text = siteRecord.homeURL
+
+            siteImageManager.loadImageWithCorners(
+                avatar,
+                siteRecord.blavatarType,
+                siteRecord.blavatarUrl,
+                BLAVATAR_SZ
+            )
+
+            avatar.strokeColor = if (isActive) {
+                ColorStateList.valueOf(context.getColorFromAttribute(R.attr.wpColorOnSurfaceMedium))
+            } else {
+                null
+            }
+            layoutContainer.setBackgroundColor(activeSiteBackgroundColor(context, isActive))
+            root.alpha = if (isSelected) selectedSiteOpacity(context) else OPAQUE
+
+            pin.setColorFilter(context.getColorFromAttribute(R.attr.wpColorOnSurfaceMedium))
+            bindPin(siteRecord)
+
+            if (isPinMode) {
+                // While the pinned set is being edited the row can't be used to select or to open a site.
+                bindRowInteraction(null, null)
+            } else {
+                bindRowInteraction(
+                    View.OnClickListener { selectSite(siteRecord) },
+                    View.OnLongClickListener {
+                        onLongClicked?.invoke(siteRecord)
+                        true
+                    }
+                )
+            }
+        }
+    }
+
+    /**
+     * Makes the row react to a selection or a long press. The listeners are attached to the row and to the container
+     * holding the site details, so both of them can be used to interact with the site, and are cleared when the row
+     * can't be interacted with.
+     */
+    private fun bindRowInteraction(
+        clickListener: View.OnClickListener?,
+        longClickListener: View.OnLongClickListener?
+    ) {
+        listOf(binding.root, binding.layoutContainer).forEach { row ->
+            row.isClickable = clickListener != null
+            row.isLongClickable = longClickListener != null
+            row.setOnClickListener(clickListener)
+            row.setOnLongClickListener(longClickListener)
+        }
+    }
+
+    /**
+     * Renders the pin control of [siteRecord] and reacts to it being tapped by updating the pinned set.
+     */
+    private fun bindPin(siteRecord: SiteRecord) {
+        binding.pin.setImageResource(pinDrawable(isPinned(siteRecord)))
+        binding.pin.setOnClickListener {
+            val isPinned = updatePin(siteRecord)
+            binding.pin.setImageResource(pinDrawable(isPinned))
+        }
+    }
+
+    private fun pinDrawable(isPinned: Boolean): Int = if (isPinned) R.drawable.pin_filled else R.drawable.pin
+
+    private fun isPinned(siteRecord: SiteRecord): Boolean =
+        sitePrefs.pinnedSiteLocalIds.contains(siteRecord.localId)
+
+    /**
+     * Selects the site: the site is remembered as recently accessed and the host is notified so it can finish the
+     * picker with the selected site.
+     */
+    private fun selectSite(siteRecord: SiteRecord) {
+        sitePrefs.addRecentSiteLocalId(siteRecord.localId)
+        onClicked?.invoke(siteRecord)
+    }
+
+    /**
+     * Toggles the pinned state of [siteRecord], persists it and asks the host to group the rows again. Returns the new
+     * pinned state of the site.
+     */
+    private fun updatePin(siteRecord: SiteRecord): Boolean {
+        val pinnedLocalIds = sitePrefs.pinnedSiteLocalIds
+        val isPinned = if (pinnedLocalIds.contains(siteRecord.localId)) {
+            pinnedLocalIds.remove(siteRecord.localId)
+            false
+        } else {
+            pinnedLocalIds.add(siteRecord.localId)
+            true
+        }
+        sitePrefs.pinnedSiteLocalIds = pinnedLocalIds
+        AnalyticsTracker.track(AnalyticsTracker.Stat.SITE_SWITCHER_PIN_UPDATED)
+        onPinUpdated?.invoke(siteRecord)
+        return isPinned
+    }
+
+    private fun activeSiteBackgroundColor(context: Context, isActive: Boolean): Int {
+        if (!isActive) return Color.TRANSPARENT
+        val color = if (context.resources.configuration.isDarkTheme()) {
+            R.color.white_translucent_10
+        } else {
+            R.color.black_translucent_10
+        }
+        return context.getColor(color)
+    }
+
+    private fun selectedSiteOpacity(context: Context): Float =
+        context.resources.getInteger(R.integer.selected_list_item_opacity) / MAX_ALPHA
+
+    companion object {
+        /**
+         * Size of the blavatar displayed by a site row.
+         */
+        const val BLAVATAR_SZ = SitePickerAdapter.mBlavatarSz
+
+        private const val MAX_ALPHA = 255f
+        private const val OPAQUE = 1f
+    }
+}
