{
  "schemaVersion": 1,
  "taskId": "04_new_stats",
  "platform": "android",
  "controls": [
    {
      "name": "missing_source_manifest",
      "mutation": "remove candidate base/upstream-source-manifest.json",
      "scorerExit": 1,
      "semantic": {"passed": 0, "failed": 0, "notScored": 10, "total": 10},
      "adapter": "incomplete",
      "diagnostic": "missing upstream-source-manifest.json"
    },
    {
      "name": "compiled_source_byte_mismatch",
      "mutation": "bind one manifest row to a missing compiled production path",
      "scorerExit": 1,
      "semantic": {"passed": 0, "failed": 0, "notScored": 10, "total": 10},
      "adapter": "incomplete",
      "diagnostic": "compiled production byte mismatch"
    },
    {
      "name": "missing_candidate_identity",
      "mutation": "remove candidate base/build.gradle.kts",
      "scorerExit": 1,
      "semantic": {"passed": 0, "failed": 0, "notScored": 10, "total": 10},
      "adapter": "incomplete",
      "diagnostic": "candidate does not expose build.gradle.kts"
    }
  ],
  "candidateDirectories": "fresh random /tmp standalone candidate copies",
  "candidateDirectoriesRemoved": true,
  "passOrFailFabricatedFromBindingErrors": false
}
