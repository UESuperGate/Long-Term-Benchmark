+    /**
+     * Presents a failure. A plan gate is only kept as such when the user already has the capability
+     * to view stats; without it the response really is a permission problem, so the two are never
+     * shown at once.
+     */
+    private fun CountryViewsResult.Error.toCardState() = errorState(messageResId, isAuthError, isPlanGated)
+
+    private fun RegionViewsResult.Error.toCardState() = errorState(messageResId, isAuthError, isPlanGated)
+
+    private fun CityViewsResult.Error.toCardState() = errorState(messageResId, isAuthError, isPlanGated)
+
+    private fun errorState(messageResId: Int, isAuthError: Boolean, isPlanGated: Boolean): LocationsCardUiState {
+        if (isPlanGated && !canViewStats()) {
+            return LocationsCardUiState.Error(
+                messageResId = messageResId,
+                isAuthError = true,
+                isPlanGated = false
+            )
+        }
+        return LocationsCardUiState.Error(
+            messageResId = messageResId,
+            isAuthError = isAuthError && !isPlanGated,
+            isPlanGated = isPlanGated
+        )
+    }
+
+    private fun canViewStats(): Boolean = !accountStore.accessToken.isNullOrEmpty()
+
+    private fun Long.toStatsViewChange(percentage: Double): StatsViewChange = when {
+        this > 0L -> StatsViewChange.Positive(this, percentage)
+        this < 0L -> StatsViewChange.Negative(this, percentage)
+        else -> StatsViewChange.NoChange
+    }
+}
