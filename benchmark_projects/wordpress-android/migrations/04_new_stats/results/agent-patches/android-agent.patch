+    }
+
+    private fun CountryViewsResult.Success.toCardState() = LocationsCardUiState.Loaded(
+        items = countries.map {
+            LocationItem(
+                id = it.countryCode,
+                name = it.countryName,
+                views = it.views,
+                flagIconUrl = it.flagIconUrl,
+                change = it.viewsChange.toStatsViewChange(it.viewsChangePercent)
+            )
+        },
+        minViews = countries.minOfOrNull { it.views } ?: 0L,
+        maxViews = countries.maxOfOrNull { it.views } ?: 0L,
+        maxViewsForBar = countries.maxOfOrNull { it.views } ?: 0L
+    )
+
+    private fun RegionViewsResult.Success.toCardState() = LocationsCardUiState.Loaded(
+        items = regions.map {
+            LocationItem(
+                id = it.countryCode.ifEmpty { it.location },
+                name = it.location,
+                views = it.views,
+                flagIconUrl = it.flagIconUrl,
+                change = it.viewsChange.toStatsViewChange(it.viewsChangePercent)
+            )
+        },
+        minViews = regions.minOfOrNull { it.views } ?: 0L,
+        maxViews = regions.maxOfOrNull { it.views } ?: 0L,
+        maxViewsForBar = regions.maxOfOrNull { it.views } ?: 0L
