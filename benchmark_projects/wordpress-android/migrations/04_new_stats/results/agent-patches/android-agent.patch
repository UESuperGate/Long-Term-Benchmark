+package org.wordpress.android.ui.newstats.locations
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import org.wordpress.android.fluxc.model.SiteModel
+import org.wordpress.android.fluxc.store.AccountStore
+import org.wordpress.android.ui.mysite.SelectedSiteRepository
+import org.wordpress.android.ui.newstats.StatsPeriod
+import org.wordpress.android.ui.newstats.analytics.NewStatsTracker
+import org.wordpress.android.ui.newstats.components.StatsViewChange
+import org.wordpress.android.ui.newstats.repository.CityViewsResult
+import org.wordpress.android.ui.newstats.repository.CountryViewsResult
+import org.wordpress.android.ui.newstats.repository.RegionViewsResult
+import org.wordpress.android.ui.newstats.repository.StatsRepository
+import org.wordpress.android.ui.newstats.util.statsUpgradeUrl
+import org.wordpress.android.ui.newstats.util.toDateRangeString
+import org.wordpress.android.util.AppLog
+import org.wordpress.android.viewmodel.ResourceProvider
+import javax.inject.Inject
+
+/** Aggregated data for the locations detail screen. */
+data class LocationsDetailData(
+    val items: List<LocationItem>,
+    val mapData: String,
+    val minViews: Long,
+    val maxViews: Long,
+    val totalViews: Long,
+    val totalViewsChange: Long,
+    val totalViewsChangePercent: Double,
+    val dateRange: String,
+    val locationType: LocationType
+)
+
+/**
+ * Owns the locations card.
+ *
+ * Each level keeps its own state so switching level never throws away what another level already
+ * loaded, and so a level the user returns to renders immediately from what it had.
+ */
+@HiltViewModel
+class LocationsViewModel @Inject constructor(
+    private val selectedSiteRepository: SelectedSiteRepository,
+    private val accountStore: AccountStore,
+    private val statsRepository: StatsRepository,
+    private val resourceProvider: ResourceProvider,
+    private val tracker: NewStatsTracker
+) : ViewModel() {
+    private val _selectedLocationType = MutableStateFlow(LocationType.COUNTRIES)
+    val selectedLocationType: StateFlow<LocationType> = _selectedLocationType.asStateFlow()
+
+    private val perTypeState = MutableStateFlow<Map<LocationType, LocationsCardUiState>>(emptyMap())
+
+    private val _uiState = MutableStateFlow<LocationsCardUiState>(LocationsCardUiState.Loading)
+    val uiState: StateFlow<LocationsCardUiState> = _uiState.asStateFlow()
+
+    private val _isRefreshing = MutableStateFlow(false)
+    val isRefreshing: StateFlow<Boolean> = _isRefreshing.asStateFlow()
+
+    private var currentPeriod: StatsPeriod = StatsPeriod.Last7Days
+    private var loadedPeriod: StatsPeriod? = null
+    private var loadJob: Job? = null
+    private var detailData: LocationsDetailData? = null
+
+    fun loadData() {
+        val site = selectedSiteRepository.getSelectedSite() ?: return
+        val period = currentPeriod
+        if (loadedPeriod == period) return
+        loadedPeriod = period
+        val type = _selectedLocationType.value
+        statsRepository.bindSite(site.siteId)
+        loadJob?.cancel()
+        loadJob = viewModelScope.launch {
+            setState(type, LocationsCardUiState.Loading)
+            setState(type, fetchForType(type, site, period, false))
+        }
+    }
+
+    fun refresh() {
+        val site = selectedSiteRepository.getSelectedSite() ?: return
+        statsRepository.invalidateCache()
+        loadJob?.cancel()
+        loadJob = viewModelScope.launch {
+            try {
+                _isRefreshing.value = true
+                val state = fetchForCurrentType(site, true)
+                setState(_selectedLocationType.value, state)
+            } finally {
+                _isRefreshing.value = false
+            }
+        }
+    }
+
+    /**
+     * Retries the failed level. A plan-gated surface is not a failure to retry: it keeps offering the
+     * upgrade action until the user moves to a level their plan covers.
+     */
+    fun onRetry() {
+        val site = selectedSiteRepository.getSelectedSite() ?: return
+        val period = currentPeriod
+        val type = _selectedLocationType.value
+        loadJob?.cancel()
+        loadJob = viewModelScope.launch {
+            val state = fetchForType(type, site, period, false)
+            if (state is LocationsCardUiState.Error && state.isPlanGated) return@launch
+            setState(type, state)
+        }
+    }
+
+    fun getAdminUrl(): String = selectedSiteRepository.getSelectedSite()?.adminUrl.orEmpty()
+
+    fun getUpgradeUrl(): String =
+        selectedSiteRepository.getSelectedSite()?.statsUpgradeUrl().orEmpty()
+
+    fun onPeriodChanged(period: StatsPeriod) {
+        if (period == currentPeriod) return
+        currentPeriod = period
+        resetLoadedPeriodForCurrentType()
+    }
+
+    fun onLocationTypeChanged(locationType: LocationType) {
+        val from = _selectedLocationType.value
+        if (from == locationType) return
+        tracker.trackLocationLevelChanged(from, locationType)
+        _selectedLocationType.value = locationType
+        detailData = null
+        resetLoadedPeriodForCurrentType()
+        publishStateForCurrentType()
+        loadData()
+    }
+
+    fun getDetailData(): LocationsDetailData = detailData
+        ?: LocationsDetailData(
+            items = emptyList(),
+            mapData = "",
+            minViews = 0L,
+            maxViews = 0L,
+            totalViews = 0L,
+            totalViewsChange = 0L,
+            totalViewsChangePercent = 0.0,
+            dateRange = currentPeriod.toDateRangeString(resourceProvider),
+            locationType = _selectedLocationType.value
+        )
+
+    private fun resetLoadedPeriodForCurrentType() {
+        loadedPeriod = null
+    }
+
+    /** Shows whatever the newly selected level already had, without clearing other levels. */
+    private fun publishStateForCurrentType() {
+        val type = _selectedLocationType.value
+        val state = perTypeState.value[type] ?: LocationsCardUiState.Loading
+        _uiState.value = state
+    }
+
+    private fun setState(type: LocationType, state: LocationsCardUiState) {
+        perTypeState.value = perTypeState.value + (type to state)
+        if (_selectedLocationType.value == type) {
+            _uiState.value = state
+            if (state is LocationsCardUiState.Loaded) {
+                detailData = state.toDetailData(type)
+            }
+        }
+    }
+
+    private fun LocationsCardUiState.Loaded.toDetailData(type: LocationType) = LocationsDetailData(
+        items = items,
+        mapData = mapData,
+        minViews = minViews,
+        maxViews = maxViews,
+        totalViews = items.sumOf { it.views },
+        totalViewsChange = 0L,
+        totalViewsChangePercent = 0.0,
+        dateRange = currentPeriod.toDateRangeString(resourceProvider),
+        locationType = type
+    )
+
+    private suspend fun fetchForCurrentType(site: SiteModel, forceRefresh: Boolean): LocationsCardUiState =
+        fetchForType(_selectedLocationType.value, site, currentPeriod, forceRefresh)
+
+    @Suppress("TooGenericExceptionCaught")
+    private suspend fun fetchForType(
+        type: LocationType,
+        site: SiteModel,
+        period: StatsPeriod,
+        forceRefresh: Boolean
+    ): LocationsCardUiState = try {
+        when (type) {
+            LocationType.COUNTRIES -> fetchCountryViews(site, period, forceRefresh)
+            LocationType.REGIONS -> fetchRegionViews(site, period, forceRefresh)
+            LocationType.CITIES -> fetchCityViews(site, period, forceRefresh)
+        }
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        AppLog.e(AppLog.T.STATS, "Error loading locations for $type", e)
