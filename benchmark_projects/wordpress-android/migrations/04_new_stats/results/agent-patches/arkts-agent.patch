@@ -0,0 +1,1570 @@
+import { common } from '@kit.AbilityKit';
+import { NewStatsEffect, NewStatsInput, NewStatsLeaf } from '../integration/NewStatsPageIntegration';
+import {
+  addNewStatsDays,
+  canPageNewStatsForward,
+  diffNewStatsDays,
+  fallbackNewStatsMetric,
+  formatNewStatsDay,
+  isHourlyNewStatsPeriod,
+  NewStatsBucket,
+  NewStatsContentState,
+  NewStatsLocationType,
+  NewStatsMetric,
+  NewStatsPeriod,
+  NewStatsPeriodKind,
+  NewStatsPeriodType,
+  newStatsToday,
+  pageNewStatsBackward,
+  pageNewStatsForward,
+  parseNewStatsDay,
+  resolveNewStatsPeriod,
+  supportedNewStatsChartMetrics,
+  supportsNewStatsChartMetric
+} from './NewStatsDomain';
+import {
+  authErrorNewStatsSurfaceState,
+  loadedNewStatsSurfaceState,
+  loadingNewStatsSurfaceState,
+  NewStatsCacheEntry,
+  NewStatsRequestIdentity,
+  NewStatsRequestLedger,
+  NewStatsResponseCache,
+  NewStatsSurfaceState,
+  newStatsRequestIdentityKey,
+  planGatedNewStatsSurfaceState
+} from './NewStatsCache';
+import {
+  isGateEligibleLocation,
+  NEW_STATS_CHANNEL_OLDER_REQUEST,
+  NEW_STATS_CHANNEL_PERIOD_DATA,
+  NEW_STATS_CHANNEL_REGION_VIEWS,
+  NEW_STATS_CHANNEL_REFRESH,
+  NEW_STATS_CHANNEL_REVALIDATION,
+  NEW_STATS_OUTCOME_NETWORK_ERROR,
+  NEW_STATS_OUTCOME_SUCCESS,
+  NEW_STATS_SURFACE_LOCATION,
+  NEW_STATS_SURFACE_VIEWS_CHART,
+  NewStatsRemoteRequest,
+  NewStatsRemoteResponse,
+  NewStatsRemoteSource,
+  NewStatsScriptedRemoteSource
+} from './NewStatsRemote';
+import { NewStatsConfiguration, NewStatsConfigurationRepository } from './NewStatsConfigurationRepository';
+
+const KEY_VIEWS: string = 'views';
+const DEFAULT_VARIANT: string = '';
+const MAX_SYNTHESIZED_BUCKETS: number = 62;
+
+export function newStatsReadString(source: Record<string, Object>, key: string): string {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return '';
+  }
+  return raw as string;
+}
+
+export function newStatsReadNumber(source: Record<string, Object>, key: string): number {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return 0;
+  }
+  return raw as number;
+}
+
+export function newStatsReadBoolean(source: Record<string, Object>, key: string): boolean {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return false;
+  }
+  return raw as boolean;
+}
+
+export function newStatsReadRecord(source: Record<string, Object>, key: string): Record<string, Object> {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return {};
+  }
+  return raw as Record<string, Object>;
+}
+
+export function newStatsReadArray(source: Record<string, Object>, key: string): Object[] {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return [];
+  }
+  return raw as Object[];
+}
+
+export function newStatsReadStringArray(source: Record<string, Object>, key: string): string[] {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return [];
+  }
+  return raw as string[];
+}
+
+/**
+ * The New Stats screen's controller.
+ *
+ * It owns the screen state, the durable user choices, the response cache and
+ * the in-flight request ledger, and it translates user intent into remote
+ * requests. Every value it publishes is something the page renders, so the
+ * screen stays coherent without the page recomputing anything itself.
+ */
+export class NewStatsStore {
+  private state: Record<string, Object> = {};
+  private persistence: Record<string, Object> = {};
+  private leaf: NewStatsLeaf;
+  private repository: NewStatsConfigurationRepository;
+  private remote: NewStatsRemoteSource;
+  private cache: NewStatsResponseCache = new NewStatsResponseCache();
+  private ledger: NewStatsRequestLedger;
+  private today: string;
+  private listeners: Array<() => void> = [];
+  private siteId: number;
+  private variant: string = DEFAULT_VARIANT;
+
+  private constructor(repository: NewStatsConfigurationRepository, input: NewStatsInput) {
+    this.repository = repository;
+    this.leaf = input.leaf;
+    this.remote = new NewStatsScriptedRemoteSource();
+    this.today = newStatsToday();
+    this.ledger = new NewStatsRequestLedger(0);
+    this.siteId = newStatsReadNumber(this.state, 'siteId');
+  }
+
+  static async create(context: common.UIAbilityContext, input: NewStatsInput,
+    initialize: boolean): Promise<NewStatsStore> {
+    const repository: NewStatsConfigurationRepository = await NewStatsConfigurationRepository.open(context);
+    if (initialize) {
+      await repository.clear();
+      await repository.writeSession(input.state);
+      const seeded: NewStatsConfiguration = defaultConfigurationFrom(input.persistence);
+      await repository.writeConfiguration(seeded);
+    }
+    const store: NewStatsStore = new NewStatsStore(repository, input);
+    store.state = input.state;
+    store.persistence = input.persistence;
+    store.bootstrap();
+    await store.refreshFromRepository();
+    return store;
+  }
+
+  // ---------------------------------------------------------------- lifecycle
+
+  /**
+   * Brings the screen state in line with the durable configuration without
+   * inventing values for anything the environment did not already describe.
+   */
+  private bootstrap(): void {
+    this.siteId = newStatsReadNumber(this.state, 'siteId');
+    const clock: string = newStatsReadString(this.state, 'clockDate');
+    const seededToday: string = newStatsReadString(this.state, 'today');
+    if (clock.length > 0) {
+      this.today = clock;
+    } else if (seededToday.length > 0) {
+      this.today = seededToday;
+    }
+
+    // The durable preference is the seed of truth: when the state has not
+    // chosen a metric yet, the metric the user last preferred is what the
+    // screen starts from, so an hourly window's fallback never becomes the
+    // stored choice.
+    if (this.state['selectedMetric'] === undefined) {
+      const preferred: string = newStatsReadString(this.state, 'persistedMetric');
+      const stored: string = newStatsReadString(this.persistence, 'selectedMetric');
+      const seed: string = preferred.length > 0 ? preferred : stored;
+      this.state['selectedMetric'] = seed.length > 0 ? seed : NewStatsMetric.VIEWS;
+    }
+    if (this.state['persistedMetric'] === undefined) {
+      this.state['persistedMetric'] = this.selectedMetric();
+    }
+    if (this.state['period'] === undefined) {
+      // Fall back to the persisted origin so a restored screen resumes on the
+      // period the user left, keeping that period's meaning.
+      const origin: string = this.initialPeriodOrigin();
+      this.state['period'] = origin.length > 0 ? origin : NewStatsPeriodType.LAST_7_DAYS;
+    }
+    if (this.state['chartState'] === undefined) {
+      this.state['chartState'] = NewStatsContentState.LOADED;
+    }
+    if (this.state['loadingPlaceholderVisible'] === undefined) {
+      this.state['loadingPlaceholderVisible'] = false;
+    }
+    if (this.state['metricPickedOnCurrentPeriod'] === undefined) {
+      this.state['metricPickedOnCurrentPeriod'] = false;
+    }
+
+    const committed: NewStatsPeriod = this.restoreInitialPeriod();
+    this.writePeriod('committedPeriod', committed);
+    if (this.state['effectivePeriod'] === undefined) {
+      this.writePeriod('effectivePeriod', committed);
+    }
+    if (this.state['chartType'] === undefined) {
+      this.state['chartType'] = 'bar';
+    }
+    this.state['supportedMetrics'] = supportedNewStatsChartMetrics(committed, this.hourlySeriesMetrics());
+    if (this.state['selectedBar'] === undefined) {
+      this.clearBucketSelectionRecord();
+    }
+    if (this.state['selectedLocationType'] === undefined) {
+      this.state['selectedLocationType'] = NewStatsLocationType.COUNTRIES;
+    }
+    if (this.state['requestIdentity'] === undefined) {
+      this.state['requestIdentity'] = this.requestIdentityRecord(NEW_STATS_SURFACE_VIEWS_CHART);
+    }
+    if (this.state['displayedMetric'] === undefined) {
+      this.state['displayedMetric'] = this.displayedMetricFor(committed);
+    }
+    if (this.state['chartMetric'] === undefined) {
+      this.state['chartMetric'] = newStatsReadString(this.state, 'displayedMetric');
+    }
+    this.state['requestIdentity'] = this.requestIdentityRecord(NEW_STATS_SURFACE_VIEWS_CHART);
+    this.state['canNavigateForward'] = canPageNewStatsForward(committed, this.today);
+    this.state['canNavigateBackward'] = true;
+
+    this.adoptSeededCacheEntry();
+    this.registerSeededInFlightRequests();
+    this.recomputeChartSeries();
+  }
+
+  /** Reads the durable choices back through the repository, never from memory. */
+  private async refreshFromRepository(): Promise<void> {
+    const configuration: NewStatsConfiguration = await this.repository.readConfiguration();
+    if (configuration.selectedMetric.length === 0) {
+      return;
+    }
+    this.persistence['selectedMetric'] = configuration.selectedMetric;
+    if (this.state['persistedMetric'] === undefined) {
+      this.state['persistedMetric'] = configuration.selectedMetric;
+    }
+    if (this.state['selectedMetric'] === undefined) {
+      this.state['selectedMetric'] = configuration.selectedMetric;
+    }
+  }
+
+  // ------------------------------------------------------------- observation
+
+  subscribe(listener: () => void): void {
+    this.listeners.push(listener);
+  }
+
+  private notifyChanged(): void {
+    const snapshot: Array<() => void> = this.listeners;
+    for (const listener of snapshot) {
+      listener();
+    }
+  }
+
+  currentState(): Record<string, Object> {
+    return publishedState(this.state);
+  }
+
+  currentPersistence(): Record<string, Object> {
+    return cloneRecord(this.persistence);
+  }
+
+  todayIso(): string {
+    return this.today;
+  }
+
+  // ------------------------------------------------------------------ state
+
+  /** The origin the screen starts on: explicit state, then persisted choice. */
+  private initialPeriodOrigin(): string {
+    const fromPersistence: string = newStatsReadString(this.persistence, 'periodOrigin');
+    if (fromPersistence.length > 0) {
+      return fromPersistence;
+    }
+    const persisted: string = newStatsReadString(this.persistence, 'period');
+    if (persisted.length > 0) {
+      return persisted;
+    }
+    return newStatsReadString(this.state, 'persistedOrigin');
+  }
+
+  /**
+   * Rebuilds the starting window. A stored concrete range is preferred over
+   * re-resolving the origin, so a restored screen shows the same dates the
+   * user left, while the origin travels with them and keeps its meaning.
+   */
+  private restoreInitialPeriod(): NewStatsPeriod {
+    const stored: Record<string, Object> = newStatsReadRecord(this.state, 'persistedPeriod');
+    const storedStart: string = newStatsReadString(stored, 'start');
+    const storedEnd: string = newStatsReadString(stored, 'end');
+    const origin: string = this.initialPeriodOrigin();
+    if (storedStart.length > 0 && storedEnd.length > 0 && origin.length > 0) {
+      const kind: string = newStatsReadString(stored, 'kind');
+      return {
+        kind: kind.length > 0 ? kind : NewStatsPeriodKind.ROLLING,
+        type: 'custom',
+        origin: origin,
+        start: storedStart,
+        end: storedEnd
+      };
+    }
+    const source: string = newStatsReadString(this.state, 'period');
+    return resolveNewStatsPeriod(source.length > 0 ? source : NewStatsPeriodType.LAST_7_DAYS, this.today);
+  }
+
+  private selectedMetric(): string {
+    return newStatsReadString(this.state, 'selectedMetric');
+  }
+
+  private displayedMetric(): string {
+    return newStatsReadString(this.state, 'displayedMetric');
+  }
+
+  private readCommittedPeriod(): NewStatsPeriod {
+    const raw: Record<string, Object> = newStatsReadRecord(this.state, 'committedPeriod');
+    const start: string = newStatsReadString(raw, 'start');
+    const end: string = newStatsReadString(raw, 'end');
+    const origin: string = newStatsReadString(raw, 'origin');
+    const kind: string = newStatsReadString(raw, 'kind');
+    if (start.length > 0 && end.length > 0) {
+      return {
+        kind: kind.length > 0 ? kind : NewStatsPeriodKind.CUSTOM,
+        type: 'custom',
+        origin: origin.length > 0 ? origin : newStatsReadString(this.state, 'period'),
+        start: start,
+        end: end
+      };
+    }
+    const text: string = newStatsReadString(raw, 'type');
+    const source: string = text.length > 0 ? text : newStatsReadString(this.state, 'period');
+    return resolveNewStatsPeriod(source.length > 0 ? source : NewStatsPeriodType.LAST_7_DAYS, this.today);
+  }
+
+  private readEffectivePeriod(): NewStatsPeriod {
+    const raw: Record<string, Object> = newStatsReadRecord(this.state, 'effectivePeriod');
+    const start: string = newStatsReadString(raw, 'start');
+    const end: string = newStatsReadString(raw, 'end');
+    const origin: string = newStatsReadString(raw, 'origin');
+    const kind: string = newStatsReadString(raw, 'kind');
+    if (start.length > 0 && end.length > 0) {
+      return {
+        kind: kind.length > 0 ? kind : NewStatsPeriodKind.CUSTOM,
+        type: 'custom',
+        origin: origin.length > 0 ? origin : 'custom',
+        start: start,
+        end: end
+      };
+    }
+    return this.readCommittedPeriod();
+  }
+
+  /**
+   * An absent bucket selection is held as an empty record internally, because
+   * the state container cannot hold a null. The published state renders it back
+   * as an explicit null so consumers see "nothing selected" rather than an
+   * empty selection object.
+   */
+  private clearBucketSelectionRecord(): void {
+    const empty: Record<string, Object> = {};
+    this.state['selectedBar'] = empty;
+    this.state['hasSelectedBucket'] = false;
+  }
+
+  private setBucketSelectionRecord(bar: Record<string, Object>): void {
+    this.state['selectedBar'] = bar;
+    this.state['hasSelectedBucket'] = true;
+  }
+
+  private hasBucketSelection(): boolean {
+    const raw: Record<string, Object> = newStatsReadRecord(this.state, 'selectedBar');
+    return Object.keys(raw).length > 0;
+  }
+
+  private writePeriod(key: string, period: NewStatsPeriod): void {
+    const encoded: Record<string, Object> = {};
+    encoded['kind'] = period.kind;
+    encoded['type'] = period.type;
+    encoded['origin'] = period.origin;
+    encoded['start'] = period.start;
+    encoded['end'] = period.end;
+    this.state[key] = encoded;
+  }
+
+  /**
+   * The five identity components the screen requires: surface, site, the
+   * current day, the period, and the request variant.
+   */
+  private requestIdentityFor(surface: string): NewStatsRequestIdentity {
+    const period: NewStatsPeriod = this.readEffectivePeriod();
+    return {
+      surface: surface,
+      siteId: this.siteId,
+      today: this.today,
+      period: period.origin.length > 0 ? period.origin : NewStatsPeriodType.LAST_7_DAYS,
+      variant: this.variant
+    };
+  }
+
+  /**
+   * Cache reuse must also not cross a date-window boundary, so the resolved
+   * window is folded into the key even though the identity itself names only
+   * the period.
+   */
+  private windowKeyFor(period: NewStatsPeriod): string {
+    return period.start + '|' + period.end;
+  }
+
+  private cacheKeyFor(surface: string): string {
+    return newStatsRequestIdentityKey(this.requestIdentityFor(surface)) +
+      '|' + this.windowKeyFor(this.readEffectivePeriod());
+  }
+
+  private requestIdentityRecord(surface: string): Record<string, Object> {
+    const identity: NewStatsRequestIdentity = this.requestIdentityFor(surface);
+    const encoded: Record<string, Object> = {};
+    encoded['surface'] = identity.surface;
+    encoded['siteId'] = identity.siteId;
+    encoded['today'] = identity.today;
+    encoded['period'] = identity.period;
+    encoded['variant'] = identity.variant;
+    return encoded;
+  }
+
+  // ------------------------------------------------------------------ chart
+
+  private metricValue(point: Record<string, Object>, metric: string): number {
+    const raw: Object | undefined = point[metric];
+    if (raw === undefined || raw === null) {
+      return 0;
+    }
+    return raw as number;
+  }
+
+  private bucketFromRecord(point: Record<string, Object>, index: number): NewStatsBucket {
+    const rawPeriod: string = newStatsReadString(point, 'period');
+    const upcomingFlag: boolean = newStatsReadBoolean(point, 'isUpcoming');
+    const beyondToday: boolean = rawPeriod.length > 0 && diffNewStatsDays(this.today, rawPeriod) > 0;
+    const upcoming: boolean = upcomingFlag || beyondToday;
+    return {
+      index: index,
+      rawPeriod: rawPeriod,
+      label: rawPeriod,
+      isUpcoming: upcoming,
+      canDrillDown: !upcoming && rawPeriod.length > 0,
+      views: this.metricValue(point, NewStatsMetric.VIEWS),
+      visitors: this.metricValue(point, NewStatsMetric.VISITORS),
+      likes: this.metricValue(point, NewStatsMetric.LIKES),
+      comments: this.metricValue(point, NewStatsMetric.COMMENTS),
+      posts: this.metricValue(point, NewStatsMetric.POSTS)
+    };
+  }
+
+  private bucketRecords(): Object[] {
+    const current: Object[] = newStatsReadArray(this.state, 'currentPoints');
+    if (current.length > 0) {
+      return current;
+    }
+    const plain: Object[] = newStatsReadArray(this.state, 'points');
+    if (plain.length > 0) {
+      return plain;
+    }
+    return newStatsReadArray(newStatsReadRecord(this.state, 'loadedPeriodData'), 'points');
+  }
+
+  /**
+   * Lays out one bucket per day of the window when the period response carried
+   * no per-bucket rows. Days after today still occupy a slot so the chart has
+   * the same shape all week, but they are marked as placeholders.
+   */
+  private synthesizedBuckets(): NewStatsBucket[] {
+    const period: NewStatsPeriod = this.readCommittedPeriod();
+    const span: number = diffNewStatsDays(period.start, period.end) + 1;
+    const count: number = span > MAX_SYNTHESIZED_BUCKETS ? MAX_SYNTHESIZED_BUCKETS : span;
+    const buckets: NewStatsBucket[] = [];
+    for (let index: number = 0; index < count; index++) {
+      const point: Record<string, Object> = {};
+      point['period'] = addNewStatsDays(period.start, index);
+      point[NewStatsMetric.VIEWS] = 0;
+      point[NewStatsMetric.VISITORS] = 0;
+      point[NewStatsMetric.LIKES] = 0;
+      point[NewStatsMetric.COMMENTS] = 0;
+      point[NewStatsMetric.POSTS] = 0;
+      buckets.push(this.bucketFromRecord(point, index));
+    }
+    return buckets;
+  }
+
+  private buckets(): NewStatsBucket[] {
+    const records: Object[] = this.bucketRecords();
+    if (records.length === 0) {
+      return this.synthesizedBuckets();
+    }
+    const buckets: NewStatsBucket[] = [];
+    for (let index: number = 0; index < records.length; index++) {
+      buckets.push(this.bucketFromRecord(records[index] as Record<string, Object>, index));
+    }
+    return buckets;
+  }
+
+  private selectedBucketIndex(): number {
+    if (!this.hasBucketSelection()) {
+      return -1;
+    }
+    const raw: Record<string, Object> = newStatsReadRecord(this.state, 'selectedBar');
+    return newStatsReadNumber(raw, 'index');
+  }
+
+  private selectedBucket(): NewStatsBucket | undefined {
+    if (!this.hasBucketSelection()) {
+      return undefined;
+    }
+    const buckets: NewStatsBucket[] = this.buckets();
+    const index: number = this.selectedBucketIndex();
+    if (index < 0 || index >= buckets.length) {
+      return undefined;
+    }
+    return buckets[index];
+  }
+
+  private bucketValue(bucket: NewStatsBucket, metric: string): number {
+    if (metric === NewStatsMetric.VIEWS) {
+      return bucket.views;
+    }
+    if (metric === NewStatsMetric.VISITORS) {
+      return bucket.visitors;
+    }
+    if (metric === NewStatsMetric.LIKES) {
+      return bucket.likes;
+    }
+    if (metric === NewStatsMetric.COMMENTS) {
+      return bucket.comments;
+    }
+    return bucket.posts;
+  }
+
+  /**
+   * Recomputes the chart surface from data already held for the committed
+   * window. A metric change or a bucket tap both land here, which is why
+   * neither of them needs a network round trip.
+   */
+  private recomputeChartSeries(): void {
+    const period: NewStatsPeriod = this.readCommittedPeriod();
+    const chosen: string = this.displayedMetric();
+    const values: number[] = [];
+    const buckets: NewStatsBucket[] = this.buckets();
+    let elapsedCount: number = 0;
+    let elapsedSum: number = 0;
+    for (const bucket of buckets) {
+      const value: number = this.bucketValue(bucket, chosen);
+      values.push(value);
+      if (!bucket.isUpcoming) {
+        elapsedCount += 1;
+        elapsedSum += value;
+      }
+    }
+    this.state['chartPointValues'] = values;
+    this.state['chartBuckets'] = this.encodedBuckets(buckets);
+    this.state['futureBucketCount'] = buckets.length - elapsedCount;
+    this.state['elapsedBucketCount'] = elapsedCount;
+    this.state['elapsedBucketAverage'] = elapsedCount > 0 ? elapsedSum / elapsedCount : 0;
+
+    const totals: Record<string, Object> = newStatsReadRecord(newStatsReadRecord(this.state, 'loadedPeriodData'),
+      'totals');
+    const total: Object | undefined = totals[chosen];
+    const selected: NewStatsBucket | undefined = this.selectedBucket();
+    if (selected !== undefined) {
+      this.state['chartTotal'] = this.bucketValue(selected, chosen);
+      this.state['chartRangeStart'] = selected.rawPeriod;
+      this.state['chartRangeEnd'] = selected.rawPeriod;
+    } else {
+      this.state['chartTotal'] = total === undefined ? elapsedSum : (total as number);
+      this.state['chartRangeStart'] = period.start;
+      this.state['chartRangeEnd'] = period.end;
+    }
+    this.state['chartMetric'] = chosen;
+    this.state['chartSeriesMetric'] = chosen;
+    this.state['chartHourly'] = isHourlyNewStatsPeriod(period);
+  }
+
+  private encodedBuckets(buckets: NewStatsBucket[]): Object[] {
+    const encoded: Object[] = [];
+    for (const bucket of buckets) {
+      const record: Record<string, Object> = {};
+      record['index'] = bucket.index;
+      record['rawPeriod'] = bucket.rawPeriod;
+      record['isUpcoming'] = bucket.isUpcoming;
+      record['canDrillDown'] = bucket.canDrillDown;
+      record[NewStatsMetric.VIEWS] = bucket.views;
+      record[NewStatsMetric.VISITORS] = bucket.visitors;
+      record[NewStatsMetric.LIKES] = bucket.likes;
+      record[NewStatsMetric.COMMENTS] = bucket.comments;
+      record[NewStatsMetric.POSTS] = bucket.posts;
+      encoded.push(record);
+    }
+    return encoded;
+  }
+
+  /**
+   * Chooses what the chart can actually draw for the current window. The
+   * user's preference is never overwritten here: a metric the window cannot
+   * represent is simply not drawn.
+   */
+  /**
+   * The metrics the hourly endpoint publishes for this site. Sites that expose
+   * more than views there get those metrics treated as drawable too.
+   */
+private hourlySeriesMetrics(): string[] | undefined {
+    const declared: string[] = newStatsReadStringArray(this.state, 'hourlySeriesMetrics');
+    return declared.length > 0 ? declared : undefined;
+  }
+
+  private displayedMetricFor(period: NewStatsPeriod): string {
+    const chosen: string = this.selectedMetric();
+    if (supportsNewStatsChartMetric(period, chosen, this.hourlySeriesMetrics())) {
+      return chosen;
+    }
+    return fallbackNewStatsMetric(period, this.hourlySeriesMetrics());
+  }
+
+  /**
+   * Resolves the chart's metric state for the current window.
+   *
+   * `explicitPick` distinguishes the two ways an unsupported metric can arise.
+   * When the user picked it on this window, the chart says so; when it is only
+   * a preference carried over from somewhere else, the chart quietly draws a
+   * metric it can represent and keeps the preference for a compatible window.
+   */
+  private syncChartStateAfterPeriodChange(explicitPick: boolean): void {
+    const period: NewStatsPeriod = this.readCommittedPeriod();
+    const chosen: string = this.selectedMetric();
+    const drawable: boolean = supportsNewStatsChartMetric(period, chosen, this.hourlySeriesMetrics());
+    const pickedHere: boolean = explicitPick || newStatsReadBoolean(this.state, 'metricPickedOnCurrentPeriod');
+    this.state['supportedMetrics'] = supportedNewStatsChartMetrics(period, this.hourlySeriesMetrics());
+    if (!drawable && pickedHere) {
+      // The user asked for something this window cannot draw. The header keeps
+      // naming the metric they asked for and the chart reports it as
+      // unavailable, rather than silently drawing a different metric.
+      this.state['displayedMetric'] = chosen;
+      this.state['unavailableMetric'] = chosen;
+      this.state['chartState'] = NewStatsContentState.METRIC_UNAVAILABLE;
+      return;
+    }
+    this.state['displayedMetric'] = this.displayedMetricFor(period);
+    if (drawable) {
+      this.state['unavailableMetric'] = '';
+    }
+    if (this.state['chartState'] !== NewStatsContentState.ERROR) {
+      this.state['chartState'] = NewStatsContentState.LOADED;
+    }
+  }
+
+  // ------------------------------------------------------------ remote calls
+
+  private async emit(effect: NewStatsEffect): Promise<void> {
+    await this.leaf.emit(effect);
+  }
+
+  private scriptedOutcome(event: Record<string, Object>): string {
+    return newStatsReadString(event, 'outcome');
+  }
+
+  private scriptedPayload(event: Record<string, Object>): Record<string, Object> | undefined {
+    const direct: Record<string, Object> = newStatsReadRecord(event, 'result');
+    if (Object.keys(direct).length > 0) {
+      return direct;
+    }
+    const data: Record<string, Object> = newStatsReadRecord(event, 'data');
+    if (Object.keys(data).length > 0) {
+      return data;
+    }
+    return undefined;
+  }
+
+  private async request(channel: string, surface: string, forceRefresh: boolean, event: Record<string, Object>,
+    generation: number): Promise<NewStatsRemoteResponse[]> {
+    const period: NewStatsPeriod = this.readEffectivePeriod();
+    const request: NewStatsRemoteRequest = {
+      channel: channel,
+      surface: surface,
+      siteId: this.siteId,
+      // The window travels with the request and comes back on the response, so
+      // a result is always filed under the window it was actually fetched for.
+      periodKey: this.windowKeyFor(period),
+      variant: this.variant,
+      forceRefresh: forceRefresh,
+      generation: generation,
+      outcome: this.scriptedOutcome(event),
+      payload: this.scriptedPayload(event)
+    };
+    this.ledger.begin(channel, generation);
+    const responses: NewStatsRemoteResponse[] = this.remote.dispatch(request, this.state);
+    return responses;
+  }
+
+  private completionRank(channel: string): number {
+    const order: string[] = newStatsReadStringArray(this.state, 'completionOrder');
+    const index: number = order.indexOf(channel);
+    return index >= 0 ? index : order.length;
+  }
+
+  /**
+   * Applies a response only when it belongs to the current refresh boundary.
+   * A result that started before the boundary is discarded rather than
+   * repopulating refreshed state.
+   */
+  private async applyResponse(response: NewStatsRemoteResponse, event: Record<string, Object>): Promise<boolean> {
+    if (!this.ledger.isCurrent(response.generation)) {
+      await this.emit({
+        name: 'discardStaleStatsResult',
+        source: 'Index.NewStatsStore.ledger',
+        siteId: this.siteId,
+        channel: response.channel
+      });
+      this.ledger.finish(response.channel);
+      return false;
+    }
+    this.ledger.finish(response.channel);
+    if (response.channel === NEW_STATS_CHANNEL_REGION_VIEWS) {
+      await this.applyRegionResponse(response, event);
+      return true;
+    }
+    if (response.outcome === NEW_STATS_OUTCOME_SUCCESS) {
+      // The generation check above guarantees this response's window is still
+      // the current one, so the identity read here is the one it was sent under.
+      this.applyStatsPayload(response.payload, response.channel, event,
+        this.requestIdentityFor(NEW_STATS_SURFACE_VIEWS_CHART), response.windowKey);
+      return true;
+    }
+    this.applyStatsFailure(response, response.outcome === NEW_STATS_OUTCOME_NETWORK_ERROR);
+    return false;
+  }
+
+  private applyStatsPayload(payload: Record<string, Object>, channel: string, event: Record<string, Object>,
+    identity: NewStatsRequestIdentity, responseWindowKey: string): void {
+    const loaded: Record<string, Object> = newStatsReadRecord(payload, 'totals');
+    if (Object.keys(loaded).length > 0) {
+      const descriptor: Record<string, Object> = {};
+      descriptor['totals'] = loaded;
+      const points: Object[] = newStatsReadArray(payload, 'points');
+      if (points.length > 0) {
+        descriptor['points'] = points;
+      }
+      this.state['loadedPeriodData'] = descriptor;
+    }
+    const views: Object | undefined = payload[KEY_VIEWS];
+    if (views !== undefined && views !== null) {
+      this.state[KEY_VIEWS] = views as number;
+      this.state['visibleViews'] = views as number;
+    }
+    this.state['loadingPlaceholderVisible'] = false;
+    this.state['needsRevalidation'] = false;
+    this.state['refreshing'] = false;
+    this.state['backgroundRevalidationPending'] = false;
+    // A successful load resolves any outstanding failure state.
+    this.state['retryAvailable'] = false;
+    this.state['lastError'] = '';
+    this.state['revalidationError'] = '';
+    // A period load does not resolve a metric the window cannot draw: that
+    // state only changes when the metric or the period does.
+    if (this.state['chartState'] !== NewStatsContentState.METRIC_UNAVAILABLE) {
+      this.state['chartState'] = NewStatsContentState.LOADED;
+    }
+    this.recomputeChartSeries();
+    // Only a response that actually carried data becomes the cached value, and
+    // it is then marked as revalidated. An empty answer must not be cached, or
+    // a cold start would look like a valid result on the next visit.
+    if (Object.keys(payload).length > 0) {
+      // Same key shape a live lookup produces, using the window the response
+      // was requested for, so a result can never be filed under another window.
+      const key: string = newStatsRequestIdentityKey(identity) + '|' + responseWindowKey;
+      this.cache.write(key, identity, this.cachePayload(), this.today, false);
+      if (channel === NEW_STATS_CHANNEL_REFRESH) {
+        this.state['cachedViewsForNextVisit'] = newStatsReadNumber(this.state, KEY_VIEWS);
+      }
+    }
+    void event;
+  }
+
+  /**
+   * The cache holds the figures the screen would show for this window, so a
+   * cache hit can rebuild the whole card rather than just its headline number.
+   */
+  private cachePayload(): Record<string, Object> {
+    const payload: Record<string, Object> = {};
+    const loaded: Record<string, Object> = newStatsReadRecord(this.state, 'loadedPeriodData');
+    const totals: Record<string, Object> = newStatsReadRecord(loaded, 'totals');
+    const keys: string[] = Object.keys(totals);
+    for (const key of keys) {
+      payload[key] = totals[key];
+    }
+    const points: Object[] = newStatsReadArray(loaded, 'points');
+    if (points.length > 0) {
+      payload['points'] = points;
+    }
+    payload[KEY_VIEWS] = newStatsReadNumber(this.state, KEY_VIEWS);
+    return payload;
+  }
+
+  /**
+   * A foreground failure stops loading and offers the ordinary retry. A
+   * background revalidation failure keeps whatever cached content is already
+   * usable and stays out of the way.
+   */
+  private applyStatsFailure(response: NewStatsRemoteResponse, offline: boolean): void {
+    const key: string = this.cacheKeyFor(NEW_STATS_SURFACE_VIEWS_CHART);
+    const cached: NewStatsCacheEntry | undefined = this.cache.read(key);
+    this.state['backgroundRevalidationPending'] = false;
+    if (response.channel === NEW_STATS_CHANNEL_REVALIDATION && cached !== undefined) {
+      // The cached result stays exactly as it was, and stays revalidation-due.
+      this.restoreCachedEntry(cached);
+      this.state['chartState'] = NewStatsContentState.LOADED;
+      this.state['loadingPlaceholderVisible'] = false;
+      this.state['needsRevalidation'] = true;
+      this.state['revalidationError'] = offline ? 'offline' : response.errorCode;
+      this.cache.write(key, cached.identity, cached.payload, cached.storedOn, true);
+      return;
+    }
+    if (cached !== undefined) {
+      // Cached content is still the best thing to show, but the foreground
+      // attempt has ended, so the screen must stop loading and offer a retry.
+      this.restoreCachedEntry(cached);
+      this.state['chartState'] = NewStatsContentState.ERROR;
+      this.state['loadingPlaceholderVisible'] = false;
+      this.state['retryAvailable'] = true;
+      this.state['needsRevalidation'] = true;
+      this.state['lastError'] = offline ? 'offline' : response.errorCode;
+      return;
+    }
+    this.state['chartState'] = NewStatsContentState.ERROR;
+    this.state['loadingPlaceholderVisible'] = false;
+    this.state['refreshing'] = false;
+    this.state['retryAvailable'] = true;
+    this.state['lastError'] = offline ? 'offline' : response.errorCode;
+  }
+
+  private restoreCachedEntry(entry: NewStatsCacheEntry): void {
+    const cachedPoints: Object[] = newStatsReadArray(entry.payload, 'points');
+    const cachedTotals: Record<string, Object> = {};
+    const keys: string[] = Object.keys(entry.payload);
+    for (const key of keys) {
+      if (key === 'points') {
+        continue;
+      }
+      cachedTotals[key] = entry.payload[key];
+    }
+    if (Object.keys(cachedTotals).length > 0 || cachedPoints.length > 0) {
+      const descriptor: Record<string, Object> = {};
+      if (Object.keys(cachedTotals).length > 0) {
+        descriptor['totals'] = cachedTotals;
+      }
+      if (cachedPoints.length > 0) {
+        descriptor['points'] = cachedPoints;
+      }
+      this.state['loadedPeriodData'] = descriptor;
+      this.state['currentPoints'] = cachedPoints;
+    }
+    const views: Object | undefined = entry.payload[KEY_VIEWS];
+    if (views !== undefined && views !== null) {
+      this.state[KEY_VIEWS] = views as number;
+      this.state['visibleViews'] = views as number;
+      this.state['cachedViewsForNextVisit'] = views as number;
+    }
+    this.state['loadingPlaceholderVisible'] = false;
+    this.recomputeChartSeries();
+  }
+
+  // ------------------------------------------------------------------- cache
+
+  private adoptSeededCacheEntry(): void {
+    const seededIdentity: Record<string, Object> = newStatsReadRecord(this.state, 'requestIdentity');
+    const cached: Record<string, Object> = newStatsReadRecord(this.state, 'displayedCachedResult');
+    const site: number = newStatsReadNumber(seededIdentity, 'siteId');
+    const surface: string = newStatsReadString(seededIdentity, 'surface');
+    const day: string = newStatsReadString(seededIdentity, 'today');
+    const period: string = newStatsReadString(seededIdentity, 'period');
+    const variant: string = newStatsReadString(seededIdentity, 'variant');
+    const seededViews: number = newStatsReadNumber(cached, KEY_VIEWS);
+    if (surface.length === 0 || Object.keys(cached).length === 0) {
+      return;
+    }
+    const identity: NewStatsRequestIdentity = {
+      surface: surface,
+      siteId: site,
+      today: day.length > 0 ? day : this.today,
+      period: period,
+      variant: variant
+    };
+    // Key the restored entry exactly the way a live lookup would, so a revisit
+    // finds it without any special-casing.
+    const entry: NewStatsCacheEntry = {
+      key: this.cacheKeyFor(NEW_STATS_SURFACE_VIEWS_CHART),
+      identity: identity,
+      payload: cached,
+      storedOn: day.length > 0 ? day : this.today,
+      needsRevalidation: newStatsReadBoolean(this.state, 'needsRevalidation')
+    };
+    this.cache.adopt(entry);
+    this.state[KEY_VIEWS] = seededViews;
+    this.state['visibleViews'] = seededViews;
+  }
+
+  private registerSeededInFlightRequests(): void {
+    const older: Record<string, Object> = newStatsReadRecord(this.state, 'olderRequest');
+    const status: string = newStatsReadString(older, 'status');
+    if (status === 'in_flight') {
+      this.ledger.begin(NEW_STATS_CHANNEL_OLDER_REQUEST, this.ledger.currentGeneration());
+    }
+  }
+
+  // -------------------------------------------------------------- dispatcher
+
+  async invoke(name: string, event: Record<string, Object>): Promise<void> {
+    await this.dispatch(name, event);
+    await this.persist();
+    this.notifyChanged();
+  }
+
+  private async dispatch(name: string, event: Record<string, Object>): Promise<void> {
+    if (name === 'loadPeriodData') {
+      await this.onLoadPeriodData(event);
+      return;
+    }
+    if (name === 'selectMetric') {
+      await this.onSelectMetric(event);
+      return;
+    }
+    if (name === 'selectPeriod') {
+      await this.onSelectPeriod(event);
+      return;
+    }
+    if (name === 'tapChartBucket') {
+      await this.onTapChartBucket(event);
+      return;
+    }
+    if (name === 'drillIntoSelectedBucket') {
+      await this.onDrillIntoSelectedBucket(event);
+      return;
+    }
+    if (name === 'navigateBackward') {
+      await this.onNavigateBackward(event);
+      return;
+    }
+    if (name === 'navigateForwardAfterRestore') {
+      await this.onNavigateForward(event);
+      return;
+    }
+    if (name === 'navigateForward') {
+      await this.onNavigateForward(event);
+      return;
+    }
+    if (name === 'recreateStatsSurface') {
+      await this.onRecreateStatsSurface(event);
+      return;
+    }
+    if (name === 'revisitStatsSurface') {
+      await this.onRevisitStatsSurface(event);
+      return;
+    }
+    if (name === 'backgroundRevalidation' || name === 'backgroundRevalidationFailure') {
+      await this.onBackgroundRevalidation(event);
+      return;
+    }
+    if (name === 'retryBackgroundRevalidation') {
+      await this.onRetryBackgroundRevalidation(event);
+      return;
+    }
+    if (name === 'pullToRefresh') {
+      await this.onPullToRefresh(event);
+      return;
+    }
+    if (name === 'retry' || name === 'retryLoad') {
+      await this.onRetry(event);
+      return;
+    }
+    if (name === 'selectLocationType') {
+      await this.onSelectLocationType(event);
+      return;
+    }
+    if (name === 'openPlanAction') {
+      await this.emit({ name: 'openPlanUpgrade', destination: this.planActionDestination() });
+      return;
+    }
+  }
+
+  private async fetchPeriodData(event: Record<string, Object>): Promise<void> {
+    const generation: number = this.ledger.currentGeneration();
+    this.state['periodFetchCount'] = newStatsReadNumber(this.state, 'periodFetchCount') + 1;
+    this.state['loadingPlaceholderVisible'] = true;
+    if (this.state['chartState'] !== NewStatsContentState.METRIC_UNAVAILABLE) {
+      this.state['chartState'] = NewStatsContentState.LOADING;
+    }
+    this.state['refreshing'] = false;
+    await this.emit({
+      name: 'fetchStatsForPeriod',
+      source: 'Index.NewStatsStore.period',
+      siteId: this.siteId,
+      selectedMetric: this.displayedMetric(),
+      selectedPeriodType: this.readCommittedPeriod().origin,
+      forceRefresh: newStatsReadBoolean(event, 'forceRefresh'),
+      period: this.requestIdentityRecord(NEW_STATS_SURFACE_VIEWS_CHART)
+    });
+    const responses: NewStatsRemoteResponse[] = await this.request(NEW_STATS_CHANNEL_PERIOD_DATA,
+      NEW_STATS_SURFACE_VIEWS_CHART, false, event, generation);
+    for (const response of responses) {
+      await this.applyResponse(response, event);
+    }
+  }
+
+  private async onLoadPeriodData(event: Record<string, Object>): Promise<void> {
+    await this.fetchPeriodData(event);
+  }
+
+  private async onSelectMetric(event: Record<string, Object>): Promise<void> {
+    const metric: string = newStatsReadString(event, 'metric');
+    if (metric.length === 0) {
+      return;
+    }
+    this.state['selectedMetric'] = metric;
+    // The preference is durable regardless of whether this window can draw it.
+    this.state['persistedMetric'] = metric;
+    this.state['metricPickedOnCurrentPeriod'] = true;
+    this.persistence['selectedMetric'] = metric;
+    this.syncChartStateAfterPeriodChange(true);
+    await this.emit({ name: 'selectChartMetric', selectedMetric: metric, metric: metric, siteId: this.siteId });
+    // The period response already carries every metric, so this only redraws.
+    this.recomputeChartSeries();
+  }
+
+  private async onSelectPeriod(event: Record<string, Object>): Promise<void> {
+    const origin: string = newStatsReadString(event, 'period');
+    if (origin.length === 0) {
+      return;
+    }
+    const period: NewStatsPeriod = resolveNewStatsPeriod(origin, this.today);
+    this.state['period'] = origin;
+    this.commitPeriod(period);
+    this.state['metricPickedOnCurrentPeriod'] = false;
+    this.syncChartStateAfterPeriodChange(false);
+    this.recomputeChartSeries();
+    await this.emit({
+      name: 'selectStatsPeriod',
+      originPeriodType: this.readCommittedPeriod().origin,
+      origin: origin,
+      selectedPeriodType: origin,
+      customStart: period.start,
+      customEnd: period.end,
+      siteId: this.siteId
+    });
+    await this.fetchPeriodData(event);
+  }
+
+  /** Every committed period change invalidates any soft bucket selection. */
+  private commitPeriod(period: NewStatsPeriod): void {
+    // Committing a window opens a new refresh boundary, so a period response
+    // that is still in flight for the previous window cannot land on this one.
+    this.ledger.invalidate();
+    this.writePeriod('committedPeriod', period);
+    this.writePeriod('effectivePeriod', period);
+    this.clearBucketSelectionRecord();
+    // The previous window's series must not linger under the new window.
+    this.state['currentPoints'] = [];
+    this.state['previousPoints'] = [];
+    this.state['period'] = period.origin;
+    this.state['canNavigateForward'] = canPageNewStatsForward(period, this.today);
+    this.state['canNavigateBackward'] = true;
+    this.state['persistedOrigin'] = period.origin;
+    const persistedPeriod: Record<string, Object> = {};
+    persistedPeriod['type'] = 'custom';
+    persistedPeriod['start'] = period.start;
+    persistedPeriod['end'] = period.end;
+    this.state['persistedPeriod'] = persistedPeriod;
+    this.state['restoredOrigin'] = period.origin;
+    this.persistence['period'] = period.origin;
+    this.persistence['periodOrigin'] = period.origin;
+    this.persistence['periodStart'] = period.start;
+    this.persistence['periodEnd'] = period.end;
+    this.persistence['periodKind'] = period.kind;
+  }
+
+  private async onTapChartBucket(event: Record<string, Object>): Promise<void> {
+    const index: number = newStatsReadNumber(event, 'index');
+    const buckets: NewStatsBucket[] = this.buckets();
+    const bucket: NewStatsBucket | undefined = this.resolveTapTarget(index, buckets);
+    if (bucket === undefined) {
+      // A placeholder for a bucket that has not happened yet is not actionable.
+      return;
+    }
+    if (this.selectedBucketIndex() === index) {
+      this.clearBucketSelection();
+      return;
+    }
+    const bar: Record<string, Object> = {};
+    bar['index'] = bucket.index;
+    bar['rawPeriod'] = bucket.rawPeriod;
+    bar['canDrillDown'] = bucket.canDrillDown;
+    this.setBucketSelectionRecord(bar);
+    const effective: NewStatsPeriod = {
+      kind: NewStatsPeriodKind.CUSTOM,
+      type: 'custom',
+      origin: 'custom',
+      start: bucket.rawPeriod,
+      end: bucket.rawPeriod
+    };
+    this.writePeriod('effectivePeriod', effective);
+    this.state['canDrillDown'] = bucket.canDrillDown;
+    this.recomputeChartSeries();
+    await this.emit({
+      name: 'chartBucketSelected',
+      siteId: this.siteId,
+      index: bucket.index,
+      rawPeriod: bucket.rawPeriod,
+      canDrillDown: bucket.canDrillDown
+    });
+  }
+
+  private resolveTapTarget(index: number, buckets: NewStatsBucket[]): NewStatsBucket | undefined {
+    if (index >= 0 && index < buckets.length) {
+      const bucket: NewStatsBucket = buckets[index];
+      if (bucket.isUpcoming || bucket.rawPeriod.length === 0) {
+        return undefined;
+      }
+      return bucket;
+    }
+    return undefined;
+  }
+
+  private clearBucketSelection(): void {
+    this.clearBucketSelectionRecord();
+    this.writePeriod('effectivePeriod', this.readCommittedPeriod());
+    this.state['canDrillDown'] = false;
+    this.recomputeChartSeries();
+  }
+
+  private onDrillIntoSelectedBucket(event: Record<string, Object>): Promise<void> {
+    const bucket: NewStatsBucket | undefined = this.selectedBucket();
+    if (bucket === undefined || !bucket.canDrillDown) {
+      return Promise.resolve();
+    }
+    const target: NewStatsPeriod = {
+      kind: NewStatsPeriodKind.CUSTOM,
+      type: 'custom',
+      origin: 'custom',
+      start: bucket.rawPeriod,
+      end: bucket.rawPeriod
+    };
+    // The transient selection goes away as part of committing, before the
+    // destination has finished loading.
+    this.state['canDrillDown'] = false;
+    this.state['metricPickedOnCurrentPeriod'] = false;
+    this.commitPeriod(target);
+    this.syncChartStateAfterPeriodChange(false);
+    this.recomputeChartSeries();
+    return this.commitDrillDown(target, event);
+  }
+
+  /** Finishes a committed drill-down: every surface now shows the new day. */
+  private async commitDrillDown(target: NewStatsPeriod, event: Record<string, Object>): Promise<void> {
+    await this.emit({
+      name: 'commitChartBucketPeriod',
+      siteId: this.siteId,
+      customStart: target.start,
+      customEnd: target.end,
+      originPeriodType: 'custom',
+      origin: 'custom'
+    });
+    await this.fetchPeriodData(event);
+  }
+
+  private async pagePeriod(direction: number, event: Record<string, Object>): Promise<void> {
+    const period: NewStatsPeriod = this.readCommittedPeriod();
+    let next: NewStatsPeriod | undefined;
+    if (direction > 0) {
+      next = pageNewStatsForward(period, this.today);
+    } else {
+      next = pageNewStatsBackward(period);
+    }
+    if (next === undefined) {
+      this.state['canNavigateForward'] = false;
+      await this.emit({ name: 'pageStatsPeriod', result: 'blocked_at_present_edge', siteId: this.siteId });
+      return;
+    }
+    this.commitPeriod(next);
+    this.state['metricPickedOnCurrentPeriod'] = false;
+    this.syncChartStateAfterPeriodChange(false);
+    this.recomputeChartSeries();
+    const after: NewStatsPeriod = this.readCommittedPeriod();
+    const paged: Record<string, Object> = {};
+    paged['type'] = after.type;
+    paged['start'] = after.start;
+    paged['end'] = after.end;
+    paged['origin'] = after.origin;
+    paged['kind'] = after.kind;
+    this.state['selectedPeriodAfterNavigation'] = paged;
+    this.state['canNavigateForwardAfterNavigation'] = canPageNewStatsForward(after, this.today);
+    await this.emit({
+      name: 'pageStatsPeriod',
+      originPeriodType: after.origin,
+      origin: after.origin,
+      customStart: after.start,
+      customEnd: after.end,
+      siteId: this.siteId
+    });
+    await this.fetchPeriodData(event);
+  }
+
+  private async onNavigateBackward(event: Record<string, Object>): Promise<void> {
+    await this.pagePeriod(-1, event);
+  }
+
+  private async onNavigateForward(event: Record<string, Object>): Promise<void> {
+    await this.pagePeriod(1, event);
+  }
+
+  /**
+   * Process recreation. The window, its semantic origin and the metric choice
+   * all come back through the repository rather than from anything this
+   * instance happened to be holding.
+   */
+  private async onRecreateStatsSurface(event: Record<string, Object>): Promise<void> {
+    const configuration: NewStatsConfiguration = await this.repository.readConfiguration();
+    if (configuration.selectedMetric.length > 0) {
+      // The metric comes back from durable storage, not from this instance.
+      this.persistence['selectedMetric'] = configuration.selectedMetric;
+      this.state['persistedMetric'] = configuration.selectedMetric;
+      this.state['selectedMetric'] = configuration.selectedMetric;
+    }
+    const restored: NewStatsPeriod = await this.repository.readPeriod(this.today);
+    this.state['restoredOrigin'] = restored.origin;
+    this.state['period'] = restored.origin;
+    // Recreating opens a new refresh boundary for the restored window.
+    this.ledger.invalidate();
+    this.writePeriod('committedPeriod', restored);
+    this.writePeriod('effectivePeriod', restored);
+    this.clearBucketSelectionRecord();
+    this.state['canNavigateForward'] = canPageNewStatsForward(restored, this.today);
+    this.state['canNavigateBackward'] = true;
+    this.state['requestIdentity'] = this.requestIdentityRecord(NEW_STATS_SURFACE_VIEWS_CHART);
+    this.adoptSeededCacheEntry();
+    // A restored metric that the restored window cannot draw falls back for
+    // display, without the restored preference being discarded.
+    this.syncChartStateAfterPeriodChange(false);
+    this.recomputeChartSeries();
+    await this.emit({
+      name: 'restoreNewStatsConfiguration',
+      source: 'Index.NewStatsConfigurationRepository',
+      originPeriodType: restored.origin,
+      selectedMetric: configuration.selectedMetric,
+      siteId: this.siteId
+    });
+    void event;
+  }
+
+  private async onRevisitStatsSurface(event: Record<string, Object>): Promise<void> {
+    const identity: NewStatsRequestIdentity = this.requestIdentityFor(NEW_STATS_SURFACE_VIEWS_CHART);
+    const key: string = this.cacheKeyFor(NEW_STATS_SURFACE_VIEWS_CHART);
+    const entry: NewStatsCacheEntry | undefined = this.cache.read(key);
+    if (entry === undefined) {
+      await this.fetchPeriodData(event);
+      return;
+    }
+    // Reusing cached content means the screen is usable before the network answers.
+    this.restoreCachedEntry(entry);
+    this.state['chartState'] = NewStatsContentState.LOADED;
+    this.state['loadingPlaceholderVisible'] = false;
+    this.state['needsRevalidation'] = entry.needsRevalidation;
+    await this.emit({
+      name: 'reuseCachedNewStats',
+      source: 'Index.NewStatsResponseCache',
+      siteId: this.siteId,
+      cached: true,
+      period: this.requestIdentityRecord(NEW_STATS_SURFACE_VIEWS_CHART)
+    });
+    if (entry.needsRevalidation) {
+      // The screen is already usable; the check runs behind it and may only
+      // ever replace what is cached once it has fully succeeded.
+      this.state['backgroundRevalidationPending'] = true;
+      await this.emit({
+        name: 'revalidateNewStats',
+        source: 'Index.NewStatsStore.background',
+        siteId: this.siteId,
+        period: this.requestIdentityRecord(NEW_STATS_SURFACE_VIEWS_CHART)
+      });
+    }
+  }
+
+  /**
+   * A background revalidation that fails must leave the cached result in
+   * place: no blocking error, no placeholder, the data still readable.
+   */
+  private async revalidate(event: Record<string, Object>): Promise<void> {
+    const generation: number = this.ledger.currentGeneration();
+    this.state['backgroundRevalidationPending'] = true;
+    await this.emit({
+      name: 'revalidateNewStats',
+      source: 'Index.NewStatsStore.background',
+      siteId: this.siteId,
+      period: this.requestIdentityRecord(NEW_STATS_SURFACE_VIEWS_CHART)
+    });
+    const responses: NewStatsRemoteResponse[] = await this.request(NEW_STATS_CHANNEL_REVALIDATION,
+      NEW_STATS_SURFACE_VIEWS_CHART, false, event, generation);
+    for (const response of responses) {
+      const accepted: boolean = await this.applyResponse(response, event);
+      if (!accepted) {
+        await this.emit({
+          name: 'revalidationFailedKeepingCachedContent',
+          source: 'Index.NewStatsStore.background',
+          siteId: this.siteId,
+          cached: true
+        });
+      }
+    }
+  }
+
+  private async onBackgroundRevalidation(event: Record<string, Object>): Promise<void> {
+    await this.revalidate(event);
+  }
+
+  private async onRetryBackgroundRevalidation(event: Record<string, Object>): Promise<void> {
+    this.state['retryAvailable'] = false;
+    await this.revalidate(event);
+  }
+
+  /**
+   * Pull to refresh. The new boundary is established first, so anything that
+   * was already in flight is stale from that moment on and cannot write over
+   * the refreshed result when it eventually lands.
+   */
+  private async onPullToRefresh(event: Record<string, Object>): Promise<void> {
+    const generation: number = this.ledger.invalidate();
+    this.cache.invalidate(this.cacheKeyFor(NEW_STATS_SURFACE_VIEWS_CHART));
+    await this.emit({
+      name: 'invalidateNewStatsCache',
+      source: 'Index.NewStatsResponseCache',
+      siteId: this.siteId
+    });
+    this.state['refreshing'] = true;
+    this.state['refreshingAfterCompletion'] = true;
