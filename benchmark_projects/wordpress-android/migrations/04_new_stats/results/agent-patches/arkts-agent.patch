new file mode 100644
index 0000000000000000000000000000000000000000..4005c4dbccc772fe7db45c21951a0da156489b18
--- /dev/null
+++ b/entry/src/main/ets/feature/NewStatsConfigurationRepository.ets
@@ -0,0 +1,155 @@
+import { preferences } from '@kit.ArkData';
+import { common } from '@kit.AbilityKit';
+import { NewStatsMetric, NewStatsPeriod, resolveNewStatsPeriod } from './NewStatsDomain';
+
+const NEW_STATS_PREFERENCES_NAME: string = 'wordpress_new_stats';
+const KEY_SESSION: string = 'session';
+const KEY_CONFIGURATION: string = 'configuration';
+
+/**
+ * The user's durable stats choices: which metric they want to compare, and the
+ * period they were last looking at.
+ *
+ * The period is stored twice on purpose. `origin` keeps the semantic choice
+ * (rolling window versus calendar period) so restoring after process death
+ * cannot reinterpret a rolling window as a calendar period just because its
+ * dates happen to line up, while `start`/`end` keep the exact window so the
+ * same dates are shown again.
+ */
+export interface NewStatsConfiguration {
+  selectedMetric: string;
+  periodOrigin: string;
+  periodStart: string;
+  periodEnd: string;
+  periodKind: string;
+  locationType: string;
+}
+
+export function defaultNewStatsConfiguration(): NewStatsConfiguration {
+  return {
+    selectedMetric: NewStatsMetric.VIEWS,
+    periodOrigin: '',
+    periodStart: '',
+    periodEnd: '',
+    periodKind: '',
+    locationType: ''
+  };
+}
+
+function readString(source: Record<string, Object>, key: string): string {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return '';
+  }
+  return raw as string;
+}
+
+/** Derives the persisted configuration from a stored session snapshot. */
+export function newStatsConfigurationFromSession(session: Record<string, Object>): NewStatsConfiguration {
+  const config: NewStatsConfiguration = defaultNewStatsConfiguration();
+  const metric: string = readString(session, 'persistedMetric');
+  if (metric.length > 0) {
+    config.selectedMetric = metric;
+  }
+  const origin: string = readString(session, 'persistedOrigin');
+  if (origin.length > 0) {
+    config.periodOrigin = origin;
+  }
+  const periodRecord: Record<string, Object> = newStatsPeriodRecord(session, 'persistedPeriod');
+  config.periodStart = readString(periodRecord, 'start');
+  config.periodEnd = readString(periodRecord, 'end');
+  config.periodKind = readString(periodRecord, 'kind');
+  const location: string = readString(session, 'selectedLocationType');
+  if (location.length > 0) {
+    config.locationType = location;
+  }
+  return config;
+}
+
+export function newStatsPeriodRecord(source: Record<string, Object>, key: string): Record<string, Object> {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return {};
+  }
+  return raw as Record<string, Object>;
+}
+
+/**
+ * Durable storage for the stats screen's choices, backed by the platform
+ * preferences store. Recreation of the screen reads everything back through
+ * this repository rather than from anything held in memory.
+ */
+export class NewStatsConfigurationRepository {
+  private store: preferences.Preferences;
+
+  constructor(store: preferences.Preferences) {
+    this.store = store;
+  }
+
+  static async open(context: common.UIAbilityContext): Promise<NewStatsConfigurationRepository> {
+    const store: preferences.Preferences = await preferences.getPreferences(context, NEW_STATS_PREFERENCES_NAME);
+    return new NewStatsConfigurationRepository(store);
+  }
+
+  async clear(): Promise<void> {
+    await this.store.clear();
+    await this.store.flush();
+  }
+
+  async writeConfiguration(config: NewStatsConfiguration): Promise<void> {
+    const encoded: Record<string, Object> = {};
+    encoded['selectedMetric'] = config.selectedMetric;
+    encoded['periodOrigin'] = config.periodOrigin;
+    encoded['periodStart'] = config.periodStart;
+    encoded['periodEnd'] = config.periodEnd;
+    encoded['periodKind'] = config.periodKind;
+    encoded['locationType'] = config.locationType;
+    await this.store.put(KEY_CONFIGURATION, JSON.stringify(encoded));
+  }
+
+  async readConfiguration(): Promise<NewStatsConfiguration> {
+    const raw: preferences.ValueType = await this.store.get(KEY_CONFIGURATION, '');
+    if (typeof raw !== 'string' || (raw as string).length === 0) {
+      return defaultNewStatsConfiguration();
+    }
+    const decoded: Record<string, Object> = JSON.parse(raw as string) as Record<string, Object>;
+    const config: NewStatsConfiguration = defaultNewStatsConfiguration();
+    config.selectedMetric = readString(decoded, 'selectedMetric');
+    config.periodOrigin = readString(decoded, 'periodOrigin');
+    config.periodStart = readString(decoded, 'periodStart');
+    config.periodEnd = readString(decoded, 'periodEnd');
+    config.periodKind = readString(decoded, 'periodKind');
+    config.locationType = readString(decoded, 'locationType');
+    return config;
+  }
+
+  async writeSession(session: Record<string, Object>): Promise<void> {
+    await this.store.put(KEY_SESSION, JSON.stringify(session));
+  }
+
+  async readSession(): Promise<Record<string, Object>> {
+    const raw: preferences.ValueType = await this.store.get(KEY_SESSION, '{}');
+    if (typeof raw !== 'string') {
+      return {};
+    }
+    return JSON.parse(raw as string) as Record<string, Object>;
+  }
+
+  /** Rebuilds a concrete window from a stored origin and window. */
+  async readPeriod(today: string): Promise<NewStatsPeriod> {
+    const config: NewStatsConfiguration = await this.readConfiguration();
+    if (config.periodOrigin.length === 0) {
+      return resolveNewStatsPeriod('last_7_days', today);
+    }
+    if (config.periodStart.length === 0 || config.periodEnd.length === 0) {
+      return resolveNewStatsPeriod(config.periodOrigin, today);
+    }
+    return {
+      kind: config.periodKind.length > 0 ? config.periodKind : 'rolling',
+      type: 'custom',
+      origin: config.periodOrigin,
+      start: config.periodStart,
+      end: config.periodEnd
+    };
+  }
+}
