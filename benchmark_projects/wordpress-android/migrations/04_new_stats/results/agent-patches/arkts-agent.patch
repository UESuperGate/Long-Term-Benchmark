+/**
+ * Publishes the screen state.
+ *
+ * The state container cannot hold a null, so "no bucket selected" is carried
+ * internally as an empty record. On the way out it is rendered as a real null
+ * so consumers can distinguish "nothing selected" from a selection object whose
+ * fields happen to be missing. The substitution is made on the encoded form,
+ * which is the only representation able to express a null.
+ */
+function publishedState(source: Record<string, Object>): Record<string, Object> {
+  const copy: Record<string, Object> = cloneRecord(source);
+  const bar: Record<string, Object> = newStatsReadRecord(copy, 'selectedBar');
+  if (Object.keys(bar).length > 0) {
+    return copy;
+  }
+  const encoded: string = JSON.stringify(copy).replace('"selectedBar":{}', '"selectedBar":null');
+  return JSON.parse(encoded) as Record<string, Object>;
