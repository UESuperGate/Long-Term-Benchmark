+    const refresh: NewStatsRemoteResponse[] = await this.request(NEW_STATS_CHANNEL_REFRESH,
+      NEW_STATS_SURFACE_VIEWS_CHART, true, event, generation);
+    const older: NewStatsRemoteResponse[] = this.olderRequestResponses(generation, event);
+    const ordered: NewStatsRemoteResponse[] = this.orderByCompletion(refresh.concat(older));
