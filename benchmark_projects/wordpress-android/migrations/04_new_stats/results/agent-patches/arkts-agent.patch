diff --git a/entry/src/main/ets/feature/NewStatsDomain.ets b/entry/src/main/ets/feature/NewStatsDomain.ets
new file mode 100644
index 0000000000000000000000000000000000000000..3b606b77ddf6a26868d2afeb0c5f1e1424d2821e
--- /dev/null
+++ b/entry/src/main/ets/feature/NewStatsDomain.ets
@@ -0,0 +1,344 @@
+/**
+ * Domain vocabulary and calendar arithmetic for the New Stats screen.
+ *
+ * This module owns every rule that is true regardless of transport, storage or
+ * UI: which metrics a chart can render for a given period window, how rolling
+ * windows and calendar periods are described, and how paging one period moves
+ * the window while preserving the semantic origin the user picked.
+ */
+
+/** Metrics the stats charts and summary rows can be expressed in. */
+export enum NewStatsMetric {
+  VIEWS = 'views',
+  VISITORS = 'visitors',
+  LIKES = 'likes',
+  COMMENTS = 'comments',
+  POSTS = 'posts'
+}
+
+/**
+ * How a period window derives its concrete dates.
+ *
+ * ROLLING windows move with the clock, CALENDAR periods snap to calendar
+ * boundaries, and CUSTOM windows come from drilling into a single bucket.
+ * The distinction is what stops a paged rolling window from silently turning
+ * into a calendar period when its dates happen to line up.
+ */
+export enum NewStatsPeriodKind {
+  ROLLING = 'rolling',
+  CALENDAR = 'calendar',
+  CUSTOM = 'custom'
+}
+
+/** Origin identifiers the period selector offers. */
+export enum NewStatsPeriodType {
+  TODAY = 'today',
+  YESTERDAY = 'yesterday',
+  LAST_7_DAYS = 'last_7_days',
+  LAST_30_DAYS = 'last_30_days',
+  LAST_90_DAYS = 'last_90_days',
+  THIS_WEEK = 'this_week',
+  THIS_MONTH = 'this_month',
+  THIS_YEAR = 'this_year'
+}
+
+/** Coarse rendering states shared by the chart and the cards around it. */
+export enum NewStatsContentState {
+  LOADING = 'loading',
+  LOADED = 'loaded',
+  EMPTY = 'empty',
+  /** The chosen metric cannot be drawn for the current window. */
+  METRIC_UNAVAILABLE = 'metric_unavailable',
+  ERROR = 'error',
+  PLAN_GATED = 'plan_gated',
+  AUTH_ERROR = 'auth_error'
+}
+
+/** Which grouping the "Visitors by location" card is showing. */
+export enum NewStatsLocationType {
+  COUNTRIES = 'countries',
+  REGIONS = 'regions'
+}
+
+/** A resolved period window together with the origin that produced it. */
+export interface NewStatsPeriod {
+  kind: string;
+  /** Always 'custom' in persisted form; the concrete range is what is stored. */
+  type: string;
+  origin: string;
+  start: string;
+  end: string;
+}
+
+/** One bucket of a chart series. */
+export interface NewStatsBucket {
+  index: number;
+  rawPeriod: string;
+  label: string;
+  isUpcoming: boolean;
+  canDrillDown: boolean;
+  views: number;
+  visitors: number;
+  likes: number;
+  comments: number;
+  posts: number;
+}
+
+const MILLIS_PER_DAY: number = 86400000;
+const ISO_LENGTH: number = 10;
+
+/** Proleptic Gregorian day, kept independent of the device time zone. */
+export class NewStatsDay {
+  year: number;
+  month: number;
+  day: number;
+
+  constructor(year: number, month: number, day: number) {
+    this.year = year;
+    this.month = month;
+    this.day = day;
+  }
+}
+
+function pad2(value: number): string {
+  const text: string = value.toString();
+  return text.length < 2 ? '0' + text : text;
+}
+
+function pad4(value: number): string {
+  const text: string = value.toString();
+  return text.length < 4 ? '0000'.substring(text.length) + text : text;
+}
+
+export function formatNewStatsDay(value: NewStatsDay): string {
+  return pad4(value.year) + '-' + pad2(value.month) + '-' + pad2(value.day);
+}
+
+export function parseNewStatsDay(text: string): NewStatsDay {
+  if (text.length < ISO_LENGTH) {
+    return new NewStatsDay(1970, 1, 1);
+  }
+  const year: number = parseInt(text.substring(0, 4));
+  const month: number = parseInt(text.substring(5, 7));
+  const day: number = parseInt(text.substring(8, 10));
+  return new NewStatsDay(year, month, day);
+}
+
+export function newStatsEpochDay(value: NewStatsDay): number {
+  return Math.floor(Date.UTC(value.year, value.month - 1, value.day) / MILLIS_PER_DAY);
+}
+
+export function newStatsDayFromEpoch(epoch: number): NewStatsDay {
+  const instant: Date = new Date(epoch * MILLIS_PER_DAY);
+  return new NewStatsDay(instant.getUTCFullYear(), instant.getUTCMonth() + 1, instant.getUTCDate());
+}
+
+export function newStatsToday(): string {
+  const now: Date = new Date();
+  return formatNewStatsDay(new NewStatsDay(now.getFullYear(), now.getMonth() + 1, now.getDate()));
+}
+
+export function addNewStatsDays(day: string, delta: number): string {
+  return formatNewStatsDay(newStatsDayFromEpoch(newStatsEpochDay(parseNewStatsDay(day)) + delta));
+}
+
+export function diffNewStatsDays(from: string, to: string): number {
+  return newStatsEpochDay(parseNewStatsDay(to)) - newStatsEpochDay(parseNewStatsDay(from));
+}
+
+/** Monday-based, matching the stats calendar in the WordPress clients. */
+export function startOfNewStatsWeek(day: string): string {
+  const epoch: number = newStatsEpochDay(parseNewStatsDay(day));
+  const weekday: number = ((epoch + 3) % 7 + 7) % 7;
+  return formatNewStatsDay(newStatsDayFromEpoch(epoch - weekday));
+}
+
+export function endOfNewStatsWeek(day: string): string {
+  return addNewStatsDays(startOfNewStatsWeek(day), 6);
+}
+
+export function startOfNewStatsMonth(day: string): string {
+  const value: NewStatsDay = parseNewStatsDay(day);
+  return formatNewStatsDay(new NewStatsDay(value.year, value.month, 1));
+}
+
+export function endOfNewStatsMonth(day: string): string {
+  const value: NewStatsDay = parseNewStatsDay(day);
+  const nextMonth: number = newStatsEpochDay(new NewStatsDay(value.year, value.month + 1, 1));
+  return formatNewStatsDay(newStatsDayFromEpoch(nextMonth - 1));
+}
+
+export function startOfNewStatsYear(day: string): string {
+  const value: NewStatsDay = parseNewStatsDay(day);
+  return formatNewStatsDay(new NewStatsDay(value.year, 1, 1));
+}
+
+export function endOfNewStatsYear(day: string): string {
+  const value: NewStatsDay = parseNewStatsDay(day);
+  return formatNewStatsDay(new NewStatsDay(value.year, 12, 31));
+}
+
+/**
+ * Resolve an origin into a concrete window for a given "today".
+ * The origin name is preserved on the result so paging and restoration can
+ * keep the period's meaning instead of re-deriving it from the dates.
+ */
+export function resolveNewStatsPeriod(origin: string, today: string): NewStatsPeriod {
+  const yesterday: string = addNewStatsDays(today, -1);
+  let kind: string = NewStatsPeriodKind.ROLLING;
+  let start: string = today;
+  let end: string = today;
+
+  if (origin === NewStatsPeriodType.YESTERDAY) {
+    start = yesterday;
+    end = yesterday;
+  } else if (origin === NewStatsPeriodType.LAST_7_DAYS) {
+    start = addNewStatsDays(today, -6);
+    end = today;
+  } else if (origin === NewStatsPeriodType.LAST_30_DAYS) {
+    start = addNewStatsDays(today, -29);
+    end = today;
+  } else if (origin === NewStatsPeriodType.LAST_90_DAYS) {
+    start = addNewStatsDays(today, -89);
+    end = today;
+  } else if (origin === NewStatsPeriodType.THIS_WEEK) {
+    kind = NewStatsPeriodKind.CALENDAR;
+    start = startOfNewStatsWeek(today);
+    end = endOfNewStatsWeek(today);
+  } else if (origin === NewStatsPeriodType.THIS_MONTH) {
+    kind = NewStatsPeriodKind.CALENDAR;
+    start = startOfNewStatsMonth(today);
+    end = endOfNewStatsMonth(today);
+  } else if (origin === NewStatsPeriodType.THIS_YEAR) {
+    kind = NewStatsPeriodKind.CALENDAR;
+    start = startOfNewStatsYear(today);
+    end = endOfNewStatsYear(today);
+  } else if (origin !== NewStatsPeriodType.TODAY) {
+    // An origin this build does not recognise keeps a multi-day rolling
+    // window, so an unexpected value can never quietly reduce the chart to an
+    // hourly series and hide every metric except views.
+    start = addNewStatsDays(today, -6);
+    end = today;
+  }
+  return { kind: kind, type: 'custom', origin: origin, start: start, end: end };
+}
+
+/** A single-day window is drawn as an hourly series. */
+export function isHourlyNewStatsPeriod(period: NewStatsPeriod): boolean {
+  return period.start === period.end;
+}
+
+function shiftNewStatsPeriod(period: NewStatsPeriod, direction: number): NewStatsPeriod {
+  if (period.origin === NewStatsPeriodType.THIS_MONTH) {
+    const value: NewStatsDay = parseNewStatsDay(period.start);
+    // Step off the first of the month and back through the day arithmetic, so
+    // crossing a year boundary normalises instead of producing month 00 or 13.
+    const anchor: string = formatNewStatsDay(
+      newStatsDayFromEpoch(newStatsEpochDay(new NewStatsDay(value.year, value.month, 1)) + direction));
+    return {
+      kind: period.kind,
+      type: 'custom',
+      origin: period.origin,
+      start: startOfNewStatsMonth(anchor),
+      end: endOfNewStatsMonth(anchor)
+    };
+  }
+  if (period.origin === NewStatsPeriodType.THIS_YEAR) {
+    const value: NewStatsDay = parseNewStatsDay(period.start);
+    const anchor: string = formatNewStatsDay(new NewStatsDay(value.year + direction, 1, 1));
+    return {
+      kind: period.kind,
+      type: 'custom',
+      origin: period.origin,
+      start: startOfNewStatsYear(anchor),
+      end: endOfNewStatsYear(anchor)
+    };
+  }
+  const span: number = diffNewStatsDays(period.start, period.end) + 1;
+  return {
+    kind: period.kind,
+    type: 'custom',
+    origin: period.origin,
+    start: addNewStatsDays(period.start, span * direction),
+    end: addNewStatsDays(period.end, span * direction)
+  };
+}
+
+/**
+ * Paging forward must never carry the window past the present edge.
+ *
+ * Landing exactly on today is allowed — that is the window the user is
+ * normally looking at — so only a window that ends after today is refused.
+ */
+function wouldPassPresentEdge(period: NewStatsPeriod, today: string): boolean {
+  return diffNewStatsDays(period.end, today) > 0;
+}
+
+export function canPageNewStatsForward(period: NewStatsPeriod, today: string): boolean {
+  return !wouldPassPresentEdge(shiftNewStatsPeriod(period, 1), today);
+}
+
+export function canPageNewStatsBackward(period: NewStatsPeriod): boolean {
+  return true;
+}
+
+export function pageNewStatsForward(period: NewStatsPeriod, today: string): NewStatsPeriod | undefined {
+  if (!canPageNewStatsForward(period, today)) {
+    return undefined;
+  }
+  return shiftNewStatsPeriod(period, 1);
+}
+
+export function pageNewStatsBackward(period: NewStatsPeriod): NewStatsPeriod {
+  return shiftNewStatsPeriod(period, -1);
+}
+
+export function newStatsPeriodSpanDays(period: NewStatsPeriod): number {
+  return diffNewStatsDays(period.start, period.end) + 1;
+}
+
+const ALL_METRICS: string[] = [
+  NewStatsMetric.VIEWS,
+  NewStatsMetric.VISITORS,
+  NewStatsMetric.LIKES,
+  NewStatsMetric.COMMENTS,
+  NewStatsMetric.POSTS
+];
+
+/**
+ * An hourly series only carries views, so a single-day window cannot draw the
+ * other metrics even though the period itself understands them.
+ *
+ * `hourlyMetrics` lets the caller supply the metrics the hourly endpoint
+ * actually publishes for the site, defaulting to views.
+ */
+export function supportedNewStatsChartMetrics(period: NewStatsPeriod, hourlyMetrics?: string[]): string[] {
+  if (isHourlyNewStatsPeriod(period)) {
+    return hourlyMetrics !== undefined && hourlyMetrics.length > 0 ? hourlyMetrics : [NewStatsMetric.VIEWS];
+  }
+  return ALL_METRICS;
+}
+
+export function supportsNewStatsChartMetric(period: NewStatsPeriod, metric: string, hourlyMetrics?: string[]): boolean {
+  return supportedNewStatsChartMetrics(period, hourlyMetrics).indexOf(metric) >= 0;
+}
+
+/** The summary row keeps working for every metric regardless of chart shape. */
+export function supportedNewStatsSummaryMetrics(): string[] {
+  return ALL_METRICS;
+}
+
+export function isKnownNewStatsMetric(metric: string): boolean {
+  return ALL_METRICS.indexOf(metric) >= 0;
+}
+
+/** The metric a chart falls back to when the preference cannot be drawn. */
+export function fallbackNewStatsMetric(period: NewStatsPeriod, hourlyMetrics?: string[]): string {
+  const supported: string[] = supportedNewStatsChartMetrics(period, hourlyMetrics);
+  return supported.length > 0 ? supported[0] : NewStatsMetric.VIEWS;
+}
+
+export function newStatsMetricValue(source: Record<string, number>, metric: string): number {
+  const value: number | undefined = source[metric];
+  return value === undefined ? 0 : value;
+}
