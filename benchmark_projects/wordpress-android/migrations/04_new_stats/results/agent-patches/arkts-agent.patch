+import {
+  NewStatsContentState,
+  NewStatsMetric,
+  NewStatsPeriod,
+  NewStatsPeriodKind,
+  supportedNewStatsSummaryMetrics
+} from './NewStatsDomain';
+import {
+  newStatsReadArray,
+  newStatsReadBoolean,
+  newStatsReadNumber,
+  newStatsReadRecord,
+  newStatsReadString,
+  newStatsReadStringArray
+} from './NewStatsStore';
+
+/** One bar of the stats chart as the page needs it. */
+export interface NewStatsChartBarView {
+  key: string;
+  index: number;
+  rawPeriod: string;
+  label: string;
+  /** 0..1 share of the tallest bar, used for the bar height. */
+  fill: number;
+  isUpcoming: boolean;
+  isSelected: boolean;
+  isActionable: boolean;
+  value: number;
+}
+
+/** One selectable metric in the chart header. */
+export interface NewStatsMetricChipView {
+  metric: string;
+  isSelected: boolean;
+  isSupported: boolean;
+}
+
+/** One cell of the always-available summary row. */
+export interface NewStatsSummaryCellView {
+  metric: string;
+  value: number;
+}
+
+export interface NewStatsLocationRowView {
+  label: string;
+  value: string;
+}
+
+/**
+ * Everything the page renders, derived from the store's state.
+ *
+ * Deriving it in one place is what keeps the header, the chart, the summary
+ * row and the surrounding cards talking about the same committed period and
+ * the same selected bucket.
+ */
+export interface NewStatsScreenSnapshot {
+  periodLabel: string;
+  rangeLabel: string;
+  metricLabel: string;
+  chartTotal: number;
+  chartTotalLabel: string;
+  chartState: string;
+  showsLoading: boolean;
+  showsUnavailable: boolean;
+  showsError: boolean;
+  showsRetry: boolean;
+  showsCached: boolean;
+  showsRefreshing: boolean;
+  unavailableLabel: string;
+  statusLabel: string;
+  metricChips: NewStatsMetricChipView[];
+  chartBars: NewStatsChartBarView[];
+  summaryRow: NewStatsSummaryCellView[];
+  selectedBucketLabel: string;
+  canPageForward: boolean;
+  canPageBackward: boolean;
+  canDrillDown: boolean;
+  locationType: string;
+  locationRows: NewStatsLocationRowView[];
+  showsPlanGate: boolean;
+  showsAuthError: boolean;
+  planActionLabel: string;
+}
+
+function readPeriod(state: Record<string, Object>): NewStatsPeriod {
+  const raw: Record<string, Object> = newStatsReadRecord(state, 'effectivePeriod');
+  const start: string = newStatsReadString(raw, 'start');
+  const end: string = newStatsReadString(raw, 'end');
+  const origin: string = newStatsReadString(raw, 'origin');
+  const kind: string = newStatsReadString(raw, 'kind');
+  return {
+    kind: kind.length > 0 ? kind : NewStatsPeriodKind.CUSTOM,
+    type: 'custom',
+    origin: origin,
+    start: start,
+    end: end
+  };
+}
+
+function shortDay(day: string): string {
+  return day.length >= 10 ? day.substring(5) : day;
+}
+
+function periodLabel(period: NewStatsPeriod): string {
+  const origin: string = period.origin;
+  return origin.length > 0 ? origin.replace('_', ' ') : 'custom';
+}
+
+function numberLabel(value: number): string {
+  const text: string = value.toString();
+  return text;
+}
+
+function metricTitle(metric: string): string {
+  return metric.length > 0 ? metric.charAt(0).toUpperCase() + metric.substring(1) : metric;
+}
+
+function bucketRecords(state: Record<string, Object>): Object[] {
+  const buckets: Object[] = newStatsReadArray(state, 'chartBuckets');
+  if (buckets.length > 0) {
+    return buckets;
+  }
+  const current: Object[] = newStatsReadArray(state, 'currentPoints');
+  if (current.length > 0) {
+    return current;
+  }
+  return newStatsReadArray(state, 'points');
+}
+
+/**
+ * The summary row reports the same window the chart header is showing, so a
+ * soft-selected bucket is reflected in every surface rather than only in the
+ * chart itself.
+ */
+function summaryValueFor(state: Record<string, Object>, metric: string): number {
+  const records: Object[] = bucketRecords(state);
+  const index: number = newStatsReadNumber(newStatsReadRecord(state, 'selectedBar'), 'index');
+  if (index >= 0 && index < records.length) {
+    return newStatsReadNumber(records[index] as Record<string, Object>, metric);
+  }
+  const totals: Record<string, Object> = newStatsReadRecord(newStatsReadRecord(state, 'loadedPeriodData'), 'totals');
+  return newStatsReadNumber(totals, metric);
+}
+
+export function buildNewStatsScreenSnapshot(state: Record<string, Object>): NewStatsScreenSnapshot {
+  const period: NewStatsPeriod = readPeriod(state);
+  const chartState: string = newStatsReadString(state, 'chartState');
+  const chartMetric: string = newStatsReadString(state, 'chartMetric');
+  const selectedBar: Record<string, Object> = newStatsReadRecord(state, 'selectedBar');
+  const selectedIndex: number = newStatsReadNumber(selectedBar, 'index');
+  const supported: string[] = newStatsReadStringArray(state, 'supportedMetrics');
+  const supportedForSelection: string[] = supported.length > 0 ? supported : [NewStatsMetric.VIEWS];
+
+  const records: Object[] = bucketRecords(state);
+  let peak: number = 0;
+  for (const record of records) {
+    const value: number = newStatsReadNumber(record as Record<string, Object>, chartMetric);
+    if (value > peak) {
+      peak = value;
+    }
+  }
+  const bars: NewStatsChartBarView[] = [];
+  for (const record of records) {
+    const point: Record<string, Object> = record as Record<string, Object>;
+    const index: number = newStatsReadNumber(point, 'index');
+    const upcoming: boolean = newStatsReadBoolean(point, 'isUpcoming');
+    const value: number = newStatsReadNumber(point, chartMetric);
+    bars.push({
+      key: newStatsReadString(point, 'rawPeriod') + '-' + index.toString(),
+      index: index,
+      rawPeriod: newStatsReadString(point, 'rawPeriod'),
+      label: shortDay(newStatsReadString(point, 'rawPeriod')),
+      fill: peak > 0 ? value / peak : 0,
+      isUpcoming: upcoming,
+      isSelected: index === selectedIndex,
+      // Placeholders for buckets that have not happened are never tappable.
+      isActionable: !upcoming && newStatsReadString(point, 'rawPeriod').length > 0,
+      value: value
+    });
+  }
+
+  const chips: NewStatsMetricChipView[] = [];
+  for (const metric of supportedNewStatsSummaryMetrics()) {
+    chips.push({
+      metric: metric,
+      isSelected: metric === chartMetric,
+      isSupported: supportedForSelection.indexOf(metric) >= 0
+    });
+  }
+
+  const summaryRow: NewStatsSummaryCellView[] = [];
+  for (const metric of supportedNewStatsSummaryMetrics()) {
+    summaryRow.push({ metric: metric, value: summaryValueFor(state, metric) });
+  }
+
+  const locationKey: string = newStatsReadString(state, 'selectedLocationType') === 'regions' ? 'regions' : 'countriesState';
+  const location: Record<string, Object> = newStatsReadRecord(state, locationKey);
+  const rows: NewStatsLocationRowView[] = [];
+  const items: string[] = newStatsReadStringArray(location, 'items');
+  for (const item of items) {
+    rows.push({ label: item, value: item });
+  }
+
+  const planGated: boolean = newStatsReadBoolean(location, 'isPlanGated');
+  const authError: boolean = newStatsReadBoolean(location, 'isAuthError');
+  const chartTotal: number = newStatsReadNumber(state, 'chartTotal');
+  const needsRevalidation: boolean = newStatsReadBoolean(state, 'needsRevalidation');
+
+  return {
+    periodLabel: periodLabel(period),
+    rangeLabel: shortDay(period.start) + ' - ' + shortDay(period.end),
+    metricLabel: metricTitle(chartMetric),
+    chartTotal: chartTotal,
+    chartTotalLabel: numberLabel(chartTotal),
+    chartState: chartState,
+    showsLoading: chartState === NewStatsContentState.LOADING || newStatsReadBoolean(state, 'loadingPlaceholderVisible'),
+    showsUnavailable: chartState === NewStatsContentState.METRIC_UNAVAILABLE,
+    showsError: chartState === NewStatsContentState.ERROR,
+    showsRetry: newStatsReadBoolean(state, 'retryAvailable'),
+    showsCached: needsRevalidation && chartState !== NewStatsContentState.LOADING,
+    showsRefreshing: newStatsReadBoolean(state, 'refreshing'),
+    unavailableLabel: 'No ' + metricTitle(newStatsReadString(state, 'unavailableMetric')) +
+      ' data for a single day',
+    statusLabel: chartState,
+    metricChips: chips,
+    chartBars: bars,
+    summaryRow: summaryRow,
+    selectedBucketLabel: newStatsReadString(selectedBar, 'rawPeriod'),
+    canPageForward: newStatsReadBoolean(state, 'canNavigateForward'),
+    canPageBackward: newStatsReadBoolean(state, 'canNavigateBackward'),
+    canDrillDown: newStatsReadBoolean(selectedBar, 'canDrillDown'),
+    locationType: newStatsReadString(state, 'selectedLocationType'),
+    locationRows: rows,
+    showsPlanGate: planGated,
+    showsAuthError: authError,
+    planActionLabel: 'View plans'
+  };
+}
