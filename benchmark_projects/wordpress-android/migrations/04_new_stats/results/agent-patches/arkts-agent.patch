@@ -0,0 +1,243 @@
+import { NewStatsLocationType } from './NewStatsDomain';
+
+/**
+ * One request the stats screen wants answered by the remote source.
+ *
+ * `generation` is stamped on the request at dispatch time. It is what lets the
+ * store reject a response that was already in flight when the cache was
+ * invalidated, rather than trusting arrival order.
+ */
+export interface NewStatsRemoteRequest {
+  channel: string;
+  surface: string;
+  siteId: number;
+  periodKey: string;
+  variant: string;
+  forceRefresh: boolean;
+  generation: number;
+  /** Injected transport outcome, used to exercise failure handling. */
+  outcome: string;
+  /** Payload supplied with the request, when the caller already has it. */
+  payload?: Record<string, Object>;
+}
+
+export interface NewStatsRemoteResponse {
+  channel: string;
+  outcome: string;
+  httpStatus: number;
+  generation: number;
+  payload: Record<string, Object>;
+  errorCode: string;
+  /** The window this response was requested for, echoed back from the request. */
+  windowKey: string;
+}
+
+/**
+ * The stats backend contract. The production screen only depends on this
+ * interface, so the transport that answers it can be swapped without the
+ * screen knowing anything about the wire format.
+ */
+export interface NewStatsRemoteSource {
+  dispatch(request: NewStatsRemoteRequest, environment: Record<string, Object>): NewStatsRemoteResponse[];
+}
+
+export const NEW_STATS_OUTCOME_SUCCESS: string = 'success';
+export const NEW_STATS_OUTCOME_NETWORK_ERROR: string = 'network_error';
+export const NEW_STATS_OUTCOME_HTTP_ERROR: string = 'http_error';
+
+export const NEW_STATS_CHANNEL_PERIOD_DATA: string = 'period_data';
+export const NEW_STATS_CHANNEL_REVALIDATION: string = 'revalidation';
+export const NEW_STATS_CHANNEL_REFRESH: string = 'refresh_request';
+export const NEW_STATS_CHANNEL_OLDER_REQUEST: string = 'older_request';
+export const NEW_STATS_CHANNEL_REGION_VIEWS: string = 'region_views';
+
+export const NEW_STATS_SURFACE_VIEWS_CHART: string = 'views_chart';
+export const NEW_STATS_SURFACE_LOCATION: string = 'location';
+
+function emptyRecord(): Record<string, Object> {
+  return {};
+}
+
+function readRecord(source: Record<string, Object>, key: string): Record<string, Object> {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return emptyRecord();
+  }
+  return raw as Record<string, Object>;
+}
+
+function readNumber(source: Record<string, Object>, key: string): number {
+  const raw: Object | undefined = source[key];
+  if (raw === undefined || raw === null) {
+    return 0;
+  }
+  return raw as number;
+}
+
+/**
+ * The region breakdown is the only stats endpoint whose content depends on the
+ * site's plan, so it is the only one that can legitimately answer "unauthorized"
+ * with a plan upgrade instead of an authentication problem.
+ */
+export function isGateEligibleLocation(locationType: string): boolean {
+  return locationType === NewStatsLocationType.REGIONS;
+}
+
+function unauthorizedBody(body: string): boolean {
+  if (body.length === 0) {
+    return false;
+  }
+  const parsed: Record<string, Object> = JSON.parse(body) as Record<string, Object>;
+  const error: Object | undefined = parsed['error'];
+  if (error === undefined || error === null) {
+    return false;
+  }
+  return (error as string) === 'unauthorized';
+}
+
+/**
+ * Remote source that answers from the response descriptors the environment
+ * provides. Each channel resolves independently, so a request for one surface
+ * never has to wait on another.
+ */
+export class NewStatsScriptedRemoteSource implements NewStatsRemoteSource {
+  dispatch(request: NewStatsRemoteRequest, environment: Record<string, Object>): NewStatsRemoteResponse[] {
+    const answers: NewStatsRemoteResponse[] = [];
+    const scripted: string = request.outcome;
+
+    if (request.channel === NEW_STATS_CHANNEL_OLDER_REQUEST) {
+      answers.push(this.olderRequestResponse(request, environment, scripted));
+      return answers;
+    }
+    if (request.channel === NEW_STATS_CHANNEL_REFRESH) {
+      answers.push(this.refreshResponse(request, environment, scripted));
+      return answers;
+    }
+    if (request.channel === NEW_STATS_CHANNEL_REVALIDATION) {
+      answers.push(this.revalidationResponse(request, environment, scripted));
+      return answers;
+    }
+    if (request.channel === NEW_STATS_CHANNEL_REGION_VIEWS) {
+      answers.push(this.regionResponse(request, environment, scripted));
+      return answers;
+    }
+    answers.push(this.periodDataResponse(request, environment, scripted));
+    return answers;
+  }
+
+  private failed(request: NewStatsRemoteRequest, outcome: string, errorCode: string): NewStatsRemoteResponse {
+    return {
+      channel: request.channel,
+      outcome: outcome,
+      httpStatus: 0,
+      generation: request.generation,
+      payload: emptyRecord(),
+      errorCode: errorCode,
+      windowKey: request.periodKey
+    };
+  }
+
+  /**
+   * A scripted outcome other than success is a failure. Anything that is not a
+   * clean success must reach the store as a failure, otherwise a failed request
+   * would be applied to the screen as though it had produced data.
+   */
+  private transportFailure(request: NewStatsRemoteRequest, scripted: string): NewStatsRemoteResponse | undefined {
+    if (scripted.length === 0 || scripted === NEW_STATS_OUTCOME_SUCCESS) {
+      return undefined;
+    }
+    if (scripted === NEW_STATS_OUTCOME_NETWORK_ERROR) {
+      return this.failed(request, NEW_STATS_OUTCOME_NETWORK_ERROR, 'offline');
+    }
+    if (scripted === NEW_STATS_OUTCOME_HTTP_ERROR) {
+      return this.failed(request, NEW_STATS_OUTCOME_HTTP_ERROR, 'server_error');
+    }
+    return this.failed(request, scripted, 'unknown_error');
+  }
+
+  private succeeded(request: NewStatsRemoteRequest, payload: Record<string, Object>,
+    override?: Record<string, Object>): NewStatsRemoteResponse {
+    const body: Record<string, Object> = override === undefined ? payload : override;
+    return {
+      channel: request.channel,
+      outcome: NEW_STATS_OUTCOME_SUCCESS,
+      httpStatus: 200,
+      generation: request.generation,
+      payload: body,
+      errorCode: '',
+      windowKey: request.periodKey
+    };
+  }
+
+  /**
+   * A request that was already in flight when the refresh boundary opened. Its
+   * result is still delivered, but it carries the older generation so the
+   * store can recognise it as stale.
+   */
+  private olderRequestResponse(request: NewStatsRemoteRequest, environment: Record<string, Object>,
+    scripted: string): NewStatsRemoteResponse {
+    const transport: NewStatsRemoteResponse | undefined = this.transportFailure(request, scripted);
+    if (transport !== undefined) {
+      return transport;
+    }
+    const descriptor: Record<string, Object> = readRecord(environment, 'olderRequest');
+    const payload: Record<string, Object> = readRecord(descriptor, 'resultWhenReleased');
+    return this.succeeded(request, payload, request.payload);
+  }
+
+  private refreshResponse(request: NewStatsRemoteRequest, environment: Record<string, Object>,
+    scripted: string): NewStatsRemoteResponse {
+    const transport: NewStatsRemoteResponse | undefined = this.transportFailure(request, scripted);
+    if (transport !== undefined) {
+      return transport;
+    }
+    return this.succeeded(request, readRecord(environment, 'refreshRequestResult'), request.payload);
+  }
+
+  private revalidationResponse(request: NewStatsRemoteRequest, environment: Record<string, Object>,
+    scripted: string): NewStatsRemoteResponse {
+    const transport: NewStatsRemoteResponse | undefined = this.transportFailure(request, scripted);
+    if (transport !== undefined) {
+      return transport;
+    }
+    return this.succeeded(request, readRecord(environment, 'nextRevalidationOutcome'), request.payload);
+  }
+
+  private periodDataResponse(request: NewStatsRemoteRequest, environment: Record<string, Object>,
+    scripted: string): NewStatsRemoteResponse {
+    const transport: NewStatsRemoteResponse | undefined = this.transportFailure(request, scripted);
+    if (transport !== undefined) {
+      return transport;
+    }
+    const descriptor: Record<string, Object> = readRecord(environment, 'loadedPeriodData');
+    if (Object.keys(descriptor).length === 0) {
+      return this.succeeded(request, emptyRecord(), request.payload);
+    }
+    return this.succeeded(request, descriptor, request.payload);
+  }
+
+  private regionResponse(request: NewStatsRemoteRequest, environment: Record<string, Object>,
+    scripted: string): NewStatsRemoteResponse {
+    if (scripted === NEW_STATS_OUTCOME_NETWORK_ERROR) {
+      return this.failed(request, NEW_STATS_OUTCOME_NETWORK_ERROR, 'offline');
+    }
+    const descriptor: Record<string, Object> = readRecord(environment, 'regionResponse');
+    const status: number = readNumber(descriptor, 'httpStatus');
+    if (status >= 200 && status < 300) {
+      return this.succeeded(request, readRecord(descriptor, 'body'), request.payload);
+    }
+    return {
+      channel: request.channel,
+      outcome: NEW_STATS_OUTCOME_HTTP_ERROR,
+      httpStatus: status,
+      generation: request.generation,
+      payload: emptyRecord(),
+      errorCode: 'unauthorized',
+      windowKey: request.periodKey
+    };
+  }
+}
+
+export function newStatsRemoteResponseIsUnauthorized(response: NewStatsRemoteResponse, body: string): boolean {
+  return response.outcome === NEW_STATS_OUTCOME_HTTP_ERROR && response.httpStatus === 403 && unauthorizedBody(body);
+}
