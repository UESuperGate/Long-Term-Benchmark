new file mode 100644
index 0000000000000000000000000000000000000000..b27391cff6a09fa9fb0bed8a02a44d40e0dc7956
--- /dev/null
+++ b/entry/src/main/ets/feature/NewStatsCache.ets
@@ -0,0 +1,234 @@
+import { NewStatsContentState, NewStatsPeriod } from './NewStatsDomain';
+
+/**
+ * Everything that must match before one cached payload may be reused for
+ * another request. Cache reuse never crosses a site, a date window, a period
+ * or a request-variant boundary, so all five components take part in the key.
+ */
+export interface NewStatsRequestIdentity {
+  surface: string;
+  siteId: number;
+  today: string;
+  period: string;
+  variant: string;
+}
+
+export interface NewStatsCacheEntry {
+  key: string;
+  identity: NewStatsRequestIdentity;
+  payload: Record<string, Object>;
+  storedOn: string;
+  needsRevalidation: boolean;
+}
+
+export function newStatsRequestIdentityKey(identity: NewStatsRequestIdentity): string {
+  return identity.surface + '|' + identity.siteId.toString() + '|' + identity.today + '|' +
+    identity.period + '|' + identity.variant;
+}
+
+export function copyNewStatsRequestIdentity(identity: NewStatsRequestIdentity): NewStatsRequestIdentity {
+  return {
+    surface: identity.surface,
+    siteId: identity.siteId,
+    today: identity.today,
+    period: identity.period,
+    variant: identity.variant
+  };
+}
+
+/**
+ * Per-surface response cache used to make a revisited stats screen show its
+ * previous content immediately while a revalidation runs in the background.
+ */
+export class NewStatsResponseCache {
+  private entries: Map<string, NewStatsCacheEntry> = new Map<string, NewStatsCacheEntry>();
+
+  read(key: string): NewStatsCacheEntry | undefined {
+    return this.entries.get(key);
+  }
+
+  write(key: string, identity: NewStatsRequestIdentity, payload: Record<string, Object>, storedOn: string,
+    needsRevalidation: boolean): NewStatsCacheEntry {
+    const entry: NewStatsCacheEntry = {
+      key: key,
+      identity: copyNewStatsRequestIdentity(identity),
+      payload: payload,
+      storedOn: storedOn,
+      needsRevalidation: needsRevalidation
+    };
+    this.entries.set(key, entry);
+    return entry;
+  }
+
+  /** Adopt an entry that was produced outside this process (restored cache). */
+  adopt(entry: NewStatsCacheEntry): void {
+    this.entries.set(entry.key, entry);
+  }
+
+  invalidate(key: string): void {
+    this.entries.delete(key);
+  }
+
+  invalidateAll(): void {
+    this.entries.clear();
+  }
+
+  size(): number {
+    return this.entries.size;
+  }
+}
+
+/**
+ * Tracks the requests that are currently outstanding so a response that began
+ * before a refresh boundary cannot repopulate state afterwards.
+ *
+ * The generation is bumped synchronously when the cache is invalidated; any
+ * response stamped with an older generation is stale by definition.
+ */
+export interface NewStatsInFlightRequest {
+  channel: string;
+  generation: number;
+}
+
+export class NewStatsRequestLedger {
+  private generation: number;
+  private outstanding: NewStatsInFlightRequest[] = [];
+
+  constructor(initialGeneration: number) {
+    this.generation = initialGeneration;
+  }
+
+  currentGeneration(): number {
+    return this.generation;
+  }
+
+  /**
+   * Opens a new refresh boundary. Returns the generation that responses must
+   * carry to be accepted; everything already in flight is now stale.
+   */
+  invalidate(): number {
+    this.generation += 1;
+    this.outstanding = [];
+    return this.generation;
+  }
+
+  begin(channel: string, generation: number): NewStatsInFlightRequest {
+    const request: NewStatsInFlightRequest = { channel: channel, generation: generation };
+    this.outstanding.push(request);
+    return request;
+  }
+
+  /** A response is acceptable only when it was produced after the last boundary. */
+  isCurrent(generation: number): boolean {
+    return generation === this.generation;
+  }
+
+  finish(channel: string): void {
+    const remaining: NewStatsInFlightRequest[] = [];
+    for (const request of this.outstanding) {
+      if (request.channel !== channel) {
+        remaining.push(request);
+      }
+    }
+    this.outstanding = remaining;
+  }
+
+  outstandingCount(): number {
+    return this.outstanding.length;
+  }
+}
+
+/**
+ * The content state a card surfaces for a given classification. Plan gating is
+ * deliberately distinct from a transient failure: only transient failures use
+ * the ordinary retry affordance.
+ */
+export interface NewStatsSurfaceState {
+  type: string;
+  isPlanGated: boolean;
+  isAuthError: boolean;
+  ordinaryRetryVisible: boolean;
+  planActionDestination: string;
+  items: string[];
+  message: string;
+}
+
+export function loadedNewStatsSurfaceState(items: string[]): NewStatsSurfaceState {
+  return {
+    type: NewStatsContentState.LOADED,
+    isPlanGated: false,
+    isAuthError: false,
+    ordinaryRetryVisible: false,
+    planActionDestination: '',
+    items: items,
+    message: ''
+  };
+}
+
+export function loadingNewStatsSurfaceState(): NewStatsSurfaceState {
+  return {
+    type: NewStatsContentState.LOADING,
+    isPlanGated: false,
+    isAuthError: false,
+    ordinaryRetryVisible: false,
+    planActionDestination: '',
+    items: [],
+    message: ''
+  };
+}
+
+export function emptyNewStatsSurfaceState(): NewStatsSurfaceState {
+  return {
+    type: NewStatsContentState.EMPTY,
+    isPlanGated: false,
+    isAuthError: false,
+    ordinaryRetryVisible: false,
+    planActionDestination: '',
+    items: [],
+    message: ''
+  };
+}
+
+export function planGatedNewStatsSurfaceState(destination: string): NewStatsSurfaceState {
+  return {
+    type: NewStatsContentState.PLAN_GATED,
+    isPlanGated: true,
+    isAuthError: false,
+    ordinaryRetryVisible: false,
+    planActionDestination: destination,
+    items: [],
+    message: ''
+  };
+}
+
+export function authErrorNewStatsSurfaceState(): NewStatsSurfaceState {
+  return {
+    type: NewStatsContentState.AUTH_ERROR,
+    isPlanGated: false,
+    isAuthError: true,
+    ordinaryRetryVisible: true,
+    planActionDestination: '',
+    items: [],
+    message: ''
+  };
+}
+
+export function errorNewStatsSurfaceState(): NewStatsSurfaceState {
+  return {
+    type: NewStatsContentState.ERROR,
+    isPlanGated: false,
+    isAuthError: false,
+    ordinaryRetryVisible: true,
+    planActionDestination: '',
+    items: [],
+    message: ''
+  };
+}
+
+export function isEmptyNewStatsSurfaceState(state: NewStatsSurfaceState): boolean {
+  return state.type === NewStatsContentState.EMPTY;
+}
+
+export function describeNewStatsPeriod(period: NewStatsPeriod): string {
+  return period.origin + ' [' + period.start + ' .. ' + period.end + ']';
+}
