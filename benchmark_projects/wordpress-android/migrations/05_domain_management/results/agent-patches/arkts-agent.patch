--- /dev/null
+++ b/entry/src/main/ets/model/DomainDetailsPolicy.ets
@@ -0,0 +1,116 @@
+/**
+ * Containment rules of the in-app domain details view.
+ *
+ * The details view is only allowed to display the domain management pages of
+ * the matching domain on wordpress.com. Every other destination has to leave
+ * the contained view and is handed over to the external navigation path.
+ */
+
+/** Host that hosts the domain management pages. */
+export const DOMAIN_DETAILS_HOST: string = 'wordpress.com';
+
+/** Path prefix of the domain management pages. */
+export const DOMAIN_DETAILS_PATH_PREFIX: string = '/domains/manage/all/';
+
+/** Section of the domain management pages that the details view may show. */
+export const DOMAIN_DETAILS_SECTION: string = 'edit';
+
+/** Parsed representation of the destination of the details view. */
+export interface DomainDetailsTarget {
+  scheme: string;
+  host: string;
+  path: string;
+  segments: string[];
+}
+
+/** Builds the details destination of a managed domain. */
+export function domainDetailsPath(domain: string): string {
+  return DOMAIN_DETAILS_PATH_PREFIX + domain + '/' + DOMAIN_DETAILS_SECTION + '/contact';
+}
+
+/** Builds the details destination of a managed domain. */
+export function domainDetailsUrl(domain: string): string {
+  return 'https://' + DOMAIN_DETAILS_HOST + domainDetailsPath(domain);
+}
+
+/** Splits a destination into the parts the containment rule needs. */
+export function parseDetailsTarget(url: string): DomainDetailsTarget | undefined {
+  const trimmed = url.trim();
+  if (trimmed.length === 0) {
+    return undefined;
+  }
+  let rest = trimmed;
+  let scheme = 'https';
+  const schemeIndex = rest.indexOf('://');
+  if (schemeIndex >= 0) {
+    scheme = rest.substring(0, schemeIndex).toLowerCase();
+    rest = rest.substring(schemeIndex + 3);
+  }
+  const queryIndex = rest.indexOf('?');
+  if (queryIndex >= 0) {
+    rest = rest.substring(0, queryIndex);
+  }
+  const hashIndex = rest.indexOf('#');
+  if (hashIndex >= 0) {
+    rest = rest.substring(0, hashIndex);
+  }
+  const slashIndex = rest.indexOf('/');
+  const host = (slashIndex >= 0 ? rest.substring(0, slashIndex) : rest).toLowerCase();
+  const path = slashIndex >= 0 ? rest.substring(slashIndex) : '/';
+  const segments: string[] = [];
+  const rawSegments = path.split('/');
+  for (const segment of rawSegments) {
+    if (segment.length > 0) {
+      segments.push(segment.toLowerCase());
+    }
+  }
+  return { scheme: scheme, host: host, path: path, segments: segments };
+}
+
+/**
+ * A destination stays inside the details view only when it is an https page of
+ * wordpress.com that belongs to the managed domain management section.
+ */
+export function isAllowedDetailsUrl(url: string, managedDomain: string): boolean {
+  const target = parseDetailsTarget(url);
+  if (target === undefined) {
+    return false;
+  }
+  if (target.scheme !== 'https' && target.scheme !== 'http') {
+    return false;
+  }
+  if (target.host !== DOMAIN_DETAILS_HOST) {
+    return false;
+  }
+  const domain = managedDomain.trim().toLowerCase();
+  if (domain.length === 0) {
+    return false;
+  }
+  const segments = target.segments;
+  if (segments.length < 5) {
+    return false;
+  }
+  if (segments[0] !== 'domains' || segments[1] !== 'manage' || segments[2] !== 'all') {
+    return false;
+  }
+  if (segments[3] !== domain) {
+    return false;
+  }
+  return segments[4] === DOMAIN_DETAILS_SECTION;
+}
+
+/** Reads the managed domain out of a domain management destination. */
+export function managedDomainFromUrl(url: string): string {
+  const target = parseDetailsTarget(url);
+  if (target === undefined) {
+    return '';
+  }
+  const segments = target.segments;
+  if (segments.length < 4) {
+    return '';
+  }
+  if (segments[0] !== 'domains' || segments[1] !== 'manage' || segments[2] !== 'all') {
+    return '';
+  }
+  return segments[3];
+}
