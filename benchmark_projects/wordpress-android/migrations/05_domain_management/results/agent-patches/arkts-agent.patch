diff --git a/entry/src/main/ets/model/DomainCheckoutResult.ets b/entry/src/main/ets/model/DomainCheckoutResult.ets
new file mode 100644
index 0000000..1d809a9
--- /dev/null
+++ b/entry/src/main/ets/model/DomainCheckoutResult.ets
@@ -0,0 +1,75 @@
+import { DomainCheckoutResult } from '../integration/DomainIntegration';
+import { asBoolean, asRecord, asText } from './DomainValues';
+
+/**
+ * The checkout runs outside of the domain feature and reports back through a
+ * typed result. The parser is the single place that turns whatever the
+ * checkout delivered into a result the domain flow can trust: a result without
+ * a domain is not a result at all and must never be reported as a completion.
+ */
+
+function resultFromRecord(record: Record<string, Object>): DomainCheckoutResult | undefined {
+  const domainName = asText(record['domainName'], asText(record['domain'], asText(record['domain_name']))).trim();
+  if (domainName.length === 0) {
+    return undefined;
+  }
+  const email = asText(record['email'], asText(record['userEmail'])).trim();
+  const canceled = asBoolean(record['canceled'], asBoolean(record['cancelled'], asBoolean(record['isCanceled'])));
+  return { domainName: domainName, email: email, canceled: canceled };
+}
+
+function queryValue(url: string, key: string): string {
+  const queryIndex = url.indexOf('?');
+  if (queryIndex < 0) {
+    return '';
+  }
+  const query = url.substring(queryIndex + 1);
+  const pairs = query.split('&');
+  for (const pair of pairs) {
+    const separator = pair.indexOf('=');
+    if (separator < 0) {
+      continue;
+    }
+    if (pair.substring(0, separator).toLowerCase() === key) {
+      return pair.substring(separator + 1);
+    }
+  }
+  return '';
+}
+
+function resultFromUrl(url: string): DomainCheckoutResult | undefined {
+  const domainName = queryValue(url, 'domain').trim();
+  if (domainName.length === 0) {
+    return undefined;
+  }
+  const email = queryValue(url, 'email').trim();
+  const canceledFlag = queryValue(url, 'canceled').toLowerCase();
+  const canceled = canceledFlag === '1' || canceledFlag === 'true';
+  return { domainName: domainName, email: email, canceled: canceled };
+}
+
+/** Parses the payload returned by the checkout into a typed result. */
+export function parseCheckoutResult(raw: Object | undefined | null): DomainCheckoutResult | undefined {
+  if (raw === undefined || raw === null) {
+    return undefined;
+  }
+  if (typeof raw === 'string') {
+    const payload = (raw as string).trim();
+    if (payload.length === 0) {
+      return undefined;
+    }
+    if (payload.startsWith('{')) {
+      try {
+        return parseCheckoutResult(JSON.parse(payload) as Object);
+      } catch (error) {
+        return undefined;
+      }
+    }
+    return resultFromUrl(payload);
+  }
+  const record = asRecord(raw);
+  if (record === undefined) {
+    return undefined;
+  }
+  return resultFromRecord(record);
+}
