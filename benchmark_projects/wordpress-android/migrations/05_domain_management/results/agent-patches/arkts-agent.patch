+import { DomainProposal, DomainRow } from '../integration/DomainIntegration';
+
+/**
+ * Small helpers used to read the loosely typed payloads that come back from
+ * the remote services. Every accessor is defensive: a missing or unexpected
+ * value never breaks the flow, it only produces an empty default.
+ */
+
+/** True when a payload entry is absent. */
+export function isMissing(value: Object | undefined | null): boolean {
+  return value === undefined || value === null;
+}
+
+/** True when a payload entry carries a value. */
+export function hasEntry(value: Object | undefined | null): boolean {
+  return !isMissing(value);
+}
+
+/** Returns the first entry that carries a value. */
+export function firstDefined(primary: Object | undefined | null, secondary: Object | undefined | null): Object | undefined {
+  if (primary !== undefined && primary !== null) {
+    return primary;
+  }
+  if (secondary !== undefined && secondary !== null) {
+    return secondary;
+  }
+  return undefined;
+}
+
+/** An empty payload that a service can answer with. */
+export function emptyPayload(): Record<string, Object> {
+  return JSON.parse('{}') as Record<string, Object>;
+}
+
+export function asRecord(value: Object | undefined | null): Record<string, Object> | undefined {
+  if (isMissing(value)) {
+    return undefined;
+  }
+  if (typeof value === 'object') {
+    return value as Record<string, Object>;
+  }
+  return undefined;
+}
+
+export function asArray(value: Object | undefined | null): Object[] {
+  if (isMissing(value)) {
+    return [];
+  }
+  if (Array.isArray(value)) {
+    return value as Object[];
+  }
+  return [];
+}
+
+export function asText(value: Object | undefined | null, fallback: string = ''): string {
+  if (isMissing(value)) {
+    return fallback;
+  }
+  if (typeof value === 'string') {
+    const raw = value as string;
+    return raw.length > 0 ? raw : fallback;
+  }
+  if (typeof value === 'number') {
+    return (value as number).toString();
+  }
+  if (typeof value === 'boolean') {
+    return (value as boolean).toString();
+  }
+  return fallback;
+}
+
+export function asNumber(value: Object | undefined | null, fallback: number = 0): number {
+  if (typeof value === 'number') {
+    return value as number;
+  }
+  if (typeof value === 'string') {
+    const raw = value as string;
+    if (raw.length === 0) {
+      return fallback;
+    }
+    const parsedValue = Number(raw);
+    return isNaN(parsedValue) ? fallback : parsedValue;
+  }
+  return fallback;
+}
+
+export function asBoolean(value: Object | undefined | null, fallback: boolean = false): boolean {
+  if (typeof value === 'boolean') {
+    return value as boolean;
+  }
+  if (typeof value === 'string') {
+    const raw = (value as string).toLowerCase();
+    if (raw === 'true' || raw === '1' || raw === 'yes') {
+      return true;
+    }
+    if (raw === 'false' || raw === '0' || raw === 'no') {
+      return false;
+    }
+  }
+  return fallback;
+}
+
+/** Normalizes a user supplied query so that it can be compared safely. */
+export function normalizeQuery(value: string): string {
+  return value.trim().toLowerCase();
+}
+
+export function rowToRecord(row: DomainRow): Record<string, Object> {
+  const record: Record<string, Object> = {
+    'domain': row.domain,
+    'siteSlug': row.siteSlug,
+    'siteTitle': row.siteTitle,
+    'status': row.status,
+    'expiry': row.expiry,
+    'detailsUrl': row.detailsUrl
+  };
+  return record;
+}
+
+export function proposalToRecord(proposal: DomainProposal): Record<string, Object> {
+  const record: Record<string, Object> = {
+    'productId': proposal.productId,
+    'domain': proposal.domain,
+    'price': proposal.price,
+    'salePrice': proposal.salePrice,
+    'supportsPrivacy': proposal.supportsPrivacy,
+    'relevance': proposal.relevance
+  };
+  return record;
+}
+
+export function domainNames(rows: DomainRow[]): string[] {
+  const names: string[] = [];
+  for (const row of rows) {
+    names.push(row.domain);
+  }
+  return names;
+}
