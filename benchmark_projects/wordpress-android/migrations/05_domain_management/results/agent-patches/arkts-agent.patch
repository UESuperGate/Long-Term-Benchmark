@@ -0,0 +1,51 @@
+import { common } from '@kit.AbilityKit';
+import { preferences } from '@kit.ArkData';
+import { DomainEffect, DomainLeaf, DomainSession } from '../integration/DomainIntegration';
+
+/**
+ * Sink that receives the effects of the domain feature.
+ *
+ * The leaf is the boundary of the feature: the store reports what happened and
+ * the host decides what to do with it. The production leaf keeps the last
+ * effects around so that the page can show the current navigation and the
+ * diagnostics of the flow.
+ */
+export class DomainAppLeaf implements DomainLeaf {
+  private effects: DomainEffect[] = [];
+
+  async emit(effect: DomainEffect): Promise<void> {
+    this.effects.push(effect);
+    if (this.effects.length > 64) {
+      this.effects.shift();
+    }
+  }
+
+  /** The effect that was produced last. */
+  latest(): DomainEffect | undefined {
+    if (this.effects.length === 0) {
+      return undefined;
+    }
+    return this.effects[this.effects.length - 1];
+  }
+
+  /** Every effect that was produced so far. */
+  all(): DomainEffect[] {
+    return this.effects.slice();
+  }
+}
+
+/** Reads the credentials of the signed in account. */
+export class DomainSessionStore {
+  private context: common.UIAbilityContext;
+
+  constructor(context: common.UIAbilityContext) {
+    this.context = context;
+  }
+
+  async read(): Promise<DomainSession> {
+    const prefs = await preferences.getPreferences(this.context, 'wordpress_session');
+    const authToken = await prefs.get('authToken', '') as string;
+    const siteId = await prefs.get('siteId', '') as string;
+    return { authToken: authToken, siteId: siteId };
+  }
+}
diff --git a/entry/src/main/ets/service/WordPressComDomainBackend.ets b/entry/src/main/ets/service/WordPressComDomainBackend.ets
new file mode 100644
index 0000000..fe495ef
--- /dev/null
+++ b/entry/src/main/ets/service/WordPressComDomainBackend.ets
@@ -0,0 +1,81 @@
+import { http } from '@kit.NetworkKit';
+import { DomainBackend, DomainSession } from '../integration/DomainIntegration';
+
+/**
+ * WordPress.com implementation of the domain service.
+ *
+ * Every call returns a payload that the store understands:
+ *  - the domain list answers with `type: success` and the owned domains,
+ *  - an account without domains answers with `type: empty`,
+ *  - a failed request answers with `type: error` so that the flow can offer a
+ *    retry instead of showing a broken screen.
+ */
+export class WordPressComDomainBackend implements DomainBackend {
+  private baseUrl: string;
+  private session: DomainSession;
+
+  constructor(session: DomainSession, baseUrl: string = 'https://public-api.wordpress.com') {
+    this.session = session;
+    this.baseUrl = baseUrl;
+  }
+
+  async fetchAllDomains(): Promise<Object> {
+    return await this.request(http.RequestMethod.GET, '/rest/v1.1/domains');
+  }
+
+  async searchForDomains(query: string): Promise<Object> {
+    const path = '/rest/v1.1/domains/suggestions?quantity=20&query=' + encodeURIComponent(query);
+    return await this.request(http.RequestMethod.GET, path);
+  }
+
+  async createCart(mode: string, domain: string, productId?: number, supportsPrivacy?: boolean): Promise<Object> {
+    const body: Record<string, Object> = {
+      'domain': domain,
+      'mode': mode,
+      'product_id': productId === undefined ? 0 : productId,
+      'privacy': supportsPrivacy === undefined ? false : supportsPrivacy
+    };
+    return await this.request(http.RequestMethod.POST, '/rest/v1.1/me/cart', body);
+  }
+
+  private async request(method: http.RequestMethod, path: string, body?: Object): Promise<Object> {
+    const client = http.createHttp();
+    try {
+      const options: http.HttpRequestOptions = {
+        method: method,
+        header: {
+          'Authorization': 'Bearer ' + this.session.authToken,
+          'Content-Type': 'application/json'
+        },
+        expectDataType: http.HttpDataType.STRING,
+        connectTimeout: 15000,
+        readTimeout: 15000
+      };
+      if (body !== undefined) {
+        options.extraData = body;
+      }
+      const response = await client.request(this.baseUrl + path, options);
+      const code = response.responseCode;
+      if (code < 200 || code >= 300) {
+        const failed: Record<string, Object> = { 'type': 'error', 'code': code };
+        return failed;
+      }
+      const payload = response.result;
+      if (typeof payload !== 'string') {
+        const empty: Record<string, Object> = { 'type': 'success', 'domains': [] };
+        return empty;
+      }
+      try {
+        return JSON.parse(payload) as Object;
+      } catch (error) {
+        const empty: Record<string, Object> = { 'type': 'success', 'domains': [] };
+        return empty;
+      }
+    } catch (error) {
+      const failed: Record<string, Object> = { 'type': 'error' };
+      return failed;
+    } finally {
+      client.destroy();
+    }
+  }
+}
