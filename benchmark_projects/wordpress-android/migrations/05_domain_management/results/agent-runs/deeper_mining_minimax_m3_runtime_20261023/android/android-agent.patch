diff --git a/src/main/java/org/wordpress/benchmark/domains/base/DomainSuggestion.java b/src/main/java/org/wordpress/benchmark/domains/base/DomainSuggestion.java
new file mode 100644
index 0000000..763cddb
--- /dev/null
+++ b/src/main/java/org/wordpress/benchmark/domains/base/DomainSuggestion.java
@@ -0,0 +1,149 @@
+package org.wordpress.benchmark.domains.base;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * One paid domain proposal shown by the new-domain search.
+ *
+ * <p>A proposal keeps the product identifier, the domain, the price, the optional sale price and
+ * the privacy capability that the purchase screens need after the proposal is selected. Free
+ * suggestions are not purchasable and never enter the result list.</p>
+ */
+public final class DomainSuggestion {
+
+    public static final int NO_PRODUCT = -1;
+
+    public final int productId;
+    public final String domain;
+    public final String price;
+    public final String salePrice;
+    public final boolean supportsPrivacy;
+    public final boolean free;
+    public final double relevance;
+
+    public DomainSuggestion(int productId, String domain, String price, String salePrice,
+                            boolean supportsPrivacy, boolean free, double relevance) {
+        this.productId = productId;
+        this.domain = Text.orEmpty(domain);
+        this.price = Text.orEmpty(price);
+        this.salePrice = Text.orEmpty(salePrice);
+        this.supportsPrivacy = supportsPrivacy;
+        this.free = free;
+        this.relevance = relevance;
+    }
+
+    /** Reads a proposal from a suggestion payload, or from a plain domain entry. */
+    public static DomainSuggestion fromJson(Object entry, double fallbackRelevance) {
+        if (entry instanceof JSONObject) {
+            JSONObject json = (JSONObject) entry;
+            int productId = (int) Text.firstLong(json, new String[] { "productId", "product_id", "productID", "product" }, DomainSuggestion.NO_PRODUCT);
+            String domain = Text.first(json, new String[] { "domain", "domain_name", "domainName", "name" });
+            String price = Text.first(json, new String[] { "price", "cost", "amount" });
+            String salePrice = Text.first(json, new String[] { "salePrice", "sale_cost", "saleCost", "originalPrice" });
+            boolean privacy = Text.firstBoolean(json, new String[] {
+                    "supportsPrivacy", "supports_privacy", "privacyProtectionIncluded", "privacy_protection_included",
+                    "supportsPrivateDomains", "isPrivate", "supports_private_regions" }, false);
+            boolean priced = json.has("price") || json.has("cost") || json.has("amount");
+            boolean free = Text.firstBoolean(json, new String[] { "free", "is_free", "isFree", "is_free_domain" }, false)
+                    || isFreeType(Text.first(json, new String[] { "type", "product_slug", "kind" }))
+                    // A suggestion without a product and without any price is a paid suggestion the
+                    // backend did not describe further, so only an explicit free price marks it free.
+                    || (productId == NO_PRODUCT && priced && isFreePrice(price) && Text.isBlank(salePrice));
+            // A "rank" is a position rather than a score, so it is not read as relevance here.
+            double relevance = Text.firstDouble(json,
+                    new String[] { "relevance", "score", "weight", "relevanceScore" }, fallbackRelevance);
+            return new DomainSuggestion(productId, domain, price, salePrice, privacy, free, relevance);
+        }
+        return new DomainSuggestion(NO_PRODUCT, Text.orEmpty(String.valueOf(entry)), "", "", false, false, fallbackRelevance);
+    }
+
+    /** Reads the paid proposals of a suggestions response, ordered by descending relevance. */
+    public static List<DomainSuggestion> paidProposals(JSONArray suggestions) {
+        List<DomainSuggestion> paid = new ArrayList<>();
+        if (suggestions == null) {
+            return paid;
+        }
+        for (int index = 0; index < suggestions.length(); index++) {
+            Object entry = suggestions.opt(index);
+            if (entry == null || entry == JSONObject.NULL) {
+                continue;
+            }
+            // The server already returns the most relevant entries first, so a response without an
+            // explicit relevance field keeps that order.
+            double fallbackRelevance = suggestions.length() - index;
+            DomainSuggestion proposal = fromJson(entry, fallbackRelevance);
+            if (proposal.free || Text.isBlank(proposal.domain)) {
+                continue;
+            }
+            paid.add(proposal);
+        }
+        Collections.sort(paid, new Comparator<DomainSuggestion>() {
+            @Override public int compare(DomainSuggestion left, DomainSuggestion right) {
+                int byRelevance = Double.compare(right.relevance, left.relevance);
+                return byRelevance != 0 ? byRelevance : left.domain.compareTo(right.domain);
+            }
+        });
+        return paid;
+    }
+
+    public JSONObject toJson() {
+        JSONObject json = Json.object();
+        Json.put(json, "productId", productId);
+        Text.put(json, "domain", domain);
+        Text.put(json, "price", price);
+        Text.put(json, "salePrice", salePrice);
+        Json.put(json, "supportsPrivacy", supportsPrivacy);
+        Json.put(json, "isFree", free);
+        Json.put(json, "relevance", relevance);
+        return json;
+    }
+
+    public static JSONArray toJsonArray(List<DomainSuggestion> proposals) {
+        JSONArray array = new JSONArray();
+        if (proposals != null) {
+            for (DomainSuggestion proposal : proposals) {
+                array.put(proposal == null ? JSONObject.NULL : proposal.toJson());
+            }
+        }
+        return array;
+    }
+
+    /**
+     * Finds the proposal a search result tap refers to. The match is exact: a row in the results
+     * identifies exactly one proposal, and selecting a near match would attach the wrong product.
+     */
+    public static DomainSuggestion findByDomain(List<DomainSuggestion> proposals, String domain) {
+        String needle = Text.normalizeQuery(domain);
+        if (needle.isEmpty() || proposals == null) {
+            return null;
+        }
+        for (DomainSuggestion proposal : proposals) {
+            if (proposal != null && Text.normalizeQuery(proposal.domain).equals(needle)) {
+                return proposal;
+            }
+        }
+        return null;
+    }
+
+    private static boolean isFreeType(String type) {
+        String value = Text.orEmpty(type).toLowerCase(java.util.Locale.ROOT);
+        return value.equals("free") || value.equals("free_domain") || value.equals("free_subdomain")
+                || value.equals("subdomain") || value.equals("wpcom_subdomain");
+    }
+
+    private static boolean isFreePrice(String price) {
+        String value = Text.orEmpty(price).trim().toLowerCase(java.util.Locale.ROOT);
+        return value.isEmpty() || value.equals("0") || value.equals("0.00") || value.equals("free")
+                || value.equals("$0") || value.equals("$0.00");
+    }
+
+    @Override public String toString() {
+        return toJson().toString();
+    }
+}
