--- /dev/null
+++ b/src/main/java/org/wordpress/benchmark/domains/base/MainThreadDomainScheduler.java
@@ -0,0 +1,90 @@
+package org.wordpress.benchmark.domains.base;
+
+import android.os.Handler;
+import android.os.Looper;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ThreadFactory;
+
+/**
+ * Production scheduler: state is delivered on the main looper and backend work runs on a single
+ * worker thread so that a slow list/search/cart request never blocks the pages.
+ */
+public final class MainThreadDomainScheduler implements DomainScheduler {
+
+    private final Handler handler;
+    private final ExecutorService worker;
+    private volatile boolean released;
+
+    public MainThreadDomainScheduler() {
+        this(new Handler(Looper.getMainLooper()));
+    }
+
+    public MainThreadDomainScheduler(Handler handler) {
+        this.handler = handler;
+        this.worker = Executors.newSingleThreadExecutor(new ThreadFactory() {
+            @Override public Thread newThread(Runnable runnable) {
+                Thread thread = new Thread(runnable, "domain-backend");
+                thread.setDaemon(true);
+                return thread;
+            }
+        });
+    }
+
+    @Override public long nowMillis() {
+        return System.currentTimeMillis();
+    }
+
+    @Override public void post(Runnable task) {
+        if (released || task == null) {
+            return;
+        }
+        if (Looper.myLooper() == handler.getLooper()) {
+            task.run();
+        } else {
+            handler.post(task);
+        }
+    }
+
+    @Override public Handle postDelayed(final Runnable task, long delayMillis) {
+        if (released || task == null) {
+            return CancelledHandle.INSTANCE;
+        }
+        handler.postDelayed(task, Math.max(0L, delayMillis));
+        return new Handle() {
+            @Override public void cancel() {
+                handler.removeCallbacks(task);
+            }
+        };
+    }
+
+    @Override public void executeOnWorker(Runnable task) {
+        if (released || task == null) {
+            return;
+        }
+        worker.execute(new Runnable() {
+            @Override public void run() {
+                task.run();
+            }
+        });
+    }
+
+    /** Releases the worker thread once the owning screen is gone. */
+    public void release() {
+        released = true;
+        handler.removeCallbacksAndMessages(null);
+        worker.shutdownNow();
+    }
+
+    @Override public void cancelPendingTasks() {
+        released = true;
+        handler.removeCallbacksAndMessages(null);
+    }
+
+    private enum CancelledHandle implements Handle {
+        INSTANCE;
+
+        @Override public void cancel() { }
+    }
+}
