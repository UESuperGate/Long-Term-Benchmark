+    private void onSearchQueryChanged(String rawQuery, Long typedAtMillis) {
+        String normalized = Text.normalizeQuery(rawQuery);
+        if (Text.isBlank(normalized)) {
+            onBlankSearchQuery();
+            return;
+        }
+        if (typedAtMillis != null) {
+            useControlledClock(typedAtMillis);
+            advanceControlledClockTo(typedAtMillis);
+        }
+        searchQuery = normalized;
+        searchError = "";
+        queryGeneration++;
+        cancelPendingDispatch();
+        proposals.clear();
+        setSearchState(SEARCH_DEBOUNCING);
+        final String query = normalized;
+        pendingQuery = query;
+        pendingDueAt = scheduler.nowMillis() + SEARCH_DEBOUNCE_MS;
+        pendingDispatch = scheduler.postDelayed(new Runnable() {
+            @Override public void run() {
+                dispatchSearch(query);
+            }
+        }, SEARCH_DEBOUNCE_MS);
+        emit("searchQueryChanged",
+                "query", query,
+                "normalizedQuery", query,
+                "debounceMs", SEARCH_DEBOUNCE_MS,
+                "dueAt", pendingDueAt);
+        notifyObservers();
+    }
