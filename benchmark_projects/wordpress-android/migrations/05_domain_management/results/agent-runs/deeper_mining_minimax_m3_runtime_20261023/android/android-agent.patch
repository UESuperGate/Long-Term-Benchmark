@@ -0,0 +1,33 @@
+package org.wordpress.benchmark.domains.base;
+
+/**
+ * Time and thread boundary used by the domain pages.
+ *
+ * <p>The production app delivers state on the main thread (so the list, the search field and the
+ * purchase progress are updated from the UI thread) and performs backend work on a worker thread.
+ * Tests and controlled-clock drivers replace this boundary with
+ * {@link ControlledDomainScheduler} so that debouncing and stale response handling can be
+ * observed deterministically.</p>
+ */
+public interface DomainScheduler {
+
+    /** Handle for a scheduled task so that a pending debounce can be cancelled. */
+    interface Handle {
+        void cancel();
+    }
+
+    /** Current value of the scheduler clock, in milliseconds. */
+    long nowMillis();
+
+    /** Delivers a task to the page (main) thread. */
+    void post(Runnable task);
+
+    /** Delivers a task to the page (main) thread once the given delay has elapsed. */
+    Handle postDelayed(Runnable task, long delayMillis);
+
+    /** Runs backend work off the page thread. */
+    void executeOnWorker(Runnable task);
+
+    /** Drops the delayed tasks that have not run yet. */
+    void cancelPendingTasks();
+}
