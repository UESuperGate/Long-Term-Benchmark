+package org.wordpress.benchmark.domains.base;
+
+import android.content.Context;
+
+/**
+ * Process wide holder of the domain flow.
+ *
+ * <p>The pages share one {@link DomainPageOwner} so that a selected proposal, the created cart and
+ * the typed checkout result survive the activity transitions between the list, the search, the
+ * purchase modes and the checkout.</p>
+ */
+public final class DomainSession {
+
+    private static volatile DomainSession instance;
+
+    private final Context context;
+    private final MainThreadDomainScheduler scheduler;
+    private final DomainBackend backend;
+    private final DomainPageOwner owner;
+
+    private DomainSession(Context context) {
+        this.context = context.getApplicationContext();
+        this.scheduler = new MainThreadDomainScheduler();
+        this.backend = new DomainBackend("");
+        this.owner = new DomainPageOwner();
+        this.owner.configure(backend, DomainRouter.get(), scheduler);
+    }
+
+    public static DomainSession get(Context context) {
+        if (instance == null) {
+            synchronized (DomainSession.class) {
+                if (instance == null) {
+                    instance = new DomainSession(context);
+                }
+            }
+        }
+        return instance;
+    }
+
+    public Context context() {
+        return context;
+    }
+
+    public DomainPageOwner owner() {
+        return owner;
+    }
+
+    public DomainPageOwner.Backend backend() {
+        return backend;
+    }
+
+    public MainThreadDomainScheduler scheduler() {
+        return scheduler;
+    }
+
+    /** Releases the flow, for example when the account is signed out. */
+    public static void reset() {
+        synchronized (DomainSession.class) {
+            if (instance != null) {
+                instance.owner.removeAllObservers();
+                instance.scheduler.release();
+            }
+            instance = null;
+        }
+    }
+}
