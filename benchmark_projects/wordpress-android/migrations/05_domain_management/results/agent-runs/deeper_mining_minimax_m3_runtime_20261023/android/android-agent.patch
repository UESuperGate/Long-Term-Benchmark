+            emit("staleListResponseIgnored", "requestIndex", requestId);
+            return;
+        }
+        listRequestLog.add(describeListResponse(response));
+        trim(listRequestLog);
+        if (isErrorResponse(response)) {
+            applyListError(Text.isBlank(errorMessage(response))
+                    ? "the account domains could not be loaded" : errorMessage(response));
+            return;
+        }
+        JSONArray domains = domainsOf(response);
+        if (domains == null) {
+            if (isExplicitlyEmpty(response)) {
+                replaceAccountDomains(Json.array());
+                setListState(LIST_EMPTY);
+                filterAccountDomains(filterQuery);
+                notifyObservers();
+                return;
+            }
+            applyListError("the account domains response could not be read");
