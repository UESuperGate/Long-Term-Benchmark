+        super.onPause();
+    }
+
+    @Override protected void onDestroy() {
+        owner.removeObserver(this);
+        super.onDestroy();
+    }
+
+    @Override public void onDomainStateChanged() {
+        runOnUiThread(new Runnable() {
+            @Override public void run() {
+                render();
+            }
+        });
+    }
+
+    public void render() {
+        if (contentView == null) {
+            return;
+        }
+        JSONObject state = owner.snapshot();
+        JSONObject proposal = state.optJSONObject("selectedProposal");
+        if (proposal == null) {
+            statusView.setText("No domain was selected.");
+            return;
+        }
+        String cartState = state.optString("cartState", "idle");
+        progressView.setVisibility("submitting".equals(cartState) ? View.VISIBLE : View.INVISIBLE);
+        statusView.setText(statusText(state, cartState));
+        contentView.removeAllViews();
+        contentView.addView(buildProposal(proposal));
+        if (!state.optString("purchaseMode", "").isEmpty()) {
+            contentView.addView(buildSelectedMode(state));
+        }
+        if ("error".equals(cartState)) {
+            contentView.addView(buildCartError(state));
+        } else if (!Text.isBlank(state.optString("checkoutError", ""))) {
+            contentView.addView(buildCheckoutError(state));
+        } else if (!"completed".equals(cartState)) {
+            contentView.addView(buildModeActions(state));
+        } else if (state.optBoolean("planRequired", false)) {
+            // Adding the domain to a site continues through the plan the site is eligible for.
+            contentView.addView(buildPlanAction(state));
+        } else {
+            contentView.addView(buildContinueAction());
+        }
+        contentView.addView(buildBackAction());
+    }
+
+    private View buildScreen() {
+        LinearLayout screen = new LinearLayout(this);
+        screen.setOrientation(LinearLayout.VERTICAL);
+        screen.setPadding(32, 32, 32, 32);
+
+        TextView title = new TextView(this);
+        title.setText("Choose how to use your domain");
+        title.setTextSize(22);
+        screen.addView(title);
+
+        progressView = new ProgressBar(this);
+        progressView.setIndeterminate(true);
+        screen.addView(progressView);
+
+        statusView = new TextView(this);
+        statusView.setPadding(0, 16, 0, 16);
+        screen.addView(statusView);
+
+        contentView = new LinearLayout(this);
+        contentView.setOrientation(LinearLayout.VERTICAL);
+        screen.addView(contentView, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+        return screen;
+    }
+
+    private View buildProposal(JSONObject proposal) {
+        LinearLayout block = new LinearLayout(this);
+        block.setOrientation(LinearLayout.VERTICAL);
+        block.setPadding(0, 16, 0, 16);
+        TextView domain = new TextView(this);
+        domain.setText(proposal.optString("domain", ""));
+        domain.setTextSize(20);
+        block.addView(domain);
+        String price = proposal.optString("price", "");
+        String salePrice = proposal.optString("salePrice", "");
+        TextView priceView = new TextView(this);
+        priceView.setText(Text.isBlank(salePrice) ? price : salePrice + " (was " + price + ")");
+        block.addView(priceView);
+        TextView privacy = new TextView(this);
+        privacy.setText(proposal.optBoolean("supportsPrivacy", false)
+                ? "Privacy protection included" : "No privacy protection");
+        block.addView(privacy);
+        return block;
+    }
+
+    private View buildModeActions(JSONObject state) {
+        LinearLayout actions = new LinearLayout(this);
+        actions.setOrientation(LinearLayout.VERTICAL);
+        actions.setPadding(0, 16, 0, 16);
+
+        Button domainOnly = new Button(this);
+        domainOnly.setText("Buy this domain only");
+        domainOnly.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                owner.selectPurchaseMode(DomainPageOwner.MODE_NEW_DOMAIN_ONLY, Json.object());
+            }
+        });
+        actions.addView(domainOnly);
+
+        JSONArray sites = owner.sites();
+        TextView siteTitle = new TextView(this);
+        siteTitle.setText("Or add it to an existing site");
+        siteTitle.setPadding(0, 24, 0, 8);
+        actions.addView(siteTitle);
+        if (sites.length() == 0) {
+            TextView empty = new TextView(this);
+            empty.setText("No existing site is available.");
+            actions.addView(empty);
+        }
+        for (int index = 0; index < sites.length(); index++) {
+            JSONObject site = sites.optJSONObject(index);
+            if (site == null) {
+                continue;
+            }
+            actions.addView(buildSiteButton(site));
+        }
+        return actions;
+    }
+
+    private View buildSiteButton(final JSONObject site) {
+        String slug = site.optString("siteSlug", site.optString("blogName", site.optString("name", "")));
+        String name = site.optString("blogName", site.optString("name", slug));
+        Button button = new Button(this);
+        button.setText(name);
+        button.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                JSONObject payload = Json.object();
+                Json.put(payload, "site", slug);
+                Json.put(payload, "siteSlug", slug);
+                owner.selectPurchaseMode(DomainPageOwner.MODE_EXISTING_SITE, payload);
+            }
+        });
+        return button;
+    }
+
+    private View buildSelectedMode(JSONObject state) {
+        TextView mode = new TextView(this);
+        String purchaseMode = state.optString("purchaseMode", "");
+        String site = state.optString("existingSite", "");
+        mode.setText(DomainPageOwner.MODE_EXISTING_SITE.equals(purchaseMode)
+                ? "Adding the domain to " + site : "Buying the domain on its own");
+        return mode;
+    }
+
+    private View buildCartError(JSONObject state) {
+        LinearLayout error = new LinearLayout(this);
+        error.setOrientation(LinearLayout.VERTICAL);
+        error.setPadding(0, 24, 0, 24);
+        TextView message = new TextView(this);
+        String reason = state.optString("cartError", "");
+        message.setText(Text.isBlank(reason) ? "The domain could not be added to the cart." : reason);
+        error.addView(message);
+        Button retry = new Button(this);
+        retry.setText("Try again");
+        retry.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                owner.acknowledgeCartError();
+                owner.submitCart();
+            }
+        });
+        error.addView(retry);
+        return error;
+    }
+
+    private View buildCheckoutError(JSONObject state) {
+        LinearLayout error = new LinearLayout(this);
+        error.setOrientation(LinearLayout.VERTICAL);
+        error.setPadding(0, 24, 0, 24);
+        TextView message = new TextView(this);
+        message.setText(state.optString("checkoutError", "The checkout did not finish."));
+        message.setTextSize(15);
+        error.addView(message);
+        Button retry = new Button(this);
+        retry.setText("Back to checkout");
+        retry.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                owner.retryCheckout();
+            }
+        });
+        error.addView(retry);
+        return error;
+    }
+
+    private View buildPlanAction(final JSONObject state) {
+        String site = state.optString("existingSite", "");
+        Button choosePlan = new Button(this);
+        choosePlan.setText(Text.isBlank(site)
+                ? "Choose a plan to add your domain" : "Choose a plan for " + site);
+        choosePlan.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                showMessage("Choose the plan that covers your domain at " + state.optString("checkoutDomain", ""));
+            }
+        });
+        return choosePlan;
+    }
+
+    private View buildContinueAction() {
+        Button continueToCheckout = new Button(this);
+        continueToCheckout.setText("Continue to checkout");
+        continueToCheckout.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                owner.openCheckout();
+            }
+        });
+        return continueToCheckout;
+    }
+
+    private View buildBackAction() {
+        Button back = new Button(this);
+        back.setText("Back to domain search");
+        back.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                finish();
+            }
+        });
+        return back;
+    }
+
+    private String statusText(JSONObject state, String cartState) {
+        String mode = state.optString("purchaseMode", "");
+        boolean existingSite = DomainPageOwner.MODE_EXISTING_SITE.equals(mode);
+        if ("submitting".equals(cartState)) {
+            return existingSite ? "Adding the domain to your site…" : "Adding the domain to your cart…";
+        }
+        if ("error".equals(cartState)) {
+            return "The domain could not be added to the cart";
+        }
+        if ("completed".equals(cartState)) {
+            return state.optBoolean("planRequired", false)
+                    ? "Choose a plan to finish adding the domain" : "Continue to the checkout";
+        }
+        String checkoutError = state.optString("checkoutError", "");
+        if (!checkoutError.isEmpty()) {
+            return checkoutError;
+        }
+        return "Pick how you want to use " + state.optString("checkoutDomain", "the domain");
+    }
+
+    // ---------------------------------------------------------------- effect handling
+
+    @Override public void openDomainSearch() {
+        startActivity(new Intent(this, DomainSearchActivity.class));
+    }
+
+    @Override public void openDomainPurchase() {
+        // Already on the purchase screen.
+    }
+
+    @Override public void openCheckout(String checkoutToken, String checkoutUrl) {
+        Intent checkout = new Intent(this, DomainCheckoutActivity.class);
+        checkout.putExtra(DomainCheckoutActivity.EXTRA_CHECKOUT_TOKEN, checkoutToken);
+        checkout.putExtra(DomainCheckoutActivity.EXTRA_CHECKOUT_URL, checkoutUrl);
+        checkout.putExtra(DomainCheckoutActivity.EXTRA_DOMAIN, owner.checkoutDomain());
+        checkout.putExtra(DomainCheckoutActivity.EXTRA_EMAIL, owner.checkoutEmail());
+        checkoutResultPending = true;
+        startActivityForResult(checkout, REQUEST_CHECKOUT);
+    }
+
+    @Override public void openPlans(String site, String domain) {
+        showMessage("Adding " + domain + " to " + site + " needs one of the eligible plans");
+    }
+
+    @Override public void openDomainDetails(String domain, String url) {
+        showMessage("Domain details for " + domain);
+    }
+
+    @Override public void openExternalUrl(String url) {
+        showMessage("Opened " + url + " outside the app");
+    }
+
+    @Override public void closeTransientScreens() {
+        finish();
+    }
+
+    @Override public void showMessage(String message) {
+        if (!Text.isBlank(message)) {
+            Toast.makeText(this, message, Toast.LENGTH_LONG).show();
+        }
+    }
+
+    @Override protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode == REQUEST_CHECKOUT) {
+            checkoutResultPending = false;
+            // The typed result contract of the checkout screen.
+            owner.onCheckoutResult(data, resultCode);
+        }
+    }
+}
