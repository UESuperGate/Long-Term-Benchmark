@@ -0,0 +1,115 @@
+package org.wordpress.benchmark.domains.base;
+
+import org.json.JSONObject;
+
+/**
+ * Turns the effects published by {@link DomainPageOwner} into screen actions.
+ *
+ * <p>The owner never knows about activities: it publishes effects, and whichever screen is in the
+ * foreground acts on them through {@link Delegate}.</p>
+ */
+public final class DomainRouter implements DomainPageOwner.EffectSink {
+
+    /** The screen actions the domain flow needs. */
+    public interface Delegate {
+        void openDomainSearch();
+
+        void openDomainPurchase();
+
+        void openCheckout(String checkoutToken, String checkoutUrl);
+
+        void openPlans(String site, String domain);
+
+        void openDomainDetails(String domain, String url);
+
+        void openExternalUrl(String url);
+
+        void closeTransientScreens();
+
+        void showMessage(String message);
+    }
+
+    private static volatile DomainRouter instance;
+
+    private volatile Delegate delegate;
+
+    private DomainRouter() { }
+
+    public static DomainRouter get() {
+        if (instance == null) {
+            synchronized (DomainRouter.class) {
+                if (instance == null) {
+                    instance = new DomainRouter();
+                }
+            }
+        }
+        return instance;
+    }
+
+    /** Registers the screen that currently owns the flow. */
+    public void setDelegate(Delegate delegate) {
+        this.delegate = delegate;
+    }
+
+    /** Removes a screen when it goes away, keeping another registered screen in place. */
+    public void clearDelegate(Delegate delegate) {
+        if (this.delegate == delegate) {
+            this.delegate = null;
+        }
+    }
+
+    public Delegate delegate() {
+        return delegate;
+    }
+
+    @Override public void emit(JSONObject effect) {
+        Delegate target = delegate;
+        if (effect == null || target == null) {
+            return;
+        }
+        String name = effect.optString("name", "");
+        if ("navigate".equals(name)) {
+            String destination = effect.optString("destination", "");
+            if (DomainPageOwner.DESTINATION_DOMAIN_SEARCH.equals(destination)) {
+                target.openDomainSearch();
+            } else if (DomainPageOwner.DESTINATION_DOMAIN_PURCHASE.equals(destination)) {
+                target.openDomainPurchase();
+            } else if (DomainPageOwner.DESTINATION_CHECKOUT.equals(destination)) {
+                target.openCheckout(effect.optString("checkoutToken", ""), effect.optString("checkoutUrl", ""));
+            } else if (DomainPageOwner.DESTINATION_PLANS.equals(destination)) {
+                target.openPlans(effect.optString("site", ""), effect.optString("domain", ""));
+            } else if (DomainPageOwner.DESTINATION_DOMAIN_DETAILS.equals(destination)) {
+                target.openDomainDetails(effect.optString("domain", ""), effect.optString("url", ""));
+            } else if (DomainPageOwner.DESTINATION_ALL_DOMAINS.equals(destination)) {
+                target.closeTransientScreens();
+            }
+            return;
+        }
+        if ("openExternalUrl".equals(name)) {
+            target.openExternalUrl(effect.optString("url", ""));
+            return;
+        }
+        if ("openDomainDetails".equals(name)) {
+            target.openDomainDetails(effect.optString("domain", ""), effect.optString("url", ""));
+            return;
+        }
+        String message = effect.optString("message", "");
+        if (Text.isBlank(message)) {
+            message = effect.optString("error", "");
+        }
+        if ("allDomainsLoadFailed".equals(name) || "cartFailed".equals(name) || "searchFailed".equals(name)
+                || "checkoutResultInvalid".equals(name)) {
+            if (!Text.isBlank(message)) {
+                target.showMessage(message);
+            }
+            return;
+        }
+        if ("checkoutCompleted".equals(name)) {
+            target.showMessage(effect.optString("domain", "") + " is now registered");
+            return;
+        }
+        if ("checkoutCancelled".equals(name)) {
+            target.showMessage("the checkout was cancelled");
+        }
+    }
+}
