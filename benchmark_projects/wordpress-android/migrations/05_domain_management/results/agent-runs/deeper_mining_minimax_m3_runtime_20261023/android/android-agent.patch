@@ -0,0 +1,116 @@
+package org.wordpress.benchmark.domains.base;
+
+import java.net.URI;
+import java.net.URLEncoder;
+import java.util.Locale;
+
+/**
+ * Containment policy for the in-app domain details web view.
+ *
+ * <p>The details screen may keep only {@code wordpress.com/domains/manage/all/<domain>/edit/...}
+ * for the managed domain. Any other host, another domain, or another path inside the account area
+ * is rejected and handed to the external navigation path so that the authenticated web view never
+ * ends up on an unsupported page.</p>
+ */
+public final class DomainUrlPolicy {
+
+    public static final String CONTAINED_HOST = "wordpress.com";
+    public static final String ALL_DOMAINS_PATH_PREFIX = "/domains/manage/all/";
+    public static final String DETAILS_SUB_PATH = "edit";
+    public static final String DEFAULT_DETAILS_SUB_PATH = "contact";
+
+    /** The details destination used by the "All Domains" rows. */
+    public static String containedDetailsUrl(String domain) {
+        return "https://" + CONTAINED_HOST + ALL_DOMAINS_PATH_PREFIX + pathSegment(domain)
+                + "/" + DETAILS_SUB_PATH + "/" + DEFAULT_DETAILS_SUB_PATH;
+    }
+
+    /** True when the web view is allowed to keep the destination for the managed domain. */
+    public boolean isContained(String url, String managedDomain) {
+        String domain = managedDomainOf(url);
+        if (domain.isEmpty() || Text.isBlank(managedDomain) || !domain.equalsIgnoreCase(managedDomain)) {
+            return false;
+        }
+        URI uri = parse(url);
+        return uri != null;
+    }
+
+    /**
+     * Reads the managed domain out of a destination, but only for a page the details web view is
+     * allowed to show at all. Any other host, scheme or path yields an empty string, so an
+     * unsupported destination can never become the domain the screen is bound to.
+     */
+    public String managedDomainOf(String url) {
+        if (Text.isBlank(url)) {
+            return "";
+        }
+        URI uri = parse(url);
+        if (uri == null) {
+            return "";
+        }
+        if (!"https".equals(Text.orEmpty(uri.getScheme()).toLowerCase(Locale.ROOT))) {
+            return "";
+        }
+        if (!CONTAINED_HOST.equals(Text.orEmpty(uri.getHost()).toLowerCase(Locale.ROOT))) {
+            return "";
+        }
+        String path = Text.orEmpty(uri.getPath());
+        if (!path.startsWith(ALL_DOMAINS_PATH_PREFIX)) {
+            return "";
+        }
+        String[] segments = path.substring(ALL_DOMAINS_PATH_PREFIX.length()).split("/");
+        // /domains/manage/all/<domain>/edit[/<page>]
+        if (segments.length < 2 || segments.length > 3) {
+            return "";
+        }
+        for (String segment : segments) {
+            if (segment.isEmpty() || ".".equals(segment) || "..".equals(segment)) {
+                return "";
+            }
+        }
+        if (!DETAILS_SUB_PATH.equals(segments[1])) {
+            return "";
+        }
+        return segments[0];
+    }
+
+    private static String pathSegment(String domain) {
+        return Text.orEmpty(domain).trim().replace("/", "%2F");
+    }
+
+    private static URI parse(String url) {
+        try {
+            URI uri = new URI(Text.orEmpty(url).trim());
+            if (uri.getHost() != null) {
+                // A port would move the destination off the supported origin.
+                return uri.getPort() == -1 || uri.getPort() == 443 ? uri : null;
+            }
+            if (uri.getAuthority() != null) {
+                // A URL without a scheme, for example "wordpress.com/domains/...", is read as https.
+                String authority = uri.getAuthority();
+                int userInfo = authority.lastIndexOf('@');
+                if (userInfo >= 0) {
+                    authority = authority.substring(userInfo + 1);
+                }
+                int port = authority.lastIndexOf(':');
+                if (port > 0 && authority.indexOf(']') < port) {
+                    authority = authority.substring(0, port);
+                }
+                URI rebuilt = new URI("https://" + authority + Text.orEmpty(uri.getPath()));
+                return rebuilt.getPort() == -1 || rebuilt.getPort() == 443 ? rebuilt : null;
+            }
+            return null;
+        } catch (Exception error) {
+            return null;
+        }
+    }
+
+    /** Percent-encodes a query so it can be appended to a suggestions request. */
+    public static String encodeQuery(String query) {
+        try {
+            return URLEncoder.encode(Text.orEmpty(query), "UTF-8");
+        } catch (Exception error) {
+            return Text.orEmpty(query);
+        }
+    }
+}
