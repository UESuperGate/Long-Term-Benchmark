+package org.wordpress.benchmark.domains.base;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.view.View;
+import android.view.ViewGroup;
+import android.webkit.WebView;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * The checkout screen of a domain purchase.
+ *
+ * <p>It shows the checkout page of the created cart and returns a typed
+ * {@link DomainCheckoutResult}: a completed registration or a cancellation. Both outcomes return to
+ * the all-domains screen through the owning purchase flow.</p>
+ */
+public final class DomainCheckoutActivity extends Activity {
+
+    public static final String EXTRA_CHECKOUT_TOKEN = "checkoutToken";
+    public static final String EXTRA_CHECKOUT_URL = "checkoutUrl";
+    public static final String EXTRA_DOMAIN = "domain";
+    public static final String EXTRA_EMAIL = "email";
+
+    private EditText emailView;
+    private WebView checkoutWebView;
+    private String domain;
+
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        domain = getIntent().getStringExtra(EXTRA_DOMAIN);
+        if (domain == null) {
+            domain = "";
+        }
+        setContentView(buildScreen());
+    }
+
+    private View buildScreen() {
+        LinearLayout screen = new LinearLayout(this);
+        screen.setOrientation(LinearLayout.VERTICAL);
+        screen.setPadding(32, 32, 32, 32);
+
+        TextView title = new TextView(this);
+        title.setText("Checkout " + domain);
+        title.setTextSize(22);
+        screen.addView(title);
+
+        String checkoutUrl = getIntent().getStringExtra(EXTRA_CHECKOUT_URL);
+        if (checkoutUrl != null && !checkoutUrl.isEmpty()) {
+            checkoutWebView = new WebView(this);
+            checkoutWebView.getSettings().setJavaScriptEnabled(true);
+            checkoutWebView.getSettings().setDomStorageEnabled(true);
+            screen.addView(checkoutWebView, new LinearLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+            checkoutWebView.loadUrl(checkoutUrl);
+        }
+
+        emailView = new EditText(this);
+        emailView.setHint("Email");
+        emailView.setSingleLine(true);
+        emailView.setText(getIntent().getStringExtra(EXTRA_EMAIL));
+        screen.addView(emailView);
+
+        Button complete = new Button(this);
+        complete.setText("Complete purchase");
+        complete.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                setResult(RESULT_OK, DomainCheckoutResult.completed(domain, email()).toIntent());
+                finish();
+            }
+        });
+        screen.addView(complete);
+
+        Button cancel = new Button(this);
+        cancel.setText("Cancel");
+        cancel.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                setResult(RESULT_CANCELED, DomainCheckoutResult.canceled(domain, email()).toIntent());
+                finish();
+            }
+        });
+        screen.addView(cancel);
+        return screen;
+    }
+
+    @Override protected void onDestroy() {
+        if (checkoutWebView != null) {
+            checkoutWebView.stopLoading();
+            checkoutWebView.setWebViewClient(new android.webkit.WebViewClient());
+            ViewGroup parent = (ViewGroup) checkoutWebView.getParent();
+            if (parent != null) {
+                parent.removeView(checkoutWebView);
+            }
+            checkoutWebView.destroy();
+            checkoutWebView = null;
+        }
+        super.onDestroy();
+    }
+
+    private String email() {
+        return emailView == null || emailView.getText() == null ? "" : emailView.getText().toString().trim();
+    }
+}
