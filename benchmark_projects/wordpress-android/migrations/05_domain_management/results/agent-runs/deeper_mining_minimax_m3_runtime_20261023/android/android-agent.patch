+package org.wordpress.benchmark.domains.base;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.text.Editable;
+import android.text.TextWatcher;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * The new-domain search screen.
+ *
+ * <p>Typing debounces for {@link DomainPageOwner#SEARCH_DEBOUNCE_MS} milliseconds, only the latest
+ * query is dispatched, and the paid proposals keep their product, price and privacy information
+ * until one of them is selected.</p>
+ */
+public final class DomainSearchActivity extends Activity
+        implements DomainPageOwner.Observer, DomainRouter.Delegate {
+
+    private DomainPageOwner owner;
+    private ProgressBar progressView;
+    private TextView statusView;
+    private LinearLayout resultsView;
+    private boolean updatingQuery;
+
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        owner = DomainSession.get(this).owner();
+        setContentView(buildScreen());
+        owner.addObserver(this);
+        if (!DomainPageOwner.SCREEN_DOMAIN_SEARCH.equals(owner.snapshot().optString("screen", ""))) {
+            owner.openSearch(Json.object());
+        }
+        render();
+    }
+
+    @Override protected void onResume() {
+        super.onResume();
+        DomainRouter.get().setDelegate(this);
+    }
+
+    @Override protected void onPause() {
+        DomainRouter.get().clearDelegate(this);
+        super.onPause();
+    }
+
+    @Override protected void onDestroy() {
+        owner.removeObserver(this);
+        super.onDestroy();
+    }
+
+    @Override public void onDomainStateChanged() {
+        runOnUiThread(new Runnable() {
+            @Override public void run() {
+                render();
+            }
+        });
+    }
+
+    public void render() {
+        if (resultsView == null) {
+            return;
+        }
+        JSONObject state = owner.snapshot();
+        String searchState = state.optString("searchState", "idle");
+        progressView.setVisibility("loading".equals(searchState) ? View.VISIBLE : View.INVISIBLE);
+        statusView.setText(statusText(state, searchState));
+        resultsView.removeAllViews();
+        if ("error".equals(searchState)) {
+            resultsView.addView(buildErrorState(state));
+            return;
+        }
+        JSONArray proposals = state.optJSONArray("searchProposals");
+        if (proposals == null) {
+            return;
+        }
+        for (int index = 0; index < proposals.length(); index++) {
+            JSONObject proposal = proposals.optJSONObject(index);
+            if (proposal != null) {
+                resultsView.addView(buildProposalRow(proposal));
+            }
+        }
+    }
+
+    private View buildScreen() {
+        LinearLayout screen = new LinearLayout(this);
+        screen.setOrientation(LinearLayout.VERTICAL);
+        screen.setPadding(32, 32, 32, 32);
+
+        TextView title = new TextView(this);
+        title.setText("Find a domain");
+        title.setTextSize(24);
+        screen.addView(title);
+
+        EditText queryView = new EditText(this);
+        queryView.setHint("Search for a domain");
+        queryView.setSingleLine(true);
+        queryView.addTextChangedListener(new TextWatcher() {
+            @Override public void beforeTextChanged(CharSequence text, int start, int count, int after) { }
+
+            @Override public void onTextChanged(CharSequence text, int start, int before, int count) { }
+
+            @Override public void afterTextChanged(Editable editable) {
+                if (updatingQuery) {
+                    return;
+                }
+                owner.onSearchQueryChanged(editable == null ? "" : editable.toString());
+            }
+        });
+        screen.addView(queryView, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        progressView = new ProgressBar(this);
+        progressView.setIndeterminate(true);
+        screen.addView(progressView);
+
+        statusView = new TextView(this);
+        statusView.setPadding(0, 16, 0, 16);
+        screen.addView(statusView);
+
+        ScrollView scroller = new ScrollView(this);
+        resultsView = new LinearLayout(this);
+        resultsView.setOrientation(LinearLayout.VERTICAL);
+        scroller.addView(resultsView, new ScrollView.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        screen.addView(scroller, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));
+        return screen;
+    }
+
+    private View buildProposalRow(final JSONObject proposal) {
+        LinearLayout item = new LinearLayout(this);
+        item.setOrientation(LinearLayout.VERTICAL);
+        item.setPadding(0, 24, 0, 24);
+
+        TextView domain = new TextView(this);
+        domain.setText(proposal.optString("domain", ""));
+        domain.setTextSize(18);
+        item.addView(domain);
+
+        String price = proposal.optString("price", "");
+        String salePrice = proposal.optString("salePrice", "");
+        TextView priceView = new TextView(this);
+        priceView.setText(Text.isBlank(salePrice) ? price : salePrice + " (was " + price + ")");
+        priceView.setTextSize(14);
+        item.addView(priceView);
+
+        TextView privacy = new TextView(this);
+        privacy.setText(proposal.optBoolean("supportsPrivacy", false)
+                ? "Privacy protection included" : "No privacy protection");
+        privacy.setTextSize(13);
+        item.addView(privacy);
+
+        Button select = new Button(this);
+        select.setText("Buy " + proposal.optString("domain", ""));
+        select.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                JSONObject payload = Json.object();
+                Json.put(payload, "domain", proposal.optString("domain", ""));
+                owner.selectProposalFromSearchResult(payload);
+            }
+        });
+        item.addView(select);
+        return item;
+    }
+
+    private View buildErrorState(JSONObject state) {
+        LinearLayout error = new LinearLayout(this);
+        error.setOrientation(LinearLayout.VERTICAL);
+        error.setPadding(0, 48, 0, 48);
+        TextView message = new TextView(this);
+        String reason = state.optString("searchError", "");
+        message.setText(Text.isBlank(reason) ? "The domain search failed." : reason);
+        message.setTextSize(16);
+        error.addView(message);
+        Button retry = new Button(this);
+        retry.setText("Retry");
+        retry.setOnClickListener(new View.OnClickListener() {
+            @Override public void onClick(View view) {
+                owner.retrySearch();
+            }
+        });
+        error.addView(retry);
+        return error;
+    }
+
+    private String statusText(JSONObject state, String searchState) {
+        if ("debouncing".equals(searchState)) {
+            return "Searching…";
+        }
+        if ("loading".equals(searchState)) {
+            return "Searching for “" + state.optString("searchQuery", "") + "”…";
+        }
+        if ("error".equals(searchState)) {
+            return "The domain search failed";
+        }
+        if ("populated".equals(searchState)) {
+            return state.optInt("proposalCount", 0) + " domains available";
+        }
+        return "Type to search for a domain";
+    }
+
+    @Override public void openDomainSearch() {
+        // Already on the search screen.
+    }
+
+    @Override public void openDomainPurchase() {
+        startActivity(new android.content.Intent(this, DomainRegistrationActivity.class));
+        finish();
+    }
+
+    @Override public void openCheckout(String checkoutToken, String checkoutUrl) {
+        // The checkout belongs to the purchase screen, which opens it for its own cart.
+        showMessage("Continue with your domain purchase");
+    }
+
+    @Override public void openPlans(String site, String domain) {
+        showMessage("Adding " + domain + " to " + site + " needs one of the eligible plans");
+    }
+
+    @Override public void openDomainDetails(String domain, String url) {
+        showMessage("Domain details for " + domain);
+    }
+
+    @Override public void openExternalUrl(String url) {
+        if (!Text.isBlank(url)) {
+            try {
+                startActivity(new android.content.Intent(android.content.Intent.ACTION_VIEW,
+                        android.net.Uri.parse(url)));
+            } catch (Exception error) {
+                showMessage("No app can open " + url);
+            }
+        }
+    }
+
+    @Override public void closeTransientScreens() {
+        finish();
+    }
+
+    @Override public void showMessage(String message) {
+        if (!Text.isBlank(message)) {
+            Toast.makeText(this, message, Toast.LENGTH_LONG).show();
+        }
+    }
+}
