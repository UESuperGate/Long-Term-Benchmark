@@ -0,0 +1,113 @@
+package org.wordpress.benchmark.domains.base;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+
+/**
+ * Deterministic scheduler driven by an explicit clock.
+ *
+ * <p>Delayed tasks only run when the clock is advanced with {@link #advanceTo(long)}, and they run
+ * in due-time order, so a debounced query and the responses that land while the clock moves can be
+ * observed exactly. Immediate deliveries (page thread posts and worker dispatches) run inline so
+ * that a complete flow resolves before the driver reads the state again.</p>
+ */
+public final class ControlledDomainScheduler implements DomainScheduler {
+
+    private final List<ScheduledTask> tasks = new ArrayList<>();
+    private long now;
+    private long sequence;
+
+    public ControlledDomainScheduler() {
+        this(0L);
+    }
+
+    public ControlledDomainScheduler(long startMillis) {
+        this.now = Math.max(0L, startMillis);
+    }
+
+    @Override public long nowMillis() {
+        return now;
+    }
+
+    @Override public void post(Runnable task) {
+        run(task);
+    }
+
+    @Override public Handle postDelayed(Runnable task, long delayMillis) {
+        long due = now + Math.max(0L, delayMillis);
+        ScheduledTask scheduled = new ScheduledTask(task, due, sequence++);
+        tasks.add(scheduled);
+        return new Handle() {
+            @Override public void cancel() {
+                tasks.remove(scheduled);
+            }
+        };
+    }
+
+    @Override public void executeOnWorker(Runnable task) {
+        run(task);
+    }
+
+    /** Moves the clock forward, running every task that becomes due on the way. */
+    public void advanceTo(long targetMillis) {
+        long target = Math.max(now, targetMillis);
+        while (true) {
+            ScheduledTask next = earliestDueTask(target);
+            if (next == null) {
+                break;
+            }
+            tasks.remove(next);
+            now = Math.max(now, next.dueAt);
+            run(next.task);
+        }
+        now = target;
+    }
+
+    /** True while at least one delayed task is waiting for the clock. */
+    public boolean hasPendingTasks() {
+        return !tasks.isEmpty();
+    }
+
+    /** Due time of the earliest waiting task, or -1 when nothing is scheduled. */
+    public long nextDueAt() {
+        ScheduledTask best = earliestDueTask(Long.MAX_VALUE);
+        return best == null ? -1L : best.dueAt;
+    }
+
+    private ScheduledTask earliestDueTask(long target) {
+        ScheduledTask best = null;
+        for (ScheduledTask task : tasks) {
+            if (task.dueAt > target) {
+                continue;
+            }
+            if (best == null || task.dueAt < best.dueAt || (task.dueAt == best.dueAt && task.sequence < best.sequence)) {
+                best = task;
+            }
+        }
+        return best;
+    }
+
+    private static void run(Runnable task) {
+        if (task != null) {
+            task.run();
+        }
+    }
+
+    /** Drops every delayed task that has not run yet. */
+    public void cancelPendingTasks() {
+        tasks.clear();
+    }
+
+    private static final class ScheduledTask {
+        final Runnable task;
+        final long dueAt;
+        final long sequence;
+
+        ScheduledTask(Runnable task, long dueAt, long sequence) {
+            this.task = task;
+            this.dueAt = dueAt;
+            this.sequence = sequence;
+        }
+    }
+}
