+package org.wordpress.benchmark.domains.base;
+
+import org.json.JSONObject;
+
+import java.util.Locale;
+
+/**
+ * One row of the "All Domains" list.
+ *
+ * <p>A row keeps the account's domain identity together with the site it is attached to, its
+ * registration status, its expiry information and the details destination that is opened when the
+ * user taps the row.</p>
+ */
+public final class DomainRow {
+
+    public final String domain;
+    public final String siteSlug;
+    public final String siteTitle;
+    public final String status;
+    public final String expiry;
+
+    public DomainRow(String domain, String siteSlug, String siteTitle, String status, String expiry) {
+        this.domain = Text.orEmpty(domain);
+        this.siteSlug = Text.orEmpty(siteSlug);
+        this.siteTitle = Text.orEmpty(siteTitle);
+        this.status = Text.orEmpty(status);
+        this.expiry = Text.orEmpty(expiry);
+    }
+
+    /** Reads a row from a backend payload, accepting both camel case and WordPress.com key styles. */
+    public static DomainRow fromJson(JSONObject json) {
+        if (json == null) {
+            return new DomainRow("", "", "", "", "");
+        }
+        String domain = Text.first(json, new String[] { "domain", "domainName", "domain_name", "name" });
+        String siteSlug = Text.first(json, new String[] { "siteSlug", "site_slug", "siteId", "site_id", "blogName", "blog_name" });
+        String siteTitle = Text.first(json, new String[] { "blogName", "blog_name", "siteTitle", "site_title", "title", "name" });
+        String status = Text.first(json, new String[] { "status", "domainStatus", "domain_status", "state" });
+        String expiry = Text.first(json, new String[] { "expiry", "expiryDate", "expiry_date", "expires", "domainExpiry", "domain_expiry_date" });
+        JSONObject expiryObject = json.optJSONObject("expiry");
+        if (expiryObject != null) {
+            expiry = Text.orEmpty(Text.first(expiryObject, new String[] { "date", "expiryDate", "expiry_date" }));
+        }
+        return new DomainRow(domain, siteSlug, siteTitle, status, expiry);
+    }
+
+    /** The contained details destination for this row. */
+    public String detailsUrl() {
+        return DomainUrlPolicy.containedDetailsUrl(domain);
+    }
+
+    public JSONObject toJson() {
+        JSONObject json = new JSONObject();
+        Text.put(json, "domain", domain);
+        Text.put(json, "siteSlug", siteSlug);
+        Text.put(json, "siteTitle", siteTitle);
+        Text.put(json, "blogName", siteTitle);
+        Text.put(json, "status", status);
+        Text.put(json, "expiry", expiry);
+        Text.put(json, "detailsUrl", detailsUrl());
+        return json;
+    }
+
+    /** True when the row matches the given query on domain, site slug or site title. */
+    public boolean matches(String normalizedQuery) {
+        if (Text.isBlank(normalizedQuery)) {
+            return true;
+        }
+        return contains(domain, normalizedQuery)
+                || contains(siteSlug, normalizedQuery)
+                || contains(siteTitle, normalizedQuery);
+    }
+
+    private static boolean contains(String value, String normalizedQuery) {
+        return Text.orEmpty(value).toLowerCase(Locale.ROOT).contains(normalizedQuery);
+    }
+
+    @Override public String toString() {
+        return toJson().toString();
+    }
+}
