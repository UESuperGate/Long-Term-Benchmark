+package org.wordpress.benchmark.domains.base;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+
+import org.json.JSONObject;
+
+/**
+ * The contained domain details screen.
+ *
+ * <p>The authenticated web view may only keep
+ * {@code wordpress.com/domains/manage/all/<domain>/edit/...} for the managed domain. Every other
+ * destination is handed to the external navigation path, so the screen keeps showing the supported
+ * details page.</p>
+ */
+public final class DomainDetailsWebViewActivity extends Activity implements DomainRouter.Delegate {
+
+    public static final String EXTRA_DOMAIN = "domain";
+    public static final String EXTRA_URL = "url";
+
+    private DomainPageOwner owner;
+    private WebView webView;
+
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        owner = DomainSession.get(this).owner();
+        String domain = getIntent().getStringExtra(EXTRA_DOMAIN);
+        String url = getIntent().getStringExtra(EXTRA_URL);
+        if (url == null || url.isEmpty()) {
+            url = DomainUrlPolicy.containedDetailsUrl(domain);
+        }
+        JSONObject payload = Json.object();
+        Json.put(payload, "managedDomain", domain == null ? "" : domain);
+        Json.put(payload, "currentUrl", url);
+        owner.openDetails(payload);
+        DomainRouter.get().setDelegate(this);
+
+        webView = new WebView(this);
+        webView.getSettings().setJavaScriptEnabled(true);
+        webView.getSettings().setDomStorageEnabled(true);
+        webView.setWebViewClient(new WebViewClient() {
+            @Override public boolean shouldOverrideUrlLoading(WebView view, String requestedUrl) {
+                return handleNavigation(requestedUrl);
+            }
+
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                return handleNavigation(request == null || request.getUrl() == null
+                        ? null : request.getUrl().toString());
+            }
+        });
+        setContentView(webView);
+        // Only a destination the policy allows is loaded into the authenticated web view.
+        String contained = owner.containedUrl();
+        if (!Text.isBlank(contained) && owner.isContainedUrlAllowed()) {
+            webView.loadUrl(contained);
+        }
+    }
+
+    @Override protected void onResume() {
+        super.onResume();
+        DomainRouter.get().setDelegate(this);
+    }
+
+    @Override protected void onPause() {
+        DomainRouter.get().clearDelegate(this);
+        super.onPause();
+    }
+
+    @Override protected void onDestroy() {
+        if (webView != null) {
+            webView.stopLoading();
+            webView.setWebViewClient(new WebViewClient());
+            // The web view has to leave the view tree before it can be destroyed.
+            android.view.ViewGroup parent = (android.view.ViewGroup) webView.getParent();
+            if (parent != null) {
+                parent.removeView(webView);
+            }
+            webView.destroy();
+            webView = null;
+        }
+        super.onDestroy();
+    }
+
+    /**
+     * Returns true when the web view must handle the destination itself. A contained page is loaded
+     * in place; anything else is handed to the external navigation path and the current page stays.
+     */
+    private boolean handleNavigation(String requestedUrl) {
+        return !owner.requestDetailsNavigation(requestedUrl);
+    }
+
+    @Override public void openDomainSearch() { }
+
+    @Override public void openDomainPurchase() { }
+
+    @Override public void openCheckout(String checkoutToken, String checkoutUrl) { }
+
+    @Override public void openPlans(String site, String domain) { }
+
+    @Override public void openDomainDetails(String domain, String url) {
+        if (webView != null && url != null && !url.isEmpty()) {
+            webView.loadUrl(url);
+        }
+    }
+
+    @Override public void openExternalUrl(String url) {
+        if (url == null || url.isEmpty()) {
+            return;
+        }
+        try {
+            startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(url)));
+        } catch (Exception error) {
+            // No browser is installed; the contained page is kept instead.
+        }
+    }
+
+    @Override public void closeTransientScreens() {
+        finish();
+    }
+
+    @Override public void showMessage(String message) { }
+}
