+package org.wordpress.benchmark.domains.base;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.json.JSONTokener;
+
+import java.io.BufferedReader;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.Charset;
+
+/**
+ * WordPress.com backend for the domain pages.
+ *
+ * <p>All domains come from the account domains endpoint, paid proposals from the domain
+ * suggestions endpoint, and the purchase cart from the domains cart endpoint, which answers with
+ * the checkout token/url used by the checkout activity.</p>
+ */
+public final class DomainBackend implements DomainPageOwner.Backend {
+
+    public static final String API_BASE = "https://public-api.wordpress.com/rest/v1.1";
+
+    private static final Charset UTF_8 = Charset.forName("UTF-8");
+    private static final int TIMEOUT_MS = 20000;
+
+    private final String authorization;
+
+    public DomainBackend(String bearerToken) {
+        String token = Text.orEmpty(bearerToken).trim();
+        this.authorization = token.isEmpty() ? "" : "Bearer " + token;
+    }
+
+    @Override public JSONObject fetchAllDomains() throws Exception {
+        return fetchAllDomainsPage();
+    }
+
+    @Override public JSONObject fetchAllDomainsPage() throws Exception {
+        JSONObject response = request("GET", API_BASE + "/domains/manage/all", null);
+        JSONArray domains = response.optJSONArray("domains");
+        if (domains == null) {
+            domains = response.optJSONArray("site_domains");
+        }
+        if (domains == null) {
+            domains = Json.array();
+        }
+        JSONArray rows = Json.array();
+        for (int index = 0; index < domains.length(); index++) {
+            JSONObject domain = domains.optJSONObject(index);
+            if (domain == null) {
+                continue;
+            }
+            JSONObject row = Json.object();
+            Json.put(row, "domain", Text.first(domain, new String[] { "domain", "domain_name" }));
+            Json.put(row, "siteSlug", Text.first(domain, new String[] { "siteSlug", "site_slug", "blogName" }));
+            Json.put(row, "blogName", Text.first(domain, new String[] { "blogName", "blog_name", "name" }));
+            Json.put(row, "status", Text.first(domain, new String[] { "status", "domainStatus", "domain_status" }));
+            JSONObject expiry = domain.optJSONObject("expiry");
+            Json.put(row, "expiry", expiry == null
+                    ? Text.first(domain, new String[] { "expiry", "expiry_date", "domain_expiry_date" })
+                    : Text.first(expiry, new String[] { "date", "expiry_date" }));
+            rows.put(row);
+        }
+        JSONObject normalized = Json.object();
+        Json.put(normalized, "type", rows.length() == 0 ? "empty" : "success");
+        Json.put(normalized, "domains", rows);
+        return normalized;
+    }
+
+    @Override public JSONArray searchForDomains(String query) throws Exception {
+        return searchDomainSuggestions(query).optJSONArray("suggestions");
+    }
+
+    @Override public JSONObject searchDomainSuggestions(String query) throws Exception {
+        JSONObject response = request("GET", API_BASE + "/domains/suggestions?q="
+                + DomainUrlPolicy.encodeQuery(Text.orEmpty(query).trim()), null);
+        JSONArray suggestions = response.optJSONArray("suggestions");
+        if (suggestions == null) {
+            suggestions = response.optJSONArray("domains");
+        }
+        JSONObject envelope = Json.object();
+        Json.put(envelope, "query", Text.orEmpty(query).trim());
+        Json.put(envelope, "suggestions", suggestions == null ? Json.array() : suggestions);
+        return envelope;
+    }
+
+    @Override public JSONObject createCart(String mode, String domain) throws Exception {
+        JSONObject request = Json.object();
+        Json.put(request, "mode", mode);
+        Json.put(request, "domain", domain);
+        return createCartForProposal(request);
+    }
+
+    @Override public JSONObject createCartForProposal(JSONObject request) throws Exception {
+        JSONObject body = Json.object();
+        Json.put(body, "product_id", request.optInt("productId", DomainSuggestion.NO_PRODUCT));
+        Json.put(body, "domain_name", request.optString("domain", ""));
+        Json.put(body, "privacy", request.optBoolean("supportsPrivacy", false));
+        Json.put(body, "mode", request.optString("mode", ""));
+        String site = request.optString("site", "");
+        if (!Text.isBlank(site)) {
+            Json.put(body, "extra", site);
+        }
+        JSONObject response = request("POST", API_BASE + "/domains/cart", body);
+        JSONObject normalized = Json.object();
+        Json.put(normalized, "type", "success");
+        Json.put(normalized, "checkoutToken", Text.first(response, new String[] { "cart_token", "checkout_token", "token" }));
+        Json.put(normalized, "checkoutUrl", Text.first(response, new String[] { "checkout_url", "url" }));
+        Json.put(normalized, "requiresPlan", Text.firstBoolean(response, new String[] { "requires_plan", "plan_required" }, false));
+        return normalized;
+    }
+
+    @Override public JSONArray fetchSites() throws Exception {
+        Object value = requestValue("GET", API_BASE + "/me/sites", null);
+        if (value instanceof JSONArray) {
+            return (JSONArray) value;
+        }
+        if (value instanceof JSONObject) {
+            JSONArray sites = ((JSONObject) value).optJSONArray("sites");
+            return sites == null ? Json.array() : sites;
+        }
+        return Json.array();
+    }
+
+    private JSONObject request(String method, String url, JSONObject body) throws Exception {
+        Object value = requestValue(method, url, body);
+        return value instanceof JSONObject ? (JSONObject) value : Json.object();
+    }
+
+    /**
+     * Performs a request and returns the parsed body. WordPress.com answers with an object for most
+     * endpoints and with a bare array for others (for example the site list), so both are accepted.
+     */
+    private Object requestValue(String method, String url, JSONObject body) throws Exception {
+        HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();
+        try {
+            connection.setRequestMethod(method);
+            connection.setConnectTimeout(TIMEOUT_MS);
+            connection.setReadTimeout(TIMEOUT_MS);
+            connection.setRequestProperty("Accept", "application/json");
+            if (!Text.isBlank(authorization)) {
+                connection.setRequestProperty("Authorization", authorization);
+            }
+            if (body != null) {
+                connection.setDoOutput(true);
+                connection.setRequestProperty("Content-Type", "application/json; charset=utf-8");
+                OutputStream output = connection.getOutputStream();
+                try {
+                    output.write(body.toString().getBytes(UTF_8));
+                    output.flush();
+                } finally {
+                    output.close();
+                }
+            }
+            int status = connection.getResponseCode();
+            String payload = read(status >= 400 ? connection.getErrorStream() : connection.getInputStream());
+            if (status >= 400) {
+                throw new IllegalStateException("the WordPress.com request failed with HTTP " + status);
+            }
+            return new JSONTokener(payload).nextValue();
+        } finally {
+            connection.disconnect();
+        }
+    }
+
+    private static String read(InputStream stream) throws Exception {
+        if (stream == null) {
+            return "{}";
+        }
+        BufferedReader reader = new BufferedReader(new InputStreamReader(stream, UTF_8));
+        try {
+            StringBuilder payload = new StringBuilder();
+            String line = reader.readLine();
+            while (line != null) {
+                payload.append(line);
+                line = reader.readLine();
+            }
+            return payload.toString();
+        } finally {
+            reader.close();
+        }
+    }
