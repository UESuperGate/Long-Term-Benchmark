+package org.wordpress.benchmark.domains.base;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * Exception-free JSON writers.
+ *
+ * <p>The domain pages keep their state as plain JSON, so building a payload should never force the
+ * caller to handle {@code JSONException}: a value that cannot be stored simply is not stored.</p>
+ */
+final class Json {
+
+    private Json() { }
+
+    static JSONObject object() {
+        return new JSONObject();
+    }
+
+    static JSONArray array() {
+        return new JSONArray();
+    }
+
+    static void put(JSONObject json, String key, String value) {
+        try {
+            json.put(key, value == null ? "" : value);
+        } catch (Exception ignored) {
+            // A JSON string value is always accepted; nothing to recover from.
+        }
+    }
+
+    static void put(JSONObject json, String key, boolean value) {
+        try {
+            json.put(key, value);
+        } catch (Exception ignored) {
+            // See above.
+        }
+    }
+
+    static void put(JSONObject json, String key, int value) {
+        try {
+            json.put(key, value);
+        } catch (Exception ignored) {
+            // See above.
+        }
+    }
+
+    static void put(JSONObject json, String key, long value) {
+        try {
+            json.put(key, value);
+        } catch (Exception ignored) {
+            // See above.
+        }
+    }
+
+    static void put(JSONObject json, String key, double value) {
+        try {
+            json.put(key, value);
+        } catch (Exception ignored) {
+            // See above.
+        }
+    }
+
+    static void put(JSONObject json, String key, JSONArray value) {
+        try {
+            json.put(key, value == null ? new JSONArray() : value);
+        } catch (Exception ignored) {
+            // See above.
+        }
+    }
+
+    static void put(JSONObject json, String key, JSONObject value) {
+        try {
+            json.put(key, value == null ? JSONObject.NULL : value);
+        } catch (Exception ignored) {
+            // See above.
+        }
+    }
+
+    static void put(JSONObject json, String key, Object value) {
+        try {
+            json.put(key, value == null ? JSONObject.NULL : value);
+        } catch (Exception ignored) {
+            // See above.
+        }
+    }
+}
