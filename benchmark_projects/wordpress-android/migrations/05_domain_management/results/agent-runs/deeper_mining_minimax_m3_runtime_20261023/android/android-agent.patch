+package org.wordpress.benchmark.domains.base;
+
+import org.json.JSONObject;
+
+/** Small string/JSON helpers shared by the domain pages. */
+final class Text {
+
+    private Text() { }
+
+    static String orEmpty(String value) {
+        return value == null ? "" : value;
+    }
+
+    static boolean isBlank(String value) {
+        return value == null || value.trim().isEmpty();
+    }
+
+    static String normalizeQuery(String value) {
+        return orEmpty(value).trim().toLowerCase(java.util.Locale.ROOT);
+    }
+
+    static String first(JSONObject json, String[] keys) {
+        if (json == null) {
+            return "";
+        }
+        for (String key : keys) {
+            String value = optString(json, key);
+            if (!value.isEmpty()) {
+                return value;
+            }
+        }
+        return "";
+    }
+
+    /**
+     * Reads a string value, treating an explicit JSON null and an empty value alike. Android's
+     * {@code optString} turns a JSON null into the literal text "null", which is never a value a
+     * caller meant to send.
+     */
+    static String optString(JSONObject json, String key) {
+        if (json == null || !json.has(key) || json.isNull(key)) {
+            return "";
+        }
+        Object value = json.opt(key);
+        if (value instanceof String) {
+            return ((String) value).trim();
+        }
+        if (value == null || value == JSONObject.NULL) {
+            return "";
+        }
+        String text = String.valueOf(value).trim();
+        return "null".equals(text) ? "" : text;
+    }
+
+    static long firstLong(JSONObject json, String[] keys, long fallback) {
+        if (json == null) {
+            return fallback;
+        }
+        for (String key : keys) {
+            if (!json.has(key) || json.isNull(key)) {
+                continue;
+            }
+            Object value = json.opt(key);
+            if (value instanceof Number) {
+                return ((Number) value).longValue();
+            }
+            try {
+                return Long.parseLong(String.valueOf(value).trim());
+            } catch (NumberFormatException error) {
+                // Try the next key.
+            }
+        }
+        return fallback;
+    }
+
+    static double firstDouble(JSONObject json, String[] keys, double fallback) {
+        if (json == null) {
+            return fallback;
+        }
+        for (String key : keys) {
+            if (!json.has(key) || json.isNull(key)) {
+                continue;
+            }
+            Object value = json.opt(key);
+            if (value instanceof Number) {
+                return ((Number) value).doubleValue();
+            }
+            try {
+                return Double.parseDouble(String.valueOf(value).trim());
+            } catch (NumberFormatException error) {
+                // Try the next key.
+            }
+        }
+        return fallback;
+    }
+
+    static boolean firstBoolean(JSONObject json, String[] keys, boolean fallback) {
+        if (json == null) {
+            return fallback;
+        }
+        for (String key : keys) {
+            if (!json.has(key) || json.isNull(key)) {
+                continue;
+            }
+            Object value = json.opt(key);
+            if (value instanceof String && ((String) value).trim().isEmpty()) {
+                continue;
+            }
+            if (value instanceof Boolean) {
+                return (Boolean) value;
+            }
+            String text = String.valueOf(value).trim();
+            if ("true".equalsIgnoreCase(text) || "1".equals(text)) {
+                return true;
+            }
+            if ("false".equalsIgnoreCase(text) || "0".equals(text)) {
+                return false;
+            }
+        }
+        return fallback;
+    }
+
+    static void put(JSONObject json, String key, String value) {
+        try {
+            json.put(key, orEmpty(value));
+        } catch (Exception error) {
+            // A JSONObject never rejects a string value; nothing to recover here.
+        }
+    }
+}
