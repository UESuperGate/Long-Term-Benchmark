@@ -0,0 +1,141 @@
+package org.wordpress.benchmark.domains.base;
+
+import android.app.Activity;
+import android.content.Intent;
+
+import org.json.JSONObject;
+
+import java.util.Locale;
+
+/**
+ * Typed result contract of the domain checkout.
+ *
+ * <p>The checkout screen returns the registered domain and the owner email; a user cancellation
+ * travels through the same contract with the cancelled flag set. A result that does not carry a
+ * usable domain and email is rejected by {@link #fromJson(JSONObject)} so that it can never be
+ * reported as a completed registration.</p>
+ */
+public final class DomainCheckoutResult {
+
+    public static final String EXTRA_DOMAIN_NAME = "domainName";
+    public static final String EXTRA_EMAIL = "email";
+    public static final String EXTRA_CANCELED = "canceled";
+
+    public final String domainName;
+    public final String email;
+    public final boolean cancelled;
+
+    private DomainCheckoutResult(String domainName, String email, boolean cancelled) {
+        this.domainName = domainName;
+        this.email = email;
+        this.cancelled = cancelled;
+    }
+
+    public static DomainCheckoutResult completed(String domainName, String email) {
+        return new DomainCheckoutResult(domainName, email, false);
+    }
+
+    public static DomainCheckoutResult canceled(String domainName, String email) {
+        return new DomainCheckoutResult(domainName, email, true);
+    }
+
+    /**
+     * Reads the result of the checkout activity, or returns {@code null} when it is not usable.
+     *
+     * <p>The activity always answers with the typed contract. A result without any payload is a
+     * user cancellation: the checkout was closed before it registered anything.</p>
+     */
+    public static DomainCheckoutResult fromIntent(Intent data, int resultCode, String pendingDomain) {
+        boolean cancelled = data == null || data.getBooleanExtra(EXTRA_CANCELED, resultCode != Activity.RESULT_OK);
+        JSONObject payload = new JSONObject();
+        String domain = pendingDomain == null ? "" : pendingDomain;
+        String email = "";
+        if (data != null) {
+            String extraDomain = data.getStringExtra(EXTRA_DOMAIN_NAME);
+            domain = Text.isBlank(extraDomain) ? domain : extraDomain;
+            email = Text.orEmpty(data.getStringExtra(EXTRA_EMAIL));
+        }
+        Text.put(payload, EXTRA_DOMAIN_NAME, domain);
+        Text.put(payload, EXTRA_EMAIL, email);
+        Json.put(payload, "canceled", cancelled);
+        return fromJson(payload);
+    }
+
+    /** Parses a checkout result payload, returning {@code null} when the result is missing/invalid. */
+    public static DomainCheckoutResult fromJson(JSONObject json) {
+        if (json == null) {
+            return null;
+        }
+        String domain = Text.first(json, new String[] { EXTRA_DOMAIN_NAME, "domain_name", "domain", "domainName" });
+        String email = Text.first(json, new String[] { EXTRA_EMAIL, "emailAddress", "email_address" });
+        boolean cancelled = Text.firstBoolean(json, new String[] {
+                EXTRA_CANCELED, "cancelled", "isCanceled", "wasCanceled", "cancel" }, false);
+        if (domain.isEmpty()) {
+            return null;
+        }
+        if (email.isEmpty() && !cancelled) {
+            // A registration always names the owner email; a cancellation may not carry one yet,
+            // because no registration took place.
+            return null;
+        }
+        return new DomainCheckoutResult(domain, email, cancelled);
+    }
+
+    /** Explains why a payload could not be accepted as a checkout result. */
+    public static String rejectionReason(JSONObject json) {
+        if (json == null) {
+            return "checkout returned no result";
+        }
+        String domain = Text.first(json, new String[] { EXTRA_DOMAIN_NAME, "domain_name", "domain", "domainName" });
+        if (domain.isEmpty()) {
+            return "checkout result is missing the registered domain";
+        }
+        boolean cancelled = Text.firstBoolean(json, new String[] {
+                EXTRA_CANCELED, "cancelled", "isCanceled", "wasCanceled", "cancel" }, false);
+        if (!cancelled && Text.first(json, new String[] { EXTRA_EMAIL, "emailAddress", "email_address" }).isEmpty()) {
+            return "checkout result is missing the owner email";
+        }
+        return "checkout result could not be read";
+    }
+
+    public boolean isCanceled() {
+        return cancelled;
+    }
+
+    public boolean isCompleted() {
+        return !cancelled;
+    }
+
+    /** True when the result reports the same domain the purchase flow started with. */
+    public boolean matchesDomain(String domain) {
+        return !Text.isBlank(domain) && domain.trim().toLowerCase(Locale.ROOT).equals(domainName.toLowerCase(Locale.ROOT));
+    }
+
+    /** True when both results describe the same checkout outcome. */
+    public boolean isSameAs(DomainCheckoutResult other) {
+        return other != null && other.cancelled == cancelled
+                && other.domainName.equalsIgnoreCase(domainName)
+                && other.email.equalsIgnoreCase(email);
+    }
+
+    public Intent toIntent() {
+        Intent intent = new Intent();
+        intent.putExtra(EXTRA_DOMAIN_NAME, domainName);
+        intent.putExtra(EXTRA_EMAIL, email);
+        intent.putExtra(EXTRA_CANCELED, cancelled);
+        return intent;
+    }
+
+    public JSONObject toJson() {
+        JSONObject json = Json.object();
+        Json.put(json, EXTRA_DOMAIN_NAME, domainName);
+        Json.put(json, EXTRA_EMAIL, email);
+        Json.put(json, EXTRA_CANCELED, cancelled);
+        Json.put(json, "isSuccess", isCompleted());
+        return json;
+    }
+
+    @Override public String toString() {
+        return toJson().toString();
+    }
+}
