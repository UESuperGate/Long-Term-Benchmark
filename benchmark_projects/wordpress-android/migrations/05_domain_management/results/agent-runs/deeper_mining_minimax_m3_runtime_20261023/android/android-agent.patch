+     * rows of a loaded list: the stored collection and the loaded state itself are left alone.
+     */
+    private void filterAccountDomains(String query) {
+        if (!isListUsable()) {
+            // Nothing is loaded, so there is no list to filter and nothing to show.
+            visibleDomains.clear();
+            return;
+        }
+        String normalized = Text.normalizeQuery(query);
+        visibleDomains.clear();
+        for (DomainRow row : accountDomains) {
+            if (row.matches(normalized)) {
+                visibleDomains.add(row);
+            }
+        }
+        if (accountDomains.isEmpty()) {
+            // An account without domains stays empty; it never becomes a filtered list.
+            setListState(LIST_EMPTY);
+            return;
+        }
+        setListState(normalized.isEmpty() ? LIST_COMPLETE : LIST_FILTERED);
+    }
