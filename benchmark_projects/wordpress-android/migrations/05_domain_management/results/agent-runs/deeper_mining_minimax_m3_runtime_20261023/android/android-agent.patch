+            settlePendingWork();
+            notifyObservers();
+            return;
+        }
+        useControlledClock(to);
+        emit("clockAdvanced", "toMs", to);
+        advanceControlledClockTo(to);
+        notifyObservers();
+    }
+
+    /**
+     * Runs every piece of page work that is already scheduled: a pending debounce and the responses
+     * that land after it. Used by the wait steps of a driver, and when a clock is advanced without
+     * a target time.
+     */
+    private void settlePendingWork() {
+        if (!(scheduler instanceof ControlledDomainScheduler)) {
+            return;
+        }
+        ControlledDomainScheduler clock = (ControlledDomainScheduler) scheduler;
+        for (int round = 0; round < 16 && clock.hasPendingTasks(); round++) {
+            long due = clock.nextDueAt();
+            if (due < 0L) {
+                return;
+            }
+            clock.advanceTo(due);
+        }
+    }
+
+    private void waitFor(String expectation) {
+        settlePendingWork();
+        trace.add("DomainPageOwner.await(" + expectation + ")");
+        notifyObservers();
+    }
+
+    private void dispatchSearch(final String normalizedQuery) {
+        pendingDispatch = null;
+        if (!normalizedQuery.equals(searchQuery)) {
+            emit("searchDispatchSkipped",
+                    "query", normalizedQuery,
+                    "latestQuery", searchQuery,
+                    "reason", "superseded before dispatch");
+            return;
+        }
+        final Backend currentBackend = backend;
+        if (currentBackend == null) {
+            applySearchError(normalizedQuery, "no domain backend is available");
+            return;
+        }
+        final int generation = queryGeneration;
+        searchRequestCount++;
+        latestDispatchedQuery = normalizedQuery;
+        dispatchedQueries.add(normalizedQuery);
+        trim(dispatchedQueries);
+        searchError = "";
+        setSearchState(SEARCH_LOADING);
+        emit("searchForDomains",
+                "query", normalizedQuery,
+                "normalizedQuery", normalizedQuery,
+                "requestIndex", searchRequestCount,
+                "generation", generation);
+        trace.add("DomainPageOwner.searchForDomains(" + normalizedQuery + ")");
+        notifyObservers();
+        scheduler.executeOnWorker(new Runnable() {
+            @Override public void run() {
+                JSONObject response;
+                try {
+                    response = currentBackend.searchDomainSuggestions(normalizedQuery);
+                } catch (Exception error) {
+                    response = errorResponse(error);
+                }
+                final JSONObject payload = response == null
+                        ? errorResponse(new IllegalStateException("the suggestions response was empty"))
+                        : response;
+                scheduler.post(new Runnable() {
+                    @Override public void run() {
+                        deliverSearchResponse(generation, normalizedQuery, payload);
+                    }
+                });
+            }
+        });
+    }
+
+    /**
+     * Delivers a suggestions response. A response that the network still owes at a later moment is
+     * held until its due time, so an older response really can land after a newer query.
+     */
+    private void deliverSearchResponse(int generation, String query, JSONObject response) {
+        long dueAt = responseDueAt(query);
+        if (dueAt > scheduler.nowMillis()) {
+            final int requestGeneration = generation;
+            final String requestQuery = query;
+            final JSONObject requestResponse = response;
+            scheduler.postDelayed(new Runnable() {
+                @Override public void run() {
+                    applySearchResponse(requestGeneration, requestQuery, requestResponse);
+                }
+            }, dueAt - scheduler.nowMillis());
+            return;
+        }
+        applySearchResponse(generation, query, response);
+    }
+
+    private void applySearchResponse(int generation, String query, JSONObject response) {
+        if (generation != queryGeneration || !query.equals(searchQuery)) {
+            emit("staleSearchCompletionIgnored",
+                    "query", query,
+                    "latestQuery", searchQuery,
+                    "generation", generation,
+                    "latestGeneration", queryGeneration);
+            return;
+        }
+        if (isErrorResponse(response)) {
+            applySearchError(query, Text.isBlank(errorMessage(response))
+                    ? "the domain suggestions could not be loaded" : errorMessage(response));
+            return;
+        }
+        String remoteQuery = Text.normalizeQuery(Text.first(response, new String[] { "query", "search", "searchedQuery" }));
+        if (!remoteQuery.isEmpty() && !remoteQuery.equals(query)) {
+            applySearchError(query, "the domain suggestions answered the query \"" + remoteQuery + "\"");
+            return;
+        }
+        // The proposals always come from the response; nothing else may claim them.
+        JSONArray suggestions = suggestionsOf(response);
+        List<DomainSuggestion> paid = DomainSuggestion.paidProposals(suggestions);
+        proposals.clear();
+        proposals.addAll(paid);
+        searchError = "";
+        setSearchState(SEARCH_POPULATED);
+        emit("searchResults",
+                "query", query,
+                "proposals", proposals.size(),
+                "excludedFreeSuggestions", countFreeSuggestions(suggestions));
+        notifyObservers();
+    }
+
+    private void applySearchError(String query, String message) {
+        searchError = Text.orEmpty(message);
+        proposals.clear();
+        setSearchState(SEARCH_ERROR);
+        emit("searchFailed", "query", query, "message", searchError, "retryable", true);
+        notifyObservers();
+    }
+
+    /** Retries a failed suggestions request with the retained query. */
+    public void retrySearch() {
+        trace.add("DomainPageOwner.retrySearch()");
+        String query = searchQuery.isEmpty() ? latestDispatchedQuery : searchQuery;
+        if (query.isEmpty()) {
+            emit("searchRetryIgnored", "reason", "no retained query");
+            return;
+        }
+        searchQuery = query;
+        queryGeneration++;
+        cancelPendingDispatch();
+        emit("retryDomainSearch", "query", query);
+        dispatchSearch(query);
+    }
+
+    /**
+     * Applies a suggestions payload that arrived outside the debounced search, for example a
+     * suggestions response that was already in flight when the search screen opened.
+     */
+    private void applySearchResultsPayload(JSONObject payload) {
+        if (payload == null) {
+            return;
+        }
+        String query = Text.normalizeQuery(firstNonBlank(Text.optString(payload, "query"), searchQuery));
+        if (query.isEmpty()) {
+            emit("searchResultsIgnored", "reason", "the payload names no query");
+            return;
+        }
+        // A delivered response owns the visible results, so any pending debounce is dropped and the
+        // proposals go through the very same path a network response takes.
+        cancelPendingDispatch();
+        searchQuery = query;
+        applySearchResponse(queryGeneration, query, payload);
+    }
+
+    private boolean searchScreenOpen() {
+        return screen == SCREEN_DOMAIN_SEARCH || searchState == SEARCH_DEBOUNCING
+                || searchState == SEARCH_LOADING || searchState == SEARCH_POPULATED || searchState == SEARCH_ERROR;
+    }
+
+    // ---------------------------------------------------------------- purchase modes
+
+    /** Selects a proposal from the visible search results and opens the purchase-mode screen. */
+    public void selectProposalFromSearchResult(JSONObject payload) {
+        DomainSuggestion proposal = proposalFrom(payload);
+        if (proposal == null) {
+            emit("proposalSelectionIgnored",
+                    "reason", "no proposal was selected",
+                    "visibleProposals", proposals.size());
+            return;
+        }
+        selectProposal(proposal);
+    }
+
+    /**
+     * The proposal a screen action refers to. A search result tap only carries the tapped domain,
+     * so the proposal is read back from the visible results to keep its product, price and privacy
+     * fields; a proposal handed over as a whole object is used as it is.
+     */
+    private DomainSuggestion proposalFrom(JSONObject payload) {
+        JSONObject proposalJson = payload.optJSONObject("proposal");
+        if (proposalJson == null) {
+            proposalJson = payload.optJSONObject("selectedProposal");
+        }
+        if (proposalJson != null) {
+            return DomainSuggestion.fromJson(proposalJson, 0d);
+        }
+        String domain = Text.optString(payload, "domain");
+        if (!Text.isBlank(domain)) {
+            DomainSuggestion visible = DomainSuggestion.findByDomain(proposals, domain);
+            if (visible != null) {
+                return visible;
+            }
+            if (selectedProposal != null && selectedProposal.domain.equalsIgnoreCase(domain)) {
+                return selectedProposal;
+            }
+            return null;
+        }
+        return selectedProposal;
+    }
+
+    /** Opens the purchase-mode screen for a proposal without choosing a mode. */
+    public void selectProposal(DomainSuggestion proposal) {
+        selectedProposal = proposal;
+        purchaseAttempt++;
+        purchaseMode = "";
+        existingSite = "";
+        resetCart();
+        purchaseScreenOpen = true;
+        screen = SCREEN_DOMAIN_PURCHASE;
+        destination = DESTINATION_DOMAIN_PURCHASE;
+        emit("proposalSelected", "proposal", proposal == null ? null : proposal.toJson());
+        emit("navigate", "destination", DESTINATION_DOMAIN_PURCHASE,
+                "domain", proposal == null ? "" : proposal.domain);
+        notifyObservers();
+    }
+
+    /** The purchase-mode screen entry point. */
+    public void openPurchaseMode(JSONObject payload) {
+        DomainSuggestion proposal = proposalFrom(payload);
+        if (proposal == null) {
+            emit("purchaseModeIgnored", "reason", "no proposal was selected");
+            return;
+        }
+        boolean sameSelection = selectedProposal != null
+                && selectedProposal.domain.equalsIgnoreCase(proposal.domain)
+                && selectedProposal.productId == proposal.productId;
+        selectedProposal = proposal;
+        if (!sameSelection) {
+            purchaseMode = "";
+            existingSite = "";
+            resetCart();
+        }
+        purchaseScreenOpen = true;
+        screen = SCREEN_DOMAIN_PURCHASE;
+        destination = DESTINATION_DOMAIN_PURCHASE;
+        trace.add("DomainPageOwner.openPurchaseMode()");
+        emit("purchaseModeOpened", "proposal", selectedProposal.toJson(),
+                "modeSelected", !Text.isBlank(purchaseMode),
+                "cartRequests", cartRequestCount);
+        notifyObservers();
+    }
+
+    /** Chooses a purchase mode and submits the cart for it. */
+    public void selectPurchaseMode(String mode, JSONObject payload) {
+        if (selectedProposal == null) {
+            emit("purchaseModeIgnored", "reason", "no proposal was selected");
+            return;
+        }
+        String site = MODE_EXISTING_SITE.equals(mode)
+                ? firstNonBlank(siteFrom(payload), existingSite) : "";
+        boolean sameChoice = mode.equals(purchaseMode)
+                && (!MODE_EXISTING_SITE.equals(mode) || site.equalsIgnoreCase(existingSite));
+        if (sameChoice && cartState != CART_IDLE) {
+            // The same purchase is in flight or already submitted; no duplicate cart is created.
+            emit("duplicateCartSubmissionIgnored",
+                    "mode", purchaseMode,
+                    "domain", selectedProposal.domain,
+                    "cartState", cartState);
+            return;
+        }
+        purchaseMode = mode;
+        existingSite = site;
+        resetCart();
+        purchaseScreenOpen = true;
+        screen = SCREEN_DOMAIN_PURCHASE;
+        if (MODE_EXISTING_SITE.equals(mode) && Text.isBlank(existingSite)) {
+            // An existing-site cart without a target site cannot be submitted yet.
+            cartProgress = "waitingForSite:" + mode;
+            recordCartProgress();
+            emit("existingSiteRequired", "domain", selectedProposal.domain, "mode", mode);
+            notifyObservers();
+            return;
+        }
+        trace.add("DomainPageOwner.selectPurchaseMode(" + mode + ")");
+        submitCart();
+    }
+
+    private String siteFrom(JSONObject payload) {
+        if (payload == null) {
+            return "";
+        }
+        return firstNonBlank(
+                Text.optString(payload, "site"),
+                Text.optString(payload, "siteSlug"),
+                Text.optString(payload, "siteName"),
+                Text.optString(payload, "blogName"),
+                Text.optString(payload, "siteId"));
+    }
+
+    /** Submits the cart for the selected mode; at most one request per explicit attempt. */
+    public void submitCart() {
+        if (selectedProposal == null) {
+            emit("cartSubmissionIgnored", "reason", "no proposal was selected");
+            return;
+        }
+        if (Text.isBlank(purchaseMode)) {
+            emit("cartSubmissionIgnored", "reason", "no purchase mode was chosen",
+                    "domain", selectedProposal.domain);
+            return;
+        }
+        if (registeredAttempt == purchaseAttempt) {
+            // This exact purchase already went through checkout, so no second cart is created for
+            // it; selecting another domain starts a new attempt.
+            emit("cartSubmissionIgnored", "reason", "the checkout already completed",
+                    "domain", selectedProposal.domain,
+                    "purchaseAttempt", purchaseAttempt);
+            return;
+        }
+        if (cartState == CART_SUBMITTING) {
+            emit("duplicateCartSubmissionIgnored", "mode", purchaseMode, "domain", selectedProposal.domain);
+            return;
+        }
+        if (cartState == CART_ERROR) {
+            // The failure has to be acknowledged first, which keeps the proposal selected.
+            emit("cartSubmissionIgnored", "reason", "the cart error has to be acknowledged first",
+                    "mode", purchaseMode, "domain", selectedProposal.domain);
+            return;
+        }
+        if (cartState == CART_COMPLETED) {
+            emit("duplicateCartSubmissionIgnored", "mode", purchaseMode, "domain", selectedProposal.domain);
+            return;
+        }
+        final Backend currentBackend = backend;
+        if (currentBackend == null) {
+            applyCartError(purchaseMode, selectedProposal.domain, "no domain backend is available");
+            return;
+        }
+        final int requestId = ++cartRequestCount;
+        final String mode = purchaseMode;
+        final String domain = selectedProposal.domain;
+        final JSONObject request = cartRequest(mode, domain);
+        cartState = CART_SUBMITTING;
+        cartProgress = "submitting:" + mode;
+        recordCartProgress();
+        cartError = "";
+        emit("cartSubmitted", "mode", mode, "domain", domain, "requestIndex", requestId,
+                "purchaseAttempt", purchaseAttempt,
+                "productId", selectedProposal.productId, "supportsPrivacy", selectedProposal.supportsPrivacy,
+                "progress", cartProgress);
+        trace.add("DomainPageOwner.createCart(" + mode + ")");
+        notifyObservers();
+        scheduler.executeOnWorker(new Runnable() {
+            @Override public void run() {
+                JSONObject response;
+                try {
+                    response = currentBackend.createCartForProposal(request);
+                } catch (Exception error) {
+                    response = errorResponse(error);
+                }
+                final JSONObject payload = response == null
+                        ? errorResponse(new IllegalStateException("the cart could not be created")) : response;
+                scheduler.post(new Runnable() {
+                    @Override public void run() {
+                        applyCartResponse(requestId, mode, domain, payload);
+                    }
+                });
+            }
+        });
+    }
+
+    /** Acknowledging a cart failure keeps the selected proposal so the attempt can be retried. */
+    public void acknowledgeCartError() {
+        trace.add("DomainPageOwner.acknowledgeCartError()");
+        if (cartState != CART_ERROR) {
+            emit("cartErrorAcknowledged", "cartState", cartState, "mode", purchaseMode);
+            return;
+        }
+        cartState = CART_IDLE;
+        cartProgress = "idle:" + purchaseMode;
+        recordCartProgress();
+        cartError = "";
+        purchaseScreenOpen = true;
+        screen = SCREEN_DOMAIN_PURCHASE;
+        emit("cartErrorAcknowledged",
+                "mode", purchaseMode,
+                "domain", selectedProposal == null ? "" : selectedProposal.domain,
+                "proposal", selectedProposal == null ? null : selectedProposal.toJson());
+        notifyObservers();
+    }
+
+    /** Explicit cart retry from the same domain selection. */
+    public void retryCart() {
+        trace.add("DomainPageOwner.retryCart()");
+        if (cartState == CART_ERROR) {
+            emit("cartRetryIgnored", "reason", "the cart error has to be acknowledged first",
+                    "mode", purchaseMode);
+            return;
+        }
+        submitCart();
+    }
+
+    private JSONObject cartRequest(String mode, String domain) {
+        JSONObject request = Json.object();
+        Json.put(request, "mode", mode);
+        Json.put(request, "domain", domain);
+        if (selectedProposal != null) {
+            Json.put(request, "productId", selectedProposal.productId);
+            Json.put(request, "price", selectedProposal.price);
+            Json.put(request, "supportsPrivacy", selectedProposal.supportsPrivacy);
+        }
+        Json.put(request, "site", existingSite);
+        return request;
+    }
+
+    private void applyCartResponse(int requestId, String mode, String domain, JSONObject response) {
+        if (requestId != cartRequestCount || !mode.equals(purchaseMode)) {
+            // A newer request, or a different purchase mode, owns the purchase screen now.
+            emit("staleCartResponseIgnored", "requestIndex", requestId, "mode", mode,
+                    "currentMode", purchaseMode);
+            return;
+        }
+        if (isErrorResponse(response)) {
+            applyCartError(mode, domain, Text.isBlank(errorMessage(response))
+                    ? "the domain could not be added to the cart" : errorMessage(response));
+            return;
+        }
+        cartToken = Text.first(response, new String[] { "checkoutToken", "checkout_token", "token", "cartToken" });
+        cartUrl = Text.first(response, new String[] { "checkoutUrl", "checkout_url", "url" });
+        cartEmail = Text.first(response, new String[] { "email", "userEmail", "user_email", "ownerEmail" });
+        planRequired = requiresPlan(response, mode);
+        cartState = CART_COMPLETED;
+        cartProgress = "completed:" + mode;
+        recordCartProgress();
+        checkoutScreenOpen = !planRequired;
+        screen = planRequired ? SCREEN_DOMAIN_PURCHASE : SCREEN_CHECKOUT;
+        destination = planRequired ? DESTINATION_PLANS : DESTINATION_CHECKOUT;
+        emit("cartCompleted", "mode", mode, "domain", domain, "checkoutToken", cartToken,
+                "planRequired", planRequired);
+        emit("navigate", "destination", destination, "mode", mode, "domain", domain,
+                "checkoutToken", cartToken, "checkoutUrl", cartUrl, "site", existingSite);
+        notifyObservers();
+    }
+
+    private void applyCartError(String mode, String domain, String message) {
+        cartState = CART_ERROR;
+        cartError = Text.orEmpty(message);
+        cartProgress = "error:" + mode;
+        recordCartProgress();
+        emit("cartFailed", "mode", mode, "domain", domain, "message", cartError, "navigated", false);
+        notifyObservers();
+    }
+
+    private void recordCartProgress() {
+        cartProgressHistory.add(cartProgress);
+        trim(cartProgressHistory);
+    }
+
+    private boolean requiresPlan(JSONObject response, String mode) {
+        if (Text.firstBoolean(response, new String[] {
+                "requiresPlan", "requires_plan", "planRequired", "plan_required", "eligibleForPlan",
+                "eligible_for_plan", "hasPlanRequirement" }, false)) {
+            return true;
+        }
+        if (backend != null && backend.isEligibleForPlan(response)) {
+            return true;
+        }
+        JSONArray plans = response.optJSONArray("eligiblePlans");
+        if (plans == null) {
+            plans = response.optJSONArray("eligible_plans");
+        }
+        return MODE_EXISTING_SITE.equals(mode) && plans != null && plans.length() > 0;
+    }
+
+    private void resetCart() {
+        cartState = CART_IDLE;
+        cartProgress = "";
+        cartError = "";
+        cartToken = "";
+        cartUrl = "";
+        cartEmail = "";
+        planRequired = false;
+        checkoutScreenOpen = false;
+    }
+
+    /** The domain the checkout screen is buying. */
+    public String checkoutDomain() {
+        if (selectedProposal != null && !Text.isBlank(selectedProposal.domain)) {
+            return selectedProposal.domain;
+        }
+        return pendingDomainForRefresh;
+    }
+
+    /** The owner email the checkout screen confirmed, when the cart already carried one. */
+    public String checkoutEmail() {
+        return cartEmail;
+    }
+
+    // ---------------------------------------------------------------- checkout result
+
+    /** Reopens the checkout of the current cart after the previous checkout screen closed. */
+    public void retryCheckout() {
+        if (cartState != CART_COMPLETED) {
+            retryCurrentScreen();
+            return;
+        }
+        checkoutScreenOpen = false;
+        screen = SCREEN_DOMAIN_PURCHASE;
+        openCheckout();
+    }
+
+    /** Opens the checkout of the created cart. */
+    public void openCheckout() {
+        if (cartState != CART_COMPLETED) {
+            checkoutState = CHECKOUT_ERROR;
+            checkoutError = "the checkout needs a completed cart";
+            emit("checkoutIgnored", "reason", checkoutError, "cartState", cartState);
+            notifyObservers();
+            return;
+        }
+        if (screen == SCREEN_CHECKOUT && checkoutScreenOpen) {
+            // The checkout of this cart is already on screen; nothing to navigate to again.
+            return;
+        }
+        checkoutScreenOpen = true;
+        purchaseScreenOpen = true;
+        screen = SCREEN_CHECKOUT;
+        destination = DESTINATION_CHECKOUT;
+        emit("navigate", "destination", DESTINATION_CHECKOUT, "checkoutToken", cartToken,
+                "checkoutUrl", cartUrl);
+        trace.add("DomainPageOwner.openCheckout()");
+        notifyObservers();
+    }
+
+    /** Production entry point: the typed result of the checkout activity. */
+    public void onCheckoutResult(Intent data, int resultCode) {
+        JSONObject payload = Json.object();
+        Json.put(payload, "resultCode", resultCode);
+        Json.put(payload, "domainName", checkoutDomain());
+        Json.put(payload, "email", checkoutEmail());
+        Json.put(payload, "canceled", data == null || data.getBooleanExtra(DomainCheckoutResult.EXTRA_CANCELED,
+                resultCode != Activity.RESULT_OK));
+        onCheckoutResult(DomainCheckoutResult.fromIntent(data, resultCode, checkoutDomain()), payload);
+    }
+
+    /** Production entry point for an already parsed checkout result. */
+    public void onCheckoutResult(DomainCheckoutResult result) {
+        onCheckoutResult(result, result == null ? null : result.toJson());
+    }
+
+    private void onCheckoutResult(JSONObject payload) {
+        JSONObject result = payload.optJSONObject("result");
+        if (result == null) {
+            result = payload.optJSONObject("checkoutResult");
+        }
+        if (result == null && hasCheckoutFields(payload)) {
+            result = payload;
+        }
+        onCheckoutResult(DomainCheckoutResult.fromJson(result), result == null ? payload : result);
+    }
+
+    private static boolean hasCheckoutFields(JSONObject payload) {
+        return payload.has(DomainCheckoutResult.EXTRA_DOMAIN_NAME)
+                || payload.has("domain_name")
+                || payload.has(DomainCheckoutResult.EXTRA_EMAIL)
+                || payload.has(DomainCheckoutResult.EXTRA_CANCELED)
+                || payload.has("cancelled");
+    }
+
+/**
+ * Records a checkout result that came back from the checkout screen.
+ *
+ * <p>A completed registration and a cancellation both close the purchase flow and return to All
+ * Domains, but only the completed one is a registration. A result that cannot be read at all is
+ * neither: it stays an error on the purchase screen, which keeps its cart so the checkout can be
+ * tried again.</p>
+ */
+    private void onCheckoutResult(DomainCheckoutResult result, JSONObject payload) {
+        trace.add("DomainPageOwner.onCheckoutResult()");
+        if (result == null) {
+            // An unusable result is neither a registration nor a cancellation, so the purchase
+            // screen keeps its cart and reports why the checkout did not complete.
+            checkoutState = CHECKOUT_ERROR;
+            checkoutOutcome = OUTCOME_ERROR;
+            checkoutError = DomainCheckoutResult.rejectionReason(payload);
+            checkoutScreenOpen = false;
+            purchaseScreenOpen = cartState == CART_COMPLETED;
+            emit("checkoutResultInvalid", "message", checkoutError, "completed", false);
+            notifyObservers();
+            return;
+        }
+        if (!Text.isBlank(cartToken) && cartToken.equals(lastAcceptedCartToken)
+                && result.isSameAs(lastAcceptedResult)) {
+            // The very same result for the very same cart is recorded once and navigates once.
+            emit("duplicateCheckoutResultIgnored",
+                    "domain", result.domainName,
+                    "canceled", result.cancelled,
+                    "registrations", checkoutCompletionCount);
+            returnToAllDomains();
+            notifyObservers();
+            return;
+        }
+        lastAcceptedResult = result;
+        lastAcceptedCartToken = cartToken;
+        lastCheckoutResult = payload == null ? result.toJson() : payload;
+        checkoutError = "";
+        checkoutResultCount++;
+        pendingDomainForRefresh = result.domainName;
+        listRefreshRequired = true;
+        if (result.isCanceled()) {
+            checkoutState = CHECKOUT_CANCELLED;
+            checkoutOutcome = OUTCOME_CANCELLED;
+            checkoutScreenOpen = false;
+            purchaseScreenOpen = false;
+            emit("checkoutCancelled", "domain", result.domainName, "email", result.email,
+                    "registered", false);
+        } else {
+            checkoutState = CHECKOUT_COMPLETED;
+            checkoutOutcome = OUTCOME_SUCCESS;
+            checkoutCompletionCount++;
+            // The registration belongs to this purchase attempt only.
+            registeredAttempt = purchaseAttempt;
+            checkoutScreenOpen = false;
+            purchaseScreenOpen = false;
+            emit("checkoutCompleted", "domain", result.domainName, "email", result.email,
+                    "registered", true, "purchaseAttempt", purchaseAttempt);
+        }
+        returnToAllDomains();
+        notifyObservers();
+    }
+
+    private void returnToAllDomains() {
+        screen = SCREEN_ALL_DOMAINS;
+        destination = DESTINATION_ALL_DOMAINS;
+        emit("navigate", "destination", DESTINATION_ALL_DOMAINS, "refreshRequired", listRefreshRequired,
+                "domain", pendingDomainForRefresh);
+    }
+
+    // ---------------------------------------------------------------- details web view
