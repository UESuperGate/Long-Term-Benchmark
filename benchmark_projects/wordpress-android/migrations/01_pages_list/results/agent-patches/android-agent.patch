@@ -0,0 +1,177 @@
+package org.wordpress.android.ui.pagesrs
+
+/**
+ * Status of a post/page as exposed by the pages service.
+ *
+ * The pages list is built on top of the shared post data layer, therefore the list only knows about the
+ * subset of statuses a page can be in.
+ */
+enum class PostStatus(val restValue: String, val titleKey: String) {
+    PUBLISHED("publish", "published"),
+    PRIVATE("private", "private"),
+    DRAFT("draft", "draft"),
+    PENDING("pending", "pending"),
+    SCHEDULED("future", "scheduled"),
+    TRASHED("trash", "trashed"),
+    UNKNOWN("unknown", "unknown");
+
+    /** Label rendered next to a page row. */
+    val displayLabel: String
+        get() = titleKey.replaceFirstChar { first -> first.uppercase() }
+
+    /** The tab this status belongs to, or `null` when the status is not listable. */
+    fun defaultTab(): PageRsListTab? = when (this) {
+        PUBLISHED, PRIVATE -> PageRsListTab.PUBLISHED
+        DRAFT, PENDING -> PageRsListTab.DRAFTS
+        SCHEDULED -> PageRsListTab.SCHEDULED
+        TRASHED -> PageRsListTab.TRASHED
+        UNKNOWN -> null
+    }
+
+    companion object {
+        /** Every status a page request can be built for, used by search which spans all tabs. */
+        val ALL_PAGE_STATUSES: List<PostStatus> = listOf(PUBLISHED, PRIVATE, DRAFT, PENDING, SCHEDULED, TRASHED)
+
+        fun fromRestValue(value: String?): PostStatus {
+            val normalized = value?.trim()?.lowercase().orEmpty()
+            return ALL_PAGE_STATUSES.firstOrNull { it.restValue == normalized || it.name.lowercase() == normalized }
+                ?: UNKNOWN
+        }
+    }
+}
+
+/**
+ * Entity the list is scoped to.
+ *
+ * The modern pages screen always requests [PAGES]; posts are a different screen with its own contract.
+ */
+enum class PostEndpointType(val restValue: String) {
+    POSTS("posts"),
+    PAGES("pages"),
+}
+
+/** Ordering applied to a page collection. */
+enum class PostListOrder(val restValue: String) {
+    TITLE("title"),
+    DATE("date"),
+}
+
+/** Direction of a page collection ordering. */
+enum class ListOrder(val restValue: String) {
+    ASC("asc"),
+    DESC("desc"),
+}
+
+/**
+ * Description of a single page collection request.
+ *
+ * This is the exact payload the pages service is queried with; keeping it a value makes the request
+ * inspectable by callers and by the store which has to be able to reproduce a query when a list reloads.
+ */
+data class PostListFilter(
+    val statuses: List<String>,
+    val orderBy: PostListOrder = PostListOrder.TITLE,
+    val order: ListOrder = ListOrder.ASC,
+    val pageSize: UInt = PageRsListTab.PAGE_SIZE,
+    val search: String = "",
+    val authorIds: List<Long> = emptyList(),
+) {
+    companion object {
+        fun forTab(
+            tab: PageRsListTab,
+            search: String = "",
+            authorIds: List<Long> = emptyList(),
+        ) = PostListFilter(
+            statuses = tab.pageStatuses().map(PostStatus::restValue),
+            orderBy = tab.orderBy(),
+            order = tab.order(),
+            pageSize = tab.pageSize,
+            search = search,
+            authorIds = authorIds,
+        )
+
+        /**
+         * Search is not scoped to a single tab: it spans every page status so that a query started from the
+         * drafts tab still finds published pages.
+         */
+        fun forSearch(
+            query: String,
+            authorIds: List<Long> = emptyList(),
+        ) = PostListFilter(
+            statuses = PostStatus.ALL_PAGE_STATUSES.map(PostStatus::restValue),
+            orderBy = PostListOrder.TITLE,
+            order = ListOrder.ASC,
+            pageSize = PageRsListTab.PAGE_SIZE,
+            search = query,
+            authorIds = authorIds,
+        )
+    }
+}
+
+/** A single page row as persisted by the store. */
+data class MetadataItem(
+    val remoteId: Long,
+    val siteId: Int,
+    val localId: Int = 0,
+    val title: String = "",
+    val status: PostStatus = PostStatus.UNKNOWN,
+    val parentId: Long = 0L,
+    val dateMillis: Long = 0L,
+    val featuredImageId: Long = 0L,
+    val authorId: Long = 0L,
+    val authorDisplayName: String? = null,
+    val hasPassword: Boolean = false,
+    val link: String? = null,
+)
+
+/** Paging information of an [ObservableMetadataCollection]. */
+data class ListInfo(
+    val page: UInt = 0u,
+    val pageCount: Int = 1,
+    val canLoadMore: Boolean = false,
+)
+
+/**
+ * A live collection of page rows.
+ *
+ * Collections are owned by whoever opened them and have to be [close]d when they become obsolete: the
+ * underlying store keeps change notifications alive until then.
+ */
+interface ObservableMetadataCollection {
+    /** Requests an up to date copy from the service. */
+    suspend fun refresh()
+
+    /** Returns the rows of the collection, applying ordering, paging and the active filters. */
+    suspend fun loadItems(): List<MetadataItem>
+
+    /** Paging information of the collection. */
+    suspend fun listInfo(): ListInfo
+
+    /** Releases the collection. Closing twice is a no-op. */
+    fun close()
+}
+
+/**
+ * Boundary used to open page collections.
+ *
+ * The application installs a concrete implementation at start-up; everything above only ever talks to
+ * [factory] so the store backed implementation can be swapped without touching the view model.
+ */
+interface CollectionLeaf {
+    val factory: (PostEndpointType, PostListFilter, UInt) -> ObservableMetadataCollection
+
+    companion object {
+        @Volatile
+        private var installed: CollectionLeaf? = null
+
+        /** The installed factory. */
+        val factory: (PostEndpointType, PostListFilter, UInt) -> ObservableMetadataCollection
+            get() = requireNotNull(installed) {
+                "CollectionLeaf.factory has not been installed by the application dependency factory"
+            }.factory
+
+        fun install(leaf: CollectionLeaf) {
+            installed = leaf
+        }
+    }
+}
