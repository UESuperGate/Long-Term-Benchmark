+package org.wordpress.android.ui.pagesrs
+
+/** Deepest indentation a page row may be rendered with. */
+private const val MAX_PAGE_INDENT = 3
+
+/**
+ * Turns loaded pages into the rows the pages list renders.
+ *
+ * The published tab is a page hierarchy and is therefore rendered depth first, with the homepage on top.
+ * Every other tab and every search result is a flat list: a search query has no meaningful hierarchy and
+ * flattening it keeps the result order stable while the query changes.
+ *
+ * Pages whose parent is not part of the loaded set are promoted to roots so that a truncated list never
+ * hides a page, and the visual indentation is capped so that deep trees stay readable.
+ */
+fun buildRows(
+    pages: List<PageRsUiModel>,
+    applyHierarchy: Boolean,
+    pageOnFront: Long,
+    pageForPosts: Long,
+): List<PageRsListItem> {
+    if (pages.isEmpty()) return emptyList()
+
+    val knownPages = pages.associateBy(PageRsUiModel::remoteId)
+    val ordered = if (applyHierarchy) {
+        flattenHierarchy(pages, pageOnFront)
+    } else {
+        pages
+    }
+
+    return ordered.map { page ->
+        PageRsListItem(
+            page = page,
+            indent = if (applyHierarchy) indentOf(page, knownPages) else 0,
+            thumbnailUrl = page.imageUrl,
+            statusLabel = page.status?.displayLabel.orEmpty(),
+            actions = computePageMenuActions(
+                status = page.status,
+                isHomepage = page.remoteId != 0L && page.remoteId == pageOnFront,
+                isPostsPage = page.remoteId != 0L && page.remoteId == pageForPosts,
+                hasPassword = page.hasPassword,
+                isBlazeEligibleSite = page.isBlazeEligible,
+                canManageHomepage = page.canManageHomepage,
+            ),
+        )
+    }
+}
+
+/**
+ * Actions a page offers.
+ *
+ * Eligibility is derived from the page and from the site: a homepage is the front door of the site and
+ * can therefore neither be moved away nor removed, and a trashed page can only be brought back or
+ * deleted for good.
+ */
+@Suppress("ReturnCount")
+fun computePageMenuActions(
+    status: PostStatus?,
+    isHomepage: Boolean,
+    isPostsPage: Boolean,
+    hasPassword: Boolean,
+    isBlazeEligibleSite: Boolean,
+    canManageHomepage: Boolean,
+): List<PageRsMenuAction> {
+    val resolvedStatus = status ?: return emptyList()
+
+    val actions = when (resolvedStatus) {
+        PostStatus.TRASHED -> listOf(
+            PageRsMenuAction.MOVE_TO_DRAFT,
+            PageRsMenuAction.DELETE_PERMANENTLY,
+        )
+
+        PostStatus.DRAFT, PostStatus.PENDING -> listOf(
+            PageRsMenuAction.VIEW_PAGE,
+            PageRsMenuAction.SET_PARENT,
+            PageRsMenuAction.PUBLISH_NOW,
+            PageRsMenuAction.COPY,
+            PageRsMenuAction.SHARE,
+            PageRsMenuAction.MOVE_TO_TRASH,
+        )
+
+        PostStatus.SCHEDULED -> listOf(
+            PageRsMenuAction.VIEW_PAGE,
+            PageRsMenuAction.SET_PARENT,
+            PageRsMenuAction.SHARE,
+            PageRsMenuAction.COPY,
+            PageRsMenuAction.MOVE_TO_DRAFT,
+            PageRsMenuAction.MOVE_TO_TRASH,
+        )
+
+        PostStatus.PUBLISHED, PostStatus.PRIVATE -> buildList {
+            add(PageRsMenuAction.VIEW_PAGE)
+            add(PageRsMenuAction.COPY)
+            add(PageRsMenuAction.SET_PARENT)
+            add(PageRsMenuAction.SHARE)
+            if (canManageHomepage && !isHomepage) add(PageRsMenuAction.SET_AS_HOMEPAGE)
+            if (canManageHomepage && !isPostsPage) add(PageRsMenuAction.SET_AS_POSTS_PAGE)
+            if (!isHomepage) {
+                add(PageRsMenuAction.MOVE_TO_DRAFT)
+                add(PageRsMenuAction.MOVE_TO_TRASH)
+            }
+            // A password protected page cannot be promoted to a marketing site.
+            if (isBlazeEligibleSite && !isHomepage && !hasPassword) add(PageRsMenuAction.PROMOTE_WITH_BLAZE)
+        }
+
+        PostStatus.UNKNOWN -> emptyList()
+    }
+
+    return actions.distinct().sortedWith(
+        compareBy(PageRsMenuAction::group, PageRsMenuAction::positionInGroup),
+    )
+}
+
+/**
+ * Depth first ordering of the loaded pages.
+ *
+ * Parents are emitted before their children, the homepage is pulled to the top and every page is emitted
+ * exactly once, including pages that are only reachable through a parent which is not part of the list.
+ */
+private fun flattenHierarchy(pages: List<PageRsUiModel>, pageOnFront: Long): List<PageRsUiModel> {
+    val knownIds = pages.mapTo(HashSet(pages.size), PageRsUiModel::remoteId)
+    val childrenByParent = pages.groupBy(PageRsUiModel::parentId)
+
+    val roots = pages
+        .filter { page ->
+            page.parentId == 0L || page.parentId == page.remoteId || page.parentId !in knownIds
+        }
+        .sortedBy { page -> if (page.remoteId != 0L && page.remoteId == pageOnFront) 0 else 1 }
+
+    val ordered = ArrayList<PageRsUiModel>(pages.size)
+    val visited = HashSet<Long>(pages.size)
+
+    fun visit(page: PageRsUiModel) {
+        if (!visited.add(page.remoteId)) return
+        ordered += page
+        childrenByParent[page.remoteId].orEmpty().forEach { child -> visit(child) }
+    }
+
+    roots.forEach { root -> visit(root) }
+    // Pages that are part of a cycle with their ancestors still have to be shown.
+    pages.forEach { page -> visit(page) }
+
+    return ordered
+}
+
+/** Visual depth of a page, capped so that deep hierarchies stay readable. */
+private fun indentOf(page: PageRsUiModel, knownPages: Map<Long, PageRsUiModel>): Int {
+    val seen = HashSet<Long>()
+    seen += page.remoteId
+
+    var level = 0
+    var current = page
+    while (level < MAX_PAGE_INDENT) {
+        val parentId = current.parentId
+        if (parentId == 0L || parentId == current.remoteId) break
+        val parent = knownPages[parentId] ?: break
+        if (!seen.add(parent.remoteId)) break
+        current = parent
+        level += 1
+    }
+    return level
+}
