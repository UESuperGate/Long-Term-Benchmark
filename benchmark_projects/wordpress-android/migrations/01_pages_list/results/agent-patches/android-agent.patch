+package org.wordpress.android.ui.pagesrs
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Resolves which pages a site uses as its homepage and as its posts page.
+ *
+ * The settings decide which actions a page may offer, therefore they are resolved before the list is
+ * rendered and refreshed whenever a page action changes them.
+ */
+internal class PageRsHomepageSettings(
+    private val wpApiClientProvider: WpApiClientProvider,
+    private val dispatcher: Dispatcher,
+) {
+    /** Site homepage settings relevant to the pages list. */
+    data class Settings(
+        val pageOnFront: Long = 0L,
+        val pageForPosts: Long = 0L,
+        val showOnFront: String = SiteModel.SHOW_ON_FRONT_POSTS,
+    ) {
+        fun canManageHomepage(): Boolean = showOnFront == SiteModel.SHOW_ON_FRONT_PAGE
+    }
+
+    private val _settings = MutableStateFlow(Settings())
+    val settings: StateFlow<Settings> = _settings.asStateFlow()
+
+    /** Reads the current settings from the service and caches them. */
+    suspend fun load(site: SiteModel): Settings = dispatcher.dispatch {
+        val payload = wpApiClientProvider.getWpApiClient(site).fetchHomepageSettings(site)
+        val resolved = if (payload.pageOnFront != 0L) {
+            Settings(payload.pageOnFront, payload.pageForPosts, payload.showOnFront)
+        } else {
+            Settings(site.pageOnFront, site.pageForPosts, site.showOnFront)
+        }
+        _settings.value = resolved
+        resolved
+    }
+
+    /** Uses [pageId] as the site homepage. */
+    suspend fun setPageOnFront(site: SiteModel, pageId: Long): Settings = dispatcher.dispatch {
+        val payload = wpApiClientProvider.getWpApiClient(site).updatePageOnFront(site, pageId)
+        val resolved = Settings(
+            pageOnFront = if (payload.pageOnFront != 0L) payload.pageOnFront else pageId,
+            pageForPosts = payload.pageForPosts,
+            showOnFront = if (payload.showOnFront.isNotBlank()) {
+                payload.showOnFront
+            } else {
+                SiteModel.SHOW_ON_FRONT_PAGE
+            },
+        )
+        _settings.value = resolved
+        resolved
+    }
+
+    /** Uses [pageId] as the page the site posts are displayed on. */
+    suspend fun setPageForPosts(site: SiteModel, pageId: Long): Settings = dispatcher.dispatch {
+        val payload = wpApiClientProvider.getWpApiClient(site).updatePageForPosts(site, pageId)
+        val resolved = _settings.value.copy(
+            pageOnFront = payload.pageOnFront,
+            pageForPosts = if (payload.pageForPosts != 0L) payload.pageForPosts else pageId,
+        )
+        _settings.value = resolved
+        resolved
+    }
+
+    /** Restores the cached settings, e.g. after the screen has been recreated. */
+    fun restore(site: SiteModel) {
+        if (_settings.value.pageOnFront == 0L) {
+            _settings.value = Settings(site.pageOnFront, site.pageForPosts, site.showOnFront)
+        }
+    }
+}
