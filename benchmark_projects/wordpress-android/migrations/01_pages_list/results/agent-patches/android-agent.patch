@@ -0,0 +1,801 @@
+package org.wordpress.android.ui.pagesrs
+
+import androidx.lifecycle.ViewModel
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
+
+/**
+ * State holder of the modern pages screen.
+ *
+ * The view model owns the four tab collections, the search collection and the author filter, and it is
+ * the only place where a request is created: the screen renders what the view model reduced.
+ */
+internal class PagesRsListViewModel(
+    private val selectedSiteRepository: SelectedSiteRepository,
+    private val serviceProvider: WpServiceProvider,
+    private val dispatcher: Dispatcher,
+    private val restClient: PostRsRestClient,
+    private val resourceProvider: ResourceProvider,
+    private val postStore: PostStore,
+    private val homepageSettings: PageRsHomepageSettings,
+    private val blazeFeatureUtils: BlazeFeatureUtils,
+    private val fluxCBridge: PageRsFluxCBridge,
+    private val networkUtilsWrapper: NetworkUtilsWrapper,
+    private val accountStore: AccountStore,
+    private val appPrefsWrapper: AppPrefsWrapper,
+    private val analyticsTracker: AnalyticsTrackerWrapper,
+) : ViewModel() {
+    private val scope = CoroutineScope(SupervisorJob() + dispatcher.defaultDispatcher)
+
+    private val _tabStates = MutableStateFlow(initialTabStates())
+    val tabStates = _tabStates.asStateFlow()
+
+    private val _isSearchActive = MutableStateFlow(false)
+    val isSearchActive = _isSearchActive.asStateFlow()
+
+    private val _searchQuery = MutableStateFlow("")
+    val searchQuery = _searchQuery.asStateFlow()
+
+    private val _searchState = MutableStateFlow<PageTabUiState>(PageTabUiState.Ready(emptyList()))
+    val searchState = _searchState.asStateFlow()
+
+    private val _searchPages = MutableStateFlow<List<PageRsUiModel>>(emptyList())
+
+    private val _authorFilter = MutableStateFlow(AuthorFilterSelection.DEFAULT)
+    val authorFilter = _authorFilter.asStateFlow()
+
+    private val _isAuthorFilterVisible = MutableStateFlow(false)
+    val isAuthorFilterVisible = _isAuthorFilterVisible.asStateFlow()
+
+    private val _pendingConfirmation = MutableStateFlow<PageRsListConfirmation?>(null)
+    val pendingConfirmation = _pendingConfirmation.asStateFlow()
+
+    private val _snackbarMessages = MutableSharedFlow<SnackbarMessage>(
+        extraBufferCapacity = SNACKBAR_BUFFER,
+    )
+    val snackbarMessages: Flow<SnackbarMessage> = _snackbarMessages
+
+    private val _editorRequests = MutableSharedFlow<PageRsEditorRequest>(extraBufferCapacity = REQUEST_BUFFER)
+    val editorRequests: Flow<PageRsEditorRequest> = _editorRequests
+
+    private val _navigationRequests =
+        MutableSharedFlow<PageRsNavigationRequest>(extraBufferCapacity = REQUEST_BUFFER)
+    val navigationRequests: Flow<PageRsNavigationRequest> = _navigationRequests
+
+    private val _renderedPages = MutableStateFlow<List<PageRsUiModel>>(emptyList())
+    val renderedPages = _renderedPages.asStateFlow()
+
+    private val _renderedRows = MutableStateFlow<List<PageRsListItem>>(emptyList())
+    val renderedRows = _renderedRows.asStateFlow()
+
+    private val _renderedMenuActions = MutableStateFlow<Map<Long, List<PageRsMenuAction>>>(emptyMap())
+    val renderedMenuActions = _renderedMenuActions.asStateFlow()
+
+    private val _siteContext = MutableStateFlow(PageRsSiteContext(SiteModel(), 0L, 0L, false, false))
+
+    private var site: SiteModel? = null
+    private var siteResolved = false
+    private var activeTab = PageRsListTab.PUBLISHED
+
+    private val stateLock = Any()
+    private val tabJobs = mutableMapOf<PageRsListTab, Job>()
+    private val tabGenerations = mutableMapOf<PageRsListTab, Int>()
+    private var searchGeneration = 0
+    private var searchJob: Job? = null
+    private var actionJob: Job? = null
+    private var mediaJob: Job? = null
+    private var homepageJob: Job? = null
+    private var lastFailedConfirmation: PageRsListConfirmation? = null
+
+    private val tabCollections = mutableMapOf<PageRsListTab, ObservableMetadataCollection>()
+    private var searchCollection: ObservableMetadataCollection? = null
+    private val resolvedMediaIds = mutableSetOf<Long>()
+
+    // region public screen events
+
+    /** Opens [tab] through the normal Pages entry and loads its pages. */
+    fun initTab(tab: PageRsListTab) {
+        resolveSite()
+        val tabChanged = activeTab != tab
+        activeTab = tab
+        if (tabChanged) trackTabPressed(tab)
+        if (_isSearchActive.value) {
+            // Opening a tab always returns to the tab list.
+            resetSearchState()
+        }
+        loadTab(tab, isUserRefresh = false)
+    }
+
+    /** Reloads [tab]; the retry affordance of a failed request runs exactly the same body. */
+    fun refreshTab(tab: PageRsListTab, isUserRefresh: Boolean = false) {
+        resolveSite()
+        loadTab(tab, isUserRefresh)
+    }
+
+    /** Enters search mode; the search field is usable right away. */
+    fun onSearchOpen() {
+        resolveSite()
+        if (_isSearchActive.value) return
+
+        searchJob?.cancel()
+        closeSearchCollection()
+        nextSearchGeneration()
+        _isSearchActive.value = true
+        resetSearchState()
+        site?.let { analyticsTracker.track(PagesRsAnalyticsStats.PAGES_SEARCH_ACCESSED, it) }
+    }
+
+    /** Applies a new search query, dispatching at most one request per settled query. */
+    fun onSearchQueryChanged(query: String, activeTab: PageRsListTab) {
+        resolveSite()
+        this.activeTab = activeTab
+        _searchQuery.value = query
+
+        searchJob?.cancel()
+        val trimmed = query.trim()
+        if (trimmed.length < MIN_SEARCH_QUERY_LENGTH) {
+            // Not enough input: the result area stays empty and the service is never asked.
+            closeSearchCollection()
+            nextSearchGeneration()
+            _searchPages.value = emptyList()
+            _searchState.value = PageTabUiState.Ready(emptyList())
+            render()
+            return
+        }
+
+        val currentSite = site ?: return
+        val generation = nextSearchGeneration()
+        searchJob = scope.launch {
+            delay(SEARCH_DEBOUNCE_MS)
+            if (!isActiveSearch(generation)) return@launch
+            loadSearchResults(currentSite, trimmed, generation)
+        }
+    }
+
+    /** Leaves search mode and restores [activeTab]. */
+    fun onSearchClose(activeTab: PageRsListTab) {
+        searchJob?.cancel()
+        // The obsolete search collection is closed before the tab it replaced is reloaded.
+        closeSearchCollection()
+        nextSearchGeneration()
+        _isSearchActive.value = false
+        resetSearchState()
+        initTab(activeTab)
+    }
+
+    /** Persists a new author filter and reloads the list with the new author. */
+    fun onAuthorFilterChanged(
+        selection: AuthorFilterSelection,
+        activeTab: PageRsListTab,
+    ) {
+        resolveSite()
+        val currentSite = site ?: return
+        this.activeTab = activeTab
+        if (!currentSite.isAuthorFilterSupported) return
+
+        _authorFilter.value = selection
+        appPrefsWrapper.postListAuthorSelection = selection
+        analyticsTracker.track(
+            PagesRsAnalyticsStats.PAGES_LIST_AUTHOR_FILTER_CHANGED,
+            currentSite,
+            mapOf("author_filter_selection" to selection.key),
+        )
+
+        // The author is part of the query, therefore the collections holding the previous query are
+        // obsolete and are closed before their replacements are opened.
+        closeTabCollection(activeTab)
+        searchJob?.cancel()
+        closeSearchCollection()
+
+        val query = _searchQuery.value.trim()
+        if (_isSearchActive.value && query.length >= MIN_SEARCH_QUERY_LENGTH) {
+            val generation = nextSearchGeneration()
+            searchJob = scope.launch {
+                delay(SEARCH_DEBOUNCE_MS)
+                if (!isActiveSearch(generation)) return@launch
+                loadSearchResults(currentSite, query, generation)
+            }
+        } else {
+            loadTab(activeTab, isUserRefresh = false)
+        }
+        render()
+    }
+
+    /** Opens a page through the existing editor bridge. */
+    fun openPage(remotePageId: Long, tab: PageRsListTab) {
+        resolveSite()
+        activeTab = tab
+        val currentSite = site ?: return
+        val page = findPage(remotePageId)
+        if (page == null) {
+            emitSnackbar(SnackbarMessage(string(PagesRsStrings.PAGES_OPEN_ERROR)))
+            return
+        }
+        val settings = homepageSettings.settings.value
+        if (page.remoteId != 0L && page.remoteId == settings.pageForPosts) {
+            emitSnackbar(SnackbarMessage(string(PagesRsStrings.PAGES_IS_POSTS_PAGE_WARNING)))
+            return
+        }
+        _editorRequests.tryEmit(PageRsEditorRequest(currentSite.id, page.remoteId, page.localId))
+    }
+
+    /** Handles a menu action; state changing and destructive actions only raise a confirmation. */
+    fun onPageMenuAction(remotePageId: Long, action: PageRsMenuAction) {
+        resolveSite()
+        val page = findPage(remotePageId) ?: return
+        analyticsTracker.track(
+            PagesRsAnalyticsStats.PAGES_OPTIONS_PRESSED,
+            site,
+            mapOf("option_name" to action.key),
+        )
+
+        val confirmation = PageRsListConfirmation.forAction(action, page)
+        if (confirmation != null) {
+            _pendingConfirmation.value = confirmation
+            return
+        }
+
+        when (action) {
+            PageRsMenuAction.VIEW_PAGE -> openPage(remotePageId, activeTab)
+            PageRsMenuAction.SET_PARENT -> _navigationRequests.tryEmit(PageRsNavigationRequest.SetParent(page))
+            PageRsMenuAction.COPY -> _navigationRequests.tryEmit(PageRsNavigationRequest.Copy(page))
+            PageRsMenuAction.SHARE -> _navigationRequests.tryEmit(PageRsNavigationRequest.Share(page))
+            PageRsMenuAction.PROMOTE_WITH_BLAZE -> {
+                blazeFeatureUtils.trackEntryPointTapped(BlazeFlowSource.PAGES_LIST)
+                _navigationRequests.tryEmit(PageRsNavigationRequest.PromoteWithBlaze(page))
+            }
+            else -> Unit
+        }
+    }
+
+    /** Runs the confirmed page mutation. */
+    fun onConfirmPendingAction() {
+        val confirmation = _pendingConfirmation.value ?: return
+        _pendingConfirmation.value = null
+        performConfirmation(confirmation)
+    }
+
+    /** Runs the action a snackbar offers, e.g. retrying a failed mutation or a failed load. */
+    fun onSnackbarAction(action: SnackbarAction?) {
+        when (action) {
+            null -> Unit
+            is SnackbarAction.RetryPageAction -> {
+                val failed = lastFailedConfirmation
+                if (failed != null && failed.pageId == action.pageId && failed.action == action.action) {
+                    // The retry targets the very same page identity.
+                    performConfirmation(failed)
+                }
+            }
+            SnackbarAction.RetryListAction -> refreshTab(activeTab, isUserRefresh = true)
+        }
+    }
+
+    // endregion
+
+    // region rendering
+
+    /** Pages currently backing the rendered list. */
+    private fun currentPages(): List<PageRsUiModel> =
+        if (_isSearchActive.value) _searchPages.value else _tabStates.value[activeTab]?.pages.orEmpty()
+
+    /**
+     * Rebuilds the rendered rows from the current state.
+     *
+     * The published tab is rendered as a hierarchy, everything else stays flat.
+     */
+    private fun render() {
+        val context = _siteContext.value
+        val pages = currentPages()
+        val rows = buildRows(
+            pages = pages,
+            applyHierarchy = !_isSearchActive.value && activeTab.isHierarchyEnabled(),
+            pageOnFront = context.pageOnFront,
+            pageForPosts = context.pageForPosts,
+        )
+        _renderedPages.value = pages
+        _renderedRows.value = rows
+        _renderedMenuActions.value = rows.associate { row -> row.page.remoteId to row.actions }
+    }
+
+    fun renderedRowFor(remotePageId: Long): PageRsListItem? =
+        _renderedRows.value.firstOrNull { row -> row.page.remoteId == remotePageId }
+
+    fun menuActionsFor(remotePageId: Long): List<PageRsMenuAction> =
+        _renderedMenuActions.value[remotePageId].orEmpty()
+
+    fun tabState(tab: PageRsListTab): PageTabUiState = _tabStates.value[tab] ?: PageTabUiState.Loading()
+
+    fun currentTab(): PageRsListTab = activeTab
+
+    fun homepagePageOnFront(): Long = _siteContext.value.pageOnFront
+
+    fun homepagePageForPosts(): Long = _siteContext.value.pageForPosts
+
+    // endregion
+
+    // region loading
+
+    private fun loadTab(tab: PageRsListTab, isUserRefresh: Boolean) {
+        val currentSite = site ?: return
+        val generation = nextTabGeneration(tab)
+        tabJobs[tab]?.cancel()
+        closeTabCollection(tab)
+
+        // The state is reduced before the request starts, so the tab never stays on a stale state.
+        reduceTabState(tab) { previous ->
+            if (previous.pages.isEmpty()) PageTabUiState.Loading() else PageTabUiState.Refreshing(previous.pages)
+        }
+        render()
+
+        tabJobs[tab] = scope.launch {
+            val request = pageRequestForTab(tab)
+            val collection = CloseGuard(fluxCBridge.openCollection(request))
+            setTabCollection(tab, collection)
+            try {
+                val pages = fluxCBridge.loadPages(request, currentSite, _siteContext.value, collection)
+                if (!isCurrentTabGeneration(tab, generation)) return@launch
+                reduceTabState(tab) { PageTabUiState.Ready(pages) }
+                render()
+                resolveFeaturedImages(pages, tab, generation)
+            } catch (cancellation: CancellationException) {
+                throw cancellation
+            } catch (error: Throwable) {
+                if (!isCurrentTabGeneration(tab, generation)) return@launch
+                // The rows that were loaded before stay visible, the failure is represented by the state.
+                reduceTabState(tab) { previous ->
+                    PageTabUiState.Error(
+                        pages = previous.pages,
+                        errorMessage = messageOf(error, PagesRsStrings.PAGES_ERROR_LOADING),
+                    )
+                }
+                render()
+                if (isUserRefresh) {
+                    emitSnackbar(SnackbarMessage(string(PagesRsStrings.PAGES_ERROR_LOADING)))
+                }
+            } finally {
+                closeTabCollection(tab, collection)
+            }
+        }
+    }
+
+    private suspend fun loadSearchResults(
+        currentSite: SiteModel,
+        query: String,
+        generation: Int,
+    ) {
+        closeSearchCollection()
+        val request = searchRequest(query)
+        val collection = CloseGuard(fluxCBridge.openCollection(request))
+        setSearchCollection(collection)
+        _searchState.value = PageTabUiState.Refreshing(_searchPages.value)
+
+        try {
+            val pages = fluxCBridge.loadPages(request, currentSite, _siteContext.value, collection)
+            if (!isActiveSearch(generation)) return
+            _searchPages.value = pages
+            _searchState.value = PageTabUiState.Ready(pages)
+            render()
+            resolveFeaturedImages(pages, null, generation)
+        } catch (cancellation: CancellationException) {
+            throw cancellation
+        } catch (error: Throwable) {
+            if (!isActiveSearch(generation)) return
+            _searchState.value = PageTabUiState.Error(
+                pages = _searchPages.value,
+                errorMessage = messageOf(error, PagesRsStrings.PAGES_ERROR_LOADING),
+            )
+            render()
+        } finally {
+            closeSearchCollection(collection)
+        }
+    }
+
+    private fun pageRequestForTab(tab: PageRsListTab) = PageListRequest(
+        endpointType = PostEndpointType.PAGES,
+        filter = PostListFilter.forTab(tab, authorIds = authorIdsFor(_authorFilter.value)),
+    )
+
+    private fun searchRequest(query: String) = PageListRequest(
+        endpointType = PostEndpointType.PAGES,
+        filter = PostListFilter.forSearch(query, authorIds = authorIdsFor(_authorFilter.value)),
+    )
+
+    /**
+     * Resolves featured images of pages that do not have one yet.
+     *
+     * Media is decoration: a slow or failing media call never removes the page row.
+     */
+    private fun resolveFeaturedImages(pages: List<PageRsUiModel>, tab: PageRsListTab?, generation: Int) {
+        val currentSite = site ?: return
+        val known = synchronized(stateLock) { resolvedMediaIds.toSet() }
+        val missing = pages.asSequence()
+            .map(PageRsUiModel::featuredImageId)
+            .filter { featuredImageId -> featuredImageId != 0L && featuredImageId !in known }
+            .distinct()
+            .toList()
+        if (missing.isEmpty()) return
+
+        mediaJob?.cancel()
+        mediaJob = scope.launch {
+            val urls = try {
+                restClient.fetchMediaUrls(currentSite, missing, FEATURED_IMAGE_THUMBNAIL_SIZE)
+            } catch (cancellation: CancellationException) {
+                throw cancellation
+            } catch (_: Throwable) {
+                emptyMap()
+            }
+            if (urls.isEmpty()) return@launch
+            synchronized(stateLock) { resolvedMediaIds += missing }
+
+            if (tab != null) {
+                if (!isCurrentTabGeneration(tab, generation)) return@launch
+                reduceTabState(tab) { state -> state.withPages(fluxCBridge.applyImageUrls(state.pages, urls)) }
+            } else {
+                if (!isActiveSearch(generation)) return@launch
+                _searchPages.update { pages -> fluxCBridge.applyImageUrls(pages, urls) }
+            }
+            render()
+        }
+    }
+
+    // endregion
+
+    // region page actions
+
+    private fun performConfirmation(confirmation: PageRsListConfirmation) {
+        val currentSite = site ?: return
+        if (!networkUtilsWrapper.isNetworkAvailable()) {
+            lastFailedConfirmation = confirmation
+            emitSnackbar(retryMessage(confirmation, string(PagesRsStrings.PAGES_ERROR_NO_NETWORK)))
+            return
+        }
+
+        actionJob?.cancel()
+        actionJob = scope.launch {
+            try {
+                when (confirmation) {
+                    is PageRsListConfirmation.SetAsHomepage ->
+                        applyHomepageSettings(homepageSettings.setPageOnFront(currentSite, confirmation.pageId))
+
+                    is PageRsListConfirmation.SetAsPostsPage ->
+                        applyHomepageSettings(homepageSettings.setPageForPosts(currentSite, confirmation.pageId))
+
+                    else -> dispatcher.dispatch { applyPageMutation(currentSite, confirmation) }
+                }
+                lastFailedConfirmation = null
+                applyMutationToRenderedState(confirmation)
+                render()
+                emitSnackbar(SnackbarMessage(successMessageFor(confirmation)))
+            } catch (cancellation: CancellationException) {
+                throw cancellation
+            } catch (error: Throwable) {
+                // The page is left untouched so it can be retried with the same identity.
+                lastFailedConfirmation = confirmation
+                emitSnackbar(retryMessage(confirmation, messageOf(error, failureMessageFor(confirmation))))
+                render()
+            }
+        }
+    }
+
+    private suspend fun applyPageMutation(currentSite: SiteModel, confirmation: PageRsListConfirmation) {
+        val service = serviceProvider.getWpService(currentSite)
+        val siteId = service.site.id
+        val pageId = confirmation.pageId
+        val postService = service.postService
+
+        when (confirmation) {
+            is PageRsListConfirmation.MoveToTrash -> {
+                postService.trashPost(PostEndpointType.PAGES, pageId)
+                postStore.updatePageStatus(siteId, pageId, PostStatus.TRASHED)
+            }
+
+            is PageRsListConfirmation.DeletePermanently -> {
+                postService.deletePost(PostEndpointType.PAGES, pageId)
+                postStore.deletePage(siteId, pageId)
+            }
+
+            is PageRsListConfirmation.MoveToDraft -> {
+                postService.updatePostStatus(PostEndpointType.PAGES, pageId, PostStatus.DRAFT)
+                postStore.updatePageStatus(siteId, pageId, PostStatus.DRAFT)
+            }
+
+            is PageRsListConfirmation.PublishNow -> {
+                postService.updatePostStatus(PostEndpointType.PAGES, pageId, PostStatus.PUBLISHED)
+                postStore.updatePageStatus(siteId, pageId, PostStatus.PUBLISHED)
+            }
+
+            is PageRsListConfirmation.SetAsHomepage, is PageRsListConfirmation.SetAsPostsPage -> Unit
+        }
+    }
+
+    private fun applyMutationToRenderedState(confirmation: PageRsListConfirmation) {
+        val pageId = confirmation.pageId
+        val newStatus = when (confirmation) {
+            is PageRsListConfirmation.MoveToTrash -> PostStatus.TRASHED
+            is PageRsListConfirmation.DeletePermanently -> null
+            is PageRsListConfirmation.MoveToDraft -> PostStatus.DRAFT
+            is PageRsListConfirmation.PublishNow -> PostStatus.PUBLISHED
+            else -> null
+        }
+
+        if (newStatus == null) {
+            _searchPages.update { pages -> pages.filterNot { page -> page.remoteId == pageId } }
+            _tabStates.update { states ->
+                states.mapValues { (_, state) -> state.withPages(state.pages.filterNot { it.remoteId == pageId }) }
+            }
+            return
+        }
+
+        _searchPages.update { pages -> pages.map { page -> if (page.remoteId == pageId) page.copy(status = newStatus) else page } }
+        _tabStates.update { states ->
+            states.mapValues { (tab, state) ->
+                when {
+                    state.pages.none { page -> page.remoteId == pageId } -> state
+                    tab.pageStatuses().contains(newStatus) -> state.withPages(
+                        state.pages.map { page ->
+                            if (page.remoteId == pageId) page.copy(status = newStatus) else page
+                        },
+                    )
+
+                    else -> state.withPages(state.pages.filterNot { page -> page.remoteId == pageId })
+                }
+            }
+        }
+    }
+
+    private fun applyHomepageSettings(settings: PageRsHomepageSettings.Settings) {
+        val currentSite = site ?: return
+        _siteContext.value = PageRsSiteContext(
+            site = currentSite,
+            pageOnFront = settings.pageOnFront,
+            pageForPosts = settings.pageForPosts,
+            canManageHomepage = settings.canManageHomepage(),
+            isBlazeEligible = blazeFeatureUtils.isBlazeEligibleSite(currentSite),
+        )
+        // Page identity is untouched, only the site derived flags of the rendered rows change.
+        _searchPages.update { pages -> pages.map(::applySiteContext) }
+        _tabStates.update { states ->
+            states.mapValues { (_, state) -> state.withPages(state.pages.map(::applySiteContext)) }
+        }
+        render()
+    }
+
+    private fun applySiteContext(page: PageRsUiModel): PageRsUiModel {
+        val context = _siteContext.value
+        return page.copy(
+            isHomepage = page.remoteId != 0L && page.remoteId == context.pageOnFront,
+            isPostsPage = page.remoteId != 0L && page.remoteId == context.pageForPosts,
+            canManageHomepage = context.canManageHomepage,
+            isBlazeEligible = context.isBlazeEligible,
+        )
+    }
+
+    private fun successMessageFor(confirmation: PageRsListConfirmation): String = when (confirmation) {
+        is PageRsListConfirmation.MoveToTrash -> string(PagesRsStrings.PAGES_MOVED_TO_TRASH)
+        is PageRsListConfirmation.DeletePermanently -> string(PagesRsStrings.PAGES_DELETED_PERMANENTLY)
+        is PageRsListConfirmation.MoveToDraft -> string(PagesRsStrings.PAGES_MOVED_TO_DRAFT)
+        is PageRsListConfirmation.PublishNow -> string(PagesRsStrings.PAGES_PUBLISHED)
+        is PageRsListConfirmation.SetAsHomepage -> string(PagesRsStrings.PAGES_HOMEPAGE_UPDATED)
+        is PageRsListConfirmation.SetAsPostsPage -> string(PagesRsStrings.PAGES_POSTS_PAGE_UPDATED)
+    }
+
+    private fun failureMessageFor(confirmation: PageRsListConfirmation): Int = when (confirmation) {
+        is PageRsListConfirmation.MoveToTrash -> PagesRsStrings.PAGES_TRASH_FAILED
+        else -> PagesRsStrings.PAGES_ACTION_FAILED
+    }
+
+    private fun retryMessage(confirmation: PageRsListConfirmation, message: String) = SnackbarMessage(
+        message = message,
+        actionLabel = string(PagesRsStrings.ACTION_RETRY),
+        action = SnackbarAction.RetryPageAction(confirmation.pageId, confirmation.action),
+    )
+
+    // endregion
+
+    // region site, author filter and preferences
+
+    private fun resolveSite() {
+        if (siteResolved) return
+        val currentSite = selectedSiteRepository.getSelectedSite() ?: return
+        siteResolved = true
+        site = currentSite
+        homepageSettings.restore(currentSite)
+        _siteContext.value = PageRsSiteContext(
+            site = currentSite,
+            pageOnFront = currentSite.pageOnFront,
+            pageForPosts = currentSite.pageForPosts,
+            canManageHomepage = currentSite.showOnFront == SiteModel.SHOW_ON_FRONT_PAGE,
+            isBlazeEligible = blazeFeatureUtils.isBlazeEligibleSite(currentSite),
+        )
+        _isAuthorFilterVisible.value = currentSite.isAuthorFilterSupported
+        _authorFilter.value = restoreAuthorSelection()
+        loadHomepageSettings(currentSite)
+    }
+
+    private fun loadHomepageSettings(currentSite: SiteModel) {
+        homepageJob?.cancel()
+        homepageJob = scope.launch {
+            val settings = withTimeoutOrNull(HOMEPAGE_SETTINGS_TIMEOUT_MS) {
+                try {
+                    homepageSettings.load(currentSite)
+                } catch (_: Throwable) {
+                    null
+                }
+            }
+            if (settings != null) applyHomepageSettings(settings)
+        }
+    }
+
+    private fun restoreAuthorSelection(): AuthorFilterSelection {
+        val currentSite = site ?: return AuthorFilterSelection.EVERYONE
+        return if (currentSite.isAuthorFilterSupported) {
+            appPrefsWrapper.postListAuthorSelection
+        } else {
+            AuthorFilterSelection.EVERYONE
+        }
+    }
+
+    private fun authorIdsFor(selection: AuthorFilterSelection): List<Long> = when (selection) {
+        AuthorFilterSelection.EVERYONE -> emptyList()
+        // The identifier always comes from the signed in account, never from the persisted value.
+        AuthorFilterSelection.ME -> listOfNotNull(accountStore.account?.userId)
+        is AuthorFilterSelection.Specific -> listOf(selection.authorId)
+    }
+
+    private fun trackTabPressed(tab: PageRsListTab) {
+        analyticsTracker.track(PagesRsAnalyticsStats.PAGES_TAB_PRESSED, site, mapOf("tab_name" to tab.key))
+    }
+
+    // endregion
+
+    // region state plumbing
+
+    private fun initialTabStates(): Map<PageRsListTab, PageTabUiState> =
+        PageRsListTab.ALL.associateWith { PageTabUiState.Loading() }
+
+    private fun reduceTabState(tab: PageRsListTab, transform: (PageTabUiState) -> PageTabUiState) {
+        _tabStates.update { states -> states + (tab to transform(states[tab] ?: PageTabUiState.Loading())) }
+    }
+
+    private fun resetSearchState() {
+        _searchQuery.value = ""
+        _searchPages.value = emptyList()
+        _searchState.value = PageTabUiState.Ready(emptyList())
+    }
+
+    private fun findPage(remotePageId: Long): PageRsUiModel? {
+        if (_isSearchActive.value) {
+            _searchPages.value.firstOrNull { page -> page.remoteId == remotePageId }?.let { return it }
+        }
+        _tabStates.value.values.forEach { state ->
+            state.pages.firstOrNull { page -> page.remoteId == remotePageId }?.let { return it }
+        }
+        return null
+    }
+
+    private fun nextTabGeneration(tab: PageRsListTab): Int = synchronized(stateLock) {
+        val next = (tabGenerations[tab] ?: 0) + 1
+        tabGenerations[tab] = next
+        next
+    }
+
+    private fun isCurrentTabGeneration(tab: PageRsListTab, generation: Int): Boolean =
+        synchronized(stateLock) { tabGenerations[tab] == generation }
+
+    private fun nextSearchGeneration(): Int = synchronized(stateLock) { ++searchGeneration }
+
+    private fun isActiveSearch(generation: Int): Boolean = synchronized(stateLock) { searchGeneration == generation }
+
+    private fun setTabCollection(tab: PageRsListTab, collection: ObservableMetadataCollection) {
+        synchronized(stateLock) { tabCollections[tab] = collection }
+    }
+
+    private fun setSearchCollection(collection: ObservableMetadataCollection) {
+        synchronized(stateLock) { searchCollection = collection }
+    }
+
+    private fun closeTabCollection(tab: PageRsListTab, collection: ObservableMetadataCollection? = null) {
+        val toClose = synchronized(stateLock) {
+            val current = tabCollections[tab]
+            if (current != null && (collection == null || current === collection)) {
+                tabCollections.remove(tab)
+                current
+            } else {
+                collection
+            }
+        }
+        toClose?.close()
+    }
+
+    private fun closeSearchCollection(collection: ObservableMetadataCollection? = null) {
+        val toClose = synchronized(stateLock) {
+            val current = searchCollection
+            if (current != null && (collection == null || current === collection)) {
+                searchCollection = null
+                current
+            } else {
+                collection
+            }
+        }
+        toClose?.close()
+    }
+
+    private fun emitSnackbar(message: SnackbarMessage) {
+        _snackbarMessages.tryEmit(message)
+    }
+
+    private fun string(resId: Int): String = resourceProvider.getString(resId)
+
+    private fun messageOf(@Suppress("UNUSED_PARAMETER") error: Throwable, resId: Int): String = string(resId)
+
+    // endregion
+
+    /** Releases everything the view model holds. */
+    override fun onCleared() {
+        synchronized(stateLock) {
+            tabCollections.values.forEach { it.close() }
+            tabCollections.clear()
+            searchCollection?.close()
+            searchCollection = null
+            resolvedMediaIds.clear()
+        }
+        scope.cancel()
+    }
+
+    internal companion object {
+        const val MIN_SEARCH_QUERY_LENGTH = 3
+        const val SEARCH_DEBOUNCE_MS = 250L
+        const val FEATURED_IMAGE_THUMBNAIL_SIZE = 128
+        const val HOMEPAGE_SETTINGS_TIMEOUT_MS = 10_000L
+
+        private const val SNACKBAR_BUFFER = 8
+        private const val REQUEST_BUFFER = 8
+    }
+}
+
+/** Replaces the rows of a tab state without changing how the tab is presented. */
+private fun PageTabUiState.withPages(pages: List<PageRsUiModel>): PageTabUiState = when (this) {
+    is PageTabUiState.Loading -> PageTabUiState.Loading(pages)
+    is PageTabUiState.Refreshing -> PageTabUiState.Refreshing(pages)
+    is PageTabUiState.Ready -> PageTabUiState.Ready(pages)
+    is PageTabUiState.Error -> PageTabUiState.Error(pages, errorMessage, canRetry)
+}
+
+/**
+ * Collection wrapper that makes closing idempotent.
+ *
+ * A collection can become obsolete while its request is still running, and closing an already closed
+ * collection must not fail the late request.
+ */
+private class CloseGuard(
+    private val delegate: ObservableMetadataCollection,
+) : ObservableMetadataCollection {
+    private val closed = java.util.concurrent.atomic.AtomicBoolean(false)
+
+    override suspend fun refresh() {
+        if (closed.get()) return
+        delegate.refresh()
+    }
+
+    override suspend fun loadItems(): List<MetadataItem> {
+        if (closed.get()) return emptyList()
+        return delegate.loadItems()
+    }
+
+    override suspend fun listInfo(): ListInfo = delegate.listInfo()
+
+    override fun close() {
+        if (closed.compareAndSet(false, true)) delegate.close()
+    }
+}
