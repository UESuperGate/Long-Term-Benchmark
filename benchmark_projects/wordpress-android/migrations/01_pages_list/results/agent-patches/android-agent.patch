@@ -0,0 +1,215 @@
+package org.wordpress.android.ui.pagesrs
+
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.flow.Flow
+
+/** Site the pages screen operates on. */
+data class SiteModel(
+    val id: Int = 0,
+    val name: String = "",
+    val url: String = "",
+    val isUsingWpComRestApi: Boolean = true,
+    val isSingleUserSite: Boolean? = null,
+    val hasCapabilityEditOthersPages: Boolean = false,
+    val isWpComAtomic: Boolean = false,
+    val showOnFront: String = SHOW_ON_FRONT_POSTS,
+    val pageOnFront: Long = 0L,
+    val pageForPosts: Long = 0L,
+) {
+    val isUsingPagesForHomepage: Boolean
+        get() = showOnFront == SHOW_ON_FRONT_PAGE && pageOnFront != 0L
+
+    /** A site is treated as multi author when it is known to have more than one user. */
+    val isMultiAuthor: Boolean
+        get() = isSingleUserSite != null && !isSingleUserSite
+
+    /**
+     * Author filtering is only offered on multi author sites the signed in user can contribute pages to.
+     *
+     * This matches the legacy pages list: self hosted sites do not support the author parameter and
+     * single user sites have nothing to filter.
+     */
+    val isAuthorFilterSupported: Boolean
+        get() = isUsingWpComRestApi && hasCapabilityEditOthersPages && isMultiAuthor
+
+    companion object {
+        const val SHOW_ON_FRONT_POSTS = "posts"
+        const val SHOW_ON_FRONT_PAGE = "page"
+    }
+}
+
+/** Signed in account. */
+data class Account(
+    val userId: Long,
+    val displayName: String = "",
+    val avatarUrl: String? = null,
+)
+
+/** Provides the site the application currently works on. */
+interface SelectedSiteRepository {
+    fun getSelectedSite(): SiteModel?
+
+    fun observeSelectedSite(): Flow<SiteModel>
+}
+
+/** Site scoped service handle. */
+interface WpService {
+    val site: SiteModel
+
+    val isUsingWpComRestApi: Boolean get() = site.isUsingWpComRestApi
+
+    /** Page mutations of this site. */
+    val postService: PostService
+}
+
+/** Provides the site scoped service handle. */
+interface WpServiceProvider {
+    fun getWpService(site: SiteModel): WpService
+}
+
+/**
+ * Store dispatch boundary.
+ *
+ * Every write that has to be serialised with the rest of the application state goes through the
+ * dispatcher, mirroring the store action chain.
+ */
+interface Dispatcher {
+    /** Coroutine dispatcher the store actions run on. */
+    val defaultDispatcher: CoroutineDispatcher
+
+    suspend fun <T> dispatch(action: suspend () -> T): T
+}
+
+/** Resolves user facing strings. */
+interface ResourceProvider {
+    fun getString(resId: Int): String
+}
+
+/** Blaze availability of a site. */
+interface BlazeFeatureUtils {
+    fun isBlazeEligibleSite(site: SiteModel): Boolean
+
+    fun trackEntryPointTapped(source: BlazeFlowSource)
+}
+
+/** Entry points that can promote a page to Blaze. */
+enum class BlazeFlowSource(val key: String) {
+    PAGES_LIST("pages_list"),
+}
+
+/** Network availability. */
+interface NetworkUtilsWrapper {
+    fun isNetworkAvailable(): Boolean
+}
+
+/** Signed in account store. */
+interface AccountStore {
+    val account: Account?
+}
+
+/** Persistent application preferences. */
+interface AppPrefsWrapper {
+    /** Persisted author filter of the post/page lists. */
+    var postListAuthorSelection: AuthorFilterSelection
+}
+
+/** Local page cache. */
+interface PostStore {
+    suspend fun getPages(siteId: Int): List<MetadataItem>
+
+    suspend fun upsertPages(siteId: Int, items: List<MetadataItem>)
+
+    suspend fun updatePageStatus(siteId: Int, remoteId: Long, status: PostStatus)
+
+    suspend fun deletePage(siteId: Int, remoteId: Long)
+
+    fun observePages(siteId: Int): Flow<List<MetadataItem>>
+}
+
+/** Low level page row persistence used by the pages list. */
+class PostSqlUtils(private val postStore: PostStore) {
+    /** Stores the rows returned by a collection request. */
+    suspend fun replacePages(siteId: Int, rows: List<MetadataItem>) = postStore.upsertPages(siteId, rows)
+
+    /** Stores the rows fetched from the service. */
+    suspend fun upsertPages(siteId: Int, rows: List<MetadataItem>) = postStore.upsertPages(siteId, rows)
+
+    /** Applies a status change to a stored row. */
+    suspend fun updateStatus(siteId: Int, remoteId: Long, status: PostStatus) =
+        postStore.updatePageStatus(siteId, remoteId, status)
+
+    /** Removes a stored row. */
+    suspend fun deletePage(siteId: Int, remoteId: Long) = postStore.deletePage(siteId, remoteId)
+
+    /** Reads a single stored row. */
+    suspend fun findPage(siteId: Int, remoteId: Long): MetadataItem? =
+        postStore.getPages(siteId).firstOrNull { it.remoteId == remoteId }
+}
+
+/** Payload of a remote page list response. */
+data class PostListPayload(
+    val items: List<MetadataItem>,
+    val page: UInt = 0u,
+    val pageCount: Int = 1,
+) {
+    val canLoadMore: Boolean get() = page + 1u < pageCount.toUInt()
+}
+
+/** Homepage settings of a site. */
+data class HomepageSettingsPayload(
+    val pageOnFront: Long = 0L,
+    val pageForPosts: Long = 0L,
+    val showOnFront: String = SiteModel.SHOW_ON_FRONT_POSTS,
+)
+
+/**
+ * Raw pages client.
+ *
+ * This is the external service leaf the pages list reads and writes pages through.
+ */
+interface WpApiClient {
+    suspend fun fetchPosts(
+        site: SiteModel,
+        endpointType: PostEndpointType,
+        filter: PostListFilter,
+        page: UInt,
+    ): PostListPayload
+
+    suspend fun fetchHomepageSettings(site: SiteModel): HomepageSettingsPayload
+
+    suspend fun updatePageOnFront(site: SiteModel, pageId: Long): HomepageSettingsPayload
+
+    suspend fun updatePageForPosts(site: SiteModel, pageId: Long): HomepageSettingsPayload
+}
+
+/** Provides the [WpApiClient] for a site. */
+interface WpApiClientProvider {
+    fun getWpApiClient(site: SiteModel): WpApiClient
+}
+
+/**
+ * Page mutations.
+ *
+ * Every mutation takes the entity explicitly so a pages screen can never write to posts by accident.
+ */
+interface PostService {
+    suspend fun trashPost(endpointType: PostEndpointType, pageId: Long)
+
+    suspend fun deletePost(endpointType: PostEndpointType, pageId: Long)
+
+    suspend fun updatePostStatus(endpointType: PostEndpointType, pageId: Long, status: PostStatus)
+}
+
+/**
+ * Media leaf used to resolve page featured images.
+ *
+ * Thumbnails are decoration: a missing or failing media call must never remove the page row.
+ */
+interface PostRsRestClient {
+    suspend fun fetchMediaUrls(site: SiteModel, ids: List<Long>, size: Int): Map<Long, String>
+}
+
+/** Analytics sink used by the pages screen. */
+interface AnalyticsTrackerWrapper {
+    fun track(stat: String, site: SiteModel? = null, properties: Map<String, Any?> = emptyMap())
+}
