+package org.wordpress.android.ui.pagesrs
+
+/**
+ * Bridge between the pages list and the page collections.
+ *
+ * The bridge owns the pages request path: it opens the collection that matches the request, asks it for a
+ * fresh copy of the rows, stores what the service returned and maps everything onto the models the
+ * screen renders.
+ */
+internal class PageRsFluxCBridge(
+    private val wpApiClientProvider: WpApiClientProvider,
+    private val postStore: PostStore,
+    private val postSqlUtils: PostSqlUtils,
+    private val postMapper: PostRsToFluxCMapper,
+) {
+    /** Opens a collection for [request]. The caller owns it and has to close it. */
+    fun openCollection(request: PageListRequest): ObservableMetadataCollection =
+        CollectionLeaf.factory(request.endpointType, request.filter, request.page)
+
+    /**
+     * Loads the rows of [request].
+     *
+     * The service is queried first so the rows are fresh, then the collection is read back; a collection
+     * that only knows about cached rows therefore still produces the same pages.
+     */
+    suspend fun loadPages(
+        request: PageListRequest,
+        site: SiteModel,
+        context: PageRsSiteContext,
+        collection: ObservableMetadataCollection,
+    ): List<PageRsUiModel> {
+        check(request.endpointType == PostEndpointType.PAGES) {
+            "The pages list can only request pages"
+        }
+
+        collection.refresh()
+        persistRemoteRows(request, site)
+        val items = collection.loadItems()
+        return postMapper.mapPages(items, context)
+    }
+
+    /** Loads the rows of [request] through a collection the bridge opens and closes itself. */
+    suspend fun loadPages(
+        request: PageListRequest,
+        site: SiteModel,
+        context: PageRsSiteContext,
+    ): List<PageRsUiModel> {
+        val collection = openCollection(request)
+        return try {
+            loadPages(request, site, context, collection)
+        } finally {
+            collection.close()
+        }
+    }
+
+    private suspend fun persistRemoteRows(request: PageListRequest, site: SiteModel) {
+        val payload = wpApiClientProvider.getWpApiClient(site)
+            .fetchPosts(site, request.endpointType, request.filter, request.page)
+        if (payload.items.isNotEmpty()) {
+            postSqlUtils.upsertPages(site.id, payload.items)
+        }
+    }
+
+    /** Applies resolved featured image urls; pages without a url stay in the list. */
+    fun applyImageUrls(pages: List<PageRsUiModel>, urls: Map<Long, String>): List<PageRsUiModel> =
+        postMapper.withImageUrls(pages, urls)
+
+    fun postStore(): PostStore = postStore
+}
