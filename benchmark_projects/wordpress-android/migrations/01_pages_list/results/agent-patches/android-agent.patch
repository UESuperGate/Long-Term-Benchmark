@@ -0,0 +1,252 @@
+package org.wordpress.android.ui.pagesrs
+
+import android.os.Bundle
+import android.widget.TextView
+import androidx.activity.ComponentActivity
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.ViewModelProvider
+import androidx.lifecycle.viewmodel.CreationExtras
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+/**
+ * Owns the modern pages screen.
+ *
+ * The activity is the entry point of the screen: it acquires the view model from its own
+ * [ViewModelStore] through a [ViewModelProvider], forwards the screen events to it and renders the
+ * values it produces.
+ */
+class PagesRuntimeOwnerActivity : ComponentActivity() {
+    private val dependencyFactory: PagesRsDependencyFactory by lazy { PagesRsDependencyFactory() }
+
+    private val activityScope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+    private lateinit var viewModel: PagesRsListViewModel
+
+    private val _renderedRows = MutableStateFlow<List<PageRsListItem>>(emptyList())
+    val renderedRows: StateFlow<List<PageRsListItem>> = _renderedRows.asStateFlow()
+
+    private val _renderedMenuPageId = MutableStateFlow<Long?>(null)
+    val renderedMenuPageId: StateFlow<Long?> = _renderedMenuPageId.asStateFlow()
+
+    private val _renderedMenuActions = MutableStateFlow<List<PageRsMenuAction>>(emptyList())
+    val renderedMenuActions: StateFlow<List<PageRsMenuAction>> = _renderedMenuActions.asStateFlow()
+
+    private val _shownSnackbars = MutableStateFlow<List<SnackbarMessage>>(emptyList())
+    val shownSnackbars: StateFlow<List<SnackbarMessage>> = _shownSnackbars.asStateFlow()
+
+    private val _editorRequests = MutableStateFlow<List<PageRsEditorRequest>>(emptyList())
+    val editorRequests: StateFlow<List<PageRsEditorRequest>> = _editorRequests.asStateFlow()
+
+    private val _navigationRequests = MutableStateFlow<List<PageRsNavigationRequest>>(emptyList())
+    val navigationRequests: StateFlow<List<PageRsNavigationRequest>> = _navigationRequests.asStateFlow()
+
+    /** State of every tab of the screen. */
+    val tabStates: StateFlow<Map<PageRsListTab, PageTabUiState>> get() = viewModel.tabStates
+
+    /** State of the search result area. */
+    val searchState: StateFlow<PageTabUiState> get() = viewModel.searchState
+
+    val isSearchActive: StateFlow<Boolean> get() = viewModel.isSearchActive
+
+    val searchQuery: StateFlow<String> get() = viewModel.searchQuery
+
+    val authorFilter: StateFlow<AuthorFilterSelection> get() = viewModel.authorFilter
+
+    val isAuthorFilterVisible: StateFlow<Boolean> get() = viewModel.isAuthorFilterVisible
+
+    val pendingConfirmation: StateFlow<PageRsListConfirmation?> get() = viewModel.pendingConfirmation
+
+    val snackbarMessages: Flow<SnackbarMessage> get() = viewModel.snackbarMessages
+
+    private lateinit var descriptionView: TextView
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        CollectionLeaf.install(dependencyFactory.collectionLeaf())
+        viewModel = ViewModelProvider(this, ViewModelFactory(dependencyFactory))[PagesRsListViewModel::class.java]
+
+        descriptionView = TextView(this)
+        setContentView(descriptionView)
+
+        observeViewModel()
+    }
+
+    override fun onDestroy() {
+        activityScope.cancel()
+        super.onDestroy()
+    }
+
+    // region screen events
+
+    /** Opens a tab of the pages screen through the normal Pages entry. */
+    fun open(tab: PageRsListTab = PageRsListTab.PUBLISHED) {
+        viewModel.initTab(tab)
+    }
+
+    /** Reloads the visible tab; the same body backs the retry affordance of a failed load. */
+    fun refresh() {
+        viewModel.refreshTab(viewModel.currentTab(), isUserRefresh = true)
+    }
+
+    /** Runs the retry affordance of the visible tab. */
+    fun retryActiveTab() {
+        viewModel.refreshTab(viewModel.currentTab(), isUserRefresh = false)
+    }
+
+    /** Enters search mode. */
+    fun openSearch() {
+        viewModel.onSearchOpen()
+    }
+
+    /** Applies a search query. */
+    fun changeSearchQuery(query: String) {
+        viewModel.onSearchQueryChanged(query, viewModel.currentTab())
+    }
+
+    /** Leaves search mode and restores the active tab. */
+    fun closeSearch() {
+        viewModel.onSearchClose(viewModel.currentTab())
+    }
+
+    /** Applies an author filter selection. */
+    fun selectAuthor(selection: AuthorFilterSelection) {
+        viewModel.onAuthorFilterChanged(selection, viewModel.currentTab())
+    }
+
+    /** Opens a page through the existing editor bridge. */
+    fun openPage(pageId: Long) {
+        viewModel.openPage(pageId, viewModel.currentTab())
+    }
+
+    /** Applies a page menu action; destructive actions only raise a confirmation. */
+    fun chooseMenuAction(pageId: Long, action: PageRsMenuAction) {
+        viewModel.onPageMenuAction(pageId, action)
+    }
+
+    /** Confirms the pending destructive or status changing action. */
+    fun confirmPendingAction() {
+        viewModel.onConfirmPendingAction()
+    }
+
+    /** Runs the action offered by a snackbar, e.g. a retry. */
+    fun performSnackbarAction(message: SnackbarMessage) {
+        viewModel.onSnackbarAction(message.action)
+    }
+
+    /** Renders pages as the depth first published hierarchy. */
+    fun renderHierarchy(pages: List<PageRsUiModel>) {
+        _renderedRows.value = buildRows(
+            pages = pages,
+            applyHierarchy = true,
+            pageOnFront = viewModel.homepagePageOnFront(),
+            pageForPosts = viewModel.homepagePageForPosts(),
+        )
+    }
+
+    /** Renders the actions available for a page. */
+    fun renderMenu(pageId: Long, actions: List<PageRsMenuAction>) {
+        _renderedMenuPageId.value = pageId
+        _renderedMenuActions.value = actions
+    }
+
+    /** Renders the actions available for a page. */
+    fun renderMenu(page: PageRsUiModel, actions: List<PageRsMenuAction>) =
+        renderMenu(page.remoteId, actions)
+
+    // endregion
+
+    // region rendered values
+
+    fun renderedRowSnapshot(): List<PageRsListItem> = _renderedRows.value
+
+    fun renderedMenuSnapshot(): List<PageRsMenuAction> = _renderedMenuActions.value
+
+    fun snackbarHistory(): List<SnackbarMessage> = _shownSnackbars.value
+
+    fun editorRequestHistory(): List<PageRsEditorRequest> = _editorRequests.value
+
+    fun navigationRequestHistory(): List<PageRsNavigationRequest> = _navigationRequests.value
+
+    fun tabStateSnapshot(): Map<PageRsListTab, PageTabUiState> = viewModel.tabStates.value
+
+    fun searchIsActive(): Boolean = viewModel.isSearchActive.value
+
+    fun currentSearchQuery(): String = viewModel.searchQuery.value
+
+    fun authorSelection(): AuthorFilterSelection = viewModel.authorFilter.value
+
+    fun pendingConfirmationOrNull(): PageRsListConfirmation? = viewModel.pendingConfirmation.value
+
+    fun activeTab(): PageRsListTab = viewModel.currentTab()
+
+    fun menuActionsFor(pageId: Long): List<PageRsMenuAction> = viewModel.menuActionsFor(pageId)
+
+    fun renderedRowFor(pageId: Long): PageRsListItem? = viewModel.renderedRowFor(pageId)
+
+    // endregion
+
+    private fun observeViewModel() {
+        activityScope.launch {
+            viewModel.renderedRows.collect { rows ->
+                _renderedRows.value = rows
+                runOnUiThread { updateDescription(rows) }
+            }
+        }
+        activityScope.launch {
+            viewModel.snackbarMessages.collect { message ->
+                _shownSnackbars.value = _shownSnackbars.value + message
+            }
+        }
+        activityScope.launch {
+            viewModel.editorRequests.collect { request ->
+                _editorRequests.value = _editorRequests.value + request
+            }
+        }
+        activityScope.launch {
+            viewModel.navigationRequests.collect { request ->
+                _navigationRequests.value = _navigationRequests.value + request
+            }
+        }
+    }
+
+    private fun updateDescription(rows: List<PageRsListItem>) {
+        if (!::descriptionView.isInitialized) return
+        val tabKey = viewModel.currentTab().key
+        val query = viewModel.searchQuery.value
+        descriptionView.text = buildString {
+            append("Tab: ").append(tabKey)
+            if (viewModel.isSearchActive.value) {
+                append(" | Search: ").append(query)
+            }
+            append('\n')
+            rows.forEach { row ->
+                append("  ".repeat(row.indent))
+                append(row.page.title.ifBlank { "(no title)" })
+                row.page.imageUrl?.let { url -> append(" [").append(url).append(']') }
+                append('\n')
+            }
+        }
+    }
+
+    /** Builds the pages list view model from the dependency factory. */
+    private class ViewModelFactory(
+        private val dependencyFactory: PagesRsDependencyFactory,
+    ) : ViewModelProvider.Factory {
+        @Suppress("UNCHECKED_CAST")
+        override fun <T : ViewModel> create(modelClass: Class<T>, extras: CreationExtras): T {
+            if (modelClass.isAssignableFrom(PagesRsListViewModel::class.java)) {
+                return dependencyFactory.listViewModel() as T
+            }
+            throw IllegalArgumentException("Unknown ViewModel class: ${modelClass.name}")
+        }
+    }
+}
