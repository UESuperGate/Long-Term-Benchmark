@@ -0,0 +1,270 @@
+package org.wordpress.android.ui.pagesrs
+
+/**
+ * The four tabs of the modern pages screen.
+ *
+ * The tab owns the request shape of the collection it shows: which statuses it contains and how those
+ * rows are ordered.
+ */
+enum class PageRsListTab(val key: String) {
+    PUBLISHED("published"),
+    DRAFTS("drafts"),
+    SCHEDULED("scheduled"),
+    TRASHED("trashed");
+
+    /** Statuses contained in this tab, mirroring the legacy pages list. */
+    fun pageStatuses(): List<PostStatus> = when (this) {
+        PUBLISHED -> listOf(PostStatus.PUBLISHED, PostStatus.PRIVATE)
+        DRAFTS -> listOf(PostStatus.DRAFT, PostStatus.PENDING)
+        SCHEDULED -> listOf(PostStatus.SCHEDULED)
+        TRASHED -> listOf(PostStatus.TRASHED)
+    }
+
+    /** Published and draft-like tabs read like an index, scheduled reads like a calendar. */
+    fun orderBy(): PostListOrder = when (this) {
+        PUBLISHED, DRAFTS, TRASHED -> PostListOrder.TITLE
+        SCHEDULED -> PostListOrder.DATE
+    }
+
+    fun order(): ListOrder = ListOrder.ASC
+
+    val pageSize: UInt get() = PAGE_SIZE
+
+    /** Only the published tab is rendered as a page hierarchy. */
+    fun isHierarchyEnabled(): Boolean = this == PUBLISHED
+
+    companion object {
+        const val PAGE_SIZE: UInt = 20u
+
+        val ALL: List<PageRsListTab> = listOf(PUBLISHED, DRAFTS, SCHEDULED, TRASHED)
+
+        fun fromKey(key: String): PageRsListTab? =
+            ALL.firstOrNull { it.key.equals(key, ignoreCase = true) || it.name.equals(key, ignoreCase = true) }
+    }
+}
+
+/** Ordering bucket a menu action is rendered in. */
+enum class ActionGroup {
+    VIEW,
+    TAKE_AN_ACTION,
+    SHARE_AND_PROMOTE,
+    TRASH,
+}
+
+/** Actions that can be triggered from a page row menu. */
+enum class PageRsMenuAction(val key: String, val group: ActionGroup, val positionInGroup: Int) {
+    VIEW_PAGE("view", ActionGroup.VIEW, 1),
+    CANCEL_AUTO_UPLOAD("cancel_auto_upload", ActionGroup.TAKE_AN_ACTION, 1),
+    SET_PARENT("set_parent", ActionGroup.TAKE_AN_ACTION, 2),
+    SET_AS_HOMEPAGE("set_as_homepage", ActionGroup.TAKE_AN_ACTION, 3),
+    SET_AS_POSTS_PAGE("set_as_posts_page", ActionGroup.TAKE_AN_ACTION, 4),
+    PUBLISH_NOW("publish_now", ActionGroup.TAKE_AN_ACTION, 5),
+    MOVE_TO_DRAFT("move_to_draft", ActionGroup.TAKE_AN_ACTION, 6),
+    COPY("copy", ActionGroup.TAKE_AN_ACTION, 7),
+    SHARE("share", ActionGroup.SHARE_AND_PROMOTE, 1),
+    PROMOTE_WITH_BLAZE("promote_with_blaze", ActionGroup.SHARE_AND_PROMOTE, 2),
+    MOVE_TO_TRASH("move_to_trash", ActionGroup.TRASH, 1),
+    DELETE_PERMANENTLY("delete_permanently", ActionGroup.TRASH, 2);
+
+    /**
+     * Whether running the action changes the page state on the site.
+     *
+     * Status changing and destructive actions always require an explicit confirmation first.
+     */
+    val requiresConfirmation: Boolean
+        get() = when (this) {
+            MOVE_TO_DRAFT, MOVE_TO_TRASH, DELETE_PERMANENTLY, PUBLISH_NOW,
+            SET_AS_HOMEPAGE, SET_AS_POSTS_PAGE,
+            -> true
+
+            else -> false
+        }
+}
+
+/** Selection of the Everyone/Me author filter. */
+sealed class AuthorFilterSelection(val key: String) {
+    /** Every author of the site. */
+    object EVERYONE : AuthorFilterSelection("everyone") {
+        override fun toString(): String = key
+    }
+
+    /** The signed in author. The identifier itself is resolved from the account at request time. */
+    object ME : AuthorFilterSelection("me") {
+        override fun toString(): String = key
+    }
+
+    /** A single, explicitly picked author. */
+    data class Specific(val authorId: Long, val authorName: String) :
+        AuthorFilterSelection(SPECIFIC_KEY) {
+        override fun toString(): String = "specific:$authorId"
+    }
+
+    companion object {
+        const val SPECIFIC_KEY = "specific"
+
+        val DEFAULT: AuthorFilterSelection = EVERYONE
+
+        fun fromKey(key: String?, authorId: Long = 0L): AuthorFilterSelection = when (key?.lowercase()) {
+            ME.key -> ME
+            SPECIFIC_KEY -> Specific(authorId, "")
+            else -> EVERYONE
+        }
+    }
+}
+
+/** A page as rendered by the pages list. */
+data class PageRsUiModel(
+    val remoteId: Long,
+    val localId: Int = 0,
+    val title: String = "",
+    val status: PostStatus? = null,
+    val parentId: Long = 0L,
+    val dateMillis: Long = 0L,
+    val featuredImageId: Long = 0L,
+    val authorId: Long = 0L,
+    val authorDisplayName: String? = null,
+    val hasPassword: Boolean = false,
+    val isHomepage: Boolean = false,
+    val isPostsPage: Boolean = false,
+    /** Whether the signed in user may change which page is used as the site homepage. */
+    val canManageHomepage: Boolean = false,
+    /** Whether the site is eligible for promoting a page to Blaze. */
+    val isBlazeEligible: Boolean = false,
+    /** Featured image url, resolved asynchronously and never required for the row to be rendered. */
+    val imageUrl: String? = null,
+)
+
+/** A page row of the rendered list. */
+data class PageRsListItem(
+    val page: PageRsUiModel,
+    val indent: Int = 0,
+    val thumbnailUrl: String? = null,
+    val statusLabel: String = "",
+    val actions: List<PageRsMenuAction> = emptyList(),
+)
+
+/**
+ * State of a single tab.
+ *
+ * [pages] always holds the rows that are known to be good: a failed request keeps the previously loaded
+ * rows so the screen stays usable, and the error is represented by the state type instead.
+ */
+sealed class PageTabUiState(
+    open val pages: List<PageRsUiModel>,
+    open val errorMessage: String? = null,
+    open val canRetry: Boolean = false,
+) {
+    /** First load, nothing has ever been rendered for this tab. */
+    data class Loading(override val pages: List<PageRsUiModel> = emptyList()) : PageTabUiState(pages)
+
+    /** A reload is running, previously loaded rows stay visible. */
+    data class Refreshing(override val pages: List<PageRsUiModel>) : PageTabUiState(pages)
+
+    /** Loaded and up to date. */
+    data class Ready(override val pages: List<PageRsUiModel>) : PageTabUiState(pages)
+
+    /** The last request failed. [pages] still holds the previously loaded rows. */
+    data class Error(
+        override val pages: List<PageRsUiModel>,
+        override val errorMessage: String?,
+        override val canRetry: Boolean = true,
+    ) : PageTabUiState(pages, errorMessage, canRetry)
+
+    val isLoading: Boolean get() = this is Loading
+    val isRefreshing: Boolean get() = this is Refreshing
+    val hasError: Boolean get() = this is Error
+    val isEmpty: Boolean get() = pages.isEmpty()
+}
+
+/** A destructive or status changing action waiting for an explicit confirmation. */
+sealed class PageRsListConfirmation(
+    open val action: PageRsMenuAction,
+    open val page: PageRsUiModel,
+) {
+    data class MoveToTrash(override val page: PageRsUiModel) :
+        PageRsListConfirmation(PageRsMenuAction.MOVE_TO_TRASH, page)
+
+    data class DeletePermanently(override val page: PageRsUiModel) :
+        PageRsListConfirmation(PageRsMenuAction.DELETE_PERMANENTLY, page)
+
+    data class MoveToDraft(override val page: PageRsUiModel) :
+        PageRsListConfirmation(PageRsMenuAction.MOVE_TO_DRAFT, page)
+
+    data class PublishNow(override val page: PageRsUiModel) :
+        PageRsListConfirmation(PageRsMenuAction.PUBLISH_NOW, page)
+
+    data class SetAsHomepage(override val page: PageRsUiModel) :
+        PageRsListConfirmation(PageRsMenuAction.SET_AS_HOMEPAGE, page)
+
+    data class SetAsPostsPage(override val page: PageRsUiModel) :
+        PageRsListConfirmation(PageRsMenuAction.SET_AS_POSTS_PAGE, page)
+
+    val pageId: Long get() = page.remoteId
+
+    companion object {
+        fun forAction(action: PageRsMenuAction, page: PageRsUiModel): PageRsListConfirmation? = when (action) {
+            PageRsMenuAction.MOVE_TO_TRASH -> MoveToTrash(page)
+            PageRsMenuAction.DELETE_PERMANENTLY -> DeletePermanently(page)
+            PageRsMenuAction.MOVE_TO_DRAFT -> MoveToDraft(page)
+            PageRsMenuAction.PUBLISH_NOW -> PublishNow(page)
+            PageRsMenuAction.SET_AS_HOMEPAGE -> SetAsHomepage(page)
+            PageRsMenuAction.SET_AS_POSTS_PAGE -> SetAsPostsPage(page)
+            else -> null
+        }
+    }
+}
+
+/** Action a snackbar offers to the user. */
+sealed interface SnackbarAction {
+    /** Repeat the failed page mutation for the very same page. */
+    data class RetryPageAction(val pageId: Long, val action: PageRsMenuAction) : SnackbarAction
+
+    /** Reload the list that failed. */
+    data object RetryListAction : SnackbarAction
+}
+
+/** Feedback message shown by the pages screen. */
+data class SnackbarMessage(
+    val message: String,
+    val actionLabel: String? = null,
+    val action: SnackbarAction? = null,
+)
+
+/** Request to open a page in the existing editor bridge. */
+data class PageRsEditorRequest(
+    val siteId: Int,
+    val remotePageId: Long,
+    val localPageId: Int = 0,
+    val loadAutoSaveRevision: Boolean = false,
+)
+
+/** Request to open a sub screen owned by the pages feature. */
+sealed interface PageRsNavigationRequest {
+    data class SetParent(val page: PageRsUiModel) : PageRsNavigationRequest
+
+    data class Copy(val page: PageRsUiModel) : PageRsNavigationRequest
+
+    data class Share(val page: PageRsUiModel) : PageRsNavigationRequest
+
+    data class PromoteWithBlaze(val page: PageRsUiModel) : PageRsNavigationRequest
+}
+
+/**
+ * Site scoped facts the mapper needs to turn store rows into rendered pages.
+ *
+ * Keeping them together avoids re-reading the site for every row and makes the mapping a pure function.
+ */
+data class PageRsSiteContext(
+    val site: SiteModel,
+    val pageOnFront: Long,
+    val pageForPosts: Long,
+    val canManageHomepage: Boolean,
+    val isBlazeEligible: Boolean,
+)
+
+/** A page collection request, together with the entity and the page offset it targets. */
+data class PageListRequest(
+    val endpointType: PostEndpointType,
+    val filter: PostListFilter,
+    val page: UInt = 0u,
+)
