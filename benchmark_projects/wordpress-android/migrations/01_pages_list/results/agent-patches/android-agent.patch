+package org.wordpress.android.ui.pagesrs
+
+/**
+ * Builds the object graph of the modern pages screen.
+ *
+ * The activity owns the factory, which keeps the view model free of construction details and gives the
+ * external leaves a single place to be replaced.
+ */
+internal class PagesRsDependencyFactory(
+    private val selectedSiteRepository: SelectedSiteRepository = SelectedSiteCache.instance,
+    private val serviceProvider: WpServiceProvider = DefaultWpServiceProvider.instance,
+    private val dispatcher: Dispatcher = DefaultDispatcher.instance,
+    private val wpApiClientProvider: WpApiClientProvider = SingleWpApiClientProvider.instance,
+    private val restClient: PostRsRestClient = DefaultMediaRestClient.instance,
+    private val resourceProvider: ResourceProvider = DefaultResourceProvider.instance,
+    private val postStore: PostStore = InMemoryPostStore.instance,
+    private val blazeFeatureUtils: BlazeFeatureUtils = DefaultBlazeFeatureUtils.instance,
+    private val networkUtilsWrapper: NetworkUtilsWrapper = DefaultNetworkUtilsWrapper.instance,
+    private val accountStore: AccountStore = DefaultAccountStore.instance,
+    private val appPrefsWrapper: AppPrefsWrapper = AppPreferences(),
+    private val analyticsTracker: AnalyticsTrackerWrapper = RecordingAnalyticsTracker.instance,
+) {
+    /** The collection leaf the view model opens page collections through. */
+    fun collectionLeaf(): CollectionLeaf = PostStoreCollectionLeaf.create(postStore, selectedSiteRepository)
+
+    private val postSqlUtils: PostSqlUtils by lazy { PostSqlUtils(postStore) }
+
+    private val postMapper: PostRsToFluxCMapper by lazy { PostRsToFluxCMapper() }
+
+    fun homepageSettings(): PageRsHomepageSettings =
+        PageRsHomepageSettings(wpApiClientProvider = wpApiClientProvider, dispatcher = dispatcher)
+
+    fun fluxCBridge(): PageRsFluxCBridge = PageRsFluxCBridge(
+        wpApiClientProvider = wpApiClientProvider,
+        postStore = postStore,
+        postSqlUtils = postSqlUtils,
+        postMapper = postMapper,
+    )
+
+    fun listViewModel(): PagesRsListViewModel = PagesRsListViewModel(
+        selectedSiteRepository = selectedSiteRepository,
+        serviceProvider = serviceProvider,
+        dispatcher = dispatcher,
+        restClient = restClient,
+        resourceProvider = resourceProvider,
+        postStore = postStore,
+        homepageSettings = homepageSettings(),
+        blazeFeatureUtils = blazeFeatureUtils,
+        fluxCBridge = fluxCBridge(),
+        networkUtilsWrapper = networkUtilsWrapper,
+        accountStore = accountStore,
+        appPrefsWrapper = appPrefsWrapper,
+        analyticsTracker = analyticsTracker,
+    )
+}
