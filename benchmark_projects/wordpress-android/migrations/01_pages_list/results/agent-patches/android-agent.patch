+++ b/WordPress/src/main/java/org/wordpress/android/ui/pagesrs/PagesRsDefaultDataSources.kt
@@ -0,0 +1,290 @@
+package org.wordpress.android.ui.pagesrs
+
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.filterNotNull
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+/**
+ * Site the application works on.
+ *
+ * The selected site is process wide state, exactly like the site store cache the rest of the application
+ * reads from.
+ */
+class SelectedSiteCache : SelectedSiteRepository {
+    private val selected = MutableStateFlow<SiteModel?>(null)
+
+    override fun getSelectedSite(): SiteModel? = selected.value
+
+    override fun observeSelectedSite(): Flow<SiteModel> = selected.filterNotNull()
+
+    fun select(site: SiteModel) {
+        selected.value = site
+    }
+
+    fun clear() {
+        selected.value = null
+    }
+
+    companion object {
+        val instance: SelectedSiteCache = SelectedSiteCache()
+    }
+}
+
+/** Site scoped service handle backed by the selected site. */
+class WpServiceHandle(
+    override val site: SiteModel,
+    private val serviceProvider: DefaultWpServiceProvider,
+) : WpService {
+    override val postService: PostService get() = serviceProvider.postService
+}
+
+/**
+ * Site scoped services of the application.
+ *
+ * The handle is shared by every screen that works on a site, the same way the stores are.
+ */
+class DefaultWpServiceProvider(
+    @Volatile var postService: PostService = StoreBackedPostService.create(),
+) : WpServiceProvider {
+    override fun getWpService(site: SiteModel): WpService = WpServiceHandle(site, this)
+
+    companion object {
+        val instance: DefaultWpServiceProvider = DefaultWpServiceProvider()
+    }
+}
+
+/** Runs store actions on the background dispatcher. */
+class DefaultDispatcher(
+    override val defaultDispatcher: CoroutineDispatcher = Dispatchers.IO,
+) : Dispatcher {
+    override suspend fun <T> dispatch(action: suspend () -> T): T =
+        withContext(defaultDispatcher) { action() }
+
+    companion object {
+        val instance: DefaultDispatcher = DefaultDispatcher()
+    }
+}
+
+/** Resolves the pages screen strings. */
+class DefaultResourceProvider(
+    private val values: Map<Int, String> = defaultPagesStringValues(),
+) : ResourceProvider {
+    override fun getString(resId: Int): String = values[resId] ?: ""
+
+    companion object {
+        val instance: DefaultResourceProvider = DefaultResourceProvider()
+    }
+}
+
+/** Blaze is offered on WordPress.com Atomic sites. */
+class DefaultBlazeFeatureUtils : BlazeFeatureUtils {
+    override fun isBlazeEligibleSite(site: SiteModel): Boolean = site.isWpComAtomic
+
+    override fun trackEntryPointTapped(source: BlazeFlowSource) = Unit
+
+    companion object {
+        val instance: DefaultBlazeFeatureUtils = DefaultBlazeFeatureUtils()
+    }
+}
+
+/** Network availability. */
+class DefaultNetworkUtilsWrapper(
+    @Volatile var connected: Boolean = true,
+) : NetworkUtilsWrapper {
+    override fun isNetworkAvailable(): Boolean = connected
+
+    companion object {
+        val instance: DefaultNetworkUtilsWrapper = DefaultNetworkUtilsWrapper()
+    }
+}
+
+/** Signed in account store. */
+class DefaultAccountStore(
+    @Volatile override var account: Account? = null,
+) : AccountStore {
+    companion object {
+        val instance: DefaultAccountStore = DefaultAccountStore()
+    }
+}
+
+/**
+ * Persistent application preferences.
+ *
+ * Backed by the process wide preference storage, therefore the persisted author filter survives the
+ * screen being recreated. Only the keys owned by a screen are ever written, unrelated preferences keep
+ * their value.
+ */
+class AppPreferences(
+    private val preferences: MutableMap<String, Any> = processPreferences,
+) : AppPrefsWrapper {
+    override var postListAuthorSelection: AuthorFilterSelection
+        get() = when (val stored = preferences[KEY_AUTHOR_SELECTION]) {
+            is AuthorFilterSelection -> stored
+            is String -> AuthorFilterSelection.fromKey(stored)
+            else -> AuthorFilterSelection.DEFAULT
+        }
+        set(value) {
+            preferences[KEY_AUTHOR_SELECTION] = value
+        }
+
+    /** Read only view of the persisted preferences, used to verify that nothing else was touched. */
+    fun snapshot(): Map<String, Any> = preferences.toMap()
+
+    companion object {
+        const val KEY_AUTHOR_SELECTION = "pages_list_author_selection"
+
+        internal val processPreferences: MutableMap<String, Any> = mutableMapOf()
+    }
+}
+
+/** Analytics sink. */
+class RecordingAnalyticsTracker : AnalyticsTrackerWrapper {
+    private val recorded = mutableListOf<RecordedStat>()
+
+    override fun track(stat: String, site: SiteModel?, properties: Map<String, Any?>) {
+        synchronized(recorded) {
+            recorded += RecordedStat(stat, site?.id, properties.toMap())
+            while (recorded.size > MAX_RECORDED_STATS) {
+                recorded.removeAt(0)
+            }
+        }
+    }
+
+    val recordedStats: List<RecordedStat>
+        get() = synchronized(recorded) { recorded.toList() }
+
+    data class RecordedStat(val stat: String, val siteId: Int?, val properties: Map<String, Any?>)
+
+    companion object {
+        private const val MAX_RECORDED_STATS = 50
+
+        val instance: RecordingAnalyticsTracker = RecordingAnalyticsTracker()
+    }
+}
+
+/**
+ * Local page cache.
+ *
+ * The pages list owns the lifetime of its rows: a service response is written here and the rendered list
+ * is reduced from the store, which is what keeps trashing and other mutations consistent across tabs.
+ */
+class InMemoryPostStore : PostStore {
+    private val mutex = Mutex()
+    private val pagesBySite = mutableMapOf<Int, MutableMap<Long, MetadataItem>>()
+    private val revisions = MutableStateFlow(0)
+
+    override suspend fun getPages(siteId: Int): List<MetadataItem> = mutex.withLock {
+        pagesBySite[siteId]?.values?.toList().orEmpty()
+    }
+
+    override suspend fun upsertPages(siteId: Int, items: List<MetadataItem>) {
+        mutex.withLock {
+            val sitePages = pagesBySite.getOrPut(siteId) { mutableMapOf() }
+            items.forEach { sitePages[it.remoteId] = it }
+        }
+        revisions.value += 1
+    }
+
+    override suspend fun updatePageStatus(siteId: Int, remoteId: Long, status: PostStatus) {
+        mutex.withLock {
+            val page = pagesBySite[siteId]?.get(remoteId) ?: return@withLock
+            pagesBySite[siteId]?.put(remoteId, page.copy(status = status))
+        }
+        revisions.value += 1
+    }
+
+    override suspend fun deletePage(siteId: Int, remoteId: Long) {
+        mutex.withLock { pagesBySite[siteId]?.remove(remoteId) }
+        revisions.value += 1
+    }
+
+    override fun observePages(siteId: Int): Flow<List<MetadataItem>> = revisions.map { getPages(siteId) }
+
+    companion object {
+        val instance: InMemoryPostStore = InMemoryPostStore()
+    }
+}
+
+/**
+ * Page collection backed by the local store.
+ *
+ * Filtering, ordering and paging of a collection happen here, so the same request always produces the
+ * same rows.
+ */
+class PostStoreCollection(
+    private val postStore: PostStore,
+    private val siteProvider: SelectedSiteRepository,
+    private val endpointType: PostEndpointType,
+    private val filter: PostListFilter,
+    private val page: UInt,
+) : ObservableMetadataCollection {
+    private val mutex = Mutex()
+    private var closed = false
+
+    override suspend fun refresh() {
+        check(!closed) { "Collection has already been closed" }
+        // The store is the single source of truth for the list: a refresh only invalidates what the
+        // collection may serve from cache, the rows themselves are written by the bridge.
+    }
+
+    override suspend fun loadItems(): List<MetadataItem> {
+        check(!closed) { "Collection has already been closed" }
+        val site = siteProvider.getSelectedSite() ?: return emptyList()
+        val statuses = filter.statuses.toSet()
+
+        return postStore.getPages(site.id)
+            .asSequence()
+            .filter { it.status.restValue in statuses }
+            .filter { filter.authorIds.isEmpty() || it.authorId in filter.authorIds }
+            .filter { filter.search.isBlank() || it.title.contains(filter.search, ignoreCase = true) }
+            .let { matching ->
+                when (filter.orderBy) {
+                    PostListOrder.TITLE -> matching.sortedBy { it.title.lowercase() }
+                    PostListOrder.DATE -> matching.sortedBy { it.dateMillis }
+                }
+            }
+            .toList()
+    }
+
+    override suspend fun listInfo(): ListInfo = mutex.withLock {
+        val site = siteProvider.getSelectedSite() ?: return@withLock ListInfo(page = page)
+        val statuses = filter.statuses.toSet()
+        val matching = postStore.getPages(site.id).count { it.status.restValue in statuses }
+        val pageSize = filter.pageSize.toInt().coerceAtLeast(1)
+        val pageCount = if (matching == 0) 1 else (matching + pageSize - 1) / pageSize
+        ListInfo(page = page, pageCount = pageCount, canLoadMore = page + 1u < pageCount.toUInt())
+    }
+
+    override fun close() {
+        closed = true
+    }
+}
+
+/**
+ * Collection leaf the application installs.
+ *
+ * Opening a collection is the only way the pages list reaches the page rows, which keeps the request
+ * path in one place.
+ */
+class PostStoreCollectionLeaf(
+    private val postStore: PostStore,
+    private val siteProvider: SelectedSiteRepository,
+) : CollectionLeaf {
+    override val factory: (PostEndpointType, PostListFilter, UInt) -> ObservableMetadataCollection =
+        { endpointType, filter, page ->
+            PostStoreCollection(postStore, siteProvider, endpointType, filter, page)
+        }
+
+    companion object {
+        fun create(
+            postStore: PostStore = InMemoryPostStore.instance,
+            siteProvider: SelectedSiteRepository = SelectedSiteCache.instance,
+        ): PostStoreCollectionLeaf = PostStoreCollectionLeaf(postStore, siteProvider)
+    }
+}
