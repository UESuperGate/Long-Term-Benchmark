+package org.wordpress.android.ui.pagesrs
+
+/**
+ * Maps stored page rows onto the models the pages list renders.
+ *
+ * The mapping is a pure function of a store row and the site context, which keeps the rows that are
+ * already loaded stable when a featured image resolves later on.
+ */
+class PostRsToFluxCMapper {
+    fun mapPages(
+        items: List<MetadataItem>,
+        context: PageRsSiteContext,
+    ): List<PageRsUiModel> = items.map { item -> mapPage(item, context) }
+
+    fun mapPage(
+        item: MetadataItem,
+        context: PageRsSiteContext,
+    ): PageRsUiModel {
+        val pageOnFront = context.pageOnFront
+        val pageForPosts = context.pageForPosts
+        return PageRsUiModel(
+            remoteId = item.remoteId,
+            localId = item.localId,
+            title = item.title,
+            status = item.status,
+            parentId = item.parentId,
+            dateMillis = item.dateMillis,
+            featuredImageId = item.featuredImageId,
+            authorId = item.authorId,
+            authorDisplayName = item.authorDisplayName,
+            hasPassword = item.hasPassword,
+            isHomepage = item.remoteId != 0L && item.remoteId == pageOnFront,
+            isPostsPage = item.remoteId != 0L && item.remoteId == pageForPosts,
+            canManageHomepage = context.canManageHomepage,
+            isBlazeEligible = context.isBlazeEligible,
+            imageUrl = null,
+        )
+    }
+
+    /**
+     * Applies resolved featured image urls.
+     *
+     * Every page of [pages] is kept, whether or not a url was resolved for it: a page without a
+     * thumbnail still has to be visible.
+     */
+    fun withImageUrls(
+        pages: List<PageRsUiModel>,
+        urls: Map<Long, String>,
+    ): List<PageRsUiModel> {
+        if (urls.isEmpty()) return pages
+        return pages.map { page ->
+            val url = urls[page.featuredImageId]
+            if (url == null || url == page.imageUrl) page else page.copy(imageUrl = url)
+        }
+    }
+
+    /** Applies a status change produced by a page mutation. */
+    fun withStatus(page: PageRsUiModel, status: PostStatus): PageRsUiModel = page.copy(status = status)
+}
