+package org.wordpress.android.ui.pagesrs
+
+/**
+ * Pages client that serves the locally known page rows.
+ *
+ * It keeps the pages request path complete when the site cannot be reached and lets the store stay the
+ * single source of truth for the rendered list. A site backed installation swaps in the REST backed
+ * client.
+ */
+class StoreBackedWpApiClient(
+    private val postStore: PostStore,
+    private val siteProvider: SelectedSiteRepository,
+) : WpApiClient {
+    override suspend fun fetchPosts(
+        site: SiteModel,
+        endpointType: PostEndpointType,
+        filter: PostListFilter,
+        page: UInt,
+    ): PostListPayload {
+        val statuses = filter.statuses.toSet()
+        val pageSize = filter.pageSize.toInt().coerceAtLeast(1)
+        val pageOffset = page.toInt().coerceAtLeast(0) * pageSize
+
+        val matching = postStore.getPages(site.id)
+            .filter { it.status.restValue in statuses }
+            .filter { filter.authorIds.isEmpty() || it.authorId in filter.authorIds }
+            .filter { filter.search.isBlank() || it.title.contains(filter.search, ignoreCase = true) }
+            .let { rows ->
+                when (filter.orderBy) {
+                    PostListOrder.TITLE -> rows.sortedBy { it.title.lowercase() }
+                    PostListOrder.DATE -> rows.sortedBy { it.dateMillis }
+                }
+            }
+
+        val windowed = if (pageOffset >= matching.size) emptyList() else matching.drop(pageOffset).take(pageSize)
+        val pageCount = if (matching.isEmpty()) 1 else (matching.size + pageSize - 1) / pageSize
+        return PostListPayload(items = windowed, page = page, pageCount = pageCount)
+    }
+
+    override suspend fun fetchHomepageSettings(site: SiteModel): HomepageSettingsPayload =
+        HomepageSettingsPayload(
+            pageOnFront = site.pageOnFront,
+            pageForPosts = site.pageForPosts,
+            showOnFront = site.showOnFront,
+        )
+
+    override suspend fun updatePageOnFront(site: SiteModel, pageId: Long): HomepageSettingsPayload =
+        HomepageSettingsPayload(
+            pageOnFront = pageId,
+            pageForPosts = site.pageForPosts,
+            showOnFront = SiteModel.SHOW_ON_FRONT_PAGE,
+        )
+
+    override suspend fun updatePageForPosts(site: SiteModel, pageId: Long): HomepageSettingsPayload =
+        HomepageSettingsPayload(
+            pageOnFront = site.pageOnFront,
+            pageForPosts = pageId,
+            showOnFront = site.showOnFront,
+        )
+
+    companion object {
+        fun create(
+            postStore: PostStore = InMemoryPostStore.instance,
+            siteProvider: SelectedSiteRepository = SelectedSiteCache.instance,
+        ): StoreBackedWpApiClient = StoreBackedWpApiClient(postStore, siteProvider)
+    }
+}
+
+/** Provides the pages client of the application. */
+class SingleWpApiClientProvider(
+    @Volatile var wpApiClient: WpApiClient = StoreBackedWpApiClient.create(),
+) : WpApiClientProvider {
+    override fun getWpApiClient(site: SiteModel): WpApiClient = wpApiClient
+
+    companion object {
+        val instance: SingleWpApiClientProvider = SingleWpApiClientProvider()
+    }
+}
+
+/**
+ * Page mutations.
+ *
+ * Mutations are applied to the store so that the list stays consistent even when the request that
+ * triggered them is not repeated.
+ */
+class StoreBackedPostService(
+    private val postStore: PostStore,
+    private val siteProvider: SelectedSiteRepository,
+) : PostService {
+    override suspend fun trashPost(endpointType: PostEndpointType, pageId: Long) =
+        updateStatus(endpointType, pageId, PostStatus.TRASHED)
+
+    override suspend fun deletePost(endpointType: PostEndpointType, pageId: Long) {
+        val siteId = siteProvider.getSelectedSite()?.id ?: return
+        requirePages(endpointType)
+        postStore.deletePage(siteId, pageId)
+    }
+
+    override suspend fun updatePostStatus(
+        endpointType: PostEndpointType,
+        pageId: Long,
+        status: PostStatus,
+    ) = updateStatus(endpointType, pageId, status)
+
+    private suspend fun updateStatus(endpointType: PostEndpointType, pageId: Long, status: PostStatus) {
+        val siteId = siteProvider.getSelectedSite()?.id ?: return
+        requirePages(endpointType)
+        postStore.updatePageStatus(siteId, pageId, status)
+    }
+
+    private fun requirePages(endpointType: PostEndpointType) {
+        check(endpointType == PostEndpointType.PAGES) { "The pages screen can only mutate pages" }
+    }
+
+    companion object {
+        fun create(
+            postStore: PostStore = InMemoryPostStore.instance,
+            siteProvider: SelectedSiteRepository = SelectedSiteCache.instance,
+        ): StoreBackedPostService = StoreBackedPostService(postStore, siteProvider)
+    }
+}
+
+/** Media service of the application, used to resolve page featured images. */
+class DefaultMediaRestClient(
+    @Volatile var delegate: PostRsRestClient = UnknownMediaUrlsRestClient,
+) : PostRsRestClient {
+    override suspend fun fetchMediaUrls(site: SiteModel, ids: List<Long>, size: Int): Map<Long, String> =
+        delegate.fetchMediaUrls(site, ids, size)
+
+    companion object {
+        val instance: DefaultMediaRestClient = DefaultMediaRestClient()
+    }
+}
+
+/** Media leaf that resolves only what is already known. */
+object UnknownMediaUrlsRestClient : PostRsRestClient {
+    override suspend fun fetchMediaUrls(site: SiteModel, ids: List<Long>, size: Int): Map<Long, String> =
+        emptyMap()
+}
