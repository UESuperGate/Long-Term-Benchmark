+
+  private onThumbnailResolved(pageId: number, url: string, generation: number): void {
+    if (generation !== this.collectionGeneration) {
+      return;
+    }
+    const rows = this.store.rows;
+    let changed: boolean = false;
+    for (const row of rows) {
+      if (row.page.id === pageId) {
+        row.thumbnailUrl = url;
+        changed = true;
+      }
+    }
+    if (changed) {
+      this.store.rows = rows.slice();
+    }
+  }
+
+  private async trashPage(pageId: number): Promise<boolean> {
+    const store = this.store;
+    store.feedback = '';
+    store.error = '';
+    try {
+      await this.service.trash(pageId);
+    } catch (reason) {
+      // The page is preserved locally and the same identity can be retried.
+      store.pendingTrash = pageId;
+      store.error = failureMessage(reason, 'Could not move the page to trash');
+      return false;
+    }
+    store.pendingTrash = undefined;
+    store.feedback = 'Page moved to trash';
+    const remaining: PageRow[] = [];
+    for (const row of store.rows) {
+      if (row.page.id !== pageId) {
+        remaining.push(row);
+      }
+    }
+    store.rows = remaining;
+    if (store.trashedRows.indexOf(pageId) < 0) {
+      store.trashedRows = store.trashedRows.concat([pageId]);
+    }
+    return true;
+  }
