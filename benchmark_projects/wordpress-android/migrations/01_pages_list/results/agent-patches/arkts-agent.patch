+    visited: number[],
+    rows: PageRow[]
+  ): void {
+    if (visited.indexOf(page.id) >= 0) {
+      return;
+    }
+    visited.push(page.id);
+    rows.push(this.toRow(page, depth));
+    for (const candidate of pages) {
+      if (candidate.parentId === page.id) {
+        this.appendSubtree(pages, candidate, depth + 1, visited, rows);
+      }
+    }
+  }
+
+  private toRow(page: PageRecord, depth: number): PageRow {
+    let indent: number = depth;
+    if (indent > MAX_VISUAL_INDENT) {
+      indent = MAX_VISUAL_INDENT;
+    }
+    if (indent < 0) {
+      indent = 0;
+    }
+    const row: PageRow = {
+      id: page.id,
+      title: page.title,
+      page: page,
+      indent: indent,
+      statusLabel: statusLabelOf(page.status)
+    };
+    return row;
+  }
+
+  /**
+   * Resolves featured images in the background. A pending or unavailable thumbnail never removes the
+   * page row and never fails the list.
+   */
+  private resolveThumbnails(pages: PageRecord[], generation: number): void {
+    for (const page of pages) {
+      const mediaId = page.featuredMediaId;
+      if (mediaId === undefined || mediaId <= 0) {
