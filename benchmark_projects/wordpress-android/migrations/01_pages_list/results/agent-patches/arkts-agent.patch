+/**
+ * Actions offered for a page, derived from the page status and from site eligibility.
+ */
+export function computePageMenuActions(
+  status: string | undefined,
+  isHomepage: boolean,
+  isPostsPage: boolean,
+  hasPassword: boolean,
+  isBlazeEligibleSite: boolean,
+  canManageHomepage: boolean
+): string[] {
+  const actions: string[] = [];
+  const state = canonicalStatus(status);
+  if (state === 'trash') {
+    // A trashed page is only restorable or permanently deletable.
+    actions.push(ACTION_RESTORE_TO_DRAFT);
+    actions.push(ACTION_DELETE_PERMANENTLY);
+    return actions;
+  }
+  if (isBlazeEligibleSite && !hasPassword && state !== 'private' && state !== 'inherit') {
+    actions.push(ACTION_BLAZE);
+  }
+  if (isHomepage || isPostsPage) {
+    // The homepage is never promoted, trashed or demoted, and it is never set as the homepage again.
+    return actions;
+  }
+  if (state === 'publish' && canManageHomepage) {
+    actions.push(ACTION_SET_AS_HOMEPAGE);
+  }
+  if (state === 'publish') {
+    actions.push(ACTION_MOVE_TO_DRAFT);
+  }
+  if (state !== 'inherit') {
+    actions.push(ACTION_TRASH);
+  }
+  return actions;
+}
