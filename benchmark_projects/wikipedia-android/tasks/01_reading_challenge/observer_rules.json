{
  "schemaVersion": 1,
  "taskId": "01_reading_challenge",
  "observationMode": "runtime_state_transition",
  "sourceObserverAllowed": false,
  "candidatePathRequired": true,
  "productionEntry": "ArticlePage.openArticle / ReadingChallengePage.refresh or enroll",
  "stateObservations": ["rendered challenge state", "persisted enrollment", "persisted streak", "persisted last-read date"],
  "effectObservations": ["widget update leaf invocation", "heartbeat leaf invocation"],
  "clock": {"kind": "evaluator_input", "productionMutationForbidden": true},
  "failClosed": [
    "missing runtime binding => not_scored",
    "compile failure => not_scored",
    "missing before/after snapshot => not_scored",
    "source text match => diagnostic_only"
  ]
}
