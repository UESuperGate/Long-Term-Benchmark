  "cases": [
    {
      "caseId": "rl_all_articles_deduplicates_memberships",
      "key": "all_articles_deduplicates_memberships",
      "traceSchemaVersion": 2,
      "functionalArea": "reactive_saved_content",
      "setup": [
        {
          "name": "saveArticleThroughSheet",
          "article": "en:Ada_Lovelace",
          "collections": [
            "Saved",
            "People"
          ]
        },
        {
          "name": "saveArticleThroughSheet",
          "article": "en:Paris",
          "collections": [
            "Saved"
          ]
        },
        {
          "name": "saveArticleThroughSheet",
          "article": "fr:Paris",
          "collections": [
            "Places"
          ]
        }
      ],
      "given": {
        "roomLists": [
          {
            "title": "Saved",
            "isDefault": true,
            "articles": [
              "en:Ada_Lovelace",
              "en:Paris"
            ]
          },
          {
            "title": "People",
            "isDefault": false,
            "articles": [
              "en:Ada_Lovelace"
            ]
          },
          {
            "title": "Places",
            "isDefault": false,
            "articles": [
              "fr:Paris"
            ]
          }
        ]
      },
      "event": {
        "name": "openSavedSurface"
      },
      "expected": {
        "state": {
          "selectedTab": "ALL_ARTICLES",
          "phase": "content",
          "articleRows": [
            {
              "article": "en:Ada_Lovelace",
              "containingCollections": [
                "Saved",
                "People"
              ]
            },
            {
              "article": "en:Paris",
              "containingCollections": [
                "Saved"
              ]
            },
            {
              "article": "fr:Paris",
              "containingCollections": [
                "Places"
              ]
            }
          ],
          "hasSavedArticles": true
        },
        "persistence": {
          "roomMembershipsUnchanged": true
        },
        "effects": [
          {
          "name": "collectListsWithPagesFlow"
          }
        ],
        "absentEffects": [
          "duplicate_en_Ada_Lovelace_row",
          "merge_en_Paris_with_fr_Paris",
          "collection_row_in_all_articles",
          "database_write"
        ]
      },
      "invariants": [
        "logical article identity is the pair of wiki language and API title",
        "one All articles row retains every containing collection",
        "the given memberships are established through production save and collection actions"
      ],
      "polarity": {
        "finalPositive": true,
        "baseSemanticFail": "The base opens a legacy list-of-lists surface and has no default ALL_ARTICLES projection that deduplicates across collections."
      },
      "evidence": {
        "androidProduction": [
          "app/src/main/java/org/wikipedia/readinglist/ReadingListsViewModel.kt#selectedTab",
          "app/src/main/java/org/wikipedia/readinglist/ReadingListsViewModel.kt#buildArticleRows",
          "app/src/main/java/org/wikipedia/readinglist/ReadingListsViewModel.kt#ReadingListRow.PageRow"
        ],
        "androidTests": {
          "status": "upstream_gap",
          "inventoryPath": "app/src/androidTest/java/org/wikipedia/tests/ReadingListsTest.kt",
          "assessment": "Unchanged in the boundary; it enters individual legacy lists and has a TODO search helper, so it does not cover the All articles projection."
        },
        "androidRuntimeTrace": {
          "required": true,
          "entryPath": "ReadingListsFragment -> ReadingListsViewModel.uiState -> ReadingListsScreen",
          "checkpoints": [
            "Room memberships before opening Saved",
            "production uiState after the first nonloading Room emission",
            "rendered row types and containing-collection chips"
          ],
          "assertions": [
            "three logical rows",
            "Ada appears once with two containing collections",
            "the two Paris rows remain separate by language",
            "no Room mutation while opening"
          ]
        }
      }
    },
