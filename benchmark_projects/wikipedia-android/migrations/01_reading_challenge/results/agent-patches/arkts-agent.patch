+/**
+ * Production persistence for the reading challenge.
+ *
+ * Reading challenge user data lives in the application preferences file. All
+ * stored dates are ISO local-date strings; the device clock is never rewritten.
+ * Storage failures degrade to an unavailable store instead of tearing the
+ * reading challenge surface down.
+ */
+import { common } from '@kit.AbilityKit';
+import { preferences } from '@kit.ArkData';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+
+import {
+  ChallengePersistence,
+  ChallengePreferences
+} from './ReadingChallengeStore';
+
+export { ChallengePersistence, ChallengePreferences } from './ReadingChallengeStore';
+
+const PREFERENCES_NAME: string = 'wikipedia_reading_challenge';
+const KEY_ENROLLED: string = 'reading_challenge_enrolled';
+const KEY_STREAK: string = 'reading_challenge_streak';
+const KEY_LAST_READ_DATE: string = 'reading_challenge_last_read_date';
+const KEY_ENROLLMENT_DATE: string = 'reading_challenge_enrollment_date';
+const EMPTY_DATE: string = '';
+const LOG_DOMAIN: number = 0x0001;
+const LOG_TAG: string = 'ReadingChallengePrefs';
+
+function emptyPreferences(): ChallengePreferences {
+  const empty: ChallengePreferences = { enrolled: false, streak: 0 };
+  return empty;
+}
+
+function sanitizeStreak(value: number | undefined): number {
+  if (value === undefined || typeof value !== 'number' || !isFinite(value) || value <= 0) {
+    return 0;
+  }
+  return Math.floor(value);
+}
+
+export class ReadingChallengePreferences implements ChallengePersistence {
+  private store: preferences.Preferences | undefined = undefined;
+
+  constructor(store: preferences.Preferences | undefined) {
+    this.store = store;
+  }
+
+  /** Opens the application preferences file that owns the challenge user data. */
+  static async create(context: common.UIAbilityContext): Promise<ReadingChallengePreferences> {
+    try {
+      const store: preferences.Preferences =
+        await preferences.getPreferences(context, { name: PREFERENCES_NAME });
+      return new ReadingChallengePreferences(store);
+    } catch (error) {
+      hilog.error(LOG_DOMAIN, LOG_TAG, 'reading challenge preferences unavailable');
+      return new ReadingChallengePreferences(undefined);
+    }
+  }
+
+  async load(): Promise<ChallengePreferences> {
+    const stored: ChallengePreferences = emptyPreferences();
+    const store: preferences.Preferences | undefined = this.store;
+    if (store === undefined) {
+      return stored;
+    }
+    try {
+      const enrolled: preferences.ValueType = await store.get(KEY_ENROLLED, false);
+      const streak: preferences.ValueType = await store.get(KEY_STREAK, 0);
+      const lastReadDate: preferences.ValueType = await store.get(KEY_LAST_READ_DATE, EMPTY_DATE);
+      const enrollmentDate: preferences.ValueType = await store.get(KEY_ENROLLMENT_DATE, EMPTY_DATE);
+      stored.enrolled = enrolled === true;
+      stored.streak = typeof streak === 'number' ? sanitizeStreak(streak) : 0;
+      if (typeof lastReadDate === 'string' && lastReadDate.length > 0) {
+        stored.lastReadDate = lastReadDate;
+      }
+      if (typeof enrollmentDate === 'string' && enrollmentDate.length > 0) {
+        stored.enrollmentDate = enrollmentDate;
+      }
+    } catch (error) {
+      hilog.error(LOG_DOMAIN, LOG_TAG, 'reading challenge preferences read failed');
+    }
+    return stored;
+  }
+
+  async save(value: ChallengePreferences): Promise<void> {
+    const store: preferences.Preferences | undefined = this.store;
+    if (store === undefined) {
+      return;
+    }
+    try {
+      await store.put(KEY_ENROLLED, value.enrolled === true);
+      await store.put(KEY_STREAK, sanitizeStreak(value.streak));
+      await store.put(KEY_LAST_READ_DATE, typeof value.lastReadDate === 'string' ? value.lastReadDate : EMPTY_DATE);
+      await store.put(KEY_ENROLLMENT_DATE,
+        typeof value.enrollmentDate === 'string' ? value.enrollmentDate : EMPTY_DATE);
+      await store.flush();
+    } catch (error) {
+      hilog.error(LOG_DOMAIN, LOG_TAG, 'reading challenge preferences write failed');
+    }
+  }
+}
