+import { common } from '@kit.AbilityKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+
 import {
   CallbackReadingPageOwner,
+  ReadingIntegrationClock,
+  ReadingIntegrationEffects,
+  ReadingIntegrationInput,
   ReadingIntegrationState,
   ReadingPageOwner
 } from '../integration/ReadingPageIntegration';
+import {
+  ChallengeClock,
+  ChallengeEffects,
+  ChallengeViewState,
+  CHALLENGE_STATE_COMPLETED,
+  CHALLENGE_STATE_CONCLUDED_INCOMPLETE,
+  CHALLENGE_STATE_CONCLUDED_NO_STREAK,
+  CHALLENGE_STATE_ENROLLED_NOT_STARTED,
+  CHALLENGE_STATE_LOADING,
+  CHALLENGE_STATE_NEEDS_READING,
+  CHALLENGE_STATE_NOT_ENROLLED,
+  CHALLENGE_STATE_NOT_LIVE_YET,
+  CHALLENGE_STATE_READ_TODAY,
+  CHALLENGE_STATE_REMOVED,
+  ReadingChallengeStore,
+  SystemChallengeClock
+} from '../model/ReadingChallengeStore';
+import { ReadingChallengePreferences } from '../model/ReadingChallengePreferences';
+
+const CHALLENGE_LOG_DOMAIN: number = 0x0001;
+const CHALLENGE_LOG_TAG: string = 'ReadingChallenge';
+
+/**
+ * Page owned leaf for the reading challenge external effects. Widget delivery
+ * and analytics transport are leaves; the store decides when they run. The
+ * surface binder re-reads the store's resolved state so the rendered challenge
+ * surface always matches persisted state.
+ */
+class PageChallengeEffects implements ChallengeEffects {
+  private readonly surfaceBinder: () => void;
+
+  constructor(surfaceBinder: () => void) {
+    this.surfaceBinder = surfaceBinder;
+  }
+
+  heartbeat(state: ChallengeViewState): void {
+    hilog.info(CHALLENGE_LOG_DOMAIN, CHALLENGE_LOG_TAG,
+      'reading challenge heartbeat state=%{public}s streak=%{public}d', state.name, state.streak);
+  }
+
+  updateWidget(): void {
+    hilog.info(CHALLENGE_LOG_DOMAIN, CHALLENGE_LOG_TAG, 'reading challenge widget update requested');
+  }
+
+  refreshSurface(): void {
+    this.surfaceBinder();
+  }
+}
+
+/** Adapts the page integration clock leaf onto the reading challenge clock. */
+class InjectedChallengeClock implements ChallengeClock {
+  private readonly source: ReadingIntegrationClock;
+
+  constructor(source: ReadingIntegrationClock) {
+    this.source = source;
+  }
+
+  today(): string {
+    return this.source.today();
+  }
+}
+
+function toIntegrationState(state: ChallengeViewState): ReadingIntegrationState {
+  const integrationState: ReadingIntegrationState = { name: state.name, streak: state.streak };
+  return integrationState;
+}
+
+/** Adapts the page integration effect leaf onto the reading challenge effects. */
+class InjectedChallengeEffects implements ChallengeEffects {
+  private readonly source: ReadingIntegrationEffects;
+
+  constructor(source: ReadingIntegrationEffects) {
+    this.source = source;
+  }
+
+  heartbeat(state: ChallengeViewState): void {
+    this.source.heartbeat(toIntegrationState(state));
+  }
+
+  updateWidget(): void {
+    this.source.updateWidget();
+  }
+
+  refreshSurface(): void {
+    this.source.refreshSurface();
+  }
+}
 
 @Entry
 @Component
 struct Index {
   @State articleTitle: string = 'Ada Lovelace';
   @State articleOpen: boolean = false;
+  @State challengeName: string = CHALLENGE_STATE_LOADING;
+  @State challengeStreak: number = 0;
   private runtimeOwnerId: string = 'Index:' + String(Date.now());
+  private store: ReadingChallengeStore | undefined = undefined;
+  private injectedClock: ChallengeClock | undefined = undefined;
+  private injectedEffects: ChallengeEffects | undefined = undefined;
 
   async aboutToAppear(): Promise<void> {
+    const context: common.UIAbilityContext | undefined = this.abilityContext();
+    if (context === undefined) {
+      return;
+    }
+    if (await this.attachStore(context)) {
+      await this.refreshChallengeSurface();
+    }
+  }
+
+  aboutToDisappear(): void {
+    this.store = undefined;
+  }
+
+  private abilityContext(): common.UIAbilityContext | undefined {
+    return this.getUIContext().getHostContext() as common.UIAbilityContext | undefined;
+  }
+
+  private createPageEffects(): ChallengeEffects {
+    return new PageChallengeEffects((): void => {
+      this.bindSurface();
+    });
+  }
+
