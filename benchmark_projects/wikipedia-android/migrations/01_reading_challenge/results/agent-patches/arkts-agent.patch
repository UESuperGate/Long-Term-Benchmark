@@ -0,0 +1,385 @@
+/**
+ * Production reading challenge domain model.
+ *
+ * The store owns the complete reading challenge lifecycle: date gating,
+ * enrollment, per-calendar-day eligibility, streak maintenance, persistence
+ * access and effect dispatch. Everything that talks to the outside world is an
+ * injected leaf (clock, persistence, effects) so the domain rules stay
+ * deterministic and application owned.
+ */
+
+/** Leaf that supplies the current calendar date as an ISO local-date value. */
+export interface ChallengeClock {
+  today(): string;
+}
+
+/** Production clock backed by the device's local wall clock. */
+export class SystemChallengeClock implements ChallengeClock {
+  today(): string {
+    const now: Date = new Date();
+    return formatIsoDate(now.getFullYear(), now.getMonth() + 1, now.getDate());
+  }
+}
+
+/** Persisted reading challenge user data. */
+export interface ChallengePreferences {
+  enrolled: boolean;
+  streak: number;
+  lastReadDate?: string;
+  enrollmentDate?: string;
+}
+
+/** Leaf that stores and restores the reading challenge user data. */
+export interface ChallengePersistence {
+  load(): Promise<ChallengePreferences>;
+  save(value: ChallengePreferences): Promise<void>;
+}
+
+/** Leaf for widget delivery, analytics transport and surface re-binding. */
+export interface ChallengeEffects {
+  heartbeat(state: ChallengeViewState): void;
+  updateWidget(): void;
+  refreshSurface(): void;
+}
+
+/** Resolved state rendered by the reading challenge surface. */
+export interface ChallengeViewState {
+  name: string;
+  streak: number;
+}
+
+export const CHALLENGE_STATE_LOADING: string = 'Loading';
+export const CHALLENGE_STATE_NOT_LIVE_YET: string = 'NotLiveYet';
+export const CHALLENGE_STATE_NOT_ENROLLED: string = 'NotEnrolled';
+export const CHALLENGE_STATE_ENROLLED_NOT_STARTED: string = 'EnrolledNotStarted';
+export const CHALLENGE_STATE_NEEDS_READING: string = 'StreakOngoingNeedsReading';
+export const CHALLENGE_STATE_READ_TODAY: string = 'StreakOngoingReadToday';
+export const CHALLENGE_STATE_COMPLETED: string = 'ChallengeCompleted';
+export const CHALLENGE_STATE_CONCLUDED_INCOMPLETE: string = 'ChallengeConcludedIncomplete';
+export const CHALLENGE_STATE_CONCLUDED_NO_STREAK: string = 'ChallengeConcludedNoStreak';
+export const CHALLENGE_STATE_REMOVED: string = 'ChallengeRemoved';
+
+const MILLISECONDS_PER_DAY: number = 86400000;
+const ISO_LOCAL_DATE_LENGTH: number = 10;
+const ISO_MONTH_SEPARATOR_INDEX: number = 4;
+const ISO_DAY_SEPARATOR_INDEX: number = 7;
+
+/** A calendar day counts for the streak only while it has not been missed yet. */
+const MAX_CONTINUING_GAP_DAYS: number = 1;
+
+function padTwo(value: number): string {
+  return value < 10 ? '0' + String(value) : String(value);
+}
+
+function formatIsoDate(year: number, month: number, day: number): string {
+  return String(year) + '-' + padTwo(month) + '-' + padTwo(day);
+}
+
+/** True when the value is a well formed `yyyy-mm-dd` local date. */
+export function isIsoLocalDate(value: string | undefined): boolean {
+  if (typeof value !== 'string' || value.length !== ISO_LOCAL_DATE_LENGTH) {
+    return false;
+  }
+  if (value.charAt(ISO_MONTH_SEPARATOR_INDEX) !== '-') {
+    return false;
+  }
+  if (value.charAt(ISO_DAY_SEPARATOR_INDEX) !== '-') {
+    return false;
+  }
+  for (let index: number = 0; index < value.length; index++) {
+    if (index === ISO_MONTH_SEPARATOR_INDEX || index === ISO_DAY_SEPARATOR_INDEX) {
+      continue;
+    }
+    const character: string = value.charAt(index);
+    if (character < '0' || character > '9') {
+      return false;
+    }
+  }
+  return true;
+}
+
+/**
+ * Orders two ISO local dates. Unusable values are pushed to the far end so a
+ * malformed stored date can never look like a challenge milestone.
+ */
+export function compareIsoDate(left: string | undefined, right: string | undefined): number {
+  const leftIsDate: boolean = isIsoLocalDate(left);
+  const rightIsDate: boolean = isIsoLocalDate(right);
+  if (leftIsDate !== rightIsDate) {
+    // A missing or malformed value never outranks a real local date.
+    return leftIsDate ? -1 : 1;
+  }
+  if (!leftIsDate || left === undefined || right === undefined) {
+    return 0;
+  }
+  if (left < right) {
+    return -1;
+  }
+  if (left > right) {
+    return 1;
+  }
+  return 0;
+}
+
+/** Calendar days between two ISO local dates; negative when `right` is earlier. */
+export function differenceInDays(left: string | undefined, right: string | undefined): number {
+  if (!isIsoLocalDate(left) || !isIsoLocalDate(right) || left === undefined || right === undefined) {
+    return 0;
+  }
+  const leftYear: number = Number(left.substring(0, ISO_MONTH_SEPARATOR_INDEX));
+  const leftMonth: number = Number(left.substring(ISO_MONTH_SEPARATOR_INDEX + 1, ISO_DAY_SEPARATOR_INDEX));
+  const leftDay: number = Number(left.substring(ISO_DAY_SEPARATOR_INDEX + 1, ISO_LOCAL_DATE_LENGTH));
+  const rightYear: number = Number(right.substring(0, ISO_MONTH_SEPARATOR_INDEX));
+  const rightMonth: number = Number(right.substring(ISO_MONTH_SEPARATOR_INDEX + 1, ISO_DAY_SEPARATOR_INDEX));
+  const rightDay: number = Number(right.substring(ISO_DAY_SEPARATOR_INDEX + 1, ISO_LOCAL_DATE_LENGTH));
+  const leftEpochDay: number = Math.floor(Date.UTC(leftYear, leftMonth - 1, leftDay) / MILLISECONDS_PER_DAY);
+  const rightEpochDay: number = Math.floor(Date.UTC(rightYear, rightMonth - 1, rightDay) / MILLISECONDS_PER_DAY);
+  return rightEpochDay - leftEpochDay;
+}
+
+function createViewState(name: string, streak: number): ChallengeViewState {
+  const viewState: ChallengeViewState = { name: name, streak: streak };
+  return viewState;
+}
+
+/**
+ * Detaches the loaded user data from the persistence leaf so in-memory
+ * maintenance can never mutate stored state without an explicit save.
+ */
+function detachPreferences(source: ChallengePreferences): ChallengePreferences {
+  const detached: ChallengePreferences = {
+    enrolled: source.enrolled === true,
+    streak: normalizeStreak(source.streak)
+  };
+  if (isIsoLocalDate(source.lastReadDate)) {
+    detached.lastReadDate = source.lastReadDate;
+  }
+  if (isIsoLocalDate(source.enrollmentDate)) {
+    detached.enrollmentDate = source.enrollmentDate;
+  }
+  return detached;
+}
+
+/**
+ * Rebuilds the record after a reset. The cleared last-read date is dropped from
+ * the stored record instead of being written as an empty or unusable value.
+ */
+function withoutLastReadDate(source: ChallengePreferences): ChallengePreferences {
+  const cleared: ChallengePreferences = { enrolled: source.enrolled, streak: 0 };
+  if (isIsoLocalDate(source.enrollmentDate)) {
+    cleared.enrollmentDate = source.enrollmentDate;
+  }
+  return cleared;
+}
+
+function normalizeStreak(value: number): number {
+  if (typeof value !== 'number' || !isFinite(value) || value <= 0) {
+    return 0;
+  }
+  return Math.floor(value);
+}
+
+/**
+ * Application owned reading challenge store.
+ *
+ * All date evaluation goes through the injected clock; production preferences
+ * only ever hold ISO local-date strings.
+ */
+export class ReadingChallengeStore {
+  /** Reads required to complete the challenge. */
+  static readonly GOAL: number = 25;
+  /** First day the challenge accepts enrollment and reads. */
+  static readonly START_DATE: string = '2026-05-11';
+  /** Last day an ordinary reading streak is built. */
+  static readonly END_DATE: string = '2026-06-04';
+  /** First day after the post-end buffer; the challenge is removed here. */
+  static readonly REMOVE_DATE: string = '2026-07-04';
+
+  private readonly clock: ChallengeClock;
+  private readonly persistence: ChallengePersistence;
+  private readonly effects: ChallengeEffects;
+
+  state: ChallengeViewState = createViewState(CHALLENGE_STATE_LOADING, 0);
+
+  constructor(clock: ChallengeClock, persistence: ChallengePersistence, effects: ChallengeEffects) {
+    this.clock = clock;
+    this.persistence = persistence;
+    this.effects = effects;
+  }
+
+  /** True once the challenge has started and before it is removed. */
+  static isLiveOn(date: string): boolean {
+    return compareIsoDate(date, ReadingChallengeStore.START_DATE) >= 0 &&
+      compareIsoDate(date, ReadingChallengeStore.REMOVE_DATE) <= 0;
+  }
+
+  /** True while the ordinary reading window is open. */
+  static isAcceptingReadsOn(date: string): boolean {
+    return compareIsoDate(date, ReadingChallengeStore.START_DATE) >= 0 &&
+      compareIsoDate(date, ReadingChallengeStore.END_DATE) <= 0;
+  }
+
+  /** Re-reads persisted data, resolves the surface state and emits no read effects. */
+  async refresh(): Promise<ChallengeViewState> {
+    const today: string = this.clock.today();
+    let preferences: ChallengePreferences = detachPreferences(await this.persistence.load());
+    if (this.hasMissedADay(today, preferences)) {
+      preferences = withoutLastReadDate(preferences);
+      await this.persistence.save(preferences);
+    }
+    return this.publish(this.resolveState(today, preferences), false);
+  }
+
+  /** Enrolls the reader with a zero streak, once and only while the challenge is live. */
+  async enroll(): Promise<ChallengeViewState> {
+    const today: string = this.clock.today();
+    let preferences: ChallengePreferences = detachPreferences(await this.persistence.load());
+    let joined: boolean = false;
+    if (!preferences.enrolled && ReadingChallengeStore.isLiveOn(today)) {
+      const enrollment: ChallengePreferences = { enrolled: true, streak: 0, enrollmentDate: today };
+      await this.persistence.save(enrollment);
+      preferences = enrollment;
+      joined = true;
+    }
+    return this.publish(this.resolveState(today, preferences), joined);
+  }
+
+  /**
+   * Article open entrypoint. Records at most one qualifying read per calendar
+   * day; every other open leaves enrollment, streak and last-read date alone.
+   */
+  async openArticle(): Promise<ChallengeViewState> {
+    const today: string = this.clock.today();
+    let preferences: ChallengePreferences = detachPreferences(await this.persistence.load());
+    let recorded: boolean = false;
+    if (this.canRecordRead(today, preferences)) {
+      if (this.hasMissedADay(today, preferences)) {
+        preferences = withoutLastReadDate(preferences);
+      }
+      if (this.isEligibleForIncrement(today, preferences)) {
+        const read: ChallengePreferences = {
+          enrolled: preferences.enrolled,
+          streak: preferences.streak + 1,
+          lastReadDate: today
+        };
+        if (isIsoLocalDate(preferences.enrollmentDate)) {
+          read.enrollmentDate = preferences.enrollmentDate;
+        }
+        await this.persistence.save(read);
+        preferences = read;
+        recorded = true;
+      }
+    }
+    return this.publish(this.resolveState(today, preferences), recorded);
+  }
+
+  /** Resolves the rendered state and pushes it to the host exactly once. */
+  private publish(state: ChallengeViewState, emitReadEffects: boolean): ChallengeViewState {
+    this.state = state;
+    this.effects.refreshSurface();
+    if (emitReadEffects) {
+      this.effects.updateWidget();
+      this.effects.heartbeat(state);
+    }
+    return state;
+  }
+
+  /**
+   * Enrollment, goal, challenge window and post-end buffer all gate whether an
+   * article open may move the streak at all.
+   */
+  private canRecordRead(today: string, preferences: ChallengePreferences): boolean {
+    if (!preferences.enrolled) {
+      return false;
+    }
+    if (preferences.streak >= ReadingChallengeStore.GOAL) {
+      return false;
+    }
+    if (!ReadingChallengeStore.isLiveOn(today)) {
+      return false;
+    }
+    if (ReadingChallengeStore.isAcceptingReadsOn(today)) {
+      return true;
+    }
+    // Post-end buffer: only a streak that is still active may continue.
+    return this.hasActiveStreak(today, preferences);
+  }
+
+  /** One increment per calendar day, and never backwards in time. */
+  private isEligibleForIncrement(today: string, preferences: ChallengePreferences): boolean {
+    if (!isIsoLocalDate(preferences.lastReadDate)) {
+      return true;
+    }
+    return compareIsoDate(preferences.lastReadDate, today) < 0;
+  }
+
+  /** An incomplete streak survives a gap of at most one day. */
+  private hasActiveStreak(today: string, preferences: ChallengePreferences): boolean {
+    if (!preferences.enrolled || preferences.streak <= 0) {
+      return false;
+    }
+    if (preferences.streak >= ReadingChallengeStore.GOAL) {
+      return false;
+    }
+    if (!isIsoLocalDate(preferences.lastReadDate)) {
+      return false;
+    }
+    const gap: number = differenceInDays(preferences.lastReadDate, today);
+    return gap >= 0 && gap <= MAX_CONTINUING_GAP_DAYS;
+  }
+
+  /**
+   * True when an incomplete streak skipped more than one day while the ordinary
+   * window is open, which is exactly the recoverable missed-day case. The goal
+   * is terminal, and a concluded post-end streak is never rewritten.
+   */
+  private hasMissedADay(today: string, preferences: ChallengePreferences): boolean {
+    if (!ReadingChallengeStore.isAcceptingReadsOn(today)) {
+      return false;
+    }
+    if (!preferences.enrolled || preferences.streak <= 0) {
+      return false;
+    }
+    if (preferences.streak >= ReadingChallengeStore.GOAL) {
+      return false;
+    }
+    if (!isIsoLocalDate(preferences.lastReadDate)) {
+      return false;
+    }
+    return differenceInDays(preferences.lastReadDate, today) > MAX_CONTINUING_GAP_DAYS;
+  }
+
+  /** Pure state resolution for the current date and persisted user data. */
+  private resolveState(today: string, preferences: ChallengePreferences): ChallengeViewState {
+    if (compareIsoDate(today, ReadingChallengeStore.START_DATE) < 0) {
+      return createViewState(CHALLENGE_STATE_NOT_LIVE_YET, 0);
+    }
+    if (compareIsoDate(today, ReadingChallengeStore.REMOVE_DATE) > 0) {
+      return createViewState(CHALLENGE_STATE_REMOVED, 0);
+    }
+    if (!preferences.enrolled) {
+      return createViewState(CHALLENGE_STATE_NOT_ENROLLED, 0);
+    }
+    if (preferences.streak >= ReadingChallengeStore.GOAL) {
+      return createViewState(CHALLENGE_STATE_COMPLETED, preferences.streak);
+    }
+    const readToday: boolean = preferences.lastReadDate === today;
+    if (compareIsoDate(today, ReadingChallengeStore.END_DATE) > 0) {
+      if (this.hasActiveStreak(today, preferences)) {
+        return createViewState(readToday ? CHALLENGE_STATE_READ_TODAY : CHALLENGE_STATE_NEEDS_READING,
+          preferences.streak);
+      }
+      if (preferences.streak > 0) {
+        return createViewState(CHALLENGE_STATE_CONCLUDED_INCOMPLETE, preferences.streak);
+      }
+      return createViewState(CHALLENGE_STATE_CONCLUDED_NO_STREAK, 0);
+    }
+    if (readToday) {
+      return createViewState(CHALLENGE_STATE_READ_TODAY, preferences.streak);
+    }
+    if (preferences.streak > 0) {
+      return createViewState(CHALLENGE_STATE_NEEDS_READING, preferences.streak);
+    }
+    return createViewState(CHALLENGE_STATE_ENROLLED_NOT_STARTED, 0);
+  }
+}
