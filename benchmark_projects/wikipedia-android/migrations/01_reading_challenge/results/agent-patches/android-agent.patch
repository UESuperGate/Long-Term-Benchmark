@@ -0,0 +1,90 @@
+package org.wikipedia.widgets.readingchallenge
+
+import java.time.LocalDate
+
+/**
+ * Lifecycle of the daily article-reading challenge as it is resolved for a single calendar day.
+ *
+ * The challenge runs over a fixed, date-gated window:
+ *
+ *  * before [ReadingChallengeWidgetRepository.START_DATE] nothing is live yet ([NotLiveYet]);
+ *  * between the start date and [ReadingChallengeWidgetRepository.END_DATE] the challenge is
+ *    running and readers may enroll and build a streak;
+ *  * for a short buffer after the end date only a streak that is still alive can continue, any
+ *    other streak is concluded and can no longer be restarted;
+ *  * after the buffer the challenge is removed ([ChallengeRemoved]).
+ */
+sealed interface ReadingChallengeState {
+
+    /** Stable name of the state, used by the surfaces that render the challenge. */
+    val stateName: String
+
+    /** Preferences have not been read yet and no state could be resolved. */
+    object Loading : ReadingChallengeState {
+        override val stateName: String get() = "Loading"
+    }
+
+    /** The challenge window has not opened yet. */
+    object NotLiveYet : ReadingChallengeState {
+        override val stateName: String get() = "NotLiveYet"
+    }
+
+    /** The challenge is running but this reader has not joined it. */
+    object NotEnrolled : ReadingChallengeState {
+        override val stateName: String get() = "NotEnrolled"
+    }
+
+    /** Joined, but no day of the streak has been completed yet (fresh join or after a reset). */
+    object EnrolledNotStarted : ReadingChallengeState {
+        override val stateName: String get() = "EnrolledNotStarted"
+    }
+
+    /** A streak is running and the reader still has to read an article today. */
+    data class StreakOngoingNeedsReading(val streak: Int) : ReadingChallengeState {
+        override val stateName: String get() = "StreakOngoingNeedsReading"
+    }
+
+    /** A streak is running and today's article has already been read. */
+    data class StreakOngoingReadToday(val streak: Int) : ReadingChallengeState {
+        override val stateName: String get() = "StreakOngoingReadToday"
+    }
+
+    /** The streak goal was reached; this is terminal and the streak is never reset again. */
+    object ChallengeCompleted : ReadingChallengeState {
+        override val stateName: String get() = "ChallengeCompleted"
+    }
+
+    /** The challenge ended, the streak broke and the recorded streak is below the goal. */
+    data class ChallengeConcludedIncomplete(val streak: Int) : ReadingChallengeState {
+        override val stateName: String get() = "ChallengeConcludedIncomplete"
+    }
+
+    /** The challenge ended without the reader ever holding a streak. */
+    object ChallengeConcludedNoStreak : ReadingChallengeState {
+        override val stateName: String get() = "ChallengeConcludedNoStreak"
+    }
+
+    /** The conclusion buffer has elapsed and the challenge is no longer shown. */
+    object ChallengeRemoved : ReadingChallengeState {
+        override val stateName: String get() = "ChallengeRemoved"
+    }
+}
+
+/**
+ * Reader-owned challenge facts for [currentDate].
+ *
+ * @param currentDate the calendar day the facts are evaluated against. It is always supplied by
+ * the caller so that date evaluation never depends on a production-stored "today".
+ * @param enabled whether this reader is enrolled in the challenge.
+ * @param currentStreak the persisted number of consecutive completed reading days.
+ * @param hasReadToday whether an article has already been counted for [currentDate].
+ * @param hasActiveStreak whether the streak is still alive, i.e. the previous day (or today) was
+ * read and a read today would still extend the same streak.
+ */
+data class ReadingChallengeUserData(
+    val currentDate: LocalDate,
+    val enabled: Boolean,
+    val currentStreak: Int,
+    val hasReadToday: Boolean,
+    val hasActiveStreak: Boolean
+)
