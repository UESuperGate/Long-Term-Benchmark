diff --git a/app/src/main/upstream/kotlin/org/wikipedia/page/PageActivity.kt b/app/src/main/upstream/kotlin/org/wikipedia/page/PageActivity.kt
index 0ae6bb0..d62e647 100644
--- a/app/src/main/upstream/kotlin/org/wikipedia/page/PageActivity.kt
