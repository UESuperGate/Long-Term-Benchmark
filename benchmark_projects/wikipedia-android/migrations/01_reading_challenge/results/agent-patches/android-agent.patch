+package org.wikipedia.widgets.readingchallenge
+
+import android.content.Context
+import java.time.LocalDate
+import org.wikipedia.settings.Prefs
+
+/**
+ * The eligible "Join" branch of the reading-challenge onboarding.
+ *
+ * Joining is only offered while the challenge window is running and only for a reader who is not
+ * enrolled yet. It persists the enrollment with a zero streak and a zeroed read history, because
+ * joining the challenge is not an article read, and then refreshes the challenge surfaces.
+ */
+class ReadingChallengeEnrollmentAction(context: Context) {
+
+    private val context: Context = context.applicationContext ?: context
+
+    init {
+        // Enrollment persists into the same store the repository owns; make sure it is connected.
+        Prefs.attach(this.context)
+    }
+
+    /** Enrolls this reader for [currentDate] when the challenge is live and enrollment applies. */
+    suspend fun enroll(currentDate: LocalDate) {
+        if (!commitEnrollment(currentDate)) {
+            return
+        }
+        ReadingChallengeWidgetRepository(context).updateWidgetsAndSendAnalytics()
+    }
+
+    /** Returns whether the enrollment was newly persisted. */
+    private fun commitEnrollment(currentDate: LocalDate): Boolean = synchronized(this) {
+        if (Prefs.readingChallengeEnrolled) {
+            // Already joined: keep the streak that is being built rather than restarting it.
+            return@synchronized false
+        }
+        if (currentDate.isBefore(ReadingChallengeWidgetRepository.effectiveStartDate()) ||
+            currentDate.isAfter(ReadingChallengeWidgetRepository.effectiveEndDate())
+        ) {
+            // Joining outside the challenge window is not an eligible branch.
+            return@synchronized false
+        }
+        Prefs.readingChallengeStreak = 0
+        Prefs.readingChallengeLastReadDate = ""
+        Prefs.readingChallengeEnrollmentDate = currentDate.toString()
+        Prefs.readingChallengeEnrolled = true
+        true
+    }
+}
