diff --git a/app/src/main/java/org/wikipedia/widgets/readingchallenge/ReadingChallengeWidgetRepository.kt b/app/src/main/java/org/wikipedia/widgets/readingchallenge/ReadingChallengeWidgetRepository.kt
new file mode 100644
index 0000000..8462680
--- /dev/null
+++ b/app/src/main/java/org/wikipedia/widgets/readingchallenge/ReadingChallengeWidgetRepository.kt
@@ -0,0 +1,300 @@
+package org.wikipedia.widgets.readingchallenge
+
+import android.appwidget.AppWidgetManager
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.SharedPreferences
+import androidx.glance.appwidget.updateAll
+import androidx.preference.PreferenceManager
+import java.time.LocalDate
+import java.time.format.DateTimeParseException
+import java.time.temporal.ChronoUnit
+import kotlinx.coroutines.channels.awaitClose
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.callbackFlow
+import org.wikipedia.WikipediaApp
+import org.wikipedia.settings.Prefs
+
+/**
+ * Application-owned owner of the daily article-reading challenge.
+ *
+ * The repository is the single place that decides whether a day counts as a qualifying read, keeps
+ * the persistent streak consistent, persists it, resolves the reader-facing state and dispatches
+ * the widget/analytics effects. Everything outside of it is a leaf: preference storage, the widget
+ * host and the analytics transport.
+ *
+ * Dates never come from stored production state: every entry point that needs to reason about
+ * "today" takes it from the caller.
+ */
+class ReadingChallengeWidgetRepository(context: Context) {
+
+    private val context: Context = context.applicationContext ?: context
+
+    init {
+        // Every challenge surface goes through this repository, so make sure the preference store
+        // the repository owns is connected before any state is resolved.
+        Prefs.attach(this.context)
+    }
+
+    /**
+     * Emits the resolved challenge state and re-emits it whenever the reading-challenge
+     * preferences change, for example right after a qualifying article read.
+     */
+    fun observeState(): Flow<ReadingChallengeState> = callbackFlow {
+        val preferences = PreferenceManager.getDefaultSharedPreferences(context)
+        fun emitCurrentState() {
+            val currentDate = LocalDate.now()
+            recalculateStreakIfNeeded(currentDate)
+            trySend(resolveState(readUserData(currentDate)))
+        }
+        val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, _ ->
+            emitCurrentState()
+        }
+        preferences.registerOnSharedPreferenceChangeListener(listener)
+        emitCurrentState()
+        awaitClose { preferences.unregisterOnSharedPreferenceChangeListener(listener) }
+    }
+
+    /** Whether an article has already been counted for [currentDate]. */
+    fun hasReadToday(currentDate: LocalDate): Boolean =
+        Prefs.readingChallengeLastReadDate == currentDate.toString()
+
+    /**
+     * Whether the persisted streak is still alive on [currentDate], which is the case when the
+     * reader already read today or read on the immediately preceding day.
+     */
+    fun hasActiveStreak(currentDate: LocalDate): Boolean {
+        if (Prefs.readingChallengeStreak <= 0) {
+            return false
+        }
+        val lastReadDate = Prefs.readingChallengeLastReadDate.toLocalDateOrNull() ?: return false
+        return !lastReadDate.isBefore(currentDate.minusDays(1))
+    }
+
+    /** Reads the persisted challenge facts for [currentDate] without changing them. */
+    fun readUserData(currentDate: LocalDate): ReadingChallengeUserData = ReadingChallengeUserData(
+        currentDate = currentDate,
+        enabled = Prefs.readingChallengeEnrolled,
+        currentStreak = Prefs.readingChallengeStreak,
+        hasReadToday = hasReadToday(currentDate),
+        hasActiveStreak = hasActiveStreak(currentDate)
+    )
+
+    /** Pure state resolution for already gathered reader facts. */
+    fun resolveState(userData: ReadingChallengeUserData): ReadingChallengeState {
+        val currentDate = userData.currentDate
+        if (currentDate.isBefore(effectiveStartDate())) {
+            return ReadingChallengeState.NotLiveYet
+        }
+        if (currentDate.isAfter(effectiveRemoveDate())) {
+            return ReadingChallengeState.ChallengeRemoved
+        }
+        if (!userData.enabled) {
+            return ReadingChallengeState.NotEnrolled
+        }
+        if (userData.currentStreak >= READING_STREAK_GOAL) {
+            return ReadingChallengeState.ChallengeCompleted
+        }
+        if (currentDate.isAfter(effectiveEndDate())) {
+            // Conclusion buffer: only a streak that is still alive may keep going, a broken streak
+            // is concluded for good and reading cannot restart it.
+            if (!userData.hasActiveStreak) {
+                return if (userData.currentStreak > 0) {
+                    ReadingChallengeState.ChallengeConcludedIncomplete(userData.currentStreak)
+                } else {
+                    ReadingChallengeState.ChallengeConcludedNoStreak
+                }
+            }
+        } else if (!userData.hasActiveStreak && !userData.hasReadToday) {
+            // No active streak during the challenge: either a fresh join or a streak that a missed
+            // day reset back to zero.
+            return ReadingChallengeState.EnrolledNotStarted
+        }
+        return if (userData.hasReadToday) {
+            ReadingChallengeState.StreakOngoingReadToday(userData.currentStreak)
+        } else {
+            ReadingChallengeState.StreakOngoingNeedsReading(userData.currentStreak)
+        }
+    }
+
+    /**
+     * Drops a streak that missed more than one day while the challenge was still running. Reached
+     * goals are terminal, and a streak that breaks after the challenge ended is concluded instead
+     * of reset, because it can no longer be recovered by reading again.
+     */
+    fun recalculateStreakIfNeeded(currentDate: LocalDate) {
+        synchronized(this) { resetBrokenStreak(currentDate) }
+    }
+
+    /** Refreshes the widget and reports the current state to analytics. */
+    suspend fun updateWidgetsAndSendAnalytics() {
+        requestWidgetUpdate()
+        val userData = readUserData(LocalDate.now())
+        ReadingChallengeAnalyticsHelper.sendHeartbeatEvent(resolveState(userData))
+    }
+
+    /**
+     * Entry point for opening an article. A day contributes at most one streak increment and only
+     * when the reader is enrolled and the streak may actually continue; otherwise nothing is
+     * persisted and no effect is dispatched.
+     */
+    suspend fun updateOnArticleRead(currentDate: LocalDate) {
+        val userData = synchronized(this) { recordArticleRead(currentDate) } ?: return
+        requestWidgetUpdate()
+        ReadingChallengeAnalyticsHelper.sendHeartbeatEvent(resolveState(userData))
+    }
+
+    /** Hands the re-render request to the widget host, which is an external leaf. */
+    private suspend fun requestWidgetUpdate() {
+        ReadingChallengeWidget().updateAll(context)
+    }
+
+    /**
+     * Applies a qualifying read and returns the resulting reader facts, or `null` when the read
+     * does not qualify and must be ignored without any persistence or effect.
+     */
+    private fun recordArticleRead(currentDate: LocalDate): ReadingChallengeUserData? {
+        if (!isArticleReadQualifying(currentDate)) {
+            return null
+        }
+        Prefs.readingChallengeStreak = Prefs.readingChallengeStreak + 1
+        Prefs.readingChallengeLastReadDate = currentDate.toString()
+        return readUserData(currentDate)
+    }
+
+    /**
+     * Whether a read on [currentDate] advances the challenge.
+     *
+     * The stale streak is recalculated first, so a read that recovers from a missed day starts the
+     * streak again at one instead of extending the abandoned one.
+     */
+    private fun isArticleReadQualifying(currentDate: LocalDate): Boolean {
+        if (!Prefs.readingChallengeEnrolled) {
+            return false
+        }
+        if (currentDate.isBefore(effectiveStartDate()) || currentDate.isAfter(effectiveRemoveDate())) {
+            return false
+        }
+        resetBrokenStreak(currentDate)
+        if (hasReadToday(currentDate)) {
+            // A calendar day contributes at most one increment.
+            return false
+        }
+        if (currentDate.isAfter(effectiveEndDate()) && !hasActiveStreak(currentDate)) {
+            // After the challenge ended only a still-running streak may continue.
+            return false
+        }
+        return true
+    }
+
+    private fun resetBrokenStreak(currentDate: LocalDate) {
+        val streak = Prefs.readingChallengeStreak
+        if (streak <= 0 || streak >= READING_STREAK_GOAL) {
+            // Nothing to reset, and a reached goal is terminal.
+            return
+        }
+        val lastReadDate = Prefs.readingChallengeLastReadDate.toLocalDateOrNull() ?: return
+        if (ChronoUnit.DAYS.between(lastReadDate, currentDate) <= 1) {
+            return
+        }
+        if (currentDate.isAfter(effectiveEndDate())) {
+            // The streak broke after the challenge ended; it is concluded, not recoverable.
+            return
+        }
+        Prefs.readingChallengeStreak = 0
+    }
+
+    companion object {
+
+        /** Number of consecutive reading days that completes the challenge. */
+        const val READING_STREAK_GOAL: Int = 25
+
+        /** Intent extra that carries the "join the challenge" action into the onboarding screen. */
+        const val INTENT_EXTRA_READING_CHALLENGE_JOIN: String = "reading_challenge_join"
+
+        /** Intent extra that marks a widget tap on a completed challenge. */
+        const val INTENT_EXTRA_READING_CHALLENGE_REWARD: String = "reading_challenge_reward"
+
+        /** First day of the challenge window, as an ISO local date. */
+        const val READING_CHALLENGE_START_DATE: String = "2026-05-11"
+
+        /** Last day of the challenge window, as an ISO local date. */
+        const val READING_CHALLENGE_END_DATE: String = "2026-06-04"
+
+        /** Days the concluded challenge stays available after the challenge window closed. */
+        const val READING_CHALLENGE_BUFFER_DAYS: Long = 21L
+
+        val START_DATE: LocalDate = LocalDate.parse(READING_CHALLENGE_START_DATE)
+
+        val END_DATE: LocalDate = LocalDate.parse(READING_CHALLENGE_END_DATE)
+
+        /** First day on which a concluded challenge is no longer shown at all. */
+        val REMOVE_DATE: LocalDate = END_DATE.plusDays(READING_CHALLENGE_BUFFER_DAYS)
+
+        /** Start date in effect, allowing a stored schedule to override the built-in default. */
+        internal fun effectiveStartDate(): LocalDate =
+            Prefs.readingChallengeStartDate.toLocalDateOrNull() ?: START_DATE
+
+        /** End date in effect, allowing a stored schedule to override the built-in default. */
+        internal fun effectiveEndDate(): LocalDate =
+            Prefs.readingChallengeEndDate.toLocalDateOrNull() ?: END_DATE
+
+        /** Removal date in effect, derived from the end date in effect. */
+        internal fun effectiveRemoveDate(): LocalDate =
+            effectiveEndDate().plusDays(READING_CHALLENGE_BUFFER_DAYS)
+
+        /** Whether the challenge widget is currently hosted by the system. */
+        fun isWidgetInstalled(): Boolean {
+            val context = try {
+                WikipediaApp.instance
+            } catch (e: Throwable) {
+                null
+            } ?: return false
+            return try {
+                val provider = ComponentName(context, ReadingChallengeWidgetReceiver::class.java)
+                AppWidgetManager.getInstance(context).getAppWidgetIds(provider)
+                    ?.any { id -> id >= 0 } == true
+            } catch (e: Throwable) {
+                // Widget host queries are a leaf; an unavailable host simply means "not installed".
+                false
+            }
+        }
+
+        /** Whether the join dialog should still be offered to this reader. */
+        fun shouldShowOnboardingDialog(): Boolean = isJoinDialogDue()
+
+        /** Whether the widget install prompt should still be offered to this reader. */
+        fun shouldShowWidgetInstallDialog(): Boolean =
+            isJoinDialogDue() && !isWidgetInstalled()
+
+        /** Whether the completed-challenge reward should be presented for [intent]. */
+        fun shouldShowReward(intent: Intent): Boolean {
+            if (!intent.getBooleanExtra(INTENT_EXTRA_READING_CHALLENGE_REWARD, false)) {
+                return false
+            }
+            return Prefs.readingChallengeEnrolled &&
+                Prefs.readingChallengeStreak >= READING_STREAK_GOAL
+        }
+
+        private fun isJoinDialogDue(): Boolean {
+            if (Prefs.readingChallengeOnboardingShown || Prefs.readingChallengeEnrolled) {
+                return false
+            }
+            val currentDate = LocalDate.now()
+            return !currentDate.isBefore(effectiveStartDate()) &&
+                !currentDate.isAfter(effectiveRemoveDate())
+        }
+    }
+}
+
+private fun String.toLocalDateOrNull(): LocalDate? {
+    if (isBlank()) {
+        return null
+    }
+    return try {
+        LocalDate.parse(this)
+    } catch (e: DateTimeParseException) {
+        null
+    }
+}
