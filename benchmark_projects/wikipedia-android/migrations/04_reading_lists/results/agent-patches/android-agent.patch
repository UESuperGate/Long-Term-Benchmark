+package org.wikipedia.readinglist
+
+import org.wikipedia.dataclients.RedirectResolver
+import org.wikipedia.page.PageTitle
+import org.wikipedia.util.ProductionLog
+
+/**
+ * Per-article state behind the Save sheet.
+ *
+ * Opening the sheet for an article makes sure the article is saved first - into the default
+ * collection - and then presents the collections it currently belongs to. Toggling a collection
+ * row resolves the collection by id at the moment of the tap; a row that was rendered before the
+ * collection disappeared therefore finds nothing and does nothing.
+ */
+class ReadingListArticleActions(
+    internal val manager: ReadingListManager,
+    private val redirectResolver: RedirectResolver,
+    private val log: ProductionLog
+) {
+    private val sheets = LinkedHashMap<String, ArticleSheetState>()
+
+    fun sheetState(title: PageTitle): ArticleSheetState =
+        sheets.getOrPut(title.logicalKey) { ArticleSheetState(title) }.also { it.refresh(this) }
+
+    /** Resolves the identity, then makes sure the article is saved in the default collection. */
+    fun ensureSaved(requested: PageTitle): MembershipChange {
+        log.record("ReadingListArticleActions.ensureSaved:${requested.logicalKey}")
+        val resolved = redirectResolver.resolve(requested)
+        val defaultCollection = manager.ensureDefaultCollection()
+        val result = manager.addPageToReadingList(defaultCollection, resolved)
+        sheets[resolved.logicalKey]?.let { it.refresh(this) }
+        return result
+    }
+
+    fun createCollectionAndAdd(title: PageTitle, collectionTitle: String): MembershipChange {
+        log.record("ReadingListArticleActions.createCollectionAndAdd:$collectionTitle")
+        val created = manager.createUserCollection(collectionTitle)
+        if (created is CollectionChange.Rejected) {
+            return MembershipChange.Rejected(title, created.reason, created.message)
+        }
+        val list = (created as CollectionChange.Applied).list
+        return manager.addPageToReadingList(list, title)
+    }
+
+    fun toggleCollection(title: PageTitle, collectionId: Long): MembershipChange {
+        log.record("ReadingListArticleActions.toggleCollection:$collectionId")
+        val result = manager.toggleCollection(title, collectionId)
+        sheets[title.logicalKey]?.refresh(this)
+        return result
+    }
+
+    /**
+     * Removes every membership of [title], asking for confirmation first when the article is
+     * held by at least one user-created collection. Holding only the default collection needs no
+     * confirmation.
+     */
+    fun unsave(title: PageTitle): UnsaveOutcome {
+        log.record("ReadingListArticleActions.unsave:${title.logicalKey}")
+        val collections = manager.memberships(title)
+        if (collections.isEmpty()) {
+            return UnsaveOutcome.Removed
+        }
+        val named = collections.filter { !it.isDefault }.map { it.title }
+        return if (named.isEmpty()) {
+            performUnsave(title)
+            UnsaveOutcome.Removed
+        } else {
+            UnsaveOutcome.NeedsConfirmation(named)
+        }
+    }
+
+    /** The confirmation step; only reached when the reader accepted it. */
+    fun confirmUnsave(title: PageTitle): UnsaveOutcome {
+        log.record("ReadingListArticleActions.confirmUnsave:${title.logicalKey}")
+        return performUnsave(title)
+    }
+
+    private fun performUnsave(title: PageTitle): UnsaveOutcome {
+        manager.removePageFromAllReadingLists(title)
+        sheets[title.logicalKey]?.refresh(this)
+        return UnsaveOutcome.Removed
+    }
+}
+
+/** Live state rendered by one Save sheet. */
+class ArticleSheetState(val requestedTitle: PageTitle) {
+    var resolvedTitle: PageTitle = requestedTitle
+        internal set
+    var isSaved: Boolean = false
+        internal set
+    var collections: List<ReadList> = emptyList()
+        internal set
+    var pendingUnsaveConfirmation: Boolean = false
+        internal set
+    var confirmationCollections: List<String> = emptyList()
+        internal set
+    var lastChange: MembershipChange? = null
+        internal set
+
+    internal fun refresh(actions: ReadingListArticleActions) {
+        isSaved = actions.manager.memberships(resolvedTitle).isNotEmpty()
+        collections = actions.manager.collections()
+    }
+
+    internal fun markResolved(title: PageTitle) {
+        resolvedTitle = title
+    }
+}
