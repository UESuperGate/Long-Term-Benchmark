@@ -0,0 +1,90 @@
+package org.wikipedia.readinglist
+
+import android.os.Handler
+import android.os.Looper
+
+/** Handle for a task queued on a [SavedScheduler]. */
+interface ScheduledTask {
+    fun cancel()
+}
+
+/**
+ * Timing seam used for the search debounce and for anything else the Saved surface defers.
+ *
+ * Production posts onto the main looper; a caller that needs deterministic ordering can drive a
+ * scheduler it controls instead, which is how the debounce window is exercised exactly.
+ */
+interface SavedScheduler {
+    fun postDelayed(delayMillis: Long, task: Runnable): ScheduledTask
+
+    companion object {
+        /** Search input is only applied once the reader stops typing for this long. */
+        const val SEARCH_DEBOUNCE_DELAY_MS = 150L
+
+        fun mainThread(): SavedScheduler = MainThreadSavedScheduler()
+
+        fun manual(): ManualSavedScheduler = ManualSavedScheduler()
+    }
+}
+
+class MainThreadSavedScheduler : SavedScheduler {
+    private var handler: Handler? = null
+
+    private fun handler(): Handler {
+        val existing = handler
+        if (existing != null) {
+            return existing
+        }
+        val created = Handler(Looper.getMainLooper())
+        handler = created
+        return created
+    }
+
+    override fun postDelayed(delayMillis: Long, task: Runnable): ScheduledTask {
+        val target = handler()
+        target.postDelayed(task, delayMillis)
+        return object : ScheduledTask {
+            override fun cancel() {
+                target.removeCallbacks(task)
+            }
+        }
+    }
+}
+
+/** Scheduler whose clock only moves when the caller advances it. */
+class ManualSavedScheduler : SavedScheduler {
+    private var now = 0L
+    private val pending = mutableListOf<Pending>()
+
+    private data class Pending(val dueAt: Long, val task: Runnable, var cancelled: Boolean)
+
+    val nowMillis: Long get() = now
+
+    val pendingCount: Int get() = pending.count { !it.cancelled }
+
+    override fun postDelayed(delayMillis: Long, task: Runnable): ScheduledTask {
+        val entry = Pending(now + delayMillis, task, false)
+        pending.add(entry)
+        return object : ScheduledTask {
+            override fun cancel() {
+                entry.cancelled = true
+            }
+        }
+    }
+
+    /** Moves the clock forward and runs everything that has come due, in due order. */
+    fun advanceBy(millis: Long) {
+        now += millis
+        runDueTasks()
+    }
+
+    fun runDueTasks() {
+        while (true) {
+            val due = pending.filter { !it.cancelled && it.dueAt <= now }.minByOrNull { it.dueAt }
+                ?: break
+            pending.remove(due)
+            due.task.run()
+        }
+        pending.removeAll { it.cancelled }
+    }
+}
