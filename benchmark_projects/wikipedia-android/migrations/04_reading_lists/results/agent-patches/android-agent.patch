@@ -0,0 +1,106 @@
+package org.wikipedia.readinglist
+
+import org.wikipedia.page.PageTitle
+import org.wikipedia.util.ProductionLog
+
+/** What an article looked like before a destructive action. */
+data class ArticleMembershipSnapshot(
+    val listId: Long,
+    val listTitle: String,
+    val title: PageTitle
+)
+
+/** What a collection looked like before a destructive action. */
+data class CollectionSnapshot(
+    val id: Long,
+    val title: String,
+    val description: String?,
+    val isRemote: Boolean
+)
+
+/** A pending, reversible destructive action. */
+sealed class UndoAction {
+    abstract val description: String
+
+    data class RemoveArticles(
+        val articles: List<PageTitle>,
+        val memberships: List<ArticleMembershipSnapshot>
+    ) : UndoAction() {
+        override val description: String get() = "Removed ${articles.size} article(s)"
+    }
+
+    data class RemoveCollections(
+        val collections: List<CollectionSnapshot>
+    ) : UndoAction() {
+        override val description: String get() = "Removed ${collections.size} collection(s)"
+    }
+}
+
+/**
+ * Single-slot undo for destructive actions on the Saved surfaces.
+ *
+ * Deleting rows stages them so they vanish from the projection immediately while the action is
+ * still reversible. Undo drops the staged rows and re-creates exactly the memberships - or the
+ * collections - that existed before, by logical identity; database row ids may differ afterwards.
+ * Rows that were not part of the action are never touched.
+ */
+class ReadingListUndo(
+    private val manager: ReadingListManager,
+    private val log: ProductionLog? = null
+) {
+    var pending: UndoAction? = null
+        private set
+
+    val isAvailable: Boolean get() = pending != null
+
+    val description: String? get() = pending?.description
+
+    fun trackArticles(articles: List<PageTitle>, memberships: List<ArticleMembershipSnapshot>) {
+        if (articles.isEmpty()) {
+            return
+        }
+        pending = UndoAction.RemoveArticles(articles, memberships)
+        log?.record("ReadingListUndo.trackArticles:${articles.size}")
+    }
+
+    fun trackCollections(collections: List<CollectionSnapshot>) {
+        if (collections.isEmpty()) {
+            return
+        }
+        pending = UndoAction.RemoveCollections(collections)
+        log?.record("ReadingListUndo.trackCollections:${collections.size}")
+    }
+
+    /** Restores the pending action. Returns false when there is nothing to restore. */
+    fun undo(): Boolean {
+        val action = pending ?: return false
+        when (action) {
+            is UndoAction.RemoveArticles -> {
+                action.articles.forEach { manager.purgeArticle(it) }
+                action.memberships.forEach { membership ->
+                    val list = manager.findListById(membership.listId)
+                        ?: manager.findListByTitle(membership.listTitle)
+                    if (list != null) {
+                        manager.addPageToReadingList(list, membership.title)
+                    }
+                }
+            }
+            is UndoAction.RemoveCollections -> {
+                action.collections.forEach { snapshot ->
+                    manager.createCollection(
+                        title = snapshot.title,
+                        description = snapshot.description,
+                        isRemote = snapshot.isRemote
+                    )
+                }
+            }
+        }
+        pending = null
+        log?.record("ReadingListUndo.undo")
+        return true
+    }
+
+    fun clear() {
+        pending = null
+    }
+}
