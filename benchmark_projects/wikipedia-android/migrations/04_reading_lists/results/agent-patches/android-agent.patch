@@ -0,0 +1,44 @@
+package org.wikipedia.auth
+
+import org.wikipedia.database.QueryFlow
+
+/**
+ * The signed-in account as the Saved stack needs it.
+ *
+ * [isTemporaryAccount] marks a throw-away account; such an account is signed in but is *not*
+ * eligible for reading list synchronization, so a pull-to-refresh from one prompts for login
+ * instead of dispatching a sync.
+ */
+data class AccountInfo(
+    val isLoggedIn: Boolean = false,
+    val isTemporaryAccount: Boolean = false,
+    val userName: String? = null
+) {
+    val isEligibleForSync: Boolean get() = isLoggedIn && !isTemporaryAccount
+}
+
+class AccountStateHolder(initial: AccountInfo = AccountInfo()) {
+    private var current = initial
+    private val flow = QueryFlow { current }
+
+    val account: AccountInfo get() = current
+
+    fun observe() = flow
+
+    fun onLogin(userName: String?, temporary: Boolean = false) {
+        current = AccountInfo(isLoggedIn = true, isTemporaryAccount = temporary, userName = userName)
+        flow.invalidate()
+    }
+
+    fun onLogout() {
+        current = AccountInfo()
+        flow.invalidate()
+    }
+
+    fun update(account: AccountInfo) {
+        if (account != current) {
+            current = account
+            flow.invalidate()
+        }
+    }
+}
