+package org.wikipedia.readinglist
+
+import org.wikipedia.offline.ArticleOfflineStatus
+import org.wikipedia.page.PageTitle
+import org.wikipedia.util.jsonArrayOf
+import org.wikipedia.util.jsonOf
+import org.json.JSONObject
+
+/** The two top level views of the Saved experience. */
+enum class SavedTab {
+    ALL_ARTICLES,
+    COLLECTIONS;
+
+    companion object {
+        fun parse(value: String?): SavedTab? = entries.firstOrNull {
+            it.name.equals(value, ignoreCase = true) || it.name.equals(value?.replace("-", "_"), ignoreCase = true)
+        }
+    }
+}
+
+/**
+ * Narrowing available on the All articles tab.
+ *
+ * [NOT_IN_COLLECTION] keeps only articles whose *complete* set of containing collections is the
+ * default collection - an article that is also in any user-created collection is excluded, even
+ * when it is also in Saved.
+ */
+enum class ArticleFilter {
+    ALL_ARTICLES,
+    NOT_IN_COLLECTION;
+
+    companion object {
+        fun parse(value: String?): ArticleFilter? = entries.firstOrNull { it.name.equals(value, ignoreCase = true) }
+    }
+}
+
+/**
+ * Sort choices offered per view. Ordinals are persisted, so the numbering is part of the
+ * durable format: name ascending is 0 and name descending is 1.
+ */
+enum class ReadingListSortMode(val preferenceKey: String) {
+    SORT_BY_NAME_ASC("sort_by_name_asc"),
+    SORT_BY_NAME_DESC("sort_by_name_desc"),
+    SORT_BY_NEWEST_FIRST("sort_by_newest_first"),
+    SORT_BY_OLDEST_FIRST("sort_by_oldest_first");
+
+    companion object {
+        fun parse(value: String?): ReadingListSortMode? = entries.firstOrNull { it.name.equals(value, ignoreCase = true) }
+
+        fun fromOrdinal(value: Int): ReadingListSortMode = entries.getOrElse(value) { SORT_BY_NAME_ASC }
+    }
+}
+
+/** Actions the overflow menu offers; they differ per tab because the row types differ. */
+enum class SavedMenuAction {
+    SORT,
+    FILTER,
+    SELECT_ALL,
+    DELETE,
+    NEW_COLLECTION
+}
+
+enum class SavedRecoveryAction {
+    NONE,
+    CLEAR_SEARCH,
+    START_SYNC,
+    LOG_IN,
+    CREATE_COLLECTION
+}
+
+/** Why the current view shows nothing. Loading is deliberately distinct from empty. */
+sealed class SavedEmptyState {
+    object NONE : SavedEmptyState()
+    object LOADING : SavedEmptyState()
+    data class SEARCH_NO_RESULTS(val query: String) : SavedEmptyState()
+    object NO_SAVED_ARTICLES : SavedEmptyState()
+    object NO_COLLECTIONS : SavedEmptyState()
+}
+
+/** Prompt shown alongside the rows; driven by login, sync preference and shared-list receipt. */
+enum class SavedOnboardingState {
+    NONE,
+    LOGIN_PROMPT,
+    SYNC_REMINDER,
+    SHARED_COLLECTION_RECEIVED;
+
+    companion object {
+        fun parse(value: String?): SavedOnboardingState? {
+            val candidate = value?.replace(" ", "")?.replace("_", "") ?: return null
+            return entries.firstOrNull {
+                it.name.equals(value, ignoreCase = true) || it.name.replace("_", "").equals(candidate, ignoreCase = true)
+            }
+        }
+    }
+}
+
+/** Transient feedback the surface shows after an action. */
+enum class SavedFeedback {
+    NONE,
+    SYNCED,
+    SYNC_FAILED,
+    LOGIN_REQUIRED,
+    LIMIT_REACHED,
+    ARTICLE_SAVED,
+    ARTICLE_UNSAVED,
+    COLLECTION_CREATED,
+    COLLECTION_DELETED,
+    ARTICLES_DELETED,
+    COLLECTIONS_DELETED,
+    RESTORED,
+    NOTHING_SELECTED,
+    COLLECTION_UNAVAILABLE
+}
+
+/**
+ * One row of the All articles tab.
+ *
+ * An article that lives in several collections still produces exactly one row; [collectionTitles]
+ * retains every collection it belongs to and [id] is the single membership row id used for
+ * selection, so a logical article can never be selected twice.
+ */
+data class SavedArticleRow(
+    val id: Long,
+    val title: PageTitle,
+    val collectionTitles: List<String>,
+    val isInDefaultCollection: Boolean,
+    val offlineStatus: ArticleOfflineStatus,
+    val downloadProgress: Int
+) {
+    /** True when the article belongs to at least one user-created collection. */
+    val isInUserCollection: Boolean
+        get() = collectionTitles.any { it != ReadList.DEFAULT_TITLE }
+
+    /** Removing this article drops more than the default membership, so it needs confirmation. */
+    val requiresUnsaveConfirmation: Boolean get() = isInUserCollection
+
+    val hasActiveDownload: Boolean get() = offlineStatus == ArticleOfflineStatus.DOWNLOADING
+
+    fun toJson(): JSONObject = jsonOf(
+        "id" to id,
+        "article" to title.logicalKey,
+        "displayTitle" to title.displayTitle,
+        "collections" to jsonArrayOf(collectionTitles),
+        "isInDefaultCollection" to isInDefaultCollection,
+        "requiresUnsaveConfirmation" to requiresUnsaveConfirmation,
+        "offlineStatus" to offlineStatus.name,
+        "downloadProgress" to downloadProgress
+    )
+}
+
+/** One row of the Collections tab. The default collection is never a row here. */
+data class SavedCollectionRow(
+    val id: Long,
+    val title: String,
+    val description: String?,
+    val articleCount: Int,
+    val isDefault: Boolean
+) {
+    fun toJson(): JSONObject = jsonOf(
+        "id" to id,
+        "title" to title,
+        "description" to description,
+        "articleCount" to articleCount,
+        "isDefault" to isDefault
+    )
+}
+
+/**
+ * Everything the Saved surface renders, for the tab that is currently selected.
+ *
+ * The state is reduced from the database projections plus the account and sync inputs; it is the
+ * only thing the UI reads, and it always describes presentation rather than stored membership.
+ */
+data class SavedUiState(
+    val selectedTab: SavedTab = SavedTab.ALL_ARTICLES,
+    val searchQuery: String = "",
+    val appliedSearchQuery: String = "",
+    val articleFilter: ArticleFilter = ArticleFilter.ALL_ARTICLES,
+    val articleSortMode: ReadingListSortMode = ReadingListSortMode.SORT_BY_NAME_ASC,
+    val collectionSortMode: ReadingListSortMode = ReadingListSortMode.SORT_BY_NAME_ASC,
+    val selectionEnabled: Boolean = false,
+    val selectedPageIds: List<Long> = emptyList(),
+    /** True while a destructive action is waiting for the reader to accept or cancel. */
+    val pendingDeleteConfirmation: Boolean = false,
+    val isRefreshing: Boolean = false,
+    val isLoading: Boolean = true,
+    val onboarding: SavedOnboardingState = SavedOnboardingState.NONE,
+    val feedback: SavedFeedback = SavedFeedback.NONE,
+    val feedbackMessage: String? = null,
+    val menuActions: List<SavedMenuAction> = emptyList(),
+    val sortChoices: List<ReadingListSortMode> = emptyList(),
+    val emptyState: SavedEmptyState = SavedEmptyState.LOADING,
+    val recoveryAction: SavedRecoveryAction = SavedRecoveryAction.NONE,
+    val articleRows: List<SavedArticleRow> = emptyList(),
+    val collectionRows: List<SavedCollectionRow> = emptyList(),
+    val undoDescription: String? = null,
+    /**
+     * Badge for the Saved entry point: how many logical articles are saved. It is deliberately
+     * independent of the active tab, the search query and the filter, and it survives sign-out
+     * because locally saved articles stay on the device.
+     */
+    val totalSavedCount: Int = 0
+) {
+    val undoAvailable: Boolean get() = undoDescription != null
+
+    val totalSavedArticleCount: Int get() = articleRows.size
+
+    fun toJson(): JSONObject = jsonOf(
+        "selectedTab" to selectedTab.name,
+        "searchQuery" to searchQuery,
+        "appliedSearchQuery" to appliedSearchQuery,
+        "articleFilter" to articleFilter.name,
+        "articleSortMode" to articleSortMode.name,
+        "collectionSortMode" to collectionSortMode.name,
+        "selectionEnabled" to selectionEnabled,
+        "selectedPageIds" to jsonArrayOf(selectedPageIds),
+        "pendingDeleteConfirmation" to pendingDeleteConfirmation,
+        "isRefreshing" to isRefreshing,
+        "isLoading" to isLoading,
+        "onboarding" to onboarding.name,
+        "feedback" to feedback.name,
+        "feedbackMessage" to feedbackMessage,
+        "menuActions" to jsonArrayOf(menuActions.map { it.name }),
+        "sortChoices" to jsonArrayOf(sortChoices.map { it.name }),
+        "emptyState" to emptyStateJson(),
+        "recoveryAction" to recoveryAction.name,
+        "articleRows" to jsonArrayOf(articleRows.map { it.toJson() }),
+        "collectionRows" to jsonArrayOf(collectionRows.map { it.toJson() }),
+        "undoAvailable" to undoAvailable,
+        "undoDescription" to undoDescription,
+        "totalSavedCount" to totalSavedCount
+    )
+
+    private fun emptyStateJson(): JSONObject = when (val state = emptyState) {
+        is SavedEmptyState.SEARCH_NO_RESULTS -> jsonOf("state" to "SEARCH_NO_RESULTS", "query" to state.query)
+        else -> jsonOf("state" to state::class.simpleName)
+    }
+}
+
+/** Sort helpers shared by both views. */
+internal object SavedSorting {
+
+    fun <T> byName(mode: ReadingListSortMode, key: (T) -> String): Comparator<T> =
+        Comparator { left, right ->
+            val comparison = key(left).lowercase().compareTo(key(right).lowercase())
+            if (mode == ReadingListSortMode.SORT_BY_NAME_DESC) -comparison else comparison
+        }
+
+    fun <T> byRecency(
+        mode: ReadingListSortMode,
+        key: (T) -> String,
+        recency: (T) -> Long
+    ): Comparator<T> = when (mode) {
+        ReadingListSortMode.SORT_BY_NEWEST_FIRST -> Comparator { left, right ->
+            recency(right).compareTo(recency(left)).takeIf { it != 0 } ?: key(left).compareTo(key(right))
+        }
+        ReadingListSortMode.SORT_BY_OLDEST_FIRST -> Comparator { left, right ->
+            recency(left).compareTo(recency(right)).takeIf { it != 0 } ?: key(left).compareTo(key(right))
+        }
+        else -> byName(mode, key)
+    }
+}
