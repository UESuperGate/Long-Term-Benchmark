@@ -0,0 +1,58 @@
+package org.wikipedia.dataclients
+
+import org.wikipedia.page.PageTitle
+import org.wikipedia.util.ProductionLog
+import java.io.IOException
+
+/** Page metadata as returned by the wiki API. */
+data class PageMetadata(
+    val languageCode: String,
+    val apiTitle: String,
+    val displayTitle: String
+)
+
+/**
+ * External HTTP boundary.
+ *
+ * Everything above this interface is application-owned; everything below it is a leaf. The
+ * production app supplies a wiki-API backed implementation. A `null` service means no network is
+ * reachable, which is what the offline path looks like from the caller's point of view.
+ */
+fun interface WikiService {
+    @Throws(IOException::class)
+    fun getPageMetadata(languageCode: String, apiTitle: String): PageMetadata
+}
+
+/**
+ * Resolves the canonical identity of an article before it is persisted.
+ *
+ * Saving must never depend on the network being available. If the metadata request cannot be
+ * served - the device is offline or the request fails - the original language and API title are
+ * used unchanged, so the persisted identity is always the one the reader acted on.
+ */
+class RedirectResolver(
+    private val service: WikiService?,
+    private val log: ProductionLog? = null
+) {
+    fun resolve(title: PageTitle): PageTitle {
+        val client = service
+        if (client == null) {
+            log?.record("RedirectResolver.resolve:offline")
+            return title
+        }
+        return try {
+            val metadata = client.getPageMetadata(title.languageCode, title.apiTitle)
+            log?.record("RedirectResolver.resolve:resolved")
+            PageTitle(metadata.languageCode, metadata.apiTitle, metadata.displayTitle)
+        } catch (e: IOException) {
+            log?.record("RedirectResolver.resolve:io_failure")
+            title
+        } catch (e: WikiApiException) {
+            log?.record("RedirectResolver.resolve:api_failure")
+            title
+        }
+    }
+}
+
+/** Non-I/O failure reported by the wiki API; also handled by falling back to the original title. */
+class WikiApiException(message: String, cause: Throwable? = null) : RuntimeException(message, cause)
