@@ -0,0 +1,103 @@
+package org.wikipedia.readinglist
+
+import org.wikipedia.database.KeyValueStore
+import org.wikipedia.page.PageTitle
+
+/**
+ * Outcome of a reading list synchronization pass.
+ *
+ * The refresh spinner on the Saved surface stays up from [isRunning] until a terminal event
+ * arrives; only the transport reports those events, and it is a leaf boundary.
+ */
+class ReadingListSyncEvent private constructor(
+    val status: Status,
+    val cause: Throwable? = null
+) {
+    val isRunning: Boolean get() = status == Status.RUNNING
+    val isError: Boolean get() = status == Status.ERROR
+
+    val isTerminal: Boolean get() = status == Status.COMPLETED || status == Status.ERROR
+
+    enum class Status { RUNNING, COMPLETED, ERROR }
+
+    companion object {
+        fun started() = ReadingListSyncEvent(Status.RUNNING)
+
+        fun finished() = ReadingListSyncEvent(Status.COMPLETED)
+
+        fun error(cause: Throwable? = null) = ReadingListSyncEvent(Status.ERROR, cause)
+    }
+}
+
+/**
+ * Reading list synchronization.
+ *
+ * The Saved surface owns two things here: whether sync is enabled for the account, and the
+ * lifecycle of a refresh. Dispatching a sync is an external effect - the transport is a leaf -
+ * but deciding *whether* to dispatch, keeping the refresh state alive until an event arrives,
+ * and applying the resulting memberships are all application-owned.
+ */
+class ReadingListSync(
+    private val manager: ReadingListManager,
+    private val store: KeyValueStore,
+    private val log: org.wikipedia.util.ProductionLog? = null
+) {
+    private val listeners = mutableListOf<(ReadingListSyncEvent) -> Unit>()
+
+    /** One remote collection as reported by the sync transport. */
+    data class RemoteList(val title: String, val articles: List<PageTitle>)
+
+    /** Transport that performs the actual network work; a leaf boundary. */
+    fun interface Transport {
+        fun start(account: org.wikipedia.auth.AccountInfo, remote: List<RemoteList>)
+    }
+
+    var transport: Transport? = null
+
+    fun addListener(listener: (ReadingListSyncEvent) -> Unit) {
+        listeners.add(listener)
+    }
+
+    fun removeListener(listener: (ReadingListSyncEvent) -> Unit) {
+        listeners.remove(listener)
+    }
+
+    fun isSyncEnabled(): Boolean = store.getBoolean(KEY_SYNC_ENABLED, false)
+
+    fun setSyncEnabled(enabled: Boolean) {
+        store.putBoolean(KEY_SYNC_ENABLED, enabled)
+        log?.record("ReadingListSync.setSyncEnabled:$enabled")
+    }
+
+    /**
+     * Starts a sync pass and applies the resulting memberships locally so the database
+     * projections update immediately, while the pass itself is still running.
+     */
+    fun start(account: org.wikipedia.auth.AccountInfo, remote: List<RemoteList>) {
+        log?.record("ReadingListSync.start")
+        emit(ReadingListSyncEvent.started())
+        applyRemote(remote)
+        transport?.start(account, remote)
+    }
+
+    /** Delivers a transport-reported event to every listener. */
+    fun onEvent(event: ReadingListSyncEvent) {
+        log?.record("ReadingListSync.onEvent:${event.status}")
+        emit(event)
+    }
+
+    private fun applyRemote(remote: List<RemoteList>) {
+        remote.forEach { list ->
+            val target = manager.findListByTitle(list.title) ?: manager.createCollection(list.title, isRemote = true)
+            list.articles.forEach { manager.addPageToReadingList(target, it) }
+        }
+    }
+
+    private fun emit(event: ReadingListSyncEvent) {
+        listeners.toList().forEach { it(event) }
+    }
+
+    companion object {
+        private const val KEY_SYNC_ENABLED = "reading_list_sync_enabled"
+    }
+}
