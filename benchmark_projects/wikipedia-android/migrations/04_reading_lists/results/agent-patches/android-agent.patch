@@ -0,0 +1,52 @@
+package org.wikipedia.database
+
+import java.util.concurrent.CopyOnWriteArrayList
+
+fun interface ChangeListener<T> {
+    fun onChanged(value: T)
+}
+
+/** Handle returned by [QueryFlow.observe]; cancelling detaches the listener. */
+class Subscription internal constructor(private val onCancel: () -> Unit) {
+    private var cancelled = false
+
+    fun cancel() {
+        if (!cancelled) {
+            cancelled = true
+            onCancel()
+        }
+    }
+}
+
+/**
+ * Push-based projection of a database query.
+ *
+ * Surfaces subscribe once and receive a fresh projection whenever the backing tables change, so
+ * a page never has to be rebuilt by hand after a write. The projection is recomputed lazily from
+ * the source lambda and only published when it actually differs from the last published value.
+ */
+class QueryFlow<T>(private val source: () -> T) {
+    private val listeners = CopyOnWriteArrayList<ChangeListener<T>>()
+    private var cached: T = source()
+
+    val value: T get() = cached
+
+    fun observe(listener: ChangeListener<T>): Subscription {
+        listeners.add(listener)
+        listener.onChanged(cached)
+        return Subscription { listeners.remove(listener) }
+    }
+
+    fun invalidate() {
+        val next = source()
+        if (next == cached) {
+            return
+        }
+        cached = next
+        listeners.forEach { it.onChanged(cached) }
+    }
+
+    fun close() {
+        listeners.clear()
+    }
+}
