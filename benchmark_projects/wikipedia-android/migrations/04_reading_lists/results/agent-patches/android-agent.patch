+++ b/app/src/test/kotlin/org/wikipedia/readinglist/SavedScenarioTest.kt
@@ -0,0 +1,628 @@
+package org.wikipedia.readinglist
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * Host-side verification of the public Saved scenarios: each test builds the scenario state,
+ * drives the production entry point and inspects the resulting state.
+ */
+class SavedScenarioTest {
+
+    private fun jsonArray(values: List<Any?>): JSONArray = JSONArray().apply { values.forEach { put(it) } }
+
+    private fun listObject(vararg pairs: Pair<String, Any?>): JSONObject = given(*pairs)
+
+    private fun stateOf(runtime: SavedRuntime): JSONObject = runtime.persistence
+
+    private fun uiState(runtime: SavedRuntime): JSONObject = runtime.persistence.getJSONObject("uiState")
+
+    private fun articleKeys(runtime: SavedRuntime): List<String> {
+        val rows = uiState(runtime).getJSONArray("articleRows")
+        return (0 until rows.length()).map { rows.getJSONObject(it).getString("article") }
+    }
+
+    private fun collectionTitles(runtime: SavedRuntime): List<String> {
+        val rows = uiState(runtime).getJSONArray("collectionRows")
+        return (0 until rows.length()).map { rows.getJSONObject(it).getString("title") }
+    }
+
+    // ------------------------------------------------------------------ case 1
+
+    @Test
+    fun allArticlesDeduplicatesMemberships() {
+        val state = given(
+            "roomLists" to jsonArray(
+                listOf(
+                    listObject(
+                        "title" to "Saved",
+                        "isDefault" to true,
+                        "articles" to jsonArray(listOf("en:Ada_Lovelace", "en:Paris"))
+                    ),
+                    listObject(
+                        "title" to "People",
+                        "isDefault" to false,
+                        "articles" to jsonArray(listOf("en:Ada_Lovelace"))
+                    ),
+                    listObject(
+                        "title" to "Places",
+                        "isDefault" to false,
+                        "articles" to jsonArray(listOf("fr:Paris"))
+                    )
+                )
+            )
+        )
+        val runtime = runtimeOf(state)
+        SavedActionPrefix(runtime).openSavedSurface()
+
+        assertTrue(runtime.transitionExecuted)
+        assertEquals("", runtime.earlyExit)
+        assertEquals(listOf("en:Ada_Lovelace", "en:Paris", "fr:Paris"), articleKeys(runtime))
+
+        val ada = uiState(runtime).getJSONArray("articleRows").getJSONObject(0)
+        assertEquals(1, countOccurrences(articleKeys(runtime), "en:Ada_Lovelace"))
+        val collections = ada.getJSONArray("collections")
+        assertEquals("Saved", collections.getString(0))
+        assertEquals("People", collections.getString(1))
+
+        // The fr article is a distinct logical article from the en article.
+        assertTrue(articleKeys(runtime).contains("fr:Paris"))
+    }
+
+    // ------------------------------------------------------------------ case 2
+
+    @Test
+    fun collectionsTabUsesItsOwnSortAndExcludesDefault() {
+        val state = given(
+            "selectedTab" to "ALL_ARTICLES",
+            "roomLists" to jsonArray(
+                listOf(
+                    listObject("title" to "Saved", "isDefault" to true),
+                    listObject("title" to "Zoo", "isDefault" to false),
+                    listObject("title" to "Alpha", "isDefault" to false)
+                )
+            ),
+            "persistedSortModes" to listObject("ALL_ARTICLES" to 1, "COLLECTIONS" to 0)
+        )
+        val runtime = runtimeOf(state)
+        SavedActionPrefix(runtime).selectSavedTab("COLLECTIONS")
+
+        assertEquals("COLLECTIONS", uiState(runtime).getString("selectedTab"))
+        assertEquals(listOf("Alpha", "Zoo"), collectionTitles(runtime))
+
+        // Article sort mode is untouched and still name-descending.
+        val modes = stateOf(runtime).getJSONObject("sortModes")
+        assertEquals(1, modes.getInt("ALL_ARTICLES"))
+        assertEquals(0, modes.getInt("COLLECTIONS"))
+
+        // The default collection is presentation-only filtered: it is still stored.
+        val stored = stateOf(runtime).getJSONArray("collections")
+        val storedTitles = (0 until stored.length()).map { stored.getJSONObject(it).getString("title") }
+        assertTrue(storedTitles.contains("Saved"))
+    }
+
+    // ------------------------------------------------------------------ case 3
+
+    @Test
+    fun searchIsDebouncedAndScopedToTheActiveTab() {
+        val state = given(
+            "selectedTab" to "ALL_ARTICLES",
+            "searchQuery" to JSONObject.NULL,
+            "searchDebounceMillis" to 150,
+            "articleRows" to jsonArray(listOf("en:Cafe", "en:Tea")),
+            "collectionTitles" to jsonArray(listOf("Cafe Collection"))
+        )
+        val runtime = runtimeOf(state)
+        val prefix = SavedActionPrefix(runtime)
+        // Typed but not yet due: the rows must not be filtered.
+        prefix.enterSavedSearchQuery("cafe", 149)
+        assertEquals(listOf("en:Cafe", "en:Tea"), articleKeys(runtime))
+
+        val runtime2 = runtimeOf(state.deepCopy())
+        SavedActionPrefix(runtime2).enterSavedSearchQuery("cafe", 150)
+        assertEquals(listOf("en:Cafe"), articleKeys(runtime2))
+        // Search does not mutate membership.
+        val collections = stateOf(runtime2).getJSONArray("memberships")
+        val saved = (0 until collections.length())
+            .map { collections.getJSONObject(it) }
+            .first { it.getString("collection") == "Saved" }
+        assertEquals(2, saved.getJSONArray("articles").length())
+    }
+
+    // ------------------------------------------------------------------ case 4
+
+    @Test
+    fun defaultOnlyFilterExcludesAnyArticleInANamedCollection() {
+        val memberships = JSONObject()
+            .put("en:Default_only", jsonArray(listOf("Saved")))
+            .put("en:Default_and_travel", jsonArray(listOf("Saved", "Travel")))
+            .put("en:Travel_only", jsonArray(listOf("Travel")))
+        val state = given(
+            "selectedTab" to "ALL_ARTICLES",
+            "selectedArticleFilter" to "ALL_ARTICLES",
+            "articleMemberships" to memberships
+        )
+        val all = runtimeOf(state.deepCopy())
+        SavedActionPrefix(all).openSavedSurface()
+        assertEquals(3, articleKeys(all).size)
+
+        val runtime = runtimeOf(state)
+        SavedActionPrefix(runtime).selectArticleFilter("NOT_IN_COLLECTION")
+        assertEquals(listOf("en:Default_only"), articleKeys(runtime))
+    }
+
+    // ------------------------------------------------------------------ case 5
