new file mode 100644
index 0000000000000000000000000000000000000000..e8ddf8db6ab91fa15fe94a7fd1a53b967bbf940b
--- /dev/null
+++ b/app/src/main/upstream/kotlin/org/wikipedia/readinglist/SavedViewModel.kt
@@ -0,0 +1,616 @@
+package org.wikipedia.readinglist
+
+import org.wikipedia.auth.AccountInfo
+import org.wikipedia.auth.AccountStateHolder
+import org.wikipedia.database.QueryFlow
+import org.wikipedia.database.Subscription
+import org.wikipedia.offline.ArticleAvailability
+import org.wikipedia.offline.ArticleOfflineStore
+import org.wikipedia.offline.ArticleOfflineStatus
+import org.wikipedia.page.PageTitle
+import org.wikipedia.util.ProductionLog
+
+/**
+ * Owns the state of the Saved experience.
+ *
+ * The database projections are the source of truth for membership; everything else - the
+ * selected tab, the search scope, the All articles filter, the two independent sort modes,
+ * selection, the refresh spinner, onboarding and feedback - is presentation that is reduced on
+ * top of those projections. Because the ViewModel subscribes to the projections, any write -
+ * from the Save sheet, from a destructive action, or from sync - re-reduces the rows without
+ * anyone rebuilding a page by hand.
+ */
+class SavedViewModel(
+    private val manager: ReadingListManager,
+    private val undo: ReadingListUndo,
+    private val sync: ReadingListSync,
+    private val account: AccountStateHolder,
+    private val offlineStore: ArticleOfflineStore,
+    private val preferences: SavedPreferences,
+    private val scheduler: SavedScheduler,
+    private val readingListsWithPages: QueryFlow<List<ReadingListWithPages>>,
+    private val log: ProductionLog
+) {
+    private val listeners = mutableListOf<(SavedUiState) -> Unit>()
+
+    private var selectedTab = SavedTab.ALL_ARTICLES
+    private var searchQuery = ""
+    private var appliedSearchQuery = ""
+    private var articleFilter = ArticleFilter.ALL_ARTICLES
+    private var selectionEnabled = false
+    private val selectedIds = LinkedHashSet<Long>()
+    private var isRefreshing = false
+    private var isLoading = true
+    private var sharedCollectionPending = false
+    private var feedback = SavedFeedback.NONE
+    private var feedbackMessage: String? = null
+    private var articleRows: List<SavedArticleRow> = emptyList()
+    private var collectionRows: List<SavedCollectionRow> = emptyList()
+    private var totalSavedCount = 0
+    private var pendingBulkDeleteConfirmation: List<SavedArticleRow> = emptyList()
+    private var pendingSearch: ScheduledTask? = null
+    private var projections: List<ReadingListWithPages> = emptyList()
+    private val availabilityFlow = offlineStore.observe()
+
+    /** Remote state the next sync pass should apply; supplied by the sync transport owner. */
+    var pendingRemoteSync: List<ReadingListSync.RemoteList> = emptyList()
+
+    val uiState: SavedUiState
+        get() = SavedUiState(
+            selectedTab = selectedTab,
+            searchQuery = searchQuery,
+            appliedSearchQuery = appliedSearchQuery,
+            articleFilter = articleFilter,
+            articleSortMode = preferences.articleSortMode,
+            collectionSortMode = preferences.collectionSortMode,
+            selectionEnabled = selectionEnabled,
+            selectedPageIds = selectedIds.toList(),
+            pendingDeleteConfirmation = pendingBulkDeleteConfirmation.isNotEmpty(),
+            isRefreshing = isRefreshing,
+            isLoading = isLoading,
+            onboarding = resolveOnboarding(),
+            feedback = feedback,
+            feedbackMessage = feedbackMessage,
+            menuActions = resolveMenuActions(),
+            sortChoices = resolveSortChoices(),
+            emptyState = resolveEmptyState(),
+            recoveryAction = resolveRecoveryAction(),
+            articleRows = articleRows,
+            collectionRows = collectionRows,
+            undoDescription = undo.description,
+            totalSavedCount = totalSavedCount
+        )
+
+    val requiresBulkDeleteConfirmation: Boolean get() = pendingBulkDeleteConfirmation.isNotEmpty()
+
+    /** Titles whose removal is waiting for confirmation, empty when nothing is pending. */
+    val pendingDeleteTitles: List<PageTitle> get() = pendingBulkDeleteConfirmation.map { it.title }
+
+    fun observe(listener: (SavedUiState) -> Unit): Subscription {
+        listeners.add(listener)
+        listener(uiState)
+        return Subscription { listeners.remove(listener) }
+    }
+
+    // ------------------------------------------------------------------ lifecycle
+
+    private fun emit() {
+        val state = uiState
+        listeners.toList().forEach { it(state) }
+    }
+
+    private fun recompute() {
+        val availability = availabilityFlow.value
+        val deduplicated = buildArticleRows(availability)
+        totalSavedCount = deduplicated.size
+        articleRows = deduplicated
+            .filter { matchesSearch(it.title, appliedSearchQuery) }
+            .filter { row -> articleFilter == ArticleFilter.ALL_ARTICLES || !row.isInUserCollection }
+        collectionRows = buildCollectionRows()
+        isLoading = false
+        emit()
+    }
+
+    private fun buildArticleRows(availability: Map<String, ArticleAvailability>): List<SavedArticleRow> {
+        val accumulator = LinkedHashMap<String, ArticleAccumulator>()
+        projections.forEach { projection ->
+            val list = projection.list
+            projection.pages.forEach { page ->
+                val entry = accumulator.getOrPut(page.title.logicalKey) { ArticleAccumulator(page.title) }
+                entry.collectionTitles.add(list.title to list.isDefault)
+                if (list.isDefault || entry.canonicalId == null) {
+                    entry.canonicalId = page.id
+                }
+                entry.inDefaultCollection = entry.inDefaultCollection || list.isDefault
+                entry.recency = maxOf(entry.recency, page.mtime)
+            }
+        }
+        val rows = accumulator.values.map { entry ->
+            val offline = availability[entry.title.logicalKey]
+            SavedArticleRow(
+                id = entry.canonicalId ?: 0L,
+                title = entry.title,
+                collectionTitles = entry.collectionTitles.sortedByDescending { it.second }.map { it.first },
+                isInDefaultCollection = entry.inDefaultCollection,
+                offlineStatus = offline?.status ?: ArticleOfflineStatus.NOT_DOWNLOADED,
+                downloadProgress = offline?.downloadProgress ?: ArticleAvailability.NO_ACTIVE_DOWNLOAD
+            )
+        }
+        return rows
+            .sortedWith(
+                SavedSorting.byRecency(
+                    mode = preferences.articleSortMode,
+                    key = { it.title.displayTitle },
+                    recency = { accRecency(accumulator, it.title.logicalKey) }
+                )
+            )
+    }
+
+    private fun buildCollectionRows(): List<SavedCollectionRow> {
+        val query = appliedSearchQuery
+        return projections
+            .filter { !it.list.isDefault }
+            .filter { query.isBlank() || it.list.title.contains(query, ignoreCase = true) }
+            .map { projection ->
+                SavedCollectionRow(
+                    id = projection.list.id,
+                    title = projection.list.title,
+                    description = projection.list.description,
+                    articleCount = projection.pages.size,
+                    isDefault = projection.list.isDefault
+                )
+            }
+            .sortedWith(
+                SavedSorting.byRecency(
+                    mode = preferences.collectionSortMode,
+                    key = { it.title },
+                    recency = { projectionRecency(it.id) }
+                )
+            )
+    }
+
+    private fun accRecency(accumulator: Map<String, ArticleAccumulator>, key: String): Long =
+        accumulator[key]?.recency ?: 0L
+
+    private fun projectionRecency(listId: Long): Long =
+        projections.firstOrNull { it.list.id == listId }?.pages?.maxOfOrNull { it.mtime } ?: 0L
+
+    private fun matchesSearch(title: PageTitle, query: String): Boolean {
+        if (query.isBlank()) {
+            return true
+        }
+        return title.displayTitle.contains(query, ignoreCase = true) ||
+            title.apiTitle.contains(query, ignoreCase = true)
+    }
+
+    private fun visibleRows(): List<Long> = when (selectedTab) {
+        SavedTab.ALL_ARTICLES -> articleRows.map { it.id }
+        SavedTab.COLLECTIONS -> collectionRows.map { it.id }
+    }
+
+    private fun resolveMenuActions(): List<SavedMenuAction> {
+        val base = when (selectedTab) {
+            SavedTab.ALL_ARTICLES -> listOf(SavedMenuAction.SORT, SavedMenuAction.FILTER)
+            SavedTab.COLLECTIONS -> listOf(SavedMenuAction.SORT, SavedMenuAction.NEW_COLLECTION)
+        }
+        if (visibleRows().isEmpty()) {
+            return base
+        }
+        return base + listOf(SavedMenuAction.SELECT_ALL, SavedMenuAction.DELETE)
+    }
+
+    private fun resolveSortChoices(): List<ReadingListSortMode> = when (selectedTab) {
+        SavedTab.ALL_ARTICLES -> ReadingListSortMode.entries.toList()
+        SavedTab.COLLECTIONS -> listOf(
+            ReadingListSortMode.SORT_BY_NAME_ASC,
+            ReadingListSortMode.SORT_BY_NAME_DESC,
+            ReadingListSortMode.SORT_BY_NEWEST_FIRST
+        )
+    }
+
+    private fun resolveEmptyState(): SavedEmptyState {
+        if (isLoading) {
+            return SavedEmptyState.LOADING
+        }
+        val rowsAreEmpty = visibleRows().isEmpty()
+        if (!rowsAreEmpty) {
+            return SavedEmptyState.NONE
+        }
+        if (appliedSearchQuery.isNotBlank()) {
+            return SavedEmptyState.SEARCH_NO_RESULTS(appliedSearchQuery)
+        }
+        return when (selectedTab) {
+            SavedTab.ALL_ARTICLES -> SavedEmptyState.NO_SAVED_ARTICLES
+            SavedTab.COLLECTIONS -> SavedEmptyState.NO_COLLECTIONS
+        }
+    }
+
+    private fun resolveRecoveryAction(): SavedRecoveryAction {
+        return when (resolveEmptyState()) {
+            is SavedEmptyState.SEARCH_NO_RESULTS -> SavedRecoveryAction.CLEAR_SEARCH
+            SavedEmptyState.NO_COLLECTIONS -> SavedRecoveryAction.CREATE_COLLECTION
+            SavedEmptyState.NO_SAVED_ARTICLES ->
+                if (account.account.isLoggedIn) SavedRecoveryAction.START_SYNC else SavedRecoveryAction.LOG_IN
+            else -> SavedRecoveryAction.NONE
+        }
+    }
+
+    private fun resolveOnboarding(): SavedOnboardingState = when {
+        sharedCollectionPending -> SavedOnboardingState.SHARED_COLLECTION_RECEIVED
+        feedback == SavedFeedback.LOGIN_REQUIRED -> SavedOnboardingState.LOGIN_PROMPT
+        // Signed out with something saved: there is something worth signing in to sync.
+        !account.account.isLoggedIn && totalSavedCount > 0 -> SavedOnboardingState.LOGIN_PROMPT
+        account.account.isLoggedIn && !sync.isSyncEnabled() -> SavedOnboardingState.SYNC_REMINDER
+        else -> SavedOnboardingState.NONE
+    }
+
+    // ------------------------------------------------------------------ tab and search
+
+    fun onScreenOpened() {
+        log.record("SavedViewModel.onScreenOpened")
+        recompute()
+    }
+
+    /**
+     * Switches the visible view. Rows, search scope, sort, menu actions, empty state and
+     * onboarding are re-derived for the new view; nothing about stored membership changes and the
+     * default collection stays in storage either way.
+     */
+    fun onSelectTab(tab: SavedTab) {
+        if (tab == selectedTab) {
+            return
+        }
+        log.record("SavedViewModel.onSelectTab:${tab.name}")
+        selectedTab = tab
+        if (tab == SavedTab.COLLECTIONS) {
+            // The narrowing filter only exists on All articles.
+            articleFilter = ArticleFilter.ALL_ARTICLES
+        }
+        selectionEnabled = false
+        selectedIds.clear()
+        pendingBulkDeleteConfirmation = emptyList()
+        recompute()
+    }
+
+    /**
+     * Records what the reader typed. A non-empty query is only applied once typing pauses for
+     * [SavedScheduler.SEARCH_DEBOUNCE_DELAY_MS]; clearing the field applies at once.
+     */
+    fun onSearchQueryChanged(query: String) {
+        log.record("SavedViewModel.onSearchQueryChanged:$query")
+        searchQuery = query
+        pendingSearch?.cancel()
+        if (query.isBlank()) {
+            appliedSearchQuery = ""
+            recompute()
+            return
+        }
+        pendingSearch = scheduler.postDelayed(SavedScheduler.SEARCH_DEBOUNCE_DELAY_MS) {
+            applySearchQuery(query)
+        }
+        emit()
+    }
+
+    /** Applies the debounced query to the rows of the active tab only. */
+    fun applySearchQuery(query: String) {
+        log.record("SavedViewModel.applySearchQuery:$query")
+        searchQuery = query
+        appliedSearchQuery = query
+        recompute()
+    }
+
+    fun onClearSearch() {
+        pendingSearch?.cancel()
+        pendingSearch = null
+        searchQuery = ""
+        appliedSearchQuery = ""
+        feedback = SavedFeedback.NONE
+        feedbackMessage = null
+        recompute()
+    }
+
+    fun onFilterSelected(filter: ArticleFilter) {
+        log.record("SavedViewModel.onFilterSelected:${filter.name}")
+        articleFilter = filter
+        recompute()
+    }
+
+    /** Applies a sort choice to the active view and persists it under that view's own key. */
+    fun onSortSelected(mode: ReadingListSortMode) {
+        if (selectedTab == SavedTab.ALL_ARTICLES) {
+            log.record("SavedViewModel.onSortSelected:articles:${mode.name}")
+            preferences.articleSortMode = mode
+        } else {
+            log.record("SavedViewModel.onSortSelected:collections:${mode.name}")
+            preferences.collectionSortMode = mode
+        }
+        recompute()
+    }
+
+    // ------------------------------------------------------------------ selection
+
+    fun onStartSelectionMode() {
+        log.record("SavedViewModel.onStartSelectionMode")
+        selectionEnabled = true
+        emit()
+    }
+
+    fun onToggleSelection(rowId: Long) {
+        log.record("SavedViewModel.onToggleSelection:$rowId")
+        selectionEnabled = true
+        if (rowId in visibleRows()) {
+            if (!selectedIds.add(rowId)) {
+                selectedIds.remove(rowId)
+            }
+        }
+        emit()
+    }
+
+    /**
+     * Selects every row currently visible. Because All articles is de-duplicated, one logical
+     * article contributes exactly one id, and rows hidden by the active filter are not selected.
+     */
+    fun onSelectAllVisible() {
+        log.record("SavedViewModel.onSelectAllVisible")
+        selectionEnabled = true
+        val visible = visibleRows()
+        selectedIds.clear()
+        selectedIds.addAll(visible)
+        emit()
+    }
+
+    fun onClearSelection() {
+        log.record("SavedViewModel.onClearSelection")
+        selectionEnabled = false
+        selectedIds.clear()
+        pendingBulkDeleteConfirmation = emptyList()
+        emit()
+    }
+
+    // ------------------------------------------------------------------ destructive actions
+
+    /**
+     * Runs the destructive action valid for the active row type.
+     *
+     * On All articles an article held by a user-created collection is only staged for removal
+     * after the reader confirms; on Collections the default collection is never a row and can
+     * never be deleted. Both paths are reversible through undo.
+     */
+    fun onDeleteSelected() {
+        log.record("SavedViewModel.onDeleteSelected:${selectedTab.name}")
+        if (selectedIds.isEmpty()) {
+            feedback = SavedFeedback.NOTHING_SELECTED
+            feedbackMessage = null
+            emit()
+            return
+        }
+        when (selectedTab) {
+            SavedTab.ALL_ARTICLES -> {
+                val rows = articleRows.filter { it.id in selectedIds }
+                if (rows.isEmpty()) {
+                    feedback = SavedFeedback.NOTHING_SELECTED
+                    emit()
+                    return
+                }
+                if (rows.any { it.requiresUnsaveConfirmation }) {
+                    pendingBulkDeleteConfirmation = rows
+                    feedback = SavedFeedback.NONE
+                    feedbackMessage = null
+                    emit()
+                    return
+                }
+                stageArticleRemoval(rows)
+            }
+            SavedTab.COLLECTIONS -> stageCollectionRemoval()
+        }
+    }
+
+    /** Confirms a bulk removal that touches at least one user-created collection. */
+    fun onConfirmDeleteSelected() {
+        val rows = pendingBulkDeleteConfirmation
+        log.record("SavedViewModel.onConfirmDeleteSelected:${rows.size}")
+        pendingBulkDeleteConfirmation = emptyList()
+        if (rows.isNotEmpty()) {
+            stageArticleRemoval(rows)
+        } else {
+            emit()
+        }
+    }
+
+    fun onCancelDeleteSelected() {
+        log.record("SavedViewModel.onCancelDeleteSelected")
+        pendingBulkDeleteConfirmation = emptyList()
+        emit()
+    }
+
+    private fun stageArticleRemoval(rows: List<SavedArticleRow>) {
+        val snapshots = rows.flatMap { row ->
+            manager.memberships(row.title).map { membership ->
+                ArticleMembershipSnapshot(membership.id, membership.title, row.title)
+            }
+        }
+        rows.forEach { manager.queueArticleForDeletion(it.title) }
+        undo.trackArticles(rows.map { it.title }, snapshots)
+        selectedIds.clear()
+        selectionEnabled = false
+        feedback = SavedFeedback.ARTICLES_DELETED
+        feedbackMessage = rows.joinToString { it.title.displayTitle }
+        recompute()
+    }
+
+    private fun stageCollectionRemoval() {
+        val selected = collectionRows.filter { it.id in selectedIds && !it.isDefault }
+        if (selected.isEmpty()) {
+            feedback = SavedFeedback.NOTHING_SELECTED
+            emit()
+            return
+        }
+        val snapshots = selected.mapNotNull { row ->
+            manager.findListById(row.id)?.let { list ->
+                CollectionSnapshot(list.id, list.title, list.description, list.isRemote)
+            }
+        }
+        selected.forEach { row ->
+            manager.findListById(row.id)?.let { manager.deleteCollection(it) }
+        }
+        undo.trackCollections(snapshots)
+        selectedIds.clear()
+        selectionEnabled = false
+        feedback = SavedFeedback.COLLECTIONS_DELETED
+        feedbackMessage = selected.joinToString { it.title }
+        recompute()
+    }
+
+    /** Restores whatever the last destructive action removed, leaving unrelated rows alone. */
+    fun onUndoDelete() {
+        log.record("SavedViewModel.onUndoDelete")
+        if (!undo.undo()) {
+            feedback = SavedFeedback.NONE
+            emit()
+            return
+        }
+        feedback = SavedFeedback.RESTORED
+        feedbackMessage = null
+        recompute()
+    }
+
+    // ------------------------------------------------------------------ sync and account
+
+    /**
+     * Pull-to-refresh. Only an account that is signed in and not temporary may start a sync; for
+     * anyone else the refresh ends immediately with a login prompt and nothing is dispatched.
+     */
+    fun onPullToRefresh() {
+        log.record("SavedViewModel.onPullToRefresh")
+        val info = account.account
+        if (!info.isEligibleForSync) {
+            isRefreshing = false
+            feedback = SavedFeedback.LOGIN_REQUIRED
+            feedbackMessage = "Log in to sync your saved articles."
+            log.record("SavedViewModel.onPullToRefresh:login_prompt")
+            emit()
+            return
+        }
+        feedback = SavedFeedback.NONE
+        feedbackMessage = null
+        isRefreshing = true
+        sync.start(info, pendingRemoteSync)
+        recompute()
+    }
+
+    fun onSyncEvent(event: ReadingListSyncEvent) {
+        log.record("SavedViewModel.onSyncEvent:${event.status}")
+        when {
+            event.isRunning -> {
+                isRefreshing = true
+                recompute()
+            }
+            event.isError -> {
+                isRefreshing = false
+                feedback = SavedFeedback.SYNC_FAILED
+                recompute()
+            }
+            else -> {
+                isRefreshing = false
+                feedback = SavedFeedback.SYNCED
+                recompute()
+            }
+        }
+    }
+
+    fun onLoginCompleted(info: AccountInfo) {
+        log.record("SavedViewModel.onLoginCompleted:${info.userName}")
+        account.update(info)
+        // Signing in turns reading list synchronization on for the account.
+        sync.setSyncEnabled(info.isEligibleForSync)
+        feedback = SavedFeedback.NONE
+        feedbackMessage = null
+        recompute()
+    }
+
+    fun onLogout() {
+        log.record("SavedViewModel.onLogout")
+        account.onLogout()
+        sync.setSyncEnabled(false)
+        feedback = SavedFeedback.NONE
+        recompute()
+    }
+
+    fun onSyncPreferenceChanged(enabled: Boolean) {
+        log.record("SavedViewModel.onSyncPreferenceChanged:$enabled")
+        sync.setSyncEnabled(enabled)
+        preferences.syncReminderSeen = !enabled
+        recompute()
+    }
+
+    fun onSharedCollectionReceived(collectionTitle: String) {
+        log.record("SavedViewModel.onSharedCollectionReceived:$collectionTitle")
+        val existing = manager.findListByTitle(collectionTitle)
+        if (existing == null) {
+            manager.createCollection(collectionTitle, isRemote = true)
+        }
+        sharedCollectionPending = true
+        feedback = SavedFeedback.NONE
+        recompute()
+    }
+
+    fun onDismissOnboarding() {
+        log.record("SavedViewModel.onDismissOnboarding")
+        sharedCollectionPending = false
+        preferences.syncReminderSeen = true
+        recompute()
+    }
+
+    // ------------------------------------------------------------------ helpers used by the sheet
+
+    fun createCollection(title: String, description: String? = null): CollectionChange {
+        log.record("SavedViewModel.createCollection:$title")
+        val result = manager.createUserCollection(title, description)
+        feedback = when {
+            result is CollectionChange.Applied -> SavedFeedback.COLLECTION_CREATED
+            else -> SavedFeedback.LIMIT_REACHED
+        }
+        feedbackMessage = (result as? CollectionChange.Rejected)?.message
+        recompute()
+        return result
+    }
+
+    fun reportFeedback(feedback: SavedFeedback, message: String? = null) {
+        if (feedback == SavedFeedback.NONE && message == null) {
+            return
+        }
+        log.record("SavedViewModel.reportFeedback:$feedback")
+        this.feedback = feedback
+        this.feedbackMessage = message
+        emit()
+    }
+
+    private class ArticleAccumulator(val title: PageTitle) {
+        var canonicalId: Long? = null
+        var inDefaultCollection = false
+        var recency = 0L
+        val collectionTitles = mutableListOf<Pair<String, Boolean>>()
+    }
+
+    init {
+        log.record("SavedViewModel.init")
+        readingListsWithPages.observe { projection ->
+            projections = projection
+            recompute()
+        }
+        availabilityFlow.observe {
+            recompute()
+        }
+        account.observe().observe {
+            log.record("SavedViewModel.onAccountStateChanged")
+            recompute()
+        }
+        sync.addListener { event -> onSyncEvent(event) }
+    }
+}
+
+/** Convenience for observers that only need the rows of the active tab. */
+fun SavedUiState.visibleRowIds(): List<Long> = when (selectedTab) {
+    SavedTab.ALL_ARTICLES -> articleRows.map { it.id }
+    SavedTab.COLLECTIONS -> collectionRows.map { it.id }
+}
