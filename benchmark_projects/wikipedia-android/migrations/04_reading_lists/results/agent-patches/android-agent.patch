+package org.wikipedia.readinglist
+
+import org.wikipedia.auth.AccountInfo
+import org.wikipedia.page.PageTitle
+import org.wikipedia.util.ProductionLog
+
+/**
+ * The Saved page.
+ *
+ * It owns no state of its own: every callback forwards to [SavedViewModel] and re-renders from
+ * the state it publishes. The class is the page's wiring - tabs, the search field, the filter, the
+ * sort sheet, the selection bar, the refresh gesture, onboarding prompts and the Save sheet entry
+ * point - which is what the rest of the app talks to.
+ */
+class ReadingListsFragment(
+    private val viewModel: SavedViewModel,
+    private val articleActions: ReadingListArticleActions,
