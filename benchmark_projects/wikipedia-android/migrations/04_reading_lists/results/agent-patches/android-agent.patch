+package org.wikipedia.database
+
+import android.content.SharedPreferences
+
+/**
+ * Small durable key/value seam used by the Saved stack so that sort modes, the sync preference
+ * and the reading list tables survive process death. [SharedPreferencesKeyValueStore] is the
+ * production implementation backed by the platform preferences file.
+ */
+interface KeyValueStore {
+    fun getString(key: String): String?
+
+    fun putString(key: String, value: String)
+
+    fun getBoolean(key: String, fallback: Boolean): Boolean
+
+    fun putBoolean(key: String, value: Boolean)
+}
+
+class SharedPreferencesKeyValueStore(private val preferences: SharedPreferences?) : KeyValueStore {
+    override fun getString(key: String): String? = preferences?.getString(key, null)
+
+    override fun putString(key: String, value: String) {
+        preferences?.edit()?.putString(key, value)?.apply()
+    }
+
+    override fun getBoolean(key: String, fallback: Boolean): Boolean =
+        preferences?.getBoolean(key, fallback) ?: fallback
+
+    override fun putBoolean(key: String, value: Boolean) {
+        preferences?.edit()?.putBoolean(key, value)?.apply()
+    }
+}
+
+/** In-memory store used when no preferences file is attached (for example in isolated tooling). */
+class InMemoryKeyValueStore : KeyValueStore {
+    private val values = HashMap<String, Any?>()
+
+    override fun getString(key: String): String? = values[key] as? String
+
+    override fun putString(key: String, value: String) {
+        values[key] = value
+    }
+
+    override fun getBoolean(key: String, fallback: Boolean): Boolean = values[key] as? Boolean ?: fallback
+
+    override fun putBoolean(key: String, value: Boolean) {
+        values[key] = value
+    }
+}
