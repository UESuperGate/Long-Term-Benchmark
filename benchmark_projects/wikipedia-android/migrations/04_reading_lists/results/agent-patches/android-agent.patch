@@ -0,0 +1,60 @@
+package org.wikipedia.offline
+
+import org.wikipedia.page.PageTitle
+import org.wikipedia.database.QueryFlow
+import org.wikipedia.util.ProductionLog
+
+/** How completely an article is available for offline reading right now. */
+enum class ArticleOfflineStatus {
+    NOT_DOWNLOADED,
+    DOWNLOADING,
+    AVAILABLE,
+    STALE
+}
+
+data class ArticleAvailability(
+    val status: ArticleOfflineStatus = ArticleOfflineStatus.NOT_DOWNLOADED,
+    val downloadProgress: Int = NO_ACTIVE_DOWNLOAD
+) {
+    val hasActiveDownload: Boolean get() = status == ArticleOfflineStatus.DOWNLOADING
+
+    companion object {
+        const val NO_ACTIVE_DOWNLOAD = -1
+    }
+}
+
+/**
+ * Application-owned view of offline availability for saved articles.
+ *
+ * Rows of the Saved surfaces join this store so a visible article always reports whether it is
+ * available offline and whether a download is still running. Downloads are outside the Saved
+ * feature; this store only mirrors their observable outcome.
+ */
+class ArticleOfflineStore(private val log: ProductionLog? = null) {
+    private val availability = LinkedHashMap<String, ArticleAvailability>()
+    private val flow: QueryFlow<Map<String, ArticleAvailability>> = QueryFlow { LinkedHashMap(availability) }
+
+    fun observe(): QueryFlow<Map<String, ArticleAvailability>> = flow
+
+    fun availabilityFor(title: PageTitle): ArticleAvailability =
+        availability[title.logicalKey] ?: ArticleAvailability()
+
+    fun setStatus(title: PageTitle, status: ArticleOfflineStatus, progress: Int = ArticleAvailability.NO_ACTIVE_DOWNLOAD) {
+        log?.record("ArticleOfflineStore.setStatus:${title.logicalKey}:$status")
+        availability[title.logicalKey] = ArticleAvailability(status, progress)
+        flow.invalidate()
+    }
+
+    fun beginDownload(title: PageTitle, progress: Int) =
+        setStatus(title, ArticleOfflineStatus.DOWNLOADING, progress)
+
+    fun reportProgress(title: PageTitle, progress: Int) {
+        log?.record("ArticleOfflineStore.reportProgress:${title.logicalKey}:$progress")
+        availability[title.logicalKey] = ArticleAvailability(ArticleOfflineStatus.DOWNLOADING, progress)
+        flow.invalidate()
+    }
+
+    fun completeDownload(title: PageTitle) {
+        setStatus(title, ArticleOfflineStatus.AVAILABLE, 100)
+    }
+}
