+package org.wikipedia.page
+
+import org.wikipedia.util.jsonOf
+import org.wikipedia.util.stringOr
+import org.wikipedia.util.stringOrNull
+import org.json.JSONObject
+
+/**
+ * Logical identity of a wiki article.
+ *
+ * An article is identified by the pair of its wiki language and its API title. That pair - not
+ * the number of reading lists it lives in, not its display title, and not the database row id
+ * that happens to carry the membership - is what makes two rows the *same* logical article.
+ */
+data class PageTitle(
+    val languageCode: String,
+    val apiTitle: String,
+    val displayTitle: String = apiTitle.replace('_', ' ')
+) {
+    /** Stable key used for grouping and de-duplication: `languageCode:apiTitle`. */
+    val logicalKey: String get() = key(languageCode, apiTitle)
+
+    override fun toString(): String = logicalKey
+
+    fun toJson(): JSONObject = jsonOf(
+        "language" to languageCode,
+        "apiTitle" to apiTitle,
+        "displayTitle" to displayTitle
+    )
+
+    companion object {
+        const val DEFAULT_LANGUAGE = "en"
+
+        fun key(languageCode: String, apiTitle: String): String = "$languageCode:$apiTitle"
+
+        /** Parses the canonical `language:Api_Title` key used across storage and IPC. */
+        fun fromKey(key: String): PageTitle {
+            val separator = key.indexOf(':')
+            if (separator <= 0 || separator == key.length - 1) {
+                return PageTitle(DEFAULT_LANGUAGE, key.replace(' ', '_'))
+            }
+            return PageTitle(key.substring(0, separator), key.substring(separator + 1))
+        }
+
+        fun fromJson(json: JSONObject): PageTitle = PageTitle(
+            languageCode = json.stringOr("language", DEFAULT_LANGUAGE),
+            apiTitle = json.stringOr("apiTitle", ""),
+            displayTitle = json.stringOrNull("displayTitle")
+                ?: json.stringOr("apiTitle", "").replace('_', ' ')
+        )
+    }
+}
