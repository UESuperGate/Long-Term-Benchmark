@@ -0,0 +1,296 @@
+package org.wikipedia.readinglist
+
+import org.wikipedia.page.PageTitle
+import org.wikipedia.util.ProductionLog
+
+/** Why a requested change to saved content was refused. */
+enum class LimitReason {
+    DEFAULT_COLLECTION_PROTECTED,
+    COLLECTION_LIMIT_REACHED,
+    ARTICLE_LIMIT_REACHED,
+    COLLECTION_UNAVAILABLE,
+    ARTICLE_NOT_SAVED
+}
+
+/**
+ * Result of a write against saved content.
+ *
+ * A [Rejected] write never touches stored membership: the requested addition is blocked, the
+ * reason is reported, and every existing membership is left exactly as it was.
+ */
+sealed class MembershipChange {
+    abstract val title: PageTitle
+
+    data class Applied(
+        override val title: PageTitle,
+        val collectionTitles: List<String>,
+        val addedCollection: String? = null,
+        val removedCollection: String? = null,
+        val wasAlreadySaved: Boolean = false
+    ) : MembershipChange()
+
+    data class Rejected(
+        override val title: PageTitle,
+        val reason: LimitReason,
+        val message: String
+    ) : MembershipChange()
+
+    val isApplied: Boolean get() = this is Applied
+}
+
+/** Result of a collection-scoped action such as deletion. */
+sealed class CollectionChange {
+    data class Applied(val list: ReadList) : CollectionChange()
+    data class Rejected(val list: ReadList, val reason: LimitReason, val message: String) : CollectionChange()
+
+    val isApplied: Boolean get() = this is Applied
+}
+
+/** Result of an unsave request; the sheet asks for confirmation only when it is required. */
+sealed class UnsaveOutcome {
+    object Removed : UnsaveOutcome()
+    data class NeedsConfirmation(val collectionTitles: List<String>) : UnsaveOutcome()
+}
+
+/**
+ * Hard caps enforced by the Saved experience.
+ *
+ * A request that would cross a cap is refused up front with a reason the surface can show; no
+ * partial write happens.
+ */
+object ReadingListLimits {
+    /** Maximum number of user-created collections. */
+    const val MAX_COLLECTIONS = 300
+
+    /** Maximum number of articles a single collection may hold. */
+    const val MAX_ARTICLES_PER_COLLECTION = 1000
+
+    fun canCreateCollection(existingCollectionCount: Int): Boolean =
+        existingCollectionCount < MAX_COLLECTIONS
+
+    fun canAddArticle(currentArticleCount: Int): Boolean =
+        currentArticleCount < MAX_ARTICLES_PER_COLLECTION
+
+    fun describeCollectionLimit(): String =
+        "You can keep up to $MAX_COLLECTIONS collections."
+
+    fun describeArticleLimit(): String =
+        "A collection can hold up to $MAX_ARTICLES_PER_COLLECTION articles."
+}
+
+/**
+ * The only writer of saved content.
+ *
+ * Everything that changes membership - saving from an article, creating a collection, toggling a
+ * membership, deleting rows - goes through this class, so limits, default-collection protection
+ * and undo bookkeeping are applied consistently. Reads for the surfaces come from
+ * [org.wikipedia.database.AppDatabase] projections instead.
+ */
+class ReadingListManager(
+    private val database: org.wikipedia.database.AppDatabase,
+    private val log: ProductionLog? = null
+) {
+    /** Monotonic recency stamp so "recently added" ordering is meaningful offline. */
+    private var clock = 0L
+
+    private fun nextMtime(): Long = ++clock
+
+    // ---------------------------------------------------------------- collections
+
+    /** Returns the default collection, creating it on first use. */
+    fun ensureDefaultCollection(): ReadList {
+        database.getLists().firstOrNull { it.isDefault }?.let {
+            log?.record("ReadingListManager.ensureDefaultCollection:hit")
+            return it
+        }
+        val created = createCollection(ReadList.DEFAULT_TITLE, isDefault = true)
+        log?.record("ReadingListManager.ensureDefaultCollection:created")
+        return created
+    }
+
+    fun findListById(id: Long): ReadList? = database.getList(id)?.takeIf { !it.isDeleted }
+
+    fun findListByTitle(title: String): ReadList? = database.getListByTitle(title)
+
+    fun collections(): List<ReadList> = database.getLists()
+
+    /** Collections a reader created themselves; the default collection is not one of them. */
+    fun userCollections(): List<ReadList> = database.getLists().filter { !it.isDefault }
+
+    fun createCollection(
+        title: String,
+        description: String? = null,
+        isDefault: Boolean = false,
+        isRemote: Boolean = false
+    ): ReadList {
+        val existing = database.getListByTitle(title)
+        if (existing != null) {
+            log?.record("ReadingListManager.createCollection:existing:$title")
+            return existing
+        }
+        val id = database.insertList(
+            ReadList(id = 0, title = title, description = description, isDefault = isDefault, isRemote = isRemote)
+        )
+        log?.record("ReadingListManager.createCollection:$title")
+        return database.getList(id)!!
+    }
+
+    fun deleteCollection(list: ReadList): CollectionChange {
+        if (list.isProtected) {
+            log?.record("ReadingListManager.deleteCollection:refused_default")
+            return CollectionChange.Rejected(
+                list,
+                LimitReason.DEFAULT_COLLECTION_PROTECTED,
+                "${ReadList.DEFAULT_TITLE} cannot be deleted."
+            )
+        }
+        log?.record("ReadingListManager.deleteCollection:${list.title}")
+        database.deleteList(list)
+        return CollectionChange.Applied(list)
+    }
+
+    /** Creation with the collection cap applied. */
+    fun createUserCollection(title: String, description: String? = null): CollectionChange {
+        val existing = database.getListByTitle(title)
+        if (existing != null) {
+            return CollectionChange.Applied(existing)
+        }
+        if (!ReadingListLimits.canCreateCollection(userCollections().size)) {
+            log?.record("ReadingListManager.createUserCollection:limit_reached:$title")
+            return CollectionChange.Rejected(
+                ReadList(id = -1, title = title),
+                LimitReason.COLLECTION_LIMIT_REACHED,
+                ReadingListLimits.describeCollectionLimit()
+            )
+        }
+        return CollectionChange.Applied(createCollection(title, description))
+    }
+
+    // ---------------------------------------------------------------- memberships
+
+    /** Collections that currently contain [title], default collection first. */
+    fun memberships(title: PageTitle): List<ReadList> {
+        val containing = database.getAllPages()
+            .filter { !it.isQueuedForDeletion && it.title.logicalKey == title.logicalKey }
+            .mapNotNull { database.getList(it.listId)?.takeIf { list -> !list.isDeleted } }
+        return containing.sortedByDescending { it.isDefault }
+    }
+
+    fun collectionTitles(title: PageTitle): List<String> = memberships(title).map { it.title }
+
+    fun isSaved(title: PageTitle): Boolean = memberships(title).isNotEmpty()
+
+    /**
+     * Adds [title] to [list].
+     *
+     * Rejects - leaving all membership untouched - when the collection is gone or the
+     * per-collection article cap would be crossed.
+     */
+    fun addPageToReadingList(list: ReadList, title: PageTitle, explicitId: Long? = null): MembershipChange {
+        val target = database.getList(list.id)?.takeIf { !it.isDeleted }
+        if (target == null) {
+            log?.record("ReadingListManager.addPageToReadingList:missing_collection:${list.title}")
+            return MembershipChange.Rejected(
+                title,
+                LimitReason.COLLECTION_UNAVAILABLE,
+                "That collection is no longer available."
+            )
+        }
+        val existing = database.getPage(target.id, title.logicalKey)
+        if (existing != null && !existing.isQueuedForDeletion) {
+            return MembershipChange.Applied(
+                title = title,
+                collectionTitles = collectionTitles(title),
+                addedCollection = target.title,
+                wasAlreadySaved = true
+            )
+        }
+        val currentCount = database.getPages(target.id).count { !it.isQueuedForDeletion }
+        if (!ReadingListLimits.canAddArticle(currentCount)) {
+            log?.record("ReadingListManager.addPageToReadingList:limit_reached:${target.title}")
+            return MembershipChange.Rejected(
+                title,
+                LimitReason.ARTICLE_LIMIT_REACHED,
+                ReadingListLimits.describeArticleLimit()
+            )
+        }
+        if (existing != null) {
+            database.deletePage(existing)
+        }
+        val page = ReadingListPage(
+            id = explicitId ?: 0L,
+            listId = target.id,
+            title = title,
+            status = ReadingListPage.STATUS_NORMAL,
+            mtime = nextMtime()
+        )
+        database.insertPage(page)
+        log?.record("ReadingListManager.addPageToReadingList:${target.title}:${title.logicalKey}")
+        return MembershipChange.Applied(
+            title = title,
+            collectionTitles = collectionTitles(title),
+            addedCollection = target.title
+        )
+    }
+
+    fun removePageFromReadingList(listId: Long, title: PageTitle): Boolean {
+        val page = database.getPage(listId, title.logicalKey) ?: return false
+        database.deletePage(page)
+        log?.record("ReadingListManager.removePageFromReadingList:$listId:${title.logicalKey}")
+        return true
+    }
+
+    /** Removes every membership of [title] and returns the memberships that were removed. */
+    fun removePageFromAllReadingLists(title: PageTitle): List<ReadList> {
+        val removed = memberships(title)
+        removed.forEach { removePageFromReadingList(it.id, title) }
+        log?.record("ReadingListManager.removePageFromAllReadingLists:${title.logicalKey}:${removed.size}")
+        return removed
+    }
+
+    /** Toggles membership of [title] in the collection identified by [collectionId]. */
+    fun toggleCollection(title: PageTitle, collectionId: Long): MembershipChange {
+        val list = findListById(collectionId)
+        if (list == null) {
+            // The collection was removed while the sheet was on screen. The row callback that is
+            // still bound to it must not fall back to any other collection.
+            log?.record("ReadingListManager.toggleCollection:collection_unavailable:$collectionId")
+            return MembershipChange.Rejected(
+                title,
+                LimitReason.COLLECTION_UNAVAILABLE,
+                "That collection is no longer available."
+            )
+        }
+        val page = database.getPage(list.id, title.logicalKey)
+        return if (page != null && !page.isQueuedForDeletion) {
+            removePageFromReadingList(list.id, title)
+            MembershipChange.Applied(
+                title = title,
+                collectionTitles = collectionTitles(title),
+                removedCollection = list.title
+            )
+        } else {
+            addPageToReadingList(list, title)
+        }
+    }
+
+    /**
+     * Stages every membership of [title] for removal. Staged rows stop being rendered as active
+     * memberships immediately; they are still recoverable through undo.
+     */
+    fun queueArticleForDeletion(title: PageTitle): List<ReadingListPage> {
+        val active = database.getAllPages()
+            .filter { it.title.logicalKey == title.logicalKey && !it.isQueuedForDeletion }
+        active.forEach { database.updatePage(it.copy(status = ReadingListPage.STATUS_QUEUE_FOR_DELETE)) }
+        if (active.isNotEmpty()) {
+            log?.record("ReadingListManager.queueArticleForDeletion:${title.logicalKey}:${active.size}")
+        }
+        return active
+    }
+
+    /** Physically drops [title] from every collection, used after the undo window closes. */
+    fun purgeArticle(title: PageTitle) {
+        database.deletePages { it.title.logicalKey == title.logicalKey }
+        log?.record("ReadingListManager.purgeArticle:${title.logicalKey}")
+    }
+}
