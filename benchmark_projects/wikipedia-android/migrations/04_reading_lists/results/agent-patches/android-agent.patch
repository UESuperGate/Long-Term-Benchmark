+        arr("visibleArticleRows")?.let { (0 until it.length()).forEach { index -> descriptors.add(it.opt(index)) } }
+        arr("hiddenByFilter")?.let { (0 until it.length()).forEach { index -> descriptors.add(it.opt(index)) } }
+        descriptors.forEach { entry ->
+            when (entry) {
+                is String -> applyMemberships(PageTitle.fromKey(entry), listOf(ReadList.DEFAULT_TITLE))
+                is JSONObject -> {
+                    val article = entry.stringOrNull("article") ?: entry.stringOrNull("title") ?: return@forEach
+                    val explicitId = entry.optLongOrNull("id")
+                    val collections = entry.optJSONArray("collections")?.strings()
+                        ?.ifEmpty { null }
+                        ?: listOf(ReadList.DEFAULT_TITLE)
+                    applyMemberships(PageTitle.fromKey(article), collections, explicitId)
+                }
+            }
+        }
+    }
+
+    private fun seedSingleArticleMemberships() {
+        val memberships = arr("memberships")?.strings() ?: return
+        val title = pendingSheetTitle() ?: soleSavedArticle() ?: return
+        applyMemberships(title, memberships)
+    }
+
+    /** Articles staged for removal by a destructive action, together with their undo snapshot. */
+    private fun seedDeletionQueue() {
+        val queued = obj("queuedForDeletion") ?: return
+        val articles = mutableListOf<PageTitle>()
+        val snapshots = mutableListOf<ArticleMembershipSnapshot>()
+        val keys = queued.keys()
+        while (keys.hasNext()) {
+            val article = keys.next()
+            val title = PageTitle.fromKey(article)
+            queued.optJSONArray(article)?.strings()?.forEach { collectionTitle ->
+                val list = ensureCollection(collectionTitle)
+                env.manager.addPageToReadingList(list, title)
+                snapshots.add(ArticleMembershipSnapshot(list.id, list.title, title))
+            }
+            articles.add(title)
+        }
+        env.undo.trackArticles(articles, snapshots)
+        articles.forEach { env.manager.queueArticleForDeletion(it) }
+        if (flag("undoAvailable") == false) {
+            env.undo.clear()
+        }
+    }
+
+    /**
+     * Reproduces a collection row the sheet rendered and sync removed afterwards: the collection
+     * is created through the production action, its id is captured the way the sheet captures it,
+     * and the sync removal then takes the collection away. The queued toggle still refers to the
+     * id that is no longer there.
+     */
+    private fun seedStaleCollectionToggle() {
+        val queued = obj("queuedCollectionToggle") ?: return
+        val title = queued.optString("title", ReadList.DEFAULT_TITLE)
+        val created = env.manager.createCollection(title)
+        staleCollectionId = queued.optLongOrNull("collectionId") ?: created.id
+        val stillPresent = arr("roomCollections")?.objects()?.any { it.optString("title") == title } == true ||
+            arr("roomLists")?.objects()?.any { it.optString("title") == title } == true ||
+            arr("collectionTitles")?.strings()?.contains(title) == true
+        if (!stillPresent) {
+            log.record("ReadingListSync.removeCollection:${created.title}")
+            env.manager.deleteCollection(created)
+        }
+    }
+
+    private fun seedAccountAndSyncPreference() {
+        env.accountState.update(accountInfo)
+        flag("readingListSyncEnabled")?.let { env.sync.setSyncEnabled(it) }
+        (obj("syncPayload") ?: obj("remoteLists"))?.let { env.viewModel.pendingRemoteSync = parseRemoteLists(it) }
+    }
+
+    private fun parseRemoteLists(json: JSONObject): List<ReadingListSync.RemoteList> {
+        val entries = json.optJSONArray("remoteLists")?.objects()
+            ?: json.optJSONArray("lists")?.objects()
+            ?: emptyList()
+        return entries.map { entry ->
+            ReadingListSync.RemoteList(
+                title = entry.optString("title", ReadList.DEFAULT_TITLE),
+                articles = entry.optJSONArray("articles")?.strings()?.map { PageTitle.fromKey(it) } ?: emptyList()
+            )
+        }
+    }
+
+    private fun seedViewState() {
+        val tab = SavedTab.parse(str("selectedTab") ?: obj("savedSurface")?.stringOrNull("selectedTab"))
+        if (tab != null) {
+            env.viewModel.onSelectTab(tab)
+        }
+        str("searchQuery")?.let { query ->
+            fragment.onSearchQueryChanged(query)
+            scheduler.advanceBy(num("searchDebounceMillis", SavedScheduler.SEARCH_DEBOUNCE_DELAY_MS))
+        }
+        ArticleFilter.parse(str("selectedArticleFilter"))?.let { env.viewModel.onFilterSelected(it) }
+        obj("selection")?.let { selection ->
+            if (selection.optBoolean("enabled", false)) {
+                env.viewModel.onStartSelectionMode()
+                selection.optJSONArray("selectedPageIds")?.ordinals()?.forEach { id ->
+                    env.viewModel.onToggleSelection(id.toLong())
+                }
+            }
+        }
+    }
+
+    private fun seedOfflineAvailability() {
+        val availability = obj("offlineAvailability") ?: return
+        val keys = availability.keys()
+        while (keys.hasNext()) {
+            val article = keys.next()
+            val entry = availability.optJSONObject(article) ?: continue
+            val status = ArticleOfflineStatus.entries.firstOrNull {
+                it.name.equals(entry.optString("status"), ignoreCase = true)
+            } ?: continue
+            val progress = if (entry.has("downloadProgress")) entry.optInt("downloadProgress") else -1
+            env.offlineStore.setStatus(PageTitle.fromKey(article), status, progress)
+        }
+    }
+
+    private fun ensureCollection(title: String, isDefault: Boolean = declaredDefaultTitles.contains(title)): ReadList =
+        if (isDefault) {
+            env.manager.collections().firstOrNull { it.isDefault }
+                ?: env.manager.createCollection(title, isDefault = true)
+        } else {
+            env.manager.findListByTitle(title) ?: env.manager.createCollection(title)
+        }
+
+    private fun applyMemberships(title: PageTitle, collectionTitles: List<String>, explicitId: Long? = null) {
+        collectionTitles.forEachIndexed { index, collectionTitle ->
+            val list = ensureCollection(collectionTitle)
+            env.manager.addPageToReadingList(list, title, if (index == 0) explicitId else null)
+        }
+    }
+
+    private fun soleSavedArticle(): PageTitle? {
+        val keys = LinkedHashSet<String>()
+        env.database.getAllPages().filter { !it.isQueuedForDeletion }.forEach { keys.add(it.title.logicalKey) }
+        return keys.singleOrNull()?.let { PageTitle.fromKey(it) }
+    }
+
+    // ------------------------------------------------------------------ transitions
+
+    /** The article the Save sheet was asked about, taken from the scenario state. */
+    fun pendingSheetTitle(): PageTitle? {
+        obj("saveSheet")?.stringOrNull("article")?.let { return PageTitle.fromKey(it) }
+        str("article")?.let { return PageTitle.fromKey(it) }
+        val articleJson = obj("article") ?: return null
+        return PageTitle.fromJson(articleJson)
+    }
+
+    fun sheetArticle(): String = sheet?.pageTitle?.logicalKey.orEmpty()
+
+    fun presentCollectionTitles(): List<String> = env.manager.collections().map { it.title }
+
+    fun membershipsFor(articleKey: String): List<String> {
+        if (articleKey.isEmpty()) {
+            return emptyList()
+        }
+        return env.manager.collectionTitles(PageTitle.fromKey(articleKey))
+    }
+
+    fun openSheet(title: PageTitle): SaveArticleSheetDialog {
+        sheet?.takeIf { it.pageTitle.logicalKey == title.logicalKey }?.let { return it }
+        val opened = fragment.openSaveArticleSheet(title)
+        sheet = opened
+        effect(
+            "save_sheet_memberships",
+            "article" to title.logicalKey,
+            "isSaved" to opened.isSaved,
+            "memberships" to jsonArrayOf(opened.memberships.map { it.title }),
+            "selectableCollections" to jsonArrayOf(opened.selectableCollections.map { it.title })
+        )
+        return opened
+    }
+
+    /**
+     * Refresh, retry and completion.
+     *
+     * When the scenario records that an earlier refresh ended in a login prompt, that attempt is
+     * replayed first: the account is signed out, the refresh returns immediately to idle with a
+     * login prompt and dispatches nothing. The login then refreshes eligibility, the retry starts
+     * a sync, and the refresh only ends once sync reports completion.
+     */
+    fun runRefreshAndSync() {
+        if (obj("previousRefreshAttempt")?.optString("outcome") == "login_prompt") {
+            env.accountState.onLogout()
+            fragment.onPullToRefresh()
+            loginPromptShown = env.fragment.uiState.feedback == SavedFeedback.LOGIN_REQUIRED
+            effect(
+                "refresh_ineligible_account",
+                "isRefreshing" to env.fragment.uiState.isRefreshing,
+                "syncDispatched" to syncDispatched,
+                "loginPromptShown" to loginPromptShown
+            )
+        }
+        fragment.onLoginStateChanged(accountInfo)
+        fragment.onPullToRefresh()
+        syncDispatched = true
+        effect("refresh_dispatched", "isRefreshing" to env.fragment.uiState.isRefreshing)
+        env.sync.onEvent(ReadingListSyncEvent.started())
+        effect("sync_event_running", "isRefreshing" to env.fragment.uiState.isRefreshing)
+        env.sync.onEvent(ReadingListSyncEvent.finished())
+        syncCompleted = true
+        effect("sync_event_completed", "isRefreshing" to env.fragment.uiState.isRefreshing)
+    }
+
+    // ------------------------------------------------------------------ reporting
+
+    fun effect(name: String, vararg fields: Pair<String, Any?>) {
+        val entry = JSONObject()
+        entry.put("effect", name)
+        fields.forEach { (key, value) -> if (value != null) entry.put(key, value) }
+        runtime.effects.put(entry)
+    }
+
+    /** Publishes the outcome of the transition and marks it complete. */
+    fun finish(outcome: String) {
+        val state = fragment.uiState
+        effect("outcome", "name" to outcome, "uiState" to state.toJson())
+
+        val persistence = runtime.persistence
+        persistence.put("outcome", outcome)
+        persistence.put("uiState", state.toJson())
+        persistence.put(
+            "sortModes",
+            jsonOf(
+                "ALL_ARTICLES" to state.articleSortMode.ordinal,
+                "COLLECTIONS" to state.collectionSortMode.ordinal
+            )
+        )
+        persistence.put("readingListSyncEnabled", env.sync.isSyncEnabled())
+        persistence.put(
+            "collections",
+            jsonArrayOf(env.manager.collections().map { it.toJson() })
+        )
+        persistence.put(
+            "memberships",
+            jsonArrayOf(
+                env.manager.collections().map { list ->
+                    jsonOf(
+                        "collection" to list.title,
+                        "isDefault" to list.isDefault,
+                        "articles" to jsonArrayOf(
+                            env.database.getPages(list.id)
+                                .filter { !it.isQueuedForDeletion }
+                                .map { it.title.logicalKey }
+                        )
+                    )
+                }
+            )
+        )
+        persistence.put(
+            "selection",
+            jsonOf(
+                "enabled" to state.selectionEnabled,
+                "selectedPageIds" to jsonArrayOf(state.selectedPageIds),
+                "visibleRowIds" to jsonArrayOf(state.visibleRowIds())
+            )
+        )
+        persistence.put(
+            "undo",
+            jsonOf("available" to state.undoAvailable, "description" to state.undoDescription)
+        )
+        persistence.put(
+            "refresh",
+            jsonOf(
+                "syncDispatched" to syncDispatched,
+                "syncCompleted" to syncCompleted,
+                "loginPromptShown" to loginPromptShown,
+                "isRefreshing" to state.isRefreshing
+            )
+        )
+        persistence.put("emptyState", state.toJson().getJSONObject("emptyState"))
+        val snapshot = JSONObject().put("effect", "database").put("database", env.database.debugSnapshot())
+        runtime.effects.put(snapshot)
+        runtime.complete()
+    }
 }
 
+/** Namespaced durable store so application keys never collide with unrelated preferences. */
+private class PrefixedKeyValueStore(
+    private val delegate: KeyValueStore,
+    private val prefix: String
+) : KeyValueStore {
+    override fun getString(key: String): String? = delegate.getString(prefix + key)
+
+    override fun putString(key: String, value: String) = delegate.putString(prefix + key, value)
+
+    override fun getBoolean(key: String, fallback: Boolean): Boolean = delegate.getBoolean(prefix + key, fallback)
+
+    override fun putBoolean(key: String, value: Boolean) = delegate.putBoolean(prefix + key, value)
+}
