@@ -0,0 +1,34 @@
+package org.wikipedia.util
+
+/** Ordered record of the production entry points that a transition actually executed. */
+interface ProductionLog {
+    fun record(method: String)
+}
+
+/** In-memory [ProductionLog]; the sequence is what an external observer inspects. */
+class RecordingProductionLog : ProductionLog {
+    private val methods = mutableListOf<String>()
+
+    val invocations: List<String> get() = methods.toList()
+
+    override fun record(method: String) {
+        methods.add(method)
+    }
+
+    fun clear() {
+        methods.clear()
+    }
+}
+
+/** Wraps a list so that production code can contribute to an externally owned record. */
+class ListBackedProductionLog(private val sink: MutableList<String>) : ProductionLog {
+    override fun record(method: String) {
+        sink.add(method)
+    }
+}
+
+class CompositeProductionLog(private val delegates: List<ProductionLog>) : ProductionLog {
+    override fun record(method: String) {
+        delegates.forEach { it.record(method) }
+    }
+}
