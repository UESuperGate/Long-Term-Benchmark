index 0000000000000000000000000000000000000000..702a3b6099e228c8b7507601e17a2f1d103ac8c3
--- /dev/null
+++ b/app/src/main/upstream/kotlin/org/wikipedia/database/AppDatabase.kt
@@ -0,0 +1,173 @@
+package org.wikipedia.database
+
+import org.wikipedia.readinglist.ReadList
+import org.wikipedia.readinglist.ReadingListPage
+import org.wikipedia.readinglist.ReadingListWithPages
+import org.wikipedia.util.jsonArrayOf
+import org.wikipedia.util.jsonOf
+import org.wikipedia.util.objectList
+import org.json.JSONObject
+
+/**
+ * Application-owned persistence for the Saved experience.
+ *
+ * Two tables: collections (`ReadList`) and memberships (`ReadingListPage`). Reads are exposed as
+ * [QueryFlow] projections so that every surface watching saved content is re-projected after a
+ * write instead of being rebuilt by hand. Writes bump a change counter and re-publish the
+ * projections, and are mirrored into the [KeyValueStore] so state survives process death.
+ */
+class AppDatabase(private val store: KeyValueStore? = null) {
+
+    private val lists = LinkedHashMap<Long, ReadList>()
+    private val pages = LinkedHashMap<Long, ReadingListPage>()
+    private var nextListId = 1L
+    private var nextPageId = 1L
+
+    private val listsFlow = QueryFlow { lists.values.toList() }
+    private val withPagesFlow = QueryFlow { loadReadingListsWithPages() }
+
+    init {
+        restore()
+    }
+
+    // ---------------------------------------------------------------- collections
+
+    fun insertList(list: ReadList): Long {
+        val id = if (list.id > 0) list.id else nextListId
+        val stored = list.copy(id = id)
+        lists[id] = stored
+        if (id >= nextListId) {
+            nextListId = id + 1
+        }
+        invalidate()
+        return id
+    }
+
+    fun updateList(list: ReadList) {
+        if (lists.containsKey(list.id)) {
+            lists[list.id] = list
+            invalidate()
+        }
+    }
+
+    fun deleteList(list: ReadList) {
+        lists.remove(list.id)
+        pages.values.filter { it.listId == list.id }.forEach { pages.remove(it.id) }
+        invalidate()
+    }
+
+    fun getList(id: Long): ReadList? = lists[id]
+
+    fun getListByTitle(title: String): ReadList? =
+        lists.values.firstOrNull { !it.isDeleted && it.title.equals(title, ignoreCase = true) }
+
+    fun getLists(): List<ReadList> = lists.values.filter { !it.isDeleted }
+
+    fun observeLists(): QueryFlow<List<ReadList>> = listsFlow
+
+    // ---------------------------------------------------------------- memberships
+
+    fun insertPage(page: ReadingListPage): Long {
+        val id = if (page.id > 0) page.id else nextPageId
+        val stored = page.copy(id = id)
+        pages[id] = stored
+        if (id >= nextPageId) {
+            nextPageId = id + 1
+        }
+        invalidate()
+        return id
+    }
+
+    fun updatePage(page: ReadingListPage) {
+        if (pages.containsKey(page.id)) {
+            pages[page.id] = page
+            invalidate()
+        }
+    }
+
+    fun deletePage(page: ReadingListPage) {
+        pages.remove(page.id)
+        invalidate()
+    }
+
+    fun deletePages(predicate: (ReadingListPage) -> Boolean): Int {
+        val doomed = pages.values.filter(predicate)
+        doomed.forEach { pages.remove(it.id) }
+        if (doomed.isNotEmpty()) {
+            invalidate()
+        }
+        return doomed.size
+    }
+
+    fun getPage(listId: Long, articleKey: String): ReadingListPage? =
+        pages.values.firstOrNull { it.listId == listId && it.title.logicalKey == articleKey }
+
+    fun getPages(listId: Long): List<ReadingListPage> =
+        pages.values.filter { it.listId == listId }.toList()
+
+    fun getAllPages(): List<ReadingListPage> = pages.values.toList()
+
+    // ---------------------------------------------------------------- projections
+
+    /** Collections joined with their active articles; queued-for-delete rows are excluded. */
+    fun loadReadingListsWithPages(): List<ReadingListWithPages> =
+        lists.values.filter { !it.isDeleted }.map { ReadingListWithPages.project(it, pages.values.toList()) }
+
+    fun observeReadingListsWithPages(): QueryFlow<List<ReadingListWithPages>> = withPagesFlow
+
+    fun invalidate() {
+        listsFlow.invalidate()
+        withPagesFlow.invalidate()
+        persist()
+    }
+
+    // ---------------------------------------------------------------- durability
+
+    private fun persist() {
+        val target = store ?: return
+        target.putString(KEY_LISTS, rowsJson(lists.values.map { it.toJson() }).toString())
+        target.putString(KEY_PAGES, rowsJson(pages.values.map { it.toJson() }).toString())
+    }
+
+    private fun restore() {
+        val target = store ?: return
+        val storedLists = target.getString(KEY_LISTS)?.let { runCatching { JSONObject(it) }.getOrNull() }
+        val storedPages = target.getString(KEY_PAGES)?.let { runCatching { JSONObject(it) }.getOrNull() }
+        if (storedLists == null && storedPages == null) {
+            return
+        }
+        storedLists?.let { json ->
+            json.objectList("rows").forEach { raw ->
+                val list = ReadList.fromJson(raw)
+                lists[list.id] = list
+                if (list.id >= nextListId) {
+                    nextListId = list.id + 1
+                }
+            }
+        }
+        storedPages?.let { json ->
+            json.objectList("rows").forEach { raw ->
+                val page = ReadingListPage.fromJson(raw)
+                pages[page.id] = page
+                if (page.id >= nextPageId) {
+                    nextPageId = page.id + 1
+                }
+            }
+        }
+        invalidate()
+    }
+
+    /** Compact snapshot of the tables; used by diagnostics and by tooling. */
+    fun debugSnapshot(): JSONObject = jsonOf(
+        "collections" to jsonArrayOf(lists.values.map { it.toJson() }),
+        "memberships" to jsonArrayOf(pages.values.map { it.toJson() })
+    )
+
+    private fun rowsJson(rows: List<JSONObject>): JSONObject =
+        jsonOf("rows" to jsonArrayOf(rows))
+
+    companion object {
+        private const val KEY_LISTS = "reading_list_collections"
+        private const val KEY_PAGES = "reading_list_memberships"
+    }
+}
