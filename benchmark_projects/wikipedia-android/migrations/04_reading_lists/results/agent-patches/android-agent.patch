+package org.wikipedia.readinglist
+
+import org.wikipedia.page.PageTitle
+import org.wikipedia.util.ProductionLog
+
+/**
+ * The sheet a reader opens from any article entry point.
+ *
+ * Opening it for a [PageTitle] saves the article if it is not saved yet and then lists the
+ * collections it currently belongs to. From there the reader can create a collection, add or
+ * remove the article from any collection, or unsave the article entirely. Unsaving an article
+ * that belongs to a user-created collection asks for confirmation first; cancelling that
+ * confirmation leaves every membership exactly as it was.
+ */
+class SaveArticleSheetDialog(
+    val pageTitle: PageTitle,
+    private val actions: ReadingListArticleActions,
+    private val onFeedback: (SavedFeedback, String?) -> Unit,
+    private val log: ProductionLog
+) {
+    /** Collections a reader may add the article to; the default collection is not offered. */
+    val selectableCollections: List<ReadList>
+        get() = state.collections.filter { !it.isDefault }
+
+    private val state: ArticleSheetState = actions.sheetState(pageTitle)
+
+    val isSaved: Boolean get() = state.isSaved
+    val memberships: List<ReadList> get() = state.collections
+    val pendingUnsaveConfirmation: Boolean get() = state.pendingUnsaveConfirmation
+
+    init {
+        log.record("SaveArticleSheetDialog.onCreate:${pageTitle.logicalKey}")
+        // Opening the sheet for an article makes sure it is saved, then shows its memberships.
+        when (val change = actions.ensureSaved(pageTitle)) {
+            is MembershipChange.Applied -> {
+                state.markResolved(change.title)
+                state.refresh(actions)
+                onFeedback(SavedFeedback.ARTICLE_SAVED, change.title.displayTitle)
+            }
+            is MembershipChange.Rejected -> onFeedback(SavedFeedback.LIMIT_REACHED, change.message)
+        }
+    }
+
+    /** Applies a pending collection-row callback that was rendered before a recomposition. */
+    fun onCollectionRowToggled(collectionId: Long): MembershipChange {
+        log.record("SaveArticleSheetDialog.onCollectionRowToggled:$collectionId")
+        val result = actions.toggleCollection(state.resolvedTitle, collectionId)
+        state.refresh(actions)
+        when (result) {
+            is MembershipChange.Applied -> onFeedback(SavedFeedback.NONE, null)
+            is MembershipChange.Rejected -> onFeedback(SavedFeedback.COLLECTION_UNAVAILABLE, result.message)
+        }
+        return result
+    }
+
+    fun onCreateCollectionClicked(collectionTitle: String): MembershipChange {
+        log.record("SaveArticleSheetDialog.onCreateCollectionClicked:$collectionTitle")
+        val result = actions.createCollectionAndAdd(state.resolvedTitle, collectionTitle)
+        state.lastChange = result
+        state.refresh(actions)
+        when (result) {
+            is MembershipChange.Applied -> onFeedback(SavedFeedback.COLLECTION_CREATED, collectionTitle)
+            is MembershipChange.Rejected -> onFeedback(SavedFeedback.LIMIT_REACHED, result.message)
+        }
+        return result
+    }
+
+    /** Removes the article from every collection, after confirmation when one is required. */
+    fun onUnsaveClicked(): UnsaveOutcome {
+        log.record("SaveArticleSheetDialog.onUnsaveClicked")
+        val outcome = actions.unsave(state.resolvedTitle)
+        when (outcome) {
+            is UnsaveOutcome.Removed -> {
+                state.pendingUnsaveConfirmation = false
+                state.refresh(actions)
+                onFeedback(SavedFeedback.ARTICLE_UNSAVED, state.resolvedTitle.displayTitle)
+            }
+            is UnsaveOutcome.NeedsConfirmation -> {
+                state.pendingUnsaveConfirmation = true
+                state.confirmationCollections = outcome.collectionTitles
+            }
+        }
+        return outcome
+    }
+
+    fun onConfirmUnsaveClicked(): UnsaveOutcome {
+        log.record("SaveArticleSheetDialog.onConfirmUnsaveClicked")
+        actions.confirmUnsave(state.resolvedTitle)
+        state.pendingUnsaveConfirmation = false
+        state.confirmationCollections = emptyList()
+        state.refresh(actions)
+        onFeedback(SavedFeedback.ARTICLE_UNSAVED, state.resolvedTitle.displayTitle)
+        return UnsaveOutcome.Removed
+    }
+
+    /**
+     * Dismisses the confirmation. Nothing is mutated here: the unsave only ever happens through
+     * [onConfirmUnsaveClicked], so cancelling leaves every membership intact.
+     */
+    fun onUnsaveConfirmationCancelled() {
+        log.record("SaveArticleSheetDialog.onUnsaveConfirmationCancelled")
+        state.pendingUnsaveConfirmation = false
+        state.confirmationCollections = emptyList()
+        state.refresh(actions)
+    }
+
+    fun onDismiss() {
+        log.record("SaveArticleSheetDialog.onDismiss")
+        state.pendingUnsaveConfirmation = false
+    }
+}
