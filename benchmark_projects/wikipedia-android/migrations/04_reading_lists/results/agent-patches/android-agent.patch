+package org.wikipedia.readinglist
+
+import org.wikipedia.database.KeyValueStore
+
+/**
+ * Durable Saved preferences.
+ *
+ * Sort mode is a per-view setting: what the reader last chose for All articles and what they last
+ * chose for Collections are stored under separate keys, so changing one never disturbs the other
+ * and both survive a restart.
+ */
+class SavedPreferences(private val store: KeyValueStore) {
+
+    var articleSortMode: ReadingListSortMode
+        get() = ReadingListSortMode.fromOrdinal(store.getString(KEY_ARTICLE_SORT)?.toIntOrNull() ?: 0)
+        set(value) {
+            store.putString(KEY_ARTICLE_SORT, value.ordinal.toString())
+        }
+
+    var collectionSortMode: ReadingListSortMode
+        get() = ReadingListSortMode.fromOrdinal(store.getString(KEY_COLLECTION_SORT)?.toIntOrNull() ?: 0)
+        set(value) {
+            store.putString(KEY_COLLECTION_SORT, value.ordinal.toString())
+        }
+
+    var syncReminderSeen: Boolean
+        get() = store.getBoolean(KEY_SYNC_REMINDER_SEEN, false)
+        set(value) {
+            store.putBoolean(KEY_SYNC_REMINDER_SEEN, value)
+        }
+
+    companion object {
+        const val KEY_ARTICLE_SORT = "saved_sort_mode_articles"
+        const val KEY_COLLECTION_SORT = "saved_sort_mode_collections"
+        private const val KEY_SYNC_REMINDER_SEEN = "saved_sync_reminder_seen"
+    }
+}
