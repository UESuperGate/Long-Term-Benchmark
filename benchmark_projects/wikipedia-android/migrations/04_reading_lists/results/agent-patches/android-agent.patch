+package org.wikipedia.util
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** Reads a string entry, returning `null` when the key is absent or JSON `null`. */
+fun JSONObject.stringOrNull(key: String): String? =
+    if (has(key) && !isNull(key)) optString(key) else null
+
+fun JSONObject.stringOr(key: String, fallback: String): String = stringOrNull(key) ?: fallback
+
+fun JSONObject.booleanOrNull(key: String): Boolean? =
+    if (has(key) && !isNull(key)) optBoolean(key) else null
+
+fun JSONObject.booleanOr(key: String, fallback: Boolean): Boolean = booleanOrNull(key) ?: fallback
+
+fun JSONObject.intOr(key: String, fallback: Int): Int = if (has(key) && !isNull(key)) optInt(key, fallback) else fallback
+
+fun JSONObject.longOr(key: String, fallback: Long): Long = if (has(key) && !isNull(key)) optLong(key, fallback) else fallback
+
+fun JSONObject.objectOrNull(key: String): JSONObject? =
+    if (has(key) && !isNull(key)) optJSONObject(key) else null
+
+fun JSONObject.arrayOrNull(key: String): JSONArray? =
+    if (has(key) && !isNull(key)) optJSONArray(key) else null
+
+fun JSONObject.stringList(key: String): List<String> {
+    val array = arrayOrNull(key) ?: return emptyList()
+    return (0 until array.length()).mapNotNull { index ->
+        val value = array.opt(index)
+        if (value == null || value === JSONObject.NULL) null else value.toString()
+    }
+}
+
+fun JSONObject.objectList(key: String): List<JSONObject> {
+    val array = arrayOrNull(key) ?: return emptyList()
+    return (0 until array.length()).mapNotNull { index -> array.optJSONObject(index) }
+}
+
+/** Builds a [JSONObject] from pairs, dropping entries whose value is `null`. */
+fun jsonOf(vararg pairs: Pair<String, Any?>): JSONObject {
+    val json = JSONObject()
+    pairs.forEach { (key, value) -> if (value != null) json.put(key, value) }
+    return json
+}
+
+fun jsonArrayOf(values: Collection<Any?>): JSONArray {
+    val array = JSONArray()
+    values.forEach { array.put(it ?: JSONObject.NULL) }
+    return array
+}
