diff --git a/entry/src/main/ets/saved/data/ReadingListDatabase.ets b/entry/src/main/ets/saved/data/ReadingListDatabase.ets
new file mode 100644
index 0000000000000000000000000000000000000000..27aa8dddbb4076e20a0e3bb5df2a19da997fe8ab
--- /dev/null
+++ b/entry/src/main/ets/saved/data/ReadingListDatabase.ets
@@ -0,0 +1,391 @@
+/**
+ * Reading list storage.
+ *
+ * This is the offline cache that backs the Saved experience. It keeps the two
+ * relational tables the feature is built on (collections and article
+ * memberships) and publishes a change flow so that every derived query
+ * re-projects itself. Writes always go through the DAOs, never through the UI.
+ */
+import { Flow } from './Flow';
+import { PageTitle } from '../model/PageTitle';
+import { ReadingListPageEntity, RoomListEntity, RoomListWithPages } from '../model/Entities';
+import {
+  STATUS_ACTIVE,
+  STATUS_DELETED,
+  STATUS_QUEUE_FOR_DELETE,
+  isProjectedStatus
+} from '../model/SavedConstants';
+
+export class ReadingListDatabase {
+  private lists: RoomListEntity[] = [];
+  private pages: ReadingListPageEntity[] = [];
+  private nextListId: number = 1;
+  private nextPageId: number = 1;
+  private clock: number = 0;
+  private readonly changes: Flow<number> = new Flow<number>(0);
+  private revision: number = 0;
+
+  constructor() {
+    this.nextListId = 1;
+    this.nextPageId = 1;
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* Change notification                                                     */
+  /* ---------------------------------------------------------------------- */
+
+  /** Emits an increasing revision whenever a table is mutated. */
+  changeFlow(): Flow<number> {
+    return this.changes;
+  }
+
+  private touch(): void {
+    this.revision = this.revision + 1;
+    this.changes.emit(this.revision);
+  }
+
+  private tick(): number {
+    this.clock = this.clock + 1;
+    return this.clock;
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* Reads                                                                   */
+  /* ---------------------------------------------------------------------- */
+
+  allLists(): RoomListEntity[] {
+    return this.lists;
+  }
+
+  allPages(): ReadingListPageEntity[] {
+    return this.pages;
+  }
+
+  listById(listId: number): RoomListEntity | undefined {
+    for (let index = 0; index < this.lists.length; index++) {
+      if (this.lists[index].id === listId) {
+        return this.lists[index];
+      }
+    }
+    return undefined;
+  }
+
+  listByTitle(title: string): RoomListEntity | undefined {
+    for (let index = 0; index < this.lists.length; index++) {
+      if (this.lists[index].title === title) {
+        return this.lists[index];
+      }
+    }
+    return undefined;
+  }
+
+  defaultList(): RoomListEntity | undefined {
+    for (let index = 0; index < this.lists.length; index++) {
+      if (this.lists[index].isDefault) {
+        return this.lists[index];
+      }
+    }
+    return undefined;
+  }
+
+  /** Every membership row, including rows queued for deletion. */
+  pagesForList(listId: number): ReadingListPageEntity[] {
+    const result: ReadingListPageEntity[] = [];
+    for (let index = 0; index < this.pages.length; index++) {
+      if (this.pages[index].listId === listId) {
+        result.push(this.pages[index]);
+      }
+    }
+    return result;
+  }
+
+  /** Membership rows that are projected to the UI for a collection. */
+  activePagesForList(listId: number): ReadingListPageEntity[] {
+    const result: ReadingListPageEntity[] = [];
+    const rows = this.pagesForList(listId);
+    for (let index = 0; index < rows.length; index++) {
+      if (rows[index].isActive) {
+        result.push(rows[index]);
+      }
+    }
+    return result;
+  }
+
+  pageById(pageId: number): ReadingListPageEntity | undefined {
+    for (let index = 0; index < this.pages.length; index++) {
+      if (this.pages[index].id === pageId) {
+        return this.pages[index];
+      }
+    }
+    return undefined;
+  }
+
+  membership(listId: number, identity: string): ReadingListPageEntity | undefined {
+    for (let index = 0; index < this.pages.length; index++) {
+      const row = this.pages[index];
+      if (row.listId === listId && row.identity === identity) {
+        return row;
+      }
+    }
+    return undefined;
+  }
+
+  /** Collections that currently project an article, ignoring default flag. */
+  collectionTitlesOf(identity: string): string[] {
+    const titles: string[] = [];
+    for (let index = 0; index < this.pages.length; index++) {
+      const row = this.pages[index];
+      if (row.identity === identity && row.isActive) {
+        const list = this.listById(row.listId);
+        if (list !== undefined && titles.indexOf(list.title) < 0) {
+          titles.push(list.title);
+        }
+      }
+    }
+    return titles;
+  }
+
+  /**
+   * Collections holding an article. A default collection always sorts first so
+   * that "only in the default collection" can be decided from a stable prefix.
+   */
+  sortedCollectionTitlesOf(identity: string): string[] {
+    const titles = this.collectionTitlesOf(identity);
+    const ordered: string[] = [];
+    for (let index = 0; index < titles.length; index++) {
+      const list = this.listByTitle(titles[index]);
+      if (list !== undefined && list.isDefault) {
+        ordered.push(titles[index]);
+      }
+    }
+    for (let index = 0; index < titles.length; index++) {
+      if (ordered.indexOf(titles[index]) < 0) {
+        ordered.push(titles[index]);
+      }
+    }
+    return ordered;
+  }
+
+  /**
+   * The full set of projected collections, each with its active pages.
+   * Membership rows with `STATUS_QUEUE_FOR_DELETE` are excluded here, which is
+   * why an article pending deletion disappears from the Saved surface before
+   * the deletion is confirmed.
+   */
+  listsWithPages(): RoomListWithPages[] {
+    const projected: RoomListWithPages[] = [];
+    for (let index = 0; index < this.lists.length; index++) {
+      const list = this.lists[index];
+      projected.push(new RoomListWithPages(list, this.activePagesForList(list.id)));
+    }
+    return projected;
+  }
+
+  countLists(): number {
+    return this.lists.length;
+  }
+
+  countUserLists(): number {
+    let total = 0;
+    for (let index = 0; index < this.lists.length; index++) {
+      if (!this.lists[index].isDefault) {
+        total = total + 1;
+      }
+    }
+    return total;
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* Writes                                                                  */
+  /* ---------------------------------------------------------------------- */
+
+  insertList(list: RoomListEntity): RoomListEntity {
+    this.lists.push(list);
+    if (list.id >= this.nextListId) {
+      this.nextListId = list.id + 1;
+    }
+    this.touch();
+    return list;
+  }
+
+  insertPage(page: ReadingListPageEntity): ReadingListPageEntity {
+    this.pages.push(page);
+    if (page.id >= this.nextPageId) {
+      this.nextPageId = page.id + 1;
+    }
+    this.touch();
+    return page;
+  }
+
+  setPageStatus(pageId: number, status: string): ReadingListPageEntity | undefined {
+    const page = this.pageById(pageId);
+    if (page === undefined) {
+      return undefined;
+    }
+    page.status = status;
+    page.updatedAt = this.tick();
+    this.touch();
+    return page;
+  }
+
+  /** Permanently removes membership rows by identifier. */
+  hardDeletePages(pageIds: number[]): number {
+    let removed = 0;
+    for (let index = this.pages.length - 1; index >= 0; index--) {
+      if (pageIds.indexOf(this.pages[index].id) >= 0) {
+        this.pages.splice(index, 1);
+        removed = removed + 1;
+      }
+    }
+    if (removed > 0) {
+      this.touch();
+    }
+    return removed;
+  }
+
+  /** Moves every membership row of an article into the queue-for-delete status. */
+  queuePagesForIdentity(identity: string): number {
+    let queued = 0;
+    for (let index = 0; index < this.pages.length; index++) {
+      const page = this.pages[index];
+      if (page.identity === identity && page.status !== STATUS_DELETED) {
+        page.status = STATUS_QUEUE_FOR_DELETE;
+        page.updatedAt = this.tick();
+        queued = queued + 1;
+      }
+    }
+    if (queued > 0) {
+      this.touch();
+    }
+    return queued;
+  }
+
+  /** Undo: brings queued membership rows back as active. */
+  restoreQueuedPages(pageIds: number[]): number {
+    let restored = 0;
+    for (let index = 0; index < this.pages.length; index++) {
+      const page = this.pages[index];
+      if (pageIds.indexOf(page.id) >= 0 && page.status === STATUS_QUEUE_FOR_DELETE) {
+        page.status = STATUS_ACTIVE;
+        page.updatedAt = this.tick();
+        restored = restored + 1;
+      }
+    }
+    if (restored > 0) {
+      this.touch();
+    }
+    return restored;
+  }
+
+  queuedPages(): ReadingListPageEntity[] {
+    const queued: ReadingListPageEntity[] = [];
+    for (let index = 0; index < this.pages.length; index++) {
+      if (this.pages[index].isQueuedForDeletion) {
+        queued.push(this.pages[index]);
+      }
+    }
+    return queued;
+  }
+
+  /** Removes a collection and every membership row it owns. */
+  deleteListCascade(listId: number): RoomListEntity | undefined {
+    const list = this.listById(listId);
+    if (list === undefined) {
+      return undefined;
+    }
+    for (let index = this.pages.length - 1; index >= 0; index--) {
+      if (this.pages[index].listId === listId) {
+        this.pages.splice(index, 1);
+      }
+    }
+    for (let index = this.lists.length - 1; index >= 0; index--) {
+      if (this.lists[index].id === listId) {
+        this.lists.splice(index, 1);
+      }
+    }
+    this.touch();
+    return list;
+  }
+
+  /** Removes a collection but keeps its membership rows for undo. */
+  queueListForDeletion(listId: number): RoomListEntity | undefined {
+    const list = this.listById(listId);
+    if (list === undefined) {
+      return undefined;
+    }
+    for (let index = 0; index < this.pages.length; index++) {
+      const page = this.pages[index];
+      if (page.listId === listId && page.status !== STATUS_DELETED) {
+        page.status = STATUS_QUEUE_FOR_DELETE;
+        page.updatedAt = this.tick();
+      }
+    }
+    this.touch();
+    return list;
+  }
+
+  /** Undo for collection deletion: the collection and its rows come back. */
+  restoreList(listId: number): RoomListEntity | undefined {
+    const list = this.listById(listId);
+    if (list === undefined) {
+      return undefined;
+    }
+    for (let index = 0; index < this.pages.length; index++) {
+      const page = this.pages[index];
+      if (page.listId === listId && page.status === STATUS_QUEUE_FOR_DELETE) {
+        page.status = STATUS_ACTIVE;
+        page.updatedAt = this.tick();
+      }
+    }
+    this.touch();
+    return list;
+  }
+
+  reserveListId(): number {
+    return this.nextListId++;
+  }
+
+  reservePageId(): number {
+    return this.nextPageId++;
+  }
+
+  /** Uses a specific identifier that is known to be free. */
+  reserveSpecificListId(listId: number): number {
+    if (listId >= this.nextListId) {
+      this.nextListId = listId + 1;
+    }
+    return listId;
+  }
+
+  reserveSpecificPageId(pageId: number): number {
+    if (pageId >= this.nextPageId) {
+      this.nextPageId = pageId + 1;
+    }
+    return pageId;
+  }
+
+  /** Keeps automatic identifiers clear of identifiers that are already known. */
+  reserveListIdAtLeast(listId: number): void {
+    if (listId > this.nextListId) {
+      this.nextListId = listId;
+    }
+  }
+
+  reservePageIdAtLeast(pageId: number): void {
+    if (pageId > this.nextPageId) {
+      this.nextPageId = pageId;
+    }
+  }
+
+  nextTimestamp(): number {
+    return this.tick();
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* Diagnostics                                                             */
+  /* ---------------------------------------------------------------------- */
+
+  isProjecting(page: ReadingListPageEntity): boolean {
+    return isProjectedStatus(page.status);
+  }
+}
