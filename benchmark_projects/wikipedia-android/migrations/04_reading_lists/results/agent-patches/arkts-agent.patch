+/**
+ * Collection and article limits.
+ *
+ * Limits are a product rule, not a transport concern: when one of them is hit
+ * the requested addition is refused, the reason is surfaced to the reader and
+ * the existing memberships are left untouched.
+ */
+import {
+  LIMIT_MESSAGE_COLLECTION_COUNT,
+  LIMIT_MESSAGE_COLLECTION_FULL,
+  LIMIT_REASON_COLLECTION_COUNT,
+  LIMIT_REASON_COLLECTION_FULL,
+  MAX_ARTICLES_PER_COLLECTION,
+  MAX_COLLECTIONS_PER_USER
+} from './SavedConstants';
+
+export class LimitDecision {
+  readonly allowed: boolean;
+  readonly reason: string;
+  readonly message: string;
+
+  constructor(allowed: boolean, reason: string, message: string) {
+    this.allowed = allowed;
+    this.reason = reason;
+    this.message = message;
+  }
+}
+
+export class SavedLimitPolicy {
+  /** Guard for "add this article to that collection". */
+  static canAddArticle(currentArticleCount: number): LimitDecision {
+    if (currentArticleCount >= MAX_ARTICLES_PER_COLLECTION) {
+      return new LimitDecision(false, LIMIT_REASON_COLLECTION_FULL, LIMIT_MESSAGE_COLLECTION_FULL);
+    }
+    return new LimitDecision(true, '', '');
+  }
+
+  /** Guard for "create another collection". */
+  static canCreateCollection(currentUserCollectionCount: number): LimitDecision {
+    if (currentUserCollectionCount >= MAX_COLLECTIONS_PER_USER) {
+      return new LimitDecision(false, LIMIT_REASON_COLLECTION_COUNT, LIMIT_MESSAGE_COLLECTION_COUNT);
+    }
+    return new LimitDecision(true, '', '');
+  }
+
+  static maxArticlesPerCollection(): number {
+    return MAX_ARTICLES_PER_COLLECTION;
+  }
+
+  static maxCollectionsPerUser(): number {
+    return MAX_COLLECTIONS_PER_USER;
+  }
+}
