--- /dev/null
+++ b/entry/src/main/ets/saved/ui/SaveArticleSheetDialog.ets
@@ -0,0 +1,186 @@
+/**
+ * Save-article sheet.
+ *
+ * The sheet is the entry point an article screen opens after the reader taps
+ * "Save": the article is guaranteed to be saved before the sheet appears, and
+ * the sheet then presents its current collection membership so the reader can
+ * create a collection, move the article between collections or unsave it.
+ */
+import { LegacySavedStore } from '../../model/LegacySavedStore';
+import { PageTitle } from '../model/PageTitle';
+import { SaveArticleCollectionOption, SaveArticleSheetState, SavedUiState } from '../model/SavedUiState';
+
+/**
+ * Arguments of the sheet. A page title is mandatory: the sheet always works on
+ * one concrete article identity, never on a list of candidates.
+ */
+export class SaveArticleSheetDialogParams {
+  readonly pageTitle: PageTitle;
+  readonly store: LegacySavedStore;
+
+  constructor(pageTitle: PageTitle, store: LegacySavedStore) {
+    this.pageTitle = pageTitle;
+    this.store = store;
+  }
+}
+
+/**
+ * Production entry point of the sheet. The article is handed over as a
+ * `PageTitle` argument; opening it never invents an identity.
+ */
+export function openSaveArticleSheetDialog(pageTitle: PageTitle, store: LegacySavedStore): SaveArticleSheetDialogParams {
+  store.prepareSaveArticleSheet(pageTitle);
+  return new SaveArticleSheetDialogParams(pageTitle, store);
+}
+
+@Component
+export struct SaveArticleSheetDialog {
+  params: SaveArticleSheetDialogParams | undefined = undefined;
+  @State sheet: SaveArticleSheetState | null = null;
+  @State newCollectionTitle: string = '';
+  @State creatingCollection: boolean = false;
+
+  constructor(params: SaveArticleSheetDialogParams) {
+    super();
+    this.params = params;
+  }
+
+  aboutToAppear(): void {
+    this.sheetStore()?.features().observe((state: SavedUiState): void => {
+      this.sheet = state.saveSheet;
+    });
+  }
+
+  private sheetStore(): LegacySavedStore | undefined {
+    return this.params !== undefined ? this.params.store : undefined;
+  }
+
+  private articleTitle(): PageTitle {
+    return this.params !== undefined ? this.params.pageTitle : new PageTitle('', '', '');
+  }
+
+  private toggle(option: SaveArticleCollectionOption): void {
+    if (option.disabled) {
+      return;
+    }
+    this.sheetStore()?.toggleSheetCollection(option.id);
+  }
+
+  private createCollection(): void {
+    if (this.newCollectionTitle.trim().length === 0) {
+      return;
+    }
+    this.sheetStore()?.createCollection(this.newCollectionTitle);
+    this.newCollectionTitle = '';
+  }
+
+  build() {
+    Column({ space: 12 }) {
+      Text(this.articleTitle().displayTitle)
+        .fontSize(20)
+        .fontWeight(FontWeight.Bold)
+      Text(this.articleTitle().languageCode + ' · ' + this.articleTitle().apiTitle)
+        .fontSize(12)
+
+      if (this.sheet !== null) {
+        if (this.sheet.pendingConfirmation) {
+          this.buildConfirmation()
+        } else {
+          this.buildCollectionList()
+        }
+      }
+    }
+    .width('100%')
+    .padding(16)
+  }
+
+  @Builder
+  buildConfirmation() {
+    Column({ space: 12 }) {
+      Text('Remove from every collection?')
+        .fontSize(16)
+        .fontWeight(FontWeight.Bold)
+      Text('This article is in ' + this.confirmationSummary() + '. Removing it takes it out of all of them.')
+        .fontSize(13)
+      Row({ space: 12 }) {
+        Button('Cancel')
+          .onClick(() => {
+            this.sheetStore()?.cancelUnsaveConfirmation();
+          })
+        Button('Remove everywhere')
+          .onClick(() => {
+            this.sheetStore()?.confirmUnsave();
+          })
+      }
+    }
+    .width('100%')
+  }
+
+  @Builder
+  buildCollectionList() {
+    Column({ space: 8 }) {
+      if (this.sheet !== null) {
+        ForEach(this.sheet.collections, (option: SaveArticleCollectionOption) => {
+          Row({ space: 8 }) {
+            Checkbox({ name: option.id.toString(), group: 'saved-collections' })
+              .select(option.checked)
+              .enabled(!option.disabled)
+              .onChange(() => {
+                this.toggle(option);
+              })
+            Column({ space: 2 }) {
+              Text(option.title)
+                .fontSize(15)
+              if (option.disabled) {
+                Text('This collection is full')
+                  .fontSize(11)
+              }
+            }
+            .alignItems(HorizontalAlign.Start)
+          }
+          .width('100%')
+          .padding(8)
+        }, (option: SaveArticleCollectionOption) => option.id.toString())
+
+        Row({ space: 8 }) {
+          TextInput({ text: this.newCollectionTitle, placeholder: 'New collection' })
+            .layoutWeight(1)
+            .onChange((value: string) => {
+              this.newCollectionTitle = value;
+            })
+          Button('Add')
+            .enabled(!this.creatingCollection)
+            .onClick(() => {
+              this.createCollection();
+            })
+        }
+        .width('100%')
+
+        if (this.sheet.limitMessage.length > 0) {
+          Text(this.sheet.limitMessage)
+            .fontSize(12)
+        }
+
+        Row({ space: 12 }) {
+          Button(this.sheet !== null && this.sheet.isSaved ? 'Remove' : 'Close')
+            .onClick(() => {
+              if (this.sheet !== null && this.sheet.isSaved) {
+                this.sheetStore()?.requestUnsave();
+              } else {
+                this.sheetStore()?.dismissSaveArticleSheet();
+              }
+            })
+        }
+        .width('100%')
+      }
+    }
+    .width('100%')
+  }
+
+  private confirmationSummary(): string {
+    if (this.sheet === null || this.sheet.confirmationCollections.length === 0) {
+      return '';
+    }
+    return this.sheet.confirmationCollections.join(', ');
+  }
+}
