@@ -0,0 +1,556 @@
+/**
+ * The Saved page.
+ *
+ * Two views share one surface: "All articles" shows every logical saved article
+ * once, "Collections" shows the reader's own collections. Switching between them
+ * only changes presentation - the underlying saved data is untouched.
+ */
+import { LegacySavedStore } from '../../model/LegacySavedStore';
+import { PageTitle } from '../model/PageTitle';
+import { SavedArticleRow, SavedCollectionRow, SavedUiState } from '../model/SavedUiState';
+import {
+  ARTICLE_FILTER_ALL_ARTICLES,
+  ARTICLE_FILTER_NOT_IN_COLLECTION,
+  COLLECTION_SORT_CHOICES,
+  EMPTY_STATE_NONE,
+  EMPTY_STATE_NOTHING_SELECTED,
+  EMPTY_STATE_NO_ARTICLES,
+  EMPTY_STATE_NO_COLLECTIONS,
+  EMPTY_STATE_SEARCH_NO_RESULTS,
+  FEEDBACK_ACTION_UNDO,
+  FEEDBACK_SEVERITY_ERROR,
+  FEEDBACK_SEVERITY_WARNING,
+  ONBOARDING_LOGIN_REMINDER,
+  ONBOARDING_NONE,
+  ONBOARDING_SHARED_COLLECTION,
+  ONBOARDING_SYNC_REMINDER,
+  TAB_ALL_ARTICLES,
+  TAB_COLLECTIONS,
+  sortModeLabel
+} from '../model/SavedConstants';
+import { SaveArticleSheetDialog, SaveArticleSheetDialogParams, openSaveArticleSheetDialog } from './SaveArticleSheetDialog';
+
+@Component
+export struct SavedPage {
+  store: LegacySavedStore | undefined = undefined;
+  @State selectedTab: string = TAB_ALL_ARTICLES;
+  @State articleRows: SavedArticleRow[] = [];
+  @State collectionRows: SavedCollectionRow[] = [];
+  @State selectedRowIds: number[] = [];
+  @State selectionEnabled: boolean = false;
+  @State searchQuery: string = '';
+  @State searchVisible: boolean = false;
+  @State isRefreshing: boolean = false;
+  @State emptyState: string = EMPTY_STATE_NONE;
+  @State onboarding: string = ONBOARDING_NONE;
+  @State badgeCount: number = 0;
+  @State feedbackMessage: string = '';
+  @State feedbackAction: string = '';
+  @State feedbackSeverity: string = FEEDBACK_SEVERITY_WARNING;
+  @State showSheet: boolean = false;
+  @State newCollectionTitle: string = '';
+  @State sheetParams: SaveArticleSheetDialogParams | undefined = undefined;
+
+  constructor(store: LegacySavedStore) {
+    super();
+    this.store = store;
+  }
+
+  aboutToAppear(): void {
+    if (this.store === undefined) {
+      return;
+    }
+    const owner: LegacySavedStore = this.store;
+    owner.features().observe((state: SavedUiState): void => {
+      this.project(state);
+    });
+    this.project(owner.state());
+  }
+
+  aboutToDisappear(): void {
+    this.store?.closeSavedSurface();
+  }
+
+  private project(state: SavedUiState): void {
+    this.selectedTab = state.selectedTab;
+    this.articleRows = state.articleRows;
+    this.collectionRows = state.collectionRows;
+    this.selectedRowIds = state.selectedRowIds;
+    this.selectionEnabled = state.selectionEnabled;
+    this.searchQuery = state.searchQuery;
+    this.isRefreshing = state.isRefreshing;
+    this.emptyState = state.emptyState;
+    this.onboarding = state.onboarding;
+    this.badgeCount = state.badgeCount;
+    this.feedbackMessage = state.feedback.visible ? state.feedback.message : '';
+    this.feedbackAction = state.feedback.actionLabel;
+    this.feedbackSeverity = state.feedback.severity;
+    this.showSheet = state.saveSheet !== null && state.saveSheet.visible;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Navigation                                                             */
+  /* -------------------------------------------------------------------- */
+
+  private selectTab(tab: string): void {
+    this.store?.selectSavedTab(tab);
+  }
+
+  private openSheetFor(row: SavedArticleRow): void {
+    const pageTitle = new PageTitle(row.language, row.apiTitle, row.displayTitle);
+    this.sheetParams = this.store !== undefined ? openSaveArticleSheetDialog(pageTitle, this.store) : undefined;
+    this.showSheet = true;
+    this.store?.openSaveArticleSheet();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Build                                                                  */
+  /* -------------------------------------------------------------------- */
+
+  build() {
+    Stack() {
+      Column() {
+        this.buildToolbar()
+        this.buildSearchField()
+        this.buildTabBar()
+        this.buildSelectionBar()
+        Refresh({ refreshing: $$this.isRefreshing }) {
+          List() {
+            if (this.selectedTab === TAB_ALL_ARTICLES) {
+              this.buildArticleRows()
+            } else {
+              this.buildCollectionRows()
+            }
+            this.buildEmptyState()
+            this.buildOnboarding()
+            this.buildFeedback()
+          }
+          .layoutWeight(1)
+          .width('100%')
+        }
+        .layoutWeight(1)
+        .width('100%')
+        .onRefreshing(() => {
+          this.store?.retryPullToRefreshAndCompleteSync();
+        })
+      }
+      .width('100%')
+      .height('100%')
+
+      if (this.showSheet && this.sheetParams !== undefined) {
+        Column() {
+          SaveArticleSheetDialog({ params: this.sheetParams })
+        }
+        .width('100%')
+        .padding(16)
+        .backgroundColor(Color.White)
+        .borderRadius(12)
+        .margin({ left: 12, right: 12, bottom: 12 })
+        .align(Alignment.Bottom)
+      }
+    }
+    .width('100%')
+    .height('100%')
+  }
+
+  @Builder
+  buildToolbar() {
+    Row({ space: 8 }) {
+      Text('Saved')
+        .fontSize(26)
+        .fontWeight(FontWeight.Bold)
+      if (this.badgeCount > 0) {
+        Text(String(this.badgeCount))
+          .fontSize(12)
+          .fontColor(Color.White)
+          .backgroundColor(Color.Red)
+          .borderRadius(10)
+          .padding({ left: 6, right: 6 })
+      }
+      Blank()
+      Button(this.selectionEnabled ? 'Done' : 'Select')
+        .onClick(() => {
+          if (this.selectionEnabled) {
+            this.store?.exitSelectionMode();
+          } else {
+            this.store?.enterSelectionMode();
+          }
+        })
+    }
+    .width('100%')
+    .padding(12)
+  }
+
+  @Builder
+  buildSearchField() {
+    Row({ space: 8 }) {
+      if (this.searchVisible) {
+        TextInput({ text: this.searchQuery, placeholder: 'Search saved' })
+          .layoutWeight(1)
+          .onChange((value: string) => {
+            // Production debounce: the query only applies after the delay.
+            this.store?.enterSavedSearchQuery(value, 0);
+          })
+        Button('Clear')
+          .onClick(() => {
+            this.store?.enterSavedSearchQuery('', 0);
+          })
+      } else {
+        Button('Search')
+          .onClick(() => {
+            this.searchVisible = true;
+          })
+      }
+    }
+    .width('100%')
+    .padding({ left: 12, right: 12, bottom: 8 })
+  }
+
+  /**
+   * Actions available while the active tab is in selection mode. The set of
+   * actions depends on the row type of the active tab.
+   */
+  @Builder
+  buildSelectionBar() {
+    if (this.selectionEnabled) {
+      Row({ space: 8 }) {
+        Text(String(this.selectedRowIds.length) + ' selected')
+          .fontSize(12)
+          .layoutWeight(1)
+        Button('Select all')
+          .onClick(() => {
+            this.store?.selectAllVisibleRows();
+          })
+        Button('Clear')
+          .onClick(() => {
+            this.store?.selectNone();
+          })
+        Button('Remove')
+          .enabled(this.selectedRowIds.length > 0)
+          .onClick(() => {
+            this.store?.deleteSelectedRows();
+          })
+      }
+      .width('100%')
+      .padding({ left: 12, right: 12, bottom: 8 })
+    }
+  }
+
+  @Builder
+  buildTabBar() {
+    Column() {
+      Row({ space: 8 }) {
+        Button('All articles')
+          .fontWeight(this.selectedTab === TAB_ALL_ARTICLES ? FontWeight.Bold : FontWeight.Normal)
+          .onClick(() => {
+            this.selectTab(TAB_ALL_ARTICLES);
+          })
+        Button('Collections')
+          .fontWeight(this.selectedTab === TAB_COLLECTIONS ? FontWeight.Bold : FontWeight.Normal)
+          .onClick(() => {
+            this.selectTab(TAB_COLLECTIONS);
+          })
+      }
+      .width('100%')
+
+      if (this.selectedTab === TAB_ALL_ARTICLES) {
+        Row({ space: 8 }) {
+          Button(this.selectedFilterLabel())
+            .onClick(() => {
+              this.store?.selectArticleFilter(this.nextFilter());
+            })
+        }
+        .width('100%')
+        .padding({ top: 4 })
+      } else {
+        this.buildNewCollectionRow()
+      }
+
+      this.buildSortRow()
+    }
+    .width('100%')
+    .padding({ left: 12, right: 12, bottom: 8 })
+  }
+
+  @Builder
+  buildNewCollectionRow() {
+    Row({ space: 8 }) {
+      TextInput({ text: this.newCollectionTitle, placeholder: 'New collection name' })
+        .layoutWeight(1)
+        .onChange((value: string) => {
+          this.newCollectionTitle = value;
+        })
+      Button('Create')
+        .enabled(this.newCollectionTitle.trim().length > 0)
+        .onClick(() => {
+          this.store?.createCollection(this.newCollectionTitle);
+          this.newCollectionTitle = '';
+        })
+    }
+    .width('100%')
+    .padding({ top: 4 })
+  }
+
+  @Builder
+  buildSortRow() {
+    Scroll() {
+      Row({ space: 8 }) {
+        ForEach(this.currentSortChoices(), (mode: number) => {
+          Button(sortModeLabel(mode))
+            .onClick(() => {
+              this.store?.selectSortMode(mode);
+            })
+        }, (mode: number) => mode.toString())
+      }
+    }
+    .scrollable(ScrollDirection.Horizontal)
+    .scrollBar(BarState.Off)
+    .width('100%')
+    .margin({ top: 4 })
+  }
+
+  @Builder
+  buildArticleRows() {
+    ForEach(this.articleRows, (row: SavedArticleRow) => {
+      Row({ space: 12 }) {
+        if (this.selectionEnabled) {
+          Checkbox({ name: row.id.toString(), group: 'saved-articles' })
+            .select(this.selectedRowIds.indexOf(row.id) >= 0)
+            .onChange(() => {
+              this.store?.toggleRowSelection(row.id);
+            })
+        }
+        Column({ space: 4 }) {
+          Text(row.displayTitle)
+            .fontSize(16)
+          Text(row.collections.join(' · '))
+            .fontSize(11)
+          if (row.isOffline) {
+            Text('Available offline')
+              .fontSize(11)
+          }
+          if (row.downloadProgress >= 0) {
+            Progress({ value: row.downloadProgress * 100, total: 100, type: ProgressType.Linear })
+              .width('100%')
+          }
+        }
+        .alignItems(HorizontalAlign.Start)
+        .layoutWeight(1)
+        Button('Save')
+          .onClick(() => {
+            this.openSheetFor(row);
+          })
+      }
+      .width('100%')
+      .padding(12)
+    }, (row: SavedArticleRow) => row.id.toString())
+  }
+
+  @Builder
+  buildCollectionRows() {
+    ForEach(this.collectionRows, (row: SavedCollectionRow) => {
+      Row({ space: 12 }) {
+        if (this.selectionEnabled) {
+          Checkbox({ name: row.id.toString(), group: 'saved-collections' })
+            .select(this.selectedRowIds.indexOf(row.id) >= 0)
+            .onChange(() => {
+              this.store?.toggleRowSelection(row.id);
+            })
+        }
+        Column({ space: 4 }) {
+          Text(row.title)
+            .fontSize(16)
+          Text(String(row.articleCount) + ' articles')
+            .fontSize(11)
+        }
+        .alignItems(HorizontalAlign.Start)
+        .layoutWeight(1)
+        Button('Delete')
+          .enabled(row.deletable)
+          .onClick(() => {
+            this.store?.deleteCollection(row.id);
+          })
+      }
+      .width('100%')
+      .padding(12)
+    }, (row: SavedCollectionRow) => row.id.toString())
+  }
+
+  @Builder
+  buildEmptyState() {
+    if (this.emptyState !== EMPTY_STATE_NONE) {
+      Column({ space: 8 }) {
+        Text(this.emptyTitle())
+          .fontSize(16)
+          .fontWeight(FontWeight.Bold)
+        Text(this.emptyMessage())
+          .fontSize(12)
+        Button(this.emptyRecoveryLabel())
+          .onClick(() => {
+            this.recoverFromEmptyState();
+          })
+      }
+      .width('100%')
+      .padding(24)
+      .alignItems(HorizontalAlign.Center)
+    }
+  }
+
+  @Builder
+  buildOnboarding() {
+    if (this.onboarding !== ONBOARDING_NONE) {
+      Row({ space: 8 }) {
+        Text(this.onboardingMessage())
+          .fontSize(12)
+          .layoutWeight(1)
+        Button(this.onboardingAction())
+          .onClick(() => {
+            this.runOnboardingAction();
+          })
+      }
+      .width('100%')
+      .padding(12)
+    }
+  }
+
+  @Builder
+  buildFeedback() {
+    if (this.feedbackMessage.length > 0) {
+      Row({ space: 8 }) {
+        Text(this.feedbackMessage)
+          .fontSize(12)
+          .layoutWeight(1)
+          .fontColor(this.feedbackSeverity === FEEDBACK_SEVERITY_ERROR ? Color.Red : Color.Gray)
+        if (this.feedbackAction === FEEDBACK_ACTION_UNDO) {
+          Button('Undo')
+            .onClick(() => {
+              this.store?.undoArticleDeletion();
+            })
+        }
+        Button('Dismiss')
+          .onClick(() => {
+            this.store?.dismissFeedback();
+          })
+      }
+      .width('100%')
+      .padding(12)
+    }
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Derived helpers                                                        */
+  /* -------------------------------------------------------------------- */
+
+  private currentFilter(): string {
+    const state: SavedUiState | undefined = this.store?.state();
+    return state !== undefined ? state.selectedArticleFilter : ARTICLE_FILTER_ALL_ARTICLES;
+  }
+
+  private selectedFilterLabel(): string {
+    return this.currentFilter() === ARTICLE_FILTER_NOT_IN_COLLECTION
+      ? 'Filter: only in Saved' : 'Filter: all saved';
+  }
+
+  private nextFilter(): string {
+    return this.currentFilter() === ARTICLE_FILTER_ALL_ARTICLES
+      ? ARTICLE_FILTER_NOT_IN_COLLECTION : ARTICLE_FILTER_ALL_ARTICLES;
+  }
+
+  private currentSortChoices(): number[] {
+    const state: SavedUiState | undefined = this.store?.state();
+    if (state === undefined) {
+      return COLLECTION_SORT_CHOICES;
+    }
+    return state.selectedTab === TAB_COLLECTIONS ? state.collectionSortChoices : state.articleSortChoices;
+  }
+
+  private emptyTitle(): string {
+    if (this.emptyState === EMPTY_STATE_SEARCH_NO_RESULTS) {
+      return 'No results';
+    }
+    if (this.emptyState === EMPTY_STATE_NOTHING_SELECTED) {
+      return 'Nothing selected';
+    }
+    if (this.emptyState === EMPTY_STATE_NO_COLLECTIONS) {
+      return 'No collections yet';
+    }
+    return 'Nothing saved yet';
+  }
+
+  private emptyMessage(): string {
+    if (this.emptyState === EMPTY_STATE_SEARCH_NO_RESULTS) {
+      return 'No saved item matches this search in this view.';
+    }
+    if (this.emptyState === EMPTY_STATE_NOTHING_SELECTED) {
+      return 'Select a row to run an action on it.';
+    }
+    if (this.emptyState === EMPTY_STATE_NO_COLLECTIONS) {
+      return 'Create a collection from the Collections tab or while saving an article.';
+    }
+    return 'Save an article to see it here.';
+  }
+
+  private emptyRecoveryLabel(): string {
+    if (this.emptyState === EMPTY_STATE_SEARCH_NO_RESULTS) {
+      return 'Clear search';
+    }
+    if (this.emptyState === EMPTY_STATE_NOTHING_SELECTED) {
+      return 'Select all';
+    }
+    if (this.emptyState === EMPTY_STATE_NO_COLLECTIONS) {
+      return 'Open All articles';
+    }
+    return 'Open Collections';
+  }
+
+  private recoverFromEmptyState(): void {
+    if (this.emptyState === EMPTY_STATE_SEARCH_NO_RESULTS) {
+      this.store?.enterSavedSearchQuery('', 0);
+      return;
+    }
+    if (this.emptyState === EMPTY_STATE_NOTHING_SELECTED) {
+      this.store?.selectAllVisibleRows();
+      return;
+    }
+    if (this.emptyState === EMPTY_STATE_NO_ARTICLES) {
+      this.selectTab(TAB_COLLECTIONS);
+      return;
+    }
+    this.selectTab(TAB_ALL_ARTICLES);
+  }
+
+  private onboardingMessage(): string {
+    if (this.onboarding === ONBOARDING_SYNC_REMINDER) {
+      return 'Sync your reading lists to keep them on all your devices.';
+    }
+    if (this.onboarding === ONBOARDING_LOGIN_REMINDER) {
+      return 'Log in to synchronise your reading lists.';
+    }
+    if (this.onboarding === ONBOARDING_SHARED_COLLECTION) {
+      return 'A collection was shared with you.';
+    }
+    return '';
+  }
+
+  private onboardingAction(): string {
+    if (this.onboarding === ONBOARDING_SYNC_REMINDER) {
+      return 'Sync now';
+    }
+    if (this.onboarding === ONBOARDING_LOGIN_REMINDER) {
+      return 'Log in';
+    }
+    return 'Open';
+  }
+
+  private runOnboardingAction(): void {
+    if (this.onboarding === ONBOARDING_SYNC_REMINDER) {
+      this.store?.retryPullToRefreshAndCompleteSync();
+      return;
+    }
+    if (this.onboarding === ONBOARDING_LOGIN_REMINDER) {
+      this.store?.onLoginEvent('', false);
+      return;
+    }
+    this.selectTab(TAB_COLLECTIONS);
+  }
+}
