+  }
+
+  databaseState(): ReadingListDatabase {
+    return this.database;
+  }
+}
+
+/** A membership that synchronisation delivers. */
+export class RemoteSyncAddition {
+  readonly article: string;
+  readonly collections: string[];
+
+  constructor(article: string, collections: string[]) {
+    this.article = article;
+    this.collections = collections;
+  }
+}
+
+function copyNumbers(values: number[]): number[] {
+  const copy: number[] = [];
+  for (let index = 0; index < values.length; index++) {
+    copy.push(values[index]);
+  }
+  return copy;
+}
+
+function copyStrings(values: string[]): string[] {
+  const copy: string[] = [];
+  for (let index = 0; index < values.length; index++) {
+    copy.push(values[index]);
+  }
+  return copy;
+}
