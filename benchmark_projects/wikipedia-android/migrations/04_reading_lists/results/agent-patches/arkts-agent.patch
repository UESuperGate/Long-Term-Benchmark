+/**
+ * Room style entities for the Saved feature.
+ *
+ * `RoomListEntity` is a collection. `ReadingListPageEntity` is a single
+ * membership row: it links one article (PageTitle) to one collection. An
+ * article that belongs to three collections therefore has three membership
+ * rows, but exactly one logical article.
+ */
+import { PageTitle } from './PageTitle';
+import { DEFAULT_COLLECTION_TITLE, STATUS_ACTIVE, STATUS_QUEUE_FOR_DELETE } from './SavedConstants';
+
+export class RoomListEntity {
+  readonly id: number;
+  title: string;
+  description: string;
+  readonly isDefault: boolean;
+  rank: number;
+  readonly createdAt: number;
+  updatedAt: number;
+
+  constructor(id: number, title: string, isDefault: boolean, description: string,
+    rank: number, createdAt: number, updatedAt: number) {
+    this.id = id;
+    this.title = title;
+    this.description = description;
+    this.isDefault = isDefault;
+    this.rank = rank;
+    this.createdAt = createdAt;
+    this.updatedAt = updatedAt;
+  }
+
+  /** The implicit collection is protected: it is never deletable. */
+  isDeletable(): boolean {
+    return !this.isDefault;
+  }
+}
+
+/** A collection together with the membership rows that are projected as active. */
+export class RoomListWithPages {
+  readonly list: RoomListEntity;
+  readonly pages: ReadingListPageEntity[];
+
+  constructor(list: RoomListEntity, pages: ReadingListPageEntity[]) {
+    this.list = list;
+    this.pages = pages;
+  }
+
+  get articleCount(): number {
+    return this.pages.length;
+  }
+}
+
+export class ReadingListPageEntity {
+  readonly id: number;
+  readonly listId: number;
+  readonly pageTitle: PageTitle;
+  status: string;
+  readonly addedAt: number;
+  updatedAt: number;
+
+  constructor(id: number, listId: number, pageTitle: PageTitle, status: string,
+    addedAt: number, updatedAt: number) {
+    this.id = id;
+    this.listId = listId;
+    this.pageTitle = pageTitle;
+    this.status = status && status.length > 0 ? status : STATUS_ACTIVE;
+    this.addedAt = addedAt;
+    this.updatedAt = updatedAt;
+  }
+
+  get isActive(): boolean {
+    return this.status === STATUS_ACTIVE;
+  }
+
+  get isQueuedForDeletion(): boolean {
+    return this.status === STATUS_QUEUE_FOR_DELETE;
+  }
+
+  get identity(): string {
+    return this.pageTitle.identity;
+  }
+}
+
+export function isDefaultCollectionTitle(title: string): boolean {
+  return title === DEFAULT_COLLECTION_TITLE;
+}
+
+export { STATUS_ACTIVE, STATUS_QUEUE_FOR_DELETE };
