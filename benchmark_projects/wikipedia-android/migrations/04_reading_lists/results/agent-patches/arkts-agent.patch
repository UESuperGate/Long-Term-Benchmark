@@ -0,0 +1,79 @@
+/**
+ * Session state owned by the Saved feature.
+ *
+ * Login, logout, receipt of a shared collection and the reading list
+ * synchronisation preference all feed this object, which in turn drives the
+ * onboarding content and the eligibility of the pull-to-refresh action.
+ */
+import { SavedAccountState } from '../model/SavedUiState';
+
+export class SavedSession {
+  private readonly account: SavedAccountState;
+  private syncEnabled: boolean;
+  private sharedCollectionsReceived: number;
+  private pendingSharedCollectionTitle: string;
+
+  constructor() {
+    this.account = new SavedAccountState();
+    this.syncEnabled = true;
+    this.sharedCollectionsReceived = 0;
+    this.pendingSharedCollectionTitle = '';
+  }
+
+  snapshot(): SavedAccountState {
+    return this.account;
+  }
+
+  isLoggedIn(): boolean {
+    return this.account.isLoggedIn;
+  }
+
+  userName(): string {
+    return this.account.userName;
+  }
+
+  /**
+   * Synchronisation is only offered to a permanent, signed in account. A
+   * signed out or temporary account has to be offered a login instead.
+   */
+  isSyncEligible(): boolean {
+    return this.account.isSyncEligible();
+  }
+
+  isSyncEnabled(): boolean {
+    return this.syncEnabled;
+  }
+
+  applySyncEnabled(enabled: boolean): void {
+    this.syncEnabled = enabled;
+  }
+
+  /** Production login event; account eligibility is refreshed here. */
+  applyLogin(userName: string, temporary: boolean): void {
+    this.account.isLoggedIn = true;
+    this.account.isTemporary = temporary;
+    this.account.userName = userName;
+  }
+
+  applyLogout(): void {
+    this.account.isLoggedIn = false;
+    this.account.isTemporary = false;
+    this.account.userName = '';
+  }
+
+  /** A collection shared by somebody else arrived from a deep link. */
+  applySharedCollection(title: string): void {
+    this.sharedCollectionsReceived = this.sharedCollectionsReceived + 1;
+    this.pendingSharedCollectionTitle = title;
+  }
+
+  takeSharedCollection(): string {
+    const title = this.pendingSharedCollectionTitle;
+    this.pendingSharedCollectionTitle = '';
+    return title;
+  }
+
+  sharedCollectionCount(): number {
+    return this.sharedCollectionsReceived;
+  }
+}
