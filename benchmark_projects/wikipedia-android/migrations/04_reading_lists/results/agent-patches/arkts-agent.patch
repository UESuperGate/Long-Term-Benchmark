@@ -0,0 +1,196 @@
+/**
+ * Constants shared by the Saved (collections based) experience.
+ *
+ * The values below are the production identifiers used by the Saved surface:
+ * they are referenced from persistence keys, database rows and the observable
+ * UI state, therefore they must stay stable across releases.
+ */
+
+/** Language used when an article is presented without an explicit wiki language. */
+export const DEFAULT_LANGUAGE_CODE: string = 'en';
+
+/**
+ * Title of the implicit collection that holds every saved article that has not
+ * been moved into a user created collection. It is never listed on the
+ * Collections tab and it can never be deleted.
+ */
+export const DEFAULT_COLLECTION_TITLE: string = 'Saved';
+
+/* -------------------------------------------------------------------------- */
+/* Tabs                                                                       */
+/* -------------------------------------------------------------------------- */
+
+export const TAB_ALL_ARTICLES: string = 'ALL_ARTICLES';
+export const TAB_COLLECTIONS: string = 'COLLECTIONS';
+export type SavedTab = 'ALL_ARTICLES' | 'COLLECTIONS';
+
+export function isSavedTab(value: string): boolean {
+  return value === TAB_ALL_ARTICLES || value === TAB_COLLECTIONS;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Article filter (All articles tab only)                                     */
+/* -------------------------------------------------------------------------- */
+
+export const ARTICLE_FILTER_ALL_ARTICLES: string = 'ALL_ARTICLES';
+/** Shows only articles that are held exclusively by the default collection. */
+export const ARTICLE_FILTER_NOT_IN_COLLECTION: string = 'NOT_IN_COLLECTION';
+export type SavedArticleFilter = 'ALL_ARTICLES' | 'NOT_IN_COLLECTION';
+
+export function isArticleFilter(value: string): boolean {
+  return value === ARTICLE_FILTER_ALL_ARTICLES || value === ARTICLE_FILTER_NOT_IN_COLLECTION;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Sort modes                                                                 */
+/* -------------------------------------------------------------------------- */
+
+/** Sorting is persisted independently for the article and the collection view. */
+export const SORT_BY_NAME_ASC: number = 0;
+export const SORT_BY_NAME_DESC: number = 1;
+export const SORT_BY_DATE_ADDED: number = 2;
+export const SORT_BY_DATE_LAST_UPDATED: number = 3;
+export type SavedSortMode = number;
+
+export const ARTICLE_SORT_CHOICES: number[] =
+  [SORT_BY_NAME_ASC, SORT_BY_NAME_DESC, SORT_BY_DATE_ADDED, SORT_BY_DATE_LAST_UPDATED];
+export const COLLECTION_SORT_CHOICES: number[] = [SORT_BY_NAME_ASC, SORT_BY_NAME_DESC];
+
+export function isSortMode(mode: number, choices: number[]): boolean {
+  return choices.indexOf(mode) >= 0;
+}
+
+export function sortModeLabel(mode: number): string {
+  if (mode === SORT_BY_NAME_DESC) {
+    return 'Sort by name descending';
+  }
+  if (mode === SORT_BY_DATE_ADDED) {
+    return 'Sort by date added';
+  }
+  if (mode === SORT_BY_DATE_LAST_UPDATED) {
+    return 'Sort by date last updated';
+  }
+  return 'Sort by name ascending';
+}
+
+/* -------------------------------------------------------------------------- */
+/* Reading list page (membership) statuses                                     */
+/* -------------------------------------------------------------------------- */
+
