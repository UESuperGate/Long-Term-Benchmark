diff --git a/entry/src/main/ets/saved/data/ReadingListPagesDao.ets b/entry/src/main/ets/saved/data/ReadingListPagesDao.ets
new file mode 100644
index 0000000000000000000000000000000000000000..3b06388b30d5d1544132d39feb8b769decfe946d
--- /dev/null
+++ b/entry/src/main/ets/saved/data/ReadingListPagesDao.ets
@@ -0,0 +1,315 @@
+/**
+ * Membership (article) DAO.
+ *
+ * A membership row links one article to one collection. The DAO is also where
+ * the logical-article aggregation lives: the All articles tab must show every
+ * logical article once while keeping the complete set of containing
+ * collections, so aggregation happens on read and never changes membership.
+ */
+import { Flow } from './Flow';
+import { ReadingListDatabase } from './ReadingListDatabase';
+import { ReadingListsDao } from './ReadingListsDao';
+import { PageTitle } from '../model/PageTitle';
+import { ReadingListPageEntity } from '../model/Entities';
+import { SavedLimitPolicy } from '../model/SavedLimits';
+import { RoomListEntity, STATUS_ACTIVE } from '../model/Entities';
+
+/** Deduplicated view of one saved article plus all of its memberships. */
+export class SavedArticleRecord {
+  /** Identity of the membership row that represents this logical article. */
+  readonly rowId: number;
+  readonly pageTitle: PageTitle;
+  collections: string[];
+  readonly addedAt: number;
+  updatedAt: number;
+
+  constructor(rowId: number, pageTitle: PageTitle, collections: string[], addedAt: number, updatedAt: number) {
+    this.rowId = rowId;
+    this.pageTitle = pageTitle;
+    this.collections = collections;
+    this.addedAt = addedAt;
+    this.updatedAt = updatedAt;
+  }
+
+  get identity(): string {
+    return this.pageTitle.identity;
+  }
+
+  /** True when the default collection is the only container of the article. */
+  onlyInDefaultCollection(defaultTitle: string): boolean {
+    if (this.collections.length !== 1) {
+      return false;
+    }
+    return this.collections[0] === defaultTitle;
+  }
+
+  isInNamedCollection(defaultTitle: string): boolean {
+    for (let index = 0; index < this.collections.length; index++) {
+      if (this.collections[index] !== defaultTitle) {
+        return true;
+      }
+    }
+    return false;
+  }
+}
+
+export class MembershipChange {
+  readonly applied: boolean;
+  readonly reason: string;
+  readonly message: string;
+  readonly page: ReadingListPageEntity | undefined;
+
+  constructor(applied: boolean, reason: string, message: string, page: ReadingListPageEntity | undefined) {
+    this.applied = applied;
+    this.reason = reason;
+    this.message = message;
+    this.page = page;
+  }
+}
+
+export class ReadingListPagesDao {
+  private readonly database: ReadingListDatabase;
+  private readonly listsDao: ReadingListsDao;
+  private readonly activePages: Flow<ReadingListPageEntity[]>;
+
+  constructor(database: ReadingListDatabase, listsDao: ReadingListsDao) {
+    this.database = database;
+    this.listsDao = listsDao;
+    this.activePages = new Flow<ReadingListPageEntity[]>(this.projectActive());
+    this.database.changeFlow().collect((): void => {
+      this.activePages.emit(this.projectActive());
+    });
+  }
+
+  /** Reactive stream of the membership rows that are projected as active. */
+  observeActivePages(): Flow<ReadingListPageEntity[]> {
+    return this.activePages;
+  }
+
+  private projectActive(): ReadingListPageEntity[] {
+    const all = this.database.allPages();
+    const active: ReadingListPageEntity[] = [];
+    for (let index = 0; index < all.length; index++) {
+      if (all[index].isActive) {
+        active.push(all[index]);
+      }
+    }
+    return active;
+  }
+
+  /** The protected default collection. */
+  defaultList(): RoomListEntity {
+    return this.listsDao.defaultList();
+  }
+
+  defaultTitle(): string {
+    return this.defaultList().title;
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* Aggregation                                                             */
+  /* ---------------------------------------------------------------------- */
+
+  /**
+   * Deduplicates membership rows into logical articles keyed by wiki language
+   * plus API title. The representative row is the membership inside the default
+   * collection when present, which keeps the row id stable while the reader
+   * adds the article to further collections.
+   */
+  logicalArticles(): SavedArticleRecord[] {
+    const pages = this.projectActive();
+    const identities: string[] = [];
+    const members: SavedArticleRecord[] = [];
+    const indexes = new Map<string, number>();
+
+    for (let index = 0; index < pages.length; index++) {
+      const page = pages[index];
+      const identity = page.identity;
+      const list = this.database.listById(page.listId);
+      const title = list !== undefined ? list.title : '';
+      const existing: number = indexes.has(identity) && indexes.get(identity) !== undefined
+        ? indexes.get(identity) as number : -1;
+      if (existing < 0) {
+        indexes.set(identity, members.length);
+        members.push(new SavedArticleRecord(page.id, page.pageTitle, [title], page.addedAt, page.updatedAt));
+      } else {
+        const record: SavedArticleRecord = members[existing];
+        if (record.collections.indexOf(title) < 0) {
+          record.collections.push(title);
+        }
+        if (page.updatedAt > record.updatedAt) {
+          record.updatedAt = page.updatedAt;
+        }
+      }
+    }
+
+    const defaultList = this.database.defaultList();
+    const defaultId = defaultList !== undefined ? defaultList.id : -1;
+    for (let index = 0; index < members.length; index++) {
+      const identity = members[index].identity;
+      const defaultRow = this.database.membership(defaultId, identity);
+      if (defaultRow !== undefined && defaultRow.isActive) {
+        members[index] = new SavedArticleRecord(
+          defaultRow.id, members[index].pageTitle, members[index].collections,
+          members[index].addedAt, members[index].updatedAt);
+      }
+    }
+
+    for (let index = 0; index < members.length; index++) {
+      members[index].collections = this.database.sortedCollectionTitlesOf(members[index].identity);
+    }
+    return members;
+  }
+
+  membershipsOf(identity: string): string[] {
+    return this.database.sortedCollectionTitlesOf(identity);
+  }
+
+  nonDefaultMembershipsOf(identity: string): string[] {
+    const defaultTitle = this.defaultTitle();
+    const all = this.membershipsOf(identity);
+    const result: string[] = [];
+    for (let index = 0; index < all.length; index++) {
+      if (all[index] !== defaultTitle) {
+        result.push(all[index]);
+      }
+    }
+    return result;
+  }
+
+  isSaved(identity: string): boolean {
+    return this.membershipsOf(identity).length > 0;
+  }
+
+  queuedPageIdsFor(identities: string[]): number[] {
+    const queued: number[] = [];
+    const pages = this.database.queuedPages();
+    for (let index = 0; index < pages.length; index++) {
+      if (identities.indexOf(pages[index].identity) >= 0) {
+        queued.push(pages[index].id);
+      }
+    }
+    return queued;
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* Writes                                                                  */
+  /* ---------------------------------------------------------------------- */
+
+  /**
+   * Guarantees the article sits in the default collection, which is what makes
+   * "Save" idempotent. Returns the membership row.
+   */
+  saveToDefaultCollection(pageTitle: PageTitle): MembershipChange {
+    const defaultList = this.defaultList();
+    const existing = this.database.membership(defaultList.id, pageTitle.identity);
+    if (existing !== undefined && existing.isActive) {
+      return new MembershipChange(true, '', '', existing);
+    }
+    if (existing !== undefined) {
+      const revived = this.database.setPageStatus(existing.id, STATUS_ACTIVE);
+      return new MembershipChange(revived !== undefined, '', '', revived);
+    }
+    const decision = SavedLimitPolicy.canAddArticle(this.database.activePagesForList(defaultList.id).length);
+    if (!decision.allowed) {
+      return new MembershipChange(false, decision.reason, decision.message, undefined);
+    }
+    const now = this.database.nextTimestamp();
+    const page = this.database.insertPage(new ReadingListPageEntity(
+      this.database.reservePageId(), defaultList.id, pageTitle, STATUS_ACTIVE, now, now));
+    return new MembershipChange(true, '', '', page);
+  }
+
+  /** Adds an article to a specific collection, honouring collection limits. */
+  addToCollection(listId: number, pageTitle: PageTitle): MembershipChange {
+    const list = this.database.listById(listId);
+    if (list === undefined) {
+      return new MembershipChange(false, 'MISSING_COLLECTION', '', undefined);
+    }
+    const existing = this.database.membership(listId, pageTitle.identity);
+    if (existing !== undefined && existing.isActive) {
+      return new MembershipChange(true, '', '', existing);
+    }
+    const decision = SavedLimitPolicy.canAddArticle(this.database.activePagesForList(listId).length);
+    if (!decision.allowed) {
+      return new MembershipChange(false, decision.reason, decision.message, undefined);
+    }
+    if (existing !== undefined) {
+      const revived = this.database.setPageStatus(existing.id, STATUS_ACTIVE);
+      return new MembershipChange(revived !== undefined, '', '', revived);
+    }
+    const now = this.database.nextTimestamp();
+    const page = this.database.insertPage(new ReadingListPageEntity(
+      this.database.reservePageId(), listId, pageTitle, STATUS_ACTIVE, now, now));
+    return new MembershipChange(true, '', '', page);
+  }
+
+  /**
+   * Adds or removes the article from a collection depending on its current
+   * state. A collection that no longer exists is a no-op: the operation must
+   * never fall back to another collection.
+   */
+  toggleCollection(listId: number, pageTitle: PageTitle): MembershipChange {
+    const list = this.database.listById(listId);
+    if (list === undefined) {
+      return new MembershipChange(false, 'MISSING_COLLECTION', '', undefined);
+    }
+    const existing = this.database.membership(listId, pageTitle.identity);
+    if (existing !== undefined && existing.isActive) {
+      const removed = this.database.hardDeletePages([existing.id]);
+      return new MembershipChange(removed > 0, 'REMOVED', '', existing);
+    }
+    if (existing !== undefined) {
+      const revived = this.database.setPageStatus(existing.id, STATUS_ACTIVE);
+      return new MembershipChange(revived !== undefined, '', '', revived);
+    }
+    return this.addToCollection(listId, pageTitle);
+  }
+
+  /** Removes a single membership row. */
+  removeFromCollection(listId: number, identity: string): boolean {
+    const existing = this.database.membership(listId, identity);
+    if (existing === undefined) {
+      return false;
+    }
+    return this.database.hardDeletePages([existing.id]) > 0;
+  }
+
+  /** Unsave: drops every membership of the article in one write. */
+  removeEveryMembership(identity: string): number {
+    let removed = 0;
+    const rows = this.database.allPages();
+    const ids: number[] = [];
+    for (let index = 0; index < rows.length; index++) {
+      if (rows[index].identity === identity && rows[index].status !== 'STATUS_DELETED') {
+        ids.push(rows[index].id);
+      }
+    }
+    removed = this.database.hardDeletePages(ids);
+    return removed;
+  }
+
+  /** Queues every membership of the given articles for deletion. */
+  queueForDeletion(identities: string[]): number[] {
+    const queued: number[] = [];
+    for (let index = 0; index < identities.length; index++) {
+      this.database.queuePagesForIdentity(identities[index]);
+      const ids = this.database.queuedPages();
+      for (let inner = 0; inner < ids.length; inner++) {
+        if (ids[inner].identity === identities[index] && queued.indexOf(ids[inner].id) < 0) {
+          queued.push(ids[inner].id);
+        }
+      }
+    }
+    return queued;
+  }
+
+  /** Undo for a queued deletion. */
+  restoreQueued(pageIds: number[]): number {
+    return this.database.restoreQueuedPages(pageIds);
+  }
+
+  activeArticleCountFor(listId: number): number {
+    return this.database.activePagesForList(listId).length;
+  }
+}
