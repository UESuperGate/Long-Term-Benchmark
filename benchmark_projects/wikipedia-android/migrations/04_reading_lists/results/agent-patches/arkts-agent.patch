@@ -0,0 +1,84 @@
+/**
+ * Offline availability and download progress of saved articles.
+ *
+ * The Saved surface reflects media state for the articles that are visible, so
+ * this store keeps only the identities it was told about and lets the view model
+ * project them onto rows.
+ */
+export const DOWNLOAD_IDLE: number = -1;
+
+export class ArticleMediaStatus {
+  private readonly offline: Map<string, boolean> = new Map<string, boolean>();
+  private readonly progress: Map<string, number> = new Map<string, number>();
+  private readonly offlineIdentities: string[] = [];
+  private readonly progressIdentities: string[] = [];
+
+  setOffline(identity: string, available: boolean): void {
+    if (!this.offline.has(identity)) {
+      this.offlineIdentities.push(identity);
+    }
+    this.offline.set(identity, available);
+  }
+
+  setDownloadProgress(identity: string, fraction: number): void {
+    if (fraction < 0 || fraction >= 1) {
+      const index = this.progressIdentities.indexOf(identity);
+      if (index >= 0) {
+        this.progressIdentities.splice(index, 1);
+      }
+      this.progress.delete(identity);
+      return;
+    }
+    if (!this.progress.has(identity)) {
+      this.progressIdentities.push(identity);
+    }
+    this.progress.set(identity, fraction);
+  }
+
+  isOffline(identity: string): boolean {
+    return this.offline.get(identity) === true;
+  }
+
+  downloadProgress(identity: string): number {
+    const value: number | undefined = this.progress.get(identity);
+    return value !== undefined ? value : DOWNLOAD_IDLE;
+  }
+
+  /** Identities that currently have offline media available. */
+  offlineArticleIdentities(): string[] {
+    return this.offlineIdentities.slice();
+  }
+
+  /** Identities that currently report an active download. */
+  downloadingIdentities(): string[] {
+    return this.progressIdentities.slice();
+  }
+
+  /** Drops entries for articles that are no longer visible anywhere. */
+  retainOnly(identities: string[]): void {
+    this.prune(this.offlineIdentities, identities);
+    this.prune(this.progressIdentities, identities);
+  }
+
+  private prune(keys: string[], visibleIdentities: string[]): void {
+    for (let index = keys.length - 1; index >= 0; index--) {
+      const key = keys[index];
+      if (visibleIdentities.indexOf(key) < 0) {
+        keys.splice(index, 1);
+        if (this.offline.has(key)) {
+          this.offline.delete(key);
+        }
+        if (this.progress.has(key)) {
+          this.progress.delete(key);
+        }
+      }
+    }
+  }
+
+  clear(): void {
+    this.offline.clear();
+    this.progress.clear();
+    this.offlineIdentities.length = 0;
+    this.progressIdentities.length = 0;
+  }
+}
