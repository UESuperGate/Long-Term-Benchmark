+/**
+ * Serialisation of the Saved surface snapshot.
+ *
+ * The snapshot is what the feature writes into preferences and what it reads
+ * back through `SavedStateRestorer`. It carries the reading list tables, the
+ * presentation state of the active view, the pending destructive action and the
+ * state of the save-article sheet, so a restart restores exactly what the
+ * reader was looking at.
+ */
+import { ReadingListDatabase } from './ReadingListDatabase';
+import { SavedUiState } from '../model/SavedUiState';
+import { ReadingListPageEntity, RoomListEntity } from '../model/Entities';
+
+interface SnapshotRoomList {
+  id: number;
+  title: string;
+  isDefault: boolean;
+  description: string;
+  articles: string[];
+}
+
+interface SnapshotPageTitle {
+  language: string;
+  apiTitle: string;
+  displayTitle: string;
+}
+
+interface SnapshotSaveSheet {
+  article: string;
+  isSaved: boolean;
+  pendingConfirmation: boolean;
+}
+
+interface SnapshotSelection {
+  enabled: boolean;
+  selectedPageIds: number[];
+}
+
+interface SnapshotAccount {
+  isLoggedIn: boolean;
+  isTemporary: boolean;
+  userName: string;
+}
+
+interface SavedSnapshot {
+  roomLists: SnapshotRoomList[];
+  selectedTab: string;
+  selectedArticleFilter: string;
+  searchQuery: string;
+  readingListSyncEnabled: boolean;
+  undoAvailable: boolean;
+  selection: SnapshotSelection;
+  account: SnapshotAccount;
+  article: SnapshotPageTitle | null;
+  saveSheet: SnapshotSaveSheet | null;
+  offlineArticles: string[];
+  downloadProgress: Record<string, number>;
+}
+
+export class SavedSnapshotCodec {
+  static encode(database: ReadingListDatabase, state: SavedUiState, offlineIdentities: string[],
+    downloadProgress: Record<string, number>): string {
+    const snapshot: SavedSnapshot = {
+      roomLists: SavedSnapshotCodec.encodeLists(database),
+      selectedTab: state.selectedTab,
+      selectedArticleFilter: state.selectedArticleFilter,
+      searchQuery: state.searchQuery,
+      readingListSyncEnabled: state.readingListSyncEnabled,
+      undoAvailable: state.undoAvailable,
+      selection: {
+        enabled: state.selectionEnabled,
+        selectedPageIds: SavedSnapshotCodec.copyNumbers(state.selectedRowIds)
+      },
+      account: {
+        isLoggedIn: state.account.isLoggedIn,
+        isTemporary: state.account.isTemporary,
+        userName: state.account.userName
+      },
+      article: SavedSnapshotCodec.encodePageTitle(state),
+      saveSheet: SavedSnapshotCodec.encodeSaveSheet(state),
+      offlineArticles: SavedSnapshotCodec.copyStrings(offlineIdentities),
+      downloadProgress: downloadProgress
+    };
+    return JSON.stringify(snapshot);
+  }
+
+  private static encodeLists(database: ReadingListDatabase): SnapshotRoomList[] {
+    const lists: RoomListEntity[] = database.allLists();
+    const encoded: SnapshotRoomList[] = [];
+    for (let index = 0; index < lists.length; index++) {
+      const list = lists[index];
+      const articles: string[] = [];
+      const pages: ReadingListPageEntity[] = database.activePagesForList(list.id);
+      for (let inner = 0; inner < pages.length; inner++) {
+        articles.push(pages[inner].identity);
+      }
+      encoded.push({
+        id: list.id,
+        title: list.title,
+        isDefault: list.isDefault,
+        description: list.description,
+        articles: articles
+      });
+    }
+    return encoded;
+  }
+
+  private static encodePageTitle(state: SavedUiState): SnapshotPageTitle | null {
+    const sheet = state.saveSheet;
+    if (sheet === null || !sheet.visible) {
+      return null;
+    }
+    return { language: sheet.language, apiTitle: sheet.apiTitle, displayTitle: sheet.displayTitle };
+  }
+
+  private static encodeSaveSheet(state: SavedUiState): SnapshotSaveSheet | null {
+    const sheet = state.saveSheet;
+    if (sheet === null || !sheet.visible) {
+      return null;
+    }
+    return {
+      article: sheet.article,
+      isSaved: sheet.isSaved,
+      pendingConfirmation: sheet.pendingConfirmation
+    };
+  }
+
+  private static copyNumbers(values: number[]): number[] {
+    const copy: number[] = [];
+    for (let index = 0; index < values.length; index++) {
+      copy.push(values[index]);
+    }
+    return copy;
+  }
+
+  private static copyStrings(values: string[]): string[] {
+    const copy: string[] = [];
+    for (let index = 0; index < values.length; index++) {
+      copy.push(values[index]);
+    }
+    return copy;
+  }
