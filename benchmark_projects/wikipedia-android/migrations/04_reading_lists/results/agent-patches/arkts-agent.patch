@@ -0,0 +1,79 @@
+/**
+ * Production wiring of the Saved feature.
+ *
+ * The application injects the restored session snapshot and the services the
+ * feature is allowed to talk to; everything else - the reading list tables, the
+ * projections, the persistence and the recovery behaviour - is owned by the
+ * feature.
+ */
+import { common } from '@kit.AbilityKit';
+import { SavedEffect, SavedInput, SavedLeaf } from '../integration/SavedPageIntegration';
+import { LegacySavedStore } from '../model/LegacySavedStore';
+
+/**
+ * Leaf sink of the surrounding application. The feature publishes every
+ * external call here; the sink only records or forwards it.
+ */
+export class ApplicationLeafSink implements SavedLeaf {
+  private readonly published: SavedEffect[] = [];
+
+  emit(effect: SavedEffect): Promise<void> {
+    this.published.push(effect);
+    return Promise.resolve();
+  }
+
+  publishedEffects(): SavedEffect[] {
+    return this.published.slice();
+  }
+
+  clear(): void {
+    this.published.length = 0;
+  }
+}
+
+/** Session snapshot handed to the feature when the app starts. */
+export class ProductionSavedInput implements SavedInput {
+  state: Record<string, Object>;
+  persistence: Record<string, Object>;
+  leaf: SavedLeaf;
+
+  constructor(leaf: SavedLeaf, state: Record<string, Object>, persistence: Record<string, Object>) {
+    this.state = state;
+    this.persistence = persistence;
+    this.leaf = leaf;
+  }
+}
+
+export class SavedFeature {
+  /**
+   * Creates the feature from an already restored session. An empty snapshot is
+   * a valid input: the persisted reading lists are then restored from
+   * preferences, which is what happens on a first run and after a restart.
+   */
+  static async create(context: common.UIAbilityContext, leaf: SavedLeaf,
+    state: Record<string, Object>, persistence: Record<string, Object>): Promise<LegacySavedStore> {
+    return LegacySavedStore.create(context, new ProductionSavedInput(leaf, state, persistence));
+  }
+
+  /** Creates the feature with the default application services. */
+  static async createWithDefaults(context: common.UIAbilityContext): Promise<LegacySavedStore> {
+    const sink = new ApplicationLeafSink();
+    const store = await LegacySavedStore.create(context, new ProductionSavedInput(sink, emptyRecord(),
+      emptyRecord()));
+    await store.openSavedSurface();
+    return store;
+  }
+
+  /** Session snapshot used when the application has nothing to restore. */
+  static defaultInput(): SavedInput {
+    return new ProductionSavedInput(new ApplicationLeafSink(), emptyRecord(), emptyRecord());
+  }
+
+  static emptyStateRecord(): Record<string, Object> {
+    return emptyRecord();
+  }
+}
+
+function emptyRecord(): Record<string, Object> {
+  return JSON.parse('{}') as Record<string, Object>;
+}
