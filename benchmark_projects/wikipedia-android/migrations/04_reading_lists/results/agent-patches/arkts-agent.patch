--- /dev/null
+++ b/entry/src/main/ets/saved/data/Flow.ets
@@ -0,0 +1,43 @@
+/**
+ * Minimal reactive stream used by the reading list data layer.
+ *
+ * The database exposes a change flow; derived queries subscribe to it and push
+ * freshly projected values to their own collectors. This is what lets the Saved
+ * page update when the underlying membership tables change without anybody
+ * rebuilding the page by hand.
+ */
+export type FlowCallback<T> = (value: T) => void;
+
+export class Flow<T> {
+  private current: T;
+  private readonly callbacks: FlowCallback<T>[] = [];
+
+  constructor(initial: T) {
+    this.current = initial;
+  }
+
+  getValue(): T {
+    return this.current;
+  }
+
+  /**
+   * Registers a collector and immediately replays the latest value so that a
+   * late subscriber never misses the current snapshot.
+   */
+  collect(callback: FlowCallback<T>): void {
+    this.callbacks.push(callback);
+    callback(this.current);
+  }
+
+  /** Number of live collectors. */
+  collectorCount(): number {
+    return this.callbacks.length;
+  }
+
+  emit(value: T): void {
+    this.current = value;
+    for (let index = 0; index < this.callbacks.length; index++) {
+      this.callbacks[index](value);
+    }
+  }
+}
