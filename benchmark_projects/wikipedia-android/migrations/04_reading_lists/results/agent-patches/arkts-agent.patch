@@ -0,0 +1,74 @@
+/**
+ * Search matching used by both Saved tabs.
+ *
+ * Matching is accent insensitive and case insensitive and always runs against a
+ * single, currently visible value: an article row is matched on its title and
+ * on the titles of the collections that hold it, a collection row on its title
+ * and description. Search never mutates membership.
+ */
+export class SavedTextSearch {
+  private static readonly FOLDING: string =
+    'àáâãäåāăą=>aaaaaa' +
+    'çćĉċč=>c' +
+    'ďđ=>d' +
+    'èéêëēĕėęě=>eeeee' +
+    'ĝğġģ=>g' +
+    'ĥħ=>h' +
+    'ìíîïĩīĭįı=>iiiii' +
+    'ĵ=>j' +
+    'ķ=>k' +
+    'ĺļľŀł=>l' +
+    'ñńņňŉ=>n' +
+    'òóôõöøōŏő=>ooooo' +
+    'ŕŗř=>r' +
+    'śŝşš=>s' +
+    'ţťŧ=>t' +
+    'ùúûüũūŭůűų=>uuuuu' +
+    'ŵ=>w' +
+    'ýÿŷ=>yy' +
+    'źżž=>z';
+
+  private static readonly ACCENTS: Map<string, string> = SavedTextSearch.buildFoldingTable();
+
+  private static buildFoldingTable(): Map<string, string> {
+    const table: Map<string, string> = new Map<string, string>();
+    const groups: string[] = SavedTextSearch.FOLDING.split(' ');
+    for (let index = 0; index < groups.length; index++) {
+      const group = groups[index];
+      const separator = group.indexOf('=>');
+      if (separator <= 0) {
+        continue;
+      }
+      const sources = group.substring(0, separator);
+      const target = group.substring(separator + 2);
+      for (let source = 0; source < sources.length; source++) {
+        table.set(sources.charAt(source), target);
+      }
+    }
+    return table;
+  }
+
+  /** Lower cases and removes diacritics so that "cafe" matches "Café". */
+  static normalise(value: string): string {
+    const lowered = value.toLowerCase();
+    let folded = '';
+    for (let index = 0; index < lowered.length; index++) {
+      const character = lowered.charAt(index);
+      const replacement = SavedTextSearch.ACCENTS.get(character);
+      folded = folded + (replacement !== undefined ? replacement : character);
+    }
+    return folded;
+  }
+
+  static matches(candidate: string, normalisedQuery: string): boolean {
+    if (normalisedQuery.length === 0) {
+      return true;
+    }
+    return SavedTextSearch.normalise(candidate).indexOf(normalisedQuery) >= 0;
+  }
+
+  /** Normalises the raw query once so that matching stays cheap. */
+  static prepareQuery(query: string): string {
+    return SavedTextSearch.normalise(query.trim());
+  }
+}
