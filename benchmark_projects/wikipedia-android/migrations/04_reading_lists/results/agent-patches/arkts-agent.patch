new file mode 100644
index 0000000000000000000000000000000000000000..bf3e99d591dc7bf8cf8cb1416f1f270f34312290
--- /dev/null
+++ b/entry/src/main/ets/saved/data/ReadingListsDao.ets
@@ -0,0 +1,150 @@
+/**
+ * Collection (Room list) DAO.
+ *
+ * Exposes the reactive projection used by the page plus the semantic writes of
+ * the Collections tab. Every write re-notifies the change flow, which is what
+ * makes both visible surfaces update from a single database change.
+ */
+import { Flow } from './Flow';
+import { ReadingListDatabase } from './ReadingListDatabase';
+import { RoomListEntity, RoomListWithPages } from '../model/Entities';
+import { SavedLimitPolicy } from '../model/SavedLimits';
+import { DEFAULT_COLLECTION_TITLE } from '../model/SavedConstants';
+
+export class CollectionCreation {
+  readonly created: RoomListEntity | undefined;
+  readonly reason: string;
+  readonly message: string;
+
+  constructor(created: RoomListEntity | undefined, reason: string, message: string) {
+    this.created = created;
+    this.reason = reason;
+    this.message = message;
+  }
+}
+
+export class ReadingListsDao {
+  private readonly database: ReadingListDatabase;
+  private readonly listsWithPages: Flow<RoomListWithPages[]>;
+
+  constructor(database: ReadingListDatabase) {
+    this.database = database;
+    this.listsWithPages = new Flow<RoomListWithPages[]>(this.project());
+    this.database.changeFlow().collect((): void => {
+      this.listsWithPages.emit(this.project());
+    });
+  }
+
+  /**
+   * Reactive stream of every collection together with the membership rows that
+   * are projected as active.
+   */
+  observeListsWithPages(): Flow<RoomListWithPages[]> {
+    return this.listsWithPages;
+  }
+
+  private project(): RoomListWithPages[] {
+    return this.database.listsWithPages();
+  }
+
+  listById(listId: number): RoomListEntity | undefined {
+    return this.database.listById(listId);
+  }
+
+  listByTitle(title: string): RoomListEntity | undefined {
+    return this.database.listByTitle(title);
+  }
+
+  /** The protected default collection; created on demand. */
+  defaultList(): RoomListEntity {
+    const existing = this.database.defaultList();
+    if (existing !== undefined) {
+      return existing;
+    }
+    const now = this.database.nextTimestamp();
+    return this.database.insertList(
+      new RoomListEntity(this.database.reserveListId(), DEFAULT_COLLECTION_TITLE, true, '', 0, now, now));
+  }
+
+  countUserCollections(): number {
+    return this.database.countUserLists();
+  }
+
+  /** User created collections only: the default collection is never listed. */
+  userCollections(): RoomListEntity[] {
+    const result: RoomListEntity[] = [];
+    const projected = this.listsWithPages.getValue();
+    for (let index = 0; index < projected.length; index++) {
+      if (!projected[index].list.isDefault) {
+        result.push(projected[index].list);
+      }
+    }
+    return result;
+  }
+
+  /** Creates a user collection, honouring the per-account collection limit. */
+  createCollection(title: string, description: string): CollectionCreation {
+    const trimmed = title.trim();
+    if (trimmed.length === 0) {
+      return new CollectionCreation(undefined, 'EMPTY_TITLE', '');
+    }
+    if (this.listByTitle(trimmed) !== undefined) {
+      return new CollectionCreation(undefined, 'DUPLICATE_TITLE', '');
+    }
+    const decision = SavedLimitPolicy.canCreateCollection(this.countUserCollections());
+    if (!decision.allowed) {
+      return new CollectionCreation(undefined, decision.reason, decision.message);
+    }
+    const now = this.database.nextTimestamp();
+    const rank = this.countUserCollections() + 1;
+    const created = this.database.insertList(
+      new RoomListEntity(this.database.reserveListId(), trimmed, false, description, rank, now, now));
+    return new CollectionCreation(created, '', '');
+  }
+
+  renameCollection(listId: number, title: string): boolean {
+    const list = this.listById(listId);
+    if (list === undefined || list.isDefault) {
+      return false;
+    }
+    const trimmed = title.trim();
+    if (trimmed.length === 0) {
+      return false;
+    }
+    list.title = trimmed;
+    list.updatedAt = this.database.nextTimestamp();
+    this.notifyRename();
+    return true;
+  }
+
+  private notifyRename(): void {
+    this.listsWithPages.emit(this.project());
+  }
+
+  /** Queues a collection for deletion; the default collection is protected. */
+  queueCollectionForDeletion(listId: number): RoomListEntity | undefined {
+    const list = this.listById(listId);
+    if (list === undefined || !list.isDeletable()) {
+      return undefined;
+    }
+    return this.database.queueListForDeletion(listId);
+  }
+
+  /** Hard removal; used once the undo window elapsed. */
+  deleteCollection(listId: number): RoomListEntity | undefined {
+    const list = this.listById(listId);
+    if (list === undefined || !list.isDeletable()) {
+      return undefined;
+    }
+    return this.database.deleteListCascade(listId);
+  }
+
+  /** Undo path for a queued collection deletion. */
+  restoreCollection(listId: number): RoomListEntity | undefined {
+    const list = this.listById(listId);
+    if (list === undefined || !list.isDeletable()) {
+      return undefined;
+    }
+    return this.database.restoreList(listId);
+  }
+}
