+/**
+ * Restoration of a persisted Saved-surface snapshot.
+ *
+ * The Saved page keeps its whole presentation state in one serialisable
+ * snapshot: the reading list tables, the active tab, the search and filter
+ * selection, the account, the pending destructive action and the state of the
+ * save-article sheet. This class turns such a snapshot back into live
+ * application objects, which is what happens on process restart and whenever
+ * the surrounding app hands a restored session to the feature.
+ */
+import { ReadingListDatabase } from './ReadingListDatabase';
+import { ReadingListsDao } from './ReadingListsDao';
+import { ReadingListPagesDao } from './ReadingListPagesDao';
+import { SavedSession } from './SavedSession';
+import { ArticleMediaStatus } from './ArticleMediaStatus';
+import { SavedEnvironment, ROUTE_REDIRECT_METADATA, OUTCOME_OK } from '../leaf/ExternalGateway';
+import { PageTitle } from '../model/PageTitle';
+import {
+  ReadingListPageEntity,
+  RoomListEntity,
+  STATUS_QUEUE_FOR_DELETE
+} from '../model/Entities';
+import { SaveArticleSheetState } from '../model/SavedUiState';
+import { QueuedCollectionToggle, SavedViewModel } from '../viewmodel/SavedViewModel';
+import {
+  DEFAULT_COLLECTION_TITLE,
+  ONBOARDING_SYNC_REMINDER,
+  TAB_ALL_ARTICLES
+} from '../model/SavedConstants';
+
+/* -------------------------------------------------------------------------- */
+/* Snapshot shapes                                                             */
+/* -------------------------------------------------------------------------- */
+
+export interface RestoredRoomList {
+  id?: number;
+  title?: string;
+  isDefault?: boolean;
+  description?: string;
+  articles?: string[];
+}
+
+/** A row captured either as a bare `lang:Title` identity or as a descriptor. */
+export interface RestoredArticleRow {
+  id?: number;
+  article?: string;
+  collections?: string[];
+}
+
+/** Concrete row descriptor used when a snapshot only carries an identity. */
+export class RestoredRowDescriptor implements RestoredArticleRow {
+  id?: number;
+  article?: string;
+  collections?: string[];
+
+  constructor(article: string, id: number | undefined, collections: string[] | undefined) {
+    this.article = article;
+    this.id = id;
+    this.collections = collections;
+  }
+}
+
+export interface RestoredPageTitle {
+  language?: string;
+  apiTitle?: string;
+  displayTitle?: string;
+}
+
+export interface RestoredSaveSheet {
+  article?: string;
+  isSaved?: boolean;
+  pendingConfirmation?: boolean;
+}
+
+export interface RestoredAccount {
+  isLoggedIn?: boolean;
+  isTemporary?: boolean;
+  userName?: string;
+}
+
+export interface RestoredSelection {
+  enabled?: boolean;
+  selectedPageIds?: number[];
+}
+
+export interface RestoredSortModes {
+  ALL_ARTICLES?: number;
+  COLLECTIONS?: number;
+}
+
+export interface RestoredQueuedToggle {
+  collectionId?: number;
+  title?: string;
+  article?: string;
+}
+
+export interface RestoredSyncAdd {
+  article?: string;
+  lists?: string[];
+}
+
+export interface RestoredRefreshAttempt {
+  outcome?: string;
+  syncStarted?: boolean;
+  attempt?: number;
+}
+
+export class RestoredSavedState {
+  selectedTab?: string;
+  selectedArticleFilter?: string;
+  searchQuery?: string;
+  searchDebounceMillis?: number;
+  persistedSortModes?: RestoredSortModes;
+  roomLists?: RestoredRoomList[];
+  roomCollections?: RestoredRoomList[];
+  collectionTitles?: string[];
+  articleRows?: string[];
+  articleMemberships?: Record<string, string[]>;
+  memberships?: string[];
+  visibleArticleRows?: RestoredArticleRow[];
+  hiddenByFilter?: RestoredArticleRow[];
+  selection?: RestoredSelection;
+  article?: RestoredPageTitle;
+  saveSheet?: RestoredSaveSheet;
+  queuedForDeletion?: Record<string, string[]>;
+  queuedCollectionToggle?: RestoredQueuedToggle;
+  account?: RestoredAccount;
+  previousRefreshAttempt?: RestoredRefreshAttempt;
+  isRefreshing?: boolean;
+  readingListSyncEnabled?: boolean;
+  onboarding?: string;
+  nextSyncCompletion?: string;
+  redirectMetadataHttp?: string;
+  redirectMetadataBody?: string;
+  undoAvailable?: boolean;
+  offlineArticles?: string[];
+  downloadProgress?: Record<string, number>;
+  syncAdds?: RestoredSyncAdd[];
+
+  constructor() {
+  }
+}
+
+/** Everything the restorer needs, and what it produced. */
+export class RestoredContext {
+  database: ReadingListDatabase;
+  listsDao: ReadingListsDao;
+  pagesDao: ReadingListPagesDao;
+  session: SavedSession;
+  mediaStatus: ArticleMediaStatus;
+  environment: SavedEnvironment;
+  viewModel: SavedViewModel;
+
+  constructor(database: ReadingListDatabase, listsDao: ReadingListsDao, pagesDao: ReadingListPagesDao,
+    session: SavedSession, mediaStatus: ArticleMediaStatus, environment: SavedEnvironment,
+    viewModel: SavedViewModel) {
+    this.database = database;
+    this.listsDao = listsDao;
+    this.pagesDao = pagesDao;
+    this.session = session;
+    this.mediaStatus = mediaStatus;
+    this.environment = environment;
+    this.viewModel = viewModel;
+  }
+}
+
+export class RestoredSummary {
+  defaultCollectionTitle: string;
+  previousRefreshOutcome: string;
+  previousSyncStarted: boolean;
+  sheetArticle: string;
+  sortModesRestored: boolean;
+
+  constructor() {
+    this.defaultCollectionTitle = DEFAULT_COLLECTION_TITLE;
+    this.previousRefreshOutcome = '';
+    this.previousSyncStarted = false;
+    this.sheetArticle = '';
+    this.sortModesRestored = false;
+  }
+}
+
+/* -------------------------------------------------------------------------- */
+/* Helpers                                                                     */
+/* -------------------------------------------------------------------------- */
+
+/**
+ * Rows survive in two shapes across snapshot versions: a bare identity string
+ * and a full descriptor. Both are accepted.
+ */
+export function toRestoredRow(value: Object): RestoredArticleRow {
+  const serialised: string = JSON.stringify(value);
+  if (serialised.length > 1 && serialised.charAt(0) === '"') {
+    const identity: string = JSON.parse(serialised) as string;
+    return new RestoredRowDescriptor(identity, undefined, undefined);
+  }
+  return JSON.parse(serialised) as RestoredArticleRow;
+}
+
+export function toRestoredPageTitle(value: Object): PageTitle {
+  const serialised: string = JSON.stringify(value);
+  const isBareIdentity: boolean = serialised.length > 1 && serialised.charAt(0) === '"';
+  if (isBareIdentity) {
+    return PageTitle.fromIdentity(JSON.parse(serialised) as string);
+  }
+  const parsed = JSON.parse(serialised) as RestoredPageTitle;
+  const language: string = parsed.language !== undefined && parsed.language !== null ? parsed.language : '';
+  const apiTitle: string = parsed.apiTitle !== undefined && parsed.apiTitle !== null ? parsed.apiTitle : '';
+  const display: string = parsed.displayTitle !== undefined && parsed.displayTitle !== null ? parsed.displayTitle : '';
+  return new PageTitle(language, apiTitle, display);
+}
+
+export function toTitleList(value: Object): string[] {
+  const serialised: string = JSON.stringify(value);
+  const isBareIdentity: boolean = serialised.length > 1 && serialised.charAt(0) === '"';
+  if (isBareIdentity) {
+    return [JSON.parse(serialised) as string];
+  }
+  const parsed = JSON.parse(serialised) as string[];
+  const titles: string[] = [];
+  if (parsed !== undefined && parsed !== null) {
+    for (let index = 0; index < parsed.length; index++) {
+      titles.push(parsed[index]);
+    }
+  }
+  return titles;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Restorer                                                                    */
+/* -------------------------------------------------------------------------- */
+
+export class SavedStateRestorer {
+  static parse(raw: Record<string, Object>): RestoredSavedState {
+    const serialised: string = JSON.stringify(raw);
+    if (serialised.length === 0 || serialised === '{}') {
+      return new RestoredSavedState();
+    }
+    return JSON.parse(serialised) as RestoredSavedState;
+  }
+
+  static restore(raw: Record<string, Object>, context: RestoredContext): RestoredSummary {
+    const snapshot = SavedStateRestorer.parse(raw);
+    const summary = new RestoredSummary();
+
+    SavedStateRestorer.restoreCollections(snapshot, context, summary);
+    SavedStateRestorer.restoreMemberships(snapshot, context, summary);
+    SavedStateRestorer.restoreSession(snapshot, context, summary);
+    SavedStateRestorer.restorePresentation(snapshot, context, summary);
+    SavedStateRestorer.restoreSheet(snapshot, context, summary);
+    SavedStateRestorer.restoreEnvironment(snapshot, context);
+    return summary;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Collections                                                           */
+  /* -------------------------------------------------------------------- */
+
+  private static restoreCollections(snapshot: RestoredSavedState, context: RestoredContext,
+    summary: RestoredSummary): void {
+    let highestListId = 0;
+    const specs: RestoredRoomList[] = [];
+
+    const collect = (lists: RestoredRoomList[] | undefined): void => {
+      if (lists === undefined || lists === null) {
+        return;
+      }
+      for (let index = 0; index < lists.length; index++) {
+        const spec = lists[index];
+        specs.push(spec);
+        const explicitId: number | undefined = spec.id !== undefined && spec.id !== null ? spec.id : undefined;
+        if (explicitId !== undefined && explicitId > highestListId) {
+          highestListId = explicitId;
+        }
+      }
+    };
+    collect(snapshot.roomLists);
+    collect(snapshot.roomCollections);
+
+    // The default collection always exists, even when the snapshot has none.
+    let defaultTitle = DEFAULT_COLLECTION_TITLE;
+    for (let index = 0; index < specs.length; index++) {
+      const spec = specs[index];
+      const title: string = spec.title !== undefined && spec.title !== null ? spec.title : '';
+      if (spec.isDefault === true && title.length > 0) {
+        defaultTitle = title;
+        break;
+      }
+    }
+    context.database.reserveListIdAtLeast(highestListId + 1);
+
+    for (let index = 0; index < specs.length; index++) {
+      const spec = specs[index];
+      const title: string = spec.title !== undefined && spec.title !== null ? spec.title : '';
+      if (title.length === 0 || context.listsDao.listByTitle(title) !== undefined) {
+        continue;
+      }
+      const isDefault: boolean = spec.isDefault === true || title === defaultTitle;
+      const description: string = spec.description !== undefined && spec.description !== null ? spec.description : '';
+      const now: number = context.database.nextTimestamp();
+      const explicitId: number | undefined = spec.id !== undefined && spec.id !== null ? spec.id : undefined;
+      const listId: number = explicitId !== undefined
+        ? context.database.reserveSpecificListId(explicitId)
+        : context.database.reserveListId();
+      context.database.insertList(new RoomListEntity(listId, title, isDefault, description, index, now, now));
+    }
+
+    const collectionTitles: string[] | undefined = snapshot.collectionTitles;
+    if (collectionTitles !== undefined && collectionTitles !== null) {
+      for (let index = 0; index < collectionTitles.length; index++) {
+        SavedStateRestorer.ensureCollection(collectionTitles[index], false, context);
+      }
+    }
+
+    summary.defaultCollectionTitle = context.pagesDao.defaultTitle();
+  }
+
+  private static ensureCollection(title: string, isDefault: boolean, context: RestoredContext): void {
+    if (title.length === 0 || title === context.pagesDao.defaultTitle()) {
+      return;
+    }
+    if (context.listsDao.listByTitle(title) !== undefined) {
+      return;
+    }
+    const now = context.database.nextTimestamp();
+    const rank = context.listsDao.countUserCollections() + 1;
+    context.database.insertList(
+      new RoomListEntity(context.database.reserveListId(), title, isDefault, '', rank, now, now));
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Memberships                                                           */
+  /* -------------------------------------------------------------------- */
+
+  private static restoreMemberships(snapshot: RestoredSavedState, context: RestoredContext,
+    summary: RestoredSummary): void {
+    // Reserve every explicit identifier before any automatic one is handed out.
+    let highestPageId = 0;
+    const rows: RestoredArticleRow[] = [];
+    const collectRows = (source: RestoredArticleRow[] | undefined): void => {
+      if (source === undefined || source === null) {
+        return;
+      }
+      for (let index = 0; index < source.length; index++) {
+        const row: RestoredArticleRow = toRestoredRow(source[index]);
+        rows.push(row);
+        const explicitId: number | undefined = row.id !== undefined && row.id !== null ? row.id : undefined;
+        if (explicitId !== undefined && explicitId > highestPageId) {
+          highestPageId = explicitId;
+        }
+      }
+    };
+    collectRows(snapshot.visibleArticleRows);
+    collectRows(snapshot.hiddenByFilter);
+
+    // Plain identities listed for the surface are saved articles themselves.
+    const plainRows: string[] | undefined = snapshot.articleRows;
+    if (plainRows !== undefined && plainRows !== null) {
+      for (let index = 0; index < plainRows.length; index++) {
+        rows.push(new RestoredRowDescriptor(plainRows[index], undefined, undefined));
+      }
+    }
+    context.database.reservePageIdAtLeast(highestPageId + 1);
+
+    // 1. Collections that list their articles.
+    const specs: RestoredRoomList[] = [];
+    const roomLists: RestoredRoomList[] | undefined = snapshot.roomLists;
+    if (roomLists !== undefined && roomLists !== null) {
+      for (let index = 0; index < roomLists.length; index++) {
+        specs.push(roomLists[index]);
+      }
+    }
+    for (let index = 0; index < specs.length; index++) {
+      const spec = specs[index];
+      const articles: string[] | undefined = spec.articles;
+      const title: string = spec.title !== undefined && spec.title !== null ? spec.title : '';
+      if (articles === undefined || articles === null || title.length === 0) {
+        continue;
+      }
+      const list = context.listsDao.listByTitle(title);
+      if (list === undefined) {
+        continue;
+      }
+      for (let inner = 0; inner < articles.length; inner++) {
+        SavedStateRestorer.insertMembership(context, list.id, PageTitle.fromIdentity(articles[inner]),
+          undefined, '');
+      }
+    }
+
+    // 2. Explicit identity -> collections map.
+    SavedStateRestorer.restoreMembershipMap(context, snapshot.articleMemberships, undefined, '', undefined);
+
+    // 3. The article the save sheet is about.
+    const sheetArticle: string = SavedStateRestorer.resolveSheetArticle(snapshot);
+    const memberships: string[] | undefined = snapshot.memberships;
+    if (memberships !== undefined && memberships !== null) {
+      for (let index = 0; index < memberships.length; index++) {
+        SavedStateRestorer.ensureCollection(memberships[index], false, context);
+      }
+      const list = context.pagesDao.defaultList();
+      if (sheetArticle.length > 0) {
+        SavedStateRestorer.insertMembership(context, list.id, PageTitle.fromIdentity(sheetArticle), undefined, '');
+      }
+      for (let index = 0; index < memberships.length; index++) {
+        const title = memberships[index];
+        if (title === context.pagesDao.defaultTitle()) {
+          continue;
+        }
+        const named = context.listsDao.listByTitle(title);
+        if (named !== undefined && sheetArticle.length > 0) {
+          SavedStateRestorer.insertMembership(context, named.id, PageTitle.fromIdentity(sheetArticle), undefined, '');
+        }
+      }
+    }
+
+    // 4. Rows the surface was rendering.
+    for (let index = 0; index < rows.length; index++) {
+      SavedStateRestorer.restoreRow(context, rows[index]);
+    }
+
+    // 5. Rows queued for deletion: they stay persisted but are not projected.
+    if (snapshot.queuedForDeletion !== undefined && snapshot.queuedForDeletion !== null) {
+      const queuedIds: number[] = [];
+      const queuedIdentities: string[] = [];
+      SavedStateRestorer.restoreMembershipMap(context, snapshot.queuedForDeletion, queuedIds, STATUS_QUEUE_FOR_DELETE,
+        queuedIdentities);
+      context.viewModel.seedQueuedDeletion(queuedIdentities, queuedIds);
+      context.viewModel.seedUndoAvailable(snapshot.undoAvailable !== false);
+    }
+
+    if (snapshot.undoAvailable === false) {
+      context.viewModel.seedUndoAvailable(false);
+    }
+  }
+
+  private static restoreRow(context: RestoredContext, row: RestoredArticleRow): void {
+    const identity: string = row.article !== undefined && row.article !== null ? row.article : '';
+    if (identity.length === 0) {
+      return;
+    }
+    const collections: string[] = row.collections !== undefined && row.collections !== null ? row.collections : [];
+    for (let index = 0; index < collections.length; index++) {
+      SavedStateRestorer.ensureCollection(collections[index], false, context);
+    }
+    const defaultList = context.pagesDao.defaultList();
+    const explicitId: number | undefined = row.id !== undefined && row.id !== null ? row.id : undefined;
+    SavedStateRestorer.insertMembership(context, defaultList.id, PageTitle.fromIdentity(identity), explicitId, '');
+    for (let index = 0; index < collections.length; index++) {
+      if (collections[index] === defaultList.title) {
+        continue;
+      }
+      const list = context.listsDao.listByTitle(collections[index]);
+      if (list !== undefined) {
+        SavedStateRestorer.insertMembership(context, list.id, PageTitle.fromIdentity(identity), undefined, '');
+      }
+    }
+  }
+
+  private static restoreMembershipMap(context: RestoredContext, map: Record<string, string[]> | undefined,
+    collectedIds: number[] | undefined, status: string, collectedIdentities: string[] | undefined): void {
+    if (map === undefined || map === null) {
+      return;
+    }
+    const identities: string[] = Object.keys(map);
+    for (let index = 0; index < identities.length; index++) {
+      const identity = identities[index];
+      const titles: string[] = map[identity];
+      for (let inner = 0; inner < titles.length; inner++) {
+        SavedStateRestorer.ensureCollection(titles[inner], false, context);
+      }
+      for (let inner = 0; inner < titles.length; inner++) {
+        const title = titles[inner];
+        const isDefault = title === context.pagesDao.defaultTitle();
+        const list = isDefault ? context.pagesDao.defaultList() : context.listsDao.listByTitle(title);
+        if (list === undefined) {
+          continue;
+        }
+        const inserted = SavedStateRestorer.insertMembership(context, list.id, PageTitle.fromIdentity(identity),
+          undefined, status);
+        if (inserted !== undefined && status === STATUS_QUEUE_FOR_DELETE && collectedIds !== undefined) {
+          collectedIds.push(inserted.id);
+          if (collectedIdentities !== undefined && collectedIdentities.indexOf(identity) < 0) {
+            collectedIdentities.push(identity);
+          }
+        }
+      }
+    }
+  }
+
+  /** Idempotent membership insert: an existing row is reused, never duplicated. */
+  private static insertMembership(context: RestoredContext, listId: number, pageTitle: PageTitle,
+    explicitId: number | undefined, status: string): ReadingListPageEntity | undefined {
+    const existing = context.database.membership(listId, pageTitle.identity);
+    if (existing !== undefined) {
+      return existing;
+    }
+    const now = context.database.nextTimestamp();
+    const pageId: number = explicitId !== undefined
+      ? context.database.reserveSpecificPageId(explicitId)
+      : context.database.reservePageId();
+    return context.database.insertPage(
+      new ReadingListPageEntity(pageId, listId, pageTitle, status, now, now));
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Session                                                               */
+  /* -------------------------------------------------------------------- */
+
+  private static restoreSession(snapshot: RestoredSavedState, context: RestoredContext,
+    summary: RestoredSummary): void {
+    if (snapshot.account !== undefined && snapshot.account !== null) {
+      const account = snapshot.account;
+      if (account.isLoggedIn === true) {
+        context.session.applyLogin(
+          account.userName !== undefined && account.userName !== null ? account.userName : '',
+          account.isTemporary === true);
+      }
+    }
+    if (snapshot.readingListSyncEnabled !== undefined && snapshot.readingListSyncEnabled !== null) {
+      context.session.applySyncEnabled(snapshot.readingListSyncEnabled);
+    }
+    if (snapshot.previousRefreshAttempt !== undefined && snapshot.previousRefreshAttempt !== null) {
+      const attempt = snapshot.previousRefreshAttempt;
+      summary.previousRefreshOutcome = attempt.outcome !== undefined && attempt.outcome !== null ? attempt.outcome : '';
+      summary.previousSyncStarted = attempt.syncStarted === true;
+    }
+    if (snapshot.nextSyncCompletion !== undefined && snapshot.nextSyncCompletion !== null) {
+      context.viewModel.applySyncCompletionPolicy(snapshot.nextSyncCompletion);
+    }
+    if (snapshot.isRefreshing !== undefined && snapshot.isRefreshing !== null) {
+      context.viewModel.seedRefreshing(snapshot.isRefreshing);
+    }
+    if (snapshot.onboarding !== undefined && snapshot.onboarding !== null && snapshot.onboarding.length > 0) {
+      context.viewModel.applyForcedOnboarding(normaliseOnboarding(snapshot.onboarding));
+    }
+    if (snapshot.syncAdds !== undefined && snapshot.syncAdds !== null) {
+      for (let index = 0; index < snapshot.syncAdds.length; index++) {
+        const addition = snapshot.syncAdds[index];
+        if (addition.article === undefined || addition.article === null || addition.article.length === 0) {
+          continue;
+        }
+        const lists: string[] = addition.lists !== undefined && addition.lists !== null ? addition.lists : [];
+        context.viewModel.queueRemoteSyncAddition(addition.article, lists);
+      }
+    }
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Presentation                                                          */
+  /* -------------------------------------------------------------------- */
+
+  private static restorePresentation(snapshot: RestoredSavedState, context: RestoredContext,
+    summary: RestoredSummary): void {
+    if (snapshot.persistedSortModes !== undefined && snapshot.persistedSortModes !== null) {
+      const modes = snapshot.persistedSortModes;
+      summary.sortModesRestored = true;
+      if (modes.ALL_ARTICLES !== undefined && modes.ALL_ARTICLES !== null) {
+        context.viewModel.applyPersistedSortModes(modes.ALL_ARTICLES, modes.COLLECTIONS !== undefined
+          && modes.COLLECTIONS !== null ? modes.COLLECTIONS : 0);
+      } else if (modes.COLLECTIONS !== undefined && modes.COLLECTIONS !== null) {
+        context.viewModel.applyPersistedSortModes(0, modes.COLLECTIONS);
+      } else {
+        summary.sortModesRestored = false;
+      }
+    }
+    if (snapshot.searchDebounceMillis !== undefined && snapshot.searchDebounceMillis !== null) {
+      context.viewModel.applySearchDebounce(snapshot.searchDebounceMillis);
+    }
+    if (snapshot.selectedArticleFilter !== undefined && snapshot.selectedArticleFilter !== null) {
+      context.viewModel.seedArticleFilter(snapshot.selectedArticleFilter);
+    }
+    if (snapshot.selectedTab !== undefined && snapshot.selectedTab !== null) {
+      context.viewModel.seedTab(snapshot.selectedTab);
+    } else {
+      context.viewModel.seedTab(TAB_ALL_ARTICLES);
+    }
+    if (snapshot.searchQuery !== undefined && snapshot.searchQuery !== null) {
+      context.viewModel.seedSearchQuery(snapshot.searchQuery);
+    }
+    if (snapshot.selection !== undefined && snapshot.selection !== null) {
+      const ids: number[] = snapshot.selection.selectedPageIds !== undefined
+        && snapshot.selection.selectedPageIds !== null ? snapshot.selection.selectedPageIds : [];
+      context.viewModel.seedSelection(snapshot.selection.enabled === true, ids);
+    }
+    if (snapshot.offlineArticles !== undefined && snapshot.offlineArticles !== null) {
+      for (let index = 0; index < snapshot.offlineArticles.length; index++) {
+        context.mediaStatus.setOffline(snapshot.offlineArticles[index], true);
+      }
+    }
+    if (snapshot.downloadProgress !== undefined && snapshot.downloadProgress !== null) {
+      const keys: string[] = Object.keys(snapshot.downloadProgress);
+      for (let index = 0; index < keys.length; index++) {
+        context.mediaStatus.setDownloadProgress(keys[index], snapshot.downloadProgress[keys[index]]);
+      }
+    }
+    context.viewModel.applySyncPreference(context.session.isSyncEnabled());
+    context.viewModel.applyFilterDefault();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Save article sheet                                                    */
+  /* -------------------------------------------------------------------- */
+
+  private static restoreSheet(snapshot: RestoredSavedState, context: RestoredContext,
+    summary: RestoredSummary): void {
+    const identity: string = SavedStateRestorer.resolveSheetArticle(snapshot);
+    summary.sheetArticle = identity;
+    if (identity.length === 0) {
+      return;
+    }
+    const explicitTitle: RestoredPageTitle | undefined = snapshot.article;
+    const pageTitle: PageTitle = explicitTitle !== undefined && explicitTitle !== null
+      ? toRestoredPageTitle(explicitTitle) : PageTitle.fromIdentity(identity);
+    context.viewModel.setPendingPageTitle(pageTitle);
+
+    const descriptor: RestoredSaveSheet | undefined = snapshot.saveSheet;
+    if (descriptor !== undefined && descriptor !== null) {
+      const sheet = new SaveArticleSheetState(pageTitle);
+      sheet.isSaved = descriptor.isSaved !== undefined && descriptor.isSaved !== null
+        ? descriptor.isSaved : context.pagesDao.isSaved(pageTitle.identity);
+      sheet.pendingConfirmation = descriptor.pendingConfirmation === true;
+      sheet.confirmationCollections = context.pagesDao.nonDefaultMembershipsOf(pageTitle.identity);
+      context.viewModel.restoreSaveSheet(sheet);
+    }
+    SavedStateRestorer.restoreQueuedToggle(snapshot, context, pageTitle.identity);
+  }
+
+  private static restoreQueuedToggle(snapshot: RestoredSavedState, context: RestoredContext,
+    article: string): void {
+    if (snapshot.queuedCollectionToggle === undefined || snapshot.queuedCollectionToggle === null) {
+      return;
+    }
+    const queued = snapshot.queuedCollectionToggle;
+    if (queued.collectionId === undefined || queued.collectionId === null) {
+      return;
+    }
+    const title: string = queued.title !== undefined && queued.title !== null ? queued.title : '';
+    const target: string = queued.article !== undefined && queued.article !== null ? queued.article : article;
+    context.viewModel.setQueuedCollectionToggle(new QueuedCollectionToggle(queued.collectionId, title, target));
+  }
+
+  private static resolveSheetArticle(snapshot: RestoredSavedState): string {
+    if (snapshot.saveSheet !== undefined && snapshot.saveSheet !== null
+      && snapshot.saveSheet.article !== undefined && snapshot.saveSheet.article !== null) {
+      return snapshot.saveSheet.article;
+    }
+    if (snapshot.queuedCollectionToggle !== undefined && snapshot.queuedCollectionToggle !== null
+      && snapshot.queuedCollectionToggle.article !== undefined
+      && snapshot.queuedCollectionToggle.article !== null) {
+      return snapshot.queuedCollectionToggle.article;
+    }
+    if (snapshot.article !== undefined && snapshot.article !== null) {
+      return toRestoredPageTitle(snapshot.article).identity;
+    }
+    return '';
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* External environment                                                  */
+  /* -------------------------------------------------------------------- */
+
+  private static restoreEnvironment(snapshot: RestoredSavedState, context: RestoredContext): void {
+    if (snapshot.redirectMetadataHttp !== undefined && snapshot.redirectMetadataHttp !== null
+      && snapshot.redirectMetadataHttp.length > 0) {
+      const body: string = snapshot.redirectMetadataBody !== undefined && snapshot.redirectMetadataBody !== null
+        ? snapshot.redirectMetadataBody : '';
+      context.environment.configureRoute(ROUTE_REDIRECT_METADATA, snapshot.redirectMetadataHttp, body);
+      return;
+    }
+    if (snapshot.redirectMetadataBody !== undefined && snapshot.redirectMetadataBody !== null
+      && snapshot.redirectMetadataBody.length > 0) {
+      context.environment.configureRoute(ROUTE_REDIRECT_METADATA, OUTCOME_OK, snapshot.redirectMetadataBody);
+    }
+  }
+}
+
+function normaliseOnboarding(value: string): string {
+  const lowered = value.toLowerCase().replace(/_/g, '');
+  if (lowered === 'syncreminder') {
+    return ONBOARDING_SYNC_REMINDER;
+  }
+  if (lowered === 'loginreminder' || lowered === 'loginprompt') {
+    return 'LOGIN_REMINDER';
+  }
+  if (lowered === 'sharedcollection' || lowered === 'sharedcollectionreminder') {
+    return 'SHARED_COLLECTION';
+  }
+  return value;
+}
