diff --git a/entry/src/main/ets/saved/leaf/ExternalGateway.ets b/entry/src/main/ets/saved/leaf/ExternalGateway.ets
new file mode 100644
index 0000000000000000000000000000000000000000..5672391ab5e6c4f61bbc72d5870c5b21990e1800
--- /dev/null
+++ b/entry/src/main/ets/saved/leaf/ExternalGateway.ets
@@ -0,0 +1,223 @@
+/**
+ * External boundaries of the Saved feature.
+ *
+ * HTTP, reading list synchronisation, analytics and file services live here and
+ * nowhere else. The rest of the feature only ever sees the typed results below,
+ * which is what makes it possible to reason about offline devices, failing
+ * requests and interrupted synchronisations without leaking transport concerns
+ * into the state reduction.
+ *
+ * Every call is published on the injected leaf sink so the surrounding
+ * application can observe the traffic; the sink never decides behaviour.
+ */
+import { SavedEffect, SavedLeaf } from '../../integration/SavedPageIntegration';
+import { PageTitle } from '../model/PageTitle';
+
+export const LEAF_HTTP: string = 'http';
+export const LEAF_SYNC: string = 'sync';
+export const LEAF_ANALYTICS: string = 'analytics';
+export const LEAF_FILE: string = 'file';
+
+export const ROUTE_REDIRECT_METADATA: string = 'redirect/metadata';
+export const ROUTE_READING_LIST_SYNC: string = 'readinglist/sync';
+export const ROUTE_SHARED_COLLECTION: string = 'readinglist/shared';
+
+export const OUTCOME_OK: string = 'ok';
+export const OUTCOME_OFFLINE: string = 'offline';
+export const OUTCOME_IO: string = 'error:io';
+export const OUTCOME_HTTP: string = 'error:http';
+
+export class HttpResult {
+  readonly ok: boolean;
+  readonly status: string;
+  readonly body: string;
+  readonly exception: string;
+
+  constructor(ok: boolean, status: string, body: string, exception: string) {
+    this.ok = ok;
+    this.status = status;
+    this.body = body;
+    this.exception = exception;
+  }
+}
+
+/** Canonical title of an article after redirect resolution. */
+export class RedirectMetadata {
+  readonly from: string;
+  readonly to: string;
+
+  constructor(from: string, to: string) {
+    this.from = from;
+    this.to = to;
+  }
+}
+
+export class ReadingListSyncRequest {
+  readonly force: boolean;
+  readonly fromRefresh: boolean;
+  readonly attempt: number;
+
+  constructor(force: boolean, fromRefresh: boolean, attempt: number) {
+    this.force = force;
+    this.fromRefresh = fromRefresh;
+    this.attempt = attempt;
+  }
+}
+
+export class ReadingListSyncResponse {
+  readonly completed: boolean;
+  readonly exception: string;
+  /** `true` when the remote side pushed changes before completing. */
+  readonly applied: boolean;
+
+  constructor(completed: boolean, exception: string, applied: boolean) {
+    this.completed = completed;
+    this.exception = exception;
+    this.applied = applied;
+  }
+}
+
+/**
+ * Transport that knows how the network behaves right now. Outcomes are a
+ * device/app level fact (offline, IO failure, HTTP error); the Saved feature
+ * never assumes success.
+ */
+export class HttpTransport {
+  private readonly outcomes: Map<string, string> = new Map<string, string>();
+  private readonly bodies: Map<string, string> = new Map<string, string>();
+
+  configure(route: string, outcome: string, body: string): void {
+    this.outcomes.set(route, outcome);
+    if (body.length > 0) {
+      this.bodies.set(route, body);
+    }
+  }
+
+  outcomeOf(route: string): string {
+    const configured = this.outcomes.get(route);
+    return configured !== undefined ? configured : OUTCOME_OK;
+  }
+
+  bodyOf(route: string): string {
+    const configured = this.bodies.get(route);
+    return configured !== undefined ? configured : '';
+  }
+
+  isHealthy(route: string): boolean {
+    return this.outcomeOf(route) === OUTCOME_OK;
+  }
+}
+
+export class SavedEnvironment {
+  private readonly leaf: SavedLeaf;
+  private readonly http: HttpTransport;
+
+  constructor(leaf: SavedLeaf) {
+    this.leaf = leaf;
+    this.http = new HttpTransport();
+  }
+
+  configureRoute(route: string, outcome: string, body: string): void {
+    this.http.configure(route, outcome, body);
+  }
+
+  isRouteHealthy(route: string): boolean {
+    return this.http.isHealthy(route);
+  }
+
+  /**
+   * Resolves the canonical title of an article.
+   *
+   * When the device is offline or the request fails the caller receives
+   * `undefined` and keeps the original language and API title; a failed lookup
+   * must never prevent the article from being saved.
+   */
+  async resolveRedirectMetadata(pageTitle: PageTitle): Promise<RedirectMetadata | undefined> {
+    const route = ROUTE_REDIRECT_METADATA;
+    const outcome = this.http.outcomeOf(route);
+    const body = this.http.bodyOf(route);
+    if (outcome !== OUTCOME_OK) {
+      await this.publish({
+        name: 'resolveRedirectMetadata',
+        leaf: LEAF_HTTP,
+        status: 'error',
+        exception: outcome,
+        article: pageTitle.identity
+      });
+      return undefined;
+    }
+    const canonical = this.parseRedirectTarget(body, pageTitle);
+    await this.publish({
+      name: 'resolveRedirectMetadata',
+      leaf: LEAF_HTTP,
+      status: 'ok',
+      article: pageTitle.identity
+    });
+    if (canonical.length === 0 || canonical === pageTitle.apiTitle) {
+      return undefined;
+    }
+    return new RedirectMetadata(pageTitle.apiTitle, canonical);
+  }
+
+  private parseRedirectTarget(body: string, pageTitle: PageTitle): string {
+    if (body.length === 0) {
+      return '';
+    }
+    const parsed = JSON.parse(body) as RedirectTargetBody;
+    if (parsed === undefined || parsed === null) {
+      return '';
+    }
+    if (parsed.from === pageTitle.apiTitle && parsed.to !== undefined && parsed.to.length > 0) {
+      return parsed.to;
+    }
+    return '';
+  }
+
+  /** Starts a reading list synchronisation round trip. */
+  async startReadingListSync(request: ReadingListSyncRequest): Promise<ReadingListSyncResponse> {
+    const outcome = this.http.outcomeOf(ROUTE_READING_LIST_SYNC);
+    await this.publish({
+      name: 'startReadingListSync',
+      leaf: LEAF_SYNC,
+      status: outcome === OUTCOME_OK ? 'started' : 'error',
+      exception: outcome === OUTCOME_OK ? '' : outcome,
+      force: request.force,
+      fromRefresh: request.fromRefresh,
+      attempt: request.attempt
+    });
+    if (outcome !== OUTCOME_OK) {
+      return new ReadingListSyncResponse(false, outcome, false);
+    }
+    return new ReadingListSyncResponse(true, '', true);
+  }
+
+  /** Reports that the synchronisation finished, successfully or not. */
+  async reportSyncEvent(completed: boolean, exception: string, surfaces: string[]): Promise<void> {
+    await this.publish({
+      name: 'readingListSyncEvent',
+      leaf: LEAF_SYNC,
+      status: completed ? 'completed' : 'failed',
+      exception: exception,
+      surfaces: surfaces
+    });
+  }
+
+  async logEvent(name: string, surfaces: string[]): Promise<void> {
+    await this.publish({ name: name, leaf: LEAF_ANALYTICS, status: 'ok', surfaces: surfaces });
+  }
+
+  async writeExportFile(fileName: string, content: string): Promise<HttpResult> {
+    await this.publish({ name: 'writeExportFile', leaf: LEAF_FILE, status: 'ok', surface: fileName });
+    return new HttpResult(true, '200', content, '');
+  }
+
+  /** Publishes one effect on the leaf sink. */
+  async publish(effect: SavedEffect): Promise<void> {
+    await this.leaf.emit(effect);
+  }
+}
+
+interface RedirectTargetBody {
+  from?: string;
+  to?: string;
+}
