@@ -0,0 +1,147 @@
+/**
+ * Persisted preferences of the Saved surface.
+ *
+ * Everything the reader expects to survive a restart lives here: the sort mode
+ * of each view (persisted independently), the last visible tab, whether
+ * reading list synchronisation is enabled, and the durable snapshot of the
+ * offline reading list cache.
+ */
+import { common } from '@kit.AbilityKit';
+import { preferences } from '@kit.ArkData';
+import {
+  PREFERENCE_ARTICLE_SORT_MODE,
+  PREFERENCE_COLLECTION_SORT_MODE,
+  PREFERENCE_DATABASE_SNAPSHOT,
+  PREFERENCE_LAST_TAB,
+  PREFERENCE_STORE_NAME,
+  PREFERENCE_SYNC_ENABLED,
+  SORT_BY_NAME_ASC
+} from '../model/SavedConstants';
+
+export class SavedPreferences {
+  private store: preferences.Preferences;
+  private cache: Map<string, string>;
+
+  private constructor(store: preferences.Preferences) {
+    this.store = store;
+    this.cache = new Map<string, string>();
+  }
+
+  static async create(context: common.UIAbilityContext, storeName: string): Promise<SavedPreferences> {
+    const store = await preferences.getPreferences(context, storeName);
+    const holder = new SavedPreferences(store);
+    await holder.warmUp();
+    return holder;
+  }
+
+  static defaultStoreName(): string {
+    return PREFERENCE_STORE_NAME;
+  }
+
+  private async warmUp(): Promise<void> {
+    const defaults: string[] = [
+      PREFERENCE_ARTICLE_SORT_MODE,
+      PREFERENCE_COLLECTION_SORT_MODE,
+      PREFERENCE_LAST_TAB,
+      PREFERENCE_SYNC_ENABLED,
+      PREFERENCE_DATABASE_SNAPSHOT
+    ];
+    for (let index = 0; index < defaults.length; index++) {
+      const key = defaults[index];
+      const value = await this.store.get(key, '');
+      if (typeof value === 'string') {
+        this.cache.set(key, value);
+      }
+    }
+  }
+
+  private read(key: string, fallback: string): string {
+    const cached = this.cache.get(key);
+    return cached !== undefined ? cached : fallback;
+  }
+
+  private async write(key: string, value: string): Promise<void> {
+    this.cache.set(key, value);
+    await this.store.put(key, value);
+    await this.store.flush();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Sort modes (independent per view)                                      */
+  /* -------------------------------------------------------------------- */
+
+  articleSortMode(): number {
+    return this.readNumber(PREFERENCE_ARTICLE_SORT_MODE, SORT_BY_NAME_ASC);
+  }
+
+  setArticleSortMode(mode: number): Promise<void> {
+    return this.write(PREFERENCE_ARTICLE_SORT_MODE, String(mode));
+  }
+
+  collectionSortMode(): number {
+    return this.readNumber(PREFERENCE_COLLECTION_SORT_MODE, SORT_BY_NAME_ASC);
+  }
+
+  setCollectionSortMode(mode: number): Promise<void> {
+    return this.write(PREFERENCE_COLLECTION_SORT_MODE, String(mode));
+  }
+
+  private readNumber(key: string, fallback: number): number {
+    const raw = this.read(key, '');
+    if (raw.length === 0) {
+      return fallback;
+    }
+    const parsed = Number(raw);
+    if (isNaN(parsed)) {
+      return fallback;
+    }
+    return parsed;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Tab + sync preference                                                  */
+  /* -------------------------------------------------------------------- */
+
+  lastTab(): string {
+    return this.read(PREFERENCE_LAST_TAB, '');
+  }
+
+  setLastTab(tab: string): Promise<void> {
+    return this.write(PREFERENCE_LAST_TAB, tab);
+  }
+
+  isSyncEnabled(): boolean {
+    return this.read(PREFERENCE_SYNC_ENABLED, 'true') === 'true';
+  }
+
+  setSyncEnabled(enabled: boolean): Promise<void> {
+    return this.write(PREFERENCE_SYNC_ENABLED, enabled ? 'true' : 'false');
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Offline cache snapshot                                                 */
+  /* -------------------------------------------------------------------- */
+
+  loadSnapshot(): string {
+    return this.read(PREFERENCE_DATABASE_SNAPSHOT, '');
+  }
+
+  persistSnapshot(serialised: string): Promise<void> {
+    return this.write(PREFERENCE_DATABASE_SNAPSHOT, serialised);
+  }
+
+  async clear(): Promise<void> {
+    this.cache = new Map<string, string>();
+    await this.store.clear();
+    await this.store.flush();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Snapshot mirror used by the persistence projection                    */
+  /* -------------------------------------------------------------------- */
+
+  /** Serialised view of everything this class persists. */
+  snapshotValues(): Map<string, string> {
+    return new Map<string, string>(this.cache);
+  }
+}
