+/**
+ * Observable presentation model of the Saved surface.
+ *
+ * Everything the page renders is derived from the reading list tables; this file
+ * only describes the shapes that are handed to the UI layer.
+ */
+import { PageTitle } from './PageTitle';
+import { EMPTY_STATE_NONE, FEEDBACK_ACTION_DISMISS, FEEDBACK_SEVERITY_INFO } from './SavedConstants';
+
+/**
+ * One row of the All articles tab.
+ *
+ * A row is a *logical* article: `id` is the identity of the representative
+ * membership row and `collections` holds every collection that currently holds
+ * the article, including the default collection.
+ */
+export class SavedArticleRow {
+  id: number;
+  article: string;
+  language: string;
+  apiTitle: string;
+  displayTitle: string;
+  collections: string[];
+  collectionCount: number;
+  onlyInDefaultCollection: boolean;
+  isOffline: boolean;
+  /** -1 when no download is in flight, otherwise a 0..1 progress fraction. */
+  downloadProgress: number;
+  selected: boolean;
+  addedAt: number;
+  updatedAt: number;
+
+  constructor(id: number, pageTitle: PageTitle, collections: string[], onlyInDefaultCollection: boolean,
+    addedAt: number, updatedAt: number) {
+    this.id = id;
+    this.article = pageTitle.identity;
+    this.language = pageTitle.languageCode;
+    this.apiTitle = pageTitle.apiTitle;
+    this.displayTitle = pageTitle.displayTitle;
+    this.collections = collections;
+    this.collectionCount = collections.length;
+    this.onlyInDefaultCollection = onlyInDefaultCollection;
+    this.isOffline = false;
+    this.downloadProgress = -1;
+    this.selected = false;
+    this.addedAt = addedAt;
+    this.updatedAt = updatedAt;
+  }
+}
+
+/** One row of the Collections tab. The default collection is never listed. */
+export class SavedCollectionRow {
+  id: number;
+  title: string;
+  description: string;
+  isDefault: boolean;
+  deletable: boolean;
+  articleCount: number;
+  offlineArticleCount: number;
+  selected: boolean;
+
+  constructor(id: number, title: string, description: string, isDefault: boolean, articleCount: number) {
+    this.id = id;
+    this.title = title;
+    this.description = description;
+    this.isDefault = isDefault;
+    this.deletable = !isDefault;
+    this.articleCount = articleCount;
+    this.offlineArticleCount = 0;
+    this.selected = false;
+  }
+}
+
+/** A collection entry inside the save-article sheet. */
+export class SaveArticleCollectionOption {
+  id: number;
+  title: string;
+  isDefault: boolean;
+  checked: boolean;
+  /** The option cannot be toggled on because a limit is already reached. */
+  disabled: boolean;
+  limitReason: string;
+
+  constructor(id: number, title: string, isDefault: boolean, checked: boolean) {
+    this.id = id;
+    this.title = title;
+    this.isDefault = isDefault;
+    this.checked = checked;
+    this.disabled = false;
+    this.limitReason = '';
+  }
+}
+
+/**
+ * State of the sheet that is opened after a reader taps "Save" on an article.
+ * Opening the sheet always guarantees the article is saved.
+ */
+export class SaveArticleSheetState {
+  visible: boolean;
+  article: string;
+  language: string;
+  apiTitle: string;
+  displayTitle: string;
+  isSaved: boolean;
+  collections: SaveArticleCollectionOption[];
+  /** True while the destructive "remove from every collection" ask is pending. */
+  pendingConfirmation: boolean;
+  /** Non default collections that would lose the article when confirming. */
+  confirmationCollections: string[];
+  creatingCollection: boolean;
+  newCollectionTitle: string;
+  limitMessage: string;
+
+  constructor(pageTitle: PageTitle) {
+    this.visible = true;
+    this.article = pageTitle.identity;
+    this.language = pageTitle.languageCode;
+    this.apiTitle = pageTitle.apiTitle;
+    this.displayTitle = pageTitle.displayTitle;
+    this.isSaved = false;
+    this.collections = [];
+    this.pendingConfirmation = false;
+    this.confirmationCollections = [];
+    this.creatingCollection = false;
+    this.newCollectionTitle = '';
+    this.limitMessage = '';
+  }
+
+  /** Collections that hold the article right now. */
+  checkedCollectionTitles(): string[] {
+    const titles: string[] = [];
+    for (let index = 0; index < this.collections.length; index++) {
+      if (this.collections[index].checked) {
+        titles.push(this.collections[index].title);
+      }
+    }
+    return titles;
+  }
+}
+
+export class SavedFeedbackState {
+  visible: boolean;
+  message: string;
+  actionLabel: string;
+  severity: string;
+
+  constructor() {
+    this.visible = false;
+    this.message = '';
+    this.actionLabel = FEEDBACK_ACTION_DISMISS;
+    this.severity = FEEDBACK_SEVERITY_INFO;
+  }
+}
+
+export class SavedAccountState {
+  isLoggedIn: boolean;
+  isTemporary: boolean;
+  userName: string;
+
+  constructor() {
+    this.isLoggedIn = false;
+    this.isTemporary = false;
+    this.userName = '';
+  }
+
+  /**
+   * Reading list synchronisation is only offered to a real, non temporary
+   * account; everything else has to show a login prompt instead.
+   */
+  isSyncEligible(): boolean {
+    return this.isLoggedIn && !this.isTemporary;
+  }
+}
+
+export class SavedUiState {
+  selectedTab: string;
+  availableTabs: string[];
+  searchQuery: string;
+  pendingSearchQuery: string;
+  isSearchPending: boolean;
+  searchDebounceMillis: number;
+  selectedArticleFilter: string;
+  articleSortMode: number;
+  collectionSortMode: number;
+  articleSortChoices: number[];
+  collectionSortChoices: number[];
+  articleRows: SavedArticleRow[];
+  collectionRows: SavedCollectionRow[];
+  visibleArticleRowIds: number[];
+  visibleCollectionRowIds: number[];
+  isLoading: boolean;
+  emptyState: string;
+  selectionEnabled: boolean;
+  selectedRowIds: number[];
+  isRefreshing: boolean;
+  syncInFlight: boolean;
+  syncStartedCount: number;
+  syncCompletedCount: number;
+  refreshAttempts: number;
+  lastRefreshOutcome: string;
+  loginPromptVisible: boolean;
+  onboarding: string;
+  saveSheet: SaveArticleSheetState | null;
+  feedback: SavedFeedbackState;
+  account: SavedAccountState;
+  readingListSyncEnabled: boolean;
+  badgeCount: number;
+  sharedCollectionTitle: string;
+  menuActions: string[];
+  createdCollectionIds: number[];
+  pendingDeletionArticleIds: number[];
+  pendingDeletionCollectionIds: number[];
+  undoAvailable: boolean;
+
+  constructor() {
+    this.selectedTab = '';
+    this.availableTabs = [];
+    this.searchQuery = '';
+    this.pendingSearchQuery = '';
+    this.isSearchPending = false;
+    this.searchDebounceMillis = 0;
+    this.selectedArticleFilter = '';
+    this.articleSortMode = 0;
+    this.collectionSortMode = 0;
+    this.articleSortChoices = [];
+    this.collectionSortChoices = [];
+    this.articleRows = [];
+    this.collectionRows = [];
+    this.visibleArticleRowIds = [];
+    this.visibleCollectionRowIds = [];
+    this.isLoading = false;
+    this.emptyState = EMPTY_STATE_NONE;
+    this.selectionEnabled = false;
+    this.selectedRowIds = [];
+    this.isRefreshing = false;
+    this.syncInFlight = false;
+    this.syncStartedCount = 0;
+    this.syncCompletedCount = 0;
+    this.refreshAttempts = 0;
+    this.lastRefreshOutcome = '';
+    this.loginPromptVisible = false;
+    this.onboarding = '';
+    this.saveSheet = null;
+    this.feedback = new SavedFeedbackState();
+    this.account = new SavedAccountState();
+    this.readingListSyncEnabled = true;
+    this.badgeCount = 0;
+    this.sharedCollectionTitle = '';
+    this.menuActions = [];
+    this.createdCollectionIds = [];
+    this.pendingDeletionArticleIds = [];
+    this.pendingDeletionCollectionIds = [];
+    this.undoAvailable = false;
+  }
+
+  articleRowIds(): number[] {
+    const ids: number[] = [];
+    for (let index = 0; index < this.articleRows.length; index++) {
+      ids.push(this.articleRows[index].id);
+    }
+    return ids;
+  }
+
+  collectionRowIds(): number[] {
+    const ids: number[] = [];
+    for (let index = 0; index < this.collectionRows.length; index++) {
+      ids.push(this.collectionRows[index].id);
+    }
+    return ids;
+  }
+
+  selectedArticleRows(): SavedArticleRow[] {
+    const rows: SavedArticleRow[] = [];
+    for (let index = 0; index < this.articleRows.length; index++) {
+      if (this.selectedRowIds.indexOf(this.articleRows[index].id) >= 0) {
+        rows.push(this.articleRows[index]);
+      }
+    }
+    return rows;
+  }
+
+  selectedCollectionRows(): SavedCollectionRow[] {
+    const rows: SavedCollectionRow[] = [];
+    for (let index = 0; index < this.collectionRows.length; index++) {
+      if (this.selectedRowIds.indexOf(this.collectionRows[index].id) >= 0) {
+        rows.push(this.collectionRows[index]);
+      }
+    }
+    return rows;
+  }
+}
