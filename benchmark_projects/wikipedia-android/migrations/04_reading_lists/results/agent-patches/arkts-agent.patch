@@ -0,0 +1,76 @@
+/**
+ * Logical identity of a Wikipedia article as used by the Saved experience.
+ *
+ * The identity of a saved article is the pair of wiki language code and API
+ * (storage) title. Display titles are presentation only: two saved rows that
+ * point at the same language/title pair are the same logical article even when
+ * they are stored in several collections.
+ */
+import { DEFAULT_LANGUAGE_CODE } from './SavedConstants';
+
+export class PageTitle {
+  readonly languageCode: string;
+  readonly apiTitle: string;
+  readonly displayTitle: string;
+
+  constructor(languageCode: string, apiTitle: string, displayTitle: string) {
+    this.languageCode = languageCode && languageCode.length > 0 ? languageCode : DEFAULT_LANGUAGE_CODE;
+    this.apiTitle = apiTitle;
+    this.displayTitle = displayTitle && displayTitle.length > 0
+      ? displayTitle
+      : PageTitle.deriveDisplayTitle(this.apiTitle);
+  }
+
+  /** Canonical string form: `<language>:<apiTitle>`. */
+  get identity(): string {
+    return this.languageCode + ':' + this.apiTitle;
+  }
+
+  get language(): string {
+    return this.languageCode;
+  }
+
+  get title(): string {
+    return this.apiTitle;
+  }
+
+  equals(other: PageTitle): boolean {
+    return other !== undefined && other !== null && other.identity === this.identity;
+  }
+
+  /** True when both titles denote the same logical article. */
+  static sameIdentity(left: PageTitle, right: PageTitle): boolean {
+    return left !== undefined && left !== null && left.identity === right.identity;
+  }
+
+  toString(): string {
+    return this.identity;
+  }
+
+  static fromIdentity(identity: string): PageTitle {
+    const separator = identity.indexOf(':');
+    if (separator <= 0 || separator === identity.length - 1) {
+      return new PageTitle(DEFAULT_LANGUAGE_CODE, identity, PageTitle.deriveDisplayTitle(identity));
+    }
+    const language = identity.substring(0, separator);
+    const apiTitle = identity.substring(separator + 1);
+    return new PageTitle(language, apiTitle, PageTitle.deriveDisplayTitle(apiTitle));
+  }
+
+  static deriveDisplayTitle(apiTitle: string): string {
+    return PageTitle.decodeUriComponent(apiTitle.replace(/_/g, ' '));
+  }
+
+  private static decodeUriComponent(value: string): string {
+    if (value.indexOf('%') < 0) {
+      return value;
+    }
+    try {
+      return decodeURIComponent(value);
+    } catch (error) {
+      // A malformed escape sequence is not a reason to fail a save operation;
+      // the raw text is still a usable display title.
+      return value;
+    }
+  }
+}
