@@ -0,0 +1,1361 @@
+/**
+ * State reduction for the Saved surface.
+ *
+ * The view model owns every piece of application state that the Saved feature
+ * needs: the active tab, the debounced search query, the article filter, the two
+ * independently persisted sort preferences, selection mode, the save-article
+ * sheet, confirmation dialogs, limits, undo and the pull-to-refresh lifecycle.
+ *
+ * It derives its projection from the reading list tables through the DAOs, so a
+ * single database write updates every visible surface without anybody having to
+ * rebuild the page.
+ */
+import { Flow } from '../data/Flow';
+import { ReadingListDatabase } from '../data/ReadingListDatabase';
+import { ReadingListsDao } from '../data/ReadingListsDao';
+import { MembershipChange, ReadingListPagesDao, SavedArticleRecord } from '../data/ReadingListPagesDao';
+import { SavedPreferences } from '../data/SavedPreferences';
+import { ArticleMediaStatus, DOWNLOAD_IDLE } from '../data/ArticleMediaStatus';
+import { SavedSession } from '../data/SavedSession';
+import { SavedTextSearch } from '../data/SavedTextSearch';
+import {
+  ReadingListSyncRequest,
+  SavedEnvironment
+} from '../leaf/ExternalGateway';
+import { PageTitle } from '../model/PageTitle';
+import { RoomListEntity, RoomListWithPages } from '../model/Entities';
+import { CollectionCreation } from '../data/ReadingListsDao';
+import { SavedLimitPolicy } from '../model/SavedLimits';
+import {
+  SaveArticleCollectionOption,
+  SaveArticleSheetState,
+  SavedArticleRow,
+  SavedCollectionRow,
+  SavedFeedbackState,
+  SavedUiState
+} from '../model/SavedUiState';
+import {
+  ARTICLE_FILTER_ALL_ARTICLES,
+  ARTICLE_FILTER_NOT_IN_COLLECTION,
+  ARTICLE_SORT_CHOICES,
+  COLLECTION_SORT_CHOICES,
+  EMPTY_STATE_LOADING,
+  EMPTY_STATE_NONE,
+  EMPTY_STATE_NOTHING_SELECTED,
+  EMPTY_STATE_NO_ARTICLES,
+  EMPTY_STATE_NO_COLLECTIONS,
+  EMPTY_STATE_SEARCH_NO_RESULTS,
+  FEEDBACK_ACTION_DISMISS,
+  FEEDBACK_ACTION_UNDO,
+  FEEDBACK_SEVERITY_ERROR,
+  FEEDBACK_SEVERITY_INFO,
+  FEEDBACK_SEVERITY_WARNING,
+  MENU_ACTION_ADD_TO_COLLECTION,
+  MENU_ACTION_DELETE,
+  MENU_ACTION_DELETE_COLLECTION,
+  MENU_ACTION_FILTER,
+  MENU_ACTION_NEW_COLLECTION,
+  MENU_ACTION_REMOVE_FROM_ALL,
+  MENU_ACTION_SEARCH,
+  MENU_ACTION_SELECT,
+  MENU_ACTION_SELECT_ALL,
+  MENU_ACTION_SELECT_NONE,
+  MENU_ACTION_SORT,
+  ONBOARDING_LOGIN_REMINDER,
+  ONBOARDING_NONE,
+  ONBOARDING_SHARED_COLLECTION,
+  ONBOARDING_SYNC_REMINDER,
+  REFRESH_OUTCOME_IDLE,
+  REFRESH_OUTCOME_LOGIN_PROMPT,
+  REFRESH_OUTCOME_REFRESHING,
+  REFRESH_OUTCOME_SYNC_COMPLETED,
+  REFRESH_OUTCOME_SYNC_FAILED,
+  REFRESH_OUTCOME_SYNC_STARTED,
+  SEARCH_DEBOUNCE_MILLIS,
+  SORT_BY_DATE_ADDED,
+  SORT_BY_DATE_LAST_UPDATED,
+  SORT_BY_NAME_ASC,
+  SORT_BY_NAME_DESC,
+  SYNC_COMPLETION_HELD,
+  SYNC_COMPLETION_IMMEDIATE,
+  SYNC_EVENT_COMPLETED,
+  SYNC_EVENT_FAILED,
+  TAB_ALL_ARTICLES,
+  TAB_COLLECTIONS,
+  isArticleFilter,
+  isSavedTab,
+  isSortMode
+} from '../model/SavedConstants';
+
+export type UiStateObserver = (state: SavedUiState) => void;
+
+/** Pending destructive action that can still be undone. */
+export class PendingUndo {
+  articleIdentities: string[];
+  articlePageIds: number[];
+  collectionIds: number[];
+
+  constructor() {
+    this.articleIdentities = [];
+    this.articlePageIds = [];
+    this.collectionIds = [];
+  }
+
+  isEmpty(): boolean {
+    return this.articleIdentities.length === 0 && this.collectionIds.length === 0;
+  }
+}
+
+/**
+ * A collection toggle that was rendered by the save sheet and has not been
+ * applied yet. The row can outlive the collection it points at when the
+ * collection is removed by synchronisation while the sheet stays open.
+ */
+export class QueuedCollectionToggle {
+  collectionId: number;
+  collectionTitle: string;
+  article: string;
+
+  constructor(collectionId: number, collectionTitle: string, article: string) {
+    this.collectionId = collectionId;
+    this.collectionTitle = collectionTitle;
+    this.article = article;
+  }
+}
+
+export class SavedViewModel {
+  private readonly database: ReadingListDatabase;
+  private readonly listsDao: ReadingListsDao;
+  private readonly pagesDao: ReadingListPagesDao;
+  private readonly preferences: SavedPreferences;
+  private readonly environment: SavedEnvironment;
+  private readonly session: SavedSession;
+  private readonly mediaStatus: ArticleMediaStatus;
+  private readonly state: SavedUiState;
+  private readonly observers: UiStateObserver[] = [];
+  private readonly listsWithPages: Flow<RoomListWithPages[]>;
+
+  private searchTimerId: number = -1;
+  private surfaceOpen: boolean = false;
+  private pendingUndo: PendingUndo | null = null;
+  private queuedToggle: QueuedCollectionToggle | null = null;
+  private pendingPageTitle: PageTitle | null = null;
+  private syncCompletion: string = SYNC_COMPLETION_IMMEDIATE;
+  private remoteSyncAdds: RemoteSyncAddition[] = [];
+  private forcedOnboarding: string = ONBOARDING_NONE;
+  private localChangeCount: number = 0;
+
+  constructor(database: ReadingListDatabase, listsDao: ReadingListsDao, pagesDao: ReadingListPagesDao,
+    preferences: SavedPreferences, environment: SavedEnvironment, session: SavedSession,
+    mediaStatus: ArticleMediaStatus) {
+    this.database = database;
+    this.listsDao = listsDao;
+    this.pagesDao = pagesDao;
+    this.preferences = preferences;
+    this.environment = environment;
+    this.session = session;
+    this.mediaStatus = mediaStatus;
+    this.state = new SavedUiState();
+    this.listsWithPages = listsDao.observeListsWithPages();
+    this.state.availableTabs = [TAB_ALL_ARTICLES, TAB_COLLECTIONS];
+    this.state.articleSortChoices = copyNumbers(ARTICLE_SORT_CHOICES);
+    this.state.collectionSortChoices = copyNumbers(COLLECTION_SORT_CHOICES);
+    this.state.searchDebounceMillis = SEARCH_DEBOUNCE_MILLIS;
+    this.state.selectedTab = TAB_ALL_ARTICLES;
+    this.state.selectedArticleFilter = ARTICLE_FILTER_ALL_ARTICLES;
+    this.state.articleSortMode = SORT_BY_NAME_ASC;
+    this.state.collectionSortMode = SORT_BY_NAME_ASC;
+    this.state.onboarding = ONBOARDING_NONE;
+    this.state.feedback = new SavedFeedbackState();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Wiring                                                                 */
+  /* -------------------------------------------------------------------- */
+
+  /** Subscribes to the reactive projections; database changes drive updates. */
+  start(): void {
+    // The default collection is materialised up front so that projecting never
+    // has to write to the database it is reading from.
+    this.pagesDao.defaultList();
+    this.listsWithPages.collect((_: RoomListWithPages[]): void => {
+      this.onDatabaseChanged();
+    });
+    this.pagesDao.observeActivePages().collect((): void => {
+      this.onDatabaseChanged();
+    });
+    this.state.account = this.session.snapshot();
+    this.state.readingListSyncEnabled = this.session.isSyncEnabled();
+    this.onDatabaseChanged();
+  }
+
+  observe(observer: UiStateObserver): void {
+    this.observers.push(observer);
+  }
+
+  currentState(): SavedUiState {
+    return this.state;
+  }
+
+  private notify(): void {
+    for (let index = 0; index < this.observers.length; index++) {
+      this.observers[index](this.state);
+    }
+  }
+
+  /**
+   * Called for every database change. The projection is rebuilt from the
+   * tables, which is what keeps the All articles and Collections views, the
+   * collection counters and the save sheet consistent with each other.
+   */
+  private onDatabaseChanged(): void {
+    this.state.articleRows = this.projectArticleRows();
+    this.state.collectionRows = this.projectCollectionRows();
+    this.state.visibleArticleRowIds = this.state.articleRowIds();
+    this.state.visibleCollectionRowIds = this.state.collectionRowIds();
+    this.dropSelectionOfMissingRows();
+    this.refreshMediaStatus();
+    this.state.pendingDeletionArticleIds = this.queuedArticleIds();
+    this.state.pendingDeletionCollectionIds = this.queuedCollectionIds();
+    this.state.undoAvailable = this.pendingUndo !== null && !this.pendingUndo.isEmpty();
+    this.state.emptyState = this.resolveEmptyState();
+    this.state.menuActions = this.resolveMenuActions();
+    this.state.badgeCount = this.localChangeCount;
+    this.resolveOnboarding();
+    this.notify();
+  }
+
+  private recompute(): void {
+    this.onDatabaseChanged();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Initial configuration                                                  */
+  /* -------------------------------------------------------------------- */
+
+  applyPersistedSortModes(articleMode: number, collectionMode: number): void {
+    if (isSortMode(articleMode, ARTICLE_SORT_CHOICES)) {
+      this.state.articleSortMode = articleMode;
+    }
+    if (isSortMode(collectionMode, COLLECTION_SORT_CHOICES)) {
+      this.state.collectionSortMode = collectionMode;
+    }
+  }
+
+  applySearchDebounce(millis: number): void {
+    if (millis > 0) {
+      this.state.searchDebounceMillis = millis;
+    }
+  }
+
+  applySyncPreference(enabled: boolean): Promise<void> {
+    this.session.applySyncEnabled(enabled);
+    this.state.readingListSyncEnabled = enabled;
+    this.state.account = this.session.snapshot();
+    this.resolveOnboarding();
+    this.notify();
+    return Promise.resolve();
+  }
+
+  applyForcedOnboarding(onboarding: string): void {
+    if (onboarding.length > 0) {
+      this.forcedOnboarding = onboarding;
+      this.state.onboarding = onboarding;
+    }
+  }
+
+  applySyncCompletionPolicy(policy: string): void {
+    this.syncCompletion = policy;
+  }
+
+  queueRemoteSyncAddition(article: string, lists: string[]): void {
+    this.remoteSyncAdds.push(new RemoteSyncAddition(article, lists));
+  }
+
+  setPendingPageTitle(pageTitle: PageTitle | null): void {
+    this.pendingPageTitle = pageTitle;
+  }
+
+  setQueuedCollectionToggle(toggle: QueuedCollectionToggle | null): void {
+    this.queuedToggle = toggle;
+  }
+
+  hasQueuedCollectionToggle(): boolean {
+    return this.queuedToggle !== null;
+  }
+
+  seedSelection(enabled: boolean, rowIds: number[]): void {
+    this.state.selectionEnabled = enabled;
+    this.state.selectedRowIds = copyNumbers(rowIds);
+  }
+
+  seedArticleFilter(filter: string): void {
+    if (isArticleFilter(filter)) {
+      this.state.selectedArticleFilter = filter;
+    }
+  }
+
+  /** Guarantees a valid filter for the tab that is about to be shown. */
+  applyFilterDefault(): void {
+    if (this.state.selectedTab !== TAB_ALL_ARTICLES
+      || !isArticleFilter(this.state.selectedArticleFilter)) {
+      this.state.selectedArticleFilter = ARTICLE_FILTER_ALL_ARTICLES;
+    }
+  }
+
+  /** Re-attaches an already open save-article sheet to the restored session. */
+  restoreSaveSheet(sheet: SaveArticleSheetState): void {
+    this.state.saveSheet = sheet;
+    this.refreshSheetOptions(sheet);
+    this.notify();
+  }
+
+  seedSearchQuery(query: string): void {
+    this.state.searchQuery = query;
+    this.state.pendingSearchQuery = query;
+  }
+
+  seedTab(tab: string): void {
+    if (isSavedTab(tab)) {
+      this.state.selectedTab = tab;
+    }
+  }
+
+  seedRefreshing(refreshing: boolean): void {
+    this.state.isRefreshing = refreshing;
+    this.state.lastRefreshOutcome = refreshing ? REFRESH_OUTCOME_REFRESHING : REFRESH_OUTCOME_IDLE;
+  }
+
+  seedQueuedDeletion(identities: string[], pageIds: number[]): void {
+    const undo = new PendingUndo();
+    undo.articleIdentities = copyStrings(identities);
+    undo.articlePageIds = copyNumbers(pageIds);
+    this.pendingUndo = undo;
+  }
+
+  seedUndoAvailable(available: boolean): void {
+    if (!available) {
+      this.pendingUndo = null;
+    }
+  }
+
+  seedLocalChangeCount(count: number): void {
+    this.localChangeCount = count;
+  }
+
+  /** Records a local change that has not been synchronised yet. */
+  markLocalChange(count: number): void {
+    this.localChangeCount = Math.max(0, this.localChangeCount + count);
+    this.state.badgeCount = this.localChangeCount;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Surface lifecycle                                                      */
+  /* -------------------------------------------------------------------- */
+
+  /** The Saved surface always opens on the deduplicated All articles view. */
+  async openSavedSurface(): Promise<void> {
+    this.surfaceOpen = true;
+    this.state.selectedTab = TAB_ALL_ARTICLES;
+    this.state.isLoading = true;
+    this.notify();
+    this.state.isLoading = false;
+    this.state.emptyState = EMPTY_STATE_NONE;
+    this.recompute();
+  }
+
+  isSurfaceOpen(): boolean {
+    return this.surfaceOpen;
+  }
+
+  async closeSavedSurface(): Promise<void> {
+    this.surfaceOpen = false;
+    this.cancelPendingSearch();
+    this.dismissSaveArticleSheet();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Tabs                                                                   */
+  /* -------------------------------------------------------------------- */
+
+  async selectSavedTab(tab: string): Promise<void> {
+    if (!isSavedTab(tab) || tab === this.state.selectedTab) {
+      if (isSavedTab(tab)) {
+        this.recompute();
+      }
+      return;
+    }
+    // The reader keeps the text they typed; only the scope it applies to moves.
+    this.flushPendingSearch();
+    this.state.selectedTab = tab;
+    if (tab !== TAB_ALL_ARTICLES) {
+      // Filtering to "only in the default collection" is an All articles idea.
+      this.state.selectedArticleFilter = ARTICLE_FILTER_ALL_ARTICLES;
+    }
+    await this.preferences.setLastTab(tab);
+    this.recompute();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Search                                                                 */
+  /* -------------------------------------------------------------------- */
+
+  /**
+   * Entry point of the debounced search field.
+   *
+   * A non empty query always waits for the full production debounce window;
+   * clearing the query is applied immediately because there is nothing left to
+   * narrow down.
+   */
+  async enterSavedSearchQuery(query: string, elapsedMillis: number): Promise<void> {
+    this.state.pendingSearchQuery = query;
+    this.cancelPendingSearch();
+    if (query.length === 0) {
+      this.state.searchQuery = '';
+      this.state.isSearchPending = false;
+      this.recompute();
+      return;
+    }
+    const debounce = this.debounceMillis();
+    const elapsed = elapsedMillis > 0 ? elapsedMillis : 0;
+    if (elapsed >= debounce) {
+      this.applySearchQuery(query);
+      return;
+    }
+    this.state.isSearchPending = true;
+    this.notify();
+    this.searchTimerId = setTimeout((): void => {
+      this.searchTimerId = -1;
+      this.applySearchQuery(query);
+    }, debounce - elapsed);
+  }
+
+  private debounceMillis(): number {
+    return this.state.searchDebounceMillis > 0 ? this.state.searchDebounceMillis : SEARCH_DEBOUNCE_MILLIS;
+  }
+
+  private applySearchQuery(query: string): void {
+    this.state.searchQuery = query;
+    this.state.pendingSearchQuery = query;
+    this.state.isSearchPending = false;
+    this.recompute();
+  }
+
+  private flushPendingSearch(): void {
+    if (this.searchTimerId >= 0) {
+      this.cancelPendingSearch();
+      if (this.state.pendingSearchQuery.length > 0) {
+        this.applySearchQuery(this.state.pendingSearchQuery);
+      }
+    }
+  }
+
+  private cancelPendingSearch(): void {
+    if (this.searchTimerId >= 0) {
+      clearTimeout(this.searchTimerId);
+      this.searchTimerId = -1;
+    }
+    this.state.isSearchPending = false;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Filter and sort                                                        */
+  /* -------------------------------------------------------------------- */
+
+  async selectArticleFilter(filter: string): Promise<void> {
+    if (!isArticleFilter(filter)) {
+      return;
+    }
+    if (this.state.selectedTab !== TAB_ALL_ARTICLES) {
+      this.state.selectedTab = TAB_ALL_ARTICLES;
+    }
+    this.state.selectedArticleFilter = filter;
+    this.recompute();
+  }
+
+  /** Sort preferences are stored per view, so switching tabs keeps both. */
+  async selectSortMode(mode: number): Promise<void> {
+    if (this.state.selectedTab === TAB_COLLECTIONS) {
+      if (!isSortMode(mode, COLLECTION_SORT_CHOICES)) {
+        return;
+      }
+      this.state.collectionSortMode = mode;
+      await this.preferences.setCollectionSortMode(mode);
+    } else {
+      if (!isSortMode(mode, ARTICLE_SORT_CHOICES)) {
+        return;
+      }
+      this.state.articleSortMode = mode;
+      await this.preferences.setArticleSortMode(mode);
+    }
+    this.recompute();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Selection                                                              */
+  /* -------------------------------------------------------------------- */
+
+  async enterSelectionMode(): Promise<void> {
+    this.state.selectionEnabled = true;
+    this.recompute();
+  }
+
+  async exitSelectionMode(): Promise<void> {
+    this.state.selectionEnabled = false;
+    this.state.selectedRowIds = [];
+    this.recompute();
+  }
+
+  async toggleRowSelection(rowId: number): Promise<void> {
+    if (!this.state.selectionEnabled) {
+      this.state.selectionEnabled = true;
+    }
+    if (this.state.selectedRowIds.indexOf(rowId) >= 0) {
+      this.state.selectedRowIds = this.state.selectedRowIds.filter((id: number): boolean => id !== rowId);
+    } else {
+      const next = copyNumbers(this.state.selectedRowIds);
+      next.push(rowId);
+      this.state.selectedRowIds = next;
+    }
+    this.recompute();
+  }
+
+  async selectNone(): Promise<void> {
+    this.state.selectedRowIds = [];
+    this.recompute();
+  }
+
+  /**
+   * Selects exactly the rows that are on screen right now. Because the rows are
+   * already deduplicated, every logical article contributes a single id and
+   * rows that the current filter hides are never selected.
+   */
+  async selectAllVisibleRows(): Promise<void> {
+    this.state.selectionEnabled = true;
+    const visible = this.state.selectedTab === TAB_COLLECTIONS
+      ? this.state.visibleCollectionRowIds
+      : this.state.visibleArticleRowIds;
+    this.state.selectedRowIds = copyNumbers(visible);
+    this.recompute();
+  }
+
+  selectedRowCount(): number {
+    return this.state.selectedRowIds.length;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Save / unsave                                                          */
+  /* -------------------------------------------------------------------- */
+
+  /**
+   * Opens the save-article sheet for an article.
+   *
+   * Redirect metadata is resolved first, but only when the device can reach the
+   * API: an offline or failing lookup leaves the original language and API title
+   * as the identity that gets persisted. Opening the sheet always guarantees the
+   * article is saved.
+   */
+  async openSaveArticleSheet(): Promise<void> {
+    const requested = this.takePendingPageTitle();
+    const metadata = await this.environment.resolveRedirectMetadata(requested);
+    let identity = requested;
+    if (metadata !== undefined) {
+      identity = new PageTitle(requested.languageCode, metadata.to, '');
+    }
+
+    const saved = this.pagesDao.saveToDefaultCollection(identity);
+    if (!saved.applied) {
+      this.showFeedback(saved.message, FEEDBACK_SEVERITY_WARNING, FEEDBACK_ACTION_DISMISS);
+    } else {
+      this.markLocalChange(1);
+    }
+
+    const sheet = new SaveArticleSheetState(identity);
+    sheet.isSaved = this.pagesDao.isSaved(identity.identity);
+    this.state.saveSheet = sheet;
+    this.refreshSheetOptions(sheet);
+    this.recompute();
+  }
+
+  async dismissSaveArticleSheet(): Promise<void> {
+    this.state.saveSheet = null;
+    this.queuedToggle = null;
+    this.notify();
+  }
+
+  /** Applies the checkbox of a collection row rendered inside the sheet. */
+  async toggleSheetCollection(listId: number): Promise<void> {
+    const sheet = this.state.saveSheet;
+    if (sheet === null) {
+      return;
+    }
+    const change = this.pagesDao.toggleCollection(listId, PageTitle.fromIdentity(sheet.article));
+    this.reportMembershipChange(change);
+  }
+
+  /**
+   * Removes the article from every collection. Confirmation is required as soon
+   * as one containing collection is user created.
+   */
+  async requestUnsave(): Promise<void> {
+    const sheet = this.state.saveSheet;
+    if (sheet === null) {
+      return;
+    }
+    const named = this.pagesDao.nonDefaultMembershipsOf(sheet.article);
+    if (named.length > 0) {
+      sheet.pendingConfirmation = true;
+      sheet.confirmationCollections = copyStrings(named);
+      this.refreshSheetOptions(sheet);
+      this.notify();
+      return;
+    }
+    await this.performUnsave(sheet.article);
+  }
+
+  /**
+   * Cancels the destructive confirmation. No membership is touched: the
+   * confirmation only ever asked a question.
+   */
+  async cancelUnsaveConfirmation(): Promise<void> {
+    const sheet = this.state.saveSheet;
+    if (sheet === null || !sheet.pendingConfirmation) {
+      return;
+    }
+    sheet.pendingConfirmation = false;
+    sheet.confirmationCollections = [];
+    this.refreshSheetOptions(sheet);
+    this.notify();
+  }
+
+  /** Confirms the destructive path: every membership goes away. */
+  async confirmUnsave(): Promise<void> {
+    const sheet = this.state.saveSheet;
+    if (sheet === null || !sheet.pendingConfirmation) {
+      return;
+    }
+    const identity = sheet.article;
+    sheet.pendingConfirmation = false;
+    sheet.confirmationCollections = [];
+    await this.performUnsave(identity);
+  }
+
+  private async performUnsave(identity: string): Promise<void> {
+    const removed = this.pagesDao.removeEveryMembership(identity);
+    const sheet = this.state.saveSheet;
+    if (sheet !== null) {
+      sheet.isSaved = false;
+      this.refreshSheetOptions(sheet);
+    }
+    this.showFeedback('Removed from all collections (' + String(removed) + ')', FEEDBACK_SEVERITY_INFO,
+      FEEDBACK_ACTION_DISMISS);
+    this.recompute();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Collection membership from the sheet                                   */
+  /* -------------------------------------------------------------------- */
+
+  async createCollectionFromSheet(title: string): Promise<RoomListEntity | undefined> {
+    const creation: CollectionCreation = await this.createCollection(title, '');
+    if (creation.created !== undefined) {
+      const sheet = this.state.saveSheet;
+      if (sheet !== null) {
+        sheet.limitMessage = '';
+        sheet.creatingCollection = false;
+        sheet.newCollectionTitle = '';
+      }
+      this.recompute();
+    }
+    return creation.created;
+  }
+
+  /**
+   * Creates a user collection. Limits are checked before anything is written,
+   * so a refused creation leaves every existing collection untouched.
+   */
+  async createCollection(title: string, description: string): Promise<CollectionCreation> {
+    const creation: CollectionCreation = this.listsDao.createCollection(title, description);
+    if (creation.created === undefined) {
+      const message: string = creation.message.length > 0 ? creation.message : 'Could not create the collection';
+      const sheet = this.state.saveSheet;
+      if (sheet !== null) {
+        sheet.limitMessage = message;
+      }
+      this.showFeedback(message, FEEDBACK_SEVERITY_WARNING, FEEDBACK_ACTION_DISMISS);
+      this.notify();
+    }
+    return creation;
+  }
+
+  async addArticleToCollection(listId: number, identity: string): Promise<boolean> {
+    const change = this.pagesDao.addToCollection(listId, PageTitle.fromIdentity(identity));
+    return this.reportMembershipChange(change);
+  }
+
+  async removeArticleFromCollection(listId: number, identity: string): Promise<boolean> {
+    const removed = this.pagesDao.removeFromCollection(listId, identity);
+    this.refreshSheetOptions(this.state.saveSheet);
+    this.recompute();
+    return removed;
+  }
+
+  /**
+   * Applies a collection toggle that a rendered sheet row queued. When the
+   * collection disappeared in the meantime the operation exits without touching
+   * any other collection.
+   */
+  async resumeQueuedCollectionToggle(): Promise<void> {
+    const queued = this.queuedToggle;
+    if (queued === null) {
+      return;
+    }
+    const list = this.listsDao.listById(queued.collectionId);
+    if (list === undefined) {
+      this.queuedToggle = null;
+      this.showFeedback('That collection is no longer available', FEEDBACK_SEVERITY_WARNING,
+        FEEDBACK_ACTION_DISMISS);
+      this.refreshSheetOptions(this.state.saveSheet);
+      this.notify();
+      return;
+    }
+    const article = queued.article.length > 0 ? queued.article : this.sheetArticleIdentity();
+    const change = this.pagesDao.toggleCollection(list.id, PageTitle.fromIdentity(article));
+    this.queuedToggle = null;
+    this.reportMembershipChange(change);
+  }
+
+  private reportMembershipChange(change: MembershipChange): boolean {
+    if (!change.applied && change.reason === 'MISSING_COLLECTION') {
+      this.showFeedback('That collection is no longer available', FEEDBACK_SEVERITY_WARNING,
+        FEEDBACK_ACTION_DISMISS);
+      this.refreshSheetOptions(this.state.saveSheet);
+      this.notify();
+      return false;
+    }
+    if (!change.applied) {
+      this.showFeedback(change.message, FEEDBACK_SEVERITY_WARNING, FEEDBACK_ACTION_DISMISS);
+      const sheet = this.state.saveSheet;
+      if (sheet !== null) {
+        sheet.limitMessage = change.message;
+      }
+      this.refreshSheetOptions(sheet);
+      this.notify();
+      return false;
+    }
+    if (change.reason === 'REMOVED') {
+      this.markLocalChange(-1);
+    } else {
+      this.markLocalChange(1);
+    }
+    this.refreshSheetOptions(this.state.saveSheet);
+    this.recompute();
+    return true;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Deletion and undo                                                      */
+  /* -------------------------------------------------------------------- */
+
+  /** Queues the selected rows for deletion; the rows vanish from the surface. */
+  async deleteSelectedRows(): Promise<void> {
+    this.commitPendingUndo();
+    if (this.state.selectedTab === TAB_COLLECTIONS) {
+      await this.queueSelectedCollectionsForDeletion();
+      return;
+    }
+    const undo = new PendingUndo();
+    const rows = this.state.selectedArticleRows();
+    for (let index = 0; index < rows.length; index++) {
+      const identity = rows[index].article;
+      undo.articleIdentities.push(identity);
+      const pageIds = this.pagesDao.queueForDeletion([identity]);
+      for (let inner = 0; inner < pageIds.length; inner++) {
+        if (undo.articlePageIds.indexOf(pageIds[inner]) < 0) {
+          undo.articlePageIds.push(pageIds[inner]);
+        }
+      }
+    }
+    this.pendingUndo = undo.isEmpty() ? null : undo;
+    this.state.selectedRowIds = [];
+    this.showUndoFeedback('Removed ' + String(rows.length) + ' article(s)');
+    this.recompute();
+  }
+
+  private async queueSelectedCollectionsForDeletion(): Promise<void> {
+    const undo = new PendingUndo();
+    const rows = this.state.selectedCollectionRows();
+    for (let index = 0; index < rows.length; index++) {
+      const queued = this.listsDao.queueCollectionForDeletion(rows[index].id);
+      if (queued !== undefined) {
+        undo.collectionIds.push(queued.id);
+      }
+    }
+    this.pendingUndo = undo.isEmpty() ? null : undo;
+    this.state.selectedRowIds = [];
+    this.showUndoFeedback('Removed ' + String(undo.collectionIds.length) + ' collection(s)');
+    this.recompute();
+  }
+
+  /** Deletes a collection by identifier; the default collection is protected. */
+  async deleteCollection(listId: number): Promise<boolean> {
+    this.commitPendingUndo();
+    const existing: RoomListEntity | undefined = this.listsDao.listById(listId);
+    if (existing === undefined) {
+      this.showFeedback('That collection is no longer available', FEEDBACK_SEVERITY_WARNING,
+        FEEDBACK_ACTION_DISMISS);
+      this.notify();
+      return false;
+    }
+    if (!existing.isDeletable()) {
+      this.showFeedback('The default collection cannot be deleted', FEEDBACK_SEVERITY_WARNING,
+        FEEDBACK_ACTION_DISMISS);
+      this.notify();
+      return false;
+    }
+    const queued = this.listsDao.queueCollectionForDeletion(listId);
+    if (queued === undefined) {
+      this.showFeedback('The default collection cannot be deleted', FEEDBACK_SEVERITY_WARNING,
+        FEEDBACK_ACTION_DISMISS);
+      this.notify();
+      return false;
+    }
+    const undo = new PendingUndo();
+    undo.collectionIds.push(queued.id);
+    this.pendingUndo = undo;
+    this.showUndoFeedback('Removed collection "' + queued.title + '"');
+    this.recompute();
+    return true;
+  }
+
+  /** Restores queued article memberships. Row ids may change, identity does not. */
+  async undoArticleDeletion(): Promise<void> {
+    const undo = this.pendingUndo;
+    if (undo === null) {
+      return;
+    }
+    if (undo.articlePageIds.length > 0) {
+      this.pagesDao.restoreQueued(undo.articlePageIds);
+    }
+    for (let index = 0; index < undo.collectionIds.length; index++) {
+      this.listsDao.restoreCollection(undo.collectionIds[index]);
+    }
+    this.pendingUndo = null;
+    this.hideFeedback();
+    this.recompute();
+  }
+
+  async undoCollectionDeletion(): Promise<void> {
+    await this.undoArticleDeletion();
+  }
+
+  /** Generic undo entry point shared by the undo snackbar. */
+  async undoLastAction(): Promise<void> {
+    await this.undoArticleDeletion();
+  }
+
+  /**
+   * The undo window stays open until the reader performs another destructive
+   * action; after that the queued rows are removed for good.
+   */
+  private commitPendingUndo(): void {
+    const undo = this.pendingUndo;
+    if (undo === null) {
+      return;
+    }
+    if (undo.articlePageIds.length > 0) {
+      this.database.hardDeletePages(undo.articlePageIds);
+    }
+    for (let index = 0; index < undo.collectionIds.length; index++) {
+      this.listsDao.deleteCollection(undo.collectionIds[index]);
+    }
+    this.pendingUndo = null;
+  }
+
+  private queuedArticleIds(): number[] {
+    if (this.pendingUndo !== null) {
+      return copyNumbers(this.pendingUndo.articlePageIds);
+    }
+    const queued = this.database.queuedPages();
+    const ids: number[] = [];
+    for (let index = 0; index < queued.length; index++) {
+      ids.push(queued[index].id);
+    }
+    return ids;
+  }
+
+  private queuedCollectionIds(): number[] {
+    const ids: number[] = [];
+    const projected = this.listsWithPages.getValue();
+    for (let index = 0; index < projected.length; index++) {
+      const total = this.database.pagesForList(projected[index].list.id).length;
+      if (total > projected[index].pages.length) {
+        ids.push(projected[index].list.id);
+      }
+    }
+    return ids;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Session                                                                */
+  /* -------------------------------------------------------------------- */
+
+  async onLoginEvent(userName: string, temporary: boolean): Promise<void> {
+    this.session.applyLogin(userName, temporary);
+    this.state.account = this.session.snapshot();
+    this.state.loginPromptVisible = false;
+    this.resolveOnboarding();
+    await this.environment.logEvent('login', [TAB_ALL_ARTICLES, TAB_COLLECTIONS]);
+    this.recompute();
+  }
+
+  async logout(): Promise<void> {
+    this.session.applyLogout();
+    this.state.account = this.session.snapshot();
+    this.resolveOnboarding();
+    this.showFeedback('Signed out. Reading lists stay on this device.', FEEDBACK_SEVERITY_INFO,
+      FEEDBACK_ACTION_DISMISS);
+    this.recompute();
+  }
+
+  async onSharedCollectionReceived(title: string): Promise<void> {
+    this.session.applySharedCollection(title);
+    this.state.sharedCollectionTitle = title;
+    this.resolveOnboarding();
+    this.showFeedback('Added shared collection "' + title + '"', FEEDBACK_SEVERITY_INFO,
+      FEEDBACK_ACTION_DISMISS);
+    this.recompute();
+  }
+
+  private resolveOnboarding(): void {
+    if (this.session.sharedCollectionCount() > 0 && this.state.sharedCollectionTitle.length > 0) {
+      this.state.onboarding = ONBOARDING_SHARED_COLLECTION;
+      return;
+    }
+    if (this.state.loginPromptVisible || (!this.session.isLoggedIn() && this.state.refreshAttempts > 0)) {
+      this.state.onboarding = ONBOARDING_LOGIN_REMINDER;
+      return;
+    }
+    if (this.session.isSyncEnabled() && this.session.isSyncEligible()
+      && this.state.articleRows.length > 0 && this.state.syncCompletedCount === 0) {
+      this.state.onboarding = ONBOARDING_SYNC_REMINDER;
+      return;
+    }
+    this.state.onboarding = this.forcedOnboarding;
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Pull to refresh                                                        */
+  /* -------------------------------------------------------------------- */
+
+  /**
+   * Pull to refresh.
+   *
+   * An ineligible account returns to idle immediately and shows a login prompt
+   * without dispatching any synchronisation. An eligible account starts
+   * synchronisation and stays refreshing until the sync completion event
+   * arrives; membership changes applied in the meantime are projected right
+   * away, even while the spinner is still running.
+   */
+  async pullToRefresh(): Promise<void> {
+    this.state.isRefreshing = true;
+    this.state.lastRefreshOutcome = REFRESH_OUTCOME_REFRESHING;
+    this.state.loginPromptVisible = false;
+    this.state.refreshAttempts = this.state.refreshAttempts + 1;
+    this.notify();
+
+    if (!this.session.isSyncEligible()) {
+      this.state.isRefreshing = false;
+      this.state.syncInFlight = false;
+      this.state.loginPromptVisible = true;
+      this.state.lastRefreshOutcome = REFRESH_OUTCOME_LOGIN_PROMPT;
+      this.resolveOnboarding();
+      this.notify();
+      return;
+    }
+
+    this.state.syncInFlight = true;
+    const request = new ReadingListSyncRequest(this.localChangeCount > 0, true, this.state.refreshAttempts);
+    const response = await this.environment.startReadingListSync(request);
+    this.state.syncStartedCount = this.state.syncStartedCount + 1;
+    if (!response.completed) {
+      this.state.syncInFlight = false;
+      this.state.isRefreshing = false;
+      this.state.lastRefreshOutcome = REFRESH_OUTCOME_SYNC_FAILED;
+      this.showFeedback('Reading list sync failed: ' + response.exception, FEEDBACK_SEVERITY_ERROR,
+        FEEDBACK_ACTION_DISMISS);
+      this.notify();
+      return;
+    }
+
+    this.state.lastRefreshOutcome = REFRESH_OUTCOME_SYNC_STARTED;
+    this.applyRemoteSync();
+    this.notify();
+
+    if (this.syncCompletion === SYNC_COMPLETION_HELD) {
+      return;
+    }
+    await this.onReadingListSyncEvent(SYNC_EVENT_COMPLETED);
+  }
+
+  /** Applies the memberships synchronisation pushed before completing. */
+  private applyRemoteSync(): void {
+    const additions = this.remoteSyncAdds;
+    this.remoteSyncAdds = [];
+    for (let index = 0; index < additions.length; index++) {
+      const addition = additions[index];
+      const pageTitle = PageTitle.fromIdentity(addition.article);
+      this.pagesDao.saveToDefaultCollection(pageTitle);
+      for (let inner = 0; inner < addition.collections.length; inner++) {
+        const list = this.listsDao.listByTitle(addition.collections[inner]);
+        if (list !== undefined) {
+          this.pagesDao.addToCollection(list.id, pageTitle);
+        }
+      }
+    }
+    if (additions.length > 0) {
+      this.recompute();
+    }
+  }
+
+  /** Completion notification of the synchronisation service. */
+  async onReadingListSyncEvent(event: string): Promise<void> {
+    if (event !== SYNC_EVENT_COMPLETED && event !== SYNC_EVENT_FAILED) {
+      return;
+    }
+    this.state.syncInFlight = false;
+    this.state.isRefreshing = false;
+    if (event === SYNC_EVENT_COMPLETED) {
+      this.state.syncCompletedCount = this.state.syncCompletedCount + 1;
+      this.state.lastRefreshOutcome = REFRESH_OUTCOME_SYNC_COMPLETED;
+      this.localChangeCount = 0;
+      await this.environment.reportSyncEvent(true, '', [TAB_ALL_ARTICLES, TAB_COLLECTIONS]);
+    } else {
+      this.state.lastRefreshOutcome = REFRESH_OUTCOME_SYNC_FAILED;
+      await this.environment.reportSyncEvent(false, 'sync_failed', [TAB_ALL_ARTICLES, TAB_COLLECTIONS]);
+    }
+    this.resolveOnboarding();
+    this.recompute();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Offline media                                                          */
+  /* -------------------------------------------------------------------- */
+
+  setArticleOffline(identity: string, offline: boolean): void {
+    this.mediaStatus.setOffline(identity, offline);
+    this.recompute();
+  }
+
+  setDownloadProgress(identity: string, fraction: number): void {
+    this.mediaStatus.setDownloadProgress(identity, fraction);
+    this.recompute();
+  }
+
+  private refreshMediaStatus(): void {
+    const records = this.pagesDao.logicalArticles();
+    const identities: string[] = [];
+    for (let index = 0; index < records.length; index++) {
+      identities.push(records[index].identity);
+    }
+    this.mediaStatus.retainOnly(identities);
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Feedback                                                               */
+  /* -------------------------------------------------------------------- */
+
+  private showUndoFeedback(message: string): void {
+    this.showFeedback(message, FEEDBACK_SEVERITY_INFO, FEEDBACK_ACTION_UNDO);
+  }
+
+  private showFeedback(message: string, severity: string, actionLabel: string): void {
+    if (message.length === 0) {
+      return;
+    }
+    this.state.feedback.visible = true;
+    this.state.feedback.message = message;
+    this.state.feedback.severity = severity;
+    this.state.feedback.actionLabel = actionLabel;
+    this.notify();
+  }
+
+  hideFeedback(): void {
+    this.state.feedback.visible = false;
+    this.state.feedback.message = '';
+    this.state.feedback.actionLabel = FEEDBACK_ACTION_DISMISS;
+    this.notify();
+  }
+
+  /* -------------------------------------------------------------------- */
+  /* Projection                                                             */
+  /* -------------------------------------------------------------------- */
+
+  private projectArticleRows(): SavedArticleRow[] {
+    const records = this.pagesDao.logicalArticles();
+    const defaultTitle = this.pagesDao.defaultTitle();
+    const query = SavedTextSearch.prepareQuery(this.state.searchQuery);
+    const rows: SavedArticleRow[] = [];
+    for (let index = 0; index < records.length; index++) {
+      const record: SavedArticleRecord = records[index];
+      if (!this.passesArticleFilter(record, defaultTitle)) {
+        continue;
+      }
+      if (query.length > 0 && !this.matchesArticleQuery(record, query)) {
+        continue;
+      }
+      const row = new SavedArticleRow(record.rowId, record.pageTitle, record.collections,
+        record.onlyInDefaultCollection(defaultTitle), record.addedAt, record.updatedAt);
+      row.isOffline = this.mediaStatus.isOffline(record.identity);
+      row.downloadProgress = this.mediaStatus.downloadProgress(record.identity);
+      row.selected = this.state.selectedRowIds.indexOf(row.id) >= 0;
+      rows.push(row);
+    }
+    this.sortArticleRows(rows);
+    return rows;
+  }
+
+  /**
+   * The filter inspects the complete set of containing collections of the
+   * deduplicated article; an article in any named collection is excluded even
+   * when the default collection also holds it.
+   */
+  private passesArticleFilter(record: SavedArticleRecord, defaultTitle: string): boolean {
+    if (this.state.selectedArticleFilter === ARTICLE_FILTER_NOT_IN_COLLECTION) {
+      return !record.isInNamedCollection(defaultTitle);
+    }
+    return true;
+  }
+
+  /**
+   * The article view matches on the article itself. Collection titles are only
+   * searched on the Collections tab, where they are the row content.
+   */
+  private matchesArticleQuery(record: SavedArticleRecord, query: string): boolean {
+    if (SavedTextSearch.matches(record.pageTitle.displayTitle, query)) {
+      return true;
+    }
+    return SavedTextSearch.matches(record.pageTitle.apiTitle.replace(/_/g, ' '), query);
+  }
+
+  private sortArticleRows(rows: SavedArticleRow[]): void {
+    const mode = this.state.articleSortMode;
+    rows.sort((left: SavedArticleRow, right: SavedArticleRow): number => {
+      if (mode === SORT_BY_NAME_DESC) {
+        return -SavedTextSearch.normalise(right.displayTitle).localeCompare(SavedTextSearch.normalise(left.displayTitle));
+      }
+      if (mode === SORT_BY_DATE_ADDED) {
+        return right.addedAt - left.addedAt;
+      }
+      if (mode === SORT_BY_DATE_LAST_UPDATED) {
+        return right.updatedAt - left.updatedAt;
+      }
+      return SavedTextSearch.normalise(left.displayTitle).localeCompare(SavedTextSearch.normalise(right.displayTitle));
+    });
+  }
+
+  private projectCollectionRows(): SavedCollectionRow[] {
+    const projected = this.listsWithPages.getValue();
+    const query = SavedTextSearch.prepareQuery(this.state.searchQuery);
+    const rows: SavedCollectionRow[] = [];
+    for (let index = 0; index < projected.length; index++) {
+      const list = projected[index].list;
+      if (list.isDefault) {
+        // The default collection is never a user created collection.
+        continue;
+      }
+      if (this.isQueuedForDeletion(list.id, projected[index].pages.length)) {
+        // A collection pending deletion is no longer an active collection.
+        continue;
+      }
+      if (query.length > 0 && !SavedTextSearch.matches(list.title, query)
+        && !SavedTextSearch.matches(list.description, query)) {
+        continue;
+      }
+      const row = new SavedCollectionRow(list.id, list.title, list.description, list.isDefault,
+        projected[index].pages.length);
+      row.offlineArticleCount = this.countOfflineArticles(projected[index]);
+      row.selected = this.state.selectedRowIds.indexOf(row.id) >= 0;
+      rows.push(row);
+    }
+    const mode = this.state.collectionSortMode;
+    rows.sort((left: SavedCollectionRow, right: SavedCollectionRow): number => {
+      if (mode === SORT_BY_NAME_DESC) {
+        return -SavedTextSearch.normalise(right.title).localeCompare(SavedTextSearch.normalise(left.title));
+      }
+      return SavedTextSearch.normalise(left.title).localeCompare(SavedTextSearch.normalise(right.title));
+    });
+    return rows;
+  }
+
+  /**
+   * A collection counts as pending deletion as soon as it holds membership rows
+ * that are not projected any more.
+ */
+private isQueuedForDeletion(listId: number, projectedArticleCount: number): boolean {
+    return this.database.pagesForList(listId).length > projectedArticleCount;
+  }
+
+private countOfflineArticles(withPages: RoomListWithPages): number {
+    let total = 0;
+    for (let index = 0; index < withPages.pages.length; index++) {
+      if (this.mediaStatus.isOffline(withPages.pages[index].identity)) {
+        total = total + 1;
+      }
+    }
+    return total;
+  }
+
+  private refreshSheetOptions(sheet: SaveArticleSheetState | null): void {
+    if (sheet === null) {
+      return;
+    }
+    const projected = this.listsWithPages.getValue();
+    const options: SaveArticleCollectionOption[] = [];
+    for (let index = 0; index < projected.length; index++) {
+      const list = projected[index].list;
+      const checked = this.pagesDao.membershipsOf(sheet.article).indexOf(list.title) >= 0;
+      const option = new SaveArticleCollectionOption(list.id, list.title, list.isDefault, checked);
+      if (!checked) {
+        const decision = SavedLimitPolicy.canAddArticle(projected[index].pages.length);
+        if (!decision.allowed) {
+          option.disabled = true;
+          option.limitReason = decision.reason;
+        }
+      }
+      options.push(option);
+    }
+    options.sort((left: SaveArticleCollectionOption, right: SaveArticleCollectionOption): number => {
+      if (left.isDefault !== right.isDefault) {
+        return left.isDefault ? -1 : 1;
+      }
+      return SavedTextSearch.normalise(left.title).localeCompare(SavedTextSearch.normalise(right.title));
+    });
+    sheet.collections = options;
+    sheet.isSaved = this.pagesDao.isSaved(sheet.article);
+  }
+
+  private sheetArticleIdentity(): string {
+    const sheet = this.state.saveSheet;
+    return sheet !== null ? sheet.article : '';
+  }
+
+  private takePendingPageTitle(): PageTitle {
+    if (this.pendingPageTitle !== null) {
+      const title = this.pendingPageTitle;
+      this.pendingPageTitle = null;
+      return title;
+    }
+    const sheet = this.state.saveSheet;
+    if (sheet !== null) {
+      return new PageTitle(sheet.language, sheet.apiTitle, sheet.displayTitle);
+    }
+    return new PageTitle('', '', '');
+  }
+
+  private dropSelectionOfMissingRows(): void {
+    const visible = this.state.selectedTab === TAB_COLLECTIONS
+      ? this.state.visibleCollectionRowIds
+      : this.state.visibleArticleRowIds;
+    const kept: number[] = [];
+    for (let index = 0; index < this.state.selectedRowIds.length; index++) {
+      if (visible.indexOf(this.state.selectedRowIds[index]) >= 0) {
+        kept.push(this.state.selectedRowIds[index]);
+      }
+    }
+    if (kept.length !== this.state.selectedRowIds.length) {
+      this.state.selectedRowIds = kept;
+    }
+    for (let index = 0; index < this.state.articleRows.length; index++) {
+      this.state.articleRows[index].selected = this.state.selectedRowIds.indexOf(this.state.articleRows[index].id) >= 0;
+    }
+    for (let index = 0; index < this.state.collectionRows.length; index++) {
+      this.state.collectionRows[index].selected = this.state.selectedRowIds.indexOf(this.state.collectionRows[index].id) >= 0;
+    }
+  }
+
+  private resolveEmptyState(): string {
+    if (this.state.isLoading) {
+      return EMPTY_STATE_LOADING;
+    }
+    if (this.state.selectionEnabled && this.state.selectedRowIds.length === 0) {
+      return EMPTY_STATE_NOTHING_SELECTED;
+    }
+    const rowsEmpty = this.state.selectedTab === TAB_COLLECTIONS
+      ? this.state.collectionRows.length === 0
+      : this.state.articleRows.length === 0;
+    if (!rowsEmpty) {
+      return EMPTY_STATE_NONE;
+    }
+    if (this.state.searchQuery.length > 0) {
+      return EMPTY_STATE_SEARCH_NO_RESULTS;
+    }
+    return this.state.selectedTab === TAB_COLLECTIONS ? EMPTY_STATE_NO_COLLECTIONS : EMPTY_STATE_NO_ARTICLES;
+  }
+
+  private resolveMenuActions(): string[] {
+    const actions: string[] = [MENU_ACTION_SELECT, MENU_ACTION_SEARCH, MENU_ACTION_SORT];
+    if (this.state.selectionEnabled) {
+      actions.push(MENU_ACTION_SELECT_ALL);
+      actions.push(MENU_ACTION_SELECT_NONE);
+    }
+    if (this.state.selectedTab === TAB_ALL_ARTICLES) {
+      actions.push(MENU_ACTION_FILTER);
+      actions.push(MENU_ACTION_ADD_TO_COLLECTION);
+      actions.push(MENU_ACTION_REMOVE_FROM_ALL);
+      actions.push(MENU_ACTION_DELETE);
+    } else {
+      actions.push(MENU_ACTION_NEW_COLLECTION);
+      actions.push(MENU_ACTION_DELETE_COLLECTION);
+    }
+    return actions;
+  }
+
+  /** Reads the current session snapshot for the page header. */
+  sessionState(): SavedSession {
+    return this.session;
+  }
+
+  preferencesState(): SavedPreferences {
+    return this.preferences;
+  }
+
+  mediaStatusState(): ArticleMediaStatus {
+    return this.mediaStatus;
+  }
+
+  downloadIdleMarker(): number {
