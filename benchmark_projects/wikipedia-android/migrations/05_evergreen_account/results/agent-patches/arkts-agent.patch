@@ -0,0 +1,318 @@
+/**
+ * Decision engine for the evergreen account-creation encouragement.
+ *
+ * The rules implemented here are the ones described by the product requirement:
+ *
+ *  - the encouragement is only considered once onboarding and every
+ *    higher-priority launch prompt have finished;
+ *  - readers with a permanent account are never prompted (this check happens
+ *    before reading history is queried at all);
+ *  - a permanently dismissed reader is never prompted again;
+ *  - at most {@link EvergreenThresholds.maximumImpressions} ordinary
+ *    impressions are ever shown;
+ *  - the first impression needs two distinct reading days less than a fortnight
+ *    apart whose earlier day is at least a week old, using only the most recent
+ *    year of history;
+ *  - the second impression needs at least two distinct reading days strictly
+ *    after the persisted first-impression day;
+ *  - an unparsable persisted impression day fails closed;
+ *  - an external article deep link never shows the encouragement.
+ *
+ * The function is pure: it neither records impressions nor writes preferences.
+ */
+
+import { EvergreenCalendarDate, formatCalendarDate, formatEpochDay, parseCalendarDate, toEpochDay } from './EvergreenDates';
+import {
+  EVERGREEN_ACCOUNT_REGISTERED,
+  EVERGREEN_LAUNCH_EXTERNAL_ARTICLE,
+  EVERGREEN_LAUNCH_ORDINARY,
+  EvergreenAccountKind,
+  EvergreenLaunchKind
+} from './EvergreenLaunchSnapshot';
+
+export interface EvergreenThresholds {
+  /** Only history from the most recent year is considered. */
+  historyWindowDays: number;
+  /** Number of distinct reading days that make a reader qualify. */
+  minimumDistinctReadingDays: number;
+  /** Exclusive upper bound for the distance between the two qualifying days. */
+  maximumDaysApart: number;
+  /** The earlier qualifying day must be at least this many days old. */
+  minimumEarliestDayAgeDays: number;
+  /** Distinct reading days after the first impression that allow a second one. */
+  minimumReturnReadingDays: number;
+  /** Upper bound of ordinary impressions for the whole lifetime. */
+  maximumImpressions: number;
+}
+
+export const DEFAULT_EVERGREEN_THRESHOLDS: EvergreenThresholds = {
+  historyWindowDays: 365,
+  minimumDistinctReadingDays: 2,
+  maximumDaysApart: 14,
+  minimumEarliestDayAgeDays: 7,
+  minimumReturnReadingDays: 2,
+  maximumImpressions: 2
+};
+
+export const EVERGREEN_REASON_ELIGIBLE_FIRST: string = 'eligible_first_impression';
+export const EVERGREEN_REASON_ELIGIBLE_SECOND: string = 'eligible_second_impression';
+export const EVERGREEN_REASON_EXTERNAL_LINK: string = 'external_article_deep_link';
+export const EVERGREEN_REASON_ONBOARDING: string = 'onboarding_incomplete';
+export const EVERGREEN_REASON_PRIORITY_PROMPT: string = 'higher_priority_prompt_pending';
+export const EVERGREEN_REASON_REGISTERED: string = 'permanent_account_suppressed';
+export const EVERGREEN_REASON_DISMISSED: string = 'permanently_dismissed';
+export const EVERGREEN_REASON_IMPRESSION_LIMIT: string = 'impression_limit_reached';
+export const EVERGREEN_REASON_INVALID_DATE: string = 'invalid_last_impression_date';
+export const EVERGREEN_REASON_STALE_HISTORY: string = 'reading_history_outside_window';
+export const EVERGREEN_REASON_NO_HISTORY: string = 'insufficient_reading_history';
+export const EVERGREEN_REASON_NO_RETURN_DAYS: string = 'insufficient_return_reading_days';
+export const EVERGREEN_REASON_NO_CLOCK: string = 'unavailable_application_clock';
+export const EVERGREEN_REASON_DISABLED: string = 'feature_disabled';
+
+export interface EvergreenEligibilityQuery {
+  account: EvergreenAccountKind;
+  launchType: EvergreenLaunchKind;
+  permanentlyDismissed: boolean;
+  impressions: number;
+  lastImpressionDate: string;
+  /** Every calendar day of the application-owned reading history, including stale rows. */
+  readingDays: string[];
+  today: string;
+  onboardingComplete: boolean;
+  higherPriorityPromptPending: boolean;
+  featureEnabled: boolean;
+}
+
+export interface EvergreenQualifyingPair {
+  earliestDay: string;
+  latestDay: string;
+}
+
+export interface EvergreenEligibilityResult {
+  evaluated: boolean;
+  shouldShow: boolean;
+  reason: string;
+  account: EvergreenAccountKind;
+  accountEligible: boolean;
+  launchType: EvergreenLaunchKind;
+  today: string;
+  impressions: number;
+  maximumImpressions: number;
+  lastImpressionDate: string;
+  permanentlyDismissed: boolean;
+  historyWindowDays: number;
+  historyWindowStart: string;
+  minimumDaysApart: number;
+  minimumEarliestDayAgeDays: number;
+  minimumReturnReadingDays: number;
+  /** Distinct reading days inside the eligibility window, ascending. */
+  readingDaysInWindow: string[];
+  readingDayCount: number;
+  /** Distinct reading days strictly after the persisted impression day. */
+  returnReadingDays: string[];
+  returnReadingDayCount: number;
+  qualifyingDays: number;
+  earliestQualifyingDay: string;
+  latestQualifyingDay: string;
+  onboardingComplete: boolean;
+  higherPriorityPromptPending: boolean;
+  /** False when the decision was taken before the reading history was queried. */
+  historyQueried: boolean;
+}
+
+function distinctDaysInWindow(
+  readingDays: string[], windowStart: number, today: number): string[] {
+  const result: string[] = [];
+  const seen: number[] = [];
+  for (let index = 0; index < readingDays.length; index++) {
+    const parsed: EvergreenCalendarDate | undefined = parseCalendarDate(readingDays[index]);
+    if (parsed === undefined) {
+      continue;
+    }
+    const epoch: number = toEpochDay(parsed);
+    if (epoch < windowStart || epoch > today) {
+      continue;
+    }
+    if (seen.indexOf(epoch) === -1) {
+      seen.push(epoch);
+      result.push(formatCalendarDate(parsed));
+    }
+  }
+  result.sort((left: string, right: string): number => (left < right ? -1 : (left > right ? 1 : 0)));
+  return result;
+}
+
+function emptyResult(
+  query: EvergreenEligibilityQuery, thresholds: EvergreenThresholds, reason: string,
+  shouldShow: boolean, accountEligible: boolean, historyQueried: boolean,
+  daysInWindow: string[], windowStart: number): EvergreenEligibilityResult {
+  return {
+    evaluated: true,
+    shouldShow: shouldShow,
+    reason: reason,
+    account: query.account,
+    accountEligible: accountEligible,
+    launchType: query.launchType,
+    today: query.today,
+    impressions: query.impressions,
+    maximumImpressions: thresholds.maximumImpressions,
+    lastImpressionDate: query.lastImpressionDate,
+    permanentlyDismissed: query.permanentlyDismissed,
+    historyWindowDays: thresholds.historyWindowDays,
+    historyWindowStart: formatEpochDay(windowStart),
+    minimumDaysApart: thresholds.maximumDaysApart,
+    minimumEarliestDayAgeDays: thresholds.minimumEarliestDayAgeDays,
+    minimumReturnReadingDays: thresholds.minimumReturnReadingDays,
+    readingDaysInWindow: daysInWindow,
+    readingDayCount: daysInWindow.length,
+    returnReadingDays: [],
+    returnReadingDayCount: 0,
+    qualifyingDays: 0,
+    earliestQualifyingDay: '',
+    latestQualifyingDay: '',
+    onboardingComplete: query.onboardingComplete,
+    higherPriorityPromptPending: query.higherPriorityPromptPending,
+    historyQueried: historyQueried
+  };
+}
+
+/**
+ * Finds the first pair of reading days that satisfies both time-window
+ * constraints: the days are closer together than the fortnight limit and the
+ * earlier of them is old enough.
+ */
+export function findEvergreenQualifyingPair(
+  daysInWindow: string[], today: number, thresholds: EvergreenThresholds): EvergreenQualifyingPair | undefined {
+  if (daysInWindow.length < thresholds.minimumDistinctReadingDays) {
+    return undefined;
+  }
+  for (let earlier = 0; earlier < daysInWindow.length; earlier++) {
+    const earlierDate: EvergreenCalendarDate | undefined = parseCalendarDate(daysInWindow[earlier]);
+    if (earlierDate === undefined) {
+      continue;
+    }
+    if (today - toEpochDay(earlierDate) < thresholds.minimumEarliestDayAgeDays) {
+      continue;
+    }
+    for (let later = earlier + 1; later < daysInWindow.length; later++) {
+      const laterDate: EvergreenCalendarDate | undefined = parseCalendarDate(daysInWindow[later]);
+      if (laterDate === undefined) {
+        continue;
+      }
+      if (toEpochDay(laterDate) - toEpochDay(earlierDate) < thresholds.maximumDaysApart) {
+        return { earliestDay: daysInWindow[earlier], latestDay: daysInWindow[later] };
+      }
+    }
+  }
+  return undefined;
+}
+
+export function isEvergreenAccountEligible(account: EvergreenAccountKind): boolean {
+  return account !== EVERGREEN_ACCOUNT_REGISTERED;
+}
+
+export function evaluateEvergreenEligibility(
+  query: EvergreenEligibilityQuery, thresholds: EvergreenThresholds): EvergreenEligibilityResult {
+  const accountEligible: boolean = isEvergreenAccountEligible(query.account);
+  const today: EvergreenCalendarDate | undefined = parseCalendarDate(query.today);
+  if (today === undefined) {
+    // Fail closed: without a usable clock no impression can be dated.
+    return emptyResult(query, thresholds, EVERGREEN_REASON_NO_CLOCK, false, accountEligible, false, [],
+      0);
+  }
+  const todayEpoch: number = toEpochDay(today);
+  const windowStart: number = todayEpoch - thresholds.historyWindowDays;
+  const daysInWindow: string[] = distinctDaysInWindow(query.readingDays, windowStart, todayEpoch);
+
+  if (query.launchType === EVERGREEN_LAUNCH_EXTERNAL_ARTICLE) {
+    return emptyResult(query, thresholds, EVERGREEN_REASON_EXTERNAL_LINK, false, accountEligible, false,
+      daysInWindow, windowStart);
+  }
+  if (!query.featureEnabled) {
+    return emptyResult(query, thresholds, EVERGREEN_REASON_DISABLED, false, accountEligible, false,
+      daysInWindow, windowStart);
+  }
+  if (!query.onboardingComplete) {
+    return emptyResult(query, thresholds, EVERGREEN_REASON_ONBOARDING, false, accountEligible, false,
+      daysInWindow, windowStart);
+  }
+  if (query.higherPriorityPromptPending) {
+    return emptyResult(query, thresholds, EVERGREEN_REASON_PRIORITY_PROMPT, false, accountEligible, false,
+      daysInWindow, windowStart);
+  }
+  if (!accountEligible) {
+    // Permanent accounts return before any reading history is queried.
+    return emptyResult(query, thresholds, EVERGREEN_REASON_REGISTERED, false, false, false, [], windowStart);
+  }
+  if (query.permanentlyDismissed) {
+    return emptyResult(query, thresholds, EVERGREEN_REASON_DISMISSED, false, accountEligible, false, [],
+      windowStart);
+  }
+
+  const impressions: number = query.impressions > 0 ? Math.floor(query.impressions) : 0;
+  const knownImpressionQuery: EvergreenEligibilityQuery = {
+    account: query.account, launchType: query.launchType, permanentlyDismissed: query.permanentlyDismissed,
+    impressions: impressions, lastImpressionDate: query.lastImpressionDate, readingDays: query.readingDays,
+    today: query.today, onboardingComplete: query.onboardingComplete,
+    higherPriorityPromptPending: query.higherPriorityPromptPending, featureEnabled: query.featureEnabled
+  };
+
+  if (impressions >= thresholds.maximumImpressions) {
+    return emptyResult(knownImpressionQuery, thresholds, EVERGREEN_REASON_IMPRESSION_LIMIT, false, accountEligible,
+      false, [], windowStart);
+  }
+
+  if (impressions >= 1) {
+    const lastImpression: EvergreenCalendarDate | undefined = parseCalendarDate(query.lastImpressionDate);
+    if (lastImpression === undefined) {
+      // An unparsable persisted day suppresses the repeat prompt; the stored
+      // value is left untouched rather than replaced by a guessed date.
+      return emptyResult(knownImpressionQuery, thresholds, EVERGREEN_REASON_INVALID_DATE, false, accountEligible,
+        false, [], windowStart);
+    }
+    const lastEpoch: number = toEpochDay(lastImpression);
+    const returnDays: string[] = [];
+    for (let index = 0; index < daysInWindow.length; index++) {
+      const day: EvergreenCalendarDate | undefined = parseCalendarDate(daysInWindow[index]);
+      if (day !== undefined && toEpochDay(day) > lastEpoch) {
+        returnDays.push(daysInWindow[index]);
+      }
+    }
+    if (returnDays.length < thresholds.minimumReturnReadingDays) {
+      const suppressed: EvergreenEligibilityResult = emptyResult(knownImpressionQuery, thresholds,
+        EVERGREEN_REASON_NO_RETURN_DAYS, false, accountEligible, true, daysInWindow, windowStart);
+      suppressed.returnReadingDays = returnDays;
+      suppressed.returnReadingDayCount = returnDays.length;
+      return suppressed;
+    }
+    const eligibleSecond: EvergreenEligibilityResult = emptyResult(knownImpressionQuery, thresholds,
+      EVERGREEN_REASON_ELIGIBLE_SECOND, true, accountEligible, true, daysInWindow, windowStart);
+    eligibleSecond.returnReadingDays = returnDays;
+    eligibleSecond.returnReadingDayCount = returnDays.length;
+    eligibleSecond.qualifyingDays = daysInWindow.length;
+    eligibleSecond.earliestQualifyingDay = returnDays[0];
+    eligibleSecond.latestQualifyingDay = returnDays[returnDays.length - 1];
+    return eligibleSecond;
+  }
+
+  const pair: EvergreenQualifyingPair | undefined =
+    findEvergreenQualifyingPair(daysInWindow, todayEpoch, thresholds);
+  if (pair === undefined) {
+    const reason: string = daysInWindow.length === 0 && query.readingDays.length > 0
+      ? EVERGREEN_REASON_STALE_HISTORY
+      : EVERGREEN_REASON_NO_HISTORY;
+    return emptyResult(knownImpressionQuery, thresholds, reason, false, accountEligible, true, daysInWindow,
+      windowStart);
+  }
+  const eligibleFirst: EvergreenEligibilityResult = emptyResult(knownImpressionQuery, thresholds,
+    EVERGREEN_REASON_ELIGIBLE_FIRST, true, accountEligible, true, daysInWindow, windowStart);
+  eligibleFirst.qualifyingDays = daysInWindow.length;
+  eligibleFirst.earliestQualifyingDay = pair.earliestDay;
+  eligibleFirst.latestQualifyingDay = pair.latestDay;
+  return eligibleFirst;
+}
+
+/** Convenience wrapper for the "ordinary launch" question asked by the page owner. */
+export function isOrdinaryEvergreenLaunch(launchType: EvergreenLaunchKind): boolean {
+  return launchType === EVERGREEN_LAUNCH_ORDINARY;
+}
