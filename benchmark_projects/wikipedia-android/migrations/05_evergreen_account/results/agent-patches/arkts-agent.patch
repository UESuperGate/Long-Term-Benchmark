+/**
+ * Normalises everything the application is allowed to know at launch into a
+ * single application-owned snapshot.
+ *
+ * Two sources feed the snapshot:
+ *  - the OpenHarmony launch information produced by `EntryAbility` (ordinary
+ *    launch, external article deep link, onboarding state), and
+ *  - the application-owned stores (reading history rows, saved-item count and
+ *    the `evergreen_account` preference snapshot).
+ *
+ * Nothing here decides anything: the snapshot only describes facts.  All
+ * encouragement policy lives in `EvergreenEligibility`.
+ */
+
+import { EvergreenInput } from '../integration/EvergreenPageIntegration';
+import { EvergreenCalendarDate, normalizeCalendarDay, parseCalendarDate, todayCalendarDay } from './EvergreenDates';
+
+export type EvergreenAccountKind = 'logged_out' | 'temporary' | 'registered';
+
+export type EvergreenLaunchKind = 'ordinary' | 'external_article_deep_link';
+
+export const EVERGREEN_LAUNCH_ORDINARY: EvergreenLaunchKind = 'ordinary';
+export const EVERGREEN_LAUNCH_EXTERNAL_ARTICLE: EvergreenLaunchKind = 'external_article_deep_link';
+
+export const EVERGREEN_ACCOUNT_LOGGED_OUT: EvergreenAccountKind = 'logged_out';
+export const EVERGREEN_ACCOUNT_TEMPORARY: EvergreenAccountKind = 'temporary';
+export const EVERGREEN_ACCOUNT_REGISTERED: EvergreenAccountKind = 'registered';
+
+const MAX_SNAPSHOT_NESTING_DEPTH: number = 3;
+const DATE_ITEM_KEYS: string[] = [
+  'date', 'day', 'localdate', 'historydate', 'readdate', 'visitdate', 'visitedon', 'timestamp', 'time'
+];
+const ACCOUNT_OBJECT_KEYS: string[] = ['registered', 'isregistered', 'hasaccount', 'loggedin', 'haspermanentaccount'];
+const TEMPORARY_OBJECT_KEYS: string[] = ['temporary', 'istemporary', 'tempaccount', 'temp'];
+const ACCOUNT_TYPE_KEYS: string[] = ['type', 'kind', 'state', 'accounttype', 'accountstate', 'accountstatus',
+  'status', 'account'];
+const ACCOUNT_KIND_KEYS: string[] = ['account', 'accounttype', 'accountstate', 'accountstatus', 'accountkind',
+  'account_state'];
+const REGISTERED_TEXT: string[] = ['register', 'permanent', 'user', 'loggedin', 'signedin', 'creator'];
+const LOGGED_OUT_TEXT: string[] = ['loggedout', 'anonymous', 'anon', 'guest', 'signedout', 'unregistered'];
+
+export interface EvergreenLaunchSnapshot {
+  /** Local calendar day used as "now" by the encouragement. */
+  today: string;
+  account: EvergreenAccountKind;
+  launchType: EvergreenLaunchKind;
+  deepLinkUri: string;
+  /** Every calendar day the reader is recorded as having read on. */
+  readingDays: string[];
+  onboardingComplete: boolean;
+  higherPriorityPromptPending: boolean;
+  /** Surface restored from a previously created page, used when the process is recreated. */
+  restoredSurface: string;
+  restoredEncouragementVisible: boolean;
+  /** Persisted encouragement counters taken from the `evergreen_account` preferences. */
+  impressions: number;
+  lastImpressionDate: string;
+  permanentlyDismissed: boolean;
+  /** Saved items ("reading list") count shown on the encouragement screen. */
+  savedCount: number;
+  featureEnabled: boolean;
+}
+
+export function emptyEvergreenLaunchSnapshot(): EvergreenLaunchSnapshot {
+  return {
+    today: todayCalendarDay(),
+    account: EVERGREEN_ACCOUNT_LOGGED_OUT,
+    launchType: EVERGREEN_LAUNCH_ORDINARY,
+    deepLinkUri: '',
+    readingDays: [],
+    onboardingComplete: true,
+    higherPriorityPromptPending: false,
+    restoredSurface: 'main',
+    restoredEncouragementVisible: false,
+    impressions: 0,
+    lastImpressionDate: '',
+    permanentlyDismissed: false,
+    savedCount: 0,
+    featureEnabled: true
+  };
+}
+
+function text(value: Object | undefined): string {
+  return value === undefined || value === null ? '' : String(value);
+}
+
+const TRUE_WORDS: string[] = ['true', '1', 'yes', 'complete', 'completed', 'done', 'finished', 'enabled'];
+const FALSE_WORDS: string[] = ['false', '0', 'no', 'pending', 'incomplete', 'inprogress', 'skipped', 'disabled', ''];
+
+function flag(value: Object | undefined, fallback: boolean): boolean {
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  const raw: string = compactToken(text(value));
+  if (TRUE_WORDS.indexOf(raw) >= 0) {
+    return true;
+  }
+  if (FALSE_WORDS.indexOf(raw) >= 0) {
+    return false;
+  }
+  return fallback;
+}
+
+/** Lower-cased token without separators, so `logged_out` and `loggedOut` match. */
+function compactToken(value: string): string {
+  let token: string = '';
+  for (let index = 0; index < value.length; index++) {
+    const code: number = value.charCodeAt(index);
+    const isDigit: boolean = code >= 48 && code <= 57;
+    const isLetter: boolean = (code >= 97 && code <= 122) || (code >= 65 && code <= 90);
+    if (isDigit || isLetter) {
+      token += value.charAt(index).toLowerCase();
+    }
+  }
+  return token;
+}
+
+function count(value: Object | undefined, fallback: number): number {
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  const parsed: number = Number(text(value));
+  return isFinite(parsed) && parsed >= 0 ? Math.floor(parsed) : fallback;
+}
+
+function record(value: Object | undefined): Record<string, Object> | undefined {
+  if (value === undefined || value === null || typeof value !== 'object' || Array.isArray(value)) {
+    return undefined;
+  }
+  return value as Record<string, Object>;
+}
+
+/**
+ * Case-insensitive field lookup.  Launch information reaches the application
+ * from several places - a `Want`, the persisted preference snapshot and the
+ * runtime snapshot of the page - and the same field is spelled differently in
+ * each of them, so every field is resolved by its name rather than by one
+ * particular spelling.
+ */
+export function lookupValue(recordValue: Record<string, Object> | undefined, key: string): Object | undefined {
+  if (recordValue === undefined) {
+    return undefined;
+  }
+  const direct: Object | undefined = recordValue[key];
+  if (direct !== undefined) {
+    return direct;
+  }
+  const wanted: string = key.toLowerCase();
+  const keys: string[] = Object.keys(recordValue);
+  for (let index = 0; index < keys.length; index++) {
+    if (keys[index].toLowerCase() === wanted) {
+      return recordValue[keys[index]];
+    }
+  }
+  return undefined;
+}
+
+function firstDefined(
+  sources: Array<Record<string, Object> | undefined>, keys: string[]): Object | undefined {
+  for (let index = 0; index < sources.length; index++) {
+    const source: Record<string, Object> | undefined = sources[index];
+    if (source === undefined) {
+      continue;
+    }
+    for (let keyIndex = 0; keyIndex < keys.length; keyIndex++) {
+      const value: Object | undefined = lookupValue(source, keys[keyIndex]);
+      if (value !== undefined && value !== null) {
+        return value;
+      }
+    }
+  }
+  return undefined;
+}
+
+export function parseAccountKind(value: Object | undefined): EvergreenAccountKind {
+  if (value === undefined || value === null) {
+    return EVERGREEN_ACCOUNT_LOGGED_OUT;
+  }
+  if (typeof value === 'object' && !Array.isArray(value)) {
+    const details: Record<string, Object> | undefined = record(value);
+    if (details !== undefined) {
+      for (let index = 0; index < TEMPORARY_OBJECT_KEYS.length; index++) {
+        if (flag(lookupValue(details, TEMPORARY_OBJECT_KEYS[index]), false)) {
+          return EVERGREEN_ACCOUNT_TEMPORARY;
+        }
+      }
+      for (let index = 0; index < ACCOUNT_OBJECT_KEYS.length; index++) {
+        if (flag(lookupValue(details, ACCOUNT_OBJECT_KEYS[index]), false)) {
+          return EVERGREEN_ACCOUNT_REGISTERED;
+        }
+      }
+      for (let index = 0; index < ACCOUNT_TYPE_KEYS.length; index++) {
+        const nested: Object | undefined = lookupValue(details, ACCOUNT_TYPE_KEYS[index]);
+        if (nested !== undefined) {
+          return parseAccountKind(nested);
+        }
+      }
+    }
+    return EVERGREEN_ACCOUNT_LOGGED_OUT;
+  }
+  const raw: string = compactToken(text(value).trim());
+  if (raw === '1') {
+    return EVERGREEN_ACCOUNT_TEMPORARY;
+  }
+  if (raw === '2') {
+    return EVERGREEN_ACCOUNT_REGISTERED;
+  }
+  if (raw.length === 0) {
+    return EVERGREEN_ACCOUNT_LOGGED_OUT;
+  }
+  if (raw.includes('temp')) {
+    return EVERGREEN_ACCOUNT_TEMPORARY;
+  }
+  for (let index = 0; index < LOGGED_OUT_TEXT.length; index++) {
+    if (raw.includes(LOGGED_OUT_TEXT[index])) {
+      return EVERGREEN_ACCOUNT_LOGGED_OUT;
+    }
+  }
+  for (let index = 0; index < REGISTERED_TEXT.length; index++) {
+    if (raw.includes(REGISTERED_TEXT[index])) {
+      return EVERGREEN_ACCOUNT_REGISTERED;
+    }
+  }
+  return EVERGREEN_ACCOUNT_LOGGED_OUT;
+}
+
+export function parseLaunchKind(value: Object | undefined): EvergreenLaunchKind {
+  const raw: string = text(value).trim().toLowerCase();
+  if (raw.length === 0) {
+    return EVERGREEN_LAUNCH_ORDINARY;
+  }
+  if (raw.includes('deep') || raw.includes('external') || raw.includes('browsable')
+    || raw.includes('view') || raw.includes('scheme')) {
+    return EVERGREEN_LAUNCH_EXTERNAL_ARTICLE;
+  }
+  return EVERGREEN_LAUNCH_ORDINARY;
+}
+
+function readingDayFromItem(item: Object): string {
+  if (typeof item !== 'object' || item === null) {
+    return normalizeCalendarDay(text(item));
+  }
+  const details: Record<string, Object> | undefined = record(item);
+  if (details === undefined) {
+    return '';
+  }
+  for (let index = 0; index < DATE_ITEM_KEYS.length; index++) {
+    const candidate: string = normalizeCalendarDay(text(details[DATE_ITEM_KEYS[index]]));
+    if (candidate.length > 0) {
+      return candidate;
+    }
+  }
+  return '';
+}
+
+/**
+ * Collects every calendar day recorded in the application-owned reading
+ * history.  History rows are kept as they were produced: stale rows are not
+ * discarded here, the eligibility query decides which of them are inside the
+ * time window.
+ */
+function collectReadingDays(source: Record<string, Object> | undefined, into: string[], depth: number): void {
+  if (source === undefined || depth < 0) {
+    return;
+  }
+  const keys: string[] = Object.keys(source);
+  for (let index = 0; index < keys.length; index++) {
+    const value: Object | undefined = source[keys[index]];
+    if (value === undefined || value === null) {
+      continue;
+    }
+    if (Array.isArray(value)) {
+      const items: Object[] = value as Object[];
+      for (let item = 0; item < items.length; item++) {
+        const day: string = readingDayFromItem(items[item]);
+        if (day.length > 0) {
+          into.push(day);
+        }
+      }
+    } else if (typeof value === 'object') {
+      collectReadingDays(value as Record<string, Object>, into, depth - 1);
+    }
+  }
+}
+
+export function readingDaysOf(sources: Array<Record<string, Object> | undefined>): string[] {
+  const collected: string[] = [];
+  for (let index = 0; index < sources.length; index++) {
+    collectReadingDays(sources[index], collected, MAX_SNAPSHOT_NESTING_DEPTH);
+  }
+  return collected;
+}
+
+function launchUriOf(sources: Array<Record<string, Object> | undefined>): string {
+  const raw: Object | undefined = firstDefined(sources, ['uri', 'deeplink', 'deeplinkuri', 'targeturi', 'url']);
+  return text(raw).trim();
+}
+
+/**
+ * Launch information may arrive as `launch: 'ordinary'`,
+ * `launch: { type, uri }` or as separate `launchType` / `uri` fields.  All of
+ * them are folded into one ordered list of records, the most specific first.
+ */
+export function launchSources(
+  state: Record<string, Object> | undefined,
+  persistence?: Record<string, Object> | undefined): Array<Record<string, Object> | undefined> {
+  const sources: Array<Record<string, Object> | undefined> = [];
+  if (state === undefined) {
+    return sources;
+  }
+  const entry: Object | undefined = lookupValue(state, 'launch');
+  if (entry !== undefined && entry !== null) {
+    if (typeof entry === 'object' && !Array.isArray(entry)) {
+      sources.push(entry as Record<string, Object>);
+    } else {
+      const described: Record<string, Object> = {};
+      described['type'] = String(entry);
+      sources.push(described);
+    }
+  }
+  sources.push(state);
+  if (persistence !== undefined) {
+    sources.push(persistence);
+  }
+  return sources;
+}
+
+function launchTypeOf(sources: Array<Record<string, Object> | undefined>): EvergreenLaunchKind {
+  const raw: Object | undefined = firstDefined(sources, ['type', 'launchtype', 'intent', 'action']);
+  const kind: EvergreenLaunchKind = parseLaunchKind(raw);
+  if (kind === EVERGREEN_LAUNCH_ORDINARY && launchUriOf(sources).length > 0) {
+    return EVERGREEN_LAUNCH_EXTERNAL_ARTICLE;
+  }
+  return kind;
+}
+
+function restoredVisibilityOf(sources: Array<Record<string, Object> | undefined>): boolean {
+  const visible: Object | undefined = firstDefined(
+    sources, ['accountencouragementvisible', 'visible', 'encouragementvisible', 'isshown', 'shown']);
+  if (visible !== undefined) {
+    return flag(visible, false);
+  }
+  return false;
+}
+
+function restoredSurfaceOf(sources: Array<Record<string, Object> | undefined>, visible: boolean): string {
+  const raw: string = text(firstDefined(sources, ['surface', 'screensurface', 'destination'])).trim().toLowerCase();
+  if (raw.length > 0) {
+    return raw;
+  }
+  return visible ? 'account_encouragement' : 'main';
+}
+
+/**
+ * Builds the launch snapshot from the input handed to the page owner plus the
+ * persisted `evergreen_account` preference snapshot.
+ */
+export function buildEvergreenLaunchSnapshot(input: EvergreenInput | undefined): EvergreenLaunchSnapshot {
+  const snapshot: EvergreenLaunchSnapshot = emptyEvergreenLaunchSnapshot();
+  if (input === undefined) {
+    return snapshot;
+  }
+  const state: Record<string, Object> | undefined = record(input.state);
+  const persistence: Record<string, Object> | undefined = record(input.persistence);
+
+  // The base store keeps a JSON copy of the preference snapshot under `snapshot`;
+  // it is only used as a fallback when individual keys are missing.
+  const archive: Record<string, Object> | undefined = persistence === undefined
+    ? undefined
+    : readArchivedSnapshot(text(lookupValue(persistence, 'snapshot')));
+
+  // Runtime facts are read from the page input first and from the persisted
+  // preference snapshot second, so the same description of the reader works no
+  // matter which record describes it.
+  const facts: Array<Record<string, Object> | undefined> = [state, persistence, archive];
+
+  snapshot.account = parseAccountKind(firstDefined(facts, ACCOUNT_KIND_KEYS.concat(ACCOUNT_TYPE_KEYS)));
+
+  const clock: string = text(firstDefined(facts, ['clockdate', 'today', 'currentdate', 'now', 'date']));
+  snapshot.today = clock.length > 0 && parseCalendarDate(clock.substring(0, 10)) !== undefined
+    ? normalizeCalendarDay(clock)
+    : todayCalendarDay();
+
+  const launchSource: Array<Record<string, Object> | undefined> = launchSources(state, persistence);
+  snapshot.launchType = launchTypeOf(launchSource);
+  snapshot.deepLinkUri = launchUriOf(launchSource);
+
+  snapshot.readingDays = readingDaysOf([state, persistence, archive]);
+
+  snapshot.onboardingComplete = flag(
+    firstDefined(facts, ['onboardingcomplete', 'hascompletedonboarding', 'onboarding', 'onboarded', 'onboardingdone']),
+    true);
+  snapshot.higherPriorityPromptPending = flag(
+    firstDefined(facts,
+      ['higherprioritypromptpending', 'pendinglaunchprompt', 'higherpriorityprompt', 'pendingprompt', 'launchprompt']),
+    false);
+  snapshot.featureEnabled = flag(
+    firstDefined(facts,
+      ['evergreenaccountenabled', 'evergreenenabled', 'featureenabled', 'evergreenfeatureenabled', 'featureavailable']),
+    true);
+
+  snapshot.restoredEncouragementVisible = restoredVisibilityOf(facts);
+  snapshot.restoredSurface = restoredSurfaceOf(facts, snapshot.restoredEncouragementVisible);
+
+  const persistedSource: Array<Record<string, Object> | undefined> = [persistence, state, archive];
+  snapshot.impressions = count(
+    firstDefined(persistedSource, ['impressions', 'impressioncount', 'impressioncounter', 'showncount']), 0);
+  snapshot.lastImpressionDate = text(
+    firstDefined(persistedSource, ['lastimpressiondate', 'lastshown', 'lastimpression', 'lastimpressionday']));
+  snapshot.permanentlyDismissed = flag(
+    firstDefined(persistedSource,
+      ['permanentlydismissed', 'permanentdismissal', 'dismissed', 'optout', 'optedout']),
+    false);
+  snapshot.savedCount = count(
+    firstDefined([state, archive], ['savedcount', 'readinglistcount', 'bookmarkcount', 'saved', 'readinglist']),
+    count(firstDefined([persistence], ['savedcount']), 0));
+  return snapshot;
+}
+
+function readArchivedSnapshot(raw: string): Record<string, Object> | undefined {
+  const trimmed: string = raw.trim();
+  if (trimmed.length === 0) {
+    return undefined;
+  }
+  try {
+    const parsed: Object = JSON.parse(trimmed) as Object;
+    return record(parsed);
+  } catch (error) {
+    return undefined;
+  }
+}
+
+/** Reads the launch information carried by an OpenHarmony `Want`. */
+export function launchSnapshotFromWant(want: Object | undefined): EvergreenLaunchSnapshot {
+  const snapshot: EvergreenLaunchSnapshot = emptyEvergreenLaunchSnapshot();
+  if (want === undefined || want === null) {
+    return snapshot;
+  }
+  const details: Record<string, Object> | undefined = record(want);
+  if (details === undefined) {
+    return snapshot;
+  }
+  const uri: string = text(lookupValue(details, 'uri')).trim();
+  if (uri.length > 0) {
+    snapshot.launchType = EVERGREEN_LAUNCH_EXTERNAL_ARTICLE;
+    snapshot.deepLinkUri = uri;
+  } else {
+    snapshot.launchType = parseLaunchKind(firstDefined([details], ['launchtype', 'action']));
+  }
+  const parameters: Record<string, Object> | undefined = record(lookupValue(details, 'parameters'));
+  if (parameters !== undefined) {
+    const accountValue: Object | undefined = firstDefined([parameters], ACCOUNT_KIND_KEYS.concat(ACCOUNT_TYPE_KEYS));
+    if (accountValue !== undefined) {
+      snapshot.account = parseAccountKind(accountValue);
+    }
+    snapshot.featureEnabled = flag(firstDefined([parameters],
+      ['evergreenaccountenabled', 'evergreenenabled', 'featureenabled']), snapshot.featureEnabled);
+  }
+  return snapshot;
+}
+
+/** True when the encouragement screen is currently the restored destination. */
+export function restoredEncouragementSurface(snapshot: EvergreenLaunchSnapshot): boolean {
+  const surface: string = snapshot.restoredSurface.toLowerCase();
+  return surface.includes('account') || surface.includes('encourage') || surface.includes('signup')
+    || surface.includes('promo') || surface.includes('login');
+}
+
+export function parsedToday(snapshot: EvergreenLaunchSnapshot): EvergreenCalendarDate | undefined {
+  return parseCalendarDate(snapshot.today);
+}
