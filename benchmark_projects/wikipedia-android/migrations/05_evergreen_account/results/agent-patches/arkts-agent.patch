+/**
+ * Application-owned reading history.
+ *
+ * The encouragement never invents reading activity: it asks this store for the
+ * calendar days on which the reader actually opened articles.  Rows are kept
+ * exactly as they were recorded - including rows older than the eligibility
+ * window, which the eligibility query then filters out.
+ */
+
+import { EvergreenCalendarDate, parseCalendarDate, sortDistinctDays, toEpochDay } from './EvergreenDates';
+
+export interface EvergreenHistoryRow {
+  /** Local calendar day in `YYYY-MM-DD` form. */
+  date: string;
+  /** Number of article reads recorded on that day. */
+  reads: number;
+  /** Titles of the articles read on that day, without duplicates. */
+  articles: string[];
+}
+
+export class EvergreenReadingHistory {
+  private rows: EvergreenHistoryRow[] = [];
+
+  constructor(days: string[] = []) {
+    this.seed(days);
+  }
+
+  /** Installs the days known to the application, one reading day each. */
+  seed(days: string[]): void {
+    this.rows = [];
+    for (let index = 0; index < days.length; index++) {
+      this.recordRead(days[index], '');
+    }
+  }
+
+  recordRead(day: string, article: string): boolean {
+    const parsed: EvergreenCalendarDate | undefined = parseCalendarDate(day);
+    if (parsed === undefined) {
+      return false;
+    }
+    const normalized: string = day.trim();
+    for (let index = 0; index < this.rows.length; index++) {
+      if (this.rows[index].date === normalized) {
+        this.rows[index].reads += 1;
+        if (article.length > 0 && this.rows[index].articles.indexOf(article) === -1) {
+          this.rows[index].articles.push(article);
+        }
+        return true;
+      }
+    }
+    const row: EvergreenHistoryRow = { date: normalized, reads: 1, articles: [] };
+    if (article.length > 0) {
+      row.articles.push(article);
+    }
+    this.rows.push(row);
+    this.sortRows();
+    return true;
+  }
+
+  private sortRows(): void {
+    this.rows.sort((left: EvergreenHistoryRow, right: EvergreenHistoryRow): number =>
+      left.date < right.date ? -1 : (left.date > right.date ? 1 : 0));
+  }
+
+  /** Every reading day held by the store, ascending, including stale rows. */
+  distinctDays(): string[] {
+    const days: string[] = [];
+    for (let index = 0; index < this.rows.length; index++) {
+      days.push(this.rows[index].date);
+    }
+    return sortDistinctDays(days);
+  }
+
+  distinctDaysInWindow(windowStart: number, today: number): string[] {
+    const days: string[] = [];
+    for (let index = 0; index < this.rows.length; index++) {
+      const parsed: EvergreenCalendarDate | undefined = parseCalendarDate(this.rows[index].date);
+      if (parsed === undefined) {
+        continue;
+      }
+      const epoch: number = toEpochDay(parsed);
+      if (epoch >= windowStart && epoch <= today) {
+        days.push(this.rows[index].date);
+      }
+    }
+    return sortDistinctDays(days);
+  }
+
+  totalReadsInWindow(windowStart: number, today: number): number {
+    let total: number = 0;
+    for (let index = 0; index < this.rows.length; index++) {
+      const parsed: EvergreenCalendarDate | undefined = parseCalendarDate(this.rows[index].date);
+      if (parsed === undefined) {
+        continue;
+      }
+      const epoch: number = toEpochDay(parsed);
+      if (epoch >= windowStart && epoch <= today) {
+        total += this.rows[index].reads;
+      }
+    }
+    return total;
+  }
+
+  totalReads(): number {
+    let total: number = 0;
+    for (let index = 0; index < this.rows.length; index++) {
+      total += this.rows[index].reads;
+    }
+    return total;
+  }
+
+  rowCount(): number {
+    return this.rows.length;
+  }
+
+  toJson(): string {
+    return JSON.stringify(this.rows);
+  }
+
+  restoreFromJson(raw: string): void {
+    this.rows = [];
+    const trimmed: string = raw.trim();
+    if (trimmed.length === 0) {
+      return;
+    }
+    try {
+      const parsed: Object = JSON.parse(trimmed) as Object;
+      if (Array.isArray(parsed)) {
+        const items: Object[] = parsed as Object[];
+        for (let index = 0; index < items.length; index++) {
+          const entry: Object = items[index];
+          if (typeof entry !== 'object' || entry === null) {
+            continue;
+          }
+          const details: Record<string, Object> = entry as Record<string, Object>;
+          const date: EvergreenCalendarDate | undefined =
+            parseCalendarDate(String(details['date'] === undefined ? '' : details['date']));
+          if (date === undefined) {
+            continue;
+          }
+          const reads: number = Number(details['reads'] === undefined ? 1 : details['reads']);
+          this.rows.push({
+            date: String(details['date']),
+            reads: isFinite(reads) && reads > 0 ? Math.floor(reads) : 1,
+            articles: []
+          });
+        }
+        this.sortRows();
+      }
+    } catch (error) {
+      this.rows = [];
+    }
+  }
+}
