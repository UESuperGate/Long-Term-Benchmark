+/**
+ * Persistence for the evergreen account-creation encouragement.
+ *
+ * The encouragement owns a dedicated `evergreen_account` preferences file with
+ * three durable keys:
+ *
+ *  - `impressions`             number of ordinary impressions already shown
+ *  - `lastImpressionDate`      local calendar day of the last impression
+ *  - `permanentlyDismissed`    set by the close control, never by "Maybe later"
+ *
+ * plus application-owned reading history rows and the saved-item count used for
+ * the personalised copy.  If the preferences file cannot be opened the store
+ * falls back to an in-memory implementation so the application keeps running
+ * instead of crashing.
+ */
+
+import { common } from '@kit.AbilityKit';
+import { preferences } from '@kit.ArkData';
+
+export const EVERGREEN_PREFERENCES_NAME: string = 'evergreen_account';
+export const EVERGREEN_KEY_IMPRESSIONS: string = 'impressions';
+export const EVERGREEN_KEY_LAST_IMPRESSION_DATE: string = 'lastImpressionDate';
+export const EVERGREEN_KEY_PERMANENTLY_DISMISSED: string = 'permanentlyDismissed';
+export const EVERGREEN_KEY_SAVED_COUNT: string = 'savedCount';
+export const EVERGREEN_KEY_READING_HISTORY: string = 'readingHistory';
+export const EVERGREEN_KEY_SNAPSHOT: string = 'snapshot';
+
+export interface EvergreenPersistedState {
+  impressions: number;
+  lastImpressionDate: string;
+  permanentlyDismissed: boolean;
