@@ -0,0 +1,170 @@
+/**
+ * Launch-time wiring for the evergreen account-creation encouragement.
+ *
+ * `EntryAbility` publishes the launch information here (ordinary launch,
+ * external article deep link, account and onboarding state) and the ArkUI page
+ * owner registers itself so that a deep link arriving while the application is
+ * already running can be routed to the live page.
+ *
+ * The module also owns the two external leaves of the feature:
+ *  - analytics, which receives impression and interaction events, and
+ *  - authentication, which is asked for a registration-first sign-up.
+ *
+ * Neither leaf is implemented in this module: the application installs a host
+ * for them, and until it does, the requests are recorded and logged so the
+ * encouragement keeps working.
+ */
+
+import { common, Want } from '@kit.AbilityKit';
+import { EvergreenEffect, EvergreenInput, EvergreenLeaf, EvergreenPageOwner } from '../integration/EvergreenPageIntegration';
+import {
+  EVERGREEN_LAUNCH_EXTERNAL_ARTICLE,
+  EvergreenLaunchSnapshot,
+  emptyEvergreenLaunchSnapshot,
+  launchSnapshotFromWant
+} from './EvergreenLaunchSnapshot';
+import { EVERGREEN_EFFECT_AUTHENTICATION } from './EvergreenStore';
+
+const EVENT_LOG_LIMIT: number = 64;
+
+/** External authentication entry point the encouragement hands over to. */
+export interface EvergreenAuthenticationHost {
+  /** Starts the registration-first authentication flow. */
+  startRegistrationFirst(source: string): Promise<void>;
+}
+
+class EvergreenApplicationLeaf implements EvergreenLeaf {
+  private analytics: EvergreenEffect[] = [];
+  private authenticationHost?: EvergreenAuthenticationHost;
+  private pendingAuthenticationRequests: string[] = [];
+
+  async emit(effect: EvergreenEffect): Promise<void> {
+    this.analytics.push(effect);
+    if (this.analytics.length > EVENT_LOG_LIMIT) {
+      this.analytics.shift();
+    }
+    console.info('EvergreenApp: ' + effect.name + ' ' + JSON.stringify(effect));
+    if (effect.name === EVERGREEN_EFFECT_AUTHENTICATION && this.authenticationHost !== undefined) {
+      const host: EvergreenAuthenticationHost = this.authenticationHost;
+      try {
+        await host.startRegistrationFirst(String(effect.source));
+      } catch (error) {
+        console.error('EvergreenApp: authentication request failed: ' + String(error));
+      }
+      return;
+    }
+    if (effect.name === EVERGREEN_EFFECT_AUTHENTICATION) {
+      this.pendingAuthenticationRequests.push(String(effect.source));
+    }
+  }
+
+  setAuthenticationHost(host: EvergreenAuthenticationHost | undefined): void {
+    this.authenticationHost = host;
+  }
+
+  recordedEvents(): EvergreenEffect[] {
+    return this.analytics.slice();
+  }
+
+  pendingAuthentication(): string[] {
+    return this.pendingAuthenticationRequests.slice();
+  }
+}
+
+export class EvergreenLaunchContext {
+  private static snapshot: EvergreenLaunchSnapshot = emptyEvergreenLaunchSnapshot();
+  private static runtimeInput?: EvergreenInput;
+  private static owner?: EvergreenPageOwner;
+  private static leaf: EvergreenApplicationLeaf = new EvergreenApplicationLeaf();
+
+  /** Snapshot of the launch currently being served. */
+  static currentSnapshot(): EvergreenLaunchSnapshot {
+    return EvergreenLaunchContext.snapshot;
+  }
+
+  /** Called by `EntryAbility` for both cold starts and new wants. */
+  static updateFromWant(want: Want): EvergreenLaunchSnapshot {
+    const fromWant: EvergreenLaunchSnapshot = launchSnapshotFromWant(want);
+    EvergreenLaunchContext.snapshot = fromWant;
+    return fromWant;
+  }
+
+  static registerRuntimeInput(input: EvergreenInput | undefined): void {
+    EvergreenLaunchContext.runtimeInput = input;
+  }
+
+  static attach(owner: EvergreenPageOwner): void {
+    EvergreenLaunchContext.owner = owner;
+  }
+
+  static detach(owner: EvergreenPageOwner | undefined): void {
+    if (EvergreenLaunchContext.owner === owner) {
+      EvergreenLaunchContext.owner = undefined;
+    }
+  }
+
+  static attachedOwner(): EvergreenPageOwner | undefined {
+    return EvergreenLaunchContext.owner;
+  }
+
+  static setAuthenticationHost(host: EvergreenAuthenticationHost | undefined): void {
+    EvergreenLaunchContext.leaf.setAuthenticationHost(host);
+  }
+
+  static recordedEvents(): EvergreenEffect[] {
+    return EvergreenLaunchContext.leaf.recordedEvents();
+  }
+
+  static pendingAuthenticationRequests(): string[] {
+    return EvergreenLaunchContext.leaf.pendingAuthentication();
+  }
+
+  /** Routes a deep link to the running page, if one is attached. */
+  static async openExternalArticle(uri: string): Promise<boolean> {
+    const owner: EvergreenPageOwner | undefined = EvergreenLaunchContext.owner;
+    if (owner === undefined) {
+      return false;
+    }
+    const event: Record<string, Object> = { 'name': 'openExternalArticleDeepLink', 'uri': uri };
+    try {
+      await owner.dispatch(event);
+    } catch (error) {
+      console.error('EvergreenLaunchContext: deep link routing failed: ' + String(error));
+      return false;
+    }
+    return true;
+  }
+
+  /**
+   * Input used when the application mounts the page itself.  A runtime may
+   * register an input first, in which case that one is used instead.
+   */
+  static productionInput(context: common.UIAbilityContext): EvergreenInput {
+    const registered: EvergreenInput | undefined = EvergreenLaunchContext.runtimeInput;
+    if (registered !== undefined) {
+      return registered;
+    }
+    const snapshot: EvergreenLaunchSnapshot = EvergreenLaunchContext.snapshot;
+    const launch: Record<string, Object> = {};
+    launch['type'] = snapshot.launchType;
+    launch['uri'] = snapshot.deepLinkUri;
+    const state: Record<string, Object> = {};
+    state['launch'] = launch;
+    state['clockDate'] = snapshot.today;
+    state['account'] = snapshot.account;
+    state['onboardingComplete'] = snapshot.onboardingComplete;
+    state['evergreenAccountEnabled'] = snapshot.featureEnabled;
+    const persistence: Record<string, Object> = {};
+    return { state: state, persistence: persistence, leaf: EvergreenLaunchContext.leaf };
+  }
+
+  static isExternalArticleLaunch(): boolean {
+    return EvergreenLaunchContext.snapshot.launchType === EVERGREEN_LAUNCH_EXTERNAL_ARTICLE;
+  }
+
+  static reset(): void {
+    EvergreenLaunchContext.snapshot = emptyEvergreenLaunchSnapshot();
+    EvergreenLaunchContext.owner = undefined;
+    EvergreenLaunchContext.runtimeInput = undefined;
+  }
+}
