+/**
+ * Calendar helpers shared by the evergreen account-creation encouragement.
+ *
+ * The encouragement reasons about *local calendar days*: a reader who opened
+ * three articles in the same evening has read on a single reading day.  All
+ * comparisons therefore happen on whole days ("epoch days") instead of on
+ * wall-clock timestamps so that results never depend on the device time zone or
+ * on daylight-saving transitions.
+ */
+
+export interface EvergreenCalendarDate {
+  year: number;
+  month: number;
+  day: number;
+}
+
+const MILLISECONDS_PER_DAY: number = 86400000;
+const ISO_DATE_LENGTH: number = 10;
+const INVALID_NUMBER: number = -1;
+
+function digitValue(code: number): number {
+  return code >= 48 && code <= 57 ? code - 48 : INVALID_NUMBER;
+}
+
+function parseUnsigned(value: string): number {
+  if (value.length === 0) {
+    return INVALID_NUMBER;
+  }
+  let result: number = 0;
+  for (let index = 0; index < value.length; index++) {
+    const digit: number = digitValue(value.charCodeAt(index));
+    if (digit === INVALID_NUMBER) {
+      return INVALID_NUMBER;
+    }
+    result = result * 10 + digit;
+  }
+  return result;
+}
+
+function pad(value: number): string {
+  return value < 10 ? '0' + String(value) : String(value);
+}
+
+/**
+ * Strict `YYYY-MM-DD` parser.  Anything else - including the empty string and
+ * values such as `not-a-date` - is rejected so that callers fail closed instead
+ * of silently substituting a guessed date.
+ */
+export function parseCalendarDate(value: string): EvergreenCalendarDate | undefined {
+  const trimmed: string = value.trim();
+  if (trimmed.length !== ISO_DATE_LENGTH) {
+    return undefined;
+  }
+  if (trimmed.charAt(4) !== '-' || trimmed.charAt(7) !== '-') {
+    return undefined;
+  }
+  const year: number = parseUnsigned(trimmed.substring(0, 4));
+  const month: number = parseUnsigned(trimmed.substring(5, 7));
+  const day: number = parseUnsigned(trimmed.substring(8, 10));
+  if (year < 1970 || month < 1 || month > 12 || day < 1 || day > 31) {
+    return undefined;
+  }
+  const roundTrip: EvergreenCalendarDate = fromEpochDay(toEpochDay({ year: year, month: month, day: day }));
+  if (roundTrip.year !== year || roundTrip.month !== month || roundTrip.day !== day) {
+    return undefined;
+  }
+  return { year: year, month: month, day: day };
+}
+
+export function toEpochDay(date: EvergreenCalendarDate): number {
+  return Math.floor(Date.UTC(date.year, date.month - 1, date.day) / MILLISECONDS_PER_DAY);
+}
+
+export function fromEpochDay(epochDay: number): EvergreenCalendarDate {
+  const instant: Date = new Date(epochDay * MILLISECONDS_PER_DAY);
+  return {
+    year: instant.getUTCFullYear(),
+    month: instant.getUTCMonth() + 1,
+    day: instant.getUTCDate()
+  };
+}
+
+export function formatCalendarDate(date: EvergreenCalendarDate): string {
+  return String(date.year) + '-' + pad(date.month) + '-' + pad(date.day);
+}
+
+export function formatEpochDay(epochDay: number): string {
+  return formatCalendarDate(fromEpochDay(epochDay));
+}
+
+/** Number of whole days between two calendar days; positive when `to` is later. */
+export function daysBetween(from: EvergreenCalendarDate, to: EvergreenCalendarDate): number {
+  return toEpochDay(to) - toEpochDay(from);
+}
+
+/**
+ * Accepts the ISO day as well as longer ISO-8601 timestamps such as
+ * `2026-08-25T21:04:00Z`, and returns the calendar day in `YYYY-MM-DD` form.
+ * Values that are not ISO dates return an empty string.
+ */
+export function normalizeCalendarDay(value: string): string {
+  const trimmed: string = value.trim();
+  if (trimmed.length === 0) {
+    return '';
+  }
+  const candidate: string = trimmed.length >= ISO_DATE_LENGTH ? trimmed.substring(0, ISO_DATE_LENGTH) : trimmed;
+  const parsed: EvergreenCalendarDate | undefined = parseCalendarDate(candidate);
+  return parsed === undefined ? '' : formatCalendarDate(parsed);
+}
+
+export function isCalendarDay(value: string): boolean {
+  return parseCalendarDate(value) !== undefined;
+}
+
+/** The current local calendar day of the device, used as the prompt's clock. */
+export function todayCalendarDay(): string {
+  const now: Date = new Date();
+  return formatCalendarDate({ year: now.getFullYear(), month: now.getMonth() + 1, day: now.getDate() });
+}
+
+/** Ascending, de-duplicated list of calendar days. */
+export function sortDistinctDays(days: string[]): string[] {
+  const seen: number[] = [];
+  const result: string[] = [];
+  for (let index = 0; index < days.length; index++) {
+    const parsed: EvergreenCalendarDate | undefined = parseCalendarDate(days[index]);
+    if (parsed === undefined) {
+      continue;
+    }
+    const day: string = formatCalendarDate(parsed);
+    const epoch: number = toEpochDay(parsed);
+    if (seen.indexOf(epoch) === -1) {
+      seen.push(epoch);
+      result.push(day);
+    }
+  }
+  result.sort((left: string, right: string): number => (left < right ? -1 : (left > right ? 1 : 0)));
+  return result;
+}
