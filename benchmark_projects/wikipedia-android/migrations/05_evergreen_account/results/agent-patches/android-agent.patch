diff --git a/app/src/main/kotlin/org/wikipedia/evergreen/encouragement/AccountEncouragementEligibility.kt b/app/src/main/kotlin/org/wikipedia/evergreen/encouragement/AccountEncouragementEligibility.kt
new file mode 100644
index 0000000000000000000000000000000000000000..0ca09001c9398b863312defd86bd0fd8b0918ae4
--- /dev/null
+++ b/app/src/main/kotlin/org/wikipedia/evergreen/encouragement/AccountEncouragementEligibility.kt
@@ -0,0 +1,146 @@
+package org.wikipedia.evergreen.encouragement
+
+import org.wikipedia.evergreen.data.AccountStateRepository
+import org.wikipedia.evergreen.data.AccountStateRepository.RegistrationKind
+import org.wikipedia.evergreen.data.EvergreenAccountRepository
+import org.wikipedia.evergreen.data.ReadingHistoryStore
+import org.wikipedia.evergreen.platform.AppClock
+import org.wikipedia.evergreen.platform.MethodTrace
+import java.time.LocalDate
+import java.time.temporal.ChronoUnit
+
+/**
+ * Decides whether an ordinary launch should show the account creation encouragement.
+ *
+ * The rules, in the order they are applied:
+ *  1. a reader with a permanent registered account is never prompted;
+ *  2. a reader who closed the screen with its dismiss control is never prompted again;
+ *  3. at most [Policy.maximumImpressions] ordinary impressions are ever shown;
+ *  4. a reader with no impression yet qualifies once they have read on two distinct days less
+ *     than a fortnight apart whose earlier day is at least a week old, considering only reading
+ *     history from the most recent year;
+ *  5. a reader who already deferred once qualifies again only after returning on two distinct
+ *     days strictly after the date of their first impression.
+ *
+ * Temporary accounts are treated exactly like logged out readers. Every persisted value that
+ * cannot be understood makes the reader ineligible rather than being repaired or guessed.
+ * Evaluating never writes anything: recording an impression is a separate, deliberate step.
+ */
+class AccountEncouragementEligibility(
+    private val history: ReadingHistoryStore,
+    private val evergreen: EvergreenAccountRepository,
+    private val accounts: AccountStateRepository,
+    private val clock: AppClock,
+    private val trace: MethodTrace,
+    val policy: Policy = Policy(),
+) {
+
+    data class Policy(
+        /** Two ordinary impressions are the maximum; later launches stay suppressed. */
+        val maximumImpressions: Int = 2,
+        /** Distinct reading days after the first impression that allow a second impression. */
+        val requiredReturnReadingDays: Int = 2,
+        /** The earlier day of a qualifying pair must be at least this many days old. */
+        val minimumAgeOfEarlierReadingDayDays: Long = 7,
+        /** A qualifying pair of reading days is closer together than this. */
+        val maximumGapBetweenQualifyingReadingDaysDays: Long = 14,
+        /** Only reading history from the most recent year is considered. */
+        val historyWindowYears: Long = 1,
+    )
+
+    sealed class Result {
+        abstract val reason: String
+
+        val shouldShow: Boolean get() = this is Eligible
+
+        data class Eligible(override val reason: String) : Result()
+
+        data class Suppressed(override val reason: String) : Result()
+    }
+
+    fun evaluate(): Result {
+        val kind = accounts.registrationKind()
+        trace.record("accountStateRepository.registrationKind")
+        if (kind == RegistrationKind.REGISTERED) {
+            return Result.Suppressed(REASON_PERMANENT_ACCOUNT)
+        }
+
+        trace.record("evergreenAccountRepository.isPermanentlyDismissed")
+        if (evergreen.isPermanentlyDismissed()) {
+            return Result.Suppressed(REASON_PERMANENTLY_DISMISSED)
+        }
+
+        trace.record("evergreenAccountRepository.impressionCount")
+        val impressions = evergreen.impressionCount()
+        if (impressions >= policy.maximumImpressions) {
+            return Result.Suppressed(REASON_IMPRESSION_LIMIT_REACHED)
+        }
+
+        return if (impressions <= 0) evaluateFirstImpression() else evaluateRepeatImpression()
+    }
+
+    private fun evaluateFirstImpression(): Result {
+        val today = clock.today()
+        val readingDays = readingDaysAfter(today.minusYears(policy.historyWindowYears), today)
+        return if (hasQualifyingPair(readingDays, today)) {
+            Result.Eligible(REASON_FIRST_IMPRESSION_QUALIFIED)
+        } else {
+            Result.Suppressed(REASON_INSUFFICIENT_READING_HISTORY)
+        }
+    }
+
+    private fun evaluateRepeatImpression(): Result {
+        trace.record("evergreenAccountRepository.parsedLastImpressionDate")
+        val lastImpressionDay = evergreen.parsedLastImpressionDate()
+            ?: return Result.Suppressed(REASON_UNREADABLE_LAST_IMPRESSION_DATE)
+
+        val today = clock.today()
+        val windowStart = today.minusYears(policy.historyWindowYears)
+        val earliest = if (lastImpressionDay.isAfter(windowStart)) lastImpressionDay else windowStart
+
+        // Only reading days strictly after the stored first impression date count as returns,
+        // and they still have to fall inside the history window.
+        val returnDays = readingDaysAfter(earliest, today).filter { it.isAfter(lastImpressionDay) }
+        return if (returnDays.size >= policy.requiredReturnReadingDays) {
+            Result.Eligible(REASON_REPEAT_IMPRESSION_QUALIFIED)
+        } else {
+            Result.Suppressed(REASON_INSUFFICIENT_RETURN_HISTORY)
+        }
+    }
+
+    private fun readingDaysAfter(fromExclusive: LocalDate, through: LocalDate): List<LocalDate> {
+        trace.record("readingHistoryStore.distinctReadingDays")
+        return history.distinctReadingDays(fromExclusive, through)
+    }
+
+    /**
+     * Scans consecutive reading days for a pair that is close enough together and old enough.
+     * Any qualifying pair contains a consecutive qualifying pair, so scanning neighbours is
+     * enough; multiple reads on one calendar day already collapsed into one reading day.
+     */
+    private fun hasQualifyingPair(readingDays: List<LocalDate>, today: LocalDate): Boolean {
+        for (index in 1 until readingDays.size) {
+            val earlier = readingDays[index - 1]
+            val later = readingDays[index]
+            val ageInDays = ChronoUnit.DAYS.between(earlier, today)
+            val gapInDays = ChronoUnit.DAYS.between(earlier, later)
+            val oldEnough = ageInDays >= policy.minimumAgeOfEarlierReadingDayDays
+            val closeEnough = gapInDays < policy.maximumGapBetweenQualifyingReadingDaysDays
+            if (oldEnough && closeEnough) {
+                return true
+            }
+        }
+        return false
+    }
+
+    companion object {
+        const val REASON_PERMANENT_ACCOUNT = "permanentAccount"
+        const val REASON_PERMANENTLY_DISMISSED = "permanentlyDismissed"
+        const val REASON_IMPRESSION_LIMIT_REACHED = "impressionLimitReached"
+        const val REASON_INSUFFICIENT_READING_HISTORY = "insufficientReadingHistory"
+        const val REASON_INSUFFICIENT_RETURN_HISTORY = "insufficientReturnReadingDays"
+        const val REASON_UNREADABLE_LAST_IMPRESSION_DATE = "unreadableLastImpressionDate"
+        const val REASON_FIRST_IMPRESSION_QUALIFIED = "firstImpressionQualified"
+        const val REASON_REPEAT_IMPRESSION_QUALIFIED = "repeatImpressionQualified"
+    }
+}
