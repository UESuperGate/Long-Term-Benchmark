+package org.wikipedia.evergreen.data
+
+import android.content.Context
+
+/**
+ * Application owned state of the prompts that compete for a launch.
+ *
+ * The account creation encouragement is considered only once initial onboarding and every other
+ * higher priority launch prompt have completed, so that it can never interrupt them.
+ */
+class LaunchPromptStateRepository(context: Context) {
+
+    private val prefs = context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun isOnboardingComplete(): Boolean = prefs.getBoolean(KEY_ONBOARDING_COMPLETE, true)
+
+    fun hasHigherPriorityPromptPending(): Boolean = prefs.getBoolean(KEY_OTHER_PROMPT_PENDING, false)
+
+    fun isEncouragementAllowed(): Boolean = isOnboardingComplete() && !hasHigherPriorityPromptPending()
+
+    fun restore(onboardingComplete: Boolean, higherPriorityPromptPending: Boolean) {
+        prefs.edit()
+            .putBoolean(KEY_ONBOARDING_COMPLETE, onboardingComplete)
+            .putBoolean(KEY_OTHER_PROMPT_PENDING, higherPriorityPromptPending)
+            .apply()
+    }
+
+    fun completeOnboarding() {
+        prefs.edit().putBoolean(KEY_ONBOARDING_COMPLETE, true).apply()
+    }
+
+    fun markHigherPriorityPromptPending() {
+        prefs.edit().putBoolean(KEY_OTHER_PROMPT_PENDING, true).apply()
+    }
+
+    companion object {
+        const val PREFS_NAME = "evergreen-launch-prompts"
+        private const val KEY_ONBOARDING_COMPLETE = "onboardingComplete"
+        private const val KEY_OTHER_PROMPT_PENDING = "higherPriorityPromptPending"
+    }
+}
