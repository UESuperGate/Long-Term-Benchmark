@@ -0,0 +1,76 @@
+package org.wikipedia.evergreen.runtime
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** First non blank string stored under [keys]. */
+internal fun JSONObject.firstString(vararg keys: String): String? {
+    for (key in keys) {
+        if (!has(key) || isNull(key)) {
+            continue
+        }
+        val value = opt(key)
+        if (value is String && value.isNotBlank()) {
+            return value
+        }
+    }
+    return null
+}
+
+/** First value stored under [keys] that can be read as a whole number. */
+internal fun JSONObject.firstInt(vararg keys: String): Int? {
+    for (key in keys) {
+        if (!has(key) || isNull(key)) {
+            continue
+        }
+        val value = opt(key)
+        when (value) {
+            is Number -> return value.toInt()
+            is String -> value.trim().toIntOrNull()?.let { return it }
+            is Boolean -> return if (value) 1 else 0
+        }
+    }
+    return null
+}
+
+/** First value stored under [keys] that can be read as a flag. */
+internal fun JSONObject.firstBoolean(vararg keys: String): Boolean? {
+    for (key in keys) {
+        if (!has(key) || isNull(key)) {
+            continue
+        }
+        val value = opt(key)
+        when (value) {
+            is Boolean -> return value
+            is Number -> return value.toInt() != 0
+            is String -> when (value.trim().lowercase()) {
+                "true", "yes", "complete", "completed" -> return true
+                "false", "no", "pending", "incomplete" -> return false
+            }
+        }
+    }
+    return null
+}
+
+/** First JSON array stored under [keys]. */
+internal fun JSONObject.firstArray(vararg keys: String): JSONArray? {
+    for (key in keys) {
+        if (!has(key) || isNull(key)) {
+            continue
+        }
+        val array = optJSONArray(key)
+        if (array != null) {
+            return array
+        }
+    }
+    return null
+}
+
+internal fun String.containsAny(vararg needles: String): Boolean {
+    for (needle in needles) {
+        if (contains(needle)) {
+            return true
+        }
+    }
+    return false
+}
