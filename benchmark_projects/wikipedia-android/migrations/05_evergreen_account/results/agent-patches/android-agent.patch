+package org.wikipedia.evergreen.data
+
+import android.content.Context
+import org.wikipedia.evergreen.platform.AppClock
+import java.time.LocalDate
+
+/**
+ * Application owned persistence for the account creation encouragement.
+ *
+ * Everything the encouragement needs in order to come back correctly after the activity or
+ * the process is recreated lives here: the number of ordinary impressions that have been shown,
+ * the local date of the most recent one, the terminal "close" opt out, and whether a shown
+ * screen is still awaiting the reader's answer.
+ *
+ * The stored date is always written back verbatim. A value that cannot be parsed is reported as
+ * `null` by [parsedLastImpressionDate] and is never replaced with a guessed date.
+ */
+class EvergreenAccountRepository(context: Context, private val clock: AppClock) {
+
+    private val prefs = context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun impressionCount(): Int = prefs.getInt(KEY_IMPRESSIONS, 0)
+
+    fun lastImpressionDate(): String = prefs.getString(KEY_LAST_IMPRESSION_DATE, "").orEmpty()
+
+    fun parsedLastImpressionDate(): LocalDate? = clock.parseDate(lastImpressionDate())
+
+    fun isPermanentlyDismissed(): Boolean = prefs.getBoolean(KEY_PERMANENTLY_DISMISSED, false)
+
+    fun permanentDismissalDate(): String = prefs.getString(KEY_DISMISSAL_DATE, "").orEmpty()
+
+    /** True while a shown encouragement screen is still waiting for the reader's answer. */
+    fun isEncouragementPending(): Boolean = prefs.getString(KEY_PENDING_SCREEN, null) == SCREEN_ENCOURAGEMENT
+
+    /** Records exactly one ordinary impression and re-dates the stored impression. */
+    fun recordImpression(date: LocalDate = clock.today()) {
+        prefs.edit()
+            .putInt(KEY_IMPRESSIONS, impressionCount() + 1)
+            .putString(KEY_LAST_IMPRESSION_DATE, clock.format(date))
+            .apply()
+    }
+
+    fun markEncouragementPending() {
+        prefs.edit().putString(KEY_PENDING_SCREEN, SCREEN_ENCOURAGEMENT).apply()
+    }
+
+    fun clearPendingEncouragement() {
+        prefs.edit().remove(KEY_PENDING_SCREEN).apply()
+    }
+
+    /** Terminal opt out written by the screen's close control. It survives every later launch. */
+    fun dismissPermanently(date: LocalDate = clock.today()) {
+        prefs.edit()
+            .putBoolean(KEY_PERMANENTLY_DISMISSED, true)
+            .putString(KEY_DISMISSAL_DATE, clock.format(date))
+            .remove(KEY_PENDING_SCREEN)
+            .apply()
+    }
+
+    /**
+     * Establishes the stored encouragement state. Used by the launch fixture adapter and by the
+     * screen restore path; production code reaches the same fields through the operations above.
+     */
+    fun restore(
+        impressions: Int,
+        lastImpressionDate: String,
+        permanentlyDismissed: Boolean,
+        pendingEncouragement: Boolean,
+    ) {
+        prefs.edit()
+            .putInt(KEY_IMPRESSIONS, impressions)
+            .putString(KEY_LAST_IMPRESSION_DATE, lastImpressionDate)
+            .putBoolean(KEY_PERMANENTLY_DISMISSED, permanentlyDismissed)
+            .putString(KEY_DISMISSAL_DATE, "")
+            .apply()
+        if (pendingEncouragement) {
+            markEncouragementPending()
+        } else {
+            clearPendingEncouragement()
+        }
+    }
+
+    companion object {
+        const val PREFS_NAME = "evergreen-account"
+        const val SCREEN_ENCOURAGEMENT = "account_encouragement"
+
+        private const val KEY_IMPRESSIONS = "impressions"
+        private const val KEY_LAST_IMPRESSION_DATE = "lastImpressionDate"
+        private const val KEY_PERMANENTLY_DISMISSED = "permanentlyDismissed"
+        private const val KEY_DISMISSAL_DATE = "permanentDismissalDate"
+        private const val KEY_PENDING_SCREEN = "pendingScreen"
+    }
+}
