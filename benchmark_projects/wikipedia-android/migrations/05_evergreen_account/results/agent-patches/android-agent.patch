+package org.wikipedia.evergreen.encouragement
+
+import org.wikipedia.evergreen.data.ReadingHistoryStore
+import org.wikipedia.evergreen.data.SavedPagesStore
+import org.wikipedia.evergreen.platform.AppClock
+
+/**
+ * The personalised numbers the encouragement screen presents, derived from application data
+ * only: how much the reader has read, how much they have saved, and what they came back to.
+ */
+class ReadingEngagementSummary(
+    private val history: ReadingHistoryStore,
+    private val savedPages: SavedPagesStore,
+    private val clock: AppClock,
+) {
+
+    data class Counts(
+        val articlesRead: Int,
+        val pagesSaved: Int,
+        val recentlyUsedPages: Int,
+    ) {
+        fun describe(): String {
+            val articles = plural(articlesRead, "article")
+            val saved = plural(pagesSaved, "saved page")
+            val recent = plural(recentlyUsedPages, "recently used page")
+            return "You have read $articles, $saved and $recent. " +
+                "An account keeps your reading and your saved pages in sync across every device."
+        }
+
+        private fun plural(count: Int, noun: String): String =
+            if (count == 1) "1 $noun" else "$count ${noun}s"
+    }
+
+    fun current(): Counts {
+        val today = clock.today()
+        return Counts(
+            articlesRead = history.distinctArticleCount(today.minusYears(HISTORY_WINDOW_YEARS), today),
+            pagesSaved = savedPages.count(),
+            recentlyUsedPages = history.distinctArticleCount(today.minusDays(RECENT_USE_WINDOW_DAYS), today),
+        )
+    }
+
+    companion object {
+        private const val HISTORY_WINDOW_YEARS = 1L
+        private const val RECENT_USE_WINDOW_DAYS = 7L
+    }
+}
