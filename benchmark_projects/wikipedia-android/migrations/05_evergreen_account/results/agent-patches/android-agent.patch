@@ -0,0 +1,64 @@
+package org.wikipedia.evergreen.data
+
+import android.content.Context
+
+/**
+ * Application owned reader account state.
+ *
+ * The authentication service is an external leaf: it hands outcomes back and this store turns
+ * them into the application's registration kind. A permanent account suppresses the account
+ * creation encouragement, a temporary account does not.
+ */
+class AccountStateRepository(context: Context) {
+
+    enum class RegistrationKind(val storageValue: String) {
+        LOGGED_OUT("logged_out"),
+        TEMPORARY("temporary"),
+        REGISTERED("registered");
+
+        companion object {
+            fun fromStorage(value: String?): RegistrationKind {
+                val normalized = value?.trim()?.lowercase()?.replace('-', '_')
+                if (normalized.isNullOrEmpty()) {
+                    return LOGGED_OUT
+                }
+                values().firstOrNull { it.storageValue == normalized }?.let { return it }
+                return when (normalized) {
+                    "temp", "temp_account", "temporary_account", "anon", "anonymous", "guest" -> TEMPORARY
+                    "permanent", "permanent_account", "account", "user" -> REGISTERED
+                    "loggedout", "logged_out_user", "signed_out" -> LOGGED_OUT
+                    else -> LOGGED_OUT
+                }
+            }
+        }
+    }
+
+    private val prefs = context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun registrationKind(): RegistrationKind =
+        RegistrationKind.fromStorage(prefs.getString(KEY_KIND, RegistrationKind.LOGGED_OUT.storageValue))
+
+    fun isPermanentAccount(): Boolean = registrationKind() == RegistrationKind.REGISTERED
+
+    fun restore(kind: RegistrationKind) {
+        prefs.edit().putString(KEY_KIND, kind.storageValue).apply()
+    }
+
+    /** Applies an authentication leaf outcome to the application's account state. */
+    fun onRegistrationSucceeded(permanentAccount: Boolean) {
+        restore(if (permanentAccount) RegistrationKind.REGISTERED else RegistrationKind.TEMPORARY)
+    }
+
+    fun signInTemporarily() {
+        restore(RegistrationKind.TEMPORARY)
+    }
+
+    fun signOut() {
+        restore(RegistrationKind.LOGGED_OUT)
+    }
+
+    companion object {
+        const val PREFS_NAME = "evergreen-account-state"
+        private const val KEY_KIND = "registrationKind"
+    }
+}
