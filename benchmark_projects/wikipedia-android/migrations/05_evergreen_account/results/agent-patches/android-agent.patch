+/** The authentication leaf's outcome expressed in application terms. */
+sealed class RegistrationOutcome {
+    abstract val reason: String
+
+    val succeeded: Boolean get() = this is Succeeded
+
+    /** A registration that produced an account. [permanentAccount] decides whether it suppresses
+     *  later prompts: a permanent account does, a temporary account does not. */
+    data class Succeeded(val permanentAccount: Boolean) : RegistrationOutcome() {
+        override val reason: String
+            get() = if (permanentAccount) "permanentAccountCreated" else "temporaryAccountCreated"
+    }
+
+    object Cancelled : RegistrationOutcome() {
+        override val reason: String get() = "cancelled"
+    }
+
+    data class Failed(override val reason: String) : RegistrationOutcome()
+}
+
+/**
+ * Application owned mapping for the registration first authentication flow.
+ *
+ * The authentication service is an external leaf: this class owns the intent that opens it and
+ * the translation of everything the leaf reports back - an activity result code or a leaf result
+ * - into application terms. Only a genuine success produces an account.
+ */
+class RegistrationFlow(private val accounts: AccountStateRepository) {
+
+    /** The registration-first intent handed to the external authentication leaf. */
+    fun buildRegistrationIntent(accountNameHint: String? = null): Intent =
+        Intent(Intent.ACTION_VIEW, Uri.parse(REGISTRATION_URI)).apply {
+            addCategory(Intent.CATEGORY_DEFAULT)
+            setPackage(EXTERNAL_AUTHENTICATION_PACKAGE)
+            putExtra(EXTRA_FLOW, FLOW_REGISTRATION_FIRST)
+            if (!accountNameHint.isNullOrBlank()) {
+                putExtra(EXTRA_ACCOUNT_NAME, accountNameHint)
+            }
+        }
+
+    fun mapActivityResult(resultCode: Int, data: Intent?): RegistrationOutcome =
+        if (resultCode == Activity.RESULT_OK) {
+            RegistrationOutcome.Succeeded(permanentAccount = true)
+        } else {
+            RegistrationOutcome.Cancelled
+        }
+
+    /**
+     * Maps the authentication leaf's own report. Anything that is not an explicit success is
+     * treated as no account having been created.
+     */
+    fun mapLeafResult(leaf: String?): RegistrationOutcome {
+        val normalized = leaf?.trim()?.lowercase()?.replace('-', '_')
+        return when {
+            normalized.isNullOrEmpty() -> RegistrationOutcome.Cancelled
+            normalized == "success" ||
+                normalized == "success_permanent_account" ||
+                normalized == "account_created" ||
+                normalized == "registered" -> RegistrationOutcome.Succeeded(permanentAccount = true)
+            normalized == "success_temporary_account" ||
+                normalized == "temporary_account" -> RegistrationOutcome.Succeeded(permanentAccount = false)
+            normalized == "cancelled" ||
+                normalized == "canceled" ||
+                normalized == "user_cancelled" ||
+                normalized == "back_pressed" -> RegistrationOutcome.Cancelled
+            else -> RegistrationOutcome.Failed(normalized)
+        }
+    }
+
+    /** Applies an outcome to the application's account state and reports whether it succeeded. */
+    fun applyOutcome(outcome: RegistrationOutcome): Boolean {
+        if (outcome is RegistrationOutcome.Succeeded) {
+            accounts.onRegistrationSucceeded(outcome.permanentAccount)
+        }
+        return outcome.succeeded
+    }
+
+    companion object {
+        const val EXTERNAL_AUTHENTICATION_PACKAGE = "org.wikipedia.auth"
+        const val FLOW_REGISTRATION_FIRST = "registration"
+        const val REGISTRATION_URI = "wikipedia://account/register"
+        const val EXTRA_FLOW = "flow"
+        const val EXTRA_ACCOUNT_NAME = "accountName"
+    }
+}
