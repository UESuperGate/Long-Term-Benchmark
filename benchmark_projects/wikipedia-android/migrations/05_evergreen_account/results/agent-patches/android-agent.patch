@@ -0,0 +1,57 @@
+package org.wikipedia.evergreen.runtime
+
+import android.net.Uri
+
+/** The article an external deep link asks for. */
+data class ArticleTarget(val project: String, val title: String) {
+    val canonical: String get() = "$project:$title"
+}
+
+/**
+ * Understands the external article links the application is launched with.
+ *
+ * A deep link names a Wikipedia host and an article path; the requested article is what the
+ * launch has to show, ahead of any other first screen consideration.
+ */
+object ArticleDeepLink {
+
+    private const val DEFAULT_PROJECT = "en"
+    private const val WIKI_PATH_PREFIX = "/wiki/"
+    private const val WIKIPEDIA_HOST_SUFFIX = "wikipedia.org"
+
+    fun parse(uri: String?): ArticleTarget? {
+        val raw = uri?.trim().orEmpty()
+        if (raw.isEmpty()) {
+            return null
+        }
+        val parsed = Uri.parse(raw)
+        val host = parsed.host?.lowercase()
+        val isWikipediaHost = host != null && host.endsWith(WIKIPEDIA_HOST_SUFFIX)
+        val path = parsed.path.orEmpty()
+        val wikiPathIndex = path.indexOf(WIKI_PATH_PREFIX)
+        if (wikiPathIndex < 0 && !isWikipediaHost) {
+            return null
+        }
+        val segment = if (wikiPathIndex >= 0) {
+            path.substring(wikiPathIndex + WIKI_PATH_PREFIX.length)
+        } else {
+            path.trimStart('/')
+        }
+        val title = Uri.decode(segment).trim().substringBefore('#')
+        if (title.isEmpty()) {
+            return null
+        }
+        return ArticleTarget(projectOf(host) ?: DEFAULT_PROJECT, title)
+    }
+
+    private fun projectOf(host: String?): String? {
+        if (host == null) {
+            return null
+        }
+        val labels = host.split(".")
+        if (labels.size < 3 || labels[labels.size - 2] != "wikipedia" || labels[labels.size - 1] != "org") {
+            return null
+        }
+        return labels.first()
+    }
+}
