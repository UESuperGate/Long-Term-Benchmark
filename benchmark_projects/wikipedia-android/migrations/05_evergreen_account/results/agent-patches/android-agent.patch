@@ -0,0 +1,52 @@
+package org.wikipedia.evergreen.data
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONException
+
+/** Application owned store of the articles the reader has saved. */
+class SavedPagesStore(context: Context) {
+
+    private val prefs = context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun titles(): List<String> {
+        val raw = prefs.getString(KEY_TITLES, "[]").orEmpty()
+        return try {
+            val array = JSONArray(raw)
+            (0 until array.length()).mapNotNull { index -> array.optString(index, "").ifBlank { null } }
+        } catch (e: JSONException) {
+            emptyList()
+        }
+    }
+
+    fun count(): Int = titles().size
+
+    fun save(project: String, title: String) {
+        val current = titles()
+        val qualified = if (project.isBlank()) title else "$project:$title"
+        if (current.any { it == qualified || it == title }) {
+            return
+        }
+        write(current + qualified)
+    }
+
+    fun remove(titles: Collection<String>) {
+        write(this.titles().filterNot { existing -> titles.any { it == existing || existing.endsWith(":$it") } })
+    }
+
+    /** Replaces the stored selection; used to establish a launch fixture. */
+    fun restore(saved: List<String>) {
+        write(saved.distinct())
+    }
+
+    private fun write(titles: List<String>) {
+        val array = JSONArray()
+        titles.forEach { array.put(it) }
+        prefs.edit().putString(KEY_TITLES, array.toString()).apply()
+    }
+
+    companion object {
+        const val PREFS_NAME = "evergreen-saved-pages"
+        private const val KEY_TITLES = "titles"
+    }
+}
