@@ -0,0 +1,61 @@
+package org.wikipedia.evergreen.platform
+
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import java.time.format.DateTimeParseException
+
+/**
+ * The application's notion of "today".
+ *
+ * Eligibility windows are expressed in local calendar days, so every date the encouragement
+ * logic reasons about is read through this class. Keeping the clock behind a seam also means
+ * a launch that happens to be anchored to a given day is evaluated with exactly the same
+ * production arithmetic that a wall clock launch uses.
+ */
+class AppClock(val zone: ZoneId = ZoneId.systemDefault()) {
+
+    @Volatile
+    private var anchoredDay: LocalDate? = null
+
+    /** The current local calendar day, or the anchored day when one was supplied. */
+    fun today(): LocalDate = anchoredDay ?: LocalDate.now(zone)
+
+    /** Anchors the clock to [day]; `null` restores the wall clock. */
+    fun anchorTo(day: LocalDate?) {
+        anchoredDay = day
+    }
+
+    fun startOfDayMillis(day: LocalDate): Long = day.atStartOfDay(zone).toInstant().toEpochMilli()
+
+    fun endOfDayMillis(day: LocalDate): Long = startOfDayMillis(day.plusDays(1)) - 1L
+
+    /** Local calendar day that contains [millis]. */
+    fun dayOf(millis: Long): LocalDate = Instant.ofEpochMilli(millis).atZone(zone).toLocalDate()
+
+    fun format(day: LocalDate): String = FORMAT.format(day)
+
+    /**
+     * Strict ISO-8601 (`yyyy-MM-dd`) parsing.
+     *
+     * Anything else - including an empty value or a value like `not-a-date` - yields `null`.
+     * Callers treat `null` as "the persisted value cannot be understood" and fail closed
+     * rather than guessing a replacement date.
+     */
+    fun parseDate(text: String?): LocalDate? {
+        val trimmed = text?.trim().orEmpty()
+        if (trimmed.isEmpty()) {
+            return null
+        }
+        return try {
+            LocalDate.parse(trimmed, FORMAT)
+        } catch (e: DateTimeParseException) {
+            null
+        }
+    }
+
+    private companion object {
+        val FORMAT: DateTimeFormatter = DateTimeFormatter.ISO_LOCAL_DATE
+    }
+}
