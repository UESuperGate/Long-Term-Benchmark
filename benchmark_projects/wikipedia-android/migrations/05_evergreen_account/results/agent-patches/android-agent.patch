@@ -0,0 +1,25 @@
+package org.wikipedia.evergreen.platform
+
+import org.json.JSONArray
+
+/**
+ * Ordered record of the production methods that took part in a decision.
+ *
+ * The page owner publishes the trace so that *how* the application reached a conclusion is
+ * observable, for example to confirm that a reader with a permanent account is rejected before
+ * the reading history store is ever queried.
+ */
+class MethodTrace {
+
+    private val entries = mutableListOf<String>()
+
+    fun record(method: String) {
+        entries.add(method)
+    }
+
+    fun methods(): List<String> = entries.toList()
+
+    fun contains(method: String): Boolean = entries.any { it == method }
+
+    fun toJsonArray(): JSONArray = JSONArray().also { array -> entries.forEach { array.put(it) } }
+}
