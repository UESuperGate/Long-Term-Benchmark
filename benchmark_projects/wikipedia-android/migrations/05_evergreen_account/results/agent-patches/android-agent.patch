@@ -0,0 +1,123 @@
+package org.wikipedia.evergreen.data
+
+import android.content.ContentValues
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+import java.time.Instant
+import java.time.LocalDate
+import java.time.ZoneId
+
+/** One article read, stored with the local calendar day it happened on. */
+data class ArticleRead(val project: String, val title: String, val day: LocalDate)
+
+/**
+ * Application owned store of article reads.
+ *
+ * Reads are kept exactly as they happened; the time windows that eligibility relies on are
+ * applied by the queries below, so history outside a window stays in the store and simply is
+ * not considered. Several reads on the same calendar day collapse into a single reading day.
+ */
+class ReadingHistoryStore(
+    context: Context,
+    private val zone: ZoneId = ZoneId.systemDefault(),
+) : SQLiteOpenHelper(context.applicationContext, DATABASE_NAME, null, DATABASE_VERSION) {
+
+    override fun onCreate(db: SQLiteDatabase) {
+        db.execSQL(CREATE_TABLE)
+        db.execSQL(CREATE_INDEX)
+    }
+
+    override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {
+        db.execSQL("DROP TABLE IF EXISTS $TABLE_READS")
+        onCreate(db)
+    }
+
+    fun recordRead(read: ArticleRead) {
+        writableDatabase.insert(TABLE_READS, null, valuesOf(read))
+    }
+
+    /** Replaces the stored history with [reads]; used to establish a launch fixture. */
+    fun replaceHistory(reads: List<ArticleRead>) {
+        val db = writableDatabase
+        db.beginTransaction()
+        try {
+            db.delete(TABLE_READS, null, null)
+            for (read in reads) {
+                db.insert(TABLE_READS, null, valuesOf(read))
+            }
+            db.setTransactionSuccessful()
+        } finally {
+            db.endTransaction()
+        }
+    }
+
+    /**
+     * Distinct local calendar days that contain at least one read strictly after [fromExclusive]
+     * and up to and including [through], oldest first.
+     */
+    fun distinctReadingDays(fromExclusive: LocalDate, through: LocalDate): List<LocalDate> {
+        val days = mutableListOf<LocalDate>()
+        readableDatabase.rawQuery(
+            "SELECT $COLUMN_READ_AT FROM $TABLE_READS " +
+                "WHERE $COLUMN_READ_AT > ? AND $COLUMN_READ_AT <= ? ORDER BY $COLUMN_READ_AT ASC",
+            windowArguments(fromExclusive, through),
+        ).use { cursor ->
+            while (cursor.moveToNext()) {
+                val day = dayOf(cursor.getLong(0))
+                if (!days.contains(day)) {
+                    days.add(day)
+                }
+            }
+        }
+        return days
+    }
+
+    fun readCount(fromExclusive: LocalDate, through: LocalDate): Int =
+        countInWindow("COUNT(*)", fromExclusive, through)
+
+    fun distinctArticleCount(fromExclusive: LocalDate, through: LocalDate): Int =
+        countInWindow("COUNT(DISTINCT $COLUMN_PROJECT || '#' || $COLUMN_TITLE)", fromExclusive, through)
+
+    private fun countInWindow(expression: String, fromExclusive: LocalDate, through: LocalDate): Int =
+        readableDatabase.rawQuery(
+            "SELECT $expression FROM $TABLE_READS " +
+                "WHERE $COLUMN_READ_AT > ? AND $COLUMN_READ_AT <= ?",
+            windowArguments(fromExclusive, through),
+        ).use { cursor -> if (cursor.moveToFirst()) cursor.getInt(0) else 0 }
+
+    private fun windowArguments(fromExclusive: LocalDate, through: LocalDate): Array<String> =
+        arrayOf(startOfDayMillis(fromExclusive).toString(), endOfDayMillis(through).toString())
+
+    private fun valuesOf(read: ArticleRead): ContentValues = ContentValues().apply {
+        put(COLUMN_PROJECT, read.project)
+        put(COLUMN_TITLE, read.title)
+        put(COLUMN_READ_AT, startOfDayMillis(read.day) + READ_TIME_OF_DAY_OFFSET_MILLIS)
+    }
+
+    private fun startOfDayMillis(day: LocalDate): Long =
+        day.atStartOfDay(zone).toInstant().toEpochMilli()
+
+    private fun endOfDayMillis(day: LocalDate): Long = startOfDayMillis(day.plusDays(1)) - 1L
+
+    private fun dayOf(millis: Long): LocalDate = Instant.ofEpochMilli(millis).atZone(zone).toLocalDate()
+
+    private companion object {
+        const val DATABASE_NAME = "evergreen-reading-history.db"
+        const val DATABASE_VERSION = 1
+        const val TABLE_READS = "reading_history"
+        const val COLUMN_PROJECT = "project"
+        const val COLUMN_TITLE = "title"
+        const val COLUMN_READ_AT = "read_at"
+        const val CREATE_TABLE =
+            "CREATE TABLE IF NOT EXISTS $TABLE_READS (" +
+                "$COLUMN_READ_AT INTEGER NOT NULL, " +
+                "$COLUMN_PROJECT TEXT NOT NULL, " +
+                "$COLUMN_TITLE TEXT NOT NULL)"
+        const val CREATE_INDEX =
+            "CREATE INDEX IF NOT EXISTS ${TABLE_READS}_$COLUMN_READ_AT ON $TABLE_READS ($COLUMN_READ_AT)"
+
+        /** Reads are stamped at local noon so that same-day ordering is deterministic. */
+        const val READ_TIME_OF_DAY_OFFSET_MILLIS = 12L * 60L * 60L * 1000L
+    }
+}
