@@ -0,0 +1,49 @@
+package org.wikipedia.evergreen.encouragement
+
+import org.wikipedia.evergreen.data.LaunchPromptStateRepository
+import org.wikipedia.evergreen.platform.MethodTrace
+
+/**
+ * Decides what a launch does with the account creation encouragement.
+ *
+ * An external article deep link wins outright: the requested article stays the destination and
+ * no impression is consumed. On an ordinary launch the encouragement is considered only after
+ * onboarding and the other higher priority launch prompts have completed, and is then handed to
+ * the eligibility rules.
+ */
+class LaunchPromptCoordinator(
+    private val launchPrompts: LaunchPromptStateRepository,
+    private val eligibility: AccountEncouragementEligibility,
+    private val trace: MethodTrace,
+) {
+
+    sealed class LaunchRequest {
+        object Ordinary : LaunchRequest()
+
+        data class ExternalArticle(val uri: String) : LaunchRequest()
+    }
+
+    data class Decision(val evaluated: Boolean, val shouldShow: Boolean, val reason: String)
+
+    fun evaluate(request: LaunchRequest): Decision = when (request) {
+        is LaunchRequest.ExternalArticle -> {
+            trace.record("launchPromptCoordinator.externalArticleTakesPrecedence")
+            Decision(evaluated = true, shouldShow = false, reason = REASON_EXTERNAL_ARTICLE)
+        }
+        is LaunchRequest.Ordinary -> evaluateOrdinaryLaunch()
+    }
+
+    private fun evaluateOrdinaryLaunch(): Decision {
+        trace.record("launchPromptCoordinator.isEncouragementAllowed")
+        if (!launchPrompts.isEncouragementAllowed()) {
+            return Decision(evaluated = true, shouldShow = false, reason = REASON_HIGHER_PRIORITY_PROMPT)
+        }
+        val result = eligibility.evaluate()
+        return Decision(evaluated = true, shouldShow = result.shouldShow, reason = result.reason)
+    }
+
+    companion object {
+        const val REASON_EXTERNAL_ARTICLE = "externalArticleDeepLinkTakesPrecedence"
+        const val REASON_HIGHER_PRIORITY_PROMPT = "higherPriorityLaunchPromptPending"
+    }
+}
