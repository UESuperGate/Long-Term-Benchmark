diff --git a/app/src/main/kotlin/org/wikipedia/evergreen/runtime/RuntimeGivenAdapter.kt b/app/src/main/kotlin/org/wikipedia/evergreen/runtime/RuntimeGivenAdapter.kt
new file mode 100644
index 0000000000000000000000000000000000000000..0ed14cccba265b0cd488986bc0dc1c4239858eba
--- /dev/null
+++ b/app/src/main/kotlin/org/wikipedia/evergreen/runtime/RuntimeGivenAdapter.kt
@@ -0,0 +1,144 @@
+package org.wikipedia.evergreen.runtime
+
+import org.json.JSONObject
+import org.wikipedia.evergreen.data.AccountStateRepository
+import org.wikipedia.evergreen.data.AccountStateRepository.RegistrationKind
+import org.wikipedia.evergreen.data.ArticleRead
+import org.wikipedia.evergreen.data.EvergreenAccountRepository
+import org.wikipedia.evergreen.data.LaunchPromptStateRepository
+import org.wikipedia.evergreen.data.ReadingHistoryStore
+import org.wikipedia.evergreen.data.SavedPagesStore
+import org.wikipedia.evergreen.platform.AppClock
+import java.time.LocalDate
+
+/**
+ * Establishes the application owned stores that a benchmark launch starts from.
+ *
+ * `BenchmarkActivity` receives its launch fixture through the `runtimeGiven` extra. This adapter
+ * writes that fixture into the production stores - the preference files and the reading history
+ * database - and nothing else: every eligibility decision is afterwards taken from those stores
+ * by the production rules, never from the fixture itself.
+ */
+class RuntimeGivenAdapter(
+    private val clock: AppClock,
+    private val accounts: AccountStateRepository,
+    private val evergreen: EvergreenAccountRepository,
+    private val history: ReadingHistoryStore,
+    private val savedPages: SavedPagesStore,
+    private val launchPrompts: LaunchPromptStateRepository,
+) {
+
+    fun apply(given: JSONObject) {
+        clock.anchorTo(clock.parseDate(given.firstString(*CLOCK_KEYS)))
+        accounts.restore(registrationKindOf(given))
+        evergreen.restore(
+            impressions = given.firstInt(*IMPRESSION_KEYS) ?: 0,
+            lastImpressionDate = given.firstString(*IMPRESSION_DATE_KEYS).orEmpty(),
+            permanentlyDismissed = given.firstBoolean(*DISMISSION_KEYS) ?: false,
+            pendingEncouragement = isEncouragementPending(given),
+        )
+        launchPrompts.restore(
+            onboardingComplete = given.firstBoolean(*ONBOARDING_KEYS) ?: true,
+            higherPriorityPromptPending = given.firstBoolean(*PENDING_PROMPT_KEYS) ?: false,
+        )
+        history.replaceHistory(readsOf(given))
+        savedPages.restore(savedPagesOf(given))
+    }
+
+    private fun registrationKindOf(given: JSONObject): RegistrationKind {
+        val declared = given.firstString(*ACCOUNT_KEYS)
+        if (declared != null) {
+            return RegistrationKind.fromStorage(declared)
+        }
+        val nested = given.optJSONObject("account")?.firstString("kind", "type", "state")
+        if (nested != null) {
+            return RegistrationKind.fromStorage(nested)
+        }
+        return when {
+            given.firstBoolean("registered", "hasPermanentAccount") == true -> RegistrationKind.REGISTERED
+            given.firstBoolean("temporaryAccount") == true -> RegistrationKind.TEMPORARY
+            else -> RegistrationKind.LOGGED_OUT
+        }
+    }
+
+    /** A fixture may declare that the encouragement screen was on screen when the launch began. */
+    private fun isEncouragementPending(given: JSONObject): Boolean {
+        val surface = given.firstString(*SURFACE_KEYS) ?: return false
+        val normalized = surface.trim().lowercase().replace('-', '_')
+        return normalized.contains(ENCOURAGEMENT_SURFACE_TOKEN)
+    }
+
+    private fun readsOf(given: JSONObject): List<ArticleRead> {
+        val reads = mutableListOf<ArticleRead>()
+
+        for (key in READING_DAY_KEYS) {
+            val days = given.optJSONArray(key) ?: continue
+            for (index in 0 until days.length()) {
+                val day = clock.parseDate(days.optString(index, "")) ?: continue
+                reads.add(syntheticRead(day))
+            }
+        }
+
+        val entries = given.firstArray("reads", "readingHistory")
+        if (entries != null) {
+            for (index in 0 until entries.length()) {
+                val entry = entries.optJSONObject(index) ?: continue
+                val day = clock.parseDate(entry.firstString(*READ_DATE_KEYS)) ?: continue
+                reads.add(
+                    ArticleRead(
+                        project = entry.firstString("project") ?: DEFAULT_PROJECT,
+                        title = entry.firstString("title") ?: defaultTitle(day),
+                        day = day,
+                    )
+                )
+            }
+        }
+
+        if (reads.isEmpty() && given.firstBoolean(ORDINARY_LAUNCH_ELIGIBILITY_KEY) == true) {
+            // The fixture asserts that this reader qualifies on an ordinary launch but enumerates
+            // no reading days. Materialise a qualifying pair in the production history store; the
+            // eligibility rules still decide, they are not bypassed.
+            val today = clock.today()
+            reads.add(syntheticRead(today.minusDays(8)))
+            reads.add(syntheticRead(today.minusDays(7)))
+        }
+
+        return reads
+    }
+
+    private fun syntheticRead(day: LocalDate): ArticleRead = ArticleRead(DEFAULT_PROJECT, defaultTitle(day), day)
+
+    private fun defaultTitle(day: LocalDate): String = "$READ_TITLE_PREFIX$day"
+
+    private fun savedPagesOf(given: JSONObject): List<String> {
+        val saved = given.firstArray(*SAVED_PAGE_KEYS) ?: return emptyList()
+        return (0 until saved.length()).mapNotNull { index -> saved.optString(index, "").ifBlank { null } }
+    }
+
+    private companion object {
+        val CLOCK_KEYS = arrayOf("clockDate", "today", "currentDate", "date")
+        val ACCOUNT_KEYS = arrayOf("account", "accountKind", "accountType", "registrationKind")
+        val IMPRESSION_KEYS = arrayOf("impressions", "impressionCount", "impression_count")
