+package org.wikipedia.search
+
+import kotlinx.serialization.Serializable
+import org.wikipedia.dataclient.ServiceFactory
+import org.wikipedia.dataclient.WikiSite
+import org.wikipedia.page.PageTitle
+import retrofit2.http.GET
+import retrofit2.http.Query
+
+/**
+ * A single section level hit produced by the semantic search backend.
+ *
+ * [title] is the article the hit belongs to and [sectionHeader] names the matched
+ * section inside that article. Section hits that are addressed as a single
+ * `Article#Section` string (as returned by the wiki semantic search) are split
+ * while the response is mapped, so the rest of the app only ever sees the split
+ * form.
+ */
+@Serializable
+class SemanticSearchResult(
+    val title: String = "",
+    val sectionHeader: String = "",
+    val sectionIndex: Int = 0,
+    val sectionText: String = "",
+    val url: String = ""
+) {
+
+    /** Article part of the hit. */
+    val articleTitle: String
+        get() = title.substringBefore(SECTION_SEPARATOR)
+
+    /** Section part of the hit, empty when the hit addresses a whole article. */
+    val matchedSectionHeader: String
+        get() = when {
+            sectionHeader.isNotEmpty() -> sectionHeader
+            title.contains(SECTION_SEPARATOR) -> title.substringAfter(SECTION_SEPARATOR)
+            else -> ""
+        }
+
+    /** Maps the hit onto the result model rendered as a semantic result card. */
+    fun toSearchResult(wikiSite: WikiSite): SearchResult = SearchResult(
+        pageTitle = PageTitle(articleTitle, wikiSite, matchedSectionHeader),
+        searchResultType = SearchResult.SearchResultType.SEMANTIC,
+        snippet = sectionText
+    )
+
+    companion object {
+        /** Separates the article from the section in `Article#Section` addresses. */
+        const val SECTION_SEPARATOR = '#'
+
+        /** Builds a hit from an `Article#Section` addressed wiki page title. */
+        fun fromPageTitle(pageTitle: String, sectionIndex: Int, sectionText: String = ""): SemanticSearchResult =
+            SemanticSearchResult(
+                title = pageTitle.substringBefore(SECTION_SEPARATOR),
+                sectionHeader = pageTitle.substringAfter(SECTION_SEPARATOR, ""),
+                sectionIndex = sectionIndex,
+                sectionText = sectionText
+            )
+    }
+}
+
+/** Response of a semantic search request. */
+@Serializable
+class SemanticSearchResults(
+    val languageCode: String = "",
+    val query: String = "",
+    val results: List<SemanticSearchResult> = emptyList()
+)
+
+/**
+ * Transport used by the semantic half of a hybrid search.
+ *
+ * The application owns request selection (which query, how many hits, which
+ * table and whether section text is included) and the mapping of the response
+ * onto semantic result cards; the transport itself only performs the request.
+ */
+interface SemanticSearchService {
+
+    @GET("semantic")
+    suspend fun search(
+        @Query("q") query: String,
+        @Query("limit") count: Int,
+        @Query("table") table: String,
+        @Query("include_text") includeText: Boolean
+    ): SemanticSearchResults
+
+    companion object {
+        const val BASE_URL = "https://api.wikimedia.org/service/search/v1"
+
+        /** Table holding the section level content served by the semantic endpoint. */
+        const val SEMANTIC_TABLE = "semantic_sections"
+
+        fun create(wikiSite: WikiSite): SemanticSearchService =
+            ServiceFactory.get(wikiSite, BASE_URL, SemanticSearchService::class.java)
+    }
+}
+
+/**
+ * Identifier of a hybrid search card: the article title, extended with the
+ * section header for section level (semantic) hits.
+ */
+val SearchResult.hybridSearchIdentifier: String
+    get() {
+        val section = pageTitle.fragment
+        return if (section.isEmpty()) pageTitle.prefixedText
+        else "${pageTitle.prefixedText}${SemanticSearchResult.SECTION_SEPARATOR}$section"
+    }
