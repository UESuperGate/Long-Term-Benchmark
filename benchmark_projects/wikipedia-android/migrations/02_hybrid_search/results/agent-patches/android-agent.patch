+package org.wikipedia.search
+
+import android.app.Activity
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.ComposeView
+import androidx.core.net.toUri
+import androidx.fragment.app.Fragment
+import androidx.fragment.app.viewModels
+import org.wikipedia.Constants
+import org.wikipedia.R
+import org.wikipedia.activity.FragmentUtil
+import org.wikipedia.analytics.eventplatform.BreadCrumbLogEvent
+import org.wikipedia.compose.theme.BaseTheme
+import org.wikipedia.dataclient.WikiSite
+import org.wikipedia.extensions.RuntimeInstrument
+import org.wikipedia.extensions.instrument
+import org.wikipedia.history.HistoryEntry
+import org.wikipedia.page.PageTitle
+import org.wikipedia.readinglist.LongPressMenu
+import org.wikipedia.settings.Prefs
+import org.wikipedia.util.FeedbackUtil
+import org.wikipedia.util.UriUtil
+
+/**
+ * Search results page.
+ *
+ * The fragment hosts both result modes: the paged standard search and, for
+ * readers the hybrid search experiment runs for, the combined lexical and
+ * semantic result list. It owns the mode of the page, the wiring of the rendered
+ * screen and every interaction that leaves the page - analytics, feedback and
+ * the persisted hybrid search opt in.
+ */
+class SearchResultsFragment : Fragment(), HybridSearchPageEffects {
+
+    private val viewModel: SearchResultsViewModel by lazy {
+        // The hosting search fragment owns the view model; fall back to a locally
+        // scoped one when the page is hosted on its own.
+        runCatching { viewModels<SearchResultsViewModel>().value }
+            .getOrElse { SearchResultsViewModel() }
+    }
+
+    private var showing = false
+
+    var showHybridSearch = false
+
+    val isShowing: Boolean
+        get() = showing
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?
+    ): View {
+        val composeView = ComposeView(requireContext())
+        composeView.setContent {
+            BaseTheme {
+                if (showHybridSearch) {
+                    renderHybridSearchResults()
+                } else {
+                    renderSearchResults()
+                }
+            }
+        }
+        return composeView
+    }
+
+    override fun onDestroyView() {
+        // The view model outlives the view, so only view scoped state is released here.
+        super.onDestroyView()
+    }
+
+    fun show() {
+        showing = true
+    }
+
+    fun hide() {
+        showing = false
+    }
+
+    fun setInvokeSource(invokeSource: Constants.InvokeSource) {
+        viewModel.invokeSource = invokeSource
+    }
+
+    /**
+     * Runs a search for [term]. In hybrid mode both search sources are queried,
+     * otherwise the paged standard search is refreshed.
+     */
+    fun startSearch(term: String?, force: Boolean, resetHybridSearch: Boolean) {
+        if (resetHybridSearch) {
+            viewModel.resetHybridSearchState()
+        }
+        val previousTerm = viewModel.searchTerm.value
+        viewModel.updateSearchTerm(term)
+        if (term.isNullOrEmpty()) {
+            return
+        }
+        if (showHybridSearch && viewModel.isHybridSearchAvailable()) {
+            if (force || term != previousTerm) {
+                viewModel.loadHybridSearchResults()
+            }
+        } else {
+            viewModel.refreshSearchResults()
+        }
+    }
+
+    private fun renderSearchResults() {
+        SearchResultsScreen(
+            viewModel = viewModel,
+            modifier = Modifier.fillMaxSize(),
+            onNavigateToTitle = { pageTitle, inNewTab, position, location ->
+                navigateToResult(pageTitle, inNewTab, position, location)
+            },
+            onItemLongClick = { view, result, position ->
+                showResultLongPressMenu(view, result, position)
+            },
+            onSemanticSearchClick = { term, _, position ->
+                onSemanticSearchRequested(term, position)
+            },
+            onCloseSearch = { hide() },
+            onRetrySearch = { viewModel.refreshSearchResults() },
+            onLanguageClick = { position -> onLanguageRowSelected(position) },
+            onLoading = { enabled -> onLoadingChanged(enabled) },
+            onNoResults = { onLoadingChanged(false) }
+        )
+    }
+
+    private fun renderHybridSearchResults() {
+        HybridSearchResultsScreen(
+            viewModel = viewModel,
+            modifier = Modifier.fillMaxSize(),
+            onNavigateToTitle = { pageTitle, inNewTab, position, location ->
+                navigateToResult(pageTitle, inNewTab, position, location)
+            },
+            onSemanticCardImpression = { result, position ->
+                onSemanticCardImpression(result, position)
+            },
+            onSemanticItemClick = { pageTitle, inNewTab, isSemantic, position, location ->
+                onSemanticResultSelected(pageTitle, inNewTab, isSemantic, position, location)
+            },
+            onItemLongClick = { view, result, position ->
+                showResultLongPressMenu(view, result, position)
+            },
+            onInfoClick = { openHybridSearchInfo() },
+            onTurnOffExperimentClick = { term -> onTurnOffHybridSearch(term) },
+            onCloseSearch = { hide() },
+            onRetrySearch = { retryHybridSearch() },
+            onLoading = { enabled -> onLoadingChanged(enabled) },
+            onRatingClick = { positive, pageTitle, position ->
+                onSemanticResultRated(positive, pageTitle, position)
+            },
+            onLexicalResultsEmpty = { onSourceResultsEmpty(lexical = true) },
+            onSemanticResultsEmpty = { onSourceResultsEmpty(lexical = false) },
+            onError = { throwable -> onHybridSearchError(throwable) }
+        )
+    }
+
+    /** Enters hybrid mode for the query that is on screen. */
+    private fun onSemanticSearchRequested(term: String, position: Int) {
+        if (!viewModel.isHybridSearchAvailable()) {
+            return
+        }
+        showHybridSearch = true
+        startSearch(term.ifEmpty { viewModel.searchTerm.value.orEmpty() }, force = true, resetHybridSearch = true)
+    }
+
+    /** Runs both sources again after a failed or partial search. */
+    private fun retryHybridSearch() {
+        if (showHybridSearch && viewModel.isHybridSearchAvailable()) {
+            viewModel.loadHybridSearchResults()
+        } else {
+            viewModel.refreshSearchResults()
+        }
+    }
+
+    /**
+     * Opts the reader out of the experiment: the preference is persisted, the page
+     * leaves hybrid mode and the query is handed back to standard search.
+     */
+    private fun onTurnOffHybridSearch(term: String) {
+        showHybridSearch = false
+        persistHybridSearchPreference(false)
+        startSearch(term, force = true, resetHybridSearch = true)
+        callback()?.setSearchText(term)
+    }
+
+    /**
+     * Sends the rating of a semantic card to analytics. Positions are zero based
+     * in the rendered list and one based in telemetry.
+     */
+    private fun onSemanticResultRated(positive: Boolean, pageTitle: PageTitle, position: Int) {
+        instrument()?.submitInteraction(
+            name = "click",
+            elementId = if (positive) {
+                HybridSearchPageActionPrefix.FEEDBACK_POSITIVE
+            } else {
+                HybridSearchPageActionPrefix.FEEDBACK_NEGATIVE
+            },
+            pageData = pageTitle,
+            actionContext = viewModel.getEventActionContext() + mapOf(
+                HybridSearchPageActionPrefix.FEEDBACK_POSITION to position + 1
+            )
+        )
+    }
+
+    /** Maps the semantic card that is shown to a result position. */
+    private fun onSemanticCardImpression(result: SearchResult, position: Int) {
+        instrument()?.submitInteraction(
+            name = "impression",
+            elementId = "semantic_search_result",
+            pageData = result.pageTitle,
+            actionContext = viewModel.getEventActionContext() + mapOf(
+                HybridSearchPageActionPrefix.FEEDBACK_POSITION to position + 1
+            )
+        )
+    }
+
+    private fun onSemanticResultSelected(
+        pageTitle: PageTitle,
+        inNewTab: Boolean,
+        isSemantic: Boolean,
+        position: Int,
+        location: Any?
+    ) {
+        instrument()?.submitInteraction(
+            name = "click",
+            elementId = "semantic_search_result",
+            pageData = pageTitle,
+            actionContext = viewModel.getEventActionContext() + mapOf(
+                HybridSearchPageActionPrefix.FEEDBACK_POSITION to position + 1
+            )
+        )
+        navigateToResult(pageTitle, inNewTab, position, location)
+    }
+
+    private fun navigateToResult(pageTitle: PageTitle, inNewTab: Boolean, position: Int, location: Any?) {
+        BreadCrumbLogEvent.logMap(requireContext(), viewModel.getBreadcrumbActionContext())
+        callback()?.navigateToTitle(pageTitle, inNewTab, position, location)
+    }
+
+    private fun showResultLongPressMenu(view: View, result: SearchResult, position: Int) {
+        LongPressMenu(view, callback()).show(HistoryEntry(result.pageTitle, HistoryEntry.SOURCE_SEARCH))
+    }
+
+    private fun onLanguageRowSelected(position: Int) {
+        (requireParentFragment() as? SearchFragment)?.setUpLanguageScroll(position)
+    }
+
+    private fun onLoadingChanged(enabled: Boolean) {
+        callback()?.onSearchProgressBar(enabled)
+    }
+
+    /** Explains a source that returned nothing while the other one answered. */
+    private fun onSourceResultsEmpty(lexical: Boolean) {
+        val activity = activityOrNull() ?: return
+        FeedbackUtil.showMessage(
+            activity,
+            if (lexical) {
+                R.string.hybrid_lexical_search_results_empty
+            } else {
+                R.string.hybrid_search_results_empty
+            }
+        )
+    }
+
+    private fun onHybridSearchError(throwable: Throwable) {
+        val activity = activityOrNull() ?: return
+        FeedbackUtil.showMessage(activity, R.string.hybrid_search_results_empty)
+    }
+
+    private fun openHybridSearchInfo() {
+        val activity = activityOrNull() ?: return
+        UriUtil.visitInExternalBrowser(activity, HYBRID_SEARCH_INFO_URL.toUri())
+    }
+
+    /** Rating of a semantic card requested by the page owner. */
+    override fun submitFeedback(payload: Map<String, Any>) {
+        val title = payload[HybridSearchPageActionPrefix.FEEDBACK_TITLE]?.toString().orEmpty()
+        if (title.isEmpty()) {
+            return
+        }
+        val position = (payload[HybridSearchPageActionPrefix.FEEDBACK_POSITION] as? Number)?.toInt() ?: 0
+        val positive = payload[HybridSearchPageActionPrefix.FEEDBACK_ELEMENT_ID]?.toString() ==
+            HybridSearchPageActionPrefix.FEEDBACK_POSITIVE
+        onSemanticResultRated(
+            positive,
+            PageTitle(title, WikiSite.forLanguageCode(viewModel.languageCode.value)),
+            position
+        )
+    }
+
+    /** Hands the query that is on screen back to standard search. */
+    override fun requestStandardSearch(query: String) {
+        showHybridSearch = false
+        startSearch(query, force = true, resetHybridSearch = true)
+        callback()?.setSearchText(query)
+    }
+
+    private fun callback(): SearchResultCallback? =
+        FragmentUtil.getCallback(this, SearchResultCallback::class.java)
+
+    private fun activityOrNull(): Activity? = try {
+        requireActivity()
+    } catch (e: Exception) {
+        null
+    }
+
+    private fun instrument(): RuntimeInstrument? = activityOrNull()?.instrument
+
+    private fun persistHybridSearchPreference(enabled: Boolean) {
+        try {
+            Prefs.isHybridSearchEnabled = enabled
+        } catch (e: Exception) {
+            // The preference store is not available; the page state still changes.
+        }
+    }
+
+    companion object {
+        private const val HYBRID_SEARCH_INFO_URL = "https://meta.wikimedia.org/wiki/Wikipedia_Search"
+    }
+}
