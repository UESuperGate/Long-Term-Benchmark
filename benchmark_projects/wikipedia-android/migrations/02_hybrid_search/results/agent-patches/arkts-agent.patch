@@ -0,0 +1,218 @@
+/**
+ * Shared contracts for the Wikipedia hybrid search experience.
+ *
+ * A reader who is eligible for the lexical/semantic experiment submits a single
+ * query and receives two result sources from it. Everything in this file is a
+ * stable application contract: the page store owns the composition, the view
+ * model owns the concurrency and the merge, and the transports below are the
+ * external leaves that the rest of the application is allowed to substitute.
+ */
+
+/** Page phases shared by the hybrid flow and the standard search fallback. */
+export const HYBRID_PHASE_IDLE: string = 'idle';
+export const HYBRID_PHASE_LOADING: string = 'loading';
+export const HYBRID_PHASE_SUCCESS: string = 'success';
+export const HYBRID_PHASE_ERROR: string = 'error';
+export const HYBRID_PHASE_STANDARD_SUCCESS: string = 'standard_success';
+
+/** Search modes owned by the page store. */
+export const MODE_STANDARD: string = 'standard';
+export const MODE_HYBRID: string = 'hybrid';
+
+/** Identifiers of the two result groups rendered on the page. */
+export const LEXICAL_SOURCE_ID: string = 'lexical';
+export const SEMANTIC_SOURCE_ID: string = 'semantic';
+
+/** Experiment assignments that receive the hybrid result page. */
+export const EXPERIMENT_GROUP_LEXICAL_FIRST: string = 'lexicalsemantic';
+export const EXPERIMENT_GROUP_SEMANTIC_FIRST: string = 'semanticlexical';
+
+/** Feedback element ids produced when a reader rates a semantic result. */
+export const SEMANTIC_POSITIVE_ELEMENT_ID: string = 'hybrid_search_semantic_positive';
+export const SEMANTIC_NEGATIVE_ELEMENT_ID: string = 'hybrid_search_semantic_negative';
+
+/** Notices rendered when a source group cannot contribute results. */
+export const NOTICE_SEMANTIC_UNAVAILABLE: string =
+  'Semantic results are not available for this search. Showing lexical results only.';
+export const NOTICE_LEXICAL_UNAVAILABLE: string =
+  'Lexical results are not available for this search. Showing semantic results only.';
+export const NOTICE_NO_RESULTS: string = 'No results were found for this search.';
+export const NOTICE_BOTH_SOURCES_FAILED: string =
+  'Lexical and semantic search are both unavailable. Check your connection and retry.';
+
+/** Languages the hybrid search rollout is enabled for. */
+const SUPPORTED_HYBRID_LANGUAGES: string[] = [
+  'ar', 'az', 'bg', 'bn', 'bs', 'ca', 'cs', 'cy', 'da', 'de', 'el', 'en', 'eo', 'es', 'et', 'eu',
+  'fa', 'fi', 'fr', 'ga', 'gl', 'he', 'hi', 'hr', 'hu', 'hy', 'id', 'is', 'it', 'ja', 'ka', 'kk',
+  'km', 'kn', 'ko', 'lt', 'lv', 'mk', 'ml', 'mr', 'ms', 'nl', 'no', 'pl', 'pt', 'ro', 'ru', 'si',
+  'sk', 'sl', 'sq', 'sr', 'sv', 'sw', 'ta', 'te', 'th', 'tr', 'uk', 'ur', 'uz', 'vi', 'zh'
+];
+
+/**
+ * Controlled transport leaf: the three search sources used by hybrid search.
+ * Failures are surfaced by rejecting the returned promise.
+ */
+export interface SearchHttpLeaf {
+  prefix(query: string, language: string): Promise<string[]>;
+
+  fullText(query: string, language: string): Promise<string[]>;
+
+  semantic(query: string, language: string): Promise<string[]>;
+}
+
+/** Feedback record produced when the reader rates a semantic result. */
+export interface FeedbackPayload {
+  elementId: string;
+
+  query: string;
+
+  /** One-based telemetry position of the rated result. */
+  position: number;
+
+  title: string;
+}
+
+/** Controlled feedback/analytics leaf. */
+export interface FeedbackLeaf {
+  submit(payload: FeedbackPayload): Promise<void>;
+}
+
+/** Controlled leaf used when the page hands a query back to standard search. */
+export interface StandardSearchLeaf {
+  request(query: string): void;
+}
+
+/** Rendered state of the hybrid search page. */
+export interface HybridSearchState {
+  phase: string;
+
+  lexicalTitles: string[];
+
+  semanticTitles: string[];
+
+  notice?: string;
+
+  retryAvailable: boolean;
+}
+
+/** Reader, experiment and preference context that gates the hybrid page. */
+export interface HybridSearchSettings {
+  language: string;
+
+  experimentGroup: string;
+
+  remoteEnabled: boolean;
+
+  hybridEnabled: boolean;
+
+  /**
+   * Persisted opt-in preference. When supplied it is authoritative for
+   * eligibility; otherwise {@link hybridEnabled} supplies the default.
+   */
+  preferenceEnabled?: boolean;
+
+  query: string;
+}
+
+/** Semantic hit mapped into a result card, keeping section/snippet detail. */
+export interface SemanticResultCard {
+  title: string;
+
+  sectionHeader: string;
+
+  sectionIndex: number;
+
+  snippet: string;
+
+  /** Title as reported by the semantic source, including any section anchor. */
+  displayTitle: string;
+}
+
+/** Outcome of the lexical branch of a search. */
+export interface LexicalSourceResult {
+  succeeded: boolean;
+
+  titles: string[];
+}
+
+/** Outcome of the semantic branch of a search. */
+export interface SemanticSourceResult {
+  succeeded: boolean;
+
+  titles: string[];
+
+  cards: SemanticResultCard[];
+}
+
+/** True when the experiment assignment renders the hybrid result page. */
+export function isHybridExperimentGroup(group: string): boolean {
+  const value = optionalText(group).trim();
+  return value === EXPERIMENT_GROUP_LEXICAL_FIRST || value === EXPERIMENT_GROUP_SEMANTIC_FIRST;
+}
+
+/** Result group order defined by the experiment assignment. */
+export function hybridSourceOrder(group: string): string[] {
+  const value = optionalText(group).trim();
+  if (value === EXPERIMENT_GROUP_SEMANTIC_FIRST) {
+    return [SEMANTIC_SOURCE_ID, LEXICAL_SOURCE_ID];
+  }
+  return [LEXICAL_SOURCE_ID, SEMANTIC_SOURCE_ID];
+}
+
+/** True when the reader's language is part of the hybrid search rollout. */
+export function isSupportedHybridLanguage(language: string): boolean {
+  const value = optionalText(language).trim().toLowerCase();
+  if (value.length === 0) {
+    return false;
+  }
+  return SUPPORTED_HYBRID_LANGUAGES.indexOf(value) >= 0;
+}
+
+/** Defensive text coercion for values crossing the page boundary. */
+export function optionalText(value: string | undefined): string {
+  if (value === undefined || value === null) {
+    return '';
+  }
+  return value;
+}
+
+/**
+ * Resolves the reader's opt-in from the settings supplied at composition.
+ *
+ * A persisted {@link HybridSearchSettings.preferenceEnabled} value wins when
+ * present; otherwise the settings-level {@link HybridSearchSettings.hybridEnabled}
+ * flag supplies the default. An absent value defaults to opted in, which is
+ * what a reader who has never seen the opt-out screen should get.
+ */
+export function resolveHybridOptIn(settings: HybridSearchSettings): boolean {
+  const persisted = settings.preferenceEnabled;
+  if (persisted !== undefined && persisted !== null) {
+    return persisted === true;
+  }
+  return settings.hybridEnabled !== false;
+}
+
+/** Article title without its section anchor. */
+export function baseTitle(displayTitle: string): string {
+  const value = optionalText(displayTitle);
+  const anchor = value.indexOf('#');
+  return anchor >= 0 ? value.substring(0, anchor) : value;
+}
+
+/** Builds the ordered notice for a completed merge. */
+export function buildMergeNotice(
+  lexicalSucceeded: boolean, lexicalCount: number,
+  semanticSucceeded: boolean, semanticCount: number): string {
+  const lexicalEmpty = lexicalCount === 0;
+  const semanticEmpty = semanticCount === 0;
+  if (lexicalEmpty && semanticEmpty) {
+    return NOTICE_NO_RESULTS;
+  }
+  if (!lexicalSucceeded || lexicalEmpty) {
+    return NOTICE_LEXICAL_UNAVAILABLE;
+  }
+  if (!semanticSucceeded || semanticEmpty) {
+    return NOTICE_SEMANTIC_UNAVAILABLE;
+  }
+  return '';
+}
