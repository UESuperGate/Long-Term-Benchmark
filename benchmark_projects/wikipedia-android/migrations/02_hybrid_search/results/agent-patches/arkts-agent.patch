index 0000000..13c280d
--- /dev/null
+++ b/entry/src/main/ets/model/HybridSearchPageStore.ets
@@ -0,0 +1,325 @@
+import { common } from '@kit.AbilityKit';
+import { preferences } from '@kit.ArkData';
+import {
+  FeedbackLeaf,
+  FeedbackPayload,
+  HybridSearchSettings,
+  HybridSearchState,
+  LEXICAL_SOURCE_ID,
+  MODE_HYBRID,
+  MODE_STANDARD,
+  SEMANTIC_NEGATIVE_ELEMENT_ID,
+  SEMANTIC_POSITIVE_ELEMENT_ID,
+  SEMANTIC_SOURCE_ID,
+  SearchHttpLeaf,
+  StandardSearchLeaf,
+  baseTitle,
+  hybridSourceOrder,
+  isHybridExperimentGroup,
+  isSupportedHybridLanguage,
+  optionalText,
+  resolveHybridOptIn,
+  HYBRID_PHASE_SUCCESS
+} from './HybridSearchModels';
+import { HybridSearchViewModel } from './HybridSearchViewModel';
+
+/**
+ * Page store for the hybrid search experience.
+ *
+ * The store owns everything the ArkUI page does: experiment gating, the
+ * persisted opt-in preference, the rendered mode, semantic feedback mapping,
+ * retry and opt-out. It delegates result production to a real
+ * {@link HybridSearchViewModel}, which in turn talks to the controlled
+ * transport leaves.
+ */
+
+/** ArkData store holding the reader's hybrid search opt-in. */
+const PREFERENCE_STORE_NAME: string = 'hybrid_search';
+const HYBRID_ENABLED_KEY: string = 'hybrid_search_enabled';
+
+export class HybridSearchPageStore {
+  readonly viewModel: HybridSearchViewModel;
+
+  /** Rendered mode: 'standard' or 'hybrid'. */
+  mode: string;
+
+  private query: string;
+  private http: SearchHttpLeaf;
+  private feedback: FeedbackLeaf;
+  private standardSearch: StandardSearchLeaf;
+  private experimentGroup: string;
+  private language: string;
+  private remoteEnabled: boolean;
+  private preferenceEnabled: boolean;
+  private preferenceStore: preferences.Preferences | undefined;
+  private disposed: boolean;
+  private opened: boolean;
+
+  private constructor(
+    context: common.UIAbilityContext,
+    settings: HybridSearchSettings,
+    http: SearchHttpLeaf,
+    feedback: FeedbackLeaf,
+    standardSearch: StandardSearchLeaf
+  ) {
+    this.query = optionalText(settings.query);
+    this.language = optionalText(settings.language);
+    this.experimentGroup = optionalText(settings.experimentGroup);
+    this.remoteEnabled = settings.remoteEnabled !== false;
+    this.http = http;
+    this.feedback = feedback;
+    this.standardSearch = standardSearch;
+    this.viewModel = new HybridSearchViewModel(http);
+    this.viewModel.experimentGroup = this.experimentGroup;
+    this.mode = MODE_STANDARD;
+    this.preferenceEnabled = resolveHybridOptIn(settings);
+    this.preferenceStore = undefined;
+    this.disposed = false;
+    this.opened = false;
+  }
+
+  /**
+   * Production composition entry: builds the page store with the supplied
+   * controlled leaves and restores the persisted opt-in preference.
+   */
+  static async create(
+    context: common.UIAbilityContext,
+    settings: HybridSearchSettings,
+    http: SearchHttpLeaf,
+    feedback: FeedbackLeaf,
+    standardSearch: StandardSearchLeaf
+  ): Promise<HybridSearchPageStore> {
+    const store = new HybridSearchPageStore(context, settings, http, feedback, standardSearch);
+    await store.openPreferenceStore(context);
+    await store.restorePreference();
+    return store;
+  }
+
+  /** Eligible readers opt into the hybrid result page here. */
+  openHybrid(): void {
+    if (this.disposed) {
+      return;
+    }
+    if (!this.isEligible()) {
+      return;
+    }
+    this.opened = true;
+    this.mode = MODE_HYBRID;
+    this.viewModel.reset();
+  }
+
+  /** Submits the current query; hybrid when eligible, standard otherwise. */
+  async submit(): Promise<HybridSearchState> {
+    if (this.disposed) {
+      return this.viewModel.state;
+    }
+    if (this.query.trim().length === 0) {
+      return this.viewModel.state;
+    }
+    if (this.isEligible()) {
+      this.opened = true;
+      this.mode = MODE_HYBRID;
+      return await this.viewModel.search(this.query, this.language);
+    }
+    this.mode = MODE_STANDARD;
+    this.standardSearch.request(this.query);
+    this.viewModel.showStandardResults();
+    return this.viewModel.state;
+  }
+
+  /** Re-executes both source requests through the surviving view model. */
+  async retry(): Promise<HybridSearchState> {
+    if (this.disposed) {
+      return this.viewModel.state;
+    }
+    if (this.mode !== MODE_HYBRID) {
+      return await this.submit();
+    }
+    return await this.viewModel.retry();
+  }
+
+  /** Page-owned feedback mapping for a rated semantic result. */
+  async rate(title: string, position: number, positive: boolean): Promise<void> {
+    if (this.disposed) {
+      return;
+    }
+    const state = this.viewModel.state;
+    const target = this.resolveSemanticTitle(state.semanticTitles, optionalText(title), position);
+    const payload: FeedbackPayload = {
+      elementId: positive ? SEMANTIC_POSITIVE_ELEMENT_ID : SEMANTIC_NEGATIVE_ELEMENT_ID,
+      query: this.query,
+      position: Math.max(0, position) + 1,
+      title: target
+    };
+    try {
+      await this.feedback.submit(payload);
+    } catch (error) {
+      console.error('hybrid search: semantic feedback was not recorded');
+    }
+  }
+
+  /** Opts out: persists the preference and returns to standard search. */
+  async optOut(): Promise<void> {
+    if (this.disposed) {
+      return;
+    }
+    this.preferenceEnabled = false;
+    await this.writePreference(false);
+    this.opened = false;
+    this.mode = MODE_STANDARD;
+    this.viewModel.reset();
+    this.standardSearch.request(this.query);
+  }
+
+  /** Reader edited the query; no request is started until submission. */
+  updateQuery(query: string): void {
+    if (this.disposed) {
+      return;
+    }
+    this.query = optionalText(query);
+  }
+
+  /** Section identifiers to render, in the experiment-defined order. */
+  sections(): string[] {
+    if (this.disposed || this.mode !== MODE_HYBRID) {
+      return [];
+    }
+    const state = this.viewModel.state;
+    if (state.phase !== HYBRID_PHASE_SUCCESS) {
+      return [];
+    }
+    const order = this.viewModel.sourceOrder();
+    const sections: string[] = [];
+    for (let index = 0; index < order.length; index++) {
+      const id = order[index];
+      if (this.hasResults(state, id)) {
+        sections.push(id);
+      }
+    }
+    return sections;
+  }
+
+  /** True when the reader is gated into the hybrid experience. */
+  isEligible(): boolean {
+    if (this.disposed) {
+      return false;
+    }
+    return this.preferenceEnabled === true
+      && this.remoteEnabled
+      && isHybridExperimentGroup(this.experimentGroup)
+      && isSupportedHybridLanguage(this.language);
+  }
+
+  /** True when the page is currently rendering hybrid results. */
+  isHybridMode(): boolean {
+    return !this.disposed && this.mode === MODE_HYBRID && this.opened;
+  }
+
+  /** Persisted opt-in preference currently applied to this page. */
+  isPreferenceEnabled(): boolean {
+    return this.preferenceEnabled;
+  }
+
+  /** The query the page is currently working with. */
+  currentQuery(): string {
+    return this.query;
+  }
+
+  /** The controlled transport the page owns. */
+  transport(): SearchHttpLeaf {
+    return this.http;
+  }
+
+  /** Releases the page and cancels in-flight work. */
+  dispose(): void {
+    if (this.disposed) {
+      return;
+    }
+    this.disposed = true;
+    this.viewModel.dispose();
+  }
+
+  private hasResults(state: HybridSearchState, id: string): boolean {
+    if (id === LEXICAL_SOURCE_ID) {
+      return state.lexicalTitles.length > 0;
+    }
+    if (id === SEMANTIC_SOURCE_ID) {
+      return state.semanticTitles.length > 0;
+    }
+    return false;
+  }
+
+  /**
+   * Resolves the rated card. The UI passes the rendered title, so an exact
+   * match, then an article-title match, then the list position is used.
+   */
+  private resolveSemanticTitle(titles: string[], title: string, position: number): string {
+    if (title.length === 0) {
+      return '';
+    }
+    for (let index = 0; index < titles.length; index++) {
+      if (titles[index] === title) {
+        return title;
+      }
+    }
+    const wantedBase = baseTitle(title);
+    for (let index = 0; index < titles.length; index++) {
+      if (baseTitle(titles[index]) === wantedBase) {
+        return titles[index];
+      }
+    }
+    if (position >= 0 && position < titles.length) {
+      return titles[position];
+    }
+    return title;
+  }
