+    if (context === undefined || context === null) {
+      return;
+    }
+    const options: preferences.Options = { name: PREFERENCE_STORE_NAME };
+    try {
+      this.preferenceStore = preferences.getPreferencesSync(context, options);
+    } catch (error) {
+      this.preferenceStore = undefined;
+    }
+    if (this.preferenceStore !== undefined) {
+      return;
+    }
+    try {
+      this.preferenceStore = await preferences.getPreferences(context, options);
+    } catch (error) {
+      console.error('hybrid search: hybrid opt-in store is unavailable');
+      this.preferenceStore = undefined;
+    }
+  }
+
+  private async restorePreference(): Promise<void> {
+    const store = this.preferenceStore;
+    if (store === undefined) {
+      return;
+    }
+    try {
+      const stored = await store.get(HYBRID_ENABLED_KEY, this.preferenceEnabled);
+      if (stored !== undefined && stored !== null) {
+        this.preferenceEnabled = stored === true;
+      }
+    } catch (error) {
+      console.error('hybrid search: hybrid opt-in preference could not be restored');
+    }
+  }
+
+  private async writePreference(enabled: boolean): Promise<void> {
+    const store = this.preferenceStore;
+    if (store === undefined) {
+      return;
+    }
+    try {
+      await store.put(HYBRID_ENABLED_KEY, enabled);
+      await store.flush();
+    } catch (error) {
+      console.error('hybrid search: hybrid opt-in preference could not be persisted');
+    }
+  }
