+import {
+  EXPERIMENT_GROUP_LEXICAL_FIRST,
+  HybridSearchState,
+  HYBRID_PHASE_ERROR,
+  HYBRID_PHASE_IDLE,
+  HYBRID_PHASE_LOADING,
+  HYBRID_PHASE_STANDARD_SUCCESS,
+  HYBRID_PHASE_SUCCESS,
+  LexicalSourceResult,
+  NOTICE_BOTH_SOURCES_FAILED,
+  SearchHttpLeaf,
+  SemanticResultCard,
+  SemanticSourceResult,
+  buildMergeNotice,
+  hybridSourceOrder,
+  optionalText
+} from './HybridSearchModels';
+
+/** Number of lexical results the page renders in total. */
+export const LEXICAL_RESULT_CAPACITY: number = 20;
+
+/**
+ * Owns the concurrent dispatch, the prefix/full-text fallback, the semantic
+ * mapping and the merge of the two result sources.
+ *
+ * The page store owns mode, persistence and analytics; this view model owns
+ * everything that turns one query into one combined result set.
+ */
+export class HybridSearchViewModel {
+  state: HybridSearchState;
+
+  /** Experiment assignment that decides the rendered group order. */
+  experimentGroup: string;
+
+  private http: SearchHttpLeaf;
+  private activeQuery: string;
+  private activeLanguage: string;
+  private generation: number;
+  private disposed: boolean;
+  private cards: SemanticResultCard[];
+
+  constructor(http: SearchHttpLeaf) {
+    this.http = http;
+    this.experimentGroup = EXPERIMENT_GROUP_LEXICAL_FIRST;
+    this.state = this.emptyState(HYBRID_PHASE_IDLE);
+    this.activeQuery = '';
+    this.activeLanguage = '';
+    this.generation = 0;
+    this.disposed = false;
+    this.cards = [];
+  }
+
+  /**
+   * Runs a hybrid search for a non-empty query. The lexical and the semantic
+   * transports are both entered before either result is awaited.
+   */
+  async search(query: string, language: string): Promise<HybridSearchState> {
+    if (this.disposed) {
+      return this.state;
+    }
+    const trimmed = optionalText(query).trim();
+    if (trimmed.length === 0) {
+      this.reset();
+      return this.state;
+    }
+    return await this.execute(trimmed, optionalText(language));
+  }
+
+  /** Re-runs the last submitted query through the same transports. */
+  async retry(): Promise<HybridSearchState> {
+    if (this.disposed || this.activeQuery.length === 0) {
+      return this.state;
+    }
+    return await this.execute(this.activeQuery, this.activeLanguage);
+  }
+
+  /** Drops any in-flight work and returns the page to its idle state. */
+  reset(): void {
+    this.generation++;
+    this.activeQuery = '';
+    this.activeLanguage = '';
+    this.cards = [];
+    this.state = this.emptyState(HYBRID_PHASE_IDLE);
+  }
+
+  /** Reports that the page handed the query back to standard search. */
+  showStandardResults(): void {
+    this.reset();
+    this.state = this.emptyState(HYBRID_PHASE_STANDARD_SUCCESS);
+  }
+
+  /** Cancels in-flight work when the owning page goes away. */
+  dispose(): void {
+    this.disposed = true;
+    this.generation++;
+    this.cards = [];
+  }
+
+  /** Ordered result group identifiers for the current experiment assignment. */
+  sourceOrder(): string[] {
+    return hybridSourceOrder(this.experimentGroup);
+  }
+
+  /** Semantic cards of the last successful semantic response. */
+  semanticCards(): SemanticResultCard[] {
+    return this.cards.slice();
+  }
+
+  private async execute(query: string, language: string): Promise<HybridSearchState> {
+    const run = ++this.generation;
+    this.activeQuery = query;
+    this.activeLanguage = language;
+    this.cards = [];
+    this.state = this.emptyState(HYBRID_PHASE_LOADING);
+
+    // Both branches are entered here, so both transports receive the request
+    // before either of them is awaited.
+    const lexicalBranch = this.loadLexical(query, language);
+    const semanticBranch = this.loadSemantic(query, language);
+
+    const lexical: LexicalSourceResult = await lexicalBranch;
+    const semantic: SemanticSourceResult = await semanticBranch;
+
+    if (this.disposed || run !== this.generation) {
+      return this.state;
+    }
+    return this.merge(lexical, semantic);
+  }
+
+  /**
+   * Lexical body: prefix search first, remaining capacity filled with
+   * full-text results, duplicate titles removed.
+   */
+  private async loadLexical(query: string, language: string): Promise<LexicalSourceResult> {
+    try {
+      const prefixTitles = await this.http.prefix(query, language);
+      const titles: string[] = [];
+      this.collectUnique(titles, prefixTitles, LEXICAL_RESULT_CAPACITY);
+
+      if (titles.length < LEXICAL_RESULT_CAPACITY) {
+        const fullTextTitles = await this.http.fullText(query, language);
+        this.collectUnique(titles, fullTextTitles, LEXICAL_RESULT_CAPACITY);
+      }
+      return { succeeded: true, titles: titles };
+    } catch (error) {
+      console.error('hybrid search: lexical source failed for ' + query);
+      return { succeeded: false, titles: [] };
+    }
+  }
+
+  /** Semantic body: maps the response into semantic result cards. */
+  private async loadSemantic(query: string, language: string): Promise<SemanticSourceResult> {
+    try {
+      const rawTitles = await this.http.semantic(query, language);
+      const titles: string[] = [];
+      const cards: SemanticResultCard[] = [];
+      for (let index = 0; index < rawTitles.length; index++) {
+        const card = HybridSearchViewModel.toCard(rawTitles[index]);
+        if (card.displayTitle.length === 0 || titles.indexOf(card.displayTitle) >= 0) {
+          continue;
+        }
+        titles.push(card.displayTitle);
+        cards.push(card);
+      }
+      return { succeeded: true, titles: titles, cards: cards };
+    } catch (error) {
+      console.error('hybrid search: semantic source failed for ' + query);
+      return { succeeded: false, titles: [], cards: [] };
+    }
+  }
+
+  /**
+   * Merge body: a surviving source is never discarded because the other
+   * source failed; only a complete failure becomes an error state.
+   */
+  private merge(lexical: LexicalSourceResult, semantic: SemanticSourceResult): HybridSearchState {
+    if (!lexical.succeeded && !semantic.succeeded) {
+      this.cards = [];
+      this.state = {
+        phase: HYBRID_PHASE_ERROR,
+        lexicalTitles: [],
+        semanticTitles: [],
+        notice: NOTICE_BOTH_SOURCES_FAILED,
+        retryAvailable: true
+      };
+      return this.state;
+    }
+
+    this.cards = semantic.cards;
+    const notice = buildMergeNotice(
+      lexical.succeeded, lexical.titles.length,
+      semantic.succeeded, semantic.titles.length);
+    const retryAvailable = !lexical.succeeded || !semantic.succeeded;
+    const merged: HybridSearchState = {
+      phase: HYBRID_PHASE_SUCCESS,
+      lexicalTitles: lexical.succeeded ? lexical.titles : [],
+      semanticTitles: semantic.succeeded ? semantic.titles : [],
+      retryAvailable: retryAvailable
+    };
+    if (notice.length > 0) {
+      merged.notice = notice;
+    }
+    this.state = merged;
+    return this.state;
+  }
+
+  private collectUnique(target: string[], candidates: string[], limit: number): void {
+    if (candidates === undefined || candidates === null) {
+      return;
+    }
+    for (let index = 0; index < candidates.length; index++) {
+      if (target.length >= limit) {
+        return;
+      }
+      const candidate = optionalText(candidates[index]).trim();
+      if (candidate.length === 0 || target.indexOf(candidate) >= 0) {
+        continue;
+      }
+      target.push(candidate);
+    }
+  }
+
+  /** Maps one semantic hit into a card, keeping section and snippet detail. */
+  private static toCard(rawTitle: string): SemanticResultCard {
+    const displayTitle = optionalText(rawTitle).trim();
+    const anchor = displayTitle.indexOf('#');
+    let title: string = displayTitle;
+    let sectionHeader: string = '';
+    if (anchor > 0) {
+      title = displayTitle.substring(0, anchor);
+      sectionHeader = displayTitle.substring(anchor + 1);
+    }
+    return {
+      title: title,
+      sectionHeader: sectionHeader,
+      sectionIndex: 0,
+      snippet: '',
+      displayTitle: displayTitle
+    };
+  }
+
+  private emptyState(phase: string): HybridSearchState {
+    return {
+      phase: phase,
+      lexicalTitles: [],
+      semanticTitles: [],
+      retryAvailable: false
+    };
+  }
+}
