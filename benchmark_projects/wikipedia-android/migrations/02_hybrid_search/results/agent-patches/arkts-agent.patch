diff --git a/entry/src/main/ets/model/HttpSearchLeaf.ets b/entry/src/main/ets/model/HttpSearchLeaf.ets
new file mode 100644
index 0000000..a63de4c
--- /dev/null
+++ b/entry/src/main/ets/model/HttpSearchLeaf.ets
@@ -0,0 +1,205 @@
+import { http } from '@kit.NetworkKit';
+import { SearchHttpLeaf } from './HybridSearchModels';
+
+/**
+ * Production lexical and semantic HTTP transport.
+ *
+ * This is a controlled external leaf: the request construction and the
+ * response mapping belong to the application, while the socket belongs to the
+ * platform. The three methods mirror the three sources the hybrid view model
+ * dispatches: a prefix search, a full-text search, and a semantic search.
+ */
+
+const LEXICAL_LIMIT: number = 20;
+const SEMANTIC_LIMIT: number = 20;
+
+interface MediaWikiSearchHit {
+  title?: string;
+}
+
+interface MediaWikiQueryContainer {
+  search?: MediaWikiSearchHit[];
+  prefixsearch?: MediaWikiSearchHit[];
+}
+
+interface MediaWikiSearchResponse {
+  query?: MediaWikiQueryContainer;
+}
+
+interface SemanticMatch {
+  section_header?: string;
+  section_index?: number;
+}
+
+interface SemanticPageHit {
+  key?: string;
+  title?: string;
+  description?: string;
+  excerpt?: string;
+  match?: SemanticMatch;
+}
+
+interface SemanticSearchResponse {
+  pages?: SemanticPageHit[];
+}
+
+/**
+ * Byte-level transport used by {@link HttpSearchLeaf}. Defaults to the
+ * platform HTTP client; the page substitutes a controlled transport when a
+ * deterministic HTTP source is supplied at the composition boundary.
+ */
+export interface SearchJsonTransport {
+  getText(url: string): Promise<string>;
+}
+
+/** Default transport: the HarmonyOS HTTP client. */
+export class NetworkSearchTransport implements SearchJsonTransport {
+  async getText(url: string): Promise<string> {
+    const client = http.createHttp();
+    try {
+      const response = await client.request(url, { method: http.RequestMethod.GET });
+      return response.result as string;
+    } finally {
+      client.destroy();
+    }
+  }
+}
+
+export class HttpSearchLeaf implements SearchHttpLeaf {
+  private baseUrl: string;
+  private transport: SearchJsonTransport;
+
+  constructor(baseUrl?: string, transport?: SearchJsonTransport) {
+    this.baseUrl = baseUrl === undefined ? '' : baseUrl;
+    this.transport = transport === undefined ? new NetworkSearchTransport() : transport;
+  }
+
+  /** Prefix (title-prefix) lexical search. */
+  async prefix(query: string, language: string): Promise<string[]> {
+    const lang = HttpSearchLeaf.normalizeLanguage(language);
+    const url = `${this.apiUrl(lang)}?action=query&format=json&formatversion=2&list=prefixsearch`
+      + `&psnamespace=0&pslimit=${LEXICAL_LIMIT}&psoffset=0`
+      + `&pssearch=${encodeURIComponent(query)}`;
+    const body = await this.transport.getText(url);
+    // `list=prefixsearch` reports its hits under `query.prefixsearch`; some
+    // deployments mirror the full-text key, so both are accepted.
+    return HttpSearchLeaf.mapLexical(body, 'prefixsearch');
+  }
+
+  /** Full-text lexical search. */
+  async fullText(query: string, language: string): Promise<string[]> {
+    const lang = HttpSearchLeaf.normalizeLanguage(language);
+    const url = `${this.apiUrl(lang)}?action=query&format=json&formatversion=2&list=search`
+      + `&srnamespace=0&srlimit=${LEXICAL_LIMIT}&sroffset=0`
+      + `&srsearch=${encodeURIComponent(query)}`;
+    const body = await this.transport.getText(url);
+    return HttpSearchLeaf.mapLexical(body, 'search');
+  }
+
+  /** Semantic search returning section-anchored titles. */
+  async semantic(query: string, language: string): Promise<string[]> {
+    const lang = HttpSearchLeaf.normalizeLanguage(language);
+    const url = `${this.restUrl(lang)}/w/rest.php/v1/search/page?q=${encodeURIComponent(query)}`
+      + `&limit=${SEMANTIC_LIMIT}`;
+    const body = await this.transport.getText(url);
+    return HttpSearchLeaf.mapSemantic(body);
+  }
+
+  private apiUrl(language: string): string {
+    return `https://${language}.wikipedia.org/w/api.php`;
+  }
+
+  private restUrl(language: string): string {
+    if (this.baseUrl.length > 0) {
+      return this.baseUrl;
+    }
+    return `https://${language}.wikipedia.org`;
+  }
+
+  private static normalizeLanguage(language: string): string {
+    const value = language === undefined || language === null ? '' : language.trim().toLowerCase();
+    return value.length === 0 ? 'en' : value;
+  }
+
+  /** Maps a MediaWiki search payload into lexical titles. */
+  private static mapLexical(body: string, primaryKey: string): string[] {
+    const titles: string[] = [];
+    const parsed = JSON.parse(body) as MediaWikiSearchResponse;
+    const query = parsed.query;
+    if (query === undefined || query === null) {
+      return titles;
+    }
+    let hits = query.search;
+    if (primaryKey === 'prefixsearch') {
+      hits = query.prefixsearch;
+      if (hits === undefined || hits === null) {
+        hits = query.search;
+      }
+    }
+    if (hits === undefined || hits === null) {
+      return titles;
+    }
+    for (let index = 0; index < hits.length; index++) {
+      const hit = hits[index];
+      if (hit === undefined || hit === null) {
+        continue;
+      }
+      const title = hit.title;
+      if (title === undefined || title === null) {
+        continue;
+      }
+      const trimmed = title.trim();
+      if (trimmed.length > 0 && titles.indexOf(trimmed) < 0) {
+        titles.push(trimmed);
+      }
+    }
+    return titles;
+  }
+
+  /** Maps a semantic payload into section-anchored semantic titles. */
+  private static mapSemantic(body: string): string[] {
+    const titles: string[] = [];
+    const parsed = JSON.parse(body) as SemanticSearchResponse;
+    const pages = parsed.pages;
+    if (pages === undefined || pages === null) {
+      return titles;
+    }
+    for (let index = 0; index < pages.length; index++) {
+      const page = pages[index];
+      if (page === undefined || page === null) {
+        continue;
+      }
+      const title = HttpSearchLeaf.pageTitle(page);
+      if (title.length === 0) {
+        continue;
+      }
+      const section = HttpSearchLeaf.pageSection(page);
+      const display = section.length === 0 ? title : `${title}#${section}`;
+      if (titles.indexOf(display) < 0) {
+        titles.push(display);
+      }
+    }
+    return titles;
+  }
+
+  private static pageTitle(page: SemanticPageHit): string {
+    if (page.title !== undefined && page.title !== null) {
+      return page.title.trim();
+    }
+    if (page.key !== undefined && page.key !== null) {
+      return page.key.trim();
+    }
+    return '';
+  }
+
+  private static pageSection(page: SemanticPageHit): string {
+    const match = page.match;
+    if (match === undefined || match === null) {
+      return '';
+    }
+    if (match.section_header !== undefined && match.section_header !== null) {
+      return match.section_header.trim();
+    }
+    return '';
+  }
+}
