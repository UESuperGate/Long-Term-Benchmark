+/** Presented modules rendered as `{ type, cards }` sections. */
+export function moduleSections(modules: FeedModule[]): Record<string, Object>[] {
+  const result: Record<string, Object>[] = [];
+  for (let index = 0; index < modules.length; index++) {
+    const cards: FeedCard[] = modules[index].cards;
+    const tokens: string[] = [];
+    for (let cardIndex = 0; cardIndex < cards.length; cardIndex++) {
+      tokens.push(cards[cardIndex].token());
+    }
+    result.push({ 'type': modules[index].type, 'cards': tokens });
+  }
+  return result;
