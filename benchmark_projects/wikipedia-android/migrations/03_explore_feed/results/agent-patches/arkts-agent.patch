+function mergeCommunityCards(existing: FeedCard[], incoming: FeedCard[], logicalAge: number, language: string): FeedCard[] {
+  const result: FeedCard[] = existing.slice();
+  const body: FeedCard[] = [];
+  for (let index = 0; index < incoming.length; index++) {
+    if (!isDayHeader(incoming[index].type)) {
+      body.push(incoming[index]);
+    }
+  }
+  if (body.length === 0) {
+    return result;
+  }
+  const grouped: FeedCard[] = body;
+  if (startsWithDayHeader(result, logicalAge)) {
+    let inserted: boolean = false;
+    for (let index = 0; index < grouped.length; index++) {
+      if (!containsPosition(result, grouped[index]) && !inserted) {
+        result.push(new FeedCard(feedCardTypeOf('DAY_HEADER'), `${logicalAge}`, `${logicalAge}`, logicalAge, language));
+        inserted = true;
+      }
+      if (!containsPosition(result, grouped[index])) {
+        result.push(grouped[index]);
+      }
+    }
+    return result;
+  }
+  const header: FeedCard[] = withDayHeader(grouped, logicalAge, language);
+  for (let index = 0; index < header.length; index++) {
+    if (!containsPosition(result, header[index])) {
+      result.push(header[index]);
+    }
+  }
+  return result;
+}
+
+function containsPosition(cards: FeedCard[], card: FeedCard): boolean {
+  for (let index = 0; index < cards.length; index++) {
+    if (cards[index].positionKey() === card.positionKey()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+function indexOfCard(cards: FeedCard[], token: string): number {
+  for (let index = 0; index < cards.length; index++) {
+    if (cards[index].token() === token) {
+      return index;
+    }
+  }
+  return -1;
+}
+
+function findModuleWithCard(modules: FeedModule[], token: string): FeedModule | undefined {
+  for (let index = 0; index < modules.length; index++) {
+    if (indexOfCard(modules[index].cards, token) >= 0) {
+      return modules[index];
+    }
+  }
+  return undefined;
+}
+
+/** Language scoped personalisation sources are stored as `language:identifier`. */
+function titlesForLanguage(values: string[], language: string): string[] {
+  const scoped: string[] = [];
+  const plain: string[] = [];
+  for (let index = 0; index < values.length; index++) {
+    const value: string = values[index];
+    const separator: number = value.indexOf(':');
+    if (separator <= 0) {
+      plain.push(value);
+      continue;
+    }
+    const entryLanguage: string = value.substring(0, separator);
+    const identifier: string = value.substring(separator + 1);
+    if (identifier.length === 0) {
+      continue;
+    }
+    if (entryLanguage === language) {
+      scoped.push(identifier);
+    } else {
+      plain.push(identifier);
+    }
+  }
+  return scoped.length > 0 ? scoped : plain;
+}
+
+function appendModule(modules: FeedModule[], type: string, titles: string[], rankedTitles: string[]): void {
+  const ordered: string[] = [];
+  // Titles the recommendation leaf ranked first come first inside the group.
+  for (let index = 0; index < rankedTitles.length; index++) {
+    const ranked: string = rankedTitles[index];
+    if (titles.indexOf(ranked) >= 0 && ordered.indexOf(ranked) < 0) {
+      ordered.push(ranked);
+    }
+  }
+  for (let index = 0; index < titles.length; index++) {
+    if (ordered.indexOf(titles[index]) < 0) {
+      ordered.push(titles[index]);
+    }
+  }
+  if (ordered.length === 0) {
+    return;
+  }
+  const cards: FeedCard[] = [];
+  for (let index = 0; index < ordered.length; index++) {
+    cards.push(new FeedCard(feedCardTypeOf(type), ordered[index], ordered[index], 0, ''));
+  }
+  modules.push(new FeedModule(type, cards));
+}
