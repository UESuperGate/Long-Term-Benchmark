+  visibleCards(hiddenCards: string[]): FeedCard[] {
+    const result: FeedCard[] = [];
+    for (let index = 0; index < this.cards.length; index++) {
+      if (hiddenCards.indexOf(this.cards[index].hideKey()) < 0) {
+        result.push(this.cards[index]);
+      }
+    }
+    return result;
+  }
+
+  /** A module survives filtering while it still shows at least one card. */
+  hasVisibleCard(hiddenCards: string[]): boolean {
+    return this.visibleCards(hiddenCards).length > 0;
+  }
+}
+
+/** Groups a flat card list into modules, preserving first appearance order. */
+export function feedModulesFromCards(cards: FeedCard[]): FeedModule[] {
+  const modules: FeedModule[] = [];
+  for (let index = 0; index < cards.length; index++) {
+    const card: FeedCard = cards[index];
+    const type: string = moduleTypeOfCard(card.type);
+    if (type.length === 0) {
+      continue;
+    }
+    let target: FeedModule | undefined = undefined;
+    for (let scan = 0; scan < modules.length; scan++) {
+      if (modules[scan].type === type) {
+        target = modules[scan];
+        break;
+      }
+    }
+    if (target === undefined) {
+      modules.push(new FeedModule(type, [card]));
+    } else {
+      target.cards.push(card);
+    }
+  }
+  return modules;
+}
