+/** Calendar date helper. Feed content is always scoped by an ISO calendar day. */
+export class FeedClock {
+  private fixedToday: string;
+
+  constructor(fixedToday: string) {
+    this.fixedToday = normalizeDate(fixedToday, systemDate());
+  }
+
+  today(): string {
+    return this.fixedToday;
+  }
+}
+
+/** Normalizes a date token, mapping the relative forms onto the clock's day. */
+export function normalizeDate(value: string, today: string): string {
+  const trimmed: string = value.trim();
+  if (trimmed.length === 0) {
+    return today;
+  }
+  const lowered: string = trimmed.toLowerCase();
+  if (lowered === 'today' || lowered === 'now' || lowered === 'current') {
+    return today;
+  }
+  return trimmed;
+}
+
+/** The device's current calendar day in ISO form. */
+export function systemDate(): string {
+  const now: Date = new Date();
+  const year: number = now.getFullYear();
+  const month: number = now.getMonth() + 1;
+  const day: number = now.getDate();
+  const paddedMonth: string = month < 10 ? `0${month}` : `${month}`;
+  const paddedDay: string = day < 10 ? `0${day}` : `${day}`;
+  return `${year}-${paddedMonth}-${paddedDay}`;
