+/**
+ * Extracts the recommendation payload a For You cache entry holds for `language`.
+ *
+ * A cache entry is only usable when it was written for the requested language,
+ * so both the date and the language keyed payload have to line up before any
+ * module is restored.
+ */
+export function modulesFromCacheEntry(entry: Record<string, Object>, language: string): FeedModule[] {
+  for (let index = 0; index < LANGUAGE_PAYLOAD_KEYS.length; index++) {
+    const scoped: Record<string, Object> | undefined = recordOf(entry[LANGUAGE_PAYLOAD_KEYS[index]]);
+    if (scoped === undefined) {
+      continue;
+    }
+    const scopedDirect: Object | undefined = scoped[language];
+    if (scopedDirect !== undefined) {
+      return parseModules(scopedDirect, language);
+    }
+  }
+  const direct: Object | undefined = entry[language];
+  if (direct !== undefined) {
+    return parseModules(direct, language);
+  }
+  for (let index = 0; index < MODULE_PAYLOAD_KEYS.length; index++) {
+    const payload: Object | undefined = entry[MODULE_PAYLOAD_KEYS[index]];
+    if (payload !== undefined) {
+      const parsed: FeedModule[] = parseModules(payload, language);
+      if (parsed.length > 0) {
+        return parsed;
+      }
+    }
+  }
+  return [];
+}
+
+/** Languages a For You cache entry holds a payload for. */
+export function languagesOfCacheEntry(entry: Record<string, Object>): string[] {
+  const result: string[] = [];
+  const declared: string[] = textListOf(entry['languages']);
+  for (let index = 0; index < declared.length; index++) {
+    if (result.indexOf(declared[index]) < 0) {
+      result.push(declared[index]);
+    }
+  }
+  const single: string = textOf(entry['language']).trim();
+  if (single.length > 0 && result.indexOf(single) < 0) {
+    result.push(single);
+  }
+  const keys: string[] = ['byLanguage', 'modulesByLanguage', 'perLanguage'];
+  for (let keyIndex = 0; keyIndex < keys.length; keyIndex++) {
+    const scoped: Record<string, Object> | undefined = recordOf(entry[keys[keyIndex]]);
+    if (scoped === undefined) {
+      continue;
+    }
+    const scopedKeys: string[] = Object.keys(scoped);
+    for (let index = 0; index < scopedKeys.length; index++) {
+      if (result.indexOf(scopedKeys[index]) < 0) {
+        result.push(scopedKeys[index]);
+      }
+    }
+  }
+  return result;
+}
+
+/**
+ * Inserts the day header that groups the editorial modules of `logicalAge`, so
+ * Community content stays grouped by calendar day while older days are added.
+ */
+export function withDayHeader(cards: FeedCard[], logicalAge: number, language: string): FeedCard[] {
+  const header: FeedCard = new FeedCard(feedCardTypeOf('DAY_HEADER'), `${logicalAge}`, `${logicalAge}`, logicalAge, language);
+  const result: FeedCard[] = [header];
+  for (let index = 0; index < cards.length; index++) {
+    result.push(cards[index]);
+  }
+  return result;
+}
+
+/** True when the list already opens with the header of `logicalAge`. */
+export function startsWithDayHeader(cards: FeedCard[], logicalAge: number): boolean {
+  if (cards.length === 0) {
+    return false;
+  }
+  const first: FeedCard = cards[0];
+  return isDayHeader(first.type) && first.logicalAge === logicalAge;
+}
+
+/**
+ * Restores a flat token list that carries its own day headers. Every card after
+ * a `DAY_HEADER:n` token belongs to logical day `n`, so an undo can put a hidden
+ * card back into the exact day it was removed from.
+ */
+export function parseCardsWithHeaders(tokens: string[], language: string): FeedCard[] {
+  const cards: FeedCard[] = [];
+  let logicalAge: number = 0;
+  for (let index = 0; index < tokens.length; index++) {
+    const token: string = tokens[index].trim();
+    if (token.length === 0) {
+      continue;
+    }
+    const card: FeedCard = feedCardFromToken(token, logicalAge, language);
+    if (isDayHeader(card.type)) {
+      const parsed: number = Number(card.identifier);
+      logicalAge = Number.isNaN(parsed) ? logicalAge : parsed;
+      cards.push(new FeedCard(card.type, card.identifier, card.title, logicalAge, language));
+      continue;
+    }
+    cards.push(card);
+  }
+  return cards;
+}
