+function cardFromRecord(record: Record<string, Object>, logicalAge: number, language: string): FeedCard | undefined {
+  const type: string = textOf(record['type']).trim();
+  const rawId: string = textOf(record['id']).trim();
+  const identifier: string = rawId.length > 0 ? rawId : textOf(record['title']).trim();
+  if (type.length === 0 && identifier.length === 0) {
+    return undefined;
+  }
+  const cardType: string = type.length > 0 ? type : 'ARTICLE';
+  return new FeedCard(feedCardTypeOf(cardType), identifier, identifier, logicalAge, language);
