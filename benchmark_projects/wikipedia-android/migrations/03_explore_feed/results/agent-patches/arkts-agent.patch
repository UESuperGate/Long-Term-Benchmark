+  }
+  if (normalized === FeedCardType.FEATURED_ARTICLE) {
+    return FeedCardType.FEATURED_ARTICLE;
+  }
+  if (normalized === FeedCardType.NEWS) {
+    return FeedCardType.NEWS;
+  }
+  if (normalized === FeedCardType.TOP_READ) {
+    return FeedCardType.TOP_READ;
+  }
+  if (normalized === FeedCardType.PIC_OF_THE_DAY) {
+    return FeedCardType.PIC_OF_THE_DAY;
+  }
+  if (normalized === FeedCardType.BASED_ON_INTEREST) {
+    return FeedCardType.BASED_ON_INTEREST;
+  }
+  if (normalized === FeedCardType.BECAUSE_YOU_READ) {
+    return FeedCardType.BECAUSE_YOU_READ;
