index 0000000000000000000000000000000000000000..3e950c09932317d17d3df638278aff760c9cf9e6
--- /dev/null
+++ b/entry/src/main/ets/model/FeedDomain.ets
@@ -0,0 +1,797 @@
+/*
+ * Domain model for the personalized Home feed.
+ *
+ * The Home surface is made of two tabs:
+ *
+ *   - Community: a date grouped editorial feed served by the remote editorial
+ *     service. It supports paging backwards one logical day at a time.
+ *   - For You:   a personalized feed whose recommendation groups are derived by
+ *     the application from the reader's saved interests, reading activity and
+ *     saved articles. The result is cached per calendar date and feed language.
+ *
+ * Both tabs share the same presentation vocabulary (phase, empty reason and
+ * recovery action) so that the empty / loading / content / error presentations
+ * stay mutually coherent for every tab.
+ */
+
+/** The two tabs exposed by the Home surface. */
+export enum HomeTab {
+  COMMUNITY = 'COMMUNITY',
+  FOR_YOU = 'FOR_YOU'
+}
+
+/**
+ * The personalization choice captured by feed onboarding. The choice decides the
+ * initial Home tab and is persisted, so later visits land on the same tab.
+ */
+export enum HomePreference {
+  COMMUNITY = 'COMMUNITY',
+  PERSONALIZED = 'PERSONALIZED'
+}
+
+/**
+ * The recommendation groups produced for the For You tab. The order is the order
+ * in which the groups are presented.
+ */
+export enum ForYouModuleType {
+  BASED_ON_INTEREST = 'BASED_ON_INTEREST',
+  BECAUSE_YOU_READ = 'BECAUSE_YOU_READ',
+  CONTINUE_READING = 'CONTINUE_READING'
+}
+
+/** The editorial modules served for a Community day. */
+export enum CommunityModuleType {
+  FEATURED_ARTICLE = 'FEATURED_ARTICLE',
+  NEWS = 'NEWS',
+  TOP_READ = 'TOP_READ',
+  PIC_OF_THE_DAY = 'PIC_OF_THE_DAY',
+  ARTICLE = 'ARTICLE'
+}
+
+/** Card kinds that can be rendered inside a feed. */
+export enum FeedCardType {
+  DAY_HEADER = 'DAY_HEADER',
+  FEATURED_ARTICLE = 'FEATURED_ARTICLE',
+  NEWS = 'NEWS',
+  TOP_READ = 'TOP_READ',
+  PIC_OF_THE_DAY = 'PIC_OF_THE_DAY',
+  BASED_ON_INTEREST = 'BASED_ON_INTEREST',
+  BECAUSE_YOU_READ = 'BECAUSE_YOU_READ',
+  CONTINUE_READING = 'CONTINUE_READING',
+  ARTICLE = 'ARTICLE'
+}
+
+/** Presentation phase of a single Home tab. */
+export enum FeedPhase {
+  IDLE = 'idle',
+  LOADING = 'loading',
+  CONTENT = 'content',
+  CONTENT_WITH_INLINE_ERROR = 'content_with_inline_error',
+  EMPTY = 'empty',
+  ERROR = 'error'
+}
+
+/** Why a tab has no content. Empty reason is only meaningful while empty. */
+export enum FeedEmptyReason {
+  NONE = 'NONE',
+  NO_DATA = 'NO_DATA',
+  ALL_MODULES_HIDDEN = 'ALL_MODULES_HIDDEN'
+}
+
+/** The action offered by an empty or errored tab. */
+export enum FeedRecoveryAction {
+  NONE = 'NONE',
+  RETRY = 'RETRY',
+  OPEN_COMMUNITY_MODULES = 'OPEN_COMMUNITY_MODULES',
+  OPEN_FOR_YOU_MODULES = 'OPEN_FOR_YOU_MODULES',
+  CUSTOMIZE_INTERESTS = 'CUSTOMIZE_INTERESTS',
+  RETURN_TO_COMMUNITY = 'RETURN_TO_COMMUNITY'
+}
+
+/** The two independent module visibility groups offered by feed settings. */
+export enum FeedSettingsTarget {
+  COMMUNITY_MODULES = 'COMMUNITY_MODULES',
+  FOR_YOU_MODULES = 'FOR_YOU_MODULES'
+}
+
+/** What triggered a feed request. */
+export enum FeedLoadSource {
+  INITIAL = 'INITIAL',
+  LOAD_MORE = 'LOAD_MORE',
+  RETRY = 'RETRY',
+  RETRY_MORE = 'RETRY_MORE',
+  REFRESH = 'REFRESH',
+  RESUME = 'RESUME',
+  LANGUAGE_CHANGED = 'LANGUAGE_CHANGED'
+}
+
+/** Activity result codes returned by the interest editor. */
+export enum FeedActivityResult {
+  RESULT_CANCELED = 0,
+  RESULT_OK = -1,
+  RESULT_INTERESTS_UPDATED = 100
+}
+
+/**
+ * Tag identifying which Home surface an effect belongs to. Effects always name
+ * the surfaces they touch so that a single tab acting is observable.
+ */
+export enum FeedTabSurface {
+  HOME = 'HOME',
+  COMMUNITY = 'COMMUNITY',
+  FOR_YOU = 'FOR_YOU',
+  SETTINGS = 'SETTINGS',
+  INTEREST_EDITOR = 'INTEREST_EDITOR'
+}
+
+/* ------------------------------------------------------------------ *
+ * Value helpers. Feed content arrives from remote leaves and from the
+ * persisted snapshot as loosely typed values, so every read is funnelled
+ * through a coercion that always yields a usable value.
+ * ------------------------------------------------------------------ */
+
+/** Reads a loosely typed value as text. */
+export function textOf(value: Object | undefined): string {
+  if (value === undefined || value === null) {
+    return '';
+  }
+  const encoded: string = JSON.stringify(value);
+  if (encoded.length > 1 && encoded.charAt(0) === '"' && encoded.charAt(encoded.length - 1) === '"') {
+    return encoded.substring(1, encoded.length - 1);
+  }
+  return encoded;
+}
+
+/** Reads a loosely typed value as a number. */
+export function numberOf(value: Object | undefined, fallback: number): number {
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  const encoded: string = JSON.stringify(value);
+  const parsed: number = Number(encoded);
+  return Number.isNaN(parsed) ? fallback : parsed;
+}
+
+/** Reads a loosely typed value as a boolean. */
+export function booleanOf(value: Object | undefined, fallback: boolean): boolean {
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  const encoded: string = JSON.stringify(value);
+  if (encoded === 'true') {
+    return true;
+  }
+  if (encoded === 'false') {
+    return false;
+  }
+  return fallback;
+}
+
+/** Reads a loosely typed value as an array. */
+export function arrayOf(value: Object | undefined): Object[] {
+  if (value === undefined || value === null) {
+    return [];
+  }
+  const encoded: string = JSON.stringify(value);
+  const parsed: Object | undefined = JSON.parse(encoded) as Object | undefined;
+  if (parsed === undefined || parsed === null) {
+    return [];
+  }
+  if (Array.isArray(parsed)) {
+    return parsed as Object[];
+  }
+  return [parsed];
+}
+
+/** Reads a loosely typed value as a keyed record. Returns undefined for scalars and lists. */
+export function recordOf(value: Object | undefined): Record<string, Object> | undefined {
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  const encoded: string = JSON.stringify(value);
+  if (encoded.length === 0 || encoded.charAt(0) === '[' || encoded.charAt(0) === '"') {
+    return undefined;
+  }
+  const parsed: Object | undefined = JSON.parse(encoded) as Object | undefined;
+  if (parsed === undefined || parsed === null || Array.isArray(parsed)) {
+    return undefined;
+  }
+  return parsed as Record<string, Object>;
+}
+
+/** Reads a loosely typed value as a list of strings. */
+export function textListOf(value: Object | undefined): string[] {
+  const raw: Object[] = arrayOf(value);
+  const result: string[] = [];
+  for (let index = 0; index < raw.length; index++) {
+    const entry: string = textOf(raw[index]).trim();
+    if (entry.length > 0) {
+      result.push(entry);
+    }
+  }
+  return result;
+}
+
+/* ------------------------------------------------------------------ *
+ * Enum coercion.
+ * ------------------------------------------------------------------ */
+
+export function homeTabOf(value: string): HomeTab | undefined {
+  const normalized: string = value.trim().toUpperCase();
+  if (normalized === HomeTab.COMMUNITY) {
+    return HomeTab.COMMUNITY;
+  }
+  if (normalized === HomeTab.FOR_YOU) {
+    return HomeTab.FOR_YOU;
+  }
+  return undefined;
+}
+
+export function homePreferenceOf(value: string): HomePreference {
+  const normalized: string = value.trim().toUpperCase();
