+import {
+  arrayOf, booleanOf, FeedCard, feedCardFromToken, feedCardTypeOf, FeedModule, isDayHeader,
+  numberOf, recordOf, textListOf, textOf
+} from './FeedDomain';
+
+/**
+ * The snapshot the page host injects when it mounts the Home surface.
+ *
+ * A snapshot is made of a `state` record (what the surface is showing right now)
+ * and a `persistence` record (what was written to durable storage). Both carry
+ * loosely typed values, so every read goes through this type, which resolves a
+ * path against the state record first and the persistence record second and
+ * always returns a usable value.
+ */
+export class FeedSnapshot {
+  private readonly state: Record<string, Object>;
+  private readonly persistence: Record<string, Object>;
+
+  constructor(state: Record<string, Object> | undefined, persistence: Record<string, Object> | undefined) {
+    this.state = state === undefined ? {} : state;
+    this.persistence = persistence === undefined ? {} : persistence;
+  }
+
+  private walk(root: Record<string, Object>, keys: string[]): Object | undefined {
+    let current: Record<string, Object> = root;
+    for (let index = 0; index < keys.length; index++) {
+      const value: Object | undefined = current[keys[index]];
+      if (value === undefined || value === null) {
+        return undefined;
+      }
+      if (index === keys.length - 1) {
+        return value;
+      }
+      const nested: Record<string, Object> | undefined = recordOf(value);
+      if (nested === undefined) {
+        return undefined;
+      }
+      current = nested;
+    }
+    return undefined;
+  }
+
+  private topLevel(key: string): Object | undefined {
+    const fromState: Object | undefined = this.state[key];
+    if (fromState !== undefined && fromState !== null) {
+      return fromState;
+    }
+    const fromPersistence: Object | undefined = this.persistence[key];
+    if (fromPersistence !== undefined && fromPersistence !== null) {
+      return fromPersistence;
+    }
+    return undefined;
+  }
+
+  /**
+   * Resolves a key list. A multi element list is first tried as one nested path,
+   * because that is what reads values out of a nested record such as the interest
+   * editor. Failing that, the elements are treated as aliases of the same top
+   * level key and the first one present wins.
+   */
+  private raw(keys: string[]): Object | undefined {
+    if (keys.length === 0) {
+      return undefined;
+    }
+    if (keys.length > 1) {
+      const nested: Object | undefined = this.walk(this.state, keys);
+      if (nested === undefined) {
+        const nestedPersistence: Object | undefined = this.walk(this.persistence, keys);
+        if (nestedPersistence !== undefined) {
+          return nestedPersistence;
+        }
+      } else {
+        return nested;
+      }
+      for (let index = 0; index < keys.length; index++) {
+        const alias: Object | undefined = this.topLevel(keys[index]);
+        if (alias !== undefined) {
+          return alias;
+        }
+      }
+      return undefined;
+    }
+    return this.topLevel(keys[0]);
+  }
+
+  text(keys: string[]): string {
+    return textOf(this.raw(keys)).trim();
+  }
+
+  number(keys: string[], fallback: number): number {
+    return numberOf(this.raw(keys), fallback);
+  }
+
+  flag(keys: string[], fallback: boolean): boolean {
+    return booleanOf(this.raw(keys), fallback);
+  }
+
+  list(keys: string[]): string[] {
+    return textListOf(this.raw(keys));
+  }
+
+  record(keys: string[]): Record<string, Object> | undefined {
+    return recordOf(this.raw(keys));
+  }
+
+  items(keys: string[]): Object[] {
+    return arrayOf(this.raw(keys));
+  }
+
+  present(keys: string[]): boolean {
+    return this.raw(keys) !== undefined;
+  }
+
+  /** The raw value at a path, whether it is a scalar, a list or a record. */
+  value(keys: string[]): Object | undefined {
+    return this.raw(keys);
+  }
+
+  /** The state half of the snapshot, used by the feed content leaves. */
+  getState(): Record<string, Object> {
+    return this.state;
+  }
+
+  /** The persistence half of the snapshot. */
+  getPersistence(): Record<string, Object> {
+    return this.persistence;
+  }
+
+  /** Both halves merged, with the state record taking precedence. */
+  merged(): Record<string, Object> {
+    const result: Record<string, Object> = {};
