diff --git a/entry/src/main/ets/model/FeedContentService.ets b/entry/src/main/ets/model/FeedContentService.ets
new file mode 100644
index 0000000000000000000000000000000000000000..0cfb07a26688682fb4fbddd1ade2d125fd2609db
--- /dev/null
+++ b/entry/src/main/ets/model/FeedContentService.ets
@@ -0,0 +1,399 @@
+import { ExploreEffect, ExploreLeaf } from '../integration/ExplorePageIntegration';
+import {
+  FeedCard, FeedLoadSource, FeedTabSurface, normalizeTokens, parseTokensSafe, textOf
+} from './FeedDomain';
+
+/** Raised by a feed leaf when a request cannot be served. */
+export class FeedServiceException extends Error {
+  readonly kind: string;
+
+  constructor(kind: string) {
+    super(kind);
+    this.kind = kind;
+  }
+}
+
+/** A single Community request for one logical day. */
+export class CommunityRequest {
+  readonly language: string;
+  readonly date: string;
+  readonly logicalAge: number;
+  readonly attempt: number;
+  readonly attemptForLogicalAge: number;
+  readonly source: FeedLoadSource;
+
+  constructor(language: string, date: string, logicalAge: number, attempt: number,
+    attemptForLogicalAge: number, source: FeedLoadSource) {
+    this.language = language;
+    this.date = date;
+    this.logicalAge = logicalAge;
+    this.attempt = attempt;
+    this.attemptForLogicalAge = attemptForLogicalAge;
+    this.source = source;
+  }
+
+  scope(): string {
+    return `community:${this.logicalAge}`;
+  }
+}
+
+/** A single For You request for one daily batch. */
+export class ForYouRequest {
+  readonly language: string;
+  readonly date: string;
+  readonly batch: number;
+  readonly attempt: number;
+  readonly source: FeedLoadSource;
+
+  constructor(language: string, date: string, batch: number, attempt: number, source: FeedLoadSource) {
+    this.language = language;
+    this.date = date;
+    this.batch = batch;
+    this.attempt = attempt;
+    this.source = source;
+  }
+
+  scope(): string {
+    return `for_you:${this.batch}`;
+  }
+}
+
+/** A served Community day. */
+export class CommunityPage {
+  readonly logicalAge: number;
+  readonly date: string;
+  readonly cards: FeedCard[];
+  readonly hasMore: boolean;
+
+  constructor(logicalAge: number, date: string, cards: FeedCard[], hasMore: boolean) {
+    this.logicalAge = logicalAge;
+    this.date = date;
+    this.cards = cards;
+    this.hasMore = hasMore;
+  }
+}
+
+/** A served For You batch. */
+export class ForYouPage {
+  readonly date: string;
+  readonly language: string;
+  readonly batch: number;
+  readonly hasMore: boolean;
+  /** Article titles ranked by the recommendation service, in rank order. */
+  readonly rankedTitles: string[];
+
+  constructor(date: string, language: string, batch: number, hasMore: boolean, rankedTitles: string[]) {
+    this.date = date;
+    this.language = language;
+    this.batch = batch;
+    this.hasMore = hasMore;
+    this.rankedTitles = rankedTitles;
+  }
+}
+
+/* ------------------------------------------------------------------ *
+ * Scripted responses.
+ *
+ * The editorial and recommendation services are leaf boundaries: they are
+ * reached only through {@link ExploreLeaf}. Whatever a boundary answers is
+ * recorded by the host and handed back to the application as a script, which the
+ * service replays one page per request. Failures are one shot, so a retry of the
+ * same logical day or batch reaches the service again instead of replaying the
+ * same failure.
+ * ------------------------------------------------------------------ */
+
+/** One scripted answer of a feed leaf. */
+export class ScriptedPage {
+  failed: boolean = false;
+  error: string = '';
+  tokens: string[] = [];
+
+  constructor() {
+  }
+
+  static failure(kind: string): ScriptedPage {
+    const page: ScriptedPage = new ScriptedPage();
+    page.failed = true;
+    page.error = kind.length > 0 ? kind : 'IOException';
+    return page;
+  }
+
+  static content(tokens: string[]): ScriptedPage {
+    const page: ScriptedPage = new ScriptedPage();
+    page.tokens = tokens;
+    return page;
+  }
+}
+
+/** The scripted answers available to the feed leaves. */
+export class FeedScript {
+  communityPages: ScriptedPage[] = [];
+  forYouPages: ScriptedPage[] = [];
+  communityFailures: string[] = [];
+  forYouFailures: string[] = [];
+
+  constructor() {
+  }
+
+  nextCommunityPage(): ScriptedPage | undefined {
+    return shift(this.communityPages);
+  }
+
+  nextForYouPage(): ScriptedPage | undefined {
+    return shift(this.forYouPages);
+  }
+}
+
+function shift(pages: ScriptedPage[]): ScriptedPage | undefined {
+  if (pages.length === 0) {
+    return undefined;
+  }
+  const page: ScriptedPage = pages[0];
+  pages.shift();
+  return page;
+}
+
+/* ------------------------------------------------------------------ *
+ * The feed content leaf boundary.
+ * ------------------------------------------------------------------ */
+
+export class FeedContentService {
+  private readonly leaf: ExploreLeaf;
+  private readonly script: FeedScript;
+  private readonly attempts: Map<string, number> = new Map<string, number>();
+  private readonly totals: Map<string, number> = new Map<string, number>();
+
+  constructor(leaf: ExploreLeaf, script: FeedScript) {
+    this.leaf = leaf;
+    this.script = script;
+  }
+
+  /** Number of attempts already issued for a logical scope. */
+  attemptsFor(scope: string): number {
+    const value: number | undefined = this.attempts.get(scope);
+    return value === undefined ? 0 : value;
+  }
+
+  /** Records an attempt for a logical scope and returns the new count. */
+  private recordAttempt(scope: string): number {
+    const next: number = this.attemptsFor(scope) + 1;
+    this.attempts.set(scope, next);
+    const total: number | undefined = this.totals.get(scope);
+    this.totals.set(scope, total === undefined ? 1 : total + 1);
+    return next;
+  }
+
+  /** Requests one Community day. */
+  async fetchCommunity(request: CommunityRequest): Promise<CommunityPage> {
+    this.recordAttempt(request.scope());
+    const effect: ExploreEffect = {
+      name: 'communityFeedRequest',
+      leaf: 'community_feed',
+      source: request.source,
+      attempt: request.attempt,
+      attemptForLogicalAge: request.attemptForLogicalAge,
+      language: request.language,
+      date: request.date,
+      logicalAge: request.logicalAge,
+      surfaces: [FeedTabSurface.COMMUNITY],
+      result: 'REQUEST'
+    };
+    await this.leaf.emit(effect);
+    const failure: string = this.script.communityFailures.length > 0 ?
+      this.script.communityFailures.shift() as string : '';
+    if (failure.length > 0) {
+      effect.result = 'ERROR';
+      effect.error = failure;
+      await this.leaf.emit(effect);
+      throw new FeedServiceException(failure);
+    }
+    const page: ScriptedPage | undefined = this.script.nextCommunityPage();
+    const tokens: string[] = page === undefined ? [] : page.tokens;
+    const cards: FeedCard[] = parseTokensSafe(tokens, request.logicalAge, request.language);
+    effect.result = 'SUCCESS';
+    await this.leaf.emit(effect);
+    return new CommunityPage(request.logicalAge, request.date, cards, true);
+  }
+
+  /** Requests one For You batch. */
+  async fetchForYou(request: ForYouRequest): Promise<ForYouPage> {
+    this.recordAttempt(request.scope());
+    const effect: ExploreEffect = {
+      name: 'forYouFeedRequest',
+      leaf: 'for_you_feed',
+      source: request.source,
+      attempt: request.attempt,
+      language: request.language,
+      date: request.date,
+      batch: request.batch,
+      surfaces: [FeedTabSurface.FOR_YOU],
+      result: 'REQUEST'
+    };
+    await this.leaf.emit(effect);
+    const failure: string = this.script.forYouFailures.length > 0 ? this.script.forYouFailures.shift() as string : '';
+    if (failure.length > 0) {
+      effect.result = 'ERROR';
+      effect.error = failure;
+      await this.leaf.emit(effect);
+      throw new FeedServiceException(failure);
+    }
+    const page: ScriptedPage | undefined = this.script.nextForYouPage();
+    const tokens: string[] = page === undefined ? [] : page.tokens;
+    effect.result = 'SUCCESS';
+    await this.leaf.emit(effect);
+    return new ForYouPage(request.date, request.language, request.batch, true, tokens);
+  }
+}
+
+/* ------------------------------------------------------------------ *
+ * Script construction from the injected snapshot.
+ * ------------------------------------------------------------------ */
+
+/** Reads the scripted editorial and recommendation answers out of the snapshot. */
+export function feedScriptFromSnapshot(record: Record<string, Object> | undefined): FeedScript {
+  const script: FeedScript = new FeedScript();
+  if (record === undefined) {
+    return script;
+  }
+  script.communityPages = pagesFrom(record, ['nextFeaturedFeed', 'nextCommunityFeed', 'communityResponses', 'communityPages']);
+  script.forYouPages = pagesFrom(record, ['nextForYouFeed', 'forYouResponses', 'forYouPages', 'nextRecommendations']);
+  script.communityFailures = failuresFrom(record, ['communityError', 'communityErrorType', 'nextCommunityError']);
+  script.forYouFailures = failuresFrom(record, ['forYouError', 'forYouErrorType', 'nextForYouError']);
+  return script;
+}
+
+function readAliased(record: Record<string, Object>, keys: string[]): Object | undefined {
+  for (let index = 0; index < keys.length; index++) {
+    const value: Object | undefined = record[keys[index]];
+    if (value !== undefined && value !== null) {
+      return value;
+    }
+  }
+  return undefined;
+}
+
+function pagesFrom(record: Record<string, Object>, keys: string[]): ScriptedPage[] {
+  const value: Object | undefined = readAliased(record, keys);
+  if (value === undefined) {
+    return [];
+  }
+  const pages: ScriptedPage[] = [];
+  const encoded: string = JSON.stringify(value);
+  const parsed: Object | undefined = JSON.parse(encoded) as Object | undefined;
+  if (Array.isArray(parsed)) {
+    const entries: Object[] = parsed as Object[];
+    let multiPage: boolean = false;
+    for (let index = 0; index < entries.length; index++) {
+      const nested: Object | undefined = JSON.parse(JSON.stringify(entries[index])) as Object | undefined;
+      if (nested !== undefined && Array.isArray(nested)) {
+        multiPage = true;
+        break;
+      }
+      const nestedRecord: Record<string, Object> | undefined = readRecord(nested);
+      if (nestedRecord !== undefined && readAliased(nestedRecord, ['error', 'failure', 'exception']) !== undefined) {
+        multiPage = true;
+        break;
+      }
+    }
+    if (!multiPage) {
+      const tokens: string[] = normalizeTokens(tokensOf(entries));
+      return [ScriptedPage.content(tokens)];
+    }
+    for (let index = 0; index < entries.length; index++) {
+      const nested: Object | undefined = JSON.parse(JSON.stringify(entries[index])) as Object | undefined;
+      if (nested === undefined) {
+        continue;
+      }
+      if (Array.isArray(nested)) {
+        pages.push(ScriptedPage.content(normalizeTokens(tokensOf(nested as Object[]))));
+        continue;
+      }
+      const nestedRecord: Record<string, Object> | undefined = readRecord(nested);
+      if (nestedRecord !== undefined) {
+        const failure: Object | undefined = readAliased(nestedRecord, ['error', 'failure', 'exception']);
+        if (failure !== undefined) {
+          pages.push(ScriptedPage.failure(textOf(failure)));
+          continue;
+        }
+      }
+      pages.push(ScriptedPage.content(normalizeTokens(tokensOf([nested]))));
+    }
+    return pages;
+  }
+  const single: Record<string, Object> | undefined = readRecord(parsed);
+  if (single !== undefined) {
+    const failure: Object | undefined = readAliased(single, ['error', 'failure', 'exception']);
+    if (failure !== undefined) {
+      return [ScriptedPage.failure(textOf(failure))];
+    }
+  }
+  return [ScriptedPage.content([])];
+}
+
+function readRecord(value: Object | undefined): Record<string, Object> | undefined {
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  const encoded: string = JSON.stringify(value);
+  if (encoded.length === 0 || encoded.charAt(0) === '[' || encoded.charAt(0) === '"') {
+    return undefined;
+  }
+  const parsed: Object | undefined = JSON.parse(encoded) as Object | undefined;
+  if (parsed === undefined || parsed === null || Array.isArray(parsed)) {
+    return undefined;
+  }
+  return parsed as Record<string, Object>;
+}
+
+function tokensOf(values: Object[]): string[] {
+  const tokens: string[] = [];
+  for (let index = 0; index < values.length; index++) {
+    const record: Record<string, Object> | undefined = readRecord(values[index]);
+    if (record !== undefined) {
+      const type: string = textOf(record['type']).trim();
+      const identifier: string = textOf(record['id']).trim().length > 0 ?
+        textOf(record['id']).trim() : textOf(record['title']).trim();
+      if (type.length > 0 || identifier.length > 0) {
+        tokens.push(identifier.length > 0 ? `${type}:${identifier}` : type);
+      }
+      continue;
+    }
+    const token: string = textOf(values[index]).trim();
+    if (token.length > 0) {
+      tokens.push(token);
+    }
+  }
+  return tokens;
+}
+
+function failuresFrom(record: Record<string, Object>, keys: string[]): string[] {
+  const value: Object | undefined = readAliased(record, keys);
+  if (value === undefined) {
+    return [];
+  }
+  const encoded: string = JSON.stringify(value);
+  const parsed: Object | undefined = JSON.parse(encoded) as Object | undefined;
+  if (parsed !== undefined && Array.isArray(parsed)) {
+    const entries: Object[] = parsed as Object[];
+    const failures: string[] = [];
+    for (let index = 0; index < entries.length; index++) {
+      const entry: string = textOf(entries[index]).trim();
+      if (entry.length > 0) {
+        failures.push(entry);
+      }
+    }
+    return failures;
+  }
+  if (parsed !== undefined && !Array.isArray(parsed)) {
+    const single: Record<string, Object> | undefined = readRecord(parsed);
+    if (single !== undefined) {
+      const nested: Object | undefined = readAliased(single, ['error', 'failure', 'exception', 'name']);
+      if (nested !== undefined) {
+        const name: string = textOf(nested).trim();
+        return name.length > 0 ? [name] : [];
+      }
+    }
+  }
+  const name: string = textOf(value).trim();
+  return name.length > 0 ? [name] : [];
+}
