+import { common } from '@kit.AbilityKit';
+import { preferences, relationalStore } from '@kit.ArkData';
+import { arrayOf, textListOf, textOf } from './FeedDomain';
+
+/**
+ * Durable keys owned by the Home feed.
+ *
+ * The feed stores the personalization choice, the feed language, the reader's
+ * hidden cards, the per tab module visibility, the daily For You cache and the
+ * onboarding flag. Everything else about a tab is transient.
+ */
+export class FeedStorageKeys {
+  static readonly HOME_PREFERENCE: string = 'home_preference';
+  static readonly HOME_LANGUAGE: string = 'home_language';
+  static readonly HIDDEN_CARDS: string = 'hidden_cards';
+  static readonly HIDDEN_COMMUNITY_MODULES: string = 'hidden_community_modules';
+  static readonly HIDDEN_FOR_YOU_MODULES: string = 'hidden_for_you_modules';
+  static readonly FOR_YOU_CACHE: string = 'for_you_cache';
+  static readonly ONBOARDING_COMPLETE: string = 'onboarding_complete';
+  static readonly SNAPSHOT: string = 'snapshot';
+}
+
+/** Typed access to the durable feed store. */
+export class FeedPreferences {
+  private readonly store: preferences.Preferences;
+
+  constructor(store: preferences.Preferences) {
+    this.store = store;
+  }
+
+  async readText(key: string): Promise<string> {
+    const value: preferences.ValueType = await this.store.get(key, '');
+    return textOf(value as Object).trim();
+  }
+
+  async readList(key: string): Promise<string[]> {
+    return textListOf(arrayOf(JSON.parse(this.safeJson(await this.readText(key))) as Object));
+  }
+
+  async writeText(key: string, value: string): Promise<void> {
+    await this.store.put(key, value);
+    await this.store.flush();
+  }
+
+  async writeList(key: string, values: string[]): Promise<void> {
+    await this.writeText(key, JSON.stringify(values));
+  }
+
+  async writeRecord(key: string, value: Record<string, Object>): Promise<void> {
+    await this.writeText(key, JSON.stringify(value));
+  }
+
+  async remove(key: string): Promise<void> {
+    await this.store.delete(key);
+    await this.store.flush();
+  }
+
+  /** True when durable storage already holds a value for `key`. */
+  async contains(key: string): Promise<boolean> {
+    return this.store.has(key);
+  }
+
+  private safeJson(value: string): string {
+    if (value.length === 0) {
+      return '[]';
+    }
+    try {
+      const parsed: Object | undefined = JSON.parse(value) as Object | undefined;
+      if (parsed === undefined) {
+        return '[]';
+      }
+      return JSON.stringify(parsed);
+    } catch (error) {
+      return '[]';
+    }
+  }
+}
+
+/* ------------------------------------------------------------------ *
+ * Saved interests.
+ *
+ * Interests live in the application database rather than in preferences, so they
+ * survive a feed cache invalidation and are shared with the interest editor.
+ * The relational store is the primary backend; if the database cannot be opened
+ * the repository falls back to an in-process store so that the editor still
+ * completes.
+ * ------------------------------------------------------------------ */
+
+export class FeedInterestRepository {
+  private static readonly TABLE: string = 'FeedInterest';
+  private database?: relationalStore.RdbStore;
+  private readonly memory: string[] = [];
+  private backend: string = 'in_process';
+
+  constructor() {
+  }
+
+  /** Opens the database and replaces its content with `seed`. */
+  async initialize(context: common.UIAbilityContext, seed: string[]): Promise<void> {
+    try {
+      const config: relationalStore.StoreConfig = {
+        name: 'feed_interests.db',
+        securityLevel: relationalStore.SecurityLevel.S1
+      };
+      this.database = await relationalStore.getRdbStore(context, config);
+      await this.database.executeSql(
+        'CREATE TABLE IF NOT EXISTS FeedInterest (code TEXT PRIMARY KEY, language TEXT, savedAt INTEGER)'
+      );
+      this.backend = 'relational_store';
+    } catch (error) {
+      this.database = undefined;
+      this.backend = 'in_process';
+    }
+    await this.replaceAll(seed);
+  }
+
+  /** Which store actually holds the interests right now. */
+  storageName(): string {
+    return this.backend;
+  }
+
+  async all(): Promise<string[]> {
+    if (this.database === undefined) {
+      return this.memory.slice();
+    }
+    const result: string[] = [];
+    try {
+      const rows: relationalStore.ResultSet = await this.database.querySql(
+        'SELECT code FROM FeedInterest ORDER BY savedAt ASC'
+      );
+      while (rows.goToNextRow()) {
+        result.push(rows.getString(0));
+      }
+      rows.close();
+    } catch (error) {
+      return this.memory.slice();
+    }
+    return result;
+  }
+
+  /** Replaces every saved interest. This is the write the editor completes with. */
+  async replaceAll(interests: string[]): Promise<void> {
+    this.memory.splice(0, this.memory.length);
+    for (let index = 0; index < interests.length; index++) {
+      this.memory.push(interests[index]);
+    }
+    if (this.database === undefined) {
+      return;
+    }
+    try {
+      await this.database.delete(new relationalStore.RdbPredicates(FeedInterestRepository.TABLE));
+      for (let index = 0; index < interests.length; index++) {
+        const code: string = interests[index];
+        const separator: number = code.indexOf(':');
+        const bucket: relationalStore.ValuesBucket = {
+          'code': code,
+          'language': separator > 0 ? code.substring(0, separator) : '',
+          'savedAt': index
+        };
+        await this.database.insert(FeedInterestRepository.TABLE, bucket);
+      }
+    } catch (error) {
+      this.backend = 'in_process';
+    }
+  }
+}
