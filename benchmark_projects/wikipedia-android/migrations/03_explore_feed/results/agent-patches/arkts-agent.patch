+/* ------------------------------------------------------------------ *
+ * Parsing of loosely typed feed payloads.
+ * ------------------------------------------------------------------ */
+
+/** Parses a list of `TYPE[:identifier]` tokens into cards for one logical day. */
+export function parseCards(payload: Object | undefined, logicalAge: number, language: string): FeedCard[] {
+  const raw: Object[] = arrayOf(payload);
+  const cards: FeedCard[] = [];
+  for (let index = 0; index < raw.length; index++) {
+    const record: Record<string, Object> | undefined = recordOf(raw[index]);
+    if (record !== undefined) {
+      const card: FeedCard | undefined = cardFromRecord(record, logicalAge, language);
+      if (card !== undefined) {
+        cards.push(card);
+      }
+      continue;
+    }
+    const token: string = textOf(raw[index]).trim();
+    if (token.length > 0) {
+      cards.push(feedCardFromToken(token, logicalAge, language));
+    }
+  }
+  return cards;
+}
