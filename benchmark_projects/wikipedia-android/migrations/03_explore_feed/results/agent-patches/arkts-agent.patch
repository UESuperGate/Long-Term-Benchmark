diff --git a/entry/src/main/ets/pages/InterestEditor.ets b/entry/src/main/ets/pages/InterestEditor.ets
new file mode 100644
index 0000000000000000000000000000000000000000..b660522c85002ad68aae58d268024f4ae8ac92ae
--- /dev/null
+++ b/entry/src/main/ets/pages/InterestEditor.ets
@@ -0,0 +1,134 @@
+import { router } from '@kit.ArkUI';
+import { FeedActivityResult, recordOf, textListOf, textOf } from '../model/FeedDomain';
+import { LegacyExploreStore } from '../model/LegacyExploreStore';
+
+function recordOrEmpty(value: Object | undefined): Record<string, Object> {
+  const record: Record<string, Object> | undefined = recordOf(value);
+  return record === undefined ? emptyRecord() : record;
+}
+
+function emptyRecord(): Record<string, Object> {
+  const empty: Record<string, Object> = {};
+  return empty;
+}
+
+/**
+ * The interest editor.
+ *
+ * Finishing with a real change writes the interests to the repository and
+ * answers RESULT_INTERESTS_UPDATED, which is what makes For You drop its stale
+ * personalized content. Finishing without a change answers RESULT_OK and leaves
+ * the feed alone.
+ */
+@Entry
+@Component
+struct InterestEditor {
+  @State selections: string[] = [];
+  @State candidates: string[] = [];
+  @State storage: string = '';
+  @State finished: boolean = false;
+  @State result: number = FeedActivityResult.RESULT_CANCELED;
+
+  private store?: LegacyExploreStore = LegacyExploreStore.current();
+
+  aboutToAppear(): void {
+    const state: Record<string, Object> = this.store === undefined ? emptyRecord() : this.store.currentState();
+    const editor: Record<string, Object> = recordOrEmpty(state['interestEditor']);
+    const persistence: Record<string, Object> = this.store === undefined ?
+      emptyRecord() : this.store.currentPersistence();
+    const interests: string[] = textListOf(state['interests']);
+    this.selections = textListOf(editor['currentSelections']);
+    if (this.selections.length === 0) {
+      this.selections = interests;
+    }
+    // Saved interests and the interests being edited are both offered, so a
+    // selection that is not saved yet still has a row to switch off.
+    const candidates: string[] = interests.slice();
+    for (let index = 0; index < this.selections.length; index++) {
+      if (candidates.indexOf(this.selections[index]) < 0) {
+        candidates.push(this.selections[index]);
+      }
+    }
+    this.candidates = candidates;
+    this.storage = textOf(persistence['interestStorage']);
+  }
+
+  private isSelected(code: string): boolean {
+    return this.selections.indexOf(code) >= 0;
+  }
+
+  private toggle(code: string): void {
+    const index: number = this.selections.indexOf(code);
+    if (index >= 0) {
+      this.selections.splice(index, 1);
+    } else {
+      this.selections.push(code);
+    }
+    this.store?.setInterestSelections(this.selections);
+  }
+
+  private async finish(): Promise<void> {
+    this.store?.setInterestSelections(this.selections);
+    await this.store?.finishInterestEditing();
+    const state: Record<string, Object> = this.store === undefined ? emptyRecord() : this.store.currentState();
+    const editor: Record<string, Object> = recordOrEmpty(state['interestEditor']);
+    const recorded: string = textOf(editor['result']);
+    this.result = recorded.length > 0 ? Number(recorded) : FeedActivityResult.RESULT_CANCELED;
+    this.finished = true;
+    router.back();
+  }
+
+  private cancel(): void {
+    this.store?.setInterestSelections(this.selections);
+    router.back();
+  }
+
+  build() {
+    Column({ space: 12 }) {
+      Row() {
+        Text('Interests').fontSize(20).fontWeight(FontWeight.Bold).layoutWeight(1)
+        Button('Cancel').fontSize(12).onClick(() => { this.cancel(); })
+      }
+      .width('100%')
+      .padding(16)
+
+      Text('Interests decide which recommendations your For You feed shows.')
+        .fontSize(13)
+        .fontColor('#767676')
+        .width('100%')
+        .padding({ left: 16, right: 16 })
+
+      List() {
+        ForEach(this.candidates, (code: string) => {
+          ListItem() {
+            Row() {
+              Text(code).layoutWeight(1)
+              Toggle({ type: ToggleType.Switch, isOn: this.isSelected(code) })
+                .onChange(() => { this.toggle(code); })
+            }
+            .width('100%')
+            .padding(16)
+          }
+        }, (code: string) => code)
+
+        if (this.candidates.length === 0) {
+          ListItem() {
+            Text('You have no interests saved yet.')
+              .fontSize(14)
+              .fontColor('#767676')
+              .padding(16)
+          }
+        }
+      }
+      .width('100%')
+      .layoutWeight(1)
+
+      Button(this.finished ? 'Saved' : 'Save')
+        .width('100%')
+        .margin({ left: 16, right: 16, bottom: 16 })
+        .onClick(() => { this.finish(); })
+    }
+    .width('100%')
+    .height('100%')
+  }
+}
