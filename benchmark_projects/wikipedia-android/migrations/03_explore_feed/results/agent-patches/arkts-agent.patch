+
+/** A single renderable feed item. */
+export class FeedCard {
+  readonly type: FeedCardType;
+  readonly identifier: string;
+  readonly title: string;
+  readonly logicalAge: number;
+  readonly language: string;
+
+  constructor(type: FeedCardType, identifier: string, title: string, logicalAge: number, language: string) {
+    this.type = type;
+    this.identifier = identifier;
+    this.title = title.length > 0 ? title : identifier;
+    this.logicalAge = logicalAge;
+    this.language = language;
+  }
+
+  /** Stable identity used for de-duplication and for restoring a hidden card. */
+  token(): string {
+    return this.identifier.length > 0 ? `${this.type}:${this.identifier}` : `${this.type}`;
+  }
+
+  /** Identity compared against the persisted hidden card list. */
+  hideKey(): string {
+    return this.identifier.length > 0 ? this.identifier : `${this.type}`;
+  }
+
+  /** Identity that also encodes the logical day, used to restore an exact position. */
+  positionKey(): string {
+    return `${this.logicalAge}#${this.token()}`;
+  }
+}
+
+/** Parses a `TYPE` or `TYPE:identifier` token into a card. */
+export function feedCardFromToken(token: string, logicalAge: number, language: string): FeedCard {
+  const trimmed: string = token.trim();
+  const separator: number = trimmed.indexOf(':');
+  if (separator < 0) {
+    return new FeedCard(feedCardTypeOf(trimmed), '', trimmed, logicalAge, language);
+  }
+  const rawType: string = trimmed.substring(0, separator);
+  const identifier: string = trimmed.substring(separator + 1);
+  return new FeedCard(feedCardTypeOf(rawType), identifier, identifier, logicalAge, language);
+}
+
+/** Trims and drops empty card tokens. */
+export function normalizeTokens(tokens: string[]): string[] {
+  const result: string[] = [];
+  for (let index = 0; index < tokens.length; index++) {
+    const token: string = tokens[index].trim();
+    if (token.length > 0) {
+      result.push(token);
+    }
+  }
+  return result;
+}
+
+/** Parses card tokens for one logical day, dropping anything unusable. */
+export function parseTokensSafe(tokens: string[], logicalAge: number, language: string): FeedCard[] {
+  const normalized: string[] = normalizeTokens(tokens);
+  const cards: FeedCard[] = [];
+  for (let index = 0; index < normalized.length; index++) {
+    cards.push(feedCardFromToken(normalized[index], logicalAge, language));
+  }
+  return cards;
+}
