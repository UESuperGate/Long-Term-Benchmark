+  }
+  const persistence: Record<string, Object> = store.currentPersistence();
+  const key: string = target === FeedSettingsTarget.COMMUNITY_MODULES ?
+    'hiddenCommunityModules' : 'hiddenForYouModules';
+  return textListOf(persistence[key]);
+}
+
+function requestedTarget(): string {
+  const params: Object = router.getParams();
+  const record: Record<string, Object> | undefined = recordOf(params);
+  if (record === undefined) {
+    return FeedSettingsTarget.COMMUNITY_MODULES;
+  }
+  const target: string = textOf(record['target']).trim();
+  return target === FeedSettingsTarget.FOR_YOU_MODULES ?
+    FeedSettingsTarget.FOR_YOU_MODULES : FeedSettingsTarget.COMMUNITY_MODULES;
+}
+
+/**
+ * Feed settings.
+ *
+ * Community and For You keep independent module visibility, so turning every
+ * module off in one tab leaves the other tab untouched. Turning one back on
+ * brings the filtered content back without another request.
+ */
+@Entry
+@Component
+struct FeedSettings {
+  @State target: string = FeedSettingsTarget.COMMUNITY_MODULES;
+  @State options: ModuleOption[] = [];
+  @State confirmAllOff: boolean = false;
+
+  private store?: LegacyExploreStore = LegacyExploreStore.current();
+
+  aboutToAppear(): void {
+    this.target = requestedTarget();
+    this.reload();
+  }
+
+  private reload(): void {
+    const hidden: string[] = hiddenModulesFor(this.store, this.target);
+    const types: string[] = this.target === FeedSettingsTarget.FOR_YOU_MODULES ?
+      allForYouModuleTypes() : allCommunityModuleTypes();
+    const options: ModuleOption[] = [];
+    for (let index = 0; index < types.length; index++) {
+      options.push(new ModuleOption(types[index], hidden.indexOf(types[index]) < 0));
+    }
+    this.options = options;
+  }
+
+  private async toggle(moduleType: string, visible: boolean): Promise<void> {
+    await this.store?.setModuleVisibility(this.target, moduleType, visible);
+    this.reload();
+  }
+
+  private async applyAllOff(): Promise<void> {
+    await this.store?.confirmAllModulesOff();
+    this.confirmAllOff = false;
+    this.reload();
+  }
+
+  build() {
+    Column({ space: 12 }) {
+      Row() {
+        Text('Feed settings')
+          .fontSize(20)
+          .fontWeight(FontWeight.Bold)
+          .layoutWeight(1)
+        Button('Close').fontSize(12).onClick(() => { router.back(); })
+      }
+      .width('100%')
+      .padding(16)
+
+      Row({ space: 8 }) {
+        Button(this.target === FeedSettingsTarget.COMMUNITY_MODULES ? '● Community' : 'Community')
+          .layoutWeight(1)
+          .onClick(() => { this.target = FeedSettingsTarget.COMMUNITY_MODULES; this.reload(); })
+        Button(this.target === FeedSettingsTarget.FOR_YOU_MODULES ? '● For You' : 'For You')
+          .layoutWeight(1)
+          .onClick(() => { this.target = FeedSettingsTarget.FOR_YOU_MODULES; this.reload(); })
+      }
+      .width('100%')
+      .padding({ left: 16, right: 16 })
+
+      List() {
+        ForEach(this.options, (option: ModuleOption) => {
+          ListItem() {
+            Row() {
+              Text(option.type).layoutWeight(1)
+              Toggle({ type: ToggleType.Switch, isOn: option.visible })
+                .onChange((isOn: boolean) => { this.toggle(option.type, isOn); })
+            }
+            .width('100%')
+            .padding(16)
+          }
+        }, (option: ModuleOption) => option.type)
+      }
+      .width('100%')
+      .layoutWeight(1)
+
+      if (this.confirmAllOff) {
+        Row({ space: 12 }) {
+          Text('Turn off every module in this tab? You can turn them back on here at any time.')
+            .fontSize(13)
+            .layoutWeight(1)
+          Button('Cancel').fontSize(12).onClick(() => { this.confirmAllOff = false; })
+          Button('Confirm').fontSize(12).onClick(() => { this.applyAllOff(); })
+        }
+        .width('100%')
+        .padding(16)
+        .backgroundColor('#f1f1f1')
+      }
+
+      Row({ space: 12 }) {
+        Button('Turn everything off')
+          .layoutWeight(1)
+          .onClick(() => { this.confirmAllOff = true; })
+        Button('Done').layoutWeight(1).onClick(() => { router.back(); })
+      }
+      .width('100%')
+      .padding(16)
+    }
+    .width('100%')
+    .height('100%')
+  }
+}
