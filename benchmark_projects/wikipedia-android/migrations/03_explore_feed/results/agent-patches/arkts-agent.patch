+function feedPhaseFromText(value: string): FeedPhase {
+  const normalized: string = value.trim().toLowerCase();
+  if (normalized.length === 0) {
+    return FeedPhase.IDLE;
+  }
+  if (normalized === FeedPhase.LOADING) {
+    return FeedPhase.LOADING;
+  }
+  if (normalized === FeedPhase.CONTENT) {
+    return FeedPhase.CONTENT;
+  }
+  if (normalized === FeedPhase.CONTENT_WITH_INLINE_ERROR) {
+    return FeedPhase.CONTENT_WITH_INLINE_ERROR;
+  }
+  if (normalized === FeedPhase.EMPTY) {
+    return FeedPhase.EMPTY;
+  }
+  if (normalized === FeedPhase.ERROR) {
