+
+/** `TYPE:identifier` tokens for a flat card list. */
+export function cardTokens(cards: FeedCard[]): string[] {
+  const result: string[] = [];
+  for (let index = 0; index < cards.length; index++) {
+    result.push(cards[index].token());
+  }
+  return result;
+}
+
+/** Module types currently presented, in order. */
+export function moduleTypes(modules: FeedModule[]): string[] {
+  const result: string[] = [];
+  for (let index = 0; index < modules.length; index++) {
+    result.push(modules[index].type);
+  }
+  return result;
+}
+
+/** Flat card tokens across every presented module. */
+export function moduleCardTokens(modules: FeedModule[]): string[] {
+  const result: string[] = [];
+  for (let index = 0; index < modules.length; index++) {
+    const cards: FeedCard[] = modules[index].cards;
+    for (let cardIndex = 0; cardIndex < cards.length; cardIndex++) {
+      result.push(cards[cardIndex].token());
+    }
+  }
+  return result;
+}
