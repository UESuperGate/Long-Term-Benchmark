+/**
+ * Describes why a presented module list differs from the backing module list.
+ * Backing modules are filtered, never deleted, so this is the record that proves
+ * a hide action only changed presentation.
+ */
+export function filteredBy(backing: FeedModule[], presented: FeedModule[]): string[] {
+  const reasons: string[] = [];
+  for (let index = 0; index < backing.length; index++) {
+    const match: FeedModule | undefined = findPresented(presented, backing[index].type);
+    if (match === undefined) {
+      reasons.push(`${backing[index].type}:module`);
+    } else if (moduleCardKeys(backing[index]) !== moduleCardKeys(match)) {
+      reasons.push(`${backing[index].type}:card`);
+    }
+  }
+  return reasons;
+}
+
+function findPresented(presented: FeedModule[], type: string): FeedModule | undefined {
+  for (let index = 0; index < presented.length; index++) {
+    if (presented[index].type === type) {
+      return presented[index];
+    }
+  }
+  return undefined;
