+ *   - a list of `{ type, cards: [...] }` records
+ *   - a `{ MODULE: [identifier, ...] }` map
+ *   - a `{ MODULE: 'identifier' }` map
+ */
+export function parseModules(payload: Object | undefined, language: string): FeedModule[] {
+  const raw: Object[] = arrayOf(payload);
+  const modules: FeedModule[] = [];
+  for (let index = 0; index < raw.length; index++) {
+    const record: Record<string, Object> | undefined = recordOf(raw[index]);
+    if (record !== undefined && record['type'] !== undefined) {
+      const type: string = textOf(record['type']).trim();
+      modules.push(new FeedModule(type, parseCards(record['cards'], 0, language)));
+      continue;
+    }
+    if (record !== undefined) {
+      const keys: string[] = Object.keys(record);
+      for (let keyIndex = 0; keyIndex < keys.length; keyIndex++) {
+        const type: string = keys[keyIndex];
+        const cards: FeedCard[] = parseCards(record[type], 0, language);
+        if (cards.length === 0) {
+          const single: string = textOf(record[type]).trim();
+          if (single.length > 0) {
+            cards.push(feedCardFromToken(`${type}:${single}`, 0, language));
+          }
+        }
+        modules.push(new FeedModule(type, cards));
+      }
+      continue;
+    }
+    const token: string = textOf(raw[index]).trim();
+    if (token.length === 0) {
+      continue;
+    }
+    const separator: number = token.indexOf(':');
+    if (separator < 0) {
+      modules.push(new FeedModule(token, [feedCardFromToken(token, 0, language)]));
+      continue;
+    }
+    const card: FeedCard = feedCardFromToken(token, 0, language);
+    modules.push(new FeedModule(`${card.type}`, [card]));
+  }
+  return modules;
+}
+
+const MODULE_PAYLOAD_KEYS: string[] = [
+  'modules', 'moduleList', 'items', 'recommendations', 'content', 'backingModules', 'entries', 'groups'
