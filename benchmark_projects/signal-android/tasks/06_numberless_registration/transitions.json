          "formattedPrice": "$1.99"
        },
        "ownedUnconsumedPurchase": false
      },
      "event": {
        "name": "initializeSignalLoginPayment"
      },
      "expected": {
        "state": {
          "selectedOption": "SignalLoginPaymentState.Option.Purchase",
          "paymentAvailability": "PaymentAvailability.Available",
          "price": {
            "type": "SignalLoginPaymentState.Price.Available",
            "formattedPrice": "$1.99"
          },
          "hasUnredeemedPurchase": false,
          "isPurchaseOptionEnabled": true,
          "isActionEnabled": true,
          "showSpinner": false,
          "dialogs.paymentUnavailable": false
        },
        "effects": [
          {
            "name": "getLoginConfiguration",
            "count": 1
          },
          {
            "name": "queryOneTimeProduct",
            "productId": "service-signal-login-product",
            "purchaseOptionId": "nonumber",
            "count": 1
          },
          {
            "name": "queryUnconsumedPurchase",
            "productId": "service-signal-login-product",
            "purchaseOptionId": "nonumber",
            "count": 1
          }
        ],
        "absentEffects": [
          "launchPurchaseFlow",
          "chargeUser",
          "createLoginPurchaseReceiptCredential",
          "registerAccount"
        ]
      },
      "invariants": [
        "purchase eligibility is derived from PaymentAvailability and the billing product returned for the service-provided LoginConfiguration.playProductId",
        "the client does not replace the service-provided product ID or the billing-formatted price with caller input",
        "initialization may discover eligibility and price but never starts or completes a purchase"
      ],
      "polarity": {
        "finalPositive": true,
        "baseSemanticFail": "At the same Signal Login payment entry, v8.26.4 Initialize is a TODO and leaves formattedPrice null; it neither resolves Play eligibility nor queries the service-named product, so the purchase action remains unavailable for semantic reasons."
