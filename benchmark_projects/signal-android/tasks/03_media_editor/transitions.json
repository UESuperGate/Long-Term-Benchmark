{
  "schemaVersion": 1,
  "taskId": "03_media_editor",
  "description": "Platform-neutral transitions for per-video audio removal in the responsive media-send editor",
  "cases": [
    {
      "traceSchemaVersion": 2,
      "caseId": "me_state_001_mute_control_eligibility",
      "key": "mute_control_eligibility",
      "functionalArea": "per_video_audio_removal",
      "given": {
        "audioRemovalAvailable": true,
        "items": [
          {
            "id": "video-1",
            "kind": "video",
            "isVideoGif": false
          },
          {
            "id": "gif-video",
            "kind": "video",
            "isVideoGif": true
          },
          {
            "id": "image-1",
            "kind": "image",
            "isVideoGif": false
          }
        ],
        "focusedItemId": "video-1"
      },
      "event": {
        "name": "renderEditorThenFocusEachItem"
      },
      "expected": {
        "state": {
          "muteControlByItem": {
            "video-1": true,
            "gif-video": false,
            "image-1": false
          }
        },
        "effects": []
      },
      "invariants": [
        "audio removal is exposed only for an ordinary editable video",
        "rendering eligibility does not mutate any item"
      ],
      "polarity": {
        "finalPositive": true,
        "baseSemanticFail": "The base editor has no audio-removal control or per-video mute eligibility state."
      },
      "evidence": {
        "androidProduction": [
          "MediaEditorToolbar.isMuteVisible",
          "EditorState.VideoTrim",
          "EditorState.VideoGif"
        ],
        "androidTests": [
          "MediaEditorToolbarSharedButtonsTest: mute control visibility by media type and feature availability"
        ]
      },
      "taskId": "03_media_editor",
      "traceDigest": "43476a5db3f876bacb5e7ffec1d41ed881d3c6b6264f1c1a38571461ef1b8825"
    },
    {
      "traceSchemaVersion": 2,
      "caseId": "me_state_002_mute_focused_video",
      "key": "mute_focused_video",
      "functionalArea": "per_video_audio_removal",
      "given": {
        "selectedItemIds": [
          "video-1"
        ],
        "focusedItemId": "video-1",
        "editorStateByItem": {
          "video-1": {
            "kind": "video_trim",
            "isMuted": false
          }
        },
        "preUpload": {
          "video-1": "uploaded"
        }
      },
      "event": {
        "name": "toggleVideoMuted"
      },
      "expected": {
        "state": {
          "focusedItemId": "video-1",
          "editorStateByItem": {
            "video-1": {
              "kind": "video_trim",
              "isMuted": true
            }
          }
        },
        "effects": [
          {
            "name": "cancelPreUpload",
            "itemId": "video-1",
            "count": 1
          },
          {
            "name": "showMutedFeedback",
            "count": 1
          }
        ]
      },
      "invariants": [
        "the selected media membership is unchanged",
        "the stale pre-upload for the edited item is invalidated exactly once"
      ],
      "polarity": {
        "finalPositive": true,
        "baseSemanticFail": "The base cannot represent a muted video edit, emit mute feedback, or invalidate pre-upload for that event."
      },
      "evidence": {
        "androidProduction": [
          "MediaSendFlowViewModel.toggleVideoMuted"
        ],
        "androidTests": [
          "MediaEditViewModelTest: ToggleVideoMuted is handed to the parent flow"
        ]
      },
      "taskId": "03_media_editor",
      "traceDigest": "624d08a377de9ef968925788e6f8a4c024d3ff755a7c13042440bd03da96a5cf"
