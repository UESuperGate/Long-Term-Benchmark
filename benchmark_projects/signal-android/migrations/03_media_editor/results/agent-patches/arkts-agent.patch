new file mode 100644
index 0000000000000000000000000000000000000000..041852f9a0115aa2c5323bd30ddfbf48022301b9
--- /dev/null
+++ b/entry/src/main/ets/feature/MediaEditorModels.ts
@@ -0,0 +1,281 @@
+/**
+ * Domain model for the Signal media editor flow.
+ *
+ * Two rules shape everything in this file:
+ *
+ *  1. Editor state is keyed by media identity (the attachment id), never by the
+ *     pager position, so focusing, reordering or restoring can never move one
+ *     attachment's edits onto another one.
+ *  2. Every stored value is read defensively. Attachments persisted before
+ *     per-video audio removal existed have no `videoMuted` flag at all, and a
+ *     missing flag has to read back as "unmuted" rather than as an error.
+ */
+
+export enum MediaKind {
+  IMAGE = 'image',
+  VIDEO = 'video',
+  AUDIO = 'audio',
+  DOCUMENT = 'document',
+  TEXT = 'text'
+}
+
+/** Value stored in an editor-state record under `kind`. */
+export enum EditorStateKind {
+  VIDEO_TRIM = 'video_trim',
+  IMAGE_TRANSFORM = 'image_transform',
+  NONE = 'none'
+}
+
+/** Which screen the media-send flow is currently showing. */
+export enum EditorScreen {
+  MEDIA_EDITOR = 'media_editor',
+  CAMERA = 'camera',
+  CLOSED = 'closed'
+}
+
+/** Where the media-send flow was started from. */
+export enum FlowOrigin {
+  PICKER = 'picker',
+  CAMERA = 'camera'
+}
+
+export interface MediaItem {
+  id: string;
+  kind: string;
+  isVideoGif: boolean;
+  contentType?: string;
+  durationUs?: number;
+}
+
+/** One observable side effect the editor performed. */
+export interface MediaEffect {
+  name: string;
+  itemId?: string;
+  itemIds?: string[];
+  value?: boolean;
+  count?: number;
+  screen?: string;
+  reason?: string;
+}
+
+/** Persisted media-send flow draft. */
+export const FLOW_STORE_NAME: string = 'signal_media_editor_flow';
+export const FLOW_BLOB_KEY: string = 'flow';
+
+export const AUDIO_REMOVED_FEEDBACK: string = 'Audio removed from video';
+
+export function cloneRecord(source: Object): Record<string, Object> {
+  return JSON.parse(JSON.stringify(source)) as Record<string, Object>;
+}
+
+/**
+ * Coerces an arbitrary stored value into a record. Missing or malformed values
+ * degrade to an empty record rather than propagating `undefined` into state.
+ */
+export function toRecord(value: Object): Record<string, Object> {
+  if (value === undefined) {
+    return {};
+  }
+  try {
+    const cloned: Record<string, Object> = cloneRecord(value);
+    return cloned === undefined ? {} : cloned;
+  } catch (error) {
+    return {};
+  }
+}
+
+export function recordKeys(source: Record<string, Object>): string[] {
+  return Object.keys(source);
+}
+
+/** Returns a copy of `source` without `key`, preserving every other field. */
+export function omitKey(source: Record<string, Object>, key: string): Record<string, Object> {
+  const keys: string[] = recordKeys(source);
+  const result: Record<string, Object> = {};
+  for (let index = 0; index < keys.length; index++) {
+    const current: string = keys[index];
+    if (current !== key) {
+      result[current] = source[current];
+    }
+  }
+  return result;
+}
+
+export function readString(source: Record<string, Object>, key: string, fallback: string): string {
+  const raw: Object = source[key];
+  if (raw === undefined) {
+    return fallback;
+  }
+  const text: string = String(raw);
+  return text.length > 0 ? text : fallback;
+}
+
+export function readBoolean(source: Record<string, Object>, key: string, fallback: boolean): boolean {
+  const raw: Object = source[key];
+  if (raw === undefined) {
+    return fallback;
+  }
+  const text: string = String(raw);
+  if (text === 'true') {
+    return true;
+  }
+  if (text === 'false') {
+    return false;
+  }
+  return fallback;
+}
+
+export function readNumber(source: Record<string, Object>, key: string, fallback: number): number {
+  const raw: Object = source[key];
+  if (raw === undefined) {
+    return fallback;
+  }
+  const parsed: number = Number(raw);
+  if (Number.isNaN(parsed)) {
+    return fallback;
+  }
+  return parsed;
+}
+
+export function readStringArray(source: Record<string, Object>, key: string): string[] {
+  const result: string[] = [];
+  const raw: Object = source[key];
+  if (raw === undefined) {
+    return result;
+  }
+  if (raw instanceof Array) {
+    const values: Object[] = raw as Object[];
+    for (let index = 0; index < values.length; index++) {
+      result.push(String(values[index]));
+    }
+  }
+  return result;
+}
+
+export function isVideoKind(kind: string): boolean {
+  if (kind === undefined) {
+    return false;
+  }
+  const normalized: string = kind.toLowerCase();
+  return normalized === MediaKind.VIDEO || normalized.startsWith('video/');
+}
+
+export function isImageKind(kind: string): boolean {
+  if (kind === undefined) {
+    return false;
+  }
+  const normalized: string = kind.toLowerCase();
+  return normalized === MediaKind.IMAGE || normalized.startsWith('image/');
+}
+
+export function isDocumentKind(kind: string): boolean {
+  if (kind === undefined) {
+    return false;
+  }
+  const normalized: string = kind.toLowerCase();
+  return normalized === MediaKind.DOCUMENT || normalized === MediaKind.TEXT;
+}
+
+/**
+ * Audio removal is offered only for an ordinary, editable video. Video GIFs are
+ * already silent loops and everything else (images, documents, audio) has no
+ * audio track to remove in the first place.
+ */
+export function isOrdinaryEditableVideo(item: MediaItem): boolean {
+  if (item.isVideoGif === true) {
+    return false;
+  }
+  return isVideoKind(item.kind);
+}
+
+/** Why audio removal is (or is not) offered for `item`. Empty means "offered". */
+export function audioRemovalIneligibilityReason(item: MediaItem): string {
+  if (item.isVideoGif === true) {
+    return 'video_gif';
+  }
+  if (isVideoKind(item.kind)) {
+    return '';
+  }
+  if (isImageKind(item.kind)) {
+    return 'image';
+  }
+  if (isDocumentKind(item.kind)) {
+    return 'document';
+  }
+  return 'unsupported_kind';
+}
+
+export function editorStateKindFor(item: MediaItem): string {
+  if (isOrdinaryEditableVideo(item)) {
+    return EditorStateKind.VIDEO_TRIM;
+  }
+  return EditorStateKind.NONE;
+}
+
+export function editorIsMuted(editor: Record<string, Object>): boolean {
+  return readBoolean(editor, 'isMuted', false);
+}
+
+/**
+ * Writes the audio-removal flag onto an existing editor-state record. Every
+ * other field (trim window, prior edits) is carried over untouched, so toggling
+ * audio never disturbs the rest of the item's edit.
+ */
+export function withAudioRemoved(existing: Record<string, Object>, fallbackKind: string, isMuted: boolean): Record<string, Object> {
+  const state: Record<string, Object> = toRecord(existing);
+  if (state['kind'] === undefined) {
+    state['kind'] = fallbackKind;
+  }
+  state['isMuted'] = isMuted;
+  return state;
+}
+
+/**
+ * Normalizes an attachment's stored transform properties.
+ *
+ * Unknown/extra fields survive the round trip, and the audio-removal flag is
+ * defaulted to `false` so payloads written before per-video audio removal stay
+ * readable and never silently mute a video.
+ */
+export function normalizeTransformProperties(stored: Record<string, Object>): Record<string, Object> {
+  const properties: Record<string, Object> = toRecord(stored);
+  properties['skipTransform'] = readBoolean(properties, 'skipTransform', false);
+  properties['videoTrim'] = readBoolean(properties, 'videoTrim', false);
+  properties['videoTrimStartTimeUs'] = readNumber(properties, 'videoTrimStartTimeUs', 0);
+  properties['videoTrimEndTimeUs'] = readNumber(properties, 'videoTrimEndTimeUs', 0);
+  properties['sentMediaQuality'] = readNumber(properties, 'sentMediaQuality', 0);
+  properties['mp4Faststart'] = readBoolean(properties, 'mp4Faststart', false);
+  properties['videoEdited'] = readBoolean(properties, 'videoEdited', false);
+  properties['videoMuted'] = readBoolean(properties, 'videoMuted', false);
+  return properties;
+}
+
+/** True when a restored flow draft carries neither media nor a focused item. */
+export function isEmptyFlow(flow: Record<string, Object>): boolean {
+  return readStringArray(flow, 'selectedItemIds').length === 0
+    && readString(flow, 'focusedItemId', '').length === 0;
+}
+
+/** Normalizes a serialized media-send flow draft into a well-formed record. */
+export function parseFlowBlob(blob: string): Record<string, Object> {
+  const flow: Record<string, Object> = {};
+  if (blob === undefined || blob.length === 0) {
+    return flow;
+  }
+  let parsed: Record<string, Object> = {};
+  try {
+    parsed = JSON.parse(blob) as Record<string, Object>;
+  } catch (error) {
+    return flow;
+  }
+  if (parsed === undefined) {
+    return flow;
+  }
+  flow['selectedItemIds'] = readStringArray(parsed, 'selectedItemIds');
+  flow['focusedItemId'] = readString(parsed, 'focusedItemId', '');
+  flow['editorStateByItem'] = toRecord(parsed['editorStateByItem']);
+  flow['messageText'] = readString(parsed, 'messageText', '');
+  flow['origin'] = readString(parsed, 'origin', FlowOrigin.PICKER);
+  flow['capturedItemId'] = readString(parsed, 'capturedItemId', '');
+  return flow;
+}
