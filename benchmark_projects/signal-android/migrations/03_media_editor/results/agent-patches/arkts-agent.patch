new file mode 100644
index 0000000000000000000000000000000000000000..816f9a7d267c05c6e0334a4eb46372270a68be88
--- /dev/null
+++ b/entry/src/main/ets/feature/MediaEditorRepository.ts
@@ -0,0 +1,203 @@
+import { common } from '@kit.AbilityKit';
+import { preferences } from '@kit.ArkData';
+import {
+  AUDIO_REMOVED_FEEDBACK,
+  EditorScreen,
+  FLOW_BLOB_KEY,
+  FLOW_STORE_NAME,
+  FlowOrigin,
+  MediaEffect,
+  MediaItem,
+  omitKey,
+  readString,
+  readStringArray,
+  toRecord
+} from './MediaEditorModels';
+
+/**
+ * Everything the editor owns but does not own itself: the media catalogue, the
+ * registry of already-uploaded attachments, the draft-flow blob, the prepared
+ * transcode job and the effect log. The editor store drives all of it through
+ * {@link MediaEditorRepository}.
+ */
+export class MediaEditorEnvironment {
+  items: MediaItem[] = [];
+  selectedItemIds: string[] = [];
+  focusedItemId: string = '';
+  editorStateByItem: Record<string, Object> = {};
+  preUpload: Record<string, Object> = {};
+  savedFlowBlob: string = '{}';
+  effects: MediaEffect[] = [];
+  preparedVideo: Record<string, Object> = {};
+  transcoder: Record<string, Object> = { allowAudioRemux: true };
+  messageText: string = '';
+  flowOrigin: string = FlowOrigin.PICKER;
+  capturedItemId: string = '';
+  productionBlobWrites: number = 0;
+  productionBlobReads: number = 0;
+
+  seedFlow(items: MediaItem[], selected: string[], focused: string, editors: Record<string, Object>,
+    preUpload: Record<string, Object> = {}): void {
+    this.items = items;
+    this.selectedItemIds = selected.slice();
+    this.focusedItemId = focused;
+    this.editorStateByItem = toRecord(editors);
+    this.preUpload = toRecord(preUpload);
+    this.effects = [];
+  }
+
+  /** Loads a previously persisted media-send flow draft into the environment. */
+  seedFlowState(flow: Record<string, Object>): void {
+    const seeded: Record<string, Object> = toRecord(flow);
+    this.selectedItemIds = readStringArray(seeded, 'selectedItemIds');
+    this.focusedItemId = readString(seeded, 'focusedItemId', '');
+    this.editorStateByItem = toRecord(seeded['editorStateByItem']);
+    this.messageText = readString(seeded, 'messageText', '');
+    this.flowOrigin = readString(seeded, 'origin', FlowOrigin.PICKER);
+    this.capturedItemId = readString(seeded, 'capturedItemId', '');
+  }
+
+  resetEffects(): void { this.effects = []; }
+  effectCursor(): number { return this.effects.length; }
+  effectsAfter(cursor: number): MediaEffect[] { return this.effects.slice(cursor); }
+  record(effect: MediaEffect): void { this.effects.push(effect); }
+}
+
+/**
+ * The editor's gateway to everything that survives the editor itself: durable
+ * flow drafts, the upload registry, navigation and the transcode pipeline.
+ */
+export class MediaEditorRepository {
+  private readonly leaf: MediaEditorEnvironment;
+
+  constructor(leaf: MediaEditorEnvironment) { this.leaf = leaf; }
+
+  loadFlow(): Record<string, Object> {
+    const flow: Record<string, Object> = {};
+    flow['selectedItemIds'] = this.leaf.selectedItemIds.slice();
+    flow['focusedItemId'] = this.leaf.focusedItemId;
+    flow['editorStateByItem'] = toRecord(this.leaf.editorStateByItem);
+    flow['messageText'] = this.leaf.messageText;
+    flow['origin'] = this.leaf.flowOrigin;
+    flow['capturedItemId'] = this.leaf.capturedItemId;
+    return flow;
+  }
+
+  /** Commits the draft blob kept in memory so recreation can restore it. */
+  commitFlowDraft(flow: Record<string, Object>): void {
+    this.leaf.savedFlowBlob = JSON.stringify(toRecord(flow));
+  }
+
+  clearFlowDraft(): void {
+    this.leaf.savedFlowBlob = '{}';
+  }
+
+  /**
+   * Mirrors the draft into the durable preferences store. The in-memory draft is
+   * committed first, so an unavailable or failing durable store degrades to the
+   * in-memory snapshot instead of losing pending edits.
+   */
+  async persistFlow(context: common.UIAbilityContext, flow: Record<string, Object>): Promise<void> {
+    const blob: string = JSON.stringify(toRecord(flow));
+    this.leaf.savedFlowBlob = blob;
+    this.leaf.productionBlobWrites += 1;
+    try {
+      const store = await preferences.getPreferences(context, FLOW_STORE_NAME);
+      await store.clear();
+      await store.put(FLOW_BLOB_KEY, blob);
+      await store.flush();
+    } catch (error) {
+      this.report('durable flow draft unavailable, keeping in-memory draft');
+    }
+  }
+
+  /** Reopens the persisted draft; falls back to the in-memory draft. */
+  async reopenPersistedFlow(context: common.UIAbilityContext): Promise<Record<string, Object>> {
+    let blob: string = '';
+    try {
+      const reopened = await preferences.getPreferences(context, FLOW_STORE_NAME);
+      const stored = await reopened.get(FLOW_BLOB_KEY, '');
+      blob = stored === undefined ? '' : String(stored);
+    } catch (error) {
+      this.report('durable flow draft unreadable, falling back to in-memory draft');
+      blob = '';
+    }
+    this.leaf.productionBlobReads += 1;
+    if (blob.length === 0) {
+      blob = this.leaf.savedFlowBlob;
+    }
+    const parsed: Record<string, Object> = JSON.parse(blob) as Record<string, Object>;
+    const flow: Record<string, Object> = {};
+    flow['selectedItemIds'] = readStringArray(parsed, 'selectedItemIds');
+    flow['focusedItemId'] = readString(parsed, 'focusedItemId', '');
+    flow['editorStateByItem'] = toRecord(parsed['editorStateByItem']);
+    flow['messageText'] = readString(parsed, 'messageText', '');
+    flow['origin'] = readString(parsed, 'origin', FlowOrigin.PICKER);
+    flow['capturedItemId'] = readString(parsed, 'capturedItemId', '');
+    return flow;
+  }
+
+  closeScreen(): void { this.leaf.record({ name: 'closeScreen', count: 1 }); }
+
+  /**
+   * Drops a pre-uploaded version of an attachment. Once an item has been edited
+   * the earlier upload describes media the user no longer sees, so the eventual
+   * send must not be able to reach for it. Invalidating an item that has no
+   * pre-upload is a no-op, which keeps the invalidation happening exactly once.
+   */
+  invalidatePreUpload(itemId: string): boolean {
+    if (this.leaf.preUpload[itemId] === undefined) {
+      return false;
+    }
+    this.leaf.preUpload = omitKey(this.leaf.preUpload, itemId);
+    this.leaf.record({ name: 'invalidatePreUpload', itemId: itemId, count: 1 });
+    return true;
+  }
+
+  showAudioRemovedFeedback(itemId: string): void {
+    this.leaf.record({
+      name: 'showAudioRemovedFeedback',
+      itemId: itemId,
+      value: true,
+      reason: AUDIO_REMOVED_FEEDBACK,
+      count: 1
+    });
+  }
+
+  requestDiscardConfirmation(itemCount: number): void {
+    this.leaf.record({ name: 'requestDiscardConfirmation', count: 1, value: itemCount > 0 });
+  }
+
+  cancelDiscardConfirmation(): void {
+    this.leaf.record({ name: 'cancelDiscardConfirmation', count: 1 });
+  }
+
+  discardPendingEdits(itemIds: string[]): void {
+    this.clearFlowDraft();
+    this.leaf.record({ name: 'discardPendingEdits', itemIds: itemIds, count: 1 });
+  }
+
+  returnToCamera(): void {
+    this.leaf.record({ name: 'returnToCamera', count: 1, screen: EditorScreen.CAMERA });
+  }
+
+  applyVideoTransform(itemId: string): void {
+    this.leaf.record({ name: 'applyVideoTransform', itemId: itemId, count: 1 });
+  }
+
+  convertVideo(): void {
+    this.leaf.record({ name: 'convertVideo', count: 1 });
+  }
+
+  passThroughVideo(): void {
+    this.leaf.record({ name: 'passThroughVideo', count: 1 });
+  }
+
+  private report(message: string): void {
+    try {
+      console.warn(`[media-editor] ${message}`);
+    } catch (unused) {
+      // Logging must never take down the editor.
+    }
+  }
+}
