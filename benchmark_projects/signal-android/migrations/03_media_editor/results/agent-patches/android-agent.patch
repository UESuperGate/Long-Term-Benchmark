+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediasend.screens.edit
+
+import org.signal.core.ui.compose.DialogController
+import org.signal.core.ui.compose.DialogResult
+
+/**
+ * What the discard prompt has to say. The flow decides whether to ask; this is only what gets rendered.
+ */
+data class DiscardChangesDialogData(val mediaCount: Int)
+
+/**
+ * The "you have unsent media" prompt shown when the flow would otherwise be closed with media still selected.
+ *
+ * Destructive dialogs are three-way — confirmed, canceled, dismissed — and only the confirmation is allowed to
+ * take anything with it. Canceling and dismissing are both treated as "stay exactly where you were", so no
+ * attachment, upload or navigation happens on either.
+ */
+class DiscardChangesController(
+  private val dialogController: DialogController<DiscardChangesDialogData>
+) {
+
+  suspend fun show(data: DiscardChangesDialogData): DialogResult {
+    return dialogController.show(data)
+  }
+
+  /** Whether the user actually chose to throw the pending work away. */
+  suspend fun isDiscardConfirmed(data: DiscardChangesDialogData): Boolean {
+    return show(data) == DialogResult.POSITIVE
+  }
+}
