+package org.signal.mediasend
+
+import androidx.lifecycle.SavedStateHandle
+import androidx.lifecycle.createSavedStateHandle
+import androidx.lifecycle.viewModelScope
+import androidx.lifecycle.viewmodel.CreationExtras
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.receiveAsFlow
+import kotlinx.coroutines.launch
+import org.signal.core.models.media.Media
+import org.signal.core.models.media.MediaFolder
+import org.signal.core.ui.compose.DialogController
+import org.signal.core.ui.compose.EventDrivenViewModel
+import org.signal.core.util.logging.Log
+import org.signal.mediasend.preupload.PreUploadController
+import org.signal.mediasend.preupload.PreUploadResult
+import org.signal.mediasend.screens.edit.DiscardChangesController
+import org.signal.mediasend.screens.edit.DiscardChangesDialogData
+import org.signal.mediasend.screens.edit.MediaEditScreenEvents
+import org.signal.mediasend.screens.edit.ScheduleSendOption
+import org.signal.mediasend.screens.edit.image.BrushTool
+import org.signal.mediasend.screens.edit.video.VideoTrimData
+import kotlin.coroutines.resume
+import kotlin.coroutines.suspendCoroutine
+import kotlin.time.Duration.Companion.milliseconds
+
+/**
+ * Owns the media send flow: the selection, which item is focused, the per-item edits, the message metadata, and the
+ * effects the screens can't own themselves (snackbars, dialogs, navigation, sends).
+ *
+ * The whole of [MediaSendFlowState] is persisted on every change, so a recreated flow comes back with the same
+ * selection, the same focus, and the same per-item edits. What can't outlive the process that started it — an upload
+ * in flight, a save in progress — is deliberately not carried over, and restoration never invents an edit.
+ */
+internal class MediaSendFlowViewModel(
+  private val savedStateHandle: SavedStateHandle = SavedStateHandle(),
+  private val args: MediaSendFlowActivityContract.Args = MediaSendFlowActivityContract.Args(),
+  private val mediaSendRepository: MediaSendRepository = MediaSendDependencies.mediaSendRepository,
+  private val preUploadController: PreUploadController = PreUploadController(),
+  private val discardChangesController: DiscardChangesController = DiscardChangesController(DialogController())
+) : EventDrivenViewModel<MediaSendFlowEvent>(TAG) {
+
+  private val mutableState = MutableStateFlow(restoreOrCreateState())
+  private val screenEventChannel = Channel<MediaEditScreenEvents>(Channel.UNLIMITED)
+
+  private val hudCommandChannel = Channel<MediaSendFlowHudCommand>(Channel.BUFFERED)
+  private val navigationChannel = Channel<MediaSendFlowEvent>(Channel.BUFFERED)
+  private val snackbarChannel = Channel<SnackbarEvent>(Channel.BUFFERED)
+  private val toastChannel = Channel<ToastEvent>(Channel.BUFFERED)
+
+  /** The selection, the focus, and every item's edits. Recreated from [savedStateHandle] on process death. */
+  val state: StateFlow<MediaSendFlowState> = mutableState.asStateFlow()
+
+  /** What the enclosing flow has to do, as opposed to what the editor screen renders. */
+  val hudCommands: Flow<MediaSendFlowHudCommand> = hudCommandChannel.receiveAsFlow()
+  val navigationEvents: Flow<MediaSendFlowEvent> = navigationChannel.receiveAsFlow()
+  val snackbarEvents: Flow<SnackbarEvent> = snackbarChannel.receiveAsFlow()
+  val toastEvents: Flow<ToastEvent> = toastChannel.receiveAsFlow()
+
+  private val current: MediaSendFlowState
+    get() = mutableState.value
+
+  init {
+    viewModelScope.launch {
+      for (event in screenEventChannel) {
+        processScreenEvent(event)
+      }
+    }
+  }
+
+  /** Raises something the editor screen owns, such as an edit to the focused item. */
+  fun onScreenEvent(event: MediaEditScreenEvents) {
+    screenEventChannel.trySend(event)
+  }
+
+  override suspend fun processEvent(event: MediaSendFlowEvent) {
+    when (event) {
+      is MediaSendFlowEvent.AddMedia -> addMedia(event.media)
+      is MediaSendFlowEvent.RemoveMedia -> removeMedia(event.media)
+      is MediaSendFlowEvent.SetFocusedMedia -> setFocusedMedia(event.media)
+      is MediaSendFlowEvent.ReorderSelectedMedia -> reorderSelectedMedia(event.fromIndex, event.toIndex)
+      is MediaSendFlowEvent.ShowSnackbar -> snackbarChannel.trySend(event.snackbar)
+      MediaSendFlowEvent.SelectionRejectionShown -> update(current.copy(isSelectionRejected = false))
+      MediaSendFlowEvent.RequestClose -> requestClose()
+      MediaSendFlowEvent.DiscardAndClose -> discardPendingWork()
+      is MediaSendFlowEvent.NavigateToFiles -> navigationChannel.trySend(event)
+      MediaSendFlowEvent.NavigateToEdit -> navigationChannel.trySend(event)
+      MediaSendFlowEvent.NavigateToCamera -> navigationChannel.trySend(event)
+    }
+  }
+
+  private suspend fun processScreenEvent(event: MediaEditScreenEvents) {
+    when (event) {
+      is MediaEditScreenEvents.RemoveMedia -> onEvent(MediaSendFlowEvent.RemoveMedia(setOf(event.media)))
+      is MediaEditScreenEvents.FocusedMediaChanged -> onEvent(MediaSendFlowEvent.SetFocusedMedia(event.media))
+      is MediaEditScreenEvents.ReorderSelectedMedia -> {
+        onEvent(MediaSendFlowEvent.ReorderSelectedMedia(event.fromIndex, event.toIndex))
+      }
+      MediaEditScreenEvents.ToggleVideoMuted -> setFocusedMediaMuted(!current.isFocusedMediaMuted)
+      is MediaEditScreenEvents.SetVideoMuted -> setFocusedMediaMuted(event.muted)
+      is MediaEditScreenEvents.VideoTrimChanged -> setVideoTrimData(event.videoTrimData)
+      // A seek only moves the preview; it changes nothing the send path reads.
+      is MediaEditScreenEvents.VideoSeek -> Unit
+      MediaEditScreenEvents.ToggleViewOnce -> toggleViewOnce()
+      is MediaEditScreenEvents.SetMediaQuality -> setMediaQuality(event.quality)
+      is MediaEditScreenEvents.BrushWidthChanged -> setBrushWidth(event.tool, event.fraction)
+      // Face blurs live in the image editor's own model, which is persisted with the rest of that item's edits.
+      is MediaEditScreenEvents.ToggleBlurFaces -> Unit
+      is MediaEditScreenEvents.AddMessageClick -> Unit
+      MediaEditScreenEvents.StickerClick -> hudCommandChannel.trySend(MediaSendFlowHudCommand.SelectSticker)
+      MediaEditScreenEvents.SaveMedia -> saveFocusedMedia()
+      MediaEditScreenEvents.NextClick -> send()
+      is MediaEditScreenEvents.ScheduleSendClick -> scheduleSend(event.option)
+      MediaEditScreenEvents.NavigateBack -> requestClose()
+      MediaEditScreenEvents.NavigateToGallery -> navigateToGallery()
+    }
+  }
+
+  private fun addMedia(media: Set<Media>) {
+    val flowState = current
+    val additions = media.filterNot { candidate -> flowState.selectedMedia.any { it.isSameMediaAs(candidate) } }
+    if (additions.isEmpty()) {
+      return
+    }
+
+    val combined = flowState.selectedMedia + additions
+    update(flowState.copy(selectedMedia = combined, focusedMedia = flowState.focusedMedia ?: combined.first()))
+
+    preUploadController.startUpload(combined, flowState.recipientId)
+  }
+
+  private fun removeMedia(media: Set<Media>) {
+    if (media.isEmpty()) {
+      return
+    }
+
+    val uris = media.map { it.uri }.toSet()
+    val remaining = current.selectedMedia.filterNot { candidate -> candidate.uri in uris }
+    if (remaining.size == current.selectedMedia.size) {
+      return
+    }
+
+    preUploadController.cancelUpload(media)
+
+    // Whatever was focused is gone, so focus lands on whatever now sits where it used to be, or on nothing.
+    val removedFocus = current.focusedMedia?.takeIf { focused -> focused.uri in uris }
+    val newFocus = if (removedFocus == null) {
+      current.focusedMedia
+    } else {
+      val index = current.selectedMedia.indexOfFirst { it.uri == removedFocus.uri }
+        .coerceIn(0, (remaining.size - 1).coerceAtLeast(0))
+      remaining.getOrNull(index)
+    }
+
+    update(
+      current.copy(
+        selectedMedia = remaining,
+        focusedMedia = newFocus,
+        // An item that left the selection takes its edits with it; the rest are untouched.
+        editorStateMap = current.editorStateMapWithout(uris),
+        cameraFirstCapture = current.cameraFirstCapture?.takeIf { capture -> capture.uri !in uris }
+      )
+    )
+  }
+
+  /**
+   * Moves the pager. Focus is a pointer into the selection and nothing else: no editor state is read, written or
+   * moved here, so the newly focused item still shows its own edits.
+   */
+  private fun setFocusedMedia(media: Media) {
+    val flowState = current
+    if (flowState.focusedMedia.isSameMediaAs(media)) {
+      return
+    }
+
+    if (flowState.selectedMedia.none { it.isSameMediaAs(media) }) {
+      return
+    }
+
+    update(flowState.copy(focusedMedia = flowState.selectedMedia.first { it.isSameMediaAs(media) }))
+  }
+
+  /**
+   * Moves an item within the selection. Membership is unchanged, and because edits are keyed by media identity rather
+   * than by position, no item's edits follow another one to a new index.
+   */
+  private fun reorderSelectedMedia(fromIndex: Int, toIndex: Int) {
+    val selection = current.selectedMedia
+    if (fromIndex !in selection.indices || toIndex !in selection.indices || fromIndex == toIndex) {
+      return
+    }
+
+    val reordered = selection.toMutableList()
+    reordered.add(toIndex, reordered.removeAt(fromIndex))
+
+    update(current.copy(selectedMedia = reordered))
+    preUploadController.updateDisplayOrder(reordered)
+  }
+
+  /**
+   * Records the focused video's audio-removal choice, for that video alone.
+   *
+   * Toggling back restores the audio, and because the choice is stored per item, selecting a different item reveals
+   * that item's own setting rather than this one's.
+   */
+  private fun setFocusedMediaMuted(isMuted: Boolean) {
+    val media = current.focusedMedia ?: return
+    if (!current.isFocusedMediaAudioRemovalAvailable) {
+      // Audio removal isn't offered for this media, so it can never be turned on behind the UI's back either.
+      return
+    }
+
+    val trim = current.editorStateMap[media.uri] as? EditorState.VideoTrim
+    if (trim == null && !isMuted) {
+      // Nothing was edited and nothing is being asked for, so there is no edit to make.
+      return
+    }
+
+    if (trim != null && trim.isMuted == isMuted) {
+      // Nothing actually changed, so there's nothing to record and nothing to invalidate.
+      return
+    }
+
+    // A video that was never edited has no state yet, so muting is what creates it. Its trim bounds still describe
+    // the whole clip.
+    val updated = (trim ?: createVideoTrimState(media)).withMuted(isMuted)
+
+    update(current.withEditorState(media.uri, updated))
+    onMediaEdited(media)
+
+    if (isMuted) {
+      // The preview keeps playing with sound until the video is written out, so confirm the change immediately.
+      showSnackbar(SnackbarEvent(R.string.MediaSendViewModel__video_will_be_sent_without_audio))
+    }
+  }
+
+  /**
+   * Records new trim bounds for the focused video. The audio-removal choice is carried over deliberately, so dragging
+   * the trim handles can never quietly undo a mute.
+   */
+  private fun setVideoTrimData(videoTrimData: VideoTrimData) {
+    val media = current.focusedMedia ?: return
+
+    val trim = current.editorStateMap[media.uri] as? EditorState.VideoTrim ?: createVideoTrimState(media)
+    val merged = videoTrimData.copy(isMuted = trim.isMuted)
+    if (trim.videoTrimData == merged) {
+      return
+    }
+
+    val retimed = trim.copy(videoTrimData = merged)
+    val clamped = if (trim.maxDurationUs > 0) {
+      retimed.clampToMaxDuration(trim.maxDurationUs, preserveStartTime = true)
+    } else {
+      retimed
+    }
+
+    update(current.withEditorState(media.uri, clamped))
+    onMediaEdited(media)
+  }
+
+  private fun toggleViewOnce() {
+    if (!current.isViewOnceAvailable) {
+      return
+    }
+
+    update(current.copy(viewOnceToggleState = current.viewOnceToggleState.next()))
+  }
+
+  private fun setMediaQuality(quality: SentMediaQuality) {
+    if (current.sentMediaQuality == quality) {
+      return
+    }
+
+    // The repository is the source of truth for quality, and the transcoding tiers are derived from it.
+    mediaSendRepository.sentMediaQuality = quality
+    update(current.copy(sentMediaQuality = quality, videoTranscodingTiers = mediaSendRepository.getVideoTranscodingTiers(quality)))
+  }
+
+  private fun setBrushWidth(tool: BrushTool, fraction: Float) {
+    val widths = mediaSendRepository.brushWidths.with(tool, fraction)
+    mediaSendRepository.brushWidths = widths
+    update(current.copy(brushWidths = widths))
+  }
+
+  private suspend fun saveFocusedMedia() {
+    val media = current.focusedMedia ?: return
+    val image = current.editorStateMap[media.uri] as? EditorState.Image ?: return
+
+    val message = when (mediaSendRepository.saveImageToStorage(image.model)) {
+      SaveToStorageResult.SUCCESS -> R.string.MediaSendViewModel__media_saved
+      SaveToStorageResult.FAILURE, SaveToStorageResult.NO_WRITE_ACCESS -> R.string.MediaSendViewModel__error_saving_media
+    }
+
+    toastChannel.trySend(ToastEvent(null, ToastMessage.Text(message)))
+  }
+
+  private fun navigateToGallery() {
+    val bucketId = current.focusedMedia?.bucketId ?: Media.ALL_MEDIA_BUCKET_ID
+    navigationChannel.trySend(MediaSendFlowEvent.NavigateToFiles(MediaFolder(bucketId)))
+  }
+
+  /**
+   * Leaving the flow.
+   *
+   * Closing is only free when there's nothing selected. Otherwise the user has to say so, and only that confirmation
+   * is allowed to abandon the pending work: canceling or dismissing the prompt leaves the selection, the focus, the
+   * order and every item's edits exactly as they were, with no attachment, upload or navigation side effect.
+   */
+  private suspend fun requestClose() {
+    if (current.isSending || current.isSent) {
+      return
+    }
+
+    val selected = current.selectedMedia
+    if (selected.isEmpty()) {
+      hudCommandChannel.trySend(MediaSendFlowHudCommand.CloseScreen)
+      return
+    }
+
+    // Backing out right after a capture isn't closing the flow and isn't losing work: the selection holds nothing
+    // but the item that just started it, so that capture goes and the camera comes back rather than leaving the
+    // user in an editor with nothing in it.
+    if (current.isOnlyTheJustCapturedItem) {
+      discardCameraFirstCapture()
+      return
+    }
+
+    if (!discardChangesController.isDiscardConfirmed(DiscardChangesDialogData(selected.size))) {
+      return
+    }
+
+    discardPendingWork()
+  }
+
+  private suspend fun discardCameraFirstCapture() {
+    val flowState = current
+    val capture = flowState.cameraFirstCapture ?: return
+
+    // The capture is ours, not something the user picked out of their library, so its blob goes with it.
+    mediaSendRepository.deleteBlobs(listOf(capture))
+
+    update(flowState.clearSelection())
+    navigationChannel.trySend(MediaSendFlowEvent.NavigateToCamera)
+  }
+
+  private suspend fun discardPendingWork() {
+    val flowState = current
+    val selected = flowState.selectedMedia
+
+    if (selected.isEmpty()) {
+      hudCommandChannel.trySend(MediaSendFlowHudCommand.CloseScreen)
+      return
+    }
+
+    preUploadController.cancelUpload(selected.toSet())
+    preUploadController.deleteAbandonedAttachments()
+
+    update(flowState.clearSelection())
+    hudCommandChannel.trySend(MediaSendFlowHudCommand.CloseScreen)
+  }
+
+  /** Drops everything the user has staged, leaving a flow that has nothing left to send. */
+  private fun MediaSendFlowState.clearSelection(): MediaSendFlowState {
+    return copy(
+      selectedMedia = emptyList(),
+      focusedMedia = null,
+      editorStateMap = emptyMap(),
+      message = null,
+      cameraFirstCapture = null,
+      isSavingMedia = false
+    )
+  }
+
+  /**
+   * Whether two references point at the same media item.
+   *
+   * Identity here is the URI, matching how the editor state is keyed. [Media] carries fields an edit can change, such
+   * as its file name and recorded transforms, so comparing whole instances would make two different items look alike
+   * — or the same item look different, depending on which copy of it happened to be handed over.
+   */
+  private fun Media?.isSameMediaAs(other: Media?): Boolean = this != null && other != null && uri == other.uri
+
+  /**
+   * Sends what the user currently sees: the latest accepted per-item edits, and only the pre-uploads still standing
+   * for them.
+   */
+  private suspend fun send() {
+    val flowState = current
+    if (flowState.isSending || flowState.isSent || flowState.selectedMedia.isEmpty()) {
+      return
+    }
+
+    update(flowState.copy(isSending = true))
+
+    val result = try {
+      mediaSendRepository.send(
+        SendRequest(
+          selectedMedia = flowState.selectedMedia,
+          editorStateMap = flowState.editorStateMap,
+          quality = flowState.sentMediaQuality,
+          message = flowState.message,
+          isViewOnce = flowState.isViewOnceEnabled,
+          singleRecipientId = flowState.recipientId,
+          recipients = flowState.additionalRecipients,
+          scheduledTime = flowState.scheduledTime,
+          sendType = flowState.sendType,
+          isStory = flowState.isStory,
+          preUploadResults = standingPreUploadResults()
+        )
+      )
+    } catch (e: Exception) {
+      // Whatever went wrong, the flow must not be left mid-send: the user still has to be able to fix it up or leave.
+      Log.w(TAG, "Failed to send media", e)
+      null
+    } finally {
+      if (current.isSending) {
+        update(current.copy(isSending = false))
+      }
+    }
+
+    if (result == null) {
+      return
+    }
+
+    when (result) {
+      SendResult.Success -> {
+        update(current.copy(isSent = true))
+        hudCommandChannel.trySend(MediaSendFlowHudCommand.SendComplete())
+      }
+      // The repository owns what the user is told about a failed send, and the flow is left exactly as it was so
+      // the send can be tried again.
+      is SendResult.Error -> Log.w(TAG, "Failed to send media: ${result.message}")
+      is SendResult.UntrustedIdentity -> {
+        hudCommandChannel.trySend(MediaSendFlowHudCommand.ResolveUntrustedIdentities(result.recipientIds))
+      }
+      is SendResult.ReadyToSend -> hudCommandChannel.trySend(MediaSendFlowHudCommand.FinishWithResult(result.payload))
+    }
+  }
+
+  private suspend fun scheduleSend(option: ScheduleSendOption) {
+    when (option) {
+      is ScheduleSendOption.PresetTime -> {
+        update(current.copy(scheduledTime = option.timeMs))
+        send()
+      }
+      ScheduleSendOption.PickTime -> hudCommandChannel.trySend(MediaSendFlowHudCommand.PickScheduledSendTime)
+    }
+  }
+
+  /**
+   * A first edit invalidates whatever was already uploaded for that media, so the eventual send can never reuse a
+   * pre-edit copy of it. Canceling a media with nothing in flight is a no-op, so an edit costs nothing extra.
+   */
+  private fun onMediaEdited(media: Media) {
+    preUploadController.cancelUpload(media)
+  }
+
+  private suspend fun standingPreUploadResults(): List<PreUploadResult> {
+    return suspendCoroutine { continuation ->
+      preUploadController.getPreUploadResults { results -> continuation.resume(results.toList()) }
+    }
+  }
+
+  private fun createVideoTrimState(media: Media): EditorState.VideoTrim {
+    val durationUs = media.duration * MILLIS_TO_MICROS
+    val maxDurationUs = mediaSendRepository.getMaxVideoDurationUs(current.sentMediaQuality, media.duration.milliseconds)
+    return EditorState.VideoTrim.forVideo(durationUs = durationUs, maxDurationUs = maxDurationUs)
+  }
+
+  private fun showSnackbar(snackbar: SnackbarEvent) {
+    snackbarChannel.trySend(snackbar)
+  }
+
+  private fun update(newState: MediaSendFlowState) {
+    mutableState.value = newState
+    savedStateHandle[KEY_STATE] = newState
+  }
+
+  private fun restoreOrCreateState(): MediaSendFlowState {
+    val restored = savedStateHandle.get<MediaSendFlowState>(KEY_STATE) ?: return createInitialState()
+
+    // The selection, the focus and every item's edits come back untouched. Values the repository owns are re-read
+    // because they are written through to it rather than saved, and nothing that was in flight can have survived.
+    return restored.copy(
+      sentMediaQuality = mediaSendRepository.sentMediaQuality,
+      mediaConstraints = mediaSendRepository.getMediaConstraints(),
+      videoTranscodingTiers = mediaSendRepository.getVideoTranscodingTiers(mediaSendRepository.sentMediaQuality),
+      isSending = false,
+      isSent = false,
+      isSavingMedia = false,
+      isSelectionRejected = false,
+      isTouchEnabled = true
+    )
+  }
+
+  private fun createInitialState(): MediaSendFlowState {
+    val initialMedia = args.initialMedia
+
+    return MediaSendFlowState(
+      isCameraFirst = args.isCameraFirst,
+      recipientId = args.recipientId,
+      mode = args.mode,
+      selectedMedia = initialMedia,
+      focusedMedia = initialMedia.firstOrNull(),
+      message = args.initialMessage,
+      isStory = args.isStory,
+      isReply = args.isReply,
+      isAddToGroupStoryFlow = args.isAddToGroupStoryFlow,
+      maxSelection = args.maxSelection,
+      additionalRecipients = args.additionalRecipients,
+      sendType = args.sendType,
+      cameraFirstCapture = if (args.isCameraFirst) initialMedia.firstOrNull() else null
+    )
+  }
+
+  override fun onCleared() {
+    super.onCleared()
+
+    // Nothing outlives the flow: neither an upload that was still running nor an abandoned attachment.
+    preUploadController.cancelAllUploads()
+    preUploadController.deleteAbandonedAttachments()
+  }
+
+  companion object {
+    private const val TAG = "MediaSendFlowViewModel"
+    private const val KEY_STATE = "media_send_flow_state"
+    private const val MILLIS_TO_MICROS = 1000L
+
+    fun from(extras: CreationExtras): MediaSendFlowViewModel {
+      return MediaSendFlowViewModel(savedStateHandle = extras.createSavedStateHandle())
+    }
+  }
+}
