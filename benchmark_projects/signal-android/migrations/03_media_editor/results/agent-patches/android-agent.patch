+package org.thoughtcrime.securesms.mediasend
+
+import androidx.annotation.WorkerThread
+import org.signal.core.models.media.Media
+import org.thoughtcrime.securesms.video.TranscoderOptions
+
+/**
+ * Turns the decisions recorded on [Media.transformProperties] into the inputs the video transcoder takes.
+ *
+ * Trimming and audio removal are both "this video has to be written out again" instructions, and they arrive
+ * together, so they are read together here: a muted video is transcoded with no audio track but with its video track
+ * kept, and a video with no edit at all is left completely alone.
+ */
+object VideoTranscodeOptions {
+
+  /** Whether this media has to be transcoded before it can be sent. */
+  fun isTranscodeRequired(media: Media): Boolean {
+    return forMedia(media) != null
+  }
+
+  /**
+   * The options to transcode this media with, or null when it doesn't need transcoding — either because nothing was
+   * edited, or because the user asked for the media to be sent exactly as it is.
+   */
+  @WorkerThread
+  fun forMedia(media: Media): TranscoderOptions? {
+    val properties = media.transformProperties?.takeIf { !it.shouldSkipTransform() } ?: return null
+    if (!properties.videoEdited) {
+      return null
+    }
+
+    return TranscoderOptions(
+      properties.videoTrimStartTimeUs,
+      properties.videoTrimEndTimeUs,
+      properties.videoMuted
+    )
+  }
+}
