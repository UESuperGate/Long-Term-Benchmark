+import org.signal.mediasend.screens.edit.video.VideoTrimData
+
+/**
+ * What the editor page shows for the focused item, resolved from the flow state.
+ *
+ * This is a read model: building it changes nothing, so scrolling the pager or laying out a wider variant of the
+ * editor can never count as an edit.
+ */
+data class MediaEditScreenState(
+  val selectedMedia: List<Media> = emptyList(),
+  val focusedMedia: Media? = null,
+  val focusedIndex: Int = -1,
+  val isCameraFirst: Boolean = false,
+  val cameraFirstCapture: Media? = null,
+  val editorState: EditorState? = null,
+  val message: CharSequence? = null,
+  /** Whether leaving now would throw work away, and therefore whether closing has to ask first. */
+  val isDiscardConfirmationRequired: Boolean = false,
+  /** Whether backing out drops the just-captured item and returns to the camera instead of asking. */
+  val isOnlyTheJustCapturedItem: Boolean = false,
+  val isSavingMedia: Boolean = false,
+  val isTouchEnabled: Boolean = true
+) {
+  /** Whether there is anything to edit at all. */
+  val hasSelection: Boolean
+    get() = selectedMedia.isNotEmpty()
+
+  /** The trim bounds and audio-removal choice of the focused video, or null when it isn't an editable video. */
+  val focusedVideoTrimData: VideoTrimData?
+    get() = (editorState as? EditorState.VideoTrim)?.videoTrimData
+}
+
+/**
+ * Wires the editor page to the flow that owns the state.
+ *
+ * The page holds no state of its own. Everything it renders is derived from [MediaSendFlowState], and everything the
+ * user does leaves as an event, which is what lets the page come back after recreation without resetting anything.
+ */
+internal class MediaEditScreen(private val viewModel: MediaSendFlowViewModel) {
+
+  val flowState: StateFlow<MediaSendFlowState> = viewModel.state
+
+  val toolbar: MediaEditorToolbar = MediaEditorToolbar(viewModel.state)
+
+  /** Effects the page renders but doesn't own. */
+  val hudCommands: Flow<MediaSendFlowHudCommand> = viewModel.hudCommands
+  val navigationEvents: Flow<MediaSendFlowEvent> = viewModel.navigationEvents
+  val snackbars: Flow<SnackbarEvent> = viewModel.snackbarEvents
+  val toasts: Flow<ToastEvent> = viewModel.toastEvents
+
+  val screenState: MediaEditScreenState
+    get() = flowState.value.toScreenState()
+
+  fun onScreenEvent(event: MediaEditScreenEvents) {
+    viewModel.onScreenEvent(event)
+  }
+
+  fun onFlowEvent(event: MediaSendFlowEvent) {
+    viewModel.onEvent(event)
+  }
+
+  /** Tapping the mute button, or flipping it either way, acts on the focused video and nothing else. */
+  fun onMuteClicked() {
+    onScreenEvent(MediaEditScreenEvents.ToggleVideoMuted)
+  }
+
+  fun onMuteClicked(muted: Boolean) {
+    onScreenEvent(MediaEditScreenEvents.SetVideoMuted(muted))
+  }
+
+  fun onBackClicked() {
+    onScreenEvent(MediaEditScreenEvents.NavigateBack)
+  }
+
+  fun onPageChanged(media: Media) {
+    onScreenEvent(MediaEditScreenEvents.FocusedMediaChanged(media))
+  }
+
+  fun onMediaRemoved(media: Media) {
+    onScreenEvent(MediaEditScreenEvents.RemoveMedia(media))
+  }
+
+  fun onMediaReordered(fromIndex: Int, toIndex: Int) {
+    onScreenEvent(MediaEditScreenEvents.ReorderSelectedMedia(fromIndex, toIndex))
+  }
+}
+
+/**
+ * Projects the flow state onto the editor page.
+ *
+ * [MediaEditScreenState.focusedMedia] and [MediaEditScreenState.editorState] are both read from the same snapshot, so
+ * a reordering or a focus change can never pair one item with another's edits.
+ */
+fun MediaSendFlowState.toScreenState(): MediaEditScreenState {
+  return MediaEditScreenState(
+    selectedMedia = selectedMedia,
+    focusedMedia = focusedMedia,
+    focusedIndex = focusedMedia?.let { focused -> selectedMedia.indexOfFirst { it.uri == focused.uri } } ?: -1,
+    isCameraFirst = isCameraFirst,
+    cameraFirstCapture = cameraFirstCapture,
+    editorState = focusedMedia?.let { editorStateMap[it.uri] },
+    message = message,
+    isDiscardConfirmationRequired = selectedMedia.isNotEmpty(),
+    isOnlyTheJustCapturedItem = isOnlyTheJustCapturedItem,
+    isSavingMedia = isSavingMedia,
+    isTouchEnabled = isTouchEnabled
+  )
+}
