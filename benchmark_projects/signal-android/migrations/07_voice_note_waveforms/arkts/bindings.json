    {
      "caseId": "vw_002_audio_upload_waits_for_waveform",
      "key": "audio_upload_waits_for_waveform",
      "traceDigest": "ae4fd19f8d9673a15cf07b9ad094e4008b43d23097be4007e9ba4a40c81877ab",
      "traceSchemaVersion": 2,
      "taskId": "07_voice_note_waveforms",
      "given": {
        "attachment": {
          "id": "audio-2",
          "contentType": "audio/ogg",
          "compression": "pending",
          "waveform": "absent",
          "upload": "not_started"
        },
        "waveformWorker": "held_until_released"
      },
      "event": {
        "name": "runAttachmentUploadChain",
        "releaseWaveformWorkerAfterCheckpoint": true
      },
      "expected": {
        "checkpointBeforeRelease": {
          "compression": "complete",
          "waveformGeneration": "running",
          "upload": "not_started"
        },
        "orderedEffectsAfterRelease": [
          {
            "name": "compressAttachment",
            "attachmentId": "audio-2",
            "count": 1
          },
          {
            "name": "generateWaveform",
            "attachmentId": "audio-2",
            "count": 1
          },
          {
            "name": "uploadAttachment",
            "attachmentId": "audio-2",
            "count": 1
          }
        ],
        "finalState": {
          "waveform": "persisted",
          "upload": "complete"
        }
      },
      "invariants": [
        "audio upload cannot start while waveform generation is unresolved",
        "releasing the waveform worker resumes the same chain rather than creating a second upload",
        "compression still precedes waveform generation"
      ],
      "fixture": "RuntimeHarness.heldWaveformWorker",
      "eventEntrypoint": "Index.owner.startUploadGraph+releaseHeldWaveform",
      "observations": [
        "owner.currentState.beforeRelease",
        "owner.currentState.afterRelease",
        "owner.currentEffects"
      ]
    },
    {
      "caseId": "vw_003_mixed_uploads_gate_only_audio",
      "key": "mixed_uploads_gate_only_audio",
      "traceDigest": "7b8c9497ae6e55af07d7952a3da323be7a74ee83a49e487383803f56e29bb854",
      "traceSchemaVersion": 2,
      "taskId": "07_voice_note_waveforms",
      "given": {
        "attachments": [
          {
            "id": "audio-3",
            "contentType": "audio/mp4",
            "waveformWorker": "held"
          },
          {
            "id": "image-3",
            "contentType": "image/jpeg"
          }
        ],
        "scheduler": "run_all_ready_work"
      },
      "event": {
        "name": "runMixedAttachmentUploadGraph",
        "thenRelease": "audio-3.waveformWorker"
      },
      "expected": {
        "checkpointBeforeRelease": {
          "audio-3": {
            "compression": "complete",
            "waveformGeneration": "running",
            "upload": "not_started"
          },
          "image-3": {
            "compression": "complete",
            "waveformGeneration": "not_scheduled",
            "upload": "complete"
          }
        },
        "finalState": {
          "audio-3.upload": "complete",
          "image-3.upload": "complete"
        },
        "effectCounts": {
          "audio-3.generateWaveform": 1,
          "audio-3.uploadAttachment": 1,
          "image-3.generateWaveform": 0,
          "image-3.uploadAttachment": 1
        }
      },
      "invariants": [
        "waveform gating is selected by attachment media type, not by the containing message",
        "an audio dependency cannot block an independent non-audio upload chain",
        "non-audio state is not assigned synthetic waveform metadata"
      ],
      "fixture": "RuntimeHarness.mixedAudioAndImageAttachments",
      "eventEntrypoint": "Index.owner.startMixedUploadGraph+releaseMixedAudio",
      "observations": [
        "owner.currentState.beforeRelease",
        "owner.currentState.afterRelease",
        "owner.currentEffects"
      ]
    },
