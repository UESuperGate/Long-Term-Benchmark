+++ b/entry/src/main/ets/common/EffectRecorder.ets
@@ -0,0 +1,22 @@
+import { JsonMap, jsonMap } from './JsonMap';
+
+/**
+ * Ordered log of the side effects a waveform flow performed. The recorder keeps
+ * the observed ordering (compress before waveform generation before upload)
+ * observable to the page and to the attachment upload graph.
+ */
+export class EffectRecorder {
+  private effects: JsonMap[] = [];
+
+  record(name: string, attachmentId: string): void {
+    this.effects.push(jsonMap(['name', 'attachmentId'], [name, attachmentId]));
+  }
+
+  reset(): void {
+    this.effects = [];
+  }
+
+  snapshot(): JsonMap[] {
+    return JSON.parse(JSON.stringify(this.effects)) as JsonMap[];
+  }
+}
