@@ -0,0 +1,28 @@
+/** Waveform sizing constants shared by generation, transport and rendering. */
+
+/** Number of bars a locally generated waveform carries. */
+export const GENERATED_BAR_COUNT: number = 50;
+
+/** Bar count the voice note waveform UI always renders, whatever arrived on the wire. */
+export const RENDER_BAR_COUNT: number = 50;
+
+/** Largest number of bars the service accepts from a remote sender. */
+export const SERVICE_WAVEFORM_BAR_LIMIT: number = 100;
+
+/** Waveform magnitudes are unsigned bytes: silence is 0, full scale is 255. */
+export const MAX_BAR_MAGNITUDE: number = 255;
+
+/**
+ * Waveform generation is only ever attached to audio media. Everything else
+ * (images, documents, video) keeps its ordinary upload chain untouched.
+ */
+export function isAudioAttachment(contentType: string): boolean {
+  const type: string = contentType.toLowerCase();
+  if (type.length === 0) {
+    return false;
+  }
+  if (type.startsWith('audio/')) {
+    return true;
+  }
+  return type === 'application/ogg' || type === 'application/x-ogg' || type.indexOf('opus') >= 0;
+}
