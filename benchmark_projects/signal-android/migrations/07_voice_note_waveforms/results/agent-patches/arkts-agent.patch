index 0000000000000000000000000000000000000000..008f2a8106fef8fd55644ae3ce0dede90dc52b39
--- /dev/null
+++ b/entry/src/main/ets/waveform/WaveformMagnitude.ets
@@ -0,0 +1,24 @@
+import { GENERATED_BAR_COUNT, MAX_BAR_MAGNITUDE } from './WaveformLimits';
+
+function isUsableMagnitude(value: number): boolean {
+  return value === value && value < Infinity && value > -Infinity;
+}
+
+/** Keeps a magnitude inside the unsigned 0..255 waveform range. */
+export function clampMagnitude(value: number): number {
+  if (!isUsableMagnitude(value)) {
+    return 0;
+  }
+  const rounded: number = Math.round(value);
+  return rounded < 0 ? 0 : (rounded > MAX_BAR_MAGNITUDE ? MAX_BAR_MAGNITUDE : rounded);
+}
+
+/** Normalizes an unsigned magnitude to the 0..1 range used by the waveform UI. */
+export function normalizeMagnitude(value: number): number {
+  return clampMagnitude(value) / MAX_BAR_MAGNITUDE;
+}
+
+/** A locally generated waveform whose bar count still matches the current release. */
+export function isCurrentGeneratedBarCount(barCount: number): boolean {
+  return barCount === GENERATED_BAR_COUNT;
+}
