diff --git a/entry/src/main/ets/waveform/WaveformRenderer.ets b/entry/src/main/ets/waveform/WaveformRenderer.ets
new file mode 100644
index 0000000000000000000000000000000000000000..cef7ce99afae1daa2870ad0a98c376517adf16bb
--- /dev/null
+++ b/entry/src/main/ets/waveform/WaveformRenderer.ets
@@ -0,0 +1,52 @@
+import { RENDER_BAR_COUNT } from './WaveformLimits';
+import { clampMagnitude, normalizeMagnitude } from './WaveformMagnitude';
+import { WaveformRecord } from './WaveformRecord';
+
+/**
+ * Turns a stored waveform into the fixed size bar list the voice note waveform
+ * UI draws. Transported bars are read as unsigned magnitudes and resampled with
+ * deterministic bucket averages, so a sender waveform renders identically
+ * whether it carries 4, 50 or 100 bars and whether or not the media file is
+ * available locally.
+ */
+export class WaveformRenderer {
+  bars(record: WaveformRecord, barCount: number = RENDER_BAR_COUNT): number[] {
+    const source: number[] = record.bytes;
+    if (barCount <= 0 || source.length === 0) {
+      return [];
+    }
+    if (source.length === barCount) {
+      const copy: number[] = [];
+      for (let index = 0; index < source.length; index++) {
+        copy.push(clampMagnitude(source[index]));
+      }
+      return copy;
+    }
+    const length: number = source.length;
+    const resampled: number[] = [];
+    for (let bar = 0; bar < barCount; bar++) {
+      let start: number = Math.floor(bar * length / barCount);
+      let end: number = Math.floor((bar + 1) * length / barCount);
+      if (end <= start) {
+        end = Math.min(length, start + 1);
+      }
+      if (start >= length) {
+        start = length - 1;
+      }
+      if (end > length) {
+        end = length;
+      }
+      let sum: number = 0;
+      for (let index = start; index < end; index++) {
+        sum += clampMagnitude(source[index]);
+      }
+      resampled.push(clampMagnitude(end > start ? sum / (end - start) : 0));
+    }
+    return resampled;
+  }
+
+  /** The rendered bars normalized to 0..1 for the waveform view. */
+  normalized(record: WaveformRecord, barCount: number = RENDER_BAR_COUNT): number[] {
+    return this.bars(record, barCount).map((value: number): number => normalizeMagnitude(value));
+  }
+}
