@@ -0,0 +1,57 @@
+/**
+ * Shared helpers for the JSON shaped payloads the waveform feature passes
+ * between the page owner, the attachment store and the transport layer.
+ */
+
+export type JsonMap = Record<string, Object>;
+
+export function jsonMap(keys: string[] = [], values: Object[] = []): JsonMap {
+  const value: JsonMap = JSON.parse('{}') as JsonMap;
+  for (let index = 0; index < keys.length; index++) {
+    value[keys[index]] = values[index];
+  }
+  return value;
+}
+
+export function cloneMap(value: JsonMap): JsonMap {
+  return JSON.parse(JSON.stringify(value)) as JsonMap;
+}
+
+export function cloneNumbers(values: number[]): number[] {
+  return JSON.parse(JSON.stringify(values)) as number[];
+}
+
+export function asMap(value: Object | undefined): JsonMap {
+  return value !== undefined && value !== null && !Array.isArray(value) ? value as JsonMap : jsonMap();
+}
+
+export function asMaps(value: Object | undefined): JsonMap[] {
+  return Array.isArray(value) ? (value as Object[]).map((item: Object): JsonMap => asMap(item)) : [];
+}
+
+export function asNumbers(value: Object | undefined): number[] {
+  return Array.isArray(value) ? (value as Object[]).map((item: Object): number => Number(item)) : [];
+}
+
+export function mapText(source: JsonMap, key: string): string {
+  const item: Object = source[key];
+  return typeof item === 'string' ? item : '';
+}
+
+export function mapNumber(source: JsonMap, key: string): number {
+  const item: Object = source[key];
+  return typeof item === 'number' ? item : 0;
+}
+
+export function mapBoolean(source: JsonMap, key: string): boolean {
+  const item: Object = source[key];
+  return typeof item === 'boolean' ? item : false;
+}
+
+export function isEmptyMap(source: JsonMap): boolean {
+  return Object.keys(source).length === 0;
+}
+
+export function isPresent(value: Object | undefined): boolean {
+  return value !== undefined && value !== null;
+}
