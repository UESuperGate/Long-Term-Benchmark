diff --git a/entry/src/main/ets/waveform/WaveformStore.ets b/entry/src/main/ets/waveform/WaveformStore.ets
new file mode 100644
index 0000000000000000000000000000000000000000..14833b67af911abb43feccc8e188ff5727044de3
--- /dev/null
+++ b/entry/src/main/ets/waveform/WaveformStore.ets
@@ -0,0 +1,55 @@
+import { preferences } from '@kit.ArkData';
+import { JsonMap, jsonMap, mapText } from '../common/JsonMap';
+import { WaveformRecord } from './WaveformRecord';
+
+const WAVEFORM_KEY: string = 'waveform';
+
+/**
+ * Persistence for the waveform row that belongs to the current attachment. A
+ * row is written as a single value so that recovery replaces the whole row
+ * atomically instead of leaving a half written waveform behind.
+ */
+export class WaveformStore {
+  private store: preferences.Preferences;
+
+  constructor(store: preferences.Preferences) {
+    this.store = store;
+  }
+
+  async clear(): Promise<void> {
+    await this.store.clear();
+    await this.store.flush();
+  }
+
+  async flush(): Promise<void> {
+    await this.store.flush();
+  }
+
+  async writeRecord(record: WaveformRecord): Promise<void> {
+    await this.store.put(WAVEFORM_KEY, JSON.stringify(record.toPersistence()));
+    await this.store.flush();
+  }
+
+  async readRecord(): Promise<WaveformRecord | undefined> {
+    const raw: preferences.ValueType = await this.store.get(WAVEFORM_KEY, '');
+    if (typeof raw !== 'string' || raw.length === 0) {
+      return undefined;
+    }
+    return this.parseRow(raw);
+  }
+
+  private parseRow(raw: string): WaveformRecord | undefined {
+    try {
+      const row: JsonMap = JSON.parse(raw) as JsonMap;
+      return WaveformRecord.fromStored(mapText(row, 'attachmentId'), row);
+    } catch (error) {
+      console.warn('[waveform] dropping unreadable waveform row: ' + JSON.stringify(error));
+      return undefined;
+    }
+  }
+
+  /** Snapshot of the persisted row, used by the attachment view after a reload. */
+  snapshot(record: WaveformRecord | undefined): JsonMap {
+    return record === undefined ? jsonMap() : jsonMap(['waveform'], [record.toPersistence()]);
+  }
+}
