@@ -0,0 +1,49 @@
+import { EffectRecorder } from '../common/EffectRecorder';
+import { JsonMap, asMap, asNumbers, cloneNumbers, jsonMap, mapBoolean, mapNumber, mapText } from '../common/JsonMap';
+import { WaveformRecord, decodeWaveformMagnitudes } from './WaveformRecord';
+
+/**
+ * The backup artifact for one attachment. Export writes the waveform into the
+ * backup payload verbatim, restore reads it back and keeps the remote origin so
+ * a restored sender waveform is never mistaken for a local cache entry.
+ */
+export class WaveformBackupFile {
+  private payload: JsonMap = jsonMap();
+
+  reset(): void {
+    this.payload = jsonMap();
+  }
+
+  /** Writes the backup entry and returns the exported attachment pointer. */
+  exportAttachment(attachment: JsonMap, record: WaveformRecord | undefined): JsonMap {
+    const pointer: JsonMap = jsonMap();
+    const contentType: string = mapText(attachment, 'contentType');
+    if (contentType.length > 0) {
+      pointer['contentType'] = contentType;
+    }
+    const cdnKey: string = mapText(attachment, 'cdnKey');
+    if (cdnKey.length > 0) {
+      pointer['cdnKey'] = cdnKey;
+    }
+    if (record !== undefined) {
+      pointer['attachmentId'] = record.attachmentId;
+      pointer['barCount'] = record.barCount();
+      pointer['audioWaveform'] = cloneNumbers(record.bytes);
+      pointer['audioDurationSeconds'] = record.durationSeconds;
+      pointer['senderProvided'] = record.senderProvided;
+    }
+    this.payload = jsonMap(['version', 'attachment'], [1, pointer]);
+    return pointer;
+  }
+
+  restoreAttachment(): WaveformRecord | undefined {
+    const pointer: JsonMap = asMap(this.payload['attachment']);
+    const waveform: Object | undefined = pointer['audioWaveform'];
+    if (waveform === undefined || waveform === null) {
+      return undefined;
+    }
+    const bytes: number[] = Array.isArray(waveform) ? asNumbers(waveform) : decodeWaveformMagnitudes(asMap(waveform));
+    return new WaveformRecord(mapText(pointer, 'attachmentId'), bytes,
+      mapNumber(pointer, 'audioDurationSeconds'), mapBoolean(pointer, 'senderProvided'));
+  }
+}
