@@ -0,0 +1,126 @@
+import { EffectRecorder } from '../common/EffectRecorder';
+import { JsonMap, jsonMap, mapText } from '../common/JsonMap';
+import { WaveformGenerationService } from '../waveform/WaveformGenerationService';
+import { WaveformRecord } from '../waveform/WaveformRecord';
+import { AttachmentUploadChain } from './AttachmentUploadChain';
+
+/**
+ * Runs the attachment upload graph.
+ *
+ * Compression always comes first. For audio the graph then parks on the
+ * waveform dependency: releasing the generation worker resumes the very same
+ * chain, so an attachment is never uploaded twice and an unrelated non-audio
+ * attachment is never blocked by an audio waveform that is still pending.
+ */
+export class AttachmentUploadGraph {
+  private recorder: EffectRecorder;
+  private generation: WaveformGenerationService;
+  private order: string[] = [];
+  private sources: Map<string, JsonMap> = new Map();
+  private chains: Map<string, AttachmentUploadChain> = new Map();
+
+  constructor(recorder: EffectRecorder, generation: WaveformGenerationService) {
+    this.recorder = recorder;
+    this.generation = generation;
+  }
+
+  reset(): void {
+    this.order = [];
+    this.sources.clear();
+    this.chains.clear();
+  }
+
+  /** Remembers an attachment so a released waveform worker can resume its chain. */
+  observe(attachment: JsonMap): void {
+    const attachmentId: string = mapText(attachment, 'id');
+    if (!this.sources.has(attachmentId)) {
+      this.sources.set(attachmentId, attachment);
+    }
+  }
+
+  /** Enters the chain for one attachment: compress, then waveform, then upload. */
+  start(attachment: JsonMap, hasUsableWaveform: boolean): AttachmentUploadChain {
+    const attachmentId: string = mapText(attachment, 'id');
+    let chain: AttachmentUploadChain | undefined = this.chains.get(attachmentId);
+    if (chain === undefined) {
+      chain = new AttachmentUploadChain(attachmentId, mapText(attachment, 'contentType'));
+      this.chains.set(attachmentId, chain);
+      this.sources.set(attachmentId, attachment);
+      this.order.push(attachmentId);
+    }
+    if (!chain.isCompressed()) {
+      this.recorder.record('compressAttachment', attachmentId);
+      chain.markCompressed();
+    }
+    if (chain.isAudio()) {
+      if (chain.isWaveformResolved() || hasUsableWaveform) {
+        chain.resolveWaveform();
+      } else {
+        chain.holdWaveformGeneration();
+      }
+    } else {
+      chain.skipWaveformGeneration();
+    }
+    this.runUpload(chain);
+    return chain;
+  }
+
+  /** Releases the waveform worker of one attachment and resumes its chain. */
+  async release(attachmentId: string, samples: number[], durationUs: number): Promise<AttachmentUploadChain | undefined> {
+    if (!this.chains.has(attachmentId)) {
+      const source: JsonMap | undefined = this.sources.get(attachmentId);
+      if (source === undefined) {
+        return undefined;
+      }
+      this.start(source, false);
+    }
+    const chain: AttachmentUploadChain | undefined = this.chains.get(attachmentId);
+    if (chain === undefined) {
+      return undefined;
+    }
+    if (chain.isAudio() && !chain.isWaveformResolved()) {
+      const record: WaveformRecord | undefined =
+        await this.generation.run(attachmentId, samples, durationUs, true);
+      if (record !== undefined) {
+        chain.resolveWaveform();
+      } else {
+        chain.failWaveformGeneration();
+      }
+    }
+    this.runUpload(chain);
+    return chain;
+  }
+
+  /** Releases every audio attachment that is still parked on its waveform. */
+  async releasePendingAudio(samples: number[], durationUs: number): Promise<void> {
+    const pending: string[] = [];
+    for (let index = 0; index < this.order.length; index++) {
+      const chain: AttachmentUploadChain | undefined = this.chains.get(this.order[index]);
+      if (chain !== undefined && chain.isWaveformPending()) {
+        pending.push(chain.attachmentId);
+      }
+    }
+    for (let index = 0; index < pending.length; index++) {
+      await this.release(pending[index], samples, durationUs);
+    }
+  }
+
+  snapshot(): JsonMap {
+    const result: JsonMap = jsonMap();
+    for (let index = 0; index < this.order.length; index++) {
+      const chain: AttachmentUploadChain | undefined = this.chains.get(this.order[index]);
+      if (chain !== undefined) {
+        result[chain.attachmentId] = chain.snapshot();
+      }
+    }
+    return result;
+  }
+
+  private runUpload(chain: AttachmentUploadChain): void {
+    if (!chain.isWaveformResolved() || chain.isUploadStarted()) {
+      return;
+    }
+    chain.markUploadStarted();
+    this.recorder.record('uploadAttachment', chain.attachmentId);
+  }
+}
