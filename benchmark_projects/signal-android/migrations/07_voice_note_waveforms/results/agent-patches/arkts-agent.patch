+import { JsonMap, asMap, asMaps, isPresent } from '../common/JsonMap';
+import { MAX_BAR_MAGNITUDE } from './WaveformLimits';
+
+/**
+ * Bounded, strict view of a waveform payload that arrived from the network.
+ *
+ * The declared bar count is read from the payload shape first and rejected
+ * against the service limit *before* any magnitude is materialised, so an
+ * oversized payload fails closed instead of being expanded into memory. Only
+ * genuine unsigned magnitudes survive the read: strings, booleans and nulls are
+ * malformed rather than silently coerced.
+ */
+export class TransportWaveform {
+  declaredBarCount: number = 0;
+  bytes: number[] = [];
+  oversized: boolean = false;
+  malformed: boolean = false;
+}
+
+function strictMagnitude(item: Object | undefined): number {
+  if (typeof item === 'number') {
+    const value: number = item;
+    if (Math.round(value) !== value || value < 0 || value > MAX_BAR_MAGNITUDE) {
+      return -1;
+    }
+    return value;
+  }
+  return -1;
+}
+
+/** Bar count declared by a payload field, or -1 when the field is not a valid count. */
+function declaredCount(source: JsonMap, key: string): number {
+  const item: Object = source[key];
+  if (typeof item === 'number') {
+    const value: number = item;
+    return Math.round(value) === value && value >= 0 ? value : -1;
+  }
+  return -1;
+}
+
+function overLimit(result: TransportWaveform, limit: number): boolean {
+  if (result.declaredBarCount > limit) {
+    result.oversized = true;
+    return true;
+  }
+  return false;
+}
+
+function isEmptyWaveform(result: TransportWaveform): boolean {
+  if (result.declaredBarCount === 0) {
+    result.malformed = true;
+    return true;
+  }
+  return false;
+}
+
+export function readTransportWaveform(value: Object | undefined, limit: number): TransportWaveform {
+  const result: TransportWaveform = new TransportWaveform();
+  if (!isPresent(value)) {
+    result.malformed = true;
+    return result;
+  }
+  if (Array.isArray(value)) {
+    const items: Object[] = value as Object[];
+    result.declaredBarCount = items.length;
+    if (overLimit(result, limit) || isEmptyWaveform(result)) {
+      return result;
+    }
+    for (let index = 0; index < items.length; index++) {
+      const magnitude: number = strictMagnitude(items[index]);
+      if (magnitude < 0) {
+        result.malformed = true;
+        return result;
+      }
+      result.bytes.push(magnitude);
+    }
+    return result;
+  }
+  const source: JsonMap = asMap(value);
+  const segments: JsonMap[] = asMaps(source['segments']);
+  if (segments.length > 0) {
+    for (let index = 0; index < segments.length; index++) {
+      const count: number = declaredCount(segments[index], 'count');
+      if (count < 0) {
+        result.malformed = true;
+        return result;
+      }
+      result.declaredBarCount += count;
+      if (overLimit(result, limit)) {
+        return result;
+      }
+    }
+    if (isEmptyWaveform(result)) {
+      return result;
+    }
+    for (let index = 0; index < segments.length; index++) {
+      const segment: JsonMap = segments[index];
+      const magnitude: number = strictMagnitude(segment['value']);
+      const count: number = declaredCount(segment, 'count');
+      if (magnitude < 0) {
+        result.malformed = true;
+        return result;
+      }
+      for (let bar = 0; bar < count; bar++) {
+        result.bytes.push(magnitude);
+      }
+    }
+    return result;
+  }
+  const barCount: number = declaredCount(source, 'barCount');
+  if (barCount < 0) {
+    result.malformed = true;
+    return result;
+  }
+  result.declaredBarCount = barCount;
+  if (overLimit(result, limit) || isEmptyWaveform(result)) {
+    return result;
+  }
+  const fill: number = strictMagnitude(source['fill']);
+  if (fill < 0) {
+    result.malformed = true;
+    return result;
+  }
+  for (let bar = 0; bar < barCount; bar++) {
+    result.bytes.push(fill);
+  }
+  return result;
+}
