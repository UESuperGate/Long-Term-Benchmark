index 0000000000000000000000000000000000000000..03a62549569ab634048e873127ad1946a22d0d1d
--- /dev/null
+++ b/entry/src/main/ets/waveform/WaveformGenerator.ets
@@ -0,0 +1,51 @@
+import { GENERATED_BAR_COUNT, MAX_BAR_MAGNITUDE } from './WaveformLimits';
+import { clampMagnitude } from './WaveformMagnitude';
+import { WaveformRecord } from './WaveformRecord';
+
+/**
+ * Turns decoded PCM into the bounded waveform a voice note carries. Bars are
+ * derived from decoded samples only (never from encoded byte positions), so a
+ * container change cannot shift the shape, and the result is deterministic:
+ * silence produces zero magnitude, full scale produces the maximum magnitude.
+ */
+export class WaveformGenerator {
+  /**
+   * Returns undefined when there is nothing decodable to derive a waveform
+   * from; the caller keeps the empty generation placeholder in that case.
+   */
+  generate(attachmentId: string, samples: number[], durationUs: number): WaveformRecord | undefined {
+    if (samples.length === 0 || durationUs <= 0) {
+      return undefined;
+    }
+    const levels: number[] = this.bucketLevels(samples, GENERATED_BAR_COUNT);
+    let loudest: number = 0;
+    for (let index = 0; index < levels.length; index++) {
+      loudest = Math.max(loudest, levels[index]);
+    }
+    const scale: number = loudest > 0 ? MAX_BAR_MAGNITUDE / loudest : 0;
+    const bars: number[] = [];
+    for (let index = 0; index < levels.length; index++) {
+      bars.push(clampMagnitude(levels[index] * scale));
+    }
+    return new WaveformRecord(attachmentId, bars, durationUs / 1000000, false);
+  }
+
+  /** Mean absolute sample level of each bucket of decoded audio. */
+  private bucketLevels(samples: number[], barCount: number): number[] {
+    const levels: number[] = [];
+    const length: number = samples.length;
+    for (let bar = 0; bar < barCount; bar++) {
+      const start: number = Math.floor(bar * length / barCount);
+      let end: number = Math.min(length, Math.floor((bar + 1) * length / barCount));
+      if (end <= start) {
+        end = Math.min(length, start + 1);
+      }
+      let sum: number = 0;
+      for (let index = start; index < end; index++) {
+        sum += Math.abs(samples[index]);
+      }
+      levels.push(end > start ? sum / (end - start) : 0);
+    }
+    return levels;
+  }
+}
