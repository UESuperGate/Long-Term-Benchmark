@@ -0,0 +1,66 @@
+import { JsonMap, isEmptyMap, jsonMap, mapNumber, mapText } from '../common/JsonMap';
+import { TransportWaveform, readTransportWaveform } from './TransportWaveform';
+
+/**
+ * Outcome of validating the waveform metadata of an incoming attachment
+ * pointer. `bytes` is only populated once the payload has been accepted.
+ */
+export class IncomingWaveformOutcome {
+  accepted: boolean = false;
+  reason: string = '';
+  barCount: number = 0;
+  limit: number = 0;
+  durationSeconds: number = 0;
+  bytes: number[] = [];
+
+  constructor(limit: number) {
+    this.limit = limit;
+  }
+
+  toMap(): JsonMap {
+    return jsonMap(['accepted', 'reason', 'barCount', 'limit', 'durationSeconds'],
+      [this.accepted, this.reason, this.barCount, this.limit, this.durationSeconds]);
+  }
+}
+
+/**
+ * Envelope validation for incoming attachment pointers. Waveform metadata is
+ * checked before the attachment is persisted or handed to the renderer, so a
+ * malformed or oversized sender payload can never contaminate attachment state.
+ */
+export class IncomingWaveformValidator {
+  static validate(pointer: JsonMap, limit: number): IncomingWaveformOutcome {
+    const outcome: IncomingWaveformOutcome = new IncomingWaveformOutcome(limit);
+    if (isEmptyMap(pointer)) {
+      outcome.reason = 'missing_attachment_pointer';
+      return outcome;
+    }
+    if (mapText(pointer, 'cdnKey').length === 0) {
+      outcome.reason = 'missing_cdn_key';
+      return outcome;
+    }
+    const waveform: Object | undefined = pointer['audioWaveform'];
+    if (waveform === undefined || waveform === null) {
+      outcome.accepted = true;
+      return outcome;
+    }
+    const transport: TransportWaveform = readTransportWaveform(waveform, outcome.limit);
+    outcome.barCount = transport.declaredBarCount;
+    outcome.durationSeconds = mapNumber(pointer, 'audioDurationSeconds');
+    if (transport.oversized) {
+      outcome.reason = 'audio_waveform_too_large';
+      return outcome;
+    }
+    if (transport.malformed) {
+      outcome.reason = 'malformed_audio_waveform';
+      return outcome;
+    }
+    if (!(outcome.durationSeconds > 0)) {
+      outcome.reason = 'missing_audio_duration';
+      return outcome;
+    }
+    outcome.bytes = transport.bytes;
+    outcome.accepted = true;
+    return outcome;
+  }
+}
