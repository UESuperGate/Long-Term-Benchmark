@@ -0,0 +1,44 @@
+import { EffectRecorder } from '../common/EffectRecorder';
+import { WaveformGenerator } from './WaveformGenerator';
+import { WaveformRecord } from './WaveformRecord';
+import { WaveformStore } from './WaveformStore';
+
+/**
+ * Runs one waveform generation attempt for an attachment.
+ *
+ * The attempt first parks an explicit empty row so that an interrupted or failed
+ * run leaves a recognizable failure marker behind instead of a waveform that
+ * looks like silence, then decodes the local audio and replaces the whole row
+ * with the generated waveform. A failed attempt keeps the placeholder so the
+ * next request with readable media can retry exactly once.
+ */
+export class WaveformGenerationService {
+  private store: WaveformStore;
+  private recorder: EffectRecorder;
+  private generator: WaveformGenerator;
+
+  constructor(store: WaveformStore, recorder: EffectRecorder, generator: WaveformGenerator) {
+    this.store = store;
+    this.recorder = recorder;
+    this.generator = generator;
+  }
+
+  /**
+   * @param markPlaceholder parks the empty generation marker first; upload
+   *        preparation needs it, a plain render refresh does not.
+   */
+  async run(attachmentId: string, samples: number[], durationUs: number, markPlaceholder: boolean): Promise<WaveformRecord | undefined> {
+    if (markPlaceholder) {
+      this.recorder.record('persistGenerationPlaceholder', attachmentId);
+      await this.store.writeRecord(WaveformRecord.empty(attachmentId));
+    }
+    this.recorder.record('decodeAudio', attachmentId);
+    const record: WaveformRecord | undefined = this.generator.generate(attachmentId, samples, durationUs);
+    if (record === undefined) {
+      return undefined;
+    }
+    await this.store.writeRecord(record);
+    this.recorder.record('persistGeneratedWaveform', attachmentId);
+    return record;
+  }
+}
