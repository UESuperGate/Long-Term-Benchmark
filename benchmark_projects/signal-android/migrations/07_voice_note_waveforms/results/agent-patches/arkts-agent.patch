+import { JsonMap, jsonMap } from '../common/JsonMap';
+import { isAudioAttachment } from '../waveform/WaveformLimits';
+
+/**
+ * Upload chain of a single attachment. Audio attachments hold the upload until
+ * their waveform has been generated; every other attachment runs its ordinary
+ * compress then upload chain and never acquires waveform work.
+ */
+export class AttachmentUploadChain {
+  readonly attachmentId: string;
+  readonly audio: boolean;
+
+  private compressed: boolean = false;
+  private waveformResolved: boolean = false;
+  private waveformHeld: boolean = false;
+  private waveformFailed: boolean = false;
+  private waveformSkipped: boolean = false;
+  private uploadStarted: boolean = false;
+
+  constructor(attachmentId: string, contentType: string) {
+    this.attachmentId = attachmentId;
+    this.audio = isAudioAttachment(contentType);
+  }
+
+  isAudio(): boolean {
+    return this.audio;
+  }
+
+  isCompressed(): boolean {
+    return this.compressed;
+  }
+
+  markCompressed(): void {
+    this.compressed = true;
+  }
+
+  /** Audio upload is now waiting for its waveform dependency. */
+  holdWaveformGeneration(): void {
+    if (!this.audio) {
+      return;
+    }
+    this.waveformHeld = true;
+  }
+
+  resolveWaveform(): void {
+    this.waveformHeld = false;
+    this.waveformFailed = false;
+    this.waveformResolved = true;
+  }
+
+  failWaveformGeneration(): void {
+    this.waveformHeld = false;
+    this.waveformFailed = true;
+  }
+
+  skipWaveformGeneration(): void {
+    this.waveformSkipped = true;
+    this.waveformResolved = true;
+  }
+
+  isWaveformResolved(): boolean {
+    return this.waveformResolved;
+  }
+
+  isWaveformPending(): boolean {
+    return this.audio && !this.waveformResolved;
+  }
+
+  isUploadStarted(): boolean {
+    return this.uploadStarted;
+  }
+
+  markUploadStarted(): void {
+    this.uploadStarted = true;
+  }
+
+  snapshot(): JsonMap {
+    return jsonMap(['compression', 'waveformGeneration', 'upload'],
+      [this.compressed ? 'complete' : 'pending', this.waveformStatus(),
+        this.uploadStatus()]);
+  }
+
+  private waveformStatus(): string {
+    if (this.waveformSkipped) {
+      return 'not_scheduled';
+    }
+    if (this.waveformFailed) {
+      return 'failed';
+    }
+    if (this.waveformResolved) {
+      return 'complete';
+    }
+    return this.waveformHeld ? 'pending' : 'not_scheduled';
+  }
+
+  private uploadStatus(): string {
+    if (this.uploadStarted) {
+      return 'complete';
+    }
+    return this.isWaveformPending() ? 'blocked' : 'not_started';
+  }
+}
