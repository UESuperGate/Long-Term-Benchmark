diff --git a/entry/src/main/ets/waveform/WaveformRecord.ets b/entry/src/main/ets/waveform/WaveformRecord.ets
new file mode 100644
index 0000000000000000000000000000000000000000..b6846147ca116732e70417cc692ddf490632b4f2
--- /dev/null
+++ b/entry/src/main/ets/waveform/WaveformRecord.ets
@@ -0,0 +1,137 @@
+import { JsonMap, asMap, asMaps, asNumbers, cloneNumbers, jsonMap, mapBoolean, mapNumber } from '../common/JsonMap';
+import { isCurrentGeneratedBarCount } from './WaveformMagnitude';
+
+/**
+ * Decodes the magnitudes of a waveform row this app wrote itself. Stored rows
+ * reach us in three interchangeable shapes: an explicit magnitude list, a run
+ * length encoded list of `{ value, count }` segments, or a uniform
+ * `{ barCount, fill }` description. Remote payloads never come through here:
+ * they are read bounded and strictly by `readTransportWaveform`.
+ */
+export function decodeWaveformMagnitudes(source: JsonMap): number[] {
+  const explicit: number[] = asNumbers(source['bytes']);
+  if (explicit.length > 0) {
+    return explicit;
+  }
+  const segments: JsonMap[] = asMaps(source['segments']);
+  if (segments.length > 0) {
+    const expanded: number[] = [];
+    for (let index = 0; index < segments.length; index++) {
+      const segment: JsonMap = segments[index];
+      const count: number = mapNumber(segment, 'count');
+      const value: number = mapNumber(segment, 'value');
+      for (let bar = 0; bar < count; bar++) {
+        expanded.push(value);
+      }
+    }
+    return expanded;
+  }
+  const barCount: number = mapNumber(source, 'barCount');
+  if (barCount > 0) {
+    const fill: number = mapNumber(source, 'fill');
+    const uniform: number[] = [];
+    for (let bar = 0; bar < barCount; bar++) {
+      uniform.push(fill);
+    }
+    return uniform;
+  }
+  return [];
+}
+
+function resolveDurationSeconds(source: JsonMap): number {
+  if (source['durationSeconds'] !== undefined) {
+    return mapNumber(source, 'durationSeconds');
+  }
+  if (source['durationUs'] !== undefined) {
+    return mapNumber(source, 'durationUs') / 1000000;
+  }
+  return 0;
+}
+
+/**
+ * The waveform row that belongs to one attachment. Sender provided magnitudes
+ * are stored verbatim and are never rewritten by generation or rendering.
+ */
+export class WaveformRecord {
+  attachmentId: string = '';
+  bytes: number[] = [];
+  durationSeconds: number = 0;
+  durationUs: number = 0;
+  senderProvided: boolean = false;
+
+  constructor(attachmentId: string, bytes: number[], durationSeconds: number, senderProvided: boolean) {
+    this.attachmentId = attachmentId;
+    this.bytes = bytes;
+    this.durationSeconds = durationSeconds;
+    this.durationUs = Math.round(durationSeconds * 1000000);
+    this.senderProvided = senderProvided;
+  }
+
+  barCount(): number {
+    return this.bytes.length;
+  }
+
+  /** A waveform that came from a sender is retained as-is, whatever its bar count is. */
+  isSenderProvided(): boolean {
+    return this.senderProvided;
+  }
+
+  /** An empty row is the failure marker of an interrupted generation, not silence. */
+  isPlaceholder(): boolean {
+    return !this.senderProvided && this.bytes.length === 0;
+  }
+
+  /** Locally generated rows whose bar count predates the current release are stale. */
+  isObsoleteGenerated(): boolean {
+    return !this.senderProvided && this.bytes.length > 0 && !isCurrentGeneratedBarCount(this.bytes.length);
+  }
+
+  isRenderable(): boolean {
+    return this.bytes.length > 0;
+  }
+
+  /** True when this row can be shipped or rendered without touching the decoder. */
+  isUsable(): boolean {
+    return this.isRenderable() && (this.senderProvided || isCurrentGeneratedBarCount(this.bytes.length));
+  }
+
+  origin(): string {
+    return this.senderProvided ? 'sender' : 'generated';
+  }
+
+  belongsTo(attachmentId: string): boolean {
+    return this.attachmentId.length === 0 || this.attachmentId === attachmentId;
+  }
+
+  toPersistence(): JsonMap {
+    return jsonMap(['attachmentId', 'bytes', 'barCount', 'durationSeconds', 'durationUs', 'senderProvided', 'origin'],
+      [this.attachmentId, cloneNumbers(this.bytes), this.bytes.length,
+        this.durationSeconds, this.durationUs, this.senderProvided, this.origin()]);
+  }
+
+  /**
+   * Builds a row from any of the stored waveform shapes. A bare magnitude list
+   * carries neither duration nor origin, so those fall back to the enclosing
+   * attachment row instead of being reset.
+   */
+  static fromStored(attachmentId: string, stored: Object | undefined, context: JsonMap = jsonMap()): WaveformRecord {
+    const source: JsonMap = Array.isArray(stored) ? jsonMap() : asMap(stored);
+    let durationSeconds: number = resolveDurationSeconds(source);
+    if (durationSeconds <= 0) {
+      durationSeconds = resolveDurationSeconds(context);
+    }
+    const senderProvided: boolean = source['senderProvided'] !== undefined ?
+      mapBoolean(source, 'senderProvided') : mapBoolean(context, 'senderProvided');
+    const bytes: number[] = Array.isArray(stored) ? asNumbers(stored) : decodeWaveformMagnitudes(source);
+    return new WaveformRecord(attachmentId, bytes, durationSeconds, senderProvided);
+  }
+
+  /** Builds a sender provided row from already validated remote magnitudes. */
+  static fromSender(attachmentId: string, bytes: number[], durationSeconds: number): WaveformRecord {
+    return new WaveformRecord(attachmentId, bytes, durationSeconds, true);
+  }
+
+  static empty(attachmentId: string): WaveformRecord {
+    return new WaveformRecord(attachmentId, [], 0, false);
+  }
+}
