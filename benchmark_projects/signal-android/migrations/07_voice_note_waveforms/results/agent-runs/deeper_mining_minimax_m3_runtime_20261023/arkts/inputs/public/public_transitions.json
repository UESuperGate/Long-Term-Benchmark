{
  "schemaVersion": 1,
  "taskId": "07_voice_note_waveforms",
  "description": "Public scenarios only; expected observations and evaluator bindings remain hidden.",
  "cases": [
    {
      "caseId": "vw_001_generate_upload_ready_waveform",
      "functionalArea": "waveform_generation",
      "given": {
        "attachment": {
          "id": "audio-1",
          "contentType": "audio/aac",
          "localMedia": "readable",
          "storedWaveform": null
        },
        "decodedAudio": {
          "fixture": "constant_full_scale_mono",
          "durationUs": 2000000
        }
      },
      "event": {
        "name": "generateWaveform",
        "purpose": "prepareAudioUpload"
      },
      "invariants": [
        "generation derives bars from decoded PCM rather than encoded byte positions",
        "stored magnitudes remain in the unsigned 0 through 255 range",
        "locally generated waveform state is never marked sender-provided"
      ]
    },
    {
      "caseId": "vw_002_audio_upload_waits_for_waveform",
      "functionalArea": "upload_dependency_gating",
      "given": {
        "attachment": {
          "id": "audio-2",
          "contentType": "audio/ogg",
          "compression": "pending",
          "waveform": "absent",
          "upload": "not_started"
        },
        "waveformWorker": "held_until_released"
      },
      "event": {
        "name": "runAttachmentUploadChain",
        "releaseWaveformWorkerAfterCheckpoint": true
      },
      "invariants": [
        "audio upload cannot start while waveform generation is unresolved",
        "releasing the waveform worker resumes the same chain rather than creating a second upload",
        "compression still precedes waveform generation"
      ]
    },
    {
      "caseId": "vw_003_mixed_uploads_gate_only_audio",
      "functionalArea": "selective_upload_dependencies",
      "given": {
        "attachments": [
          {
            "id": "audio-3",
            "contentType": "audio/mp4",
            "waveformWorker": "held"
          },
          {
            "id": "image-3",
            "contentType": "image/jpeg"
          }
        ],
        "scheduler": "run_all_ready_work"
      },
      "event": {
        "name": "runMixedAttachmentUploadGraph",
        "thenRelease": "audio-3.waveformWorker"
      },
      "invariants": [
        "waveform gating is selected by attachment media type, not by the containing message",
        "an audio dependency cannot block an independent non-audio upload chain",
        "non-audio state is not assigned synthetic waveform metadata"
      ]
    },
    {
      "caseId": "vw_004_outgoing_pointer_carries_waveform",
      "functionalArea": "outbound_attachment_transport",
      "given": {
        "attachment": {
          "id": "audio-4",
          "contentType": "audio/aac",
          "cdnKey": "cdn-key-4",
          "encryptionDigest": "digest-4",
          "storedWaveform": {
            "bytes": [
              0,
              64,
              128,
              255
            ],
            "durationSeconds": 12.5,
            "senderProvided": false
          }
        }
      },
      "event": {
        "name": "serializeOutgoingAttachmentPointer"
      },
      "invariants": [
        "transport uses the waveform record belonging to the same attachment",
        "serialization preserves byte order and duration",
        "adding waveform metadata does not replace upload identity or encryption fields"
      ]
    },
    {
      "caseId": "vw_005_reject_oversized_remote_waveform",
      "functionalArea": "invalid_remote_payload",
      "given": {
        "incomingEnvelope": {
          "attachmentPointer": {
            "contentType": "audio/aac",
            "cdnKey": "valid-cdn-key",
            "audioWaveform": {
              "barCount": 101,
              "fill": 127
            },
            "audioDurationSeconds": 4.0
          }
        },
        "serviceWaveformLimit": 100
      },
      "event": {
        "name": "validateIncomingEnvelope"
      },
      "invariants": [
        "an otherwise well-formed CDN pointer does not override the waveform size limit",
        "validation happens before attachment persistence",
        "invalid remote bytes never become renderer input"
      ]
    },
    {
      "caseId": "vw_006_persist_valid_sender_waveform",
      "functionalArea": "inbound_attachment_persistence",
      "given": {
        "incomingAttachmentPointer": {
          "contentType": "audio/ogg",
          "cdnKey": "cdn-key-6",
          "audioWaveform": [
            0,
            64,
            128,
            255
          ],
          "audioDurationSeconds": 3.25
        },
        "database": "empty"
      },
      "event": {
        "name": "importPersistAndReloadIncomingAttachment"
      },
      "invariants": [
        "valid sender bytes and duration survive database serialization exactly",
        "remote origin remains distinguishable after reload",
        "receiving metadata never invokes the local audio decoder"
      ]
    },
    {
      "caseId": "vw_007_resample_sender_waveform_without_media",
      "functionalArea": "renderer_resampling",
      "given": {
        "attachment": {
          "id": "audio-7",
          "contentType": "audio/aac",
          "localMedia": "unavailable",
          "storedWaveform": {
            "segments": [
              {
                "value": 0,
                "count": 50
              },
              {
                "value": 255,
                "count": 50
              }
            ],
            "durationSeconds": 10.0,
            "senderProvided": true
          }
        }
      },
      "event": {
        "name": "requestRenderableWaveform"
      },
      "invariants": [
        "render output has a stable bar count independent of transported bar count",
        "byte magnitudes are interpreted unsigned and normalized by 255",
        "a valid sender-provided waveform remains usable without a local media URI"
      ]
    },
    {
      "caseId": "vw_008_regenerate_stale_local_waveform",
      "functionalArea": "stale_cache_regeneration",
      "given": {
        "attachment": {
          "id": "audio-8",
          "contentType": "audio/aac",
          "localMedia": "readable",
          "storedWaveform": {
            "barCount": 46,
            "fill": 17,
            "durationUs": 1000000,
            "senderProvided": false
          }
        },
        "decodedAudio": {
          "fixture": "constant_full_scale_mono",
          "durationUs": 2000000
        }
      },
      "event": {
        "name": "requestRenderableWaveform"
      },
      "invariants": [
        "bar-count invalidation applies to locally generated records",
        "the stale record is not emitted before regeneration completes",
        "regeneration updates waveform metadata for the existing attachment identity"
      ]
    },
    {
      "caseId": "vw_009_recover_empty_generation_placeholder",
      "functionalArea": "generation_recovery",
      "given": {
        "attachment": {
          "id": "audio-9",
          "contentType": "audio/ogg",
          "localMedia": "readable",
          "storedWaveform": {
            "barCount": 0,
            "durationUs": 0,
            "senderProvided": false,
            "meaning": "placeholder_from_interrupted_generation"
          }
        },
        "decodedAudio": {
          "fixture": "silence_then_full_scale",
          "durationUs": 4000000
        }
      },
      "event": {
        "name": "requestRenderableWaveform"
      },
      "invariants": [
        "an empty generation placeholder is failure state rather than a valid silent waveform",
        "a later readable-media request retries generation exactly once",
        "recovery replaces the placeholder atomically and does not itself start upload"
      ]
    },
    {
      "caseId": "vw_010_backup_round_trip_sender_waveform",
      "functionalArea": "backup_persistence",
      "given": {
        "attachment": {
          "id": "audio-10",
          "contentType": "audio/aac",
          "localMedia": "unavailable",
          "storedWaveform": {
            "bytes": [
              0,
              85,
              170,
              255
            ],
            "durationSeconds": 8.5,
            "senderProvided": true
          }
        },
        "restoreDatabase": "empty"
      },
      "event": {
        "name": "exportClearRestoreAndRenderAttachment"
      },
      "invariants": [
        "backup export and import preserve sender bytes and duration exactly",
        "restored transport metadata is marked sender-provided",
        "restored waveform remains renderable when the media file is not local"
      ]
    }
  ]
}
