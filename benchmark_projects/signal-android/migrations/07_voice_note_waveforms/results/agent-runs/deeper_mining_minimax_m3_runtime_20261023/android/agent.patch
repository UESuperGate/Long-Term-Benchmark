@@ -0,0 +1,55 @@
+package org.signal.benchmark.waveform.waveform;
+
+/**
+ * Derives the bars of a clip from its decoded samples.
+ *
+ * <p>The generator works on decoded audio, never on positions inside the encoded file: the samples
+ * are split into as many buckets as bars, each bucket contributes its loudest sample, and the
+ * buckets are scaled against the loudest sample of the whole clip. The result is deterministic and
+ * bounded, silence produces all zero bars and full scale audio produces full scale bars.
+ */
+public final class WaveformGenerator {
+  /** Bars a freshly generated waveform carries. */
+  public static final int GENERATED_BAR_COUNT = 100;
+
+  private static final int FULL_SCALE_MAGNITUDE = 255;
+
+  /**
+   * Generates the waveform of {@code samples} measured over {@code durationUs}.
+   *
+   * @param samples    decoded samples of the clip, or null when no audio could be decoded
+   * @param durationUs length of the clip in microseconds
+   */
+  public WaveformRecord generate(int[] samples, long durationUs) {
+    int[] bars = new int[GENERATED_BAR_COUNT];
+    if (samples != null && samples.length > 0) {
+      int loudest = 0;
+      for (int sample : samples) {
+        loudest = Math.max(loudest, magnitude(sample));
+      }
+      for (int bar = 0; bar < GENERATED_BAR_COUNT; bar++) {
+        int start = (int) ((long) bar * samples.length / GENERATED_BAR_COUNT);
+        int end = (int) Math.min((long) samples.length,
+            Math.max((long) start + 1, (long) (bar + 1) * samples.length / GENERATED_BAR_COUNT));
+        int peak = 0;
+        for (int i = start; i < end; i++) {
+          peak = Math.max(peak, magnitude(samples[i]));
+        }
+        bars[bar] = scale(peak, loudest);
+      }
+    }
+    return WaveformRecord.generated(bars, durationUs);
+  }
+
+  private static int scale(int peak, int loudest) {
+    if (loudest <= 0) {
+      return 0;
+    }
+    return Math.min(FULL_SCALE_MAGNITUDE, (int) Math.round((double) FULL_SCALE_MAGNITUDE * peak / loudest));
+  }
+
+  private static int magnitude(int sample) {
+    long value = sample < 0 ? -(long) sample : (long) sample;
+    return (int) Math.min(value, Integer.MAX_VALUE);
+  }
+}
