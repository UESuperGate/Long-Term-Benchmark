@@ -0,0 +1,60 @@
+package org.signal.benchmark.waveform.attachment;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.signal.benchmark.waveform.Json;
+import org.signal.benchmark.waveform.waveform.WaveformRecord;
+
+/**
+ * Writes and reads the attachment rows a backup carries.
+ *
+ * <p>Waveform metadata is part of an attachment row, so a backup has to carry it: the sender
+ * magnitudes, their order, the duration, and the origin. The backup document is stored as it was
+ * written and parsed again on restore, so a round trip cannot quietly rewrite sender bytes or
+ * relabel a sender waveform as a local cache entry.
+ */
+public final class AttachmentBackupCodec {
+  private static final int BACKUP_VERSION = 1;
+  private static final String FIELD_VERSION = "version";
+  private static final String FIELD_ATTACHMENTS = "attachments";
+
+  private final AttachmentWaveformStore store;
+
+  public AttachmentBackupCodec(AttachmentWaveformStore store) {
+    this.store = store;
+  }
+
+  /** Serializes the row of {@code attachmentId} into a backup document. */
+  public String export(String attachmentId, WaveformRecord record) throws JSONException {
+    JSONObject backup = new JSONObject();
+    Json.put(backup, FIELD_VERSION, BACKUP_VERSION);
+    JSONObject rows = new JSONObject();
+    if (record != null) {
+      Json.put(rows, attachmentId == null ? "" : attachmentId, record.toJson());
+    }
+    Json.put(backup, FIELD_ATTACHMENTS, rows);
+    return backup.toString();
+  }
+
+  /**
+   * Restores {@code attachmentId} from a backup document into the attachment database and returns
+   * the row as it came back out of storage.
+   */
+  public WaveformRecord restore(String backupDocument, String attachmentId) throws JSONException {
+    if (backupDocument == null) {
+      return null;
+    }
+    JSONObject backup = new JSONObject(backupDocument);
+    JSONObject rows = backup.optJSONObject(FIELD_ATTACHMENTS);
+    if (rows == null) {
+      return null;
+    }
+    JSONObject row = rows.optJSONObject(attachmentId == null ? "" : attachmentId);
+    WaveformRecord record = WaveformRecord.fromJson(row);
+    if (record == null) {
+      return null;
+    }
+    store.save(attachmentId, record);
+    return store.read(attachmentId);
+  }
+}
