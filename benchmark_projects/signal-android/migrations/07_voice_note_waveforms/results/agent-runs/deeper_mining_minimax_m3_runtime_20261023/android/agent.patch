index 0000000000000000000000000000000000000000..47d38a89658a49f6be9ce48eda61c23c3e7a3112
--- /dev/null
+++ b/app/src/main/java/org/signal/benchmark/waveform/ProductionTrace.java
@@ -0,0 +1,46 @@
+package org.signal.benchmark.waveform;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * Ordered record of the production work a page performed: the entry points that ran and the
+ * platform effects they caused. Every effect carries the attachment it belongs to, so a single
+ * upload chain can be followed across compression, waveform generation and upload, and chains of
+ * independent attachments stay distinguishable.
+ */
+public final class ProductionTrace {
+  private JSONArray productionCalls = new JSONArray();
+  private JSONArray effects = new JSONArray();
+
+  /** Records a production entry point, for example {@code WaveformPageOwner.generateWaveform}. */
+  public void call(String name) {
+    productionCalls.put(name);
+  }
+
+  /** Records a platform effect performed on behalf of {@code attachmentId}. */
+  public void effect(String name, String attachmentId) {
+    try {
+      effects.put(new JSONObject()
+          .put("name", name)
+          .put("attachmentId", attachmentId == null ? "" : attachmentId));
+    } catch (JSONException error) {
+      throw new IllegalStateException("Unable to record effect " + name, error);
+    }
+  }
+
+  /** Drops everything recorded so far; a freshly mounted page starts from an empty trace. */
+  public void reset() {
+    productionCalls = new JSONArray();
+    effects = new JSONArray();
+  }
+
+  public JSONArray productionCalls() {
+    return Json.copyOf(productionCalls);
+  }
+
+  public JSONArray effects() {
+    return Json.copyOf(effects);
+  }
+}
