@@ -0,0 +1,49 @@
+package org.signal.benchmark.waveform.waveform;
+
+import org.json.JSONArray;
+import org.signal.benchmark.waveform.Json;
+
+/**
+ * Turns a stored waveform into the render data the waveform view draws.
+ *
+ * <p>The view always draws a fixed number of bars, no matter how many bars a record happens to
+ * carry: a record a sender produced, a record the local generator produced, or a record that came
+ * back from a backup. Source magnitudes are read unsigned, each output bar takes the loudest
+ * magnitude of its deterministic bucket, and every value is normalized against full scale. Because
+ * nothing here touches the local media file, sender waveforms stay renderable even when the clip
+ * itself was never downloaded.
+ */
+public final class WaveformRenderer {
+  /** Bars the view draws, independent of how many bars were generated or transported. */
+  public static final int BAR_COUNT = 100;
+
+  private static final int FULL_SCALE_MAGNITUDE = 255;
+
+  /** Renders {@code record} into {@link #BAR_COUNT} normalized bars. */
+  public JSONArray render(WaveformRecord record) {
+    JSONArray bars = new JSONArray();
+    if (record == null) {
+      return bars;
+    }
+    int[] source = record.bars();
+    for (int bar = 0; bar < BAR_COUNT; bar++) {
+      int start = bucketStart(bar, source.length);
+      int end = bucketEnd(bar, source.length);
+      int loudest = 0;
+      for (int i = start; i < end; i++) {
+        loudest = Math.max(loudest, source[i]);
+      }
+      Json.put(bars, loudest / (double) FULL_SCALE_MAGNITUDE);
+    }
+    return bars;
+  }
+
+  private static int bucketStart(int bar, int sourceLength) {
+    return (int) ((long) bar * sourceLength / BAR_COUNT);
+  }
+
+  private static int bucketEnd(int bar, int sourceLength) {
+    return (int) Math.min((long) sourceLength,
+        Math.max((long) bucketStart(bar, sourceLength) + 1, (long) (bar + 1) * sourceLength / BAR_COUNT));
+  }
+}
