+package org.signal.benchmark.waveform.upload;
+
+import java.util.Locale;
+
+/**
+ * An attachment queued for upload: its identity and the media type that decides its chain.
+ *
+ * <p>The media type, not the message the attachment happens to ride in, is what selects the chain.
+ * An audio attachment carries a waveform and therefore waits for it; nothing else in the same
+ * message is held back.
+ */
+public final class PendingAttachment {
+  private final String id;
+  private final String contentType;
+
+  public PendingAttachment(String id, String contentType) {
+    this.id = id == null ? "" : id;
+    this.contentType = contentType == null ? "" : contentType;
+  }
+
+  public String id() {
+    return id;
+  }
+
+  public String contentType() {
+    return contentType;
+  }
+
+  /** Only audio attachments get waveform generation work. */
+  public boolean isAudio() {
+    return contentType.toLowerCase(Locale.US).startsWith("audio");
+  }
+}
