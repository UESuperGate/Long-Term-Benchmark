index 0000000000000000000000000000000000000000..c6cec25570aaa6ea287700137c3bbc0d6ecf5d55
--- /dev/null
+++ b/app/src/main/java/org/signal/benchmark/waveform/waveform/WaveformSamples.java
@@ -0,0 +1,151 @@
+package org.signal.benchmark.waveform.waveform;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * Reads and writes the unsigned waveform bar magnitudes in the shapes an attachment carries them
+ * in: a plain byte array, a run length expansion, or a repeated value description.
+ *
+ * <p>A magnitude is always an unsigned value from 0 (silence) through 255 (full scale). Anything
+ * outside that range is not a waveform and is reported as unusable rather than silently clamped,
+ * so a caller can fail closed instead of rendering bytes a sender never sent.
+ */
+public final class WaveformSamples {
+  private static final int MAX_UNSIGNED_MAGNITUDE = 255;
+
+  /** Guards against expanding a corrupt description into an unbounded array. */
+  private static final int MAX_EXPANDED_BARS = 100_000;
+
+  private WaveformSamples() {
+  }
+
+  /** Returns the unsigned magnitudes of {@code source}, or null when it is not a waveform. */
+  public static int[] read(JSONObject source) {
+    if (source == null) {
+      return null;
+    }
+    JSONArray bytes = source.optJSONArray("bytes");
+    if (bytes != null) {
+      return magnitudes(bytes);
+    }
+    JSONArray segments = source.optJSONArray("segments");
+    if (segments != null) {
+      return expand(segments);
+    }
+    if (source.has("barCount")) {
+      return repeated(source.optInt("barCount", -1), unsigned(source.opt("fill")));
+    }
+    return null;
+  }
+
+  /**
+   * How many bars a description claims to carry, without expanding it. Returns -1 when the
+   * description is unusable, so a caller can reject oversized metadata before allocating for it.
+   */
+  public static int declaredBarCount(JSONObject source) {
+    if (source == null) {
+      return -1;
+    }
+    JSONArray bytes = source.optJSONArray("bytes");
+    if (bytes != null) {
+      return bytes.length();
+    }
+    JSONArray segments = source.optJSONArray("segments");
+    if (segments != null) {
+      int total = 0;
+      for (int i = 0; i < segments.length(); i++) {
+        JSONObject segment = segments.optJSONObject(i);
+        if (segment == null) {
+          return -1;
+        }
+        int count = segment.optInt("count", -1);
+        if (count < 0) {
+          return -1;
+        }
+        total += count;
+        if (total > MAX_EXPANDED_BARS) {
+          return -1;
+        }
+      }
+      return total;
+    }
+    if (source.has("barCount")) {
+      int count = source.optInt("barCount", -1);
+      return count < 0 || count > MAX_EXPANDED_BARS ? -1 : count;
+    }
+    return -1;
+  }
+
+  public static JSONArray toJson(int[] bars) {
+    JSONArray array = new JSONArray();
+    for (int bar : bars) {
+      array.put(bar);
+    }
+    return array;
+  }
+
+  private static int[] magnitudes(JSONArray bytes) {
+    int[] bars = new int[bytes.length()];
+    for (int i = 0; i < bars.length; i++) {
+      Integer value = unsigned(bytes.opt(i));
+      if (value == null) {
+        return null;
+      }
+      bars[i] = value;
+    }
+    return bars;
+  }
+
+  private static int[] expand(JSONArray segments) {
+    int total = 0;
+    for (int i = 0; i < segments.length(); i++) {
+      JSONObject segment = segments.optJSONObject(i);
+      if (segment == null) {
+        return null;
+      }
+      int count = segment.optInt("count", -1);
+      if (count < 0) {
+        return null;
+      }
+      total += count;
+      if (total > MAX_EXPANDED_BARS) {
+        return null;
+      }
+    }
+    int[] bars = new int[total];
+    int index = 0;
+    for (int i = 0; i < segments.length(); i++) {
+      // Safe to look up without a checked exception: every element was verified above.
+      JSONObject segment = segments.optJSONObject(i);
+      Integer value = unsigned(segment.opt("value"));
+      int count = segment.optInt("count", 0);
+      if (value == null && count > 0) {
+        return null;
+      }
+      while (count-- > 0) {
+        bars[index++] = value == null ? 0 : value;
+      }
+    }
+    return bars;
+  }
+
+  private static int[] repeated(int count, Integer fill) {
+    if (count < 0 || count > MAX_EXPANDED_BARS || (fill == null && count > 0)) {
+      return null;
+    }
+    int[] bars = new int[count];
+    for (int i = 0; i < count; i++) {
+      bars[i] = fill == null ? 0 : fill;
+    }
+    return bars;
+  }
+
+  private static Integer unsigned(Object raw) {
+    if (!(raw instanceof Number)) {
+      return null;
+    }
+    int value = ((Number) raw).intValue();
+    return value < 0 || value > MAX_UNSIGNED_MAGNITUDE ? null : value;
+  }
+}
