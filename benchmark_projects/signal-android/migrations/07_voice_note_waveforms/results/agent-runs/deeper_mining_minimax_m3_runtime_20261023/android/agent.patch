@@ -0,0 +1,146 @@
+package org.signal.benchmark.waveform.waveform;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.signal.benchmark.waveform.Json;
+
+/**
+ * The waveform of a single audio attachment: the unsigned bar magnitudes, the clip duration, and
+ * where the bytes came from.
+ *
+ * <p>Origin matters for the rest of the pipeline. Bars the local decoder produced can be
+ * regenerated whenever the bar count they were built with is obsolete, while bars a sender sent
+ * are authoritative and must be carried through persistence, rendering and backup untouched.
+ */
+public final class WaveformRecord {
+  /** Origin of bars produced locally from decoded audio. */
+  public static final String ORIGIN_LOCAL = "local";
+
+  /** Origin of bars a remote party sent with the attachment pointer. */
+  public static final String ORIGIN_SENDER = "sender";
+
+  private static final double MICROS_PER_SECOND = 1_000_000d;
+
+  private final int[] bars;
+  private final double durationSeconds;
+  private final boolean senderProvided;
+
+  private WaveformRecord(int[] bars, double durationSeconds, boolean senderProvided) {
+    this.bars = bars;
+    this.durationSeconds = durationSeconds;
+    this.senderProvided = senderProvided;
+  }
+
+  /** The explicit empty record generation leaves behind when it is interrupted or fails. */
+  public static WaveformRecord placeholder() {
+    return new WaveformRecord(new int[0], 0d, false);
+  }
+
+  /** Bars derived from decoded local audio, measured over {@code durationUs}. */
+  public static WaveformRecord generated(int[] bars, long durationUs) {
+    return new WaveformRecord(bars.clone(), durationUs / MICROS_PER_SECOND, false);
+  }
+
+  /** Bars a remote party sent alongside the attachment pointer. */
+  public static WaveformRecord fromSender(int[] bars, double durationSeconds) {
+    return new WaveformRecord(bars.clone(), durationSeconds, true);
+  }
+
+  /** Reads a record that was written by {@link #toJson()} or exported into a backup. */
+  public static WaveformRecord fromJson(JSONObject json) {
+    if (json == null) {
+      return null;
+    }
+    int[] bars = WaveformSamples.read(json);
+    if (bars == null) {
+      return null;
+    }
+    return new WaveformRecord(bars, durationOf(json), json.optBoolean("senderProvided", false));
+  }
+
+  /** Reads the waveform an attachment was mounted with, whatever shape it arrived in. */
+  public static WaveformRecord fromStoredWaveform(JSONObject stored) {
+    if (stored == null) {
+      return null;
+    }
+    int[] bars = WaveformSamples.read(stored);
+    if (bars == null) {
+      return null;
+    }
+    JSONObject json = new JSONObject();
+    Json.put(json, "bytes", WaveformSamples.toJson(bars));
+    if (stored.has("durationSeconds") && !stored.isNull("durationSeconds")) {
+      Json.put(json, "durationSeconds", stored.optDouble("durationSeconds", 0d));
+    } else {
+      Json.put(json, "durationUs", stored.optLong("durationUs", 0L));
+    }
+    Json.put(json, "senderProvided", stored.optBoolean("senderProvided", false));
+    return fromJson(json);
+  }
+
+  private static double durationOf(JSONObject json) {
+    if (json.has("durationSeconds") && !json.isNull("durationSeconds")) {
+      return json.optDouble("durationSeconds", 0d);
+    }
+    return json.optLong("durationUs", 0L) / MICROS_PER_SECOND;
+  }
+
+  public JSONObject toJson() {
+    JSONObject json = new JSONObject();
+    Json.put(json, "bytes", barsJson());
+    Json.put(json, "barCount", bars.length);
+    Json.put(json, "durationSeconds", durationSeconds);
+    Json.put(json, "durationUs", durationUs());
+    Json.put(json, "senderProvided", senderProvided);
+    Json.put(json, "origin", origin());
+    return json;
+  }
+
+  public JSONArray barsJson() {
+    return WaveformSamples.toJson(bars);
+  }
+
+  public int[] bars() {
+    return bars.clone();
+  }
+
+  public int barCount() {
+    return bars.length;
+  }
+
+  public double durationSeconds() {
+    return durationSeconds;
+  }
+
+  public long durationUs() {
+    return Math.round(durationSeconds * MICROS_PER_SECOND);
+  }
+
+  public boolean isSenderProvided() {
+    return senderProvided;
+  }
+
+  public String origin() {
+    return senderProvided ? ORIGIN_SENDER : ORIGIN_LOCAL;
+  }
+
+  /** True for the empty record an interrupted generation leaves: a failure, not silent audio. */
+  public boolean isPlaceholder() {
+    return bars.length == 0;
+  }
+
+  /** True when the record has bars and can be drawn or sent without the local media file. */
+  public boolean isRenderable() {
+    return bars.length > 0;
+  }
+
+  /** True when locally generated bars were built with an obsolete bar count. */
+  public boolean isStaleLocal(int currentBarCount) {
+    return !senderProvided && bars.length > 0 && bars.length != currentBarCount;
+  }
+
+  @Override
+  public String toString() {
+    return toJson().toString();
+  }
+}
