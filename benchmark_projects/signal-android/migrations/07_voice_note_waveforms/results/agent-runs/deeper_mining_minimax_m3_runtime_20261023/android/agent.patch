@@ -0,0 +1,36 @@
+package org.signal.benchmark.waveform.attachment;
+
+import org.json.JSONObject;
+import org.signal.benchmark.waveform.Json;
+import org.signal.benchmark.waveform.waveform.WaveformRecord;
+
+/**
+ * Builds the attachment pointer an audio attachment is sent with.
+ *
+ * <p>The upload identity and the encryption metadata are copied through exactly as they were: the
+ * waveform rides along as extra fields and never replaces them. Only an audio attachment that has
+ * stored bars and a positive duration carries waveform fields, so a pointer never advertises a
+ * waveform the attachment does not have.
+ */
+public final class AttachmentPointerSerializer {
+  /** Serializes the pointer for {@code record}, which is the row stored for this attachment. */
+  public JSONObject serialize(String contentType,
+                              String cdnKey,
+                              String encryptionDigest,
+                              boolean audio,
+                              WaveformRecord record) {
+    JSONObject pointer = new JSONObject();
+    Json.put(pointer, "contentType", orEmpty(contentType));
+    Json.put(pointer, "cdnKey", orEmpty(cdnKey));
+    Json.put(pointer, "encryptionDigest", orEmpty(encryptionDigest));
+    if (audio && record != null && record.isRenderable() && record.durationSeconds() > 0) {
+      Json.put(pointer, "audioWaveform", record.barsJson());
+      Json.put(pointer, "audioDurationSeconds", record.durationSeconds());
+    }
+    return pointer;
+  }
+
+  private static String orEmpty(String value) {
+    return value == null ? "" : value;
+  }
+}
