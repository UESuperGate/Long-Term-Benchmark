@@ -0,0 +1,135 @@
+package org.signal.benchmark.waveform.attachment;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.signal.benchmark.waveform.Json;
+import org.signal.benchmark.waveform.waveform.WaveformSamples;
+
+/**
+ * Fails closed on attachment metadata a service would never have produced.
+ *
+ * <p>An oversized waveform is rejected on the declared bar count, before the description is even
+ * expanded, so a payload that exceeds the service limit can never allocate its way into the
+ * attachment database or the renderer. Magnitudes that are not unsigned bytes are rejected the
+ * same way. A pointer without waveform fields is accepted as an attachment without a waveform.
+ */
+public final class IncomingPointerValidator {
+  /** Bars a sender may attach to a single voice note. */
+  public static final int SERVICE_WAVEFORM_LIMIT = 100;
+
+  static final String CODE_ACCEPTED = "OK";
+  static final String CODE_TOO_LARGE = "AUDIO_WAVEFORM_TOO_LARGE";
+  static final String CODE_MALFORMED = "MALFORMED_AUDIO_WAVEFORM";
+  static final String CODE_NO_POINTER = "MALFORMED_ATTACHMENT_POINTER";
+
+  static final String REASON_TOO_LARGE = "audio_waveform_too_large";
+  static final String REASON_MALFORMED = "malformed_audio_waveform";
+  static final String REASON_NO_POINTER = "malformed_attachment_pointer";
+
+  /** Validates the waveform carried by {@code pointer} against {@code limit}. */
+  public Result validate(JSONObject pointer, int limit) {
+    if (pointer == null) {
+      return Result.rejected(CODE_NO_POINTER, REASON_NO_POINTER, limit, -1, 0d);
+    }
+    JSONObject waveform = describe(pointer.opt("audioWaveform"));
+    double durationSeconds = pointer.optDouble("audioDurationSeconds", 0d);
+    if (waveform == null) {
+      return Result.accepted(limit, null, durationSeconds);
+    }
+    int declared = WaveformSamples.declaredBarCount(waveform);
+    if (declared < 0) {
+      return Result.rejected(CODE_MALFORMED, REASON_MALFORMED, limit, declared, durationSeconds);
+    }
+    if (declared > limit) {
+      return Result.rejected(CODE_TOO_LARGE, REASON_TOO_LARGE, limit, declared, durationSeconds);
+    }
+    int[] bars = WaveformSamples.read(waveform);
+    if (bars == null) {
+      return Result.rejected(CODE_MALFORMED, REASON_MALFORMED, limit, declared, durationSeconds);
+    }
+    return Result.accepted(limit, bars, durationSeconds);
+  }
+
+  /** Normalizes the shapes a waveform field can arrive in into a description document. */
+  private static JSONObject describe(Object raw) {
+    if (raw == null || raw == JSONObject.NULL) {
+      return null;
+    }
+    if (raw instanceof JSONObject) {
+      return (JSONObject) raw;
+    }
+    if (raw instanceof JSONArray) {
+      JSONObject description = new JSONObject();
+      Json.put(description, "bytes", raw);
+      return description;
+    }
+    return new JSONObject();
+  }
+
+  /** The outcome of validating one attachment pointer. */
+  public static final class Result {
+    private final boolean accepted;
+    private final String code;
+    private final String reason;
+    private final int limit;
+    private final int declaredBarCount;
+    private final double durationSeconds;
+    private final int[] bars;
+
+    private Result(boolean accepted,
+                   String code,
+                   String reason,
+                   int limit,
+                   int[] bars,
+                   int declaredBarCount,
+                   double durationSeconds) {
+      this.accepted = accepted;
+      this.code = code;
+      this.reason = reason;
+      this.limit = limit;
+      this.bars = bars;
+      this.declaredBarCount = declaredBarCount;
+      this.durationSeconds = durationSeconds;
+    }
+
+    static Result accepted(int limit, int[] bars, double durationSeconds) {
+      return new Result(true, CODE_ACCEPTED, null, limit, bars,
+          bars == null ? -1 : bars.length, durationSeconds);
+    }
+
+    static Result rejected(String code,
+                           String reason,
+                           int limit,
+                           int declaredBarCount,
+                           double durationSeconds) {
+      return new Result(false, code, reason, limit, null, declaredBarCount, durationSeconds);
+    }
+
+    public boolean isAccepted() {
+      return accepted;
+    }
+
+    public String reason() {
+      return reason;
+    }
+
+    public double durationSeconds() {
+      return durationSeconds;
+    }
+
+    /** The validated magnitudes, exactly as they arrived, or null when none were accepted. */
+    public int[] bars() {
+      return bars == null ? null : bars.clone();
+    }
+
+    public JSONObject toJson() {
+      JSONObject json = new JSONObject();
+      Json.put(json, "accepted", accepted);
+      Json.put(json, "reason", reason == null ? JSONObject.NULL : reason);
+      Json.put(json, "code", code);
+      Json.put(json, "limit", limit);
+      Json.put(json, "barCount", declaredBarCount < 0 ? JSONObject.NULL : declaredBarCount);
+      return json;
+    }
+  }
+}
