+import java.util.Map;
+import org.signal.benchmark.waveform.ProductionTrace;
+import org.signal.benchmark.waveform.attachment.AttachmentWaveformStore;
+import org.signal.benchmark.waveform.waveform.WaveformGenerator;
+import org.signal.benchmark.waveform.waveform.WaveformRecord;
+
+/**
+ * Runs attachment upload chains.
+ *
+ * <p>Each attachment gets its own chain so one attachment's dependency can never stall another's.
+ * An audio chain is compressed first and then held until its waveform has been generated and
+ * stored; only then does its upload start, exactly once. Releasing a held chain continues the work
+ * that was already in flight rather than starting a second chain.
+ */
+public final class AttachmentUploadScheduler {
+  private final AttachmentWaveformStore store;
+  private final WaveformGenerator generator;
+  private final ProductionTrace trace;
+  private final Map<String, UploadState> chains = new LinkedHashMap<>();
+
+  public AttachmentUploadScheduler(AttachmentWaveformStore store,
+                                  WaveformGenerator generator,
+                                  ProductionTrace trace) {
+    this.store = store;
+    this.generator = generator;
+    this.trace = trace;
+  }
+
+  /** Forgets every chain, for example when the page is mounted with a new attachment. */
+  public void reset() {
+    chains.clear();
+  }
+
+  /** All chains started since the last reset, in the order they started. */
+  public Map<String, UploadState> chains() {
+    return chains;
+  }
+
+  public UploadState chain(String attachmentId) {
+    return chains.get(attachmentId);
+  }
+
+  /**
+   * Compresses {@code pending} and starts its upload. An audio attachment without stored bars is
+   * held until generation finishes; an attachment that already has bars, or that is not audio at
+   * all, uploads straight away. A chain that is already in flight is never restarted, so one
+   * attachment can only ever upload once.
+   */
+  public UploadState start(PendingAttachment pending) {
+    UploadState existing = chains.get(pending.id());
+    if (existing != null) {
+      return existing;
+    }
+
+    UploadState chain = new UploadState(pending.id());
+    chain.waveformRequired(pending.isAudio());
+    chains.put(chain.id(), chain);
+
+    trace.effect("compressAttachment", chain.id());
+    chain.compressed();
+
+    if (!chain.requiresWaveform()) {
+      beginUpload(chain);
+      return chain;
+    }
+    if (store.hasRenderableWaveform(chain.id())) {
+      chain.waveformComplete();
+      beginUpload(chain);
+      return chain;
+    }
+    chain.waveformPending();
+    return chain;
+  }
+
+  /**
+   * Generates the waveform of every held audio chain and then uploads it. Chains that already
+   * uploaded, or that never waited for a waveform, are left untouched.
+   */
+  public Map<String, UploadState> releaseHeld(int[] decodedPcm, long durationUs) {
+    Map<String, UploadState> released = new LinkedHashMap<>();
+    for (UploadState chain : new ArrayList<>(chains.values())) {
+      if (!chain.isHeld()) {
+        continue;
+      }
+      generateAndUpload(chain, decodedPcm, durationUs);
+      released.put(chain.id(), chain);
+    }
+    return released;
+  }
+
+  /**
+   * Resumes the chain of {@code attachmentId} once its bars exist, no matter which path produced
+   * them. A chain that already uploaded is not uploaded again.
+   */
+  public UploadState onWaveformReady(String attachmentId) {
+    UploadState chain = chains.get(attachmentId);
+    if (chain != null && chain.isHeld() && store.hasRenderableWaveform(attachmentId)) {
+      chain.waveformComplete();
+      beginUpload(chain);
+    }
+    return chain;
+  }
+
+  private void generateAndUpload(UploadState chain, int[] decodedPcm, long durationUs) {
+    trace.effect("decodeAudio", chain.id());
+    WaveformRecord record = generator.generate(decodedPcm, durationUs);
+    store.save(chain.id(), record);
+    trace.effect("persistGeneratedWaveform", chain.id());
+    chain.waveformComplete();
+    beginUpload(chain);
+  }
+
+  private void beginUpload(UploadState chain) {
+    if (chain.isUploadStarted()) {
+      return;
+    }
+    trace.effect("uploadAttachment", chain.id());
+    chain.uploaded();
+  }
+}
