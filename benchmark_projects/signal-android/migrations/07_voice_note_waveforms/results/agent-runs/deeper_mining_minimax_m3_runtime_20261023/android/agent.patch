@@ -0,0 +1,82 @@
+package org.signal.benchmark.waveform.attachment;
+
+import android.content.SharedPreferences;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.signal.benchmark.waveform.waveform.WaveformRecord;
+
+/**
+ * The attachment side of the local database: one row per attachment holding the waveform that
+ * belongs to it.
+ *
+ * <p>Rows are stored as documents keyed by attachment, so a waveform is never shared between
+ * attachments, and every read parses the persisted document again. Reading a row back is therefore
+ * the same path the app takes when it reloads an attachment from the database, which keeps stored
+ * bytes and their origin intact across a reload.
+ */
+public final class AttachmentWaveformStore {
+  private static final String ROW_PREFIX = "attachment:";
+
+  private final SharedPreferences preferences;
+
+  public AttachmentWaveformStore(SharedPreferences preferences) {
+    this.preferences = preferences;
+  }
+
+  /** Drops every stored attachment row. */
+  public void clear() {
+    preferences.edit().clear().commit();
+  }
+
+  /** Writes the waveform row of {@code attachmentId}, replacing whatever was there. */
+  public void save(String attachmentId, WaveformRecord record) {
+    if (record == null) {
+      return;
+    }
+    preferences.edit().putString(rowKey(attachmentId), record.toJson().toString()).commit();
+  }
+
+  /** Re-reads and re-parses the stored row of {@code attachmentId}. */
+  public WaveformRecord read(String attachmentId) {
+    String row = preferences.getString(rowKey(attachmentId), null);
+    if (row == null) {
+      return null;
+    }
+    try {
+      return WaveformRecord.fromJson(new JSONObject(row));
+    } catch (JSONException error) {
+      return null;
+    }
+  }
+
+  /** True when the attachment already has bars that can be sent or drawn. */
+  public boolean hasRenderableWaveform(String attachmentId) {
+    WaveformRecord record = read(attachmentId);
+    return record != null && record.isRenderable();
+  }
+
+  /** Every stored attachment row, keyed by attachment. */
+  public Map<String, WaveformRecord> readAll() {
+    Map<String, WaveformRecord> rows = new LinkedHashMap<>();
+    Map<String, ?> stored = preferences.getAll();
+    if (stored == null) {
+      return rows;
+    }
+    for (String key : stored.keySet()) {
+      if (key == null || !key.startsWith(ROW_PREFIX)) {
+        continue;
+      }
+      WaveformRecord record = read(key.substring(ROW_PREFIX.length()));
+      if (record != null) {
+        rows.put(key.substring(ROW_PREFIX.length()), record);
+      }
+    }
+    return rows;
+  }
+
+  private static String rowKey(String attachmentId) {
+    return ROW_PREFIX + (attachmentId == null ? "" : attachmentId);
+  }
+}
