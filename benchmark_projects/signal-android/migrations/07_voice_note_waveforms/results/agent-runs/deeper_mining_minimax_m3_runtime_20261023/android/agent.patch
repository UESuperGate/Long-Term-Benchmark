@@ -0,0 +1,44 @@
+package org.signal.benchmark.waveform;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * Small helpers for building the JSON documents the pipeline passes around, so the production
+ * components stay readable instead of threading checked {@link JSONException}s through every
+ * method. A failure here means a value could not be represented at all, which is a programming
+ * error rather than something the caller can recover from.
+ */
+public final class Json {
+  private Json() {
+  }
+
+  public static JSONObject put(JSONObject target, String key, Object value) {
+    try {
+      return target.put(key, value);
+    } catch (JSONException error) {
+      throw new IllegalStateException("Unable to store " + key, error);
+    }
+  }
+
+  public static JSONArray put(JSONArray target, Object value) {
+    return target.put(value);
+  }
+
+  public static JSONObject copyOf(JSONObject source) {
+    try {
+      return new JSONObject(source.toString());
+    } catch (JSONException error) {
+      throw new IllegalStateException("Unable to copy document", error);
+    }
+  }
+
+  public static JSONArray copyOf(JSONArray source) {
+    try {
+      return new JSONArray(source.toString());
+    } catch (JSONException error) {
+      throw new IllegalStateException("Unable to copy array", error);
+    }
+  }
+}
