@@ -0,0 +1,81 @@
+package org.signal.benchmark.waveform.upload;
+
+import org.json.JSONObject;
+import org.signal.benchmark.waveform.Json;
+
+/**
+ * How far a single attachment upload chain has progressed.
+ *
+ * <p>Compression always comes first. An audio chain then reports pending waveform generation and an
+ * upload that has not started, and only becomes uploadable once its bars are stored. A chain for
+ * any other media type never has waveform work at all.
+ */
+public final class UploadState {
+  private static final String NOT_SCHEDULED = "not_scheduled";
+
+  private final String id;
+  private boolean waveformRequired;
+  private boolean awaitedWaveform;
+  private String compression = "pending";
+  private String waveformGeneration = NOT_SCHEDULED;
+  private String upload = "waiting_for_waveform";
+  private boolean uploadStarted;
+
+  UploadState(String id) {
+    this.id = id == null ? "" : id;
+  }
+
+  public String id() {
+    return id;
+  }
+
+  void compressed() {
+    compression = "complete";
+  }
+
+  void waveformPending() {
+    waveformGeneration = "pending";
+    awaitedWaveform = true;
+  }
+
+  void waveformComplete() {
+    waveformGeneration = "complete";
+  }
+
+  void waveformRequired(boolean waveformRequired) {
+    this.waveformRequired = waveformRequired;
+  }
+
+  void uploaded() {
+    uploadStarted = true;
+    upload = "complete";
+  }
+
+  boolean isHeld() {
+    return requiresWaveform() && !uploadStarted;
+  }
+
+  boolean requiresWaveform() {
+    return waveformRequired;
+  }
+
+  /** True when this chain had to wait for its waveform before it could upload. */
+  public boolean hasAwaitedWaveform() {
+    return awaitedWaveform;
+  }
+
+  public boolean isUploadStarted() {
+    return uploadStarted;
+  }
+
+  public JSONObject toJson() {
+    JSONObject json = new JSONObject();
+    Json.put(json, "compression", compression);
+    Json.put(json, "waveformGeneration", waveformGeneration);
+    Json.put(json, "upload", upload);
+    Json.put(json, "waveformRequired", waveformRequired);
+    Json.put(json, "uploadStarted", uploadStarted);
+    Json.put(json, "awaitedWaveform", awaitedWaveform);
+    return json;
+  }
+}
