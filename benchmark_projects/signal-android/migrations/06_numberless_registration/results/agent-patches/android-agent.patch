@@ -0,0 +1,98 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration
+
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.collect
+import org.signal.core.util.billing.OneTimePurchaseApi
+import org.signal.core.util.logging.Log
+import org.signal.registration.screens.signallogininfo.SignalLoginInfoScreenActions
+import org.signal.registration.screens.signallogininfo.SignalLoginInfoScreenEvents
+import org.signal.registration.screens.signallogininfo.SignalLoginInfoViewModel
+import org.signal.registration.screens.signalloginpayment.SignalLoginPaymentScreenActions
+import org.signal.registration.screens.signalloginpayment.SignalLoginPaymentScreenEvents
+import org.signal.registration.screens.signalloginpayment.SignalLoginPaymentViewModel
+import org.signal.registration.util.SignalCredentialManager
+
+/**
+ * The effects that have to happen on the UI layer, because they need things the UI layer owns.
+ *
+ * Two of them matter for correctness:
+ *
+ *  - The purchase sheet. A view model can prepare a purchase and hand out a launcher, but only something holding an
+ *    activity can actually show the sheet. So the launcher crosses out here, the sheet is presented here, and whatever
+ *    it settles as comes straight back to the owning view model as a single event. Nothing in between is allowed to
+ *    assume an outcome.
+ *
+ *  - The password manager. A save is only believed once the same credential can be read back out of it, and both halves
+ *    of that round trip happen here, with each result routed back to the view model that asked for it.
+ */
+object RegistrationNavigation {
+
+  private val TAG = Log.tag(RegistrationNavigation::class)
+
+  /**
+   * Drive the Signal Login payment screen's outward-facing effects.
+   *
+   * Stays alive for as long as the screen does, because the purchase sheet's result arrives asynchronously long after
+   * the tap that started it.
+   */
+  suspend fun collectPaymentActions(
+    actions: Flow<SignalLoginPaymentScreenActions>,
+    viewModel: SignalLoginPaymentViewModel,
+    oneTimePurchaseApi: OneTimePurchaseApi,
+    onOpenUrl: (String) -> Unit = {}
+  ) {
+    actions.collect { action ->
+      when (action) {
+        is SignalLoginPaymentScreenActions.OpenLearnMoreArticle -> {
+          onOpenUrl(SIGNAL_LOGIN_LEARN_MORE_URL)
+        }
+        is SignalLoginPaymentScreenActions.LaunchPurchaseSheet -> {
+          val result = oneTimePurchaseApi.launchPurchase(action.launcher)
+          // The one and only thing that can complete a purchase.
+          viewModel.onEvent(SignalLoginPaymentScreenEvents.PurchaseFlowCompleted(result))
+        }
+        is SignalLoginPaymentScreenActions.ResolvePaymentServices -> {
+          onOpenUrl(GOOGLE_PLAY_SERVICES_URL)
+        }
+      }
+    }
+  }
+
+  /**
+   * Drive the Signal Login info screen's password manager effects.
+   *
+   * The credential handed over is exactly what the user was shown: the uppercase account ID and the display-form
+   * recovery key.
+   */
+  suspend fun collectCredentialActions(
+    actions: Flow<SignalLoginInfoScreenActions>,
+    viewModel: SignalLoginInfoViewModel,
+    credentialManager: SignalCredentialManager
+  ) {
+    actions.collect { action ->
+      when (action) {
+        is SignalLoginInfoScreenActions.SaveCredentialWithPasswordManager -> {
+          val state = viewModel.state.value
+          val result = credentialManager.saveCredential(
+            username = state.accountId,
+            password = state.recoveryKey
+          )
+          viewModel.onEvent(SignalLoginInfoScreenEvents.CredentialSaveCompleted(result))
+        }
+        is SignalLoginInfoScreenActions.ReadBackSavedCredential -> {
+          // Filtered to the account we issued, so a stale entry for some other login can't be mistaken for ours.
+          val credential = viewModel.aci?.let { credentialManager.getCredential(it) }
+          viewModel.onEvent(SignalLoginInfoScreenEvents.SavedCredentialRetrieved(credential))
+        }
+      }
+    }
+  }
+
+  private const val SIGNAL_LOGIN_LEARN_MORE_URL = "https://signal.org/support/numberless-registration/"
+  private const val GOOGLE_PLAY_SERVICES_URL = "market://details?id=com.google.android.gms"
+}
