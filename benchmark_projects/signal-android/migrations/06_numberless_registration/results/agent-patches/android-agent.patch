+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.screens.signallogininfo
+
+import androidx.annotation.VisibleForTesting
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.ViewModelProvider
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.flow.receiveAsFlow
+import org.signal.core.models.AccountEntropyPool
+import org.signal.core.models.ServiceId.ACI
+import org.signal.core.ui.compose.EventDrivenViewModel
+import org.signal.core.util.logging.Log
+import org.signal.registration.RegistrationFlowEvent
+import org.signal.registration.RegistrationFlowState
+import org.signal.registration.RegistrationRoute
+import org.signal.registration.screens.util.navigateBack
+import org.signal.registration.screens.util.navigateTo
+import org.signal.registration.util.SignalCredentialManager
+
+/**
+ * Shows the account ID and recovery key the service just issued, and refuses to let registration finish until the user
+ * has demonstrably preserved them.
+ *
+ * "Demonstrably" is the important word. Writing to the password manager and getting a cheerful result back is not
+ * enough: the user has to confirm where it went, and then we read the credential back out of the password manager and
+ * compare both halves. Only an exact two-part match counts. A cancel, an interruption, a missing entry, or a mismatch
+ * all leave the user here with the option of trying again or writing it down by hand.
+ */
+class SignalLoginInfoViewModel(
+  private val flowState: RegistrationFlowState,
+  private val credentialManager: SignalCredentialManager,
+  private val parentEventEmitter: (RegistrationFlowEvent) -> Unit
+) : EventDrivenViewModel<SignalLoginInfoScreenEvents>(TAG) {
+
+  companion object {
+    private val TAG = Log.tag(SignalLoginInfoViewModel::class)
+  }
+
+  private val _state = MutableStateFlow(SignalLoginInfoState())
+  val state: StateFlow<SignalLoginInfoState> = _state.asStateFlow()
+
+  private val _actions = Channel<SignalLoginInfoScreenActions>(Channel.BUFFERED)
+  val actions: Flow<SignalLoginInfoScreenActions> = _actions.receiveAsFlow()
+
+  /** The account this screen is preserving, in its canonical form. */
+  val aci: ACI?
+    get() = flowState.aci
+
+  init {
+    _state
+      .onEach { Log.d(TAG, "[State] $it") }
+      .launchIn(viewModelScope)
+
+    val aci = flowState.aci
+    val accountEntropyPool = flowState.accountEntropyPool
+    checkNotNull(aci) { "SignalLoginInfo requires an issued ACI" }
+    checkNotNull(accountEntropyPool) { "SignalLoginInfo requires an issued recovery key" }
+
+    _state.value = SignalLoginInfoState(
+      // The uppercase ACI and the display-form recovery key are exactly what gets handed to the password manager.
+      accountId = aci.toString().uppercase(),
+      recoveryKey = accountEntropyPool.displayValue,
+      isPasswordManagerAvailable = credentialManager.isAvailable()
+    )
+  }
+
+  override suspend fun processEvent(event: SignalLoginInfoScreenEvents) {
+    applyEvent(_state.value, event, parentEventEmitter) { _state.value = it }
+  }
+
+  @VisibleForTesting
+  suspend fun applyEvent(
+    state: SignalLoginInfoState,
+    event: SignalLoginInfoScreenEvents,
+    parentEventEmitter: (RegistrationFlowEvent) -> Unit,
+    stateEmitter: (SignalLoginInfoState) -> Unit
+  ) {
+    when (event) {
+      is SignalLoginInfoScreenEvents.SaveWithPasswordManagerClicked -> {
+        if (!state.isPasswordManagerAvailable) {
+          Log.i(TAG, "No password manager available; going straight to the not-confirmed path.")
+          stateEmitter(state.copy(dialogs = state.dialogs.copy(saveNotConfirmed = true)))
+          return
+        }
+        stateEmitter(state.copy(showSpinner = true))
+        _actions.trySend(SignalLoginInfoScreenActions.SaveCredentialWithPasswordManager)
+      }
+
+      is SignalLoginInfoScreenEvents.CredentialSaveCompleted -> {
+        when (event.result) {
+          SignalCredentialManager.SaveResult.Saved -> {
+            // A successful write still isn't proof, so we stop here and ask the user to confirm it.
+            stateEmitter(state.copy(showSpinner = false, showConfirmSavedSheet = true))
+          }
+          SignalCredentialManager.SaveResult.Cancelled,
+          is SignalCredentialManager.SaveResult.Failed -> {
+            stateEmitter(state.copy(showSpinner = false, dialogs = state.dialogs.copy(saveNotConfirmed = true)))
+          }
+        }
+      }
+
+      is SignalLoginInfoScreenEvents.ConfirmSavedSheetConfirmed -> {
+        stateEmitter(state.copy(showConfirmSavedSheet = false, showSpinner = true))
+        _actions.trySend(SignalLoginInfoScreenActions.ReadBackSavedCredential)
+      }
+
+      is SignalLoginInfoScreenEvents.ConfirmSavedSheetDismissed -> {
+        stateEmitter(state.copy(showConfirmSavedSheet = false))
+      }
+
+      is SignalLoginInfoScreenEvents.SavedCredentialRetrieved -> {
+        stateEmitter(applyReadBack(state, event.credential, parentEventEmitter))
+      }
+
+      is SignalLoginInfoScreenEvents.RecordManuallyClicked -> {
+        stateEmitter(state.copy(showSpinner = false))
+        parentEventEmitter.navigateTo(RegistrationRoute.SignalLoginManualSave)
+      }
+
+      is SignalLoginInfoScreenEvents.SaveNotConfirmedDialogDismissed -> {
+        stateEmitter(state.copy(dialogs = state.dialogs.copy(saveNotConfirmed = false)))
+      }
+
+      is SignalLoginInfoScreenEvents.BackClicked -> {
+        parentEventEmitter.navigateBack()
+      }
+    }
+  }
+
+  /**
+   * Decide whether the credential is genuinely safely stored.
+   *
+   * The read-back username is normalized into an ACI and the read-back password is parsed as an account entropy pool
+   * before either is compared, so a differently-formatted but equivalent string still matches, while anything that
+   * isn't the account we issued fails. Both halves have to match; a partial match is not a match.
+   */
+  private fun applyReadBack(
+    state: SignalLoginInfoState,
+    credential: SignalCredentialManager.SignalCredential?,
+    parentEventEmitter: (RegistrationFlowEvent) -> Unit
+  ): SignalLoginInfoState {
+    val issuedAci = flowState.aci
+    val issuedRecoveryKey = flowState.accountEntropyPool
+    val readBackAci = credential?.let { ACI.parseOrNull(it.username) }
+    val readBackRecoveryKey = credential?.let { AccountEntropyPool.parseOrNull(it.password) }
+
+    val matches = issuedAci != null &&
+      issuedRecoveryKey != null &&
+      readBackAci != null &&
+      readBackRecoveryKey != null &&
+      readBackAci.toString() == issuedAci.toString() &&
+      readBackRecoveryKey.value == issuedRecoveryKey.value
+
+    if (!matches) {
+      Log.w(TAG, "The saved credential didn't read back as the account we issued; not treating it as saved.")
+      return state.copy(showSpinner = false, dialogs = state.dialogs.copy(saveNotConfirmed = true))
+    }
+
+    Log.i(TAG, "The credential read back exactly; it is safely stored.")
+    parentEventEmitter.navigateTo(RegistrationRoute.AddUsername)
+    return state.copy(showSpinner = false, dialogs = state.dialogs.copy(saveNotConfirmed = false))
+  }
+
+  class Factory(
+    private val flowState: RegistrationFlowState,
+    private val credentialManager: SignalCredentialManager,
+    private val parentEventEmitter: (RegistrationFlowEvent) -> Unit
+  ) : ViewModelProvider.Factory {
+    @Suppress("UNCHECKED_CAST")
+    override fun <T : ViewModel> create(modelClass: Class<T>): T {
+      return SignalLoginInfoViewModel(flowState, credentialManager, parentEventEmitter) as T
+    }
+  }
+}
