+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.screens.signalloginmanualsave
+
+/**
+ * State for the manual preservation path: the account ID and recovery key are on screen, formatted to be written down,
+ * and nothing has been confirmed yet.
+ */
+data class SignalLoginManualSaveState(
+  val accountId: String = "",
+  val recoveryKey: String = "",
+  val showSpinner: Boolean = false,
+  val dialogs: Dialogs = Dialogs()
+) {
+  data class Dialogs(
+    val networkError: Boolean = false,
