+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.util
+
+import android.content.Context
+import java.io.File
+
+/**
+ * Durable record of a one-time purchase that has been paid for but not yet redeemed.
+ *
+ * The purchase is only removed once it has actually been spent registering an account. Everything in between — the
+ * process being killed, a network failure while redeeming, the user backing out and coming back tomorrow — has to
+ * survive, because re-charging for a purchase the user already paid for is not acceptable.
+ *
+ * [receiptCredentialRequestContext] is stored *byte for byte* alongside the purchase token. The service rejects a
+ * second, different receipt-credential request for the same purchase, so restoring the original bytes is what makes a
+ * retry able to succeed at all.
+ */
+class SignalLoginPurchaseStore(private val file: File) {
+
+  /** A purchase awaiting redemption, along with the exact request context it must be redeemed with. */
+  data class StoredPurchase(
+    val purchaseToken: String,
+    val receiptCredentialRequestContext: ByteArray
+  ) {
+    override fun equals(other: Any?): Boolean =
+      other is StoredPurchase &&
+        other.purchaseToken == purchaseToken &&
+        other.receiptCredentialRequestContext.contentEquals(receiptCredentialRequestContext)
+
+    override fun hashCode(): Int =
+      31 * purchaseToken.hashCode() + receiptCredentialRequestContext.contentHashCode()
+  }
+
+  /** The stored purchase, or null when nothing is waiting to be redeemed. */
+  fun read(): StoredPurchase? {
+    if (!file.exists()) {
+      return null
+    }
+
+    return try {
+      val reader = BlobReader(file.readBytes())
+      reader.assertMagic(MAGIC)
+      reader.assertVersion(VERSION)
+      StoredPurchase(purchaseToken = reader.readString(), receiptCredentialRequestContext = reader.readBlob())
+    } catch (e: Exception) {
+      // A corrupt or stale file is indistinguishable from "nothing purchased" for our purposes: the user has not been
+      // overcharged either way, and the billing library is still the source of truth for what they own.
+      file.delete()
+      null
+    }
+  }
+
+  fun write(purchaseToken: String, receiptCredentialRequestContext: ByteArray) {
+    try {
+      val bytes = BlobWriter()
+        .writeInt(MAGIC)
+        .writeInt(VERSION)
+        .writeString(purchaseToken)
+        .writeBlob(receiptCredentialRequestContext)
+        .build()
+
+      file.parentFile?.mkdirs()
+      file.writeBytes(bytes)
+    } catch (_: Exception) {
+      // Persisting is an optimization for recovery, not a precondition for registering. If the write fails we simply
+      // lose the ability to resume across process death; the billing library still prevents a second charge.
+      file.delete()
+    }
+  }
+
+  /** Forget the purchase. Only call this once the purchase has been consumed. */
+  fun clear() {
+    file.delete()
+  }
+
+  companion object {
+    private const val MAGIC = 0x534C5055 // "SLPU"
+    private const val VERSION = 1
+    private const val DIRECTORY = "signal_login"
+    private const val FILE_NAME = "purchase.blob"
+
+    fun fromContext(context: Context): SignalLoginPurchaseStore =
+      SignalLoginPurchaseStore(File(context.getDir(DIRECTORY, Context.MODE_PRIVATE), FILE_NAME))
+  }
+}
