+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.screens.addusername
+
+import org.signal.libsignal.usernames.Username
+
+/**
+ * State for the optional "claim a username" step that closes out a numberless registration.
+ */
+data class AddUsernameState(
+  val username: String = "",
+  /** The discriminator. Either the user picked one, or the service assigned one. */
+  val discriminator: String = "",
+  /** True when the discriminator in the field is one the user chose, rather than one the service handed us. */
+  val isDiscriminatorUserSet: Boolean = false,
+  /** The exact `nickname.discriminator` pairing the service is currently holding for us, if any. */
+  val reservation: Username? = null,
+  val validationError: ValidationError? = null,
+  val isReserving: Boolean = false,
+  /** True only when a reservation exists and matches what's currently typed. */
+  val isSubmittable: Boolean = false,
+  /** True while the discriminator field has focus, which is when we must not swap the value out from under the user. */
+  val discriminatorFieldFocused: Boolean = false,
+  val showSpinner: Boolean = false,
+  val dialogs: Dialogs = Dialogs()
+) {
+  /** What's wrong with the current draft. */
+  sealed interface ValidationError {
+    data object NicknameInvalid : ValidationError
+    data object DiscriminatorInvalid : ValidationError
+    data object AlreadyTaken : ValidationError
+  }
+
+  data class Dialogs(
+    /**
+     * The explicit "are you sure you want to skip this?" confirmation. Skipping a username is allowed, but it is never
+     * a single tap.
+     */
+    val confirmSkip: Boolean = false,
+    val networkError: Boolean = false,
+    val unknownError: Boolean = false
+  )
+}
