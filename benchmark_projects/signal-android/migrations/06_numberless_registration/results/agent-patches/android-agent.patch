+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.screens.signallogininfo
+
+/**
+ * State for the screen that shows a brand new Signal Login's account ID and recovery key, and gets the user to
+ * preserve them before registration can finish.
+ */
+data class SignalLoginInfoState(
+  /** The ACI, in the uppercase form it is displayed (and stored) in. */
+  val accountId: String = "",
+  /** The recovery key, in its display form. */
+  val recoveryKey: String = "",
+  /** Whether the device offers a password manager we can save to. */
+  val isPasswordManagerAvailable: Boolean = false,
+  val showSpinner: Boolean = false,
+  /** Raised after a save, so the user has to confirm they know where it went. */
+  val showConfirmSavedSheet: Boolean = false,
+  val dialogs: Dialogs = Dialogs()
+) {
+  data class Dialogs(
+    /**
+     * The credential could not be confirmed — it wasn't saved, couldn't be read back, or came back different. The user
+     * can try again or record it by hand; neither is treated as success.
+     */
+    val saveNotConfirmed: Boolean = false,
+    val networkError: Boolean = false,
+    val unknownError: Boolean = false
+  )
+}
