+package org.signal.registration.screens.signallogininfo
+
+import org.signal.registration.util.SignalCredentialManager
+
+sealed class SignalLoginInfoScreenEvents {
+  /** The user asked to save the credential with the device's password manager. */
+  data object SaveWithPasswordManagerClicked : SignalLoginInfoScreenEvents()
+
+  /** The user confirmed where the saved credential went, so we can check that it's really there. */
+  data object ConfirmSavedSheetConfirmed : SignalLoginInfoScreenEvents()
+
+  /** The user dismissed the "where did it save?" sheet without confirming. */
+  data object ConfirmSavedSheetDismissed : SignalLoginInfoScreenEvents()
+
+  /** The password manager reported what happened to the write. Nothing here counts as confirmation. */
+  data class CredentialSaveCompleted(val result: SignalCredentialManager.SaveResult) : SignalLoginInfoScreenEvents()
+
+  /** The password manager gave back whatever it had stored. */
+  data class SavedCredentialRetrieved(val credential: SignalCredentialManager.SignalCredential?) : SignalLoginInfoScreenEvents()
+
+  /** The user gave up on the password manager and wants to record the credential by hand instead. */
+  data object RecordManuallyClicked : SignalLoginInfoScreenEvents()
+
+  /** The user dismissed the "we couldn't confirm your credential" dialog. */
+  data object SaveNotConfirmedDialogDismissed : SignalLoginInfoScreenEvents()
+
+  /** The user tapped back. */
+  data object BackClicked : SignalLoginInfoScreenEvents()
+}
