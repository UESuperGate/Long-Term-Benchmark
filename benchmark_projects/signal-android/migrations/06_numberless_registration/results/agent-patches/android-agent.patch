@@ -0,0 +1,67 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.screens.signallogincredentials
+
+import org.signal.core.models.ServiceId
+import org.signal.core.models.ServiceId.ACI
+import org.signal.registration.screens.aepentry.AepInput
+import org.signal.registration.screens.shared.AccountIdError
+
+/** A user-entered account ID, along with whatever is wrong with it. */
+data class AccountIdInput(val enteredText: String = "", val error: AccountIdError? = null) {
+  val normalized: String
+    get() = enteredText.trim().lowercase()
+
+  val parsed: ACI?
+    get() = ServiceId.ACI.parseOrNull(normalized)
+
+  val isValid: Boolean
+    get() = parsed != null
+
+  companion object {
+    fun from(value: String, error: AccountIdError? = null) = AccountIdInput(value, error)
+  }
+}
+
+/**
+ * State shared by the screens that deal in a Signal Login's two halves: the account ID and the recovery key.
+ *
+ * In [Mode.EnterLogin] the user is typing in a Signal Login they already have. In [Mode.ConfirmSaved] they are typing
+ * back in what they just saved or wrote down, so that we can check the two really do match.
+ */
+data class SignalLoginCredentialEntryState(
+  val mode: Mode = Mode.EnterLogin,
+  val accountId: AccountIdInput = AccountIdInput(),
+  val recoveryKey: AepInput = AepInput(),
+  /**
+   * Set when a confirmation attempt didn't match. Both fields are flagged at once, because either half could have been
+   * copied wrong and there's no way to tell which. Editing either field clears it, so a mistyped value stays editable
+   * and a corrected retry is one tap away.
+   */
+  val areCredentialsIncorrect: Boolean = false,
+  val showSpinner: Boolean = false,
+  val dialogs: Dialogs = Dialogs()
+) {
+  /**
+   * Whether the continue button should be live. This is purely about whether both halves are *well formed* — matching the
+   * issued values is a separate question that only [areCredentialsIncorrect] reports.
+   */
+  val isNextEnabled: Boolean
+    get() = !showSpinner && accountId.isValid && recoveryKey.isValid
+
+  enum class Mode {
+    /** The user is entering a Signal Login they already own. */
+    EnterLogin,
+
+    /** The user is confirming a Signal Login that was just issued, saved, or written down. */
+    ConfirmSaved
+  }
+
+  data class Dialogs(
+    val networkError: Boolean = false,
+    val unknownError: Boolean = false
+  )
+}
