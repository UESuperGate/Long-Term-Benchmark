@@ -0,0 +1,167 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.ViewModelProvider
+import androidx.lifecycle.viewModelScope
+import androidx.navigation3.runtime.NavBackStack
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.flow.receiveAsFlow
+import org.signal.core.models.AccountEntropyPool
+import org.signal.core.models.ServiceId.ACI
+import org.signal.core.ui.compose.EventDrivenViewModel
+import org.signal.core.util.logging.Log
+
+/**
+ * Owns the registration flow itself: the back stack, and the account identity that a successful registration issues.
+ *
+ * The order of two events matters a great deal here. [RegistrationFlowEvent.Registered] is always processed *before*
+ * the navigation that follows it, so a screen that is about to show the user their account ID and recovery key can
+ * rely on [aci] and [accountEntropyPool] already being populated.
+ */
+class RegistrationViewModel(
+  private val repository: RegistrationRepository,
+  initialRoute: RegistrationRoute = RegistrationRoute.Welcome,
+  private val navBackStack: NavBackStack<RegistrationRoute> = NavBackStack(initialRoute)
+) : EventDrivenViewModel<RegistrationFlowEvent>(TAG), RegistrationFlowState {
+
+  companion object {
+    private val TAG = Log.tag(RegistrationViewModel::class)
+  }
+
+  /**
+   * Everything every child screen publishes. A single serialized channel, so that the order in which a child emits
+   * [RegistrationFlowEvent.Registered] and then asks to navigate is the order in which the flow sees them.
+   */
+  private val _childEvents = Channel<RegistrationFlowEvent>(Channel.UNLIMITED)
+  val childEvents = _childEvents.receiveAsFlow()
+
+  /** The emitter handed to every child screen. */
+  val parentEventEmitter: (RegistrationFlowEvent) -> Unit = { event -> _childEvents.trySend(event) }
+
+  private val _backStack = MutableStateFlow(navBackStack.toList())
+  val backStack: StateFlow<List<RegistrationRoute>> = _backStack.asStateFlow()
+
+  private var _aci: ACI? = null
+
+  private var _accountEntropyPool: AccountEntropyPool? = null
+
+  private var _isPhoneNumberlessAccount: Boolean = false
+
+  private var _registrationComplete: Boolean = false
+
+  private var _finalRegistrationCommitted: Boolean = false
+
+  override val aci: ACI? get() = _aci
+
+  override val accountEntropyPool: AccountEntropyPool? get() = _accountEntropyPool
+
+  override val isPhoneNumberlessAccount: Boolean get() = _isPhoneNumberlessAccount
+
+  override val registrationComplete: Boolean get() = _registrationComplete
+
+  override val finalRegistrationCommitted: Boolean get() = _finalRegistrationCommitted
+
+  init {
+    childEvents
+      .onEach { onEvent(it) }
+      .launchIn(viewModelScope)
+  }
+
+  override suspend fun processEvent(event: RegistrationFlowEvent) {
+    onRegistrationFlowEvent(event)
+  }
+
+  @androidx.annotation.VisibleForTesting
+  internal fun onRegistrationFlowEvent(event: RegistrationFlowEvent) {
+    when (event) {
+      is RegistrationFlowEvent.Registered -> {
+        Log.i(TAG, "Registered. Phone numberless: ${event.phoneNumberless}")
+        _aci = event.aci
+        _accountEntropyPool = event.accountEntropyPool
+        _isPhoneNumberlessAccount = event.phoneNumberless
+      }
+      is RegistrationFlowEvent.NavigateToScreen -> {
+        if (event.popCurrent) {
+          navBackStack.pop()
+        }
+        navBackStack.add(event.route)
+        publishBackStack()
+      }
+      is RegistrationFlowEvent.NavigateBack -> {
+        navBackStack.pop()
+        publishBackStack()
+      }
+      is RegistrationFlowEvent.NavigateBackToScreen -> {
+        // Everything above the target goes away; if it isn't there at all, the target becomes the whole stack.
+        while (navBackStack.isNotEmpty() && navBackStack.last() != event.route) {
+          navBackStack.pop()
+        }
+        if (navBackStack.isEmpty()) {
+          navBackStack.add(event.route)
+        }
+        publishBackStack()
+      }
+      is RegistrationFlowEvent.ResetState -> {
+        navBackStack.resetTo(RegistrationRoute.Welcome)
+        _aci = null
+        _accountEntropyPool = null
+        _isPhoneNumberlessAccount = false
+        _registrationComplete = false
+        _finalRegistrationCommitted = false
+        publishBackStack()
+      }
+      is RegistrationFlowEvent.RegistrationComplete -> {
+        // The flow was asked to finish. That is not the same as the service having accepted the account, so
+        // [_finalRegistrationCommitted] stays false until [onRegistrationCommitted] says so.
+        _registrationComplete = true
+      }
+      else -> Log.d(TAG, "[FlowEvent] $event")
+    }
+  }
+
+  /**
+   * Record that the service has accepted this registration.
+   *
+   * A numberless account has no phone number and therefore no PIN and no phone identity keys, so the phone-verification
+   * and PIN routes a normal registration would insert are simply never added to the back stack.
+   */
+  fun onRegistrationCommitted() {
+    _finalRegistrationCommitted = true
+  }
+
+  /** True when the account identity the credential-preservation screens need is available. */
+  val hasIssuedAccountIdentity: Boolean
+    get() = _aci != null && _accountEntropyPool != null
+
+  /**
+   * The route to take when the user chooses to register without a phone number, or null when that option isn't being
+   * offered.
+   *
+   * This is purely additive: the ordinary phone-number path is a separate route and is untouched by whether this
+   * returns null.
+   */
+  fun signalLoginPaymentRoute(): RegistrationRoute? =
+    if (repository.isPhoneNumberlessRegistrationAvailable()) RegistrationRoute.SignalLoginPayment else null
+
+  private fun publishBackStack() {
+    _backStack.value = navBackStack.toList()
+  }
+
+  class Factory(
+    private val repository: RegistrationRepository,
+    private val initialRoute: RegistrationRoute = RegistrationRoute.Welcome
+  ) : ViewModelProvider.Factory {
+    @Suppress("UNCHECKED_CAST")
+    override fun <T : ViewModel> create(modelClass: Class<T>): T = RegistrationViewModel(repository, initialRoute) as T
+  }
+}
