+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.billing
+
+import org.signal.core.util.billing.BillingPurchaseState
+import org.signal.core.util.billing.BillingResponseCode
+import org.signal.core.util.billing.OneTimeProduct
+import org.signal.core.util.billing.OneTimeProductId
+import org.signal.core.util.billing.OneTimeProductResult
+import org.signal.core.util.billing.OneTimePurchase
+import org.signal.core.util.billing.OneTimePurchaseApi
+import org.signal.core.util.billing.OneTimePurchasePreparation
+import org.signal.core.util.billing.OneTimePurchaseResult
+import org.signal.core.util.billing.PurchaseLauncher
+import org.signal.core.util.censor
+import org.signal.core.util.logging.Log
+
+/**
+ * [OneTimePurchaseApi] backed by the platform billing library.
+ *
+ * The impl owns no activity. [BillingService] is the thin seam over the platform client: it is created and driven by
+ * whatever layer owns the activity, which is exactly why [launchPurchase] takes the opaque [PurchaseLauncher] rather
+ * than an activity.
+ */
+class OneTimePurchaseApiImpl(
+  private val billingService: BillingService
+) : OneTimePurchaseApi {
+
+  companion object {
+    private val TAG = Log.tag(OneTimePurchaseApiImpl::class)
+  }
+
+  override suspend fun getProduct(productId: OneTimeProductId): OneTimeProductResult {
+    if (!ensureConnected()) {
+      return OneTimeProductResult.Unavailable
+    }
+
+    val product = try {
+      billingService.queryProduct(productId)
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to query product $productId", e)
+      return OneTimeProductResult.TransientError
+    }
+
+    return if (product == null) OneTimeProductResult.Unavailable else OneTimeProductResult.Success(product)
+  }
+
+  override suspend fun preparePurchase(productId: OneTimeProductId): OneTimePurchasePreparation {
+    if (!ensureConnected()) {
+      return OneTimePurchasePreparation.Unavailable
+    }
+
+    val owned = try {
+      billingService.queryOwnedPurchase(productId)
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to query owned purchases for $productId", e)
+      return OneTimePurchasePreparation.NetworkError
+    }
+
+    if (owned != null) {
+      Log.i(TAG, "Already owns an unconsumed purchase of $productId; will not charge again.")
+      return OneTimePurchasePreparation.AlreadyPurchased(owned)
+    }
+
+    val launcher = try {
+      billingService.createLauncher(productId)
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to create a purchase launcher for $productId", e)
+      return OneTimePurchasePreparation.Failed
+    }
+
+    return OneTimePurchasePreparation.Ready(launcher)
+  }
+
+  override suspend fun launchPurchase(launcher: PurchaseLauncher): OneTimePurchaseResult {
+    if (!ensureConnected()) {
+      return OneTimePurchaseResult.Unavailable
+    }
+
+    val purchase = try {
+      billingService.launchPurchaseSheet(launcher)
+    } catch (e: Exception) {
+      Log.w(TAG, "The purchase sheet failed to launch", e)
+      return OneTimePurchaseResult.Failed
+    } ?: return OneTimePurchaseResult.UserCancelled
+
+    return when (purchase.state) {
+      BillingPurchaseState.PURCHASED -> OneTimePurchaseResult.Success(purchase)
+      BillingPurchaseState.PENDING -> OneTimePurchaseResult.NetworkError
+      BillingPurchaseState.UNSPECIFIED -> OneTimePurchaseResult.Failed
+    }
+  }
+
+  override suspend fun getUnredeemedPurchase(purchaseToken: String): OneTimePurchase? {
+    if (!ensureConnected()) {
+      return null
+    }
+
+    return try {
+      billingService.queryOwnedPurchaseByToken(purchaseToken)?.takeIf { it.state == BillingPurchaseState.PURCHASED }
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to look up owned purchase $purchaseToken", e)
+      null
+    }
+  }
+
+  override suspend fun consumePurchase(purchase: OneTimePurchase): Boolean {
+    if (!ensureConnected()) {
+      return false
+    }
+
+    return try {
+      billingService.acknowledgeAndConsume(purchase)
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to consume purchase ${purchase.purchaseToken.censor()}", e)
+      false
+    }
+  }
+
+  private suspend fun ensureConnected(): Boolean {
+    return try {
+      billingService.connect() == BillingResponseCode.OK
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to connect to the billing service", e)
+      false
+    }
+  }
+
+  /**
+   * The platform-specific operations this API needs. Implemented by the module that actually talks to the billing
+   * library, and driven from the layer that owns the activity.
+   */
+  interface BillingService {
+    /** Establish (or re-establish) the connection. Returns [BillingResponseCode.OK] when the library is usable. */
+    suspend fun connect(): BillingResponseCode
+
+    /** The product with its localized, currency-formatted price, or null when the store has nothing for [productId]. */
+    suspend fun queryProduct(productId: OneTimeProductId): OneTimeProduct?
+
+    /** An owned purchase of [productId] that has not been consumed, if there is one. */
+    suspend fun queryOwnedPurchase(productId: OneTimeProductId): OneTimePurchase?
+
+    /** An owned, unconsumed purchase identified by [purchaseToken], if there is one. */
+    suspend fun queryOwnedPurchaseByToken(purchaseToken: String): OneTimePurchase?
+
+    /** A launcher the UI layer can turn into a purchase sheet for [productId]. */
+    suspend fun createLauncher(productId: OneTimeProductId): PurchaseLauncher
+
+    /** Present the purchase sheet and wait for it to settle. Null means the user dismissed it. */
+    suspend fun launchPurchaseSheet(launcher: PurchaseLauncher): OneTimePurchase?
+
+    /** Acknowledge and remove [purchase]. */
+    suspend fun acknowledgeAndConsume(purchase: OneTimePurchase): Boolean
+  }
+}
