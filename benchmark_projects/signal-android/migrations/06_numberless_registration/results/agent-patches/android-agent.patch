+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.screens.signalloginpayment
+
+import com.google.android.gms.common.ConnectionResult
+import org.signal.core.util.PlayServicesUtil
+
+/**
+ * Whether the Play Billing machinery can be used for the Signal Login purchase *right now*.
+ *
+ * The distinction that matters is [isRecoverable]: a non-terminal value means the user can fix the condition (usually
+ * by letting Play services finish updating) and retry, so the purchase option must stay enabled; a terminal value means
+ * no amount of retrying on this device will help, so the screen explains that payment can't proceed while leaving the
+ * rest of registration available.
+ */
+enum class PaymentAvailability {
+  /** Play services and the billing library are both usable. */
+  Available,
+
+  /** Play services is present but is mid-update, disabled, or otherwise needs the user to do something first. */
+  ServiceUpdating,
+
+  /** Play services is not installed in a form we can use. Payment cannot proceed on this device. */
+  Unavailable;
+
+  /**
+   * True when the condition can be repaired by the user. Recoverable availability never locks the user out of the
+   * purchase option; it only asks them to resolve the condition and try again.
+   */
+  val isRecoverable: Boolean
+    get() = this != Unavailable
+
+  companion object {
+    /**
+     * Maps a Play services connection result onto our own availability. Anything that isn't explicitly "you need to
+     * go update/enable Play services" is treated as terminal.
+     */
+    fun fromConnectionResult(connectionResultCode: Int): PaymentAvailability = when (connectionResultCode) {
+      ConnectionResult.SUCCESS -> Available
+      ConnectionResult.SERVICE_UPDATING,
+      ConnectionResult.SERVICE_VERSION_UPDATE_REQUIRED,
+      ConnectionResult.SERVICE_DISABLED,
+      ConnectionResult.SERVICE_INVALID -> ServiceUpdating
+      else -> Unavailable
+    }
+
+    /** Cheap probe used when a full connection result isn't available. */
+    fun fromPlayServicesStatus(status: PlayServicesUtil.PlayServicesStatus): PaymentAvailability = when (status) {
+      PlayServicesUtil.PlayServicesStatus.SUCCESS -> Available
+      PlayServicesUtil.PlayServicesStatus.MISSING -> Unavailable
+    }
+  }
+}
