@@ -0,0 +1,276 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration
+
+import java.security.SecureRandom
+import org.signal.core.util.billing.OneTimeProductId
+import org.signal.core.util.billing.OneTimeProductResult
+import org.signal.core.util.billing.OneTimePurchase
+import org.signal.core.util.billing.OneTimePurchaseApi
+import org.signal.core.util.billing.OneTimePurchasePreparation
+import org.signal.core.util.censor
+import org.signal.core.util.logging.Log
+import org.signal.libsignal.net.RequestResult
+import org.signal.libsignal.zkgroup.receipts.ReceiptCredentialResult
+import org.signal.network.api.RegistrationApiV2.RegisterAccountError
+import org.signal.registration.screens.signalloginpayment.PaymentAvailability
+import org.signal.registration.util.SignalLoginPurchaseStore
+
+/**
+ * Owns everything between "the user decided to pay" and "an account exists": deciding whether the purchase is even
+ * possible, preparing it, remembering it across process death, turning the paid purchase into a privacy-preserving
+ * proof of payment, and handing that proof to the registration service.
+ *
+ * Three rules hold no matter what:
+ *
+ *  1. The product ID always comes from the service, and the price always comes from the billing library. Nothing the
+ *     caller passes in can substitute for either.
+ *  2. A purchase is consumed, and its persisted context dropped, *only* after its proof has actually registered an
+ *     account. Every failure before that point leaves the purchase on disk so the next attempt redeems rather than
+ *     re-charges.
+ *  3. Nothing here can report success without the service having registered an account. A cancelled sheet, a pending
+ *     purchase, a rate limit, or a dead network are all outcomes that preserve the purchase and report no success.
+ */
+class SignalLoginPurchaseStep(
+  private val repository: RegistrationRepository,
+  private val oneTimePurchaseApi: OneTimePurchaseApi,
+  private val purchaseStore: SignalLoginPurchaseStore,
+  private val randomBytes: (Int) -> ByteArray = ::secureRandomBytes
+) {
+
+  companion object {
+    private val TAG = Log.tag(SignalLoginPurchaseStep::class)
+
+    /**
+     * The purchase option within the service-provided product that pays for registering *without* a number. The
+     * product ID itself is never ours to choose — see [productId].
+     */
+    const val NO_NUMBER_PURCHASE_OPTION_ID = "nonumber"
+
+    /** How much randomness goes into a receipt credential request. */
+    private const val RECEIPT_CREDENTIAL_REQUEST_CONTEXT_LENGTH = 32
+
+    private fun secureRandomBytes(length: Int): ByteArray = ByteArray(length).also { SecureRandom().nextBytes(it) }
+  }
+
+  /**
+   * Whether the purchase can proceed, and for how much.
+   *
+   * [Available] is the only outcome that lets the user act; everything else is either retryable ([NeedsServiceUpdate],
+   * [TransientError]) or terminal ([Unavailable], [NoProductConfigured]).
+   */
+  sealed interface Price {
+    /** The purchase is possible, at this localized, currency-formatted price. */
+    data class Available(val productId: OneTimeProductId, val formattedPrice: String) : Price
+
+    /** Play services needs the user to do something first. Retryable; the purchase option stays enabled. */
+    data object NeedsServiceUpdate : Price
+
+    /** A lookup failed in a way that may well succeed next time. */
+    data object TransientError : Price
+
+    /** Payment can't proceed on this device at all. */
+    data object Unavailable : Price
+
+    /** The service hasn't told us which product to buy. */
+    data object NoProductConfigured : Price
+  }
+
+  /** The outcome of turning a paid purchase into a registered account. */
+  sealed interface Redemption {
+    /** The proof registered an account. [phoneNumberless] is true when the response carried no phone number. */
+    data class Registered(val data: RegisteredAccountData, val phoneNumberless: Boolean) : Redemption
+
+    /** The service hasn't finished processing the purchase. The purchase stays recoverable. */
+    data object ReceiptPending : Redemption
+
+    /** The proof wasn't accepted. The purchase stays recoverable, but retrying won't fix a bad credential. */
+    data object ReceiptRejected : Redemption
+
+    /** The network failed. The purchase stays recoverable and will not be charged again. */
+    data class NetworkError(val error: Throwable) : Redemption
+
+    /** Anything else. The purchase stays recoverable. */
+    data class Failed(val error: Throwable) : Redemption
+
+    /** There is nothing paid-but-unredeemed to work with. */
+    data object NothingToRedeem : Redemption
+  }
+
+  /**
+   * Work out whether a purchase is possible and what it costs. This never starts a purchase; it only discovers
+   * eligibility and a price.
+   */
+  suspend fun loadPrice(): Price {
+    val availability = repository.getPaymentAvailability()
+    if (availability != PaymentAvailability.Available) {
+      Log.i(TAG, "Payment is not available right now: $availability")
+      return if (availability.isRecoverable) Price.NeedsServiceUpdate else Price.Unavailable
+    }
+
+    val productId = try {
+      productId()
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to load the service-provided login configuration", e)
+      return Price.TransientError
+    } ?: return Price.NoProductConfigured
+
+    return when (val result = oneTimePurchaseApi.getProduct(productId)) {
+      is OneTimeProductResult.Success -> {
+        // The formatted price is the billing library's, verbatim. We never format it ourselves.
+        Price.Available(productId, result.product.formattedPrice)
+      }
+      OneTimeProductResult.TransientError -> Price.TransientError
+      OneTimeProductResult.Unavailable -> Price.Unavailable
+    }
+  }
+
+  /**
+   * The anti-spam product to buy, taken verbatim from the service's login configuration. Returns null when the
+   * service hasn't configured one.
+   */
+  private suspend fun productId(): OneTimeProductId? {
+    val playProductId = repository.getLoginConfiguration().playProductId?.takeIf { it.isNotBlank() } ?: return null
+    return OneTimeProductId(productId = playProductId, purchaseOptionId = NO_NUMBER_PURCHASE_OPTION_ID)
+  }
+
+  /**
+   * A purchase the user has already paid for, if billing still owns one. Used to keep the payment screen in a state
+   * where "continue" redeems instead of charging.
+   */
+  suspend fun restoreUnredeemedPurchase(): OneTimePurchase? {
+    val stored = purchaseStore.read()
+    if (stored == null) {
+      return null
+    }
+
+    val owned = oneTimePurchaseApi.getUnredeemedPurchase(stored.purchaseToken)
+    if (owned == null) {
+      // Billing has nothing (or no longer has anything) for this token, so there is nothing left to redeem.
+      Log.i(TAG, "Dropping a persisted purchase that billing no longer owns.")
+      purchaseStore.clear()
+      return null
+    }
+
+    Log.i(TAG, "Restored a paid-but-unredeemed purchase from disk.")
+    return owned
+  }
+
+  /**
+   * Get ready to buy, without buying. A purchase the account already owns comes back as
+   * [OneTimePurchasePreparation.AlreadyPurchased] instead of a launcher, so the user cannot be charged twice.
+   */
+  suspend fun preparePurchase(): OneTimePurchasePreparation {
+    val productId = try {
+      productId()
+    } catch (e: Exception) {
+      Log.w(TAG, "Failed to load the service-provided login configuration", e)
+      return OneTimePurchasePreparation.NetworkError
+    } ?: return OneTimePurchasePreparation.Unavailable
+
+    return oneTimePurchaseApi.preparePurchase(productId)
+  }
+
+  /**
+   * Remember a purchase that has just been paid for, so it survives process death and can be redeemed later.
+   *
+   * If we already have a record of this purchase we keep the original receipt credential request context: the service
+   * rejects a different request for the same purchase, so regenerating one would make the retry impossible.
+   */
+  fun recordPurchase(purchase: OneTimePurchase) {
+    val existing = purchaseStore.read()
+    if (existing != null && existing.purchaseToken == purchase.purchaseToken) {
+      Log.i(TAG, "Already have a record of this purchase; keeping the original request context.")
+      return
+    }
+
+    purchaseStore.write(purchase.purchaseToken, randomBytes(RECEIPT_CREDENTIAL_REQUEST_CONTEXT_LENGTH))
+  }
+
+  /**
+   * Exchange a paid purchase for a verified proof of payment and register an account with it.
+   *
+   * [purchase] may be null, in which case the persisted purchase is used — that is the path taken when the process was
+   * killed between paying and redeeming.
+   */
+  suspend fun redeem(purchase: OneTimePurchase?): Redemption {
+    if (purchase != null) {
+      recordPurchase(purchase)
+    }
+
+    val stored = purchaseStore.read()
+    if (stored == null) {
+      Log.i(TAG, "Nothing paid-but-unredeemed to redeem.")
+      return Redemption.NothingToRedeem
+    }
+
+    val credential = when (val result = repository.createLoginReceiptCredential(stored.purchaseToken, stored.receiptCredentialRequestContext)) {
+      is CreateLoginReceiptCredentialResult.Issued -> result.credential
+      CreateLoginReceiptCredentialResult.Pending -> {
+        Log.i(TAG, "The service hasn't finished processing the purchase yet.")
+        return Redemption.ReceiptPending
+      }
+      is CreateLoginReceiptCredentialResult.InvalidPurchase -> {
+        // The purchase stays on disk on purpose. The user paid for it, and forgetting that would let the screen look
+        // like a fresh "buy" while billing still owns a purchase they can never get rid of.
+        Log.w(TAG, "The service rejected purchase ${stored.purchaseToken.censor()}.")
+        return Redemption.ReceiptRejected
+      }
+      CreateLoginReceiptCredentialResult.RateLimited -> {
+        Log.w(TAG, "Rate limited while requesting a receipt credential.")
+        return Redemption.Failed(RateLimitException())
+      }
+    }
+
+    val presentation = when (val verification = repository.verifyReceiptCredential(credential)) {
+      is ReceiptCredentialResult.Success -> verification.presentation
+      is ReceiptCredentialResult.Failure -> {
+        // Also preserved: the purchase is still paid for, and a retry re-requests with the same context.
+        Log.w(TAG, "The issued receipt credential did not verify. Message: ${verification.error?.message}")
+        return Redemption.ReceiptRejected
+      }
+    }
+
+    return when (val result = repository.registerAccountWithoutPhoneNumber(presentation)) {
+      is RequestResult.Success -> {
+        // The account exists, so the purchase has been spent. Only now is it safe to consume it.
+        consume(OneTimePurchase(stored.purchaseToken))
+        Redemption.Registered(result.result, phoneNumberless = result.result.response.e164 == null)
+      }
+      is RequestResult.NonSuccess -> {
+        // Registration didn't happen, so the purchase is still owed an account. Keep it on disk.
+        Log.w(TAG, "Registration with the receipt credential failed: ${result.error}")
+        Redemption.Failed(RegistrationFailedException(result.error))
+      }
+      is RequestResult.RetryableNetworkError -> {
+        Log.w(TAG, "Network error while registering.", result.networkError)
+        Redemption.NetworkError(result.networkError)
+      }
+      is RequestResult.ApplicationError -> {
+        Log.w(TAG, "Application error while registering.", result.cause)
+        Redemption.Failed(result.cause)
+      }
+    }
+  }
+
+  /** Throwaway carrier for a service-side rate limit, which callers treat like any other retryable failure. */
+  class RateLimitException : Exception("Rate limited")
+
+  /** Throwaway carrier for a registration failure, which callers treat like any other retryable failure. */
+  class RegistrationFailedException(val error: RegisterAccountError) : Exception("Registration failed: $error")
+
+  private suspend fun consume(purchase: OneTimePurchase) {
+    if (oneTimePurchaseApi.consumePurchase(purchase)) {
+      purchaseStore.clear()
+      Log.i(TAG, "Consumed the purchase and cleared its persisted context.")
+    } else {
+      // The account is already registered, so we can't ask the user to pay again. Holding onto our local record would
+      // only strand them on a purchase that can never be redeemed, so we let it go and make noise instead.
+      Log.w(TAG, "Registered an account but failed to consume purchase ${purchase.purchaseToken.censor()}.")
+      purchaseStore.clear()
+    }
+  }
+}
