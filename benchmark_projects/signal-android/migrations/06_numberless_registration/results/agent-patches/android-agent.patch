+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.util
+
+import java.io.ByteArrayOutputStream
+import java.io.DataInputStream
+import java.io.DataOutputStream
+
+/**
+ * Minimal length-prefixed blob encoding used for the little bit of durable state registration owns between process
+ * lifetimes. Values are written with an explicit magic number and version so that a file written by an older (or
+ * newer) build is rejected rather than misinterpreted.
+ */
+class BlobWriter {
+  private val buffer = ByteArrayOutputStream()
+  private val stream = DataOutputStream(buffer)
+
+  fun writeInt(value: Int) = apply { stream.writeInt(value) }
+
+  fun writeString(value: String) = writeBlob(value.toByteArray(Charsets.UTF_8))
+
+  fun writeBlob(value: ByteArray) = apply {
+    stream.writeInt(value.size)
+    stream.write(value)
+  }
+
+  fun build(): ByteArray {
+    stream.flush()
+    return buffer.toByteArray()
+  }
+}
+
+class BlobReader(private val source: ByteArray) {
+  private val stream = DataInputStream(source.inputStream())
+
+  fun readInt(): Int = stream.readInt()
+
+  fun readString(): String = String(readBlob(), Charsets.UTF_8)
+
+  fun readBlob(): ByteArray = ByteArray(readInt()).also { stream.readFully(it) }
+
+  fun assertMagic(magic: Int) {
+    val actual = readInt()
+    check(actual == magic) { "Bad blob magic: expected $magic but got $actual" }
+  }
+
+  fun assertVersion(version: Int) {
+    val actual = readInt()
+    check(actual == version) { "Bad blob version: expected $version but got $actual" }
+  }
+
+  /** True when there is another field to read. */
+  fun hasNext(): Boolean = stream.available() > 0
+}
