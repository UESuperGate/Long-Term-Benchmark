+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration
+
+import org.signal.core.models.AccountEntropyPool
+import org.signal.core.models.ServiceId.ACI
+
+/**
+ * The account identity issued by a successful registration, shared by every screen in the flow.
+ *
+ * A numberless registration fills these in from a receipt-based registration response, which carries neither a phone
+ * number nor any PNI key material — so [isPhoneNumberlessAccount] being true is exactly the statement that no
+ * phone-number identity exists for this account.
+ */
+interface RegistrationFlowState {
+  /** The ACI the service issued for this account, once registration has succeeded. */
+  val aci: ACI?
+
+  /** The recovery key (account entropy pool) issued alongside the ACI. */
+  val accountEntropyPool: AccountEntropyPool?
+
+  /** True when the account was created without a phone number, so it has no PIN and no phone identity keys. */
+  val isPhoneNumberlessAccount: Boolean
+
+  /** True once the flow has emitted [RegistrationFlowEvent.RegistrationComplete]. */
+  val registrationComplete: Boolean
+
+  /**
+   * True once registration has actually been committed with the service. Distinguishes "the user asked to skip the
+   * username" from "the service has accepted the account", so that a failure can't be mistaken for success.
+   */
+  val finalRegistrationCommitted: Boolean
+}
