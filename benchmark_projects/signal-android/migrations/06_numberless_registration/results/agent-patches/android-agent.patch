+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.screens.signallogincredentials
+
+import androidx.annotation.VisibleForTesting
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.ViewModelProvider
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+import org.signal.core.models.AccountEntropyPool
+import org.signal.core.ui.compose.EventDrivenViewModel
+import org.signal.core.util.logging.Log
+import org.signal.libsignal.net.RequestResult
+import org.signal.registration.RegistrationFlowEvent
+import org.signal.registration.RegistrationFlowState
+import org.signal.registration.RegistrationRepository
+import org.signal.registration.RegistrationRoute
+import org.signal.registration.screens.aepentry.AepInput
+import org.signal.registration.screens.util.navigateBack
+import org.signal.registration.screens.util.navigateTo
+
+/**
+ * The manual preservation path's verification step: the user types back in the account ID and recovery key they just
+ * saved or wrote down, and we check both halves against the ones the service issued.
+ *
+ * Registration does not advance unless both halves match. A mismatch flags both fields, because either one could have
+ * been copied wrong and there's nothing to indicate which; editing either field clears the flag so the user can just fix
+ * the typo. Nothing here can recreate the account, so a correction is always cheaper than starting over.
+ */
+class SignalLoginManualSaveConfirmationViewModel(
+  private val flowState: RegistrationFlowState,
+  private val repository: RegistrationRepository,
+  private val parentEventEmitter: (RegistrationFlowEvent) -> Unit
+) : EventDrivenViewModel<SignalLoginCredentialEntryScreenEvents>(TAG) {
+
+  companion object {
+    private val TAG = Log.tag(SignalLoginManualSaveConfirmationViewModel::class)
+  }
+
+  private val _state = MutableStateFlow(SignalLoginCredentialEntryState(mode = SignalLoginCredentialEntryState.Mode.ConfirmSaved))
+  val state: StateFlow<SignalLoginCredentialEntryState> = _state.asStateFlow()
+
+  init {
+    _state
+      .onEach { Log.d(TAG, "[State] $it") }
+      .launchIn(viewModelScope)
+  }
+
+  override suspend fun processEvent(event: SignalLoginCredentialEntryScreenEvents) {
+    applyEvent(_state.value, event, parentEventEmitter) { _state.value = it }
+  }
+
+  @VisibleForTesting
+  suspend fun applyEvent(
+    state: SignalLoginCredentialEntryState,
+    event: SignalLoginCredentialEntryScreenEvents,
+    parentEventEmitter: (RegistrationFlowEvent) -> Unit,
+    stateEmitter: (SignalLoginCredentialEntryState) -> Unit
+  ) {
+    when (event) {
+      is SignalLoginCredentialEntryScreenEvents.AccountIdChanged -> {
+        // Editing either half clears the flag: the whole point is that a correction is reachable immediately.
+        stateEmitter(state.copy(accountId = AccountIdInput.from(event.value), areCredentialsIncorrect = false))
+      }
+
+      is SignalLoginCredentialEntryScreenEvents.RecoveryKeyChanged -> {
+        stateEmitter(state.copy(recoveryKey = AepInput.from(event.value), areCredentialsIncorrect = false))
+      }
+
+      is SignalLoginCredentialEntryScreenEvents.NextClicked -> {
+        when (state.mode) {
+          SignalLoginCredentialEntryState.Mode.ConfirmSaved -> applyConfirmation(state, parentEventEmitter, stateEmitter)
+          SignalLoginCredentialEntryState.Mode.EnterLogin -> applyExistingLogin(state, parentEventEmitter, stateEmitter)
+        }
+      }
+
+      is SignalLoginCredentialEntryScreenEvents.BackClicked -> {
+        parentEventEmitter.navigateBack()
+      }
+
+      is SignalLoginCredentialEntryScreenEvents.NetworkErrorDialogDismissed -> {
+        stateEmitter(state.copy(dialogs = state.dialogs.copy(networkError = false)))
+      }
+
+      is SignalLoginCredentialEntryScreenEvents.UnknownErrorDialogDismissed -> {
+        stateEmitter(state.copy(dialogs = state.dialogs.copy(unknownError = false)))
+      }
+    }
+  }
+
+  /**
+   * Compare both halves of what was typed against the account identity the flow is holding.
+   *
+   * A single flag covers both fields on purpose: a partial match tells us nothing about which half was copied wrong, so
+   * flagging both is the only honest thing to do.
+   */
+  private fun applyConfirmation(
+    state: SignalLoginCredentialEntryState,
+    parentEventEmitter: (RegistrationFlowEvent) -> Unit,
+    stateEmitter: (SignalLoginCredentialEntryState) -> Unit
+  ) {
+    val issuedAci = flowState.aci
+    val issuedRecoveryKey = flowState.accountEntropyPool
+    val enteredAci = state.accountId.parsed
+    val enteredRecoveryKey = AccountEntropyPool.parseOrNull(state.recoveryKey.normalized)
+
+    val matches = issuedAci != null &&
+      issuedRecoveryKey != null &&
+      enteredAci != null &&
+      enteredRecoveryKey != null &&
+      enteredAci.toString() == issuedAci.toString() &&
+      enteredRecoveryKey.value == issuedRecoveryKey.value
+
+    if (!matches) {
+      Log.w(TAG, "The re-entered credentials don't match the issued account; both fields flagged.")
+      stateEmitter(state.copy(areCredentialsIncorrect = true))
+      return
+    }
+
+    Log.i(TAG, "The re-entered credentials match the issued account.")
+    parentEventEmitter.navigateTo(RegistrationRoute.AddUsername)
+    stateEmitter(state.copy(areCredentialsIncorrect = false))
+  }
+
+  /** The user is entering a Signal Login they already own, rather than confirming one we just issued. */
+  private suspend fun applyExistingLogin(
+    state: SignalLoginCredentialEntryState,
+    parentEventEmitter: (RegistrationFlowEvent) -> Unit,
+    stateEmitter: (SignalLoginCredentialEntryState) -> Unit
+  ) {
+    val aci = state.accountId.parsed ?: return stateEmitter(state.copy(areCredentialsIncorrect = true))
+    val recoveryKey = AccountEntropyPool.parseOrNull(state.recoveryKey.normalized) ?: return stateEmitter(state.copy(areCredentialsIncorrect = true))
+
+    stateEmitter(state.copy(showSpinner = true))
+    val result = repository.registerAccountWithExistingSignalLogin(aci, recoveryKey)
+    stateEmitter(state.copy(showSpinner = false))
+
+    when (result) {
+      is RequestResult.Success -> {
+        val data = result.result
+        parentEventEmitter(RegistrationFlowEvent.Registered(data.aci, data.keyMaterial.accountEntropyPool, data.response.storageCapable, phoneNumberless = data.response.e164 == null))
+        parentEventEmitter.navigateTo(RegistrationRoute.SignalLoginInfo, popCurrent = true)
+      }
+      is RequestResult.NonSuccess -> stateEmitter(state.copy(dialogs = state.dialogs.copy(unknownError = true)))
+      is RequestResult.RetryableNetworkError -> stateEmitter(state.copy(dialogs = state.dialogs.copy(networkError = true)))
+      is RequestResult.ApplicationError -> stateEmitter(state.copy(dialogs = state.dialogs.copy(unknownError = true)))
+    }
+  }
+
+  class Factory(
+    private val flowState: RegistrationFlowState,
+    private val repository: RegistrationRepository,
+    private val parentEventEmitter: (RegistrationFlowEvent) -> Unit
+  ) : ViewModelProvider.Factory {
+    @Suppress("UNCHECKED_CAST")
+    override fun <T : ViewModel> create(modelClass: Class<T>): T {
+      return SignalLoginManualSaveConfirmationViewModel(flowState, repository, parentEventEmitter) as T
+    }
+  }
+}
