@@ -0,0 +1,340 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.screens.addusername
+
+import androidx.annotation.VisibleForTesting
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.ViewModelProvider
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.launch
+import org.signal.core.ui.compose.EventDrivenViewModel
+import org.signal.core.util.UsernameUtil
+import org.signal.core.util.logging.Log
+import org.signal.libsignal.net.RequestResult
+import org.signal.libsignal.usernames.Username
+import org.signal.network.service.UsernameService.ConfirmUsernameError
+import org.signal.network.service.UsernameService.ReserveUsernameError
+import org.signal.registration.RegistrationFlowEvent
+import org.signal.registration.RegistrationFlowState
+import org.signal.registration.RegistrationRepository
+
+/**
+ * The optional last step of a numberless registration: claim a username, or don't.
+ *
+ * Two rules shape everything here. A username is only ever confirmed after the exact `nickname.discriminator` pairing on
+ * screen has been reserved, so editing either half immediately invalidates the reservation it was based on. And skipping
+ * is always two steps — a request, then an explicit confirmation — so no single tap can finish registration without a
+ * username.
+ */
+class AddUsernameViewModel(
+  private val repository: RegistrationRepository,
+  private val flowState: RegistrationFlowState,
+  private val parentEventEmitter: (RegistrationFlowEvent) -> Unit,
+  private val settleTimeMs: Long = SETTLE_TIME_MS
+) : EventDrivenViewModel<AddUsernameScreenEvents>(TAG) {
+
+  companion object {
+    private val TAG = Log.tag(AddUsernameViewModel::class)
+
+    /** How long we let typing settle before asking the service to reserve anything. */
+    const val SETTLE_TIME_MS = 500L
+  }
+
+  private val _state = MutableStateFlow(AddUsernameState())
+  val state: StateFlow<AddUsernameState> = _state.asStateFlow()
+
+  /** The in-flight settle-and-reserve, cancelled whenever the draft changes again. */
+  private var settleJob: Job? = null
+
+  init {
+    _state
+      .onEach { Log.d(TAG, "[State] $it") }
+      .launchIn(viewModelScope)
+  }
+
+  override suspend fun processEvent(event: AddUsernameScreenEvents) {
+    applyEvent(_state.value, event, parentEventEmitter) { _state.value = it }
+
+    when (event) {
+      is AddUsernameScreenEvents.NicknameChanged,
+      is AddUsernameScreenEvents.DiscriminatorChanged -> scheduleReservation()
+      is AddUsernameScreenEvents.DiscriminatorFocusLost -> requestServiceAssignedDiscriminatorIfBlank()
+      else -> Unit
+    }
+  }
+
+  @VisibleForTesting
+  suspend fun applyEvent(
+    state: AddUsernameState,
+    event: AddUsernameScreenEvents,
+    parentEventEmitter: (RegistrationFlowEvent) -> Unit,
+    stateEmitter: (AddUsernameState) -> Unit
+  ) {
+    when (event) {
+      is AddUsernameScreenEvents.NicknameChanged -> {
+        // The reservation was for the previous nickname, so it no longer describes anything on screen.
+        stateEmitter(
+          state.copy(
+            username = event.value,
+            reservation = null,
+            isSubmittable = false,
+            validationError = null
+          )
+        )
+      }
+
+      is AddUsernameScreenEvents.DiscriminatorChanged -> {
+        // The service is holding a specific `nickname.discriminator` pairing, and clearing or changing this field means
+        // that pairing is no longer what the user is looking at. Drop it at once; there is nothing to confirm.
+        stateEmitter(
+          state.copy(
+            discriminator = event.value,
+            isDiscriminatorUserSet = event.value.isNotBlank(),
+            reservation = null,
+            isSubmittable = false,
+            validationError = if (event.value.isNotBlank() && UsernameUtil.checkDiscriminator(event.value.trim()) != null) {
+              AddUsernameState.ValidationError.DiscriminatorInvalid
+            } else {
+              null
+            }
+          )
+        )
+      }
+
+      is AddUsernameScreenEvents.DiscriminatorFocusChanged -> {
+        stateEmitter(state.copy(discriminatorFieldFocused = event.focused))
+      }
+
+      is AddUsernameScreenEvents.DiscriminatorFocusLost -> {
+        stateEmitter(state.copy(discriminatorFieldFocused = false))
+      }
+
+      is AddUsernameScreenEvents.NextClicked -> {
+        confirm(state, parentEventEmitter, stateEmitter)
+      }
+
+      is AddUsernameScreenEvents.SkipClicked -> {
+        // A request. Registration is not finished, and the user stays right here.
+        stateEmitter(state.copy(dialogs = state.dialogs.copy(confirmSkip = true)))
+      }
+
+      is AddUsernameScreenEvents.SkipConfirmed -> {
+        // Only this event may turn the pending skip into a completed registration.
+        finalize(state, username = null, parentEventEmitter, stateEmitter)
+      }
+
+      is AddUsernameScreenEvents.SkipDialogDismissed -> {
+        stateEmitter(state.copy(dialogs = state.dialogs.copy(confirmSkip = false)))
+      }
+
+      is AddUsernameScreenEvents.NetworkErrorDialogDismissed -> {
+        stateEmitter(state.copy(dialogs = state.dialogs.copy(networkError = false)))
+      }
+
+      is AddUsernameScreenEvents.UnknownErrorDialogDismissed -> {
+        stateEmitter(state.copy(dialogs = state.dialogs.copy(unknownError = false)))
+      }
+    }
+  }
+
+  /**
+   * Wait for typing to settle, then reserve whatever the draft says.
+   *
+   * Cancelled and replaced on every keystroke, so only the last thing the user typed can ever reach the service.
+   */
+  private fun scheduleReservation() {
+    settleJob?.cancel()
+    settleJob = viewModelScope.launch {
+      delay(settleTimeMs)
+      reserveCurrentDraft(::applyState)
+    }
+  }
+
+  /**
+   * Fetch a free discriminator from the service, but only when the user has cleared the field and is no longer typing
+   * in it.
+   *
+   * This is deliberately *not* done from [AddUsernameScreenEvents.DiscriminatorChanged]. Writing into a field that still
+   * has focus is how a service-assigned discriminator gets overwritten — or, worse, appears to have been accepted when
+   * the user actually cleared it. Waiting for focus to go away removes the race entirely.
+   */
+  private fun requestServiceAssignedDiscriminatorIfBlank() {
+    settleJob?.cancel()
+    settleJob = viewModelScope.launch {
+      val state = _state.value
+      if (state.discriminatorFieldFocused || state.isDiscriminatorUserSet || state.discriminator.isNotBlank()) {
+        return@launch
+      }
+
+      when (val result = repository.getRandomUsernameDiscriminator()) {
+        is RequestResult.Success -> {
+          val assigned = _state.value.copy(discriminator = result.result, isDiscriminatorUserSet = false)
+          _state.value = assigned
+          reserve(assigned.username.trim(), assigned.discriminator.trim(), ::applyState)
+        }
+        is RequestResult.NonSuccess -> _state.value = _state.value.copy(dialogs = _state.value.dialogs.copy(networkError = true))
+        is RequestResult.RetryableNetworkError -> _state.value = _state.value.copy(dialogs = _state.value.dialogs.copy(networkError = true))
+        is RequestResult.ApplicationError -> _state.value = _state.value.copy(dialogs = _state.value.dialogs.copy(unknownError = true))
+      }
+    }
+  }
+
+  private suspend fun reserveCurrentDraft(stateEmitter: (apply: (AddUsernameState) -> AddUsernameState) -> Unit) {
+    val draft = _state.value
+    reserve(draft.username.trim(), draft.discriminator.trim(), stateEmitter)
+  }
+
+  /**
+   * Apply a result to whatever the state is *now*, rather than to a snapshot taken before the network call.
+   *
+   * Reservations settle after the user has usually carried on typing, so results are always folded into the live state.
+   */
+  private fun applyState(transform: (AddUsernameState) -> AddUsernameState) {
+    _state.value = transform(_state.value)
+  }
+
+  /**
+   * Reserve a specific `nickname.discriminator`, if it is well formed.
+   *
+   * [stateEmitter] is handed the *live* state, and results are applied through it rather than through the snapshot this
+   * call started with. A slow response therefore can't overwrite something the user has typed since, and if the draft no
+   * longer matches what we asked the service about, the response is dropped instead of being written into an unrelated
+   * draft.
+   */
+  private suspend fun reserve(
+    nickname: String,
+    discriminator: String,
+    stateEmitter: (apply: (AddUsernameState) -> AddUsernameState) -> Unit
+  ) {
+    if (nickname.isBlank() || discriminator.isBlank()) {
+      return
+    }
+
+    if (UsernameUtil.checkNickname(nickname) != null) {
+      stateEmitter { it.copy(validationError = AddUsernameState.ValidationError.NicknameInvalid, isReserving = false, reservation = null, isSubmittable = false) }
+      return
+    }
+
+    if (UsernameUtil.checkDiscriminator(discriminator) != null) {
+      stateEmitter { it.copy(validationError = AddUsernameState.ValidationError.DiscriminatorInvalid, isReserving = false, reservation = null, isSubmittable = false) }
+      return
+    }
+
+    stateEmitter { it.copy(isReserving = true, validationError = null) }
+
+    val candidate = Username("$nickname.$discriminator")
+    val accountEntropyPool = flowState.accountEntropyPool
+    if (accountEntropyPool == null) {
+      stateEmitter { it.copy(isReserving = false) }
+      return
+    }
+
+    when (val result = repository.reserveUsername(candidate.username, accountEntropyPool)) {
+      is RequestResult.Success -> {
+        // The service hands back the pairing it is actually holding, which is the only one we may confirm — and only
+        // while the user is still looking at the pairing we asked about.
+        val reserved = result.result
+        val matchesCandidate = reserved.discriminator == discriminator && reserved.username.substringBeforeLast('.') == nickname
+        stateEmitter { live ->
+          if (live.username.trim() != nickname || live.discriminator.trim() != discriminator) {
+            Log.i(TAG, "The reservation arrived after the draft moved on; dropping it.")
+            live.copy(isReserving = false)
+          } else {
+            live.copy(reservation = reserved, isReserving = false, isSubmittable = matchesCandidate, validationError = null)
+          }
+        }
+      }
+      is RequestResult.NonSuccess -> {
+        when (val error = result.error) {
+          ReserveUsernameError.NotAvailable -> stateEmitter { it.copy(isReserving = false, isSubmittable = false, reservation = null, validationError = AddUsernameState.ValidationError.AlreadyTaken) }
+          ReserveUsernameError.NicknameInvalid -> stateEmitter { it.copy(isReserving = false, isSubmittable = false, reservation = null, validationError = AddUsernameState.ValidationError.NicknameInvalid) }
+          ReserveUsernameError.RateLimited -> stateEmitter { it.copy(isReserving = false, isSubmittable = false, reservation = null, dialogs = it.dialogs.copy(networkError = true)) }
+        }
+      }
+      is RequestResult.RetryableNetworkError -> stateEmitter { it.copy(isReserving = false, isSubmittable = false, dialogs = it.dialogs.copy(networkError = true)) }
+      is RequestResult.ApplicationError -> stateEmitter { it.copy(isReserving = false, isSubmittable = false, dialogs = it.dialogs.copy(unknownError = true)) }
+    }
+  }
+
+  /** Take ownership of the reserved username, then close out registration. */
+  private suspend fun confirm(
+    state: AddUsernameState,
+    parentEventEmitter: (RegistrationFlowEvent) -> Unit,
+    stateEmitter: (AddUsernameState) -> Unit
+  ) {
+    val reservation = state.reservation
+    val accountEntropyPool = flowState.accountEntropyPool
+    if (!state.isSubmittable || reservation == null || accountEntropyPool == null) {
+      Log.i(TAG, "Refusing to confirm a username that isn't reserved.")
+      return
+    }
+
+    settleJob?.cancel()
+    stateEmitter(state.copy(isReserving = true, showSpinner = true, dialogs = state.dialogs.copy(confirmSkip = false)))
+
+    when (val result = repository.confirmUsername(reservation, accountEntropyPool)) {
+      is RequestResult.Success -> finalize(state, result.result, parentEventEmitter, stateEmitter)
+      is RequestResult.NonSuccess -> {
+        stateEmitter(state.copy(isReserving = false, showSpinner = false))
+        when (val error = result.error) {
+          ConfirmUsernameError.NotAvailable, ConfirmUsernameError.ReservationInvalid -> {
+            // The reservation went stale. Keep the draft so the user can pick a different discriminator.
+            Log.i(TAG, "The username reservation is no longer valid; the draft is kept.")
+            stateEmitter(_state.value.copy(reservation = null, isSubmittable = false, validationError = AddUsernameState.ValidationError.AlreadyTaken))
+          }
+          ConfirmUsernameError.RateLimited -> stateEmitter(_state.value.copy(dialogs = _state.value.dialogs.copy(networkError = true)))
+          ConfirmUsernameError.BadRequest, ConfirmUsernameError.GenerationFailed -> stateEmitter(_state.value.copy(dialogs = _state.value.dialogs.copy(unknownError = true)))
+        }
+      }
+      is RequestResult.RetryableNetworkError -> stateEmitter(state.copy(isReserving = false, showSpinner = false, dialogs = state.dialogs.copy(networkError = true)))
+      is RequestResult.ApplicationError -> stateEmitter(state.copy(isReserving = false, showSpinner = false, dialogs = state.dialogs.copy(unknownError = true)))
+    }
+  }
+
+  /**
+   * Tell the service we're done, then — and only then — announce that registration is complete.
+   *
+   * A failed finalization leaves the user on this screen with their draft intact. Registration never reports success on
+   * the strength of a local decision alone.
+   */
+  private suspend fun finalize(
+    state: AddUsernameState,
+    username: Username?,
+    parentEventEmitter: (RegistrationFlowEvent) -> Unit,
+    stateEmitter: (AddUsernameState) -> Unit
+  ) {
+    stateEmitter(state.copy(showSpinner = true, dialogs = state.dialogs.copy(confirmSkip = false)))
+
+    when (repository.finalizeRegistration(username)) {
+      is RequestResult.Success -> {
+        Log.i(TAG, "Registration finalized. Username: ${username?.username ?: "<none>"}")
+        stateEmitter(state.copy(showSpinner = false, isReserving = false))
+        parentEventEmitter(RegistrationFlowEvent.RegistrationComplete)
+      }
+      is RequestResult.NonSuccess -> stateEmitter(state.copy(showSpinner = false, isReserving = false, dialogs = state.dialogs.copy(unknownError = true)))
+      is RequestResult.RetryableNetworkError -> stateEmitter(state.copy(showSpinner = false, isReserving = false, dialogs = state.dialogs.copy(networkError = true)))
+      is RequestResult.ApplicationError -> stateEmitter(state.copy(showSpinner = false, isReserving = false, dialogs = state.dialogs.copy(unknownError = true)))
+    }
+  }
+
+  class Factory(
+    private val repository: RegistrationRepository,
+    private val flowState: RegistrationFlowState,
+    private val parentEventEmitter: (RegistrationFlowEvent) -> Unit
+  ) : ViewModelProvider.Factory {
+    @Suppress("UNCHECKED_CAST")
+    override fun <T : ViewModel> create(modelClass: Class<T>): T {
+      return AddUsernameViewModel(repository, flowState, parentEventEmitter) as T
+    }
+  }
+}
