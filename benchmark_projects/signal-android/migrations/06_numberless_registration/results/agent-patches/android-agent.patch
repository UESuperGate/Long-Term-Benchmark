+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.registration.util
+
+import android.content.Context
+import androidx.credentials.CreatePasswordRequest
+import androidx.credentials.CredentialManager
+import androidx.credentials.GetCredentialRequest
+import androidx.credentials.GetPasswordOption
+import androidx.credentials.PasswordCredential
+import androidx.credentials.exceptions.CreateCredentialCancellationException
+import androidx.credentials.exceptions.CreateCredentialInterruptedException
+import androidx.credentials.exceptions.CreateCredentialProviderConfigurationException
+import androidx.credentials.exceptions.GetCredentialException
+import org.signal.core.models.ServiceId
+import org.signal.core.models.ServiceId.ACI
+import org.signal.core.util.logging.Log
+
+/**
+ * Saves and reads back the Signal Login credential through whatever password manager the device offers.
+ *
+ * The read-back half is the point. [saveCredential] reporting success only means the provider accepted the write, so
+ * callers must follow up with [getCredential] and compare what actually comes back before treating the credential as
+ * safely stored. Anything that isn't an exact match — a cancel, an interruption, a provider that silently declined, or
+ * a stale entry for a different account — counts as "not saved".
+ */
+class SignalCredentialManager(
+  private val context: Context,
+  private val credentialManager: CredentialManager = CredentialManager.create(context)
+) {
+
+  companion object {
+    private val TAG = Log.tag(SignalCredentialManager::class)
+
+    /** Where the Signal Login credential lives in the password manager. */
+    const val CREDENTIAL_ID = "org.thoughtcrime.securesms:signal_login"
+  }
+
+  /** Whether the device offers a password manager at all. */
+  fun isAvailable(): Boolean = try {
+    credentialManager.isAvailable(context)
+  } catch (e: Exception) {
+    Log.w(TAG, "Couldn't determine whether a password manager is available.", e)
+    false
+  }
+
+  /** A credential as it came back out of the password manager. */
+  data class SignalCredential(val username: String, val password: String)
+
+  /** The outcome of trying to save. Nothing here is ever "confirmed" — see [getCredential]. */
+  sealed interface SaveResult {
+    /** The provider accepted the write. Still needs a read-back to be trusted. */
+    data object Saved : SaveResult
+
+    /** The user dismissed the provider's sheet. Not an error, but definitely not saved either. */
+    data object Cancelled : SaveResult
+
+    /** The provider can't save credentials at all, or the write failed. */
+    data class Failed(val error: Throwable? = null) : SaveResult
+  }
+
+  /**
+   * Write [username]/[password] to the password manager.
+   *
+   * [username] is the ACI in the same uppercase form the user is looking at, and [password] is the recovery key in its
+   * display form, so what lands in the password manager is exactly what the user was shown.
+   */
+  suspend fun saveCredential(username: String, password: String): SaveResult = try {
+    credentialManager.createCredential(
+      context = context,
+      request = CreatePasswordRequest(
+        id = CREDENTIAL_ID,
+        password = password,
+        preferImmediatelyAvailableCredentials = true,
+        isAutoSelectAllowed = true
+      )
+    )
+    Log.i(TAG, "The password manager accepted the Signal Login credential.")
+    SaveResult.Saved
+  } catch (_: CreateCredentialCancellationException) {
+    Log.i(TAG, "The user cancelled the password manager save.")
+    SaveResult.Cancelled
+  } catch (_: CreateCredentialInterruptedException) {
+    Log.i(TAG, "The password manager save was interrupted.")
+    SaveResult.Failed()
+  } catch (_: CreateCredentialProviderConfigurationException) {
+    Log.i(TAG, "The password manager can't save credentials.")
+    SaveResult.Failed()
+  } catch (e: Exception) {
+    Log.w(TAG, "The password manager save failed.", e)
+    SaveResult.Failed(e)
+  }
+
+  /**
+   * Read the stored credential back, filtered to [accountId].
+   *
+   * Returns null whenever anything at all is off: no provider, no stored entry, an exception, or an entry whose
+   * username isn't the account we asked about. Callers treat null exactly like a mismatch.
+   */
+  suspend fun getCredential(accountId: ACI): SignalCredential? = try {
+    val response = credentialManager.getCredential(
+      context = context,
+      request = GetCredentialRequest(options = listOf(GetPasswordOption()))
+    )
+    val credential = response.credential as? PasswordCredential
+    if (credential == null) {
+      Log.w(TAG, "The password manager returned something that isn't a username/password credential.")
+      null
+    } else if (ServiceId.ACI.parseOrNull(credential.id) != accountId) {
+      Log.w(TAG, "The password manager returned a credential for a different account.")
+      null
+    } else {
+      SignalCredential(username = credential.id, password = credential.password)
+    }
+  } catch (_: GetCredentialException) {
+    // Includes the provider being unavailable and the user dismissing the sheet.
+    Log.i(TAG, "Couldn't read a credential back from the password manager.")
+    null
+  } catch (e: Exception) {
+    Log.w(TAG, "Reading the credential back failed.", e)
+    null
+  }
+}
