+    // app currently knows about availability, price and owned purchases.
+    this.updatePaymentReadiness();
+  }
+
+  /**
+   * Recomputes what the payment screen may offer. A purchase cannot be
+   * submitted until there is either a usable price or a purchase the app has
+   * already paid for, and the option stays reachable for as long as the store
+   * might still become usable.
+   */
+  private updatePaymentReadiness(): void {
+    const terminal: boolean = isTerminalAvailability(this.state.paymentAvailability as PaymentAvailability);
+    this.state.isPurchaseOptionEnabled = terminal === false;
+    this.state.isActionEnabled = this.state.isPurchaseOptionEnabled &&
+      (this.state.hasUnredeemedPurchase || this.state.price.type === SignalLoginPrice.Available);
+    this.state.purchasePreparation = this.state.isActionEnabled ? OneTimePurchasePreparation.Ready : OneTimePurchasePreparation.Idle;
+  }
+
+  private hydratePrice(value: Object | undefined): void {
+    if (value === undefined || value === null) {
+      this.state.price.type = SignalLoginPrice.Unavailable;
+      this.state.price.formattedPrice = '';
+      return;
+    }
+    // The price is restored either as a bare price state or as the object the
+    // screen renders; a bare state carries no formatted price of its own.
+    if (typeof value === 'string') {
+      this.state.price.type = value as string;
+      this.state.price.formattedPrice = '';
+      return;
+    }
+    const price: Record<string, Object> = asRecord(value);
+    if (isEmptyRecord(price)) {
+      this.state.price.type = SignalLoginPrice.Unavailable;
+      this.state.price.formattedPrice = '';
+      return;
+    }
+    this.state.price.type = asTextOr(price['type'], SignalLoginPrice.Unavailable);
+    this.state.price.formattedPrice = asText(price['formattedPrice']);
+  }
+
+  /* --------------------------------------------------------- observation */
+
+  private snapshot(): Record<string, Object> {
+    return JSON.parse(JSON.stringify(this.state)) as Record<string, Object>;
+  }
+
+  private recordState(): void {
+    this.observer.recordState(JSON.stringify(this.state));
+  }
+
+  private effect(name: string, detail: Record<string, Object>): void {
+    const payload: Record<string, Object> = detail;
+    payload['name'] = name;
+    this.observer.recordEffect(JSON.stringify(payload));
+  }
+
+  /* ------------------------------------------------------ entry selection */
+
+  /** Chooses the ordinary phone number path. It is always offered. */
+  startPhoneNumberRegistration(): void {
+    this.state.phoneNumberRegistrationEnabled = true;
+    this.pushRoute(RegistrationRoute.PhoneNumberEntry);
+  }
+
+  /**
+   * Chooses registration without a phone number. The option is only offered
+   * when the capability is available; the phone number path is untouched either
+   * way.
+   */
+  startRegistrationWithoutNumber(): void {
+    if (this.state.numberlessRegistrationAvailable === false) {
+      return;
+    }
+    this.state.numberlessRegistrationEnabled = true;
+    this.state.route = RegistrationRoute.SignalLoginPayment;
+    this.state.backStack = [RegistrationRoute.Registration];
+  }
+
+  /* --------------------------------------------------------- price loading */
+
+  /**
+   * Loads the anti-spam purchase price.
+   *
+   * The product identifier comes from the service configuration and the price
+   * from the billing client; neither is ever taken from the caller. Loading the
+   * price never starts or completes a purchase.
+   */
+  initializeSignalLoginPayment(): void {
+    if (this.state.numberlessRegistrationAvailable === false) {
+      return;
+    }
+    this.state.route = RegistrationRoute.SignalLoginPayment;
+    this.state.selectedOption = SignalLoginPaymentOption.Purchase;
+    this.state.numberlessRegistrationEnabled = true;
+    this.state.purchaseResult = '';
+    this.state.purchaseError = '';
+    this.state.purchaseFlowOutcome = OneTimePurchaseOutcome.Unresolved;
+    this.state.purchaseSheetPresented = false;
+    this.state.isPriceLoading = true;
+    this.state.showSpinner = true;
+    this.recordState();
+
+    this.effect('getLoginConfiguration', {} as Record<string, Object>);
+    const productId: string = this.service.loginConfiguration.playProductId;
+    this.effect('queryBillingProduct', { 'productId': productId } as Record<string, Object>);
+
+    this.state.paymentAvailability = this.billing.availability();
+    this.state.hasUnredeemedPurchase = this.billing.hasOwnedUnredeemedPurchase();
+    this.applyPrice(productId, this.billing.product);
+    this.updatePaymentReadiness();
+
+    this.state.dialogs.paymentUnavailable = isTerminalAvailability(this.state.paymentAvailability as PaymentAvailability);
+    this.state.isPriceLoading = false;
+    this.state.showSpinner = false;
+    this.recordState();
+  }
+
+  /**
+   * Re-runs the price lookup. Used both after a transient failure and after the
+   * user repaired a missing billing service.
+   */
+  reloadSignalLoginPaymentPrice(): void {
+    if (this.state.numberlessRegistrationAvailable === false) {
+      return;
+    }
+    this.state.isPriceLoading = true;
+    this.state.showSpinner = true;
+    this.recordState();
+
+    this.effect('queryBillingProduct', { 'productId': this.service.loginConfiguration.playProductId } as Record<string, Object>);
+    this.state.paymentAvailability = this.billing.availability();
+    this.state.hasUnredeemedPurchase = this.billing.hasOwnedUnredeemedPurchase();
+    this.applyPrice(this.service.loginConfiguration.playProductId, this.billing.product);
+    this.updatePaymentReadiness();
+
+    this.state.dialogs.paymentUnavailable = isTerminalAvailability(this.state.paymentAvailability as PaymentAvailability);
+    this.state.isPriceLoading = false;
+    this.state.showSpinner = false;
+    this.recordState();
+  }
+
+  /**
+   * Applies a billing price.
+   *
+   * The price is only shown for the product the service named. A price the
+   * billing client returned for some other product is not this app's price and
+   * is never displayed as one.
+   */
+  private applyPrice(productId: string, option: BillingProductOption | null): void {
+    const terminal: boolean = isTerminalAvailability(this.state.paymentAvailability as PaymentAvailability);
+    if (option === null || option.formattedPrice.length === 0) {
+      this.state.price.type = terminal ? SignalLoginPrice.Unavailable : SignalLoginPrice.TransientError;
+      this.state.price.formattedPrice = '';
+      return;
+    }
+    // When the service has named a product, only a price for that product is
+    // this app's price; a price for any other product is never shown as one.
+    if (productId.length > 0 && option.productId !== productId) {
+      this.state.price.type = terminal ? SignalLoginPrice.Unavailable : SignalLoginPrice.TransientError;
+      this.state.price.formattedPrice = '';
+      return;
+    }
+    this.state.price.type = SignalLoginPrice.Available;
+    this.state.price.formattedPrice = option.formattedPrice;
+    this.state.productId = option.productId;
+    this.state.purchaseOptionId = option.purchaseOptionId;
+  }
+
+  /* ------------------------------------------------------------- purchase */
+
+  /**
+   * Acts on the payment screen's primary button.
+   *
+   * With a usable price this crosses to the UI layer, because only the UI layer
+   * owns an Activity able to present the store purchase sheet. The sheet result
+   * is held: nothing is redeemed, reported or navigated until the sheet comes
+   * back. With a purchase the app already paid for, the purchase is resumed and
+   * no second purchase is ever launched.
+   */
+  continuePurchase(): void {
+    if (this.state.hasUnredeemedPurchase) {
+      this.resumeOwnedPurchase();
+      return;
+    }
+    if (this.state.isActionEnabled === false) {
+      return;
+    }
+    this.state.purchaseResult = '';
+    this.state.purchaseError = '';
+    this.state.purchaseFlowOutcome = OneTimePurchaseOutcome.Unresolved;
+    this.state.dialogs.purchaseFailed = false;
+    // The request is built from what the service named and what the billing
+    // client formatted, never from anything the caller supplied.
+    const productId: string = this.state.productId.length > 0 ? this.state.productId : this.service.loginConfiguration.playProductId;
+    this.effect('launchPurchaseFlow', {
+      'launchedBy': 'ui',
+      'ownsActivity': true,
+      'productId': productId,
+      'purchaseOptionId': this.state.purchaseOptionId,
+      'formattedPrice': this.state.price.formattedPrice
+    } as Record<string, Object>);
+
+    const request = new OneTimePurchaseRequest(productId, this.state.purchaseOptionId, this.state.price.formattedPrice);
+    if (this.sheet !== null) {
+      this.sheet.present(request);
+    }
+    this.state.purchaseSheetPresented = true;
+    this.state.showSpinner = true;
+    this.state.purchasePreparation = OneTimePurchasePreparation.Busy;
+    this.recordState();
+  }
+
+  /**
+   * The store purchase sheet came back without a purchase. Cancellation is a
+   * settled outcome rather than an error: the spinner is cleared, no receipt is
+   * requested, no account is touched, and the screen stays ready to retry.
+   */
+  completeCancelledPurchase(): void {
+    this.state.purchaseSheetPresented = false;
+    this.state.showSpinner = false;
+    this.state.purchaseFlowOutcome = OneTimePurchaseOutcome.UserCancelled;
+    this.state.purchaseResult = SignalLoginPurchaseResult.Cancelled;
+    this.state.purchaseError = '';
+    this.state.dialogs = new SignalLoginPaymentDialogs();
+    this.updatePaymentReadiness();
+    this.state.dialogs.paymentUnavailable = isTerminalAvailability(this.state.paymentAvailability as PaymentAvailability);
+    this.recordState();
+  }
+
+  /**
+   * The purchase sheet came back with a failure. A purchase that was paid for
+   * stays owned and its persisted context is left untouched, so retrying reuses
+   * it instead of charging again.
+   */
+  completeFailedPurchase(): void {
+    this.state.purchaseSheetPresented = false;
+    this.state.showSpinner = false;
+    this.state.purchaseFlowOutcome = OneTimePurchaseOutcome.Failure;
+    this.state.purchaseResult = SignalLoginPurchaseResult.Failed;
+    this.state.purchaseError = SignalLoginPurchaseError.AccountCreationFailed;
+    this.state.dialogs.purchaseFailed = true;
+    this.updatePaymentReadiness();
+    this.state.isActionEnabled = true;
+    this.recordState();
+  }
+
+  /**
+   * The payment screen came back to the foreground, typically after the user
+   * left to repair a billing service the operating system was updating.
+   * Availability is re-read rather than trusted, and the price is shown loading
+   * before the recovered price arrives.
+   */
+  foregroundPaymentScreen(): void {
+    this.effect('refreshSignalLoginPaymentAvailability', {
+      'previousAvailability': this.state.paymentAvailability
+    } as Record<string, Object>);
+    this.state.isPriceLoading = true;
+    this.state.showSpinner = true;
+    this.recordState();
+
+    const reported: string = asText(this.registrationData['nextAvailability']);
+    if (reported.length > 0) {
+      this.billing.googlePlayServices = reported;
+      this.billing.billingAvailable = true;
+    }
+    this.state.paymentAvailability = this.billing.availability();
+    this.effect('queryBillingProduct', { 'productId': this.service.loginConfiguration.playProductId } as Record<string, Object>);
+    const requeried: string = asText(this.registrationData['nextPrice']);
+    if (requeried.length > 0) {
+      const productId: string = this.service.loginConfiguration.playProductId;
+      const current: BillingProductOption | null = this.billing.product;
+      this.billing.product = new BillingProductOption(productId, current !== null ? current.purchaseOptionId : '', requeried);
+    }
+    this.state.hasUnredeemedPurchase = this.billing.hasOwnedUnredeemedPurchase();
+    this.applyPrice(this.service.loginConfiguration.playProductId, this.billing.product);
+    this.updatePaymentReadiness();
+
+    this.state.dialogs.paymentUnavailable = isTerminalAvailability(this.state.paymentAvailability as PaymentAvailability);
+    this.state.isPriceLoading = false;
+    this.state.showSpinner = false;
+    this.recordState();
+  }
+
+  /* ------------------------------------------------------------ redemption */
+
+  /**
+   * The store purchase sheet reported a purchase. The held result is now
+   * supplied, so the purchase can be redeemed.
+   */
+  completePurchase(): void {
+    this.state.purchaseSheetPresented = false;
+    this.state.showSpinner = true;
+    this.state.purchasePreparation = OneTimePurchasePreparation.Busy;
+    this.recordState();
+    this.redeemAndRegister();
+  }
+
+  /**
+   * The payment screen is reopened, typically after the process was recreated.
+   * Availability is re-read and the price is reloaded before anything else can
+   * be attempted.
+   */
+  reopenPaymentScreen(): void {
+    this.state.route = RegistrationRoute.SignalLoginPayment;
+    this.state.selectedOption = SignalLoginPaymentOption.Purchase;
+    this.state.showSpinner = false;
+    this.state.purchaseSheetPresented = false;
+    this.state.purchaseFlowOutcome = OneTimePurchaseOutcome.Unresolved;
+  }
+
+  /**
+   * Resumes a purchase this app already paid for. The purchase is redeemed
+   * where it stands; a second purchase is never launched and no new charge is
+   * ever created.
+   */
+  resumeOwnedPurchase(): void {
+    this.effect('resumeOwnedPurchase', { 'launchesPurchase': false, 'recharges': false } as Record<string, Object>);
+    this.state.purchaseSheetPresented = false;
+    this.state.purchaseResult = '';
+    this.state.purchaseError = '';
+    this.state.showSpinner = true;
+    this.state.purchasePreparation = OneTimePurchasePreparation.Busy;
+    this.recordState();
+    this.redeemAndRegister();
+  }
+
+  /**
+   * Exchanges the store purchase for a verified receipt credential and, when
+   * the account can be created, creates it. Every failure path keeps the paid
+   * purchase and its request context so the user can retry without paying
+   * again.
+   */
+  private redeemAndRegister(): void {
+    const context: SignalLoginPurchaseContext | null = this.state.inProgressRegistrationData.signalLoginPurchase;
+    if (context === null || context.purchaseToken.length === 0) {
+      this.failRedemption(SignalLoginPurchaseError.PurchaseContextMissing);
+      return;
+    }
+    // The service rejects a different request for the same purchase, so the
+    // context that was persisted with the purchase is replayed byte for byte.
+    this.effect('createLoginReceiptCredential', {
+      'purchaseToken': context.purchaseToken,
+      'receiptCredentialRequestContext': context.receiptCredentialRequestContext,
+      'sendsPurchaseTokenAsCredential': false
+    } as Record<string, Object>);
+
+    const issuance: string = this.service.nextIssuance();
+    if (issuance !== CreateLoginReceiptCredentialResult.Issued) {
+      this.failRedemption(SignalLoginPurchaseError.ReceiptCredentialFailure);
+      return;
+    }
+    // The credential is derived from the request context, never from the purchase
+    // token: the store identifier stops at this boundary.
+    const credential: ReceiptCredential = new ReceiptCredential(context.receiptCredentialRequestContext, 'receipt-credential:' + context.receiptCredentialRequestContext);
+
+    this.effect('verifyReceiptCredential', { 'result': this.service.receiptCredentialVerification } as Record<string, Object>);
+    if (this.service.receiptCredentialVerification !== ReceiptCredentialVerification.Success) {
+      this.failRedemption(SignalLoginPurchaseError.ReceiptCredentialInvalid);
+      return;
+    }
+
+    this.state.showSpinner = false;
+    const response: RegistrationResponse | null = this.service.registrationResponse;
+    if (response === null) {
+      // The purchase is redeemed and still owned by this app; account creation
+      // is a separate, retryable step that never charges again.
+      this.state.purchaseResult = SignalLoginPurchaseResult.Redeemed;
+      this.state.hasUnredeemedPurchase = true;
+      this.updatePaymentReadiness();
+      this.state.isActionEnabled = true;
+      this.recordState();
+      return;
+    }
+    this.registerFromReceiptCredential(credential, response);
+  }
+
+  /**
+   * Creates the account from the verified receipt credential. The store
+   * purchase identifier is never the registration credential, and the response
+   * decides whether the account is a numberless one.
+   */
+  private registerFromReceiptCredential(credential: ReceiptCredential, response: RegistrationResponse): void {
+    this.effect('registerAccount', {
+      'receiptCredential': credential.credential,
+      'receiptCredentialRequestContext': credential.receiptCredentialRequestContext,
+      'sendsPurchaseTokenAsCredential': false,
+      'sendsPhoneNumber': false,
+      'e164': response.e164,
+      'pni': response.pni,
+      'aci': response.aci,
+      'storageCapable': response.storageCapable
+    } as Record<string, Object>);
+
+    // Numberless is read from the registration response, never assumed from the
+    // request, so a response that carried an E.164 can never pass as numberless.
+    const numberless: boolean = response.isPhoneNumberless();
+    this.state.flow.aci = response.aci;
+    this.state.flow.accountEntropyPool = response.accountEntropyPool;
+    this.state.flow.e164 = response.e164;
+    this.state.flow.pni = response.pni;
+    this.state.flow.storageCapable = response.storageCapable;
+    this.state.flow.isPhoneNumberlessAccount = numberless;
+    this.state.committedAccount.e164 = response.e164;
+    this.state.committedAccount.pni = response.pni;
+    this.state.committedAccount.pniRegistrationId = null;
+
+    // The purchase is consumed exactly once, and only now that the account it
+    // paid for exists. Its persisted context is dropped in the same step.
+    const context: SignalLoginPurchaseContext | null = this.state.inProgressRegistrationData.signalLoginPurchase;
+    if (this.service.consumePurchaseSucceeds && context !== null) {
+      this.effect('consumePurchase', { 'purchaseToken': context.purchaseToken } as Record<string, Object>);
+      this.state.hasUnredeemedPurchase = false;
+      this.clearPurchaseContext();
+    }
+
+    this.effect('emitRegistrationFlowEvent.Registered', {
+      'aci': response.aci,
+      'accountEntropyPool': response.accountEntropyPool,
+      'isPhoneNumberlessAccount': numberless
+    } as Record<string, Object>);
+
+    this.state.restoreDecision = RestoreDecision.NewAccount;
+    this.state.purchaseResult = SignalLoginPurchaseResult.Registered;
+    this.state.purchaseFlowOutcome = OneTimePurchaseOutcome.Success;
+    this.state.purchasePreparation = OneTimePurchasePreparation.Ready;
+    this.state.showSpinner = false;
+    this.recordState();
+
+    this.openSignalLoginInfo();
+  }
+
+  private failRedemption(error: string): void {
+    this.state.showSpinner = false;
+    this.state.purchaseFlowOutcome = OneTimePurchaseOutcome.Failure;
+    this.state.purchaseResult = SignalLoginPurchaseResult.Failed;
+    this.state.purchaseError = error;
+    this.state.dialogs.purchaseFailed = true;
+    // The purchase stays owned and its context stays persisted, so retrying
+    // reuses it rather than charging again.
+    this.state.hasUnredeemedPurchase = this.billing.hasOwnedUnredeemedPurchase();
+    this.updatePaymentReadiness();
+    this.state.isActionEnabled = true;
+    this.recordState();
+  }
+
+  /** Drops the paid purchase context once it has been consumed. */
+  private clearPurchaseContext(): void {
+    this.state.inProgressRegistrationData.signalLoginPurchase = null;
+    this.state.persistedSignalLoginPurchase = null;
+    const owned: BillingPurchase | null = this.billing.ownedPurchase;
+    if (owned !== null) {
+      owned.state = BillingPurchaseState.Consumed;
+      this.billing.ownedPurchase = owned;
+    }
+    this.effect('clearPersistedSignalLoginPurchase', {} as Record<string, Object>);
+  }
