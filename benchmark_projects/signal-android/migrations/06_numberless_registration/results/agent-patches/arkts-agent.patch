+    const readback: Record<string, Object> = asRecord(given['readbackCredential']);
+    const retrieved: Record<string, Object> = asRecord(given['savedCredentialRetrieved']);
+    const stored: Record<string, Object> = asRecord(given['passwordManagerStoredCredential']);
+    if (isEmptyRecord(readback) === false) {
+      this.credentialManager.seed(UsernamePasswordCredential.fromJson(readback));
+    } else if (isEmptyRecord(retrieved) === false) {
+      this.credentialManager.seed(UsernamePasswordCredential.fromJson(retrieved));
+    } else if (isEmptyRecord(stored) === false) {
+      this.credentialManager.seed(UsernamePasswordCredential.fromJson(stored));
+    }
