--- /dev/null
+++ b/entry/src/main/ets/feature/Json.ts
@@ -0,0 +1,73 @@
+/**
+ * Small helpers for reading loosely typed JSON payloads.
+ *
+ * Registration state is exchanged with the platform as JSON (preferences blob,
+ * navigation state, service responses) so every boundary converts through the
+ * functions below instead of scattering casts around the flow.
+ */
+
+/** Parses a JSON document into a property bag. */
+export function jsonRecord(source: string): Record<string, Object> {
+  if (source.length === 0) {
+    return {} as Record<string, Object>;
+  }
+  return JSON.parse(source) as Record<string, Object>;
+}
+
+/** Reads a member of a property bag as text, tolerating missing or non text members. */
+export function asText(value: Object | undefined): string {
+  if (value === undefined || value === null) {
+    return '';
+  }
+  if (typeof value === 'string') {
+    return value as string;
+  }
+  return JSON.stringify(value);
+}
+
+/** Reads a member of a property bag as a boolean, accepting the usual textual spellings. */
+export function asFlag(value: Object | undefined): boolean {
+  if (value === undefined || value === null) {
+    return false;
+  }
+  if (typeof value === 'boolean') {
+    return value as boolean;
+  }
+  const text: string = asText(value);
+  return text === 'true' || text === '1';
+}
+
+/** Reads a nested property bag, returning an empty bag when the member is absent. */
+export function asRecord(value: Object | undefined): Record<string, Object> {
+  if (value === undefined || value === null) {
+    return {} as Record<string, Object>;
+  }
+  if (typeof value === 'object') {
+    return value as Record<string, Object>;
+  }
+  // A bare scalar is not a property bag; treating it as one would silently
+  // produce members that were never there.
+  return {} as Record<string, Object>;
+}
+
+/** True when a property bag carries no members at all. */
+export function isEmptyRecord(value: Record<string, Object>): boolean {
+  return JSON.stringify(value).length <= 2;
+}
+
+/** Reads a member, falling back to a default when the member is absent or blank. */
+export function asTextOr(value: Object | undefined, fallback: string): string {
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  const text: string = asText(value);
+  return text.length === 0 ? fallback : text;
+}
+
+/** Reads a boolean member, falling back to a default when the member is absent. */
+export function asFlagOr(value: Object | undefined, fallback: boolean): boolean {
+  if (value === undefined || value === null) {
+    return fallback;
+  }
+  return asFlag(value);
+}
