@@ -0,0 +1,172 @@
+/**
+ * In-app billing boundary for the one-time anti-spam purchase that backs
+ * phone-numberless Signal registration.
+ *
+ * The registration flow never talks to a store plug-in directly. It reads a
+ * {@link BillingSnapshot} that the billing client cached, and it hands a
+ * {@link OneTimePurchaseRequest} to the UI layer, because only the UI layer owns
+ * an Activity able to present the store purchase sheet.
+ */
+import { asFlag, asRecord, asText } from './Json';
+
+/** Store level availability of the billing client, as reported by the client itself. */
+export enum PaymentAvailability {
+  Unavailable = 'PaymentAvailability.Unavailable',
+  ServiceUpdating = 'PaymentAvailability.ServiceUpdating',
+  Available = 'PaymentAvailability.Available'
+}
+
+/** State of a purchase owned by this app for the anti-spam product. */
+export enum BillingPurchaseState {
+  Pending = 'BillingPurchaseState.PENDING',
+  Purchased = 'BillingPurchaseState.PURCHASED',
+  Cancelled = 'BillingPurchaseState.CANCELLED',
+  Consumed = 'BillingPurchaseState.CONSUMED',
+  Failed = 'BillingPurchaseState.FAILED'
+}
+
+/** Outcome of a one-time purchase. Unresolved means the sheet is still open. */
+export enum OneTimePurchaseOutcome {
+  Unresolved = 'OneTimePurchaseResult.Unresolved',
+  Success = 'OneTimePurchaseResult.Success',
+  Failure = 'OneTimePurchaseResult.Failure',
+  UserCancelled = 'OneTimePurchaseResult.UserCancelled'
+}
+
+/** Progress of preparing a one-time purchase, so the launch can be guarded. */
+export enum OneTimePurchasePreparation {
+  Idle = 'OneTimePurchasePreparation.Idle',
+  Ready = 'OneTimePurchasePreparation.Ready',
+  Busy = 'OneTimePurchasePreparation.Busy'
+}
+
+/** A single purchase option of a billing product, together with its store formatted price. */
+export class BillingProductOption {
+  productId: string = '';
+  purchaseOptionId: string = '';
+  formattedPrice: string = '';
+
+  constructor(productId: string, purchaseOptionId: string, formattedPrice: string) {
+    this.productId = productId;
+    this.purchaseOptionId = purchaseOptionId;
+    this.formattedPrice = formattedPrice;
+  }
+
+  /** Builds the option from a billing query response. */
+  static fromJson(value: Record<string, Object>): BillingProductOption {
+    return new BillingProductOption(asText(value['productId']), asText(value['purchaseOptionId']), asText(value['formattedPrice']));
+  }
+}
+
+/** A purchase this app owns for the anti-spam product. */
+export class BillingPurchase {
+  purchaseToken: string = '';
+  state: BillingPurchaseState = BillingPurchaseState.Pending;
+
+  constructor(purchaseToken: string, state: BillingPurchaseState) {
+    this.purchaseToken = purchaseToken;
+    this.state = state;
+  }
+
+  /** Builds a purchase from a billing query or purchase callback payload. */
+  static fromJson(value: Record<string, Object>): BillingPurchase {
+    const token: string = asText(value['purchaseToken']);
+    const state: string = asText(value['state']);
+    return new BillingPurchase(token, state.length === 0 ? BillingPurchaseState.Pending : state as BillingPurchaseState);
+  }
+
+  /** True when this purchase has been paid for and still has to be redeemed. */
+  isPaidAndUnredeemed(): boolean {
+    return this.state === BillingPurchaseState.Purchased && this.purchaseToken.length > 0;
+  }
+}
+
+/**
+ * Everything the registration flow is allowed to know about the billing client
+ * at a point in time. The snapshot is owned outside the flow so that a process
+ * recreation can rebuild the flow from it.
+ */
+export class BillingSnapshot {
+  googlePlayServices: string = PaymentAvailability.Unavailable;
+  billingAvailable: boolean = true;
+  product: BillingProductOption | null = null;
+  ownedPurchase: BillingPurchase | null = null;
+
+  /** Returns the snapshot to its initial state. */
+  reset(): void {
+    this.googlePlayServices = PaymentAvailability.Unavailable;
+    this.billingAvailable = true;
+    this.product = null;
+    this.ownedPurchase = null;
+  }
+
+  /** Derives the effective availability from the store client state. */
+  availability(): PaymentAvailability {
+    if (!this.billingAvailable) {
+      return PaymentAvailability.Unavailable;
+    }
+    const reported: string = this.googlePlayServices;
+    if (reported === PaymentAvailability.Available) {
+      return PaymentAvailability.Available;
+    }
+    if (reported === PaymentAvailability.ServiceUpdating) {
+      return PaymentAvailability.ServiceUpdating;
+    }
+    return PaymentAvailability.Unavailable;
+  }
+
+  /** True when the user may reach an owned purchase without paying again. */
+  hasOwnedUnredeemedPurchase(): boolean {
+    const owned: BillingPurchase | null = this.ownedPurchase;
+    return owned !== null && owned.isPaidAndUnredeemed();
+  }
+
+  /** Restores the snapshot from persisted or cached service state. */
+  restore(given: Record<string, Object>): void {
+    const services: string = asText(given['googlePlayServices']);
+    if (services.length > 0) {
+      this.googlePlayServices = services;
+    }
+    if (given['googlePlayBillingAvailable'] !== undefined) {
+      this.billingAvailable = asFlag(given['googlePlayBillingAvailable']);
+    }
+    const product: Record<string, Object> = asRecord(given['billingProduct']);
+    if (Object.keys(product).length > 0) {
+      this.product = BillingProductOption.fromJson(product);
+    }
+    const owned: Record<string, Object> = asRecord(given['ownedPurchase']);
+    if (Object.keys(owned).length > 0) {
+      this.ownedPurchase = BillingPurchase.fromJson(owned);
+    }
+  }
+}
+
+/** A request for the store purchase sheet. The price is owned by the store. */
+export class OneTimePurchaseRequest {
+  productId: string = '';
+  purchaseOptionId: string = '';
+  formattedPrice: string = '';
+
+  constructor(productId: string, purchaseOptionId: string, formattedPrice: string) {
+    this.productId = productId;
+    this.purchaseOptionId = purchaseOptionId;
+    this.formattedPrice = formattedPrice;
+  }
+}
+
+/**
+ * Contract of the layer that owns the Activity able to present the store
+ * purchase sheet. The flow stores a reference to it, but never implements it.
+ */
+export interface OneTimePurchaseSheet {
+  present(request: OneTimePurchaseRequest): void;
+}
+
+/**
+ * Payment availability that leaves the user without any way to reach the store.
+ * `ServiceUpdating` is deliberately not terminal: the operating system is in
+ * the middle of a remediation the user can finish, so the option stays live.
+ */
+export function isTerminalAvailability(availability: PaymentAvailability): boolean {
+  return availability === PaymentAvailability.Unavailable;
+}
