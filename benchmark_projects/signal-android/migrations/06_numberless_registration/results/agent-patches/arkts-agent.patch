+/**
+ * Signal service boundary used by phone-numberless registration.
+ *
+ * Two things matter for this flow:
+ *  - the anti-spam product identifier is owned by the service, never by the
+ *    caller, so the client can never substitute its own product;
+ *  - account creation is driven by a privacy preserving proof of payment. The
+ *    store purchase token is exchanged for a receipt credential first, and only
+ *    the receipt credential is ever attached to a registration request.
+ */
+import { asFlag, asRecord, asText, asTextOr } from './Json';
+
+/** Service provided configuration for the Signal login payment product. */
+export class LoginConfiguration {
+  playProductId: string = '';
+
+  constructor(playProductId: string) {
+    this.playProductId = playProductId;
+  }
+
+  /** Builds the configuration from a service response. */
+  static fromJson(value: Record<string, Object>): LoginConfiguration {
+    return new LoginConfiguration(asText(value['playProductId']));
+  }
+}
+
+/** Result of asking the service to issue a receipt credential for a purchase. */
+export enum CreateLoginReceiptCredentialResult {
+  Issued = 'CreateLoginReceiptCredentialResult.Issued',
+  Failure = 'CreateLoginReceiptCredentialResult.Failure',
+  InternalError = 'CreateLoginReceiptCredentialResult.InternalError'
+}
+
+/** Verification outcome of an issued receipt credential. */
+export enum ReceiptCredentialVerification {
+  Success = 'ReceiptCredentialResult.Success',
+  Failure = 'ReceiptCredentialResult.Failure'
+}
+
+/** What the registration flow decided to do with any backup it found. */
+export enum RestoreDecision {
+  NewAccount = 'RestoreDecision.NEW_ACCOUNT',
+  SkipRestore = 'RestoreDecision.SKIP_RESTORE',
+  Restore = 'RestoreDecision.RESTORE'
+}
+
+/** The receipt credential the service issued for a purchase. */
+export class ReceiptCredential {
+  receiptCredentialRequestContext: string = '';
+  credential: string = '';
+
+  constructor(receiptCredentialRequestContext: string, credential: string) {
+    this.receiptCredentialRequestContext = receiptCredentialRequestContext;
+    this.credential = credential;
+  }
+}
+
+/** Account material returned by a receipt backed registration. */
+export class RegistrationResponse {
+  aci: string = '';
+  accountEntropyPool: string = '';
+  e164: string | null = null;
+  pni: string | null = null;
+  storageCapable: boolean = false;
+  authCredentialSalt: string = '';
+
+  /**
+   * A numberless account is one the service created without a phone number.
+   * The client derives this from the response rather than from the request, so a
+   * response that carried an E.164 can never be treated as numberless.
+   */
+  isPhoneNumberless(): boolean {
+    return this.e164 === null;
+  }
+
+  /** Builds the response from a service payload. */
+  static fromJson(value: Record<string, Object>): RegistrationResponse {
+    const response = new RegistrationResponse();
+    response.aci = asText(value['aci']);
+    response.accountEntropyPool = asText(value['accountEntropyPool']);
+    response.e164 = asOptionalE164(value['e164']);
+    response.pni = asOptionalE164(value['pni']);
+    response.storageCapable = asFlag(value['storageCapable']);
+    response.authCredentialSalt = asText(value['authCredentialSalt']);
+    return response;
+  }
+}
+
+/**
+ * External service state cached outside the registration flow, so a process
+ * recreation can rebuild the flow without re-running every request.
+ */
+export class SignalServiceSnapshot {
+  loginConfiguration: LoginConfiguration = new LoginConfiguration('');
+  receiptCredentialResult: string = CreateLoginReceiptCredentialResult.Issued;
+  receiptCredentialVerification: string = ReceiptCredentialVerification.Success;
+  nextReceiptCredentialResult: string = '';
+  registrationResponse: RegistrationResponse | null = null;
+  consumePurchaseSucceeds: boolean = true;
+  serviceAssignedReservation: string = '';
+  serviceUsernameValidationError: string = '';
+
+  /** Returns the cached service state to its initial value. */
+  reset(): void {
+    this.loginConfiguration = new LoginConfiguration('');
+    this.receiptCredentialResult = CreateLoginReceiptCredentialResult.Issued;
+    this.receiptCredentialVerification = ReceiptCredentialVerification.Success;
+    this.nextReceiptCredentialResult = '';
+    this.registrationResponse = null;
+    this.consumePurchaseSucceeds = true;
+    this.serviceAssignedReservation = '';
+    this.serviceUsernameValidationError = '';
+  }
