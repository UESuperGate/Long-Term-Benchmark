@@ -0,0 +1,116 @@
+/**
+ * Credential preservation boundary.
+ *
+ * A one-time payment buys an account whose only way back in is the issued
+ * account identifier and recovery key. The client offers to hand those to the
+ * platform password manager, but never trusts that offer on the strength of the
+ * save alone: it reads the credential back, filtered by the same account, and
+ * only an exact two part match counts as safely stored.
+ */
+import { asText } from './Json';
+
+/** A username and password credential as stored by the platform password manager. */
+export class UsernamePasswordCredential {
+  type: string = 'UsernamePasswordCredential';
+  username: string = '';
+  password: string = '';
+
+  constructor(username: string, password: string) {
+    this.username = username;
+    this.password = password;
+  }
+
+  /** Builds a credential from a password manager read-back payload. */
+  static fromJson(value: Record<string, Object>): UsernamePasswordCredential {
+    return new UsernamePasswordCredential(asText(value['username']), asText(value['password']));
+  }
+
+  toJson(): Record<string, Object> {
+    return { 'type': this.type, 'username': this.username, 'password': this.password } as Record<string, Object>;
+  }
+}
+
+/** Where the password manager keeps its single Signal entry. */
+export interface CredentialStorage {
+  read(): UsernamePasswordCredential | null;
+
+  write(credential: UsernamePasswordCredential | null): void;
+
+  isAvailable(): boolean;
+}
+
+/** Normalizes an account identifier for comparison. */
+export function normalizeAccountId(value: string): string {
+  return value.trim().toUpperCase();
+}
+
+/**
+ * Normalizes a recovery key for comparison. The key is shown to the user in a
+ * grouped, space separated display form, so a read-back has to be parsed back
+ * into its compact form before it can be compared with the issued pool.
+ */
+export function normalizeRecoveryKey(value: string): string {
+  return value.replace(/[\s-]/g, '').toUpperCase();
+}
+
+/**
+ * Compares a locally entered or read-back credential with the account material
+ * the registration flow already holds.
+ *
+ * Both halves are compared, because either one may have been copied wrongly. A
+ * partial match is never a confirmation.
+ */
+export function credentialMatches(accountId: string, recoveryKey: string, enteredAccountId: string, enteredRecoveryKey: string): boolean {
+  const accountMatches: boolean = normalizeAccountId(enteredAccountId) === normalizeAccountId(accountId);
+  const keyMatches: boolean = normalizeRecoveryKey(enteredRecoveryKey) === normalizeRecoveryKey(recoveryKey);
+  return accountMatches && keyMatches && accountId.length > 0 && recoveryKey.length > 0;
+}
+
+/** Wraps the platform password manager. */
+export class SignalCredentialManager {
+  private storage: CredentialStorage;
+
+  constructor(storage: CredentialStorage) {
+    this.storage = storage;
+  }
+
+  isAvailable(): boolean {
+    return this.storage.isAvailable();
+  }
+
+  /**
+   * Records a credential the password manager already holds, for instance one
+   * written by an earlier session of this app.
+   */
+  seed(credential: UsernamePasswordCredential | null): void {
+    this.storage.write(credential);
+  }
+
+  /**
+   * Offers the issued login to the password manager. The account identifier is
+   * saved in the upper case form the user is shown, the recovery key in its
+   * display form, and the saved credential is returned to the caller so the
+   * result can be routed back to the screen that asked for it.
+   */
+  saveCredential(accountId: string, recoveryKey: string): UsernamePasswordCredential {
+    const credential = new UsernamePasswordCredential(normalizeAccountId(accountId), recoveryKey);
+    this.storage.write(credential);
+    return credential;
+  }
+
+  /**
+   * Reads the credential back. The read-back is filtered by the account the
+   * flow is currently preserving, so a credential left behind by a different
+   * account can never be mistaken for a confirmation.
+   */
+  getCredential(accountId: string): UsernamePasswordCredential | null {
+    const stored: UsernamePasswordCredential | null = this.storage.read();
+    if (stored === null) {
+      return null;
+    }
+    if (normalizeAccountId(stored.username) !== normalizeAccountId(accountId)) {
+      return null;
+    }
+    return stored;
+  }
+}
