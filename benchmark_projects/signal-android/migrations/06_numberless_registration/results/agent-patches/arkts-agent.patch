+    return configured.length > 0 ? configured : this.hasIssuance() ? this.receiptCredentialResult : CreateLoginReceiptCredentialResult.Failure;
+  }
+
+  /** Restores the cached service state. */
+  restore(given: Record<string, Object>): void {
+    const configuration: Record<string, Object> = asRecord(given['serviceLoginConfiguration']);
+    if (Object.keys(configuration).length > 0) {
+      this.loginConfiguration = LoginConfiguration.fromJson(configuration);
+    }
+    const receiptResult: string = asText(given['serviceReceiptResult']);
+    if (receiptResult.length > 0) {
+      this.receiptCredentialResult = receiptResult;
+    }
+    const nextReceiptResult: string = asText(given['nextReceiptRequestResult']);
+    if (nextReceiptResult.length > 0) {
+      this.nextReceiptCredentialResult = nextReceiptResult;
+    }
+    const verification: string = asText(given['receiptVerification']);
+    if (verification.length > 0) {
+      this.receiptCredentialVerification = verification;
+    }
+    const response: Record<string, Object> = asRecord(given['registrationResponse']);
+    if (Object.keys(response).length > 0) {
+      this.registrationResponse = RegistrationResponse.fromJson(response);
+    }
+    if (given['consumePurchaseSucceeds'] !== undefined) {
+      this.consumePurchaseSucceeds = asFlag(given['consumePurchaseSucceeds']);
+    }
+    const reservation: string = asText(given['serviceAssignedReservation']);
+    if (reservation.length > 0) {
+      this.serviceAssignedReservation = reservation;
+    }
+    const validationError: string = asTextOr(given['serviceUsernameValidationError'], asTextOr(given['nextUsernameValidationError'], ''));
+    if (validationError.length > 0) {
+      this.serviceUsernameValidationError = validationError;
+    }
+  }
+}
+
+function asOptionalE164(value: Object | undefined): string | null {
+  if (value === undefined || value === null) {
+    return null;
+  }
+  const text: string = asText(value);
+  return text.length === 0 ? null : text;
