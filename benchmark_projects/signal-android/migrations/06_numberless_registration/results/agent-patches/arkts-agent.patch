@@ -0,0 +1,1316 @@
+/**
+ * The registration flow that lets a new user create a Signal account without
+ * supplying a phone number.
+ *
+ * The flow is an ordinary registration path with one difference: instead of an
+ * SMS session it is unlocked by a one-time anti-spam purchase whose privacy
+ * preserving proof of payment is exchanged for the account. Everything else -
+ * preserving the issued login, optionally claiming a username, completing
+ * registration - behaves the way it does for any other account.
+ *
+ * The flow owns state and decisions only. I/O lives in the dependencies handed
+ * to it, so the flow can be rebuilt after a process recreation.
+ */
+import {
+  BillingProductOption,
+  BillingPurchase,
+  BillingPurchaseState,
+  BillingSnapshot,
+  OneTimePurchaseOutcome,
+  OneTimePurchasePreparation,
+  OneTimePurchaseRequest,
+  OneTimePurchaseSheet,
+  PaymentAvailability,
+  isTerminalAvailability
+} from './Billing';
+import {
+  CreateLoginReceiptCredentialResult,
+  ReceiptCredential,
+  ReceiptCredentialVerification,
+  RegistrationResponse,
+  RestoreDecision,
+  SignalServiceSnapshot
+} from './SignalService';
+import {
+  SignalCredentialManager,
+  UsernamePasswordCredential,
+  credentialMatches,
+  normalizeAccountId
+} from './CredentialManager';
+import { asFlag, asFlagOr, asRecord, asText, asTextOr, isEmptyRecord } from './Json';
+
+/* ------------------------------------------------------------------ routes */
+
+/** Destination of the registration flow. */
+export class RegistrationRoute {
+  static readonly Registration: string = 'RegistrationRoute.Registration';
+  static readonly PhoneNumberEntry: string = 'RegistrationRoute.PhoneNumberEntry';
+  static readonly SignalLoginPayment: string = 'RegistrationRoute.SignalLoginPayment';
+  static readonly SignalLoginInfo: string = 'RegistrationRoute.SignalLoginInfo';
+  static readonly SignalLoginManualSaveConfirmation: string = 'RegistrationRoute.SignalLoginManualSaveConfirmation';
+  static readonly AddUsername: string = 'RegistrationRoute.AddUsername';
+  static readonly FullyComplete: string = 'RegistrationRoute.FullyComplete';
+}
+
+/** Outcome of the one-time purchase, as the payment screen reports it. */
+export class SignalLoginPurchaseResult {
+  static readonly Registered: string = 'SignalLoginPurchaseResult.Registered';
+  static readonly Redeemed: string = 'SignalLoginPurchaseResult.Redeemed';
+  static readonly Cancelled: string = 'SignalLoginPurchaseResult.Cancelled';
+  static readonly Failed: string = 'SignalLoginPurchaseResult.Failed';
+}
+
+/** Price states of the payment screen. */
+export class SignalLoginPrice {
+  static readonly Available: string = 'SignalLoginPaymentState.Price.Available';
+  static readonly TransientError: string = 'SignalLoginPaymentState.Price.TransientError';
+  static readonly Unavailable: string = 'SignalLoginPaymentState.Price.Unavailable';
+}
+
+/** Options of the payment screen. */
+export class SignalLoginPaymentOption {
+  static readonly Purchase: string = 'SignalLoginPaymentState.Option.Purchase';
+}
+
+/** Modes of the manual credential entry screen. */
+export class SignalLoginCredentialEntryMode {
+  static readonly Enter: string = 'SignalLoginCredentialEntryState.Mode.Enter';
+  static readonly ConfirmSaved: string = 'SignalLoginCredentialEntryState.Mode.ConfirmSaved';
+}
+
+/** Errors the payment screen can report while keeping the purchase recoverable. */
+export class SignalLoginPurchaseError {
+  static readonly ReceiptCredentialFailure: string = 'SignalLoginPurchaseError.ReceiptCredentialFailure';
+  static readonly ReceiptCredentialInvalid: string = 'SignalLoginPurchaseError.ReceiptCredentialInvalid';
+  static readonly PurchaseContextMissing: string = 'SignalLoginPurchaseError.PurchaseContextMissing';
+  static readonly AccountCreationFailed: string = 'SignalLoginPurchaseError.AccountCreationFailed';
+}
+
+/** Milliseconds the username screens wait before asking the service to reserve. */
+export const RESERVATION_SETTLE_MILLISECONDS: number = 500;
+
+/* ------------------------------------------------------------------- state */
+
+/** Price as the payment screen renders it. */
+export class SignalLoginPaymentPrice {
+  type: string = SignalLoginPrice.Unavailable;
+  formattedPrice: string = '';
+}
+
+/** Dialogs the payment screen can raise. */
+export class SignalLoginPaymentDialogs {
+  paymentUnavailable: boolean = false;
+  purchaseFailed: boolean = false;
+  saveNotConfirmed: boolean = false;
+  saveFailed: boolean = false;
+  confirmSkip: boolean = false;
+}
+
+/** Account material the registration flow holds after account creation. */
+export class AccountFlowState {
+  aci: string = '';
+  accountEntropyPool: string = '';
+  e164: string | null = null;
+  pni: string | null = null;
+  storageCapable: boolean = false;
+  isPhoneNumberlessAccount: boolean = false;
+  username: string | null = null;
+}
+
+/** Identity the app committed to disk when the account was created. */
+export class CommittedAccount {
+  e164: string | null = null;
+  pni: string | null = null;
+  pniRegistrationId: number | null = null;
+}
+
+/**
+ * The purchase the app has paid for but not yet redeemed, together with the
+ * receipt credential request context the service must be asked about again. The
+ * service rejects a different request for the same purchase, so this blob is
+ * written once and replayed byte for byte.
+ */
+export class SignalLoginPurchaseContext {
+  purchaseToken: string = '';
+  receiptCredentialRequestContext: string = '';
+  productId: string = '';
+  purchaseOptionId: string = '';
+  formattedPrice: string = '';
+
+  constructor(purchaseToken: string, receiptCredentialRequestContext: string) {
+    this.purchaseToken = purchaseToken;
+    this.receiptCredentialRequestContext = receiptCredentialRequestContext;
+  }
+
+  static fromJson(value: Record<string, Object>): SignalLoginPurchaseContext {
+    const context = new SignalLoginPurchaseContext(asText(value['purchaseToken']), asText(value['receiptCredentialRequestContext']));
+    context.productId = asText(value['productId']);
+    context.purchaseOptionId = asText(value['purchaseOptionId']);
+    context.formattedPrice = asText(value['formattedPrice']);
+    return context;
+  }
+
+  toJson(): Record<string, Object> {
+    return {
+      'purchaseToken': this.purchaseToken,
+      'receiptCredentialRequestContext': this.receiptCredentialRequestContext,
+      'productId': this.productId,
+      'purchaseOptionId': this.purchaseOptionId,
+      'formattedPrice': this.formattedPrice
+    } as Record<string, Object>;
+  }
+}
+
+/** In-progress registration data the app keeps across a process recreation. */
+export class InProgressRegistrationData {
+  signalLoginPurchase: SignalLoginPurchaseContext | null = null;
+}
+
+/** The complete registration state of phone-numberless registration. */
+export class RegistrationFlowState {
+  route: string = RegistrationRoute.Registration;
+  backStack: string[] = [];
+
+  numberlessRegistrationAvailable: boolean = true;
+  numberlessRegistrationEnabled: boolean = false;
+  phoneNumberRegistrationEnabled: boolean = true;
+
+  selectedOption: string = SignalLoginPaymentOption.Purchase;
+  paymentAvailability: string = PaymentAvailability.Unavailable;
+  price: SignalLoginPaymentPrice = new SignalLoginPaymentPrice();
+  productId: string = '';
+  purchaseOptionId: string = '';
+  isPriceLoading: boolean = false;
+  showSpinner: boolean = false;
+  hasUnredeemedPurchase: boolean = false;
+  purchasePreparation: string = OneTimePurchasePreparation.Idle;
+  purchaseSheetPresented: boolean = false;
+  purchaseFlowOutcome: string = OneTimePurchaseOutcome.Unresolved;
+  purchaseResult: string = '';
+  purchaseError: string = '';
+  isPurchaseOptionEnabled: boolean = false;
+  isActionEnabled: boolean = false;
+  dialogs: SignalLoginPaymentDialogs = new SignalLoginPaymentDialogs();
+
+  flow: AccountFlowState = new AccountFlowState();
+  committedAccount: CommittedAccount = new CommittedAccount();
+  restoreDecision: string = '';
+  inProgressRegistrationData: InProgressRegistrationData = new InProgressRegistrationData();
+
+  isPasswordManagerAvailable: boolean = false;
+  showConfirmSavedSheet: boolean = false;
+  savedCredentialConfirmed: boolean = false;
+  isReadbackRequested: boolean = false;
+
+  mode: string = SignalLoginCredentialEntryMode.ConfirmSaved;
+  enteredAccountId: string = '';
+  enteredRecoveryKey: string = '';
+  areCredentialsIncorrect: boolean = false;
+  accountIdFieldIncorrect: boolean = false;
+  recoveryKeyFieldIncorrect: boolean = false;
+  isNextEnabled: boolean = false;
+
+  username: string = '';
+  discriminator: string = '';
+  isDiscriminatorUserSet: boolean = false;
+  reservation: string | null = null;
+  validationError: string | null = null;
+  isReserving: boolean = false;
+  isSubmittable: boolean = false;
+  discriminatorFieldFocused: boolean = false;
+
+  registrationComplete: boolean = false;
+  finalRegistrationCommitted: boolean = false;
+
+  persistedSignalLoginPurchase: SignalLoginPurchaseContext | null = null;
+}
+
+/* ------------------------------------------------------------- observation */
+
+/**
+ * Where the flow reports the decisions it takes. Implementation is owned by the
+ * application so the flow itself stays free of test or diagnostic plumbing.
+ */
+export interface RegistrationFlowObserver {
+  recordEffect(json: string): void;
+
+  recordState(snapshotJson: string): void;
+}
+
+/* ------------------------------------------------------------------- flow */
+
+/** Owns the state and the decisions of phone-numberless registration. */
+export class NumberlessRegistrationFlow {
+  private state: RegistrationFlowState = new RegistrationFlowState();
+  private billing: BillingSnapshot;
+  private service: SignalServiceSnapshot;
+  private credentialManager: SignalCredentialManager;
+  private observer: RegistrationFlowObserver;
+  private sheet: OneTimePurchaseSheet | null = null;
+  private registrationData: Record<string, Object> = {} as Record<string, Object>;
+  private settleHandle: number = 0;
+
+  constructor(
+    billing: BillingSnapshot,
+    service: SignalServiceSnapshot,
+    credentialManager: SignalCredentialManager,
+    observer: RegistrationFlowObserver,
+    sheet: OneTimePurchaseSheet | null
+  ) {
+    this.billing = billing;
+    this.service = service;
+    this.credentialManager = credentialManager;
+    this.observer = observer;
+    this.sheet = sheet;
+  }
+
+  /* ----------------------------------------------------------- hydration */
+
+  /**
+   * Rebuilds the flow from the application owned registration data plus the
+   * state the external services are known to be in. Nothing here decides
+   * anything; it only re-establishes what the app already knows.
+   */
+  restore(registrationData: Record<string, Object>): void {
+    this.registrationData = registrationData;
+    this.state = new RegistrationFlowState();
+    this.billing.reset();
+    this.service.reset();
+    this.hydrate(registrationData);
+  }
+
+  private hydrate(given: Record<string, Object>): void {
+    const payment: Record<string, Object> = asRecord(given['payment']);
+    const flowGiven: Record<string, Object> = asRecord(given['flow']);
+    const flow: Record<string, Object> = isEmptyRecord(flowGiven) ? asRecord(given['flowState']) : flowGiven;
+    const parentLogin: Record<string, Object> = asRecord(given['parentLogin']);
+    const entered: Record<string, Object> = asRecord(given['enteredLogin']);
+    const dialogs: Record<string, Object> = asRecord(given['dialogs']);
+
+    this.state.route = asTextOr(asTextOr(given['route'], asTextOr(given['entryRoute'], this.state.route)), this.state.route);
+    this.state.numberlessRegistrationAvailable = asFlagOr(given['phoneNumberlessRegistrationAvailable'], true);
