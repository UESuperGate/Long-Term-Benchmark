+package org.thoughtcrime.securesms.stickers
+
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flow
+import org.signal.core.util.concurrent.SignalExecutors
+import org.signal.core.util.requireNonNullString
+import org.thoughtcrime.securesms.database.AttachmentTable
+import org.thoughtcrime.securesms.database.SignalDatabase
+import org.thoughtcrime.securesms.database.StickerTable
+import org.thoughtcrime.securesms.database.model.StickerPackId
+import org.thoughtcrime.securesms.database.model.StickerPackKey
+import org.thoughtcrime.securesms.database.model.StickerPackRecord
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+import org.thoughtcrime.securesms.jobs.MultiDeviceStickerPackOperationJob
+import org.thoughtcrime.securesms.jobs.StickerPackDownloadJob
+import org.thoughtcrime.securesms.keyvalue.SignalStore
+import java.util.concurrent.Executor
+import kotlin.coroutines.resume
+import kotlin.coroutines.suspendCoroutine
+
+/**
+ * Application owned access point to the sticker packs that are known to this device.
+ *
+ * Every entry point here runs its work on the serial database executor and reports back through
+ * a callback or a [Flow]; the callers (view models, jobs and the UI) never touch the database
+ * tables directly.
+ */
+object StickerManagementRepository {
+
+  /**
+   * Emits the current sticker pack state, classified into installed, official ("blessed") and
+   * other available packs while preserving the order the repository returns them in.
+   *
+   * [StickerPacksResult.sortOrderByPackId] carries the position of each pack in that order so
+   * callers can render and persist a stable sort order.
+   */
+  fun getStickerPacks(): Flow<StickerPacksResult> = flow {
+    emit(SignalExecutors.SERIAL.await { queryStickerPacks() })
+  }
+
+  /** Removes packs that lost their last sticker, e.g. because a download failed. */
+  suspend fun deleteOrphanedStickerPacks() {
+    SignalExecutors.SERIAL.await { stickerDatabase.deleteOrphanedPacks() }
+  }
+
+  /** Re-downloads the stickers of packs that are referenced by messages but not stored locally. */
+  fun fetchUnretrievedReferencePacks() {
+    SignalExecutors.SERIAL.execute {
+      val jobManager = AppDependencies.getJobManager()
+      val cursor = attachmentDatabase.getUnavailableStickerPacks()
+
+      try {
+        while (cursor.moveToNext()) {
+          val packId = cursor.requireNonNullString(AttachmentTable.STICKER_PACK_ID)
+          val packKey = cursor.requireNonNullString(AttachmentTable.STICKER_PACK_KEY)
+
+          jobManager.add(StickerPackDownloadJob.forReference(packId, packKey))
+        }
+      } finally {
+        cursor.close()
+      }
+    }
+  }
+
+  /** Fire and forget variant of [installStickerPack] for callers that cannot suspend. */
+  fun installStickerPackAsync(packId: String, packKey: String, notify: Boolean) {
+    SignalExecutors.SERIAL.execute {
+      installStickerPackInternal(StickerPackId(packId), StickerPackKey(packKey), notify)
+    }
+  }
+
+  /**
+   * Installs [packId]: when the pack is already present as a reference it is marked as installed,
+   * the stickers are downloaded and - for accounts with linked devices - the install is mirrored to
+   * them.
+   */
+  suspend fun installStickerPack(packId: StickerPackId, packKey: StickerPackKey, notify: Boolean) {
+    SignalExecutors.SERIAL.await { installStickerPackInternal(packId, packKey, notify) }
+  }
+
+  /** Fire and forget variant of [uninstallStickerPacks] for a single pack. */
+  fun uninstallStickerPackAsync(packId: String, packKey: String) {
+    SignalExecutors.SERIAL.execute {
+      uninstallStickerPackInternal(StickerPackId(packId), StickerPackKey(packKey))
+    }
+  }
+
+  /** Removes every pack in [packKeysById] and emits one linked device removal per pack. */
+  suspend fun uninstallStickerPacks(packKeysById: Map<StickerPackId, StickerPackKey>) {
+    SignalExecutors.SERIAL.await {
+      packKeysById.forEach { (packId, packKey) ->
+        uninstallStickerPackInternal(packId, packKey)
+      }
+    }
+  }
+
+  /** Persists the user chosen order of the installed packs. */
+  suspend fun setStickerPacksOrder(packsInOrder: List<StickerPackRecord>) {
+    SignalExecutors.SERIAL.await { stickerDatabase.updatePackOrder(packsInOrder) }
+  }
+
+  private fun installStickerPackInternal(packId: StickerPackId, packKey: StickerPackKey, notify: Boolean) {
+    if (stickerDatabase.isPackAvailableAsReference(packId.value)) {
+      stickerDatabase.markPackAsInstalled(packId.value, notify)
+    }
+
+    val jobManager = AppDependencies.getJobManager()
+    jobManager.add(StickerPackDownloadJob.forInstall(packId.value, packKey.value, notify))
+
+    if (SignalStore.account().hasLinkedDevices()) {
+      jobManager.add(MultiDeviceStickerPackOperationJob(packId.value, packKey.value, MultiDeviceStickerPackOperationJob.Type.INSTALL))
+    }
+  }
+
+  private fun uninstallStickerPackInternal(packId: StickerPackId, packKey: StickerPackKey) {
+    stickerDatabase.uninstallPack(packId.value)
+
+    if (SignalStore.account().hasLinkedDevices()) {
+      AppDependencies.getJobManager().add(MultiDeviceStickerPackOperationJob(packId.value, packKey.value, MultiDeviceStickerPackOperationJob.Type.REMOVE))
+    }
+  }
+
+  private fun queryStickerPacks(): StickerPacksResult {
+    val records = stickerDatabase.getAllStickerPacks()
+
+    val installedPacks = ArrayList<StickerPackRecord>(records.size)
+    val availablePacks = ArrayList<StickerPackRecord>(records.size)
+    val blessedPacks = ArrayList<StickerPackRecord>(records.size)
+    val sortOrderByPackId = LinkedHashMap<StickerPackId, Int>(records.size)
+
+    records.forEachIndexed { index, record ->
+      sortOrderByPackId[StickerPackId(record.packId)] = index
+
+      when {
+        record.isInstalled -> installedPacks += record
+        BlessedPacks.contains(record.packId) -> blessedPacks += record
+        else -> availablePacks += record
+      }
+    }
+
+    return StickerPacksResult(
+      installedPacks = installedPacks,
+      availablePacks = availablePacks,
+      blessedPacks = blessedPacks,
+      sortOrderByPackId = sortOrderByPackId
+    )
+  }
+
+  private val stickerDatabase: StickerTable
+    get() = SignalDatabase.stickers()
+
+  private val attachmentDatabase: AttachmentTable
+    get() = SignalDatabase.attachments()
+
+  interface Callback<T> {
+    fun onComplete(result: T)
+  }
+}
+
+/**
+ * The classified sticker pack state as produced by [StickerManagementRepository.getStickerPacks].
+ */
+data class StickerPacksResult(
+  val installedPacks: List<StickerPackRecord>,
+  val availablePacks: List<StickerPackRecord>,
+  val blessedPacks: List<StickerPackRecord>,
+  val sortOrderByPackId: Map<StickerPackId, Int>
+)
+
+/**
+ * Runs [block] on [this] executor and suspends until it has produced a result.
+ */
+private suspend fun <T> Executor.await(block: () -> T): T = suspendCoroutine { continuation ->
+  execute { continuation.resume(block()) }
+}
