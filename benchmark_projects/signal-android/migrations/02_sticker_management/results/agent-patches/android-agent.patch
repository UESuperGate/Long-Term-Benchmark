@@ -0,0 +1,21 @@
+package org.signal.core.util
+
+/**
+ * Returns a copy of this list in which the elements at [i] and [j] have been exchanged.
+ *
+ * Out of range indices leave the list untouched, which keeps drag-and-drop callbacks that
+ * race against the underlying data from crashing the UI.
+ */
+fun <E> List<E>.swap(i: Int, j: Int): List<E> {
+  val copy = toMutableList()
+
+  if (i !in copy.indices || j !in copy.indices) {
+    return copy
+  }
+
+  val tmp = copy[i]
+  copy[i] = copy[j]
+  copy[j] = tmp
+
+  return copy
+}
