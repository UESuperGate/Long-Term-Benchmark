--- /dev/null
+++ b/entry/src/main/ets/feature/StickerManagementStore.ts
@@ -0,0 +1,313 @@
+/**
+ * Sticker management feature store.
+ *
+ * The store owns the classification of the known sticker packs (installed, official available and
+ * other available), the transient download state of a running install, the multi-selection and the
+ * removal confirmation. Every effect that touches storage is delegated to
+ * {@link StickerManagementRepository}, which is the only place that talks to the leaf services.
+ */
+
+/** A sticker pack as it is known to the service and stored on the device. */
+export interface StickerPack {
+  id: string;
+  key: string;
+  title: string;
+  installed: boolean;
+  official: boolean;
+  order: number;
+}
+
+/** Leaf services the feature is allowed to use. */
+export interface StickerLeaf {
+  enqueueDownload(id: string, key: string, notify: boolean): void;
+  uninstall(ids: string[]): void;
+  persistOrder(ids: string[]): void;
+  markReferenceInstalled(id: string, notify: boolean): void;
+  enqueueLinked(id: string, key: string, operation: string): void;
+}
+
+/** Outcome of the last completed action. */
+export interface StickerConfirmation {
+  type: string;
+  title?: string;
+  count?: number;
+}
+
+/** Immutable snapshot handed to the page. */
+export interface StickerManagementState {
+  installedPackIds: string[];
+  availableOfficialIds: string[];
+  availableOtherIds: string[];
+  selectedPackIds: string[];
+  multiSelectEnabled: boolean;
+  prompt: number | null;
+  confirmation: StickerConfirmation | null;
+}
+
+/**
+ * Application owned repository: it translates feature intents into leaf service calls.
+ */
+export class StickerManagementRepository {
+  private readonly leaf: StickerLeaf;
+
+  constructor(leaf: StickerLeaf) {
+    this.leaf = leaf;
+  }
+
+  install(pack: StickerPack, notify: boolean, linked: boolean, reference: boolean): void {
+    if (reference) {
+      this.leaf.markReferenceInstalled(pack.id, notify);
+    }
+
+    this.leaf.enqueueDownload(pack.id, pack.key, notify);
+
+    if (linked) {
+      this.leaf.enqueueLinked(pack.id, pack.key, 'install');
+    }
+  }
+
+  uninstall(keys: Map<string, string>, linked: boolean): void {
+    const ids: string[] = [];
+
+    keys.forEach((key: string, id: string) => {
+      ids.push(id);
+
+      if (linked) {
+        this.leaf.enqueueLinked(id, key, 'remove');
+      }
+    });
+
+    if (ids.length > 0) {
+      this.leaf.uninstall(ids);
+    }
+  }
+
+  persistOrder(ids: string[]): void {
+    this.leaf.persistOrder(ids);
+  }
+}
+
+/** Feature store backing the sticker management page. */
+export class StickerManagementStore {
+  installed: StickerPack[] = [];
+  official: StickerPack[] = [];
+  other: StickerPack[] = [];
+  selected: string[] = [];
+  statuses: Map<string, string> = new Map<string, string>();
+  effects: string[] = [];
+  orderedStates: string[] = [];
+  prompt: number | null = null;
+  confirmation: StickerConfirmation | null = null;
+  multiSelectEnabled: boolean = false;
+
+  private readonly repository: StickerManagementRepository;
+  private pendingOrder: string[] | null = null;
+
+  constructor(repository: StickerManagementRepository) {
+    this.repository = repository;
+  }
+
+  /** Reclassifies the packs reported by the repository, preserving their order. */
+  onPacksUpdated(records: StickerPack[]): void {
+    const installed: StickerPack[] = [];
+    const official: StickerPack[] = [];
+    const other: StickerPack[] = [];
+
+    for (const record of records) {
+      if (this.statuses.has(record.id)) {
+        // A pack whose install is still settling stays visible with its transient status.
+        if (record.official) {
+          official.push(record);
+        } else {
+          other.push(record);
+        }
+      } else if (record.installed) {
+        installed.push(record);
+      } else if (record.official) {
+        official.push(record);
+      } else {
+        other.push(record);
+      }
+    }
+
+    this.installed = this.applyPendingOrder(installed);
+    this.official = official;
+    this.other = other;
+    this.selected = this.selected.filter((id: string) => this.installed.some((pack: StickerPack) => pack.id === id));
+    this.recordState();
+  }
+
+  seedInstalled(packs: StickerPack[]): void {
+    this.installed = this.applyPendingOrder(packs);
+    this.recordState();
+  }
+
+  seedSelection(ids: string[], enabled: boolean, prompt: number | null): void {
+    this.selected = ids.slice();
+    this.multiSelectEnabled = enabled;
+    this.prompt = prompt;
+    this.recordState();
+  }
+
+  seedSettled(id: string): void {
+    this.statuses.delete(id);
+    this.recordState();
+  }
+
+  install(pack: StickerPack, linked: boolean, reference: boolean): void {
+    if (this.statuses.has(pack.id)) {
+      return;
+    }
+
+    this.statuses.set(pack.id, 'IN_PROGRESS');
+    this.recordState();
+
+    this.repository.install(pack, false, linked, reference);
+    this.effects.push('install:' + pack.id);
+
+    this.statuses.set(pack.id, 'DOWNLOADED');
+    this.confirmation = { type: 'installed', title: pack.title };
+    this.recordState();
+  }
+
+  /** Called once the completed download status of a pack is no longer worth showing. */
+  installationLingerElapsed(id: string): void {
+    this.seedSettled(id);
+  }
+
+  move(from: number, to: number): void {
+    if (from === to || from < 0 || to < 0 || from >= this.installed.length || to >= this.installed.length) {
+      return;
+    }
+
+    const reordered: StickerPack[] = this.installed.slice();
+    const moved: StickerPack = reordered[from];
+    reordered[from] = reordered[to];
+    reordered[to] = moved;
+
+    this.installed = reordered;
+    this.pendingOrder = this.installed.map((pack: StickerPack) => pack.id);
+    this.recordState();
+  }
+
+  saveOrder(): void {
+    const ids: string[] = this.installed.map((pack: StickerPack) => pack.id);
+
+    this.repository.persistOrder(ids);
+    this.effects.push('persistOrder:' + ids.join(','));
+    this.pendingOrder = null;
+    this.recordState();
+  }
+
+  toggleSelection(id: string): void {
+    if (!this.installed.some((pack: StickerPack) => pack.id === id)) {
+      return;
+    }
+
+    if (!this.multiSelectEnabled) {
+      this.multiSelectEnabled = true;
+      this.selected = [id];
+    } else if (this.selected.indexOf(id) >= 0) {
+      this.selected = this.selected.filter((selected: string) => selected !== id);
+    } else {
+      this.selected = this.selected.concat([id]);
+    }
+
+    this.recordState();
+  }
+
+  setMultiSelectEnabled(enabled: boolean): void {
+    this.multiSelectEnabled = enabled;
+
+    if (!enabled) {
+      this.selected = [];
+    }
+
+    this.recordState();
+  }
+
+  toggleSelectAll(): void {
+    const ids: string[] = this.installed.map((pack: StickerPack) => pack.id);
+    const everythingSelected = ids.length > 0 && ids.every((id: string) => this.selected.indexOf(id) >= 0);
+
+    this.selected = everythingSelected ? [] : ids;
+
+    if (this.selected.length > 0) {
+      this.multiSelectEnabled = true;
+    }
+
+    this.recordState();
+  }
+
+  requestUninstall(ids: string[]): void {
+    if (ids.length === 0) {
+      return;
+    }
+
+    this.prompt = ids.length;
+    this.recordState();
+  }
+
+  cancelUninstall(): void {
+    this.prompt = null;
+    this.recordState();
+  }
+
+  confirmUninstall(ids: string[], linked: boolean): void {
+    if (ids.length === 0) {
+      this.prompt = null;
+      this.recordState();
+      return;
+    }
+
+    const keys: Map<string, string> = new Map<string, string>();
+
+    for (const id of ids) {
+      const pack: StickerPack | undefined = this.installed.find((installedPack: StickerPack) => installedPack.id === id);
+
+      if (pack !== undefined) {
+        keys.set(id, pack.key);
+      }
+    }
+
+    this.repository.uninstall(keys, linked);
+    this.effects.push('uninstall:' + keys.size);
+
+    this.selected = this.selected.filter((id: string) => ids.indexOf(id) < 0);
+    this.prompt = null;
+    this.confirmation = { type: 'uninstalledPacks', count: ids.length };
+    this.recordState();
+  }
+
+  state(): StickerManagementState {
+    return {
+      installedPackIds: this.installed.map((pack: StickerPack) => pack.id),
+      availableOfficialIds: this.official.map((pack: StickerPack) => pack.id),
+      availableOtherIds: this.other.map((pack: StickerPack) => pack.id),
+      selectedPackIds: this.selected.slice(),
+      multiSelectEnabled: this.multiSelectEnabled,
+      prompt: this.prompt,
+      confirmation: this.confirmation
+    };
+  }
+
+  private applyPendingOrder(packs: StickerPack[]): StickerPack[] {
+    const order: string[] | null = this.pendingOrder;
+
+    if (order === null) {
+      return packs;
+    }
+
+    return packs.slice().sort((left: StickerPack, right: StickerPack) => {
+      const leftIndex: number = order.indexOf(left.id);
+      const rightIndex: number = order.indexOf(right.id);
+
+      return (leftIndex < 0 ? order.length : leftIndex) - (rightIndex < 0 ? order.length : rightIndex);
+    });
+  }
+
+  private recordState(): void {
+    const snapshot: StickerManagementState = this.state();
+    this.orderedStates.push(snapshot.installedPackIds.join(','));
+  }
+}
