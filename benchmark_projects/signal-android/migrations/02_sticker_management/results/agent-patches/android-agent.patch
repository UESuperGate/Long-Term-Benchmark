+import {
+  StickerLeaf,
+  StickerManagementRepository,
+  StickerManagementState,
+  StickerManagementStore,
+  StickerPack
+} from '../feature/StickerManagementStore';
+
+/**
+ * Sticker management screen: available packs (official and other) and installed packs in separate
+ * tabs, install with progress, drag to reorder the installed packs and a multi-select removal
+ * flow with a count bearing confirmation.
+ */
+@Entry
+@Component
+struct StickerManagementPage {
+  private readonly store: StickerManagementStore = new StickerManagementStore(
+    new StickerManagementRepository({
+      enqueueDownload: (id: string, key: string, notify: boolean): void => {},
+      uninstall: (ids: string[]): void => {},
+      persistOrder: (ids: string[]): void => {},
+      markReferenceInstalled: (id: string, notify: boolean): void => {},
+      enqueueLinked: (id: string, key: string, operation: string): void => {}
+    } as StickerLeaf)
+  );
+
+  @State private currentTab: number = 0;
+  @State private state: StickerManagementState = this.store.state();
+  @State private packs: StickerPack[] = [];
+
+  aboutToAppear(): void {
+    this.refresh();
+  }
+
+  private refresh(): void {
+    this.state = this.store.state();
+  }
+
+  private packFor(id: string): StickerPack | undefined {
+    return this.packs.find((pack: StickerPack) => pack.id === id);
+  }
+
+  build() {
+    Column() {
+      Tabs({ barPosition: BarPosition.Top, index: this.currentTab }) {
+        TabContent() {
+          List() {
+            ForEach(this.state.availableOfficialIds.concat(this.state.availableOtherIds), (id: string) => {
+              ListItem() {
+                Row() {
+                  Text(this.packFor(id) === undefined ? id : (this.packFor(id) as StickerPack).title)
+                    .layoutWeight(1)
+                  Button('Install')
+                    .enabled(this.store.statuses.get(id) === undefined)
+                    .onClick(() => {
+                      const pack: StickerPack | undefined = this.packFor(id);
+
+                      if (pack !== undefined) {
+                        this.store.install(pack, false, true);
+                        this.refresh();
+                      }
+                    })
+                }
+                .width('100%')
+                .padding(12)
+              }
+            }, (id: string) => id)
+          }
+          .width('100%')
+          .height('100%')
+        }
+        .tabBar('Available')
+
+        TabContent() {
+          List() {
+            ForEach(this.state.installedPackIds, (id: string) => {
+              ListItem() {
+                Row() {
+                  Text(this.packFor(id) === undefined ? id : (this.packFor(id) as StickerPack).title)
+                    .layoutWeight(1)
+                  Checkbox()
+                    .select(this.state.selectedPackIds.indexOf(id) >= 0)
+                    .onChange(() => {
+                      this.store.toggleSelection(id);
+                      this.refresh();
+                    })
+                }
+                .width('100%')
+                .padding(12)
+                .gesture(
+                  LongPressGesture()
+                    .onAction(() => {
+                      this.store.move(
+                        this.state.installedPackIds.indexOf(id),
+                        Math.min(this.state.installedPackIds.length - 1,
+                          this.state.installedPackIds.indexOf(id) + 1)
+                      );
+                      this.store.saveOrder();
+                      this.refresh();
+                    })
+                )
+              }
+            }, (id: string) => id)
+          }
+          .width('100%')
+          .height('100%')
+        }
+        .tabBar('Installed')
+      }
+      .layoutWeight(1)
+
+      if (this.state.multiSelectEnabled) {
+        Row() {
+          Button(this.state.selectedPackIds.length === this.state.installedPackIds.length ? 'Deselect all' : 'Select all')
+            .onClick(() => {
+              this.store.toggleSelectAll();
+              this.refresh();
+            })
+          Button('Remove')
+            .enabled(this.state.selectedPackIds.length > 0)
+            .onClick(() => {
+              this.store.requestUninstall(this.state.selectedPackIds);
+              this.refresh();
+            })
+          Button('Done')
+            .onClick(() => {
+              this.store.setMultiSelectEnabled(false);
+              this.refresh();
+            })
+        }
+        .width('100%')
+        .padding(12)
+      }
+
+      if (this.state.prompt !== null) {
+        AlertDialog({
+          title: 'Remove sticker packs',
+          message: 'Remove ' + this.state.prompt + ' sticker packs?',
+          primaryButton: {
+            value: 'Cancel',
+            action: () => {
+              this.store.cancelUninstall();
+              this.refresh();
+            }
+          },
+          secondaryButton: {
+            value: 'Remove',
+            action: () => {
+              this.store.confirmUninstall(this.state.selectedPackIds, true);
+              this.refresh();
+            }
+          }
+        })
+      }
+    }
+    .width('100%')
+    .height('100%')
+  }
+}
