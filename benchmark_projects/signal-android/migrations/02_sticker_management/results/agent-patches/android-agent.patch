+package org.thoughtcrime.securesms.stickers
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import org.signal.core.util.swap
+import org.thoughtcrime.securesms.database.DatabaseObserver
+import org.thoughtcrime.securesms.database.model.StickerPackId
+import org.thoughtcrime.securesms.database.model.StickerPackKey
+import org.thoughtcrime.securesms.database.model.StickerPackRecord
+import org.thoughtcrime.securesms.dependencies.AppDependencies
+
+/**
+ * Drives the sticker management screen: it keeps the packs that are available on this device
+ * classified into the installed and the available tabs, forwards the install, uninstall, reorder
+ * and multi-select interactions to [StickerManagementRepository] and exposes the resulting state
+ * as a single [StickerManagementUiState].
+ */
+class StickerManagementViewModel : ViewModel() {
+
+  private val _uiState = MutableStateFlow(StickerManagementUiState())
+  val uiState: StateFlow<StickerManagementUiState> = _uiState.asStateFlow()
+
+  /** The most recent repository classification, used to rebuild the state on every publish. */
+  private var packs: StickerPacksResult = StickerPacksResult(
+    installedPacks = emptyList(),
+    availablePacks = emptyList(),
+    blessedPacks = emptyList(),
+    sortOrderByPackId = emptyMap()
+  )
+
+  /** Transient, per pack download state that only lives for as long as an install is settling. */
+  private val downloadStatuses = mutableMapOf<StickerPackId, AvailableStickerPack.DownloadStatus>()
+  private val installationLingerJobs = mutableMapOf<StickerPackId, Job>()
+
+  private var installedPacks: List<InstalledStickerPack> = emptyList()
+
+  /** The order the user has dragged the installed packs into, until it is dropped. */
+  private var pendingOrder: List<StickerPackId>? = null
+
+  private var multiSelectEnabled: Boolean = false
+  private var selectedPackIds: Set<StickerPackId> = emptySet()
+  private var userPrompt: ConfirmRemoveStickerPacksPrompt? = null
+  private var actionConfirmation: StickerManagementConfirmation? = null
+
+  private val packsObserver = DatabaseObserver.Observer { onDatabaseChanged() }
+
+  init {
+    AppDependencies.getDatabaseObserver().registerStickerPackObserver(packsObserver)
+
+    viewModelScope.launch {
+      StickerManagementRepository.deleteOrphanedStickerPacks()
+      StickerManagementRepository.fetchUnretrievedReferencePacks()
+      refreshPacks()
+    }
+  }
+
+  /** Cleans up packs that lost their stickers and reloads the state whenever the screen shows. */
+  fun onScreenVisible() {
+    viewModelScope.launch {
+      StickerManagementRepository.deleteOrphanedStickerPacks()
+      refreshPacks()
+    }
+  }
+
+  /**
+   * Installs [pack]: the pack is shown as in progress while the repository works, then as
+   * downloaded - together with a confirmation - until the transient state is cleared again and
+   * the repository classification takes over.
+   */
+  fun installStickerPack(pack: AvailableStickerPack) {
+    val packId = pack.id
+
+    if (downloadStatuses.containsKey(packId)) {
+      return
+    }
+
+    downloadStatuses[packId] = AvailableStickerPack.DownloadStatus.InProgress
+    publish()
+
+    viewModelScope.launch {
+      try {
+        StickerManagementRepository.installStickerPack(pack.id, pack.key, notify = false)
+      } catch (e: Exception) {
+        // The install never made it to the repository: drop the transient state again instead of
+        // leaving the pack stuck in progress.
+        downloadStatuses.remove(packId)
+        publish()
+        return@launch
+      }
+
+      downloadStatuses[packId] = AvailableStickerPack.DownloadStatus.Downloaded
+      actionConfirmation = StickerManagementConfirmation.InstalledPack(pack.record.title)
+      publish()
+
+      scheduleInstallationSettle(packId)
+    }
+  }
+
+  /** Opens the confirmation for removing [packIds]; nothing is removed before it is confirmed. */
+  fun onUninstallStickerPacksRequested(packIds: Set<StickerPackId>) {
+    if (packIds.isEmpty()) {
+      return
+    }
+
+    userPrompt = ConfirmRemoveStickerPacksPrompt(numItemsToDelete = packIds.size)
+    publish()
+  }
+
+  /** Removes the confirmed [packIds] and reports how many packs were removed. */
+  fun onUninstallStickerPacksConfirmed(packIds: Set<StickerPackId>) {
+    if (packIds.isEmpty()) {
+      userPrompt = null
+      publish()
+      return
+    }
+
+    val packKeysById = packIds
+      .mapNotNull { packId ->
+        installedPacks.firstOrNull { it.id == packId }?.let { packId to it.key }
+      }
+      .toMap()
+
+    viewModelScope.launch {
+      try {
+        StickerManagementRepository.uninstallStickerPacks(packKeysById)
+      } catch (e: Exception) {
+        // Nothing was removed: dismiss the prompt, but keep the packs and the selection in place
+        // so the removal can be requested again.
+        userPrompt = null
+        publish()
+        return@launch
+      }
+
+      selectedPackIds = selectedPackIds - packIds
+      userPrompt = null
+      actionConfirmation = StickerManagementConfirmation.UninstalledPacks(packIds.size)
+      publish()
+    }
+  }
+
+  /** Dismisses the removal prompt, leaving both the installed packs and the selection untouched. */
+  fun onUninstallStickerPacksCanceled() {
+    userPrompt = null
+    publish()
+  }
+
+  /** Moves an installed pack during a drag, updating the visible order right away. */
+  fun updatePosition(fromIndex: Int, toIndex: Int) {
+    val current = installedPacks
+
+    if (fromIndex == toIndex || fromIndex !in current.indices || toIndex !in current.indices) {
+      return
+    }
+
+    installedPacks = current.swap(fromIndex, toIndex)
+    pendingOrder = installedPacks.map { it.id }
+    publish()
+  }
+
+  /** Persists the currently visible order of the installed packs. */
+  fun saveInstalledPacksSortOrder() {
+    val packsInOrder = installedPacks.map { it.record }
+
+    viewModelScope.launch {
+      try {
+        StickerManagementRepository.setStickerPacksOrder(packsInOrder)
+      } catch (e: Exception) {
+        // The order could not be persisted; keep showing it and retry on the next drop.
+        return@launch
+      }
+
+      pendingOrder = null
+      refreshPacks()
+    }
+  }
+
+  /** Toggles [pack] in the selection, entering multi-select mode on the first selection. */
+  fun toggleSelection(pack: InstalledStickerPack) {
+    val packId = pack.id
+
+    if (installedPacks.none { it.id == packId }) {
+      return
+    }
+
+    if (!multiSelectEnabled) {
+      multiSelectEnabled = true
+      selectedPackIds = setOf(packId)
+    } else if (packId in selectedPackIds) {
+      selectedPackIds = selectedPackIds - packId
+    } else {
+      selectedPackIds = selectedPackIds + packId
+    }
+
+    publish()
+  }
+
+  /** Selects every installed pack, or clears the selection when everything is already selected. */
+  fun toggleSelectAll() {
+    val installedPackIds = installedPacks.mapTo(mutableSetOf()) { it.id }
+
+    selectedPackIds = if (installedPackIds.isNotEmpty() && installedPackIds.all { it in selectedPackIds }) {
+      emptySet()
+    } else {
+      installedPackIds
+    }
+
+    if (selectedPackIds.isNotEmpty()) {
+      multiSelectEnabled = true
+    }
+
+    publish()
+  }
+
+  /** Leaving multi-select mode clears the selection without touching the installed packs. */
+  fun setMultiSelectEnabled(isEnabled: Boolean) {
+    multiSelectEnabled = isEnabled
+
+    if (!isEnabled) {
+      selectedPackIds = emptySet()
+    }
+
+    publish()
+  }
+
+  /** Dismisses the confirmation that is currently shown. */
+  fun onSnackbarDismiss() {
+    actionConfirmation = null
+    publish()
+  }
+
+  override fun onCleared() {
+    AppDependencies.getDatabaseObserver().unregisterObserver(packsObserver)
+    installationLingerJobs.values.forEach { it.cancel() }
+    installationLingerJobs.clear()
+    viewModelScope.cancel()
+    super.onCleared()
+  }
+
+  private fun onDatabaseChanged() {
+    viewModelScope.launch {
+      refreshPacks()
+    }
+  }
+
+  private suspend fun refreshPacks() {
+    applyPacks(StickerManagementRepository.getStickerPacks().first())
+  }
+
+  private fun applyPacks(result: StickerPacksResult) {
+    packs = result
+
+    installedPacks = orderedRecords()
+      .filter { it.isInstalled && StickerPackId(it.packId) !in downloadStatuses }
+      .map { record ->
+        InstalledStickerPack(
+          record = record,
+          isBlessed = BlessedPacks.contains(record.packId),
+          sortOrder = result.sortOrderByPackId[StickerPackId(record.packId)] ?: 0
+        )
+      }
+
+    pendingOrder?.let { order ->
+      installedPacks = installedPacks.sortedBy { pack ->
+        order.indexOf(pack.id).let { if (it < 0) order.size else it }
+      }
+    }
+
+    val installedPackIds = installedPacks.mapTo(mutableSetOf()) { it.id }
+    selectedPackIds = selectedPackIds.filterTo(mutableSetOf()) { it in installedPackIds }
+
+    publish()
+  }
+
+  private fun scheduleInstallationSettle(packId: StickerPackId) {
+    installationLingerJobs.remove(packId)?.cancel()
+    installationLingerJobs[packId] = viewModelScope.launch {
+      delay(INSTALLATION_LINGER_MS)
+      installationLingerJobs.remove(packId)
+      downloadStatuses.remove(packId)
+      publish()
+    }
+  }
+
+  /**
+   * Rebuilds the visible state. Packs with a transient download status stay in the available tabs
+   * even when the repository already classifies them as installed, so a just installed pack remains
+   * visible until the status is cleared.
+   */
+  private fun publish() {
+    val availableBlessedPacks = mutableListOf<AvailableStickerPack>()
+    val availableNotBlessedPacks = mutableListOf<AvailableStickerPack>()
+
+    for (record in orderedRecords()) {
+      val downloadStatus = downloadStatuses[StickerPackId(record.packId)]
+
+      when {
+        downloadStatus != null -> {
+          val pack = AvailableStickerPack(
+            record = record,
+            isBlessed = BlessedPacks.contains(record.packId),
+            downloadStatus = downloadStatus
+          )
+
+          if (pack.isBlessed) {
+            availableBlessedPacks += pack
+          } else {
+            availableNotBlessedPacks += pack
+          }
+        }
+        record.isInstalled -> Unit
+        BlessedPacks.contains(record.packId) ->
+          availableBlessedPacks += AvailableStickerPack(record, true, AvailableStickerPack.DownloadStatus.NotDownloaded)
+        else ->
+          availableNotBlessedPacks += AvailableStickerPack(record, false, AvailableStickerPack.DownloadStatus.NotDownloaded)
+      }
+    }
+
+    _uiState.value = StickerManagementUiState(
+      availableBlessedPacks = availableBlessedPacks,
+      availableNotBlessedPacks = availableNotBlessedPacks,
+      installedPacks = installedPacks,
+      multiSelectEnabled = multiSelectEnabled,
+      selectedPackIds = selectedPackIds,
+      userPrompt = userPrompt,
+      actionConfirmation = actionConfirmation
+    )
+  }
+
+  /** All known pack records in the order the repository returned them. */
+  private fun orderedRecords(): List<StickerPackRecord> =
+    (packs.installedPacks + packs.availablePacks + packs.blessedPacks).sortedBy {
+      packs.sortOrderByPackId[StickerPackId(it.packId)] ?: Int.MAX_VALUE
+    }
+
+  private companion object {
+    /** How long a just installed pack keeps its completed download status. */
+    private const val INSTALLATION_LINGER_MS = 500L
+  }
+}
+
+data class StickerManagementUiState(
+  val availableBlessedPacks: List<AvailableStickerPack> = emptyList(),
+  val availableNotBlessedPacks: List<AvailableStickerPack> = emptyList(),
+  val installedPacks: List<InstalledStickerPack> = emptyList(),
+  val multiSelectEnabled: Boolean = false,
+  val selectedPackIds: Set<StickerPackId> = emptySet(),
+  val userPrompt: ConfirmRemoveStickerPacksPrompt? = null,
+  val actionConfirmation: StickerManagementConfirmation? = null
+)
+
+/** Confirmation shown before one or several installed packs are removed. */
+data class ConfirmRemoveStickerPacksPrompt(val numItemsToDelete: Int)
+
+/** Outcome of the last completed action, rendered as a snackbar. */
+sealed interface StickerManagementConfirmation {
+  data class InstalledPack(val packTitle: String) : StickerManagementConfirmation
+  data class UninstalledPack(val packTitle: String) : StickerManagementConfirmation
+  data class UninstalledPacks(val numPacksUninstalled: Int) : StickerManagementConfirmation
+}
+
+/** A pack that can be installed from the available tabs. */
+data class AvailableStickerPack(
+  val record: StickerPackRecord,
+  val isBlessed: Boolean,
+  val downloadStatus: DownloadStatus
+) {
+  val id: StickerPackId get() = StickerPackId(record.packId)
+  val key: StickerPackKey get() = StickerPackKey(record.packKey)
+
+  sealed class DownloadStatus {
+    data object NotDownloaded : DownloadStatus()
+    data object InProgress : DownloadStatus()
+    data object Downloaded : DownloadStatus()
+  }
+}
+
+/** A pack whose stickers are stored on this device. */
+data class InstalledStickerPack(
+  val record: StickerPackRecord,
+  val isBlessed: Boolean,
+  val sortOrder: Int
+) {
+  val id: StickerPackId get() = StickerPackId(record.packId)
+  val key: StickerPackKey get() = StickerPackKey(record.packKey)
+}
