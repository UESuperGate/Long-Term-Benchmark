{
  "schemaVersion": 1,
  "taskId": "01_media_keyboard",
  "description": "Platform-neutral media keyboard state transitions",
  "cases": [
    {
      "traceSchemaVersion": 2,
      "caseId": "mk_state_001_initialize_tabs",
      "key": "initialize_tabs",
      "functionalArea": "tab_availability",
      "given": {
        "repositoryTabs": [
          "GIF",
          "EMOJI",
          "STICKER"
        ],
        "initialTab": null
      },
      "event": {
        "name": "initialize"
      },
      "expected": {
        "state": {
          "initialized": true,
          "availableTabs": [
            "EMOJI",
            "STICKER",
            "GIF"
          ],
          "selectedTab": "EMOJI"
        },
        "effects": [
          {
            "name": "getAvailableTabs",
            "count": 1
          }
        ]
      },
      "invariants": [
        "tab order follows product order rather than repository iteration order"
      ],
      "evidence": {
        "androidProduction": [
          "MediaKeyboardViewModel.applyEvent",
          "MediaKeyboardState.availableTabs"
        ],
        "androidTests": [
          "MediaKeyboardViewModelTest.initialize - populates available tabs"
        ]
      },
      "taskId": "01_media_keyboard",
      "traceDigest": "db8238253cddff40bb35c8aae0bc446bdd8a39686cbd29377b51f1b461a59770"
    },
    {
      "traceSchemaVersion": 2,
      "caseId": "mk_state_002_restrict_fallback",
      "key": "restrict_fallback",
      "functionalArea": "host_tab_restriction",
      "given": {
        "offeredTabs": [
          "EMOJI",
          "STICKER",
          "GIF"
        ],
        "preferredTab": "GIF",
        "restrictedTo": null
      },
      "event": {
        "name": "restrictTabs",
        "tabs": [
          "EMOJI"
        ]
      },
      "expected": {
        "state": {
          "availableTabs": [
            "EMOJI"
          ],
          "selectedTab": "EMOJI",
          "preferredTab": "GIF"
        },
        "effects": []
      },
      "invariants": [
        "the user's preferred tab is retained while unreachable",
        "no unavailable tab is exposed"
      ],
      "evidence": {
        "androidProduction": [
          "MediaKeyboardViewModel.restrictTabs",
          "MediaKeyboardState.selectedTab"
        ],
        "androidTests": [
          "MediaKeyboardViewModelTest.restrict tabs - narrows to the given tabs and selects one of them"
        ]
      },
      "taskId": "01_media_keyboard",
      "traceDigest": "2fc90f16aaa0cf612e76e8b711c61b6ac2fc4d4c077aa03838cbb7692451e072"
    },
    {
      "traceSchemaVersion": 2,
      "caseId": "mk_state_003_lift_restriction",
      "key": "lift_restriction",
      "functionalArea": "host_tab_restriction",
      "given": {
        "offeredTabs": [
          "EMOJI",
          "STICKER",
          "GIF"
        ],
        "preferredTab": "GIF",
        "restrictedTo": [
          "EMOJI"
        ]
      },
      "event": {
        "name": "restrictTabs",
        "tabs": null
      },
      "expected": {
        "state": {
          "availableTabs": [
            "EMOJI",
            "STICKER",
            "GIF"
          ],
          "selectedTab": "GIF",
          "preferredTab": "GIF"
        },
        "effects": []
      },
      "invariants": [
        "lifting a temporary restriction restores a still-offered preference"
      ],
      "evidence": {
        "androidProduction": [
          "MediaKeyboardViewModel.restrictTabs",
          "MediaKeyboardState.selectedTab"
        ],
        "androidTests": [
          "MediaKeyboardViewModelTest.restrict tabs - lifting the restriction returns to the tab the user had picked"
        ]
      },
      "taskId": "01_media_keyboard",
      "traceDigest": "3f53eaf59df29421e3c4c5876aa59c9982627d770b53682f675bf6a174900fc9"
