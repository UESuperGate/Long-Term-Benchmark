      "functionalArea": "search_state",
      "given": {
        "availableTabs": [
          "EMOJI",
          "STICKER",
          "GIF"
        ],
        "selectedTab": "EMOJI",
        "searchActive": true,
        "searchQuery": "cats"
      },
      "event": {
        "name": "selectTab",
