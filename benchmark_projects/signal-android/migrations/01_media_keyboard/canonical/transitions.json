      },
      "expected": {
        "state": {
          "selectedTab": "GIF",
          "preferredTab": "GIF",
          "searchActive": true,
          "searchQuery": ""
        },
        "effects": []
      },
      "invariants": [
        "host-owned search visibility is unchanged by tab selection"
      ],
      "evidence": {
        "androidProduction": [
          "MediaKeyboardViewModel.applyEvent"
        ],
        "androidTests": [
          "MediaKeyboardViewModelTest.tab selected - switches tab and clears the query"
        ]
      },
      "taskId": "01_media_keyboard",
