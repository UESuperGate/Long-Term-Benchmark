+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediakeyboard
+
+/**
+ * The media surfaces a conversation keyboard can offer.
+ *
+ * Declaration order is the order the product puts tabs in, but hosts are free to offer any subset
+ * in any order, so use [PRODUCT_ORDER] rather than a host's iteration order anywhere a user or the
+ * UI would notice.
+ */
+enum class MediaKeyboardTab {
+  EMOJI,
+  STICKER,
+  GIF;
+
+  companion object {
+    /** The order tabs are shown in, independent of the order the host offers them. */
+    @JvmField
+    val PRODUCT_ORDER: List<MediaKeyboardTab> = listOf(EMOJI, STICKER, GIF)
+
+    /** [tabs] with duplicates dropped, in [PRODUCT_ORDER]. */
+    fun ordered(tabs: Iterable<MediaKeyboardTab>): List<MediaKeyboardTab> {
+      val offered = tabs.toSet()
+      return PRODUCT_ORDER.filter { it in offered }
+    }
+  }
+}
