+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediakeyboard.screens.gif
+
+import androidx.annotation.StringRes
+
+/**
+ * The gif searches offered as one-tap chips above the results.
+ *
+ * Picking one replaces the results rather than adding to them: it is a fresh search, so it starts
+ * from the first page again.
+ *
+ * @param query The gif search to run. Empty means "whatever the host shows by default".
+ * @param label String resource naming the chip.
+ */
+enum class GifQuickSearchOption(val query: String, @field:StringRes val label: Int) {
+  /** Recently used gifs. What the tab opens on. */
+  LAST("", android.R.string.more),
+
+  YES("yes", android.R.string.yes),
+  NO("no", android.R.string.no),
+  OK("ok", android.R.string.ok),
+  HELLO("hello", android.R.string.hello)
+}
