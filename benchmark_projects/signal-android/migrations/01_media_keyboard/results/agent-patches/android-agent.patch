+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.conversation.v2
+
+import androidx.compose.ui.graphics.Color
+import org.signal.mediakeyboard.data.KeyboardSticker
+
+/**
+ * Holds the sticker a conversation is waiting on the user to confirm before sending it.
+ *
+ * A sticker tap on the keyboard is not a send. It puts a sticker here and raises the conversation's
+ * overlay; nothing is sent, and nothing about the sticker changes, until [send] runs. That split is
+ * what makes it safe to show an overlay over whatever the user was doing when they tapped.
+ *
+ * @param onSend Sends a confirmed sticker. Called at most once per confirmation.
+ * @param onShowingChanged Tells the conversation to raise or drop the overlay.
+ */
+class ChatStickerConfirmationController(
+  private val onSend: (KeyboardSticker) -> Unit,
+  private val onShowingChanged: (Boolean) -> Unit
+) {
+  /** The sticker awaiting confirmation, or null when the overlay is not up. */
+  var confirmation: StickerConfirmation? = null
+    private set
+
+  /**
+   * Color of the conversation's send affordance. Highlighted while a sticker is waiting, so the
+   * button the overlay is asking about looks like the one it is standing in for.
+   */
+  var sendColor: Color = IDLE_SEND_COLOR
+
+  /** Whether the confirmation overlay is up. */
+  val isShowing: Boolean get() = confirmation != null
+
+  /**
+   * Puts [sticker] up for confirmation, as a reply to [replyTo] when there is one.
+   *
+   * Nothing is sent and the sticker is not marked as used. Show this in response to the tap, not
+   * after it.
+   */
+  fun show(sticker: KeyboardSticker, replyTo: String?) {
+    confirmation = StickerConfirmation(sticker, replyTo)
+    sendColor = PENDING_SEND_COLOR
+    onShowingChanged(true)
+  }
+
+  /** Drops the pending sticker. Doing this with nothing pending does nothing. */
+  fun dismiss() {
+    if (confirmation == null) {
+      return
+    }
+
+    confirmation = null
+    sendColor = IDLE_SEND_COLOR
+    onShowingChanged(false)
+  }
+
+  /** Sends the pending sticker, once. Does nothing when there is nothing pending. */
+  fun send() {
+    val pending = confirmation ?: return
+
+    // Cleared before the callback: a send that re-enters the conversation must not find the sticker
+    // still waiting and send it a second time.
+    confirmation = null
+    sendColor = IDLE_SEND_COLOR
+    onShowingChanged(false)
+    onSend(pending.sticker)
+  }
+
+  private companion object {
+    val IDLE_SEND_COLOR = Color(0xFF208FFFuL)
+    val PENDING_SEND_COLOR = Color(0xFF2ECC71uL)
+  }
+}
+
+/** A sticker the conversation is asking the user to confirm. */
+data class StickerConfirmation(
+  val sticker: KeyboardSticker,
+  /** The message this sticker would reply to, or null when it is not a reply. */
+  val replyTo: String?
+)
