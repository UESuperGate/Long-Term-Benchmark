+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.thoughtcrime.securesms.conversation.v2
+
+import org.signal.mediakeyboard.MediaKeyboardAction
+import org.signal.mediakeyboard.data.KeyboardGif
+import org.signal.mediakeyboard.data.KeyboardSticker
+import org.signal.mediakeyboard.data.StickerKeyboardRepository
+
+/**
+ * Carries media keyboard actions into a conversation.
+ *
+ * The keyboard reports what the user did and leaves the consequences to the host, so this is where
+ * the conversation's own rules apply. The one that matters most: a sticker tap raises a confirmation
+ * and stops there. The sticker is not sent, and it is not marked as used either, so a sticker the
+ * user backs out of never reaches the top of their recents as though they had sent it.
+ *
+ * @param stickerRepository Recency for stickers, written only once one has been confirmed.
+ * @param onSendSticker Sends a sticker the user has confirmed.
+ * @param onInput Inserts text, such as emoji, into the composer.
+ * @param onBackspace Deletes the character before the cursor.
+ * @param onGifSelected Sends a gif the user picked.
+ * @param onShowingChanged Raises or drops the conversation's confirmation overlay.
+ */
+class ChatMediaKeyboardActionHandler(
+  private val stickerRepository: StickerKeyboardRepository,
+  private val onSendSticker: (KeyboardSticker) -> Unit,
+  private val onInput: (String) -> Unit,
+  private val onBackspace: () -> Unit,
+  private val onGifSelected: (KeyboardGif) -> Unit,
+  onShowingChanged: (Boolean) -> Unit
+) {
+  /** The overlay standing between a sticker tap and a sent sticker. */
+  val confirmation = ChatStickerConfirmationController(
+    onSend = { sticker ->
+      // Recording recency is part of sending, not part of tapping, so it happens here and nowhere
+      // else.
+      stickerRepository.onStickerUsed(sticker)
+      onSendSticker(sticker)
+    },
+    onShowingChanged = onShowingChanged
+  )
+
+  private var replyTo: String? = null
+
+  /** Records what the next confirmed sticker would reply to. */
+  fun onReplyChanged(replyTo: String?) {
+    this.replyTo = replyTo
+  }
+
+  /** Handles one action from a media keyboard page. */
+  fun onAction(action: MediaKeyboardAction) {
+    when (action) {
+      is MediaKeyboardAction.EmojiSelected -> onInput(action.emoji)
+      MediaKeyboardAction.Backspace -> onBackspace()
+      is MediaKeyboardAction.GifSelected -> onGifSelected(action.gif)
+
+      // A tap only asks. Sending, and recording the sticker as used, wait for the confirmation.
+      is MediaKeyboardAction.StickerSelected -> confirmation.show(action.sticker, replyTo)
+
+      // Nothing else on the keyboard is a conversation decision; the host screen owns those.
+      else -> Unit
+    }
+  }
+}
