+
+package org.signal.mediakeyboard
+
+/**
+ * Things a media keyboard page does that the conversation hosting it has to carry out.
+ *
+ * Pages never touch a conversation themselves; they describe what happened and let the host decide.
+ * That is also what keeps a sticker tap inert: the page reports [StickerSelected] and nothing is
+ * sent until the host has confirmed.
+ */
+sealed interface MediaKeyboardAction {
+  /** Insert [emoji] into the composer. */
+  data class EmojiSelected(val emoji: String) : MediaKeyboardAction
+
+  /** Delete the character before the cursor. */
+  data object Backspace : MediaKeyboardAction
+
+  /** The user tapped a sticker. Requests confirmation; does not send. */
+  data class StickerSelected(val sticker: data.KeyboardSticker) : MediaKeyboardAction
+
+  /** The user asked to send [sticker] outright, from somewhere that is already a send surface. */
+  data class StickerSendClicked(val sticker: data.KeyboardSticker) : MediaKeyboardAction
+
+  /** The user tapped a gif. */
+  data class GifSelected(val gif: data.KeyboardGif) : MediaKeyboardAction
+
+  /** The user asked to move to [tab]. */
+  data class TabSelected(val tab: MediaKeyboardTab) : MediaKeyboardAction
+
+  /** The user asked to open sticker management. */
+  data object StickerManagementClicked : MediaKeyboardAction
+
+  /** The user asked to open sticker search. */
+  data object StickerSearchClicked : MediaKeyboardAction
+
+  /** The user asked to open gif search. */
+  data object GifSearchClicked : MediaKeyboardAction
+
+  /** The user asked to look at a pack, from sticker search results. */
+  data class ViewStickerPackClicked(val packId: String, val packKey: String) : MediaKeyboardAction
+
+  /** The user asked to add a pack to their stickers. */
+  data class SendStickerPackClicked(val packId: String, val packKey: String) : MediaKeyboardAction
+
+  /** The user confirmed removing a pack from their stickers. */
+  data class RemoveStickerPackConfirmed(val packId: String, val packKey: String) : MediaKeyboardAction
+}
