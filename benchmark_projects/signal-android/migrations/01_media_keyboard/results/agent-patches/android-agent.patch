+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediakeyboard
+
+import android.util.Log
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import org.signal.core.ui.compose.EventDrivenViewModel
+import org.signal.mediakeyboard.data.MediaKeyboardRepository
+
+/**
+ * Owns which media surface the keyboard is showing, and which ones it is even allowed to show.
+ *
+ * The two are kept apart on purpose. [restrictTabs] is how a host narrows the keyboard for a
+ * particular conversation state, and it only ever narrows: the tab the user picked is remembered so
+ * that lifting the restriction puts them back on it. A user picking a different tab, on the other
+ * hand, is a real preference change and does replace it.
+ *
+ * @param repository Host-owned media, and the authority on what the keyboard can show.
+ * @param isEnteringText Whether the conversation behind the keyboard is in text entry.
+ * @param initialTab Tab to prefer when nothing else says otherwise, typically restored by the host.
+ */
+class MediaKeyboardViewModel(
+  private val repository: MediaKeyboardRepository,
+  isEnteringText: StateFlow<Boolean>,
+  private val initialTab: MediaKeyboardTab? = null
+) : EventDrivenViewModel<MediaKeyboardScreenEvents>(TAG, shouldLogEvents = true) {
+
+  private val _state = MutableStateFlow(MediaKeyboardState())
+
+  /** The keyboard as it should be drawn right now. */
+  val state: StateFlow<MediaKeyboardState> = _state.asStateFlow()
+
+  init {
+    eventScope.launch {
+      isEnteringText.collect { enteringText ->
+        if (enteringText) {
+          // A media query only means anything while the user is browsing media. Once they are back
+          // in the composer it is stale, so drop it instead of leaving it filtering the tab.
+          _state.update { current -> current.copy(searchQuery = "") }
+        }
+      }
+    }
+  }
+
+  /**
+   * Narrows the keyboard to [tabs], or lifts any narrowing when [tabs] is null.
+   *
+   * This is host-driven and reversible, so it never touches the remembered preference: a tab that is
+   * restricted away stays the user's preference and comes back when the restriction is lifted.
+   */
+  fun restrictTabs(tabs: Set<MediaKeyboardTab>?) {
+    _state.update { current -> current.copy(restrictedTo = tabs) }
+  }
+
+  override suspend fun processEvent(event: MediaKeyboardScreenEvents) {
+    applyEvent(_state.value, event) { updated -> _state.update { updated } }
+  }
+
+  /**
+   * Folds [event] into [state], handing the result to [stateEmitter].
+   *
+   * Kept separate from [processEvent] so a caller that already has the state in hand can fold an
+   * event into it without going through the view model.
+   */
+  suspend fun applyEvent(
+    state: MediaKeyboardState,
+    event: MediaKeyboardScreenEvents,
+    stateEmitter: (MediaKeyboardState) -> Unit
+  ) {
+    when (event) {
+      MediaKeyboardScreenEvents.Initialize -> stateEmitter(initialize(state))
+
+      is MediaKeyboardScreenEvents.TabSelected -> {
+        val available = state.availableTabs
+        // A tab the host is not offering right now is not something the user could have picked, so
+        // leave the current selection alone rather than stranding the keyboard on a hidden tab.
+        if (available.isEmpty() || event.tab in available) {
+          // Search results belong to the tab that produced them; carrying the query over would show
+          // a gif or sticker search against an emoji grid. Visibility is the host's business.
+          stateEmitter(state.copy(preferredTab = event.tab, searchQuery = ""))
+        }
+      }
+
+      is MediaKeyboardScreenEvents.SearchQueryChanged -> stateEmitter(
+        state.copy(
+          searchQuery = event.query,
+          searchActive = event.query.isNotEmpty()
+        )
+      )
+    }
+  }
+
+  private suspend fun initialize(state: MediaKeyboardState): MediaKeyboardState {
+    val offered = try {
+      MediaKeyboardTab.ordered(repository.getAvailableTabs())
+    } catch (e: Exception) {
+      // A host that cannot answer still gets a keyboard: empty, but not stuck loading forever.
+      Log.w(TAG, "Failed to load available media keyboard tabs", e)
+      emptyList()
+    }
+
+    // Order matters here: what the host was told to open wins, then whatever the user last chose,
+    // and only then the first thing the host offers.
+    val preferred = listOfNotNull(initialTab, state.preferredTab).firstOrNull { it in offered }
+      ?: offered.firstOrNull()
+      ?: state.preferredTab
+
+    return state.copy(
+      offeredTabs = offered,
+      preferredTab = preferred,
+      initialized = true
+    )
+  }
+
+  companion object {
+    private const val TAG = "MediaKeyboardViewModel"
+  }
+}
