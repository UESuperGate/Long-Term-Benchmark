+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediakeyboard.data
+
+import android.graphics.drawable.Drawable
+
+/** Emoji pages, recents, search, and variation preferences. */
+interface EmojiKeyboardRepository {
+  /** Pages of emoji, in the order the keyboard lays them out. */
+  suspend fun getEmojiPages(): List<EmojiCategoryPage>
+
+  /** Recently used emoji, most recent first. */
+  suspend fun getRecentEmoji(): List<KeyboardEmoji>
+
+  /** Emoji matching [query], most relevant first. */
+  suspend fun search(query: String): List<KeyboardEmoji>
+
+  /** Canonical emoji to the variation the user last picked for it. */
+  suspend fun getPreferredVariations(): Map<String, String>
+
+  /** Records that the user prefers [variation] whenever [canonical] is shown. */
+  fun setPreferredVariation(canonical: String, variation: String)
+
+  /** Records [emoji] as used, which feeds recents and future variation defaults. */
+  suspend fun onEmojiUsed(emoji: String)
+
+  /** The rendered drawable for [emoji], when the host has one. */
+  fun getEmojiDrawable(emoji: String): Drawable?
+}
+
+/** One emoji and the variations that render it differently. */
+data class KeyboardEmoji(
+  val canonical: String,
+  val variations: List<String>
+) {
+  /** Whether picking this emoji can offer the user more than one rendering of it. */
+  val hasVariations: Boolean get() = variations.size > 1
+}
+
+/** The emoji belonging to one category of the emoji keyboard. */
+data class EmojiCategoryPage(
+  val category: EmojiKeyboardCategory,
+  val emoji: List<KeyboardEmoji>
+)
+
+/** Groups the emoji keyboard lays out, in the order the user sees them. */
+enum class EmojiKeyboardCategory {
+  RECENT,
+  CUSTOM,
+  SMILEYS_AND_EMOTION,
+  PEOPLE_AND_BODY,
+  ANIMALS_AND_NATURE,
+  FOOD_AND_DRINK,
+  ACTIVITY_AND_TRAVEL,
+  OBJECTS_AND_SYMBOLS,
+  FLAGS
+}
