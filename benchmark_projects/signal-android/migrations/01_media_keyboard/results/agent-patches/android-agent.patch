+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediakeyboard.screens.gif
+
+import org.signal.mediakeyboard.data.KeyboardGif
+
+/**
+ * What the gif tab is showing.
+ *
+ * Loading is split in two so a page already on screen can stay put while the next one is fetched.
+ * [hasMore] is only ever true when there is something real left to ask for, which is why a failed
+ * request has to clear it.
+ */
+data class GifPageState(
+  val selectedQuickSearch: GifQuickSearchOption = GifQuickSearchOption.LAST,
+  val gifs: List<KeyboardGif> = emptyList(),
+  /** A first page is in flight and there is nothing to show yet. */
+  val isLoading: Boolean = false,
+  /** A later page is in flight, appending to gifs that are already on screen. */
+  val isLoadingMore: Boolean = false,
+  val hasMore: Boolean = false,
+  /** The first page could not be loaded. Retryable. */
+  val loadFailed: Boolean = false
+)
