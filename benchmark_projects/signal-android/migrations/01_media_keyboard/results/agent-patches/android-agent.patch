+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediakeyboard.data
+
+import android.net.Uri
+import org.signal.core.util.Result
+
+/** Gif search. */
+interface GifKeyboardRepository {
+  /**
+   * One page of gifs for [query], starting at [offset]. A [Result.Failure] is a normal outcome, not
+   * an exception: the keyboard turns it into a retryable state.
+   */
+  suspend fun getGifs(query: String, offset: Int, limit: Int): Result<GifPage, GifFetchError>
+}
+
+/** One page of gif search results. */
+data class GifPage(
+  val gifs: List<KeyboardGif>,
+  /** Whether the host has more results past the end of this page. */
+  val hasMore: Boolean
+)
+
+/** Why a gif request could not be served. */
+sealed interface GifFetchError {
+  /** The host could not reach the gif service. */
+  data object Network : GifFetchError
+
+  /** Anything else, with the cause when there was one. */
+  data class Unknown(val cause: Throwable? = null) : GifFetchError
+}
+
+/** A single gif result, in whatever form the host keeps its media. */
+data class KeyboardGif(
+  val id: String,
+  val still: Any?,
+  val mp4PreviewUri: Uri?,
+  val width: Int,
+  val height: Int
+) {
+  /** Aspect ratio used to lay results out in a stable grid. Falls back to square for bad sizes. */
+  val aspectRatio: Float get() = if (width > 0 && height > 0) width.toFloat() / height.toFloat() else 1f
+}
