+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediakeyboard
+
+/**
+ * Everything the media keyboard needs to draw itself.
+ *
+ * The keyboard remembers two things separately: which tabs the host offered ([offeredTabs], possibly
+ * narrowed right now by [restrictedTo]) and which tab the user actually wants ([preferredTab]).
+ * Restrictions are temporary, so narrowing the selection must never overwrite the preference: that
+ * is what lets lifting a restriction put the user back where they were.
+ */
+data class MediaKeyboardState(
+  /** Tabs the host offered, in product order. */
+  val offeredTabs: List<MediaKeyboardTab> = emptyList(),
+  /** Temporary narrowing of the offered tabs, or null when nothing is being restricted. */
+  val restrictedTo: Set<MediaKeyboardTab>? = null,
+  /** The tab the user last chose, remembered even while it is not reachable. */
+  val preferredTab: MediaKeyboardTab = MediaKeyboardTab.EMOJI,
+  /** Whether the media search surface is showing. Owned by the host and untouched by tab changes. */
+  val searchActive: Boolean = false,
+  /** Current media search query. Scoped to the tab that is showing. */
+  val searchQuery: String = "",
+  /** Whether the keyboard has asked the host what it can show. */
+  val initialized: Boolean = false
+) {
+  /**
+   * The tabs the user may actually be put on right now. A restriction can only narrow what the
+   * repository offered, so it can never surface a tab the host does not support.
+   */
+  val availableTabs: List<MediaKeyboardTab>
+    get() = if (restrictedTo == null) {
+      offeredTabs.distinct()
+    } else {
+      offeredTabs.filter { it in restrictedTo }.distinct()
+    }
+
+  /**
+   * The tab to show. Falls back to the first reachable tab when the preference is restricted away,
+   * and to the preference itself when nothing is reachable at all.
+   */
+  val selectedTab: MediaKeyboardTab
+    get() = if (preferredTab in availableTabs) preferredTab else availableTabs.firstOrNull() ?: preferredTab
+}
