+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+import {
+  ConversationMediaStore,
+  GifStore,
+  KeyboardSticker,
+  MediaKeyboardState,
+  MediaKeyboardStore
+} from '../feature/MediaKeyboardStore';
+
+@Entry
+@Component
+struct MediaKeyboardPage {
+  private keyboard: MediaKeyboardStore = new MediaKeyboardStore((): string[] => {
+    return ['GIF', 'EMOJI', 'STICKER'];
+  });
+
+  private gifs: GifStore = new GifStore((query: string, offset: number, limit: number) => {
+    return { failed: false, ids: [], hasMore: false };
+  });
+
+  private conversation: ConversationMediaStore = new ConversationMediaStore({
+    visibility: (value: boolean): void => {
+      this.showConfirmation = value;
+    },
+    onSend: (sticker: KeyboardSticker): void => {
+      this.sentSticker = sticker;
+    }
+  });
+
+  @State keyboardState: MediaKeyboardState = {
+    initialized: false,
+    availableTabs: [],
+    selectedTab: '',
+    preferredTab: '',
+    searchActive: false,
+    searchQuery: ''
+  };
+
+  @State gifIds: string[] = [];
+
+  @State showConfirmation: boolean = false;
+
+  @State sentSticker: KeyboardSticker | null = null;
+
+  aboutToAppear(): void {
+    this.keyboard.initialize();
+    this.gifs.loadFirstPage();
+    this.sync();
+  }
+
+  private sync(): void {
+    this.keyboardState = this.keyboard.keyboardState();
+    this.gifIds = this.gifs.state().gifs;
+    this.showConfirmation = this.conversation.confirmation() !== null;
+  }
+
+  build() {
+    Column() {
+      Row() {
+        ForEach(this.keyboardState.availableTabs, (tab: string) => {
+          Text(tab)
+            .fontWeight(this.keyboardState.selectedTab === tab ? FontWeight.Bold : FontWeight.Normal)
+            .onClick(() => {
+              this.keyboard.selectTab(tab);
+              this.sync();
+            })
+        }, (tab: string): string => tab)
+      }
+      .width('100%')
+      .justifyContent(FlexAlign.SpaceEvenly)
+
+      if (this.gifs.loadFailed) {
+        Text('Could not load gifs')
+          .onClick(() => {
+            this.gifs.retry();
+            this.sync();
+          })
+      } else {
+        Grid() {
+          ForEach(this.gifIds, (id: string) => {
+            GridItem() {
+              Text(id)
+            }
+          }, (id: string): string => id)
+        }
+        .onScrollIndex((start: number, end: number, center: number, index: number): void => {
+          if (index >= this.gifIds.length - 4) {
+            this.gifs.loadMore();
+            this.sync();
+          }
+        })
+      }
+
+      if (this.showConfirmation) {
+        Row() {
+          Button('Cancel')
+            .onClick(() => {
+              this.conversation.cancelConfirmation();
+              this.sync();
+            })
+          Button('Send')
+            .onClick(() => {
+              this.conversation.confirmSend();
+              this.sync();
+            })
+        }
+      }
+    }
+    .width('100%')
+    .height('100%')
+  }
+}
