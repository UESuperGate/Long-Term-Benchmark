+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+/** One page of gif search results. A failed page is a normal outcome, not an exception. */
+export interface GifPageResult {
+  failed: boolean;
+  ids: string[];
+  hasMore: boolean;
+}
+
+/** A single sticker: enough to show it, and enough to send it. */
+export interface KeyboardSticker {
+  packId: string;
+  packKey: string;
+  stickerId: number;
+}
+
+/** What the conversation does when a sticker confirmation opens, closes, or is accepted. */
+export interface ConversationEffects {
+  visibility(value: boolean): void;
+  onSend(sticker: KeyboardSticker): void;
+}
+
+/** The media keyboard as it should be drawn. */
+export interface MediaKeyboardState {
+  initialized: boolean;
+  availableTabs: string[];
+  selectedTab: string;
+  preferredTab: string;
+  searchActive: boolean;
+  searchQuery: string;
+}
+
+/** What the gif tab is showing. */
+export interface GifState {
+  gifs: string[];
+  isLoading: boolean;
+  isLoadingMore: boolean;
+  hasMore: boolean;
+  loadFailed: boolean;
+}
+
+/** The order tabs are shown in, independent of the order the host offers them. */
+const PRODUCT_ORDER: string[] = ['EMOJI', 'STICKER', 'GIF'];
+
+/** How many results a single gif request asks for. */
+const GIF_PAGE_SIZE: number = 60;
+
+/**
+ * Which media surface the keyboard is showing, and which ones the host is willing to show.
+ *
+ * What the host offered and what the user last picked are kept apart. Narrowing is temporary and
+ * reversible, so it never overwrites the pick: a tab that is restricted away stays the user's
+ * preference and comes back when the restriction is lifted.
+ */
+export class MediaKeyboardStore {
+  /** Tabs the host offered, in product order. */
+  offeredTabs: string[] = [];
+  /** The tab the user last chose, remembered even while it is not reachable. */
+  preferredTab: string = 'EMOJI';
+  /** Temporary narrowing of the offered tabs, or null when nothing is being restricted. */
+  restrictedTo: string[] | null = null;
+  /** Whether the keyboard has asked the host what it can show. */
+  initialized: boolean = false;
+  /** Whether the media search surface is showing. Owned by the host, untouched by tab changes. */
+  searchActive: boolean = false;
+  /** Current media search query. Scoped to the tab that is showing. */
+  searchQuery: string = '';
+
+  private readonly getAvailableTabs: () => string[];
+
+  constructor(getAvailableTabs: () => string[]) {
+    this.getAvailableTabs = getAvailableTabs;
+  }
+
+  /** Asks the host what it can show and puts the first reachable tab up. */
+  initialize(): void {
+    this.offeredTabs = MediaKeyboardStore.orderTabs(this.getAvailableTabs());
+    this.initialized = true;
+  }
+
+  /** Replaces the whole state, for restoring a keyboard that already exists. */
+  seed(tabs: string[], preferred: string, restricted: string[] | null, active: boolean, query: string): void {
+    this.offeredTabs = MediaKeyboardStore.orderTabs(tabs);
+    this.preferredTab = preferred;
+    this.restrictedTo = restricted === null ? null : restricted.slice();
+    this.searchActive = active;
+    this.searchQuery = query;
+  }
+
+  /**
+   * Narrows the keyboard to tabs, or lifts any narrowing when tabs is null.
+   *
+   * Host-driven and reversible, so the remembered preference is left alone.
+   */
+  restrictTabs(tabs: string[] | null): void {
+    this.restrictedTo = tabs === null ? null : tabs.slice();
+  }
+
+  /** Moves to tab and drops the search query that belonged to the tab being left behind. */
+  selectTab(tab: string): void {
+    const available = this.available();
+    if (available.length > 0 && available.indexOf(tab) < 0) {
+      // Not something the user could have picked, so leave the selection where it is.
+      return;
+    }
+
+    this.preferredTab = tab;
+    this.searchQuery = '';
+  }
+
+  /** The keyboard as it should be drawn right now. */
+  keyboardState(): MediaKeyboardState {
+    return {
+      initialized: this.initialized,
+      availableTabs: this.available(),
+      selectedTab: this.selected(),
+      preferredTab: this.preferredTab,
+      searchActive: this.searchActive,
+      searchQuery: this.searchQuery
+    };
+  }
+
+  /**
+   * The tabs the user may actually be put on right now. A restriction can only narrow what the host
+   * offered, so it can never surface a tab the host does not support.
+   */
+  private available(): string[] {
+    const restricted = this.restrictedTo;
+    if (restricted === null) {
+      return this.offeredTabs.slice();
+    }
+
+    return this.offeredTabs.filter((tab: string) => restricted.indexOf(tab) >= 0);
+  }
+
+  /** The tab to show, falling back to the first reachable one while the preference is restricted. */
+  private selected(): string {
+    const available = this.available();
+    if (available.indexOf(this.preferredTab) >= 0) {
+      return this.preferredTab;
+    }
+
+    return available.length > 0 ? available[0] : this.preferredTab;
+  }
+
+  private static orderTabs(tabs: string[]): string[] {
+    const ordered: string[] = [];
+    for (const tab of PRODUCT_ORDER) {
+      if (tabs.indexOf(tab) >= 0 && ordered.indexOf(tab) < 0) {
+        ordered.push(tab);
+      }
+    }
+
+    return ordered;
+  }
+}
+
+/**
+ * Drives the gif tab: a first page, whatever the user scrolls onto after that, and a way back from a
+ * request that did not come back.
+ *
+ * A failed first page becomes state rather than an error to propagate: it is retryable, and it stops
+ * claiming there is more to load, because there is nothing on screen to append to.
+ */
+export class GifStore {
+  gifs: string[] = [];
+  isLoading: boolean = false;
+  isLoadingMore: boolean = false;
+  hasMore: boolean = false;
+  loadFailed: boolean = false;
+  query: string = '';
+
+  private readonly getGifs: (query: string, offset: number, limit: number) => GifPageResult;
+
+  constructor(getGifs: (query: string, offset: number, limit: number) => GifPageResult) {
+    this.getGifs = getGifs;
+  }
+
+  /** Replaces the whole state, for restoring a tab that already exists. */
+  seed(ids: string[], more: boolean, failed: boolean): void {
+    this.gifs = ids.slice();
+    this.hasMore = more;
+    this.loadFailed = failed;
+    this.isLoading = false;
+    this.isLoadingMore = false;
+  }
+
+  /** Loads the first page, replacing whatever was there. */
+  loadFirstPage(): void {
+    this.isLoading = true;
+    this.isLoadingMore = false;
+    this.loadFailed = false;
+
+    const page = this.getGifs(this.query, 0, GIF_PAGE_SIZE);
+    this.isLoading = false;
+
+    if (page.failed) {
+      this.hasMore = false;
+      this.loadFailed = true;
+      return;
+    }
+
+    this.gifs = page.ids.slice();
+    this.hasMore = page.hasMore;
+    this.loadFailed = false;
+  }
+
+  /** Asks for the first page again from the start, rather than continuing from the failure. */
+  retry(): void {
+    this.loadFirstPage();
+  }
+
+  /** Appends the next page. Results already on screen are the offset. */
+  loadMore(): void {
+    if (!this.hasMore || this.isLoading || this.isLoadingMore) {
+      return;
+    }
+
+    this.isLoadingMore = true;
+    const page = this.getGifs(this.query, this.gifs.length, GIF_PAGE_SIZE);
+    this.isLoadingMore = false;
+
+    if (page.failed) {
+      // Leave hasMore alone so scrolling again asks for the page that failed.
+      return;
+    }
+
+    this.gifs = this.gifs.concat(page.ids);
+    this.hasMore = page.hasMore;
+  }
+
+  /** The tab as it should be drawn right now. */
+  state(): GifState {
+    return {
+      gifs: this.gifs.slice(),
+      isLoading: this.isLoading,
+      isLoadingMore: this.isLoadingMore,
+      hasMore: this.hasMore,
+      loadFailed: this.loadFailed
+    };
+  }
+}
+
+/**
+ * Holds the sticker a conversation is waiting on the user to confirm before sending it.
+ *
+ * A sticker tap is not a send. It puts a sticker here and raises the conversation's overlay;
+ * nothing is sent until confirmSend runs.
+ */
+export class ConversationMediaStore {
+  /** The sticker awaiting confirmation, or null when the overlay is not up. */
+  pending: KeyboardSticker | null = null;
+
+  private readonly effects: ConversationEffects;
+
+  constructor(effects: ConversationEffects) {
+    this.effects = effects;
+  }
+
+  /** Puts sticker up for confirmation without going through the conversation. */
+  seed(sticker: KeyboardSticker): void {
+    this.pending = sticker;
+  }
+
+  /** The user tapped a sticker. Raises the overlay; sends nothing. */
+  tapSticker(sticker: KeyboardSticker): void {
+    this.pending = sticker;
+    this.effects.visibility(true);
+  }
+
+  /** The user backed out. Does nothing when there is nothing to back out of. */
+  cancelConfirmation(): void {
+    if (this.pending === null) {
+      return;
+    }
+
+    this.pending = null;
+    this.effects.visibility(false);
+  }
+
+  /** Sends the pending sticker, once. Does nothing when there is nothing pending. */
+  confirmSend(): void {
+    const pending = this.pending;
+    if (pending === null) {
+      return;
+    }
+
+    // Cleared before the effect: a send that re-enters the conversation must not find the sticker
+    // still waiting and send it a second time.
+    this.pending = null;
+    this.effects.visibility(false);
+    this.effects.onSend(pending);
+  }
+
+  /** The sticker awaiting confirmation, or null. */
+  confirmation(): KeyboardSticker | null {
+    return this.pending;
+  }
+}
