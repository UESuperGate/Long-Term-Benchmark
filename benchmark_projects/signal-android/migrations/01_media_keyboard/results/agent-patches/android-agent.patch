@@ -0,0 +1,139 @@
+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.mediakeyboard.screens.gif
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import org.signal.core.util.Result
+import org.signal.mediakeyboard.MediaKeyboardAction
+import org.signal.mediakeyboard.data.GifKeyboardRepository
+import org.signal.mediakeyboard.screens.MediaKeyboardPageViewModel
+
+/**
+ * Drives the gif tab: a first page, whatever the user scrolls onto after that, and a way back from
+ * a request that did not come back.
+ *
+ * A failed first page is state, not an exception: it becomes a retryable screen and stops claiming
+ * there is more to load, because there is nothing on screen to append to. Retrying asks for the
+ * first page again from offset zero rather than continuing from where the failure happened.
+ */
+class GifPageViewModel(
+  private val repository: GifKeyboardRepository
+) : MediaKeyboardPageViewModel<GifPageScreenEvents>(TAG, shouldLogEvents = true) {
+
+  private val _state = MutableStateFlow(GifPageState())
+
+  /** What the tab should be showing right now. */
+  val state: StateFlow<GifPageState> = _state.asStateFlow()
+
+  override suspend fun processEvent(event: GifPageScreenEvents) {
+    applyEvent(_state.value, event) { updated -> _state.update { updated } }
+  }
+
+  /**
+   * Folds [event] into [state], handing the result to [stateEmitter].
+   *
+   * Kept separate from [processEvent] so a caller that already has the state in hand can fold an
+   * event into it without going through the view model.
+   */
+  suspend fun applyEvent(
+    state: GifPageState,
+    event: GifPageScreenEvents,
+    stateEmitter: (GifPageState) -> Unit
+  ) {
+    when (event) {
+      GifPageScreenEvents.Initialize -> {
+        // Already showing something, and not sitting on a failure the user has to clear: leave it.
+        if (!state.isLoading && (state.gifs.isNotEmpty() && !state.loadFailed)) {
+          return
+        }
+
+        loadFirstPage(state, stateEmitter)
+      }
+
+      is GifPageScreenEvents.QuickSearchSelected -> {
+        if (event.option == state.selectedQuickSearch) {
+          return
+        }
+
+        // A new search is a new first page, not an extension of the old results.
+        loadFirstPage(state.copy(selectedQuickSearch = event.option), stateEmitter)
+      }
+
+      GifPageScreenEvents.RetryClicked -> loadFirstPage(state, stateEmitter)
+
+      GifPageScreenEvents.LoadMoreRequested -> loadMore(state, stateEmitter)
+
+      is GifPageScreenEvents.GifClicked -> emitAction(MediaKeyboardAction.GifSelected(event.gif))
+
+      GifPageScreenEvents.SearchClicked -> emitAction(MediaKeyboardAction.GifSearchClicked)
+    }
+  }
+
+  private suspend fun loadFirstPage(state: GifPageState, stateEmitter: (GifPageState) -> Unit) {
+    stateEmitter(state.copy(isLoading = true, isLoadingMore = false, loadFailed = false))
+
+    when (val result = repository.getGifs(state.selectedQuickSearch.query, 0, PAGE_SIZE)) {
+      is Result.Success -> stateEmitter(
+        state.copy(
+          gifs = result.success.gifs,
+          isLoading = false,
+          isLoadingMore = false,
+          hasMore = result.success.hasMore,
+          loadFailed = false
+        )
+      )
+
+      is Result.Failure -> stateEmitter(
+        state.copy(
+          isLoading = false,
+          isLoadingMore = false,
+          // Nothing is on screen, so there is nothing to append to and nothing to promise.
+          hasMore = false,
+          loadFailed = true
+        )
+      )
+    }
+  }
+
+  private suspend fun loadMore(state: GifPageState, stateEmitter: (GifPageState) -> Unit) {
+    if (!state.hasMore || state.isLoading || state.isLoadingMore) {
+      return
+    }
+
+    stateEmitter(state.copy(isLoadingMore = true))
+
+    // Results already on screen are the offset: the host pages by count, so this is what keeps a
+    // repeated scroll from re-fetching the same page.
+    val offset = state.gifs.size
+
+    when (val result = repository.getGifs(state.selectedQuickSearch.query, offset, PAGE_SIZE)) {
+      is Result.Success -> stateEmitter(
+        state.copy(
+          gifs = state.gifs + result.success.gifs,
+          isLoadingMore = false,
+          hasMore = result.success.hasMore,
+          loadFailed = false
+        )
+      )
+
+      is Result.Failure -> stateEmitter(
+        // The results already on screen stay. Leave hasMore alone so scrolling again asks for the
+        // page that failed rather than stranding the user at the end of the list.
+        state.copy(isLoadingMore = false)
+      )
+    }
+  }
+
+  companion object {
+    private const val TAG = "GifPageViewModel"
+
+    /** How many results a single request asks for. */
+    private const val PAGE_SIZE = 60
+  }
+}
