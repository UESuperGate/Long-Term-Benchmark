+/*
+ * Copyright 2026 Signal Messenger, LLC
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+package org.signal.core.ui.compose
+
+import android.util.Log
+import androidx.lifecycle.ViewModel
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.launch
+import kotlin.coroutines.CoroutineContext
+import kotlin.coroutines.EmptyCoroutineContext
+
+/**
+ * Turns a fire-and-forget event stream into serialized state changes.
+ *
+ * UI is free to call [onEvent] from anywhere, including from callbacks that cannot suspend, so
+ * events are parked in an unbounded channel and drained one at a time. Handling them in order, and
+ * never concurrently, is what lets a screen fold an event into state without a mutex: [processEvent]
+ * always sees the state the previous event left behind.
+ *
+ * @param tag Log tag for the event stream.
+ * @param shouldLogEvents Whether every event should be logged as it is queued and handled.
+ */
+abstract class EventDrivenViewModel<E : Any>(
+  private val tag: String,
+  private val shouldLogEvents: Boolean = false
+) : ViewModel() {
+
+  private val eventQueue = Channel<E>(Channel.UNLIMITED)
+
+  /**
+   * Scope that owns everything this view model does on its own behalf, including draining
+   * [eventQueue]. Cancelled when the view model is cleared so nothing outlives the screen.
+   */
+  protected val eventScope: CoroutineScope = CoroutineScope(SupervisorJob() + eventDispatcher)
+
+  init {
+    eventScope.launch {
+      for (event in eventQueue) {
+        if (shouldLogEvents) {
+          Log.d(tag, "Handling event: $event")
+        }
+
+        processEvent(event)
+      }
+    }
+  }
+
+  /**
+   * Queues [event] to be handled. Returns immediately; the work happens on [eventScope] in the
+   * order events were queued.
+   */
+  fun onEvent(event: E) {
+    if (shouldLogEvents) {
+      Log.d(tag, "Queuing event: $event")
+    }
+
+    eventQueue.trySend(event)
+  }
+
+  /** Folds [event] into whatever state the previous event left behind. */
+  protected abstract suspend fun processEvent(event: E)
+
+  override fun onCleared() {
+    eventScope.cancel()
+    super.onCleared()
+  }
+
+  private companion object {
+    /**
+     * Events are normally handled on the main dispatcher. Hosted code and tests often have no main
+     * looper to offer, so fall back to the caller's context rather than failing construction.
+     */
+    val eventDispatcher: CoroutineContext = try {
+      Dispatchers.Main.immediate
+    } catch (e: IllegalStateException) {
+      EmptyCoroutineContext
+    } catch (e: NotImplementedError) {
+      EmptyCoroutineContext
+    }
+  }
+}
