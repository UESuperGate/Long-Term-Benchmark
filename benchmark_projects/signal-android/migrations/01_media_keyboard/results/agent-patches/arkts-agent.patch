+
+  /** Tapping a sticker asks for confirmation; it does not send or record a use. */
+  tapSticker(sticker: KeyboardSticker): void {
+    this.show(sticker, null);
+  }
+
+  show(sticker: KeyboardSticker, replyTo: string | null): void {
+    this.pending = sticker;
+    this.replyTo = replyTo;
+    this.effects.visibility(true);
+  }
+
+  /** Cancelling returns to the conversation without sending. */
+  cancelConfirmation(): void {
+    this.dismiss();
+  }
+
+  dismiss(): void {
+    if (this.pending === null) {
+      return;
+    }
+    this.pending = null;
+    this.replyTo = null;
+    this.effects.visibility(false);
+  }
+
+  /** Hides the overlay and hands the sticker to the host exactly once. */
+  confirmSend(): void {
+    const confirmed: KeyboardSticker | null = this.pending;
+    if (confirmed === null) {
+      return;
+    }
+    this.pending = null;
+    this.replyTo = null;
+    this.effects.visibility(false);
+    this.effects.onSend(confirmed);
+  }
+
+  confirmation(): KeyboardSticker | null {
+    return this.pending;
+  }
+
+  isShowing(): boolean {
+    return this.pending !== null;
+  }
 }
 
